{
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/pete/Cadres/lattice/integrations/claude-code/hooks/post-tool-use.sh",
            "statusMessage": "Checking Lattice edit impact",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "apply_patch|Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/Users/pete/Cadres/lattice/integrations/claude-code/hooks/session-start.sh",
            "statusMessage": "Loading Lattice session context",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/Users/pete/Cadres/lattice/integrations/claude-code/hooks/stop.sh",
            "statusMessage": "Recording Lattice session outcome",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/Users/pete/Cadres/lattice/integrations/claude-code/hooks/user-prompt-submit.sh",
            "statusMessage": "Loading Lattice prompt context",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
