{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HuaBqgdbcHqjSVfPnHeSCz","type":"tool_result","content":"1\t//! Phase 7 verification integration tests.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## Non-Negotiable Product Properties`:\n5\t//! \"Every stale or contradicted memory is surfaced as such, not hidden behind recency.\"\n6\t//!\n7\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n8\t//! `## Risks — Stale Memory Leakage`:\n9\t//! \"Control: freshness indexes, graph-change-triggered verification, stale labels in all memory surfaces, and tests that stale memory cannot rank as trusted.\"\n10\t//!\n11\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n12\t//! `## Risks — Scope Leakage`:\n13\t//! \"Control: scope-aware queries, enforced filters in store APIs, and negative tests.\"\n14\t//!\n15\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n16\t//! `## Phase 7: Verification And Freshness` DoD:\n17\t//! \"stale or contradicted memory cannot appear as normal trusted guidance\".\n18\t\n19\tuse std::collections::{BTreeMap, HashMap};\n20\tuse std::io::Write;\n21\tuse std::path::PathBuf;\n22\tuse std::sync::{Arc, Mutex};\n23\t\n24\tuse rusqlite::Connection;\n25\tuse serde_json::json;\n26\tuse sha2::{Digest, Sha256};\n27\tuse tempfile::tempdir;\n28\tuse tracing_subscriber::fmt::MakeWriter;\n29\t\n30\tuse super::{\n31\t    BundleSection, ExpiryScanner, IncrementalVerifier, ScopeFilter, SurfacingPipeline,\n32\t    VerificationObserver, WorkspaceFileReader,\n33\t};\n34\tuse crate::consolidation::llm::{\n35\t    BudgetCatalog, ConsolidationMode, ContradictionCandidatePair, ContradictionDetectionJob,\n36\t    LlmDriver, LlmDriverError, LlmJobContext, LlmJobServices, LlmRequest, LlmResponse,\n37\t};\n38\tuse crate::consolidation::{ConsolidationConfig, ConsolidationJobRuntime, ProposalDecision};\n39\tuse crate::events::{BranchRef, EventStore, EventWriter, FlushPolicy};\n40\tuse crate::graph::CodeGraph;\n41\tuse crate::identity::{FileId, Identity, MemoryId, OperatorId};\n42\tuse crate::memory::{\n43\t    EvidenceSpan, Memory, MemoryEvidence, MemoryScope, MemoryStore, MemoryStructuredFields,\n44\t    MemoryType, MemoryVerificationStatus,\n45\t};\n46\tuse crate::retrieval_v1::{\n47\t    Candidate, CandidateSource, MemoryScoringMetadata, RankedCandidate, ScoringContext,\n48\t};\n49\tuse crate::storage::graph_store::{\n50\t    FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n51\t};\n52\tuse crate::symbols::{Language, ParsedFile};\n53\tuse crate::{DateTime, Utc};\n54\t\n55\t#[test]\n56\tfn test_stale_memory_never_appears_in_trusted_bundle() {\n57\t    let harness = VerificationHarness::new();\n58\t    let memory_id = harness.seed_span_memory(\"mem-stale\", \"src/auth.ts\", \"const FLAG = true;\\n\");\n59\t    let changed = harness.file_id(\"src/auth.ts\", \"hash-auth-v2\");\n60\t    let report = harness.reverify_changed_file(\n61\t        &changed,\n62\t        \"const FLAG = false;\\n\",\n63\t        ObservationRecorder::default(),\n64\t    );\n65\t    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n66\t\n67\t    assert_eq!(report.stale, 1);\n68\t    assert_sections(&bundle, &memory_id, BundleSection::Stale);\n69\t}\n70\t\n71\t#[test]\n72\tfn test_contradicted_memory_never_appears_in_trusted_bundle() {\n73\t    let mut harness = VerificationHarness::new();\n74\t    let contradicted_id = harness.seed_plain_memory(\"mem-b\", \"The build never uses cargo check.\");\n75\t    let _contradictor_id =\n76\t        harness.seed_plain_memory(\"mem-a\", \"The build uses cargo check for verification.\");\n77\t\n78\t    harness.apply_contradiction(\"mem-b\", \"mem-a\");\n79\t    let bundle = harness.bundle_for_ids(&[contradicted_id.as_str()]);\n80\t\n81\t    assert_sections(&bundle, &contradicted_id, BundleSection::Contradicted);\n82\t}\n83\t\n84\t#[test]\n85\tfn test_expired_memory_never_appears_in_trusted_bundle() {\n86\t    let harness = VerificationHarness::new();\n87\t    let memory_id = harness.seed_file_memory(\"mem-expired\", \"src/expiry.rs\");\n88\t    harness\n89\t        .memory_store\n90\t        .set_expires_at(&memory_id, DateTime::from_unix_seconds(99))\n91\t        .expect(\"expiry stores\");\n92\t    harness.scan_expiry(DateTime::from_unix_seconds(100));\n93\t    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n94\t\n95\t    assert_sections(&bundle, &memory_id, BundleSection::Expired);\n96\t}\n97\t\n98\t#[test]\n99\tfn test_invalidated_memory_never_appears_in_trusted_bundle() {\n100\t    let harness = VerificationHarness::new();\n101\t    let memory_id = harness.seed_file_memory(\"mem-invalidated\", \"src/delete-me.ts\");\n102\t    harness.write_file(\"src/delete-me.ts\", \"export const alive = true;\\n\");\n103\t    harness.delete_file(\"src/delete-me.ts\");\n104\t    let deleted = harness.file_id(\"src/delete-me.ts\", \"hash-delete-v2\");\n105\t    let report = harness.reverify_deleted_file(&deleted, ObservationRecorder::default());\n106\t    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n107\t\n108\t    assert_eq!(report.invalidated, 1);\n109\t    assert_sections(&bundle, &memory_id, BundleSection::Invalidated);\n110\t}\n111\t\n112\t#[test]\n113\tfn test_scope_leak_blocked_at_store_boundary_for_all_scopes() {\n114\t    let harness = VerificationHarness::new();\n115\t    let logs = Arc::new(Mutex::new(Vec::new()));\n116\t    let subscriber = tracing_subscriber::fmt()\n117\t        .with_writer(BufferWriter(logs.clone()))\n118\t        .with_ansi(false)\n119\t        .finish();\n120\t    let _guard = tracing::subscriber::set_default(subscriber);\n121\t\n122\t    let ids = harness.seed_scope_leak_fixture();\n123\t    let results = harness.run_scope_leak_queries();\n124\t    let events = harness\n125\t        .memory_store\n126\t        .scope_filter_events()\n127\t        .expect(\"scope events load\");\n128\t    let log_output = String::from_utf8(logs.lock().expect(\"log lock\").clone()).expect(\"utf8\");\n129\t\n130\t    assert!(results.into_iter().all(|memory| memory.is_none()));\n131\t    assert_eq!(events.len(), 4);\n132\t    assert_eq!(\n133\t        events\n134\t            .iter()\n135\t            .map(|event| event.memory_id.as_str())\n136\t            .collect::<Vec<_>>(),\n137\t        ids.iter().map(String::as_str).collect::<Vec<_>>()\n138\t    );\n139\t    assert!(log_output.contains(\"scope_leak_blocked\"));\n140\t}\n141\t\n142\t#[test]\n143\tfn test_ranker_excludes_non_verified_from_top_n() {\n144\t    let harness = VerificationHarness::new();\n145\t    let ids = harness.seed_ranker_fixture();\n146\t    let ranked = ids\n147\t        .iter()\n148\t        .enumerate()\n149\t        .map(|(index, id)| ranked_memory(id, 100.0 - index as f32))\n150\t        .collect::<Vec<_>>();\n151\t    let ctx = harness.scoring_context_for(&ids);\n152\t\n153\t    let trusted = SurfacingPipeline::trusted_ranked_top_n(ranked, &ctx, 5);\n154\t\n155\t    assert_eq!(trusted.len(), 1);\n156\t    assert_eq!(\n157\t        trusted[0].candidate.identity,\n158\t        memory_identity(\"mem-verified\")\n159\t    );\n160\t}\n161\t\n162\t#[test]\n163\tfn test_incremental_verification_narrows_to_changed_files_only() {\n164\t    let harness = VerificationHarness::new();\n165\t    let files = harness.seed_many_file_memories(100);\n166\t    let changed = files[7].clone();\n167\t    let observer = ObservationRecorder::default();\n168\t    let report = harness.reverify_unchanged_content(&changed, &files, &observer);\n169\t\n170\t    assert_eq!(report.impacted, 1);\n171\t    assert_eq!(observer.memory_ids(), vec![\"mem-007\"]);\n172\t}\n173\t\n174\t#[test]\n175\tfn test_verifier_emits_explainable_label_reason_for_every_non_verified_state() {\n176\t    let harness = VerificationHarness::new();\n177\t    let ids = harness.seed_explainable_reason_fixture();\n178\t    let bundle = harness.bundle_for_ids(&ids.iter().map(String::as_str).collect::<Vec<_>>());\n179\t\n180\t    assert_eq!(bundle.advisory.len(), 7);\n181\t    assert_reason_contains(\n182\t        &bundle,\n183\t        \"mem-unverified\",\n184\t        \"scope mismatch workspace-main/main\",\n185\t    );\n186\t    assert_reason_contains(&bundle, \"mem-in-review\", \"file `src/review.rs`\");\n187\t    assert_reason_contains(&bundle, \"mem-stale-reason\", \"span byte range 0..18\");\n188\t    assert_reason_contains(&bundle, \"mem-contradicted-reason\", \"contradicted by mem-a\");\n189\t    assert_reason_contains(&bundle, \"mem-superseded-reason\", \"superseded by mem-newer\");\n190\t    assert_reason_contains(&bundle, \"mem-expired-reason\", \"expiry 2026-05-17T00:00:00Z\");\n191\t    assert_reason_contains(&bundle, \"mem-invalidated-reason\", \"file id src/deleted.rs\");\n192\t}\n193\t\n194\tstruct VerificationHarness {\n195\t    _dir: tempfile::TempDir,\n196\t    workspace_root: PathBuf,\n197\t    runtime_db: PathBuf,\n198\t    memory_store: MemoryStore,\n199\t    _event_store: Arc<EventStore>,\n200\t    event_writer: EventWriter,"}]},"parent_tool_use_id":null,"session_id":"0696e093-0770-442b-8dc9-5393bbfcd0b6","uuid":"f1def8a6-55ee-4bbd-8f4e-c40de0cfed22","timestamp":"2026-05-17T13:02:19.182Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/integration_tests.rs","content":"//! Phase 7 verification integration tests.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Non-Negotiable Product Properties`:\n//! \"Every stale or contradicted memory is surfaced as such, not hidden behind recency.\"\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Risks — Stale Memory Leakage`:\n//! \"Control: freshness indexes, graph-change-triggered verification, stale labels in all memory surfaces, and tests that stale memory cannot rank as trusted.\"\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Risks — Scope Leakage`:\n//! \"Control: scope-aware queries, enforced filters in store APIs, and negative tests.\"\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 7: Verification And Freshness` DoD:\n//! \"stale or contradicted memory cannot appear as normal trusted guidance\".\n\nuse std::collections::{BTreeMap, HashMap};\nuse std::io::Write;\nuse std::path::PathBuf;\nuse std::sync::{Arc, Mutex};\n\nuse rusqlite::Connection;\nuse serde_json::json;\nuse sha2::{Digest, Sha256};\nuse tempfile::tempdir;\nuse tracing_subscriber::fmt::MakeWriter;\n\nuse super::{\n    BundleSection, ExpiryScanner, IncrementalVerifier, ScopeFilter, SurfacingPipeline,\n    VerificationObserver, WorkspaceFileReader,\n};\nuse crate::consolidation::llm::{\n    BudgetCatalog, ConsolidationMode, ContradictionCandidatePair, ContradictionDetectionJob,\n    LlmDriver, LlmDriverError, LlmJobContext, LlmJobServices, LlmRequest, LlmResponse,\n};\nuse crate::consolidation::{ConsolidationConfig, ConsolidationJobRuntime, ProposalDecision};\nuse crate::events::{BranchRef, EventStore, EventWriter, FlushPolicy};\nuse crate::graph::CodeGraph;\nuse crate::identity::{FileId, Identity, MemoryId, OperatorId};\nuse crate::memory::{\n    EvidenceSpan, Memory, MemoryEvidence, MemoryScope, MemoryStore, MemoryStructuredFields,\n    MemoryType, MemoryVerificationStatus,\n};\nuse crate::retrieval_v1::{\n    Candidate, CandidateSource, MemoryScoringMetadata, RankedCandidate, ScoringContext,\n};\nuse crate::storage::graph_store::{\n    FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n};\nuse crate::symbols::{Language, ParsedFile};\nuse crate::{DateTime, Utc};\n\n#[test]\nfn test_stale_memory_never_appears_in_trusted_bundle() {\n    let harness = VerificationHarness::new();\n    let memory_id = harness.seed_span_memory(\"mem-stale\", \"src/auth.ts\", \"const FLAG = true;\\n\");\n    let changed = harness.file_id(\"src/auth.ts\", \"hash-auth-v2\");\n    let report = harness.reverify_changed_file(\n        &changed,\n        \"const FLAG = false;\\n\",\n        ObservationRecorder::default(),\n    );\n    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n\n    assert_eq!(report.stale, 1);\n    assert_sections(&bundle, &memory_id, BundleSection::Stale);\n}\n\n#[test]\nfn test_contradicted_memory_never_appears_in_trusted_bundle() {\n    let mut harness = VerificationHarness::new();\n    let contradicted_id = harness.seed_plain_memory(\"mem-b\", \"The build never uses cargo check.\");\n    let _contradictor_id =\n        harness.seed_plain_memory(\"mem-a\", \"The build uses cargo check for verification.\");\n\n    harness.apply_contradiction(\"mem-b\", \"mem-a\");\n    let bundle = harness.bundle_for_ids(&[contradicted_id.as_str()]);\n\n    assert_sections(&bundle, &contradicted_id, BundleSection::Contradicted);\n}\n\n#[test]\nfn test_expired_memory_never_appears_in_trusted_bundle() {\n    let harness = VerificationHarness::new();\n    let memory_id = harness.seed_file_memory(\"mem-expired\", \"src/expiry.rs\");\n    harness\n        .memory_store\n        .set_expires_at(&memory_id, DateTime::from_unix_seconds(99))\n        .expect(\"expiry stores\");\n    harness.scan_expiry(DateTime::from_unix_seconds(100));\n    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n\n    assert_sections(&bundle, &memory_id, BundleSection::Expired);\n}\n\n#[test]\nfn test_invalidated_memory_never_appears_in_trusted_bundle() {\n    let harness = VerificationHarness::new();\n    let memory_id = harness.seed_file_memory(\"mem-invalidated\", \"src/delete-me.ts\");\n    harness.write_file(\"src/delete-me.ts\", \"export const alive = true;\\n\");\n    harness.delete_file(\"src/delete-me.ts\");\n    let deleted = harness.file_id(\"src/delete-me.ts\", \"hash-delete-v2\");\n    let report = harness.reverify_deleted_file(&deleted, ObservationRecorder::default());\n    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n\n    assert_eq!(report.invalidated, 1);\n    assert_sections(&bundle, &memory_id, BundleSection::Invalidated);\n}\n\n#[test]\nfn test_scope_leak_blocked_at_store_boundary_for_all_scopes() {\n    let harness = VerificationHarness::new();\n    let logs = Arc::new(Mutex::new(Vec::new()));\n    let subscriber = tracing_subscriber::fmt()\n        .with_writer(BufferWriter(logs.clone()))\n        .with_ansi(false)\n        .finish();\n    let _guard = tracing::subscriber::set_default(subscriber);\n\n    let ids = harness.seed_scope_leak_fixture();\n    let results = harness.run_scope_leak_queries();\n    let events = harness\n        .memory_store\n        .scope_filter_events()\n        .expect(\"scope events load\");\n    let log_output = String::from_utf8(logs.lock().expect(\"log lock\").clone()).expect(\"utf8\");\n\n    assert!(results.into_iter().all(|memory| memory.is_none()));\n    assert_eq!(events.len(), 4);\n    assert_eq!(\n        events\n            .iter()\n            .map(|event| event.memory_id.as_str())\n            .collect::<Vec<_>>(),\n        ids.iter().map(String::as_str).collect::<Vec<_>>()\n    );\n    assert!(log_output.contains(\"scope_leak_blocked\"));\n}\n\n#[test]\nfn test_ranker_excludes_non_verified_from_top_n() {\n    let harness = VerificationHarness::new();\n    let ids = harness.seed_ranker_fixture();\n    let ranked = ids\n        .iter()\n        .enumerate()\n        .map(|(index, id)| ranked_memory(id, 100.0 - index as f32))\n        .collect::<Vec<_>>();\n    let ctx = harness.scoring_context_for(&ids);\n\n    let trusted = SurfacingPipeline::trusted_ranked_top_n(ranked, &ctx, 5);\n\n    assert_eq!(trusted.len(), 1);\n    assert_eq!(\n        trusted[0].candidate.identity,\n        memory_identity(\"mem-verified\")\n    );\n}\n\n#[test]\nfn test_incremental_verification_narrows_to_changed_files_only() {\n    let harness = VerificationHarness::new();\n    let files = harness.seed_many_file_memories(100);\n    let changed = files[7].clone();\n    let observer = ObservationRecorder::default();\n    let report = harness.reverify_unchanged_content(&changed, &files, &observer);\n\n    assert_eq!(report.impacted, 1);\n    assert_eq!(observer.memory_ids(), vec![\"mem-007\"]);\n}\n\n#[test]\nfn test_verifier_emits_explainable_label_reason_for_every_non_verified_state() {\n    let harness = VerificationHarness::new();\n    let ids = harness.seed_explainable_reason_fixture();\n    let bundle = harness.bundle_for_ids(&ids.iter().map(String::as_str).collect::<Vec<_>>());\n\n    assert_eq!(bundle.advisory.len(), 7);\n    assert_reason_contains(\n        &bundle,\n        \"mem-unverified\",\n        \"scope mismatch workspace-main/main\",\n    );\n    assert_reason_contains(&bundle, \"mem-in-review\", \"file `src/review.rs`\");\n    assert_reason_contains(&bundle, \"mem-stale-reason\", \"span byte range 0..18\");\n    assert_reason_contains(&bundle, \"mem-contradicted-reason\", \"contradicted by mem-a\");\n    assert_reason_contains(&bundle, \"mem-superseded-reason\", \"superseded by mem-newer\");\n    assert_reason_contains(&bundle, \"mem-expired-reason\", \"expiry 2026-05-17T00:00:00Z\");\n    assert_reason_contains(&bundle, \"mem-invalidated-reason\", \"file id src/deleted.rs\");\n}\n\nstruct VerificationHarness {\n    _dir: tempfile::TempDir,\n    workspace_root: PathBuf,\n    runtime_db: PathBuf,\n    memory_store: MemoryStore,\n    _event_store: Arc<EventStore>,\n    event_writer: EventWriter,","numLines":200,"startLine":1,"totalLines":923}}}
