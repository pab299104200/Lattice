{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rb49bBhUuuyioKsoH6xyL1","type":"tool_result","content":"1\tuse std::cell::Cell;\n2\t\n3\tuse sha2::{Digest, Sha256};\n4\t\n5\tuse super::{\n6\t    SpanMismatchReason, SpanReader, SpanValidationError, SpanValidator, VerificationStatus,\n7\t};\n8\tuse crate::identity::FileId;\n9\tuse crate::memory::{EvidenceSpan, MemoryEvidence};\n10\t\n11\t#[test]\n12\tfn unchanged_content_at_span_returns_verified() {\n13\t    let file_id = file_id(\"src/auth.ts\");\n14\t    let source = b\"prefix\\nlet token = issue();\\nsuffix\\n\";\n15\t    let span_bytes = b\"let token = issue();\";\n16\t    let start = source\n17\t        .windows(span_bytes.len())\n18\t        .position(|window| window == span_bytes)\n19\t        .expect(\"span start\");\n20\t    let evidence = evidence_with_span(\n21\t        file_id,\n22\t        start as u32,\n23\t        (start + span_bytes.len()) as u32,\n24\t        2,\n25\t        2,\n26\t        span_bytes,\n27\t        \"let token = issue();\",\n28\t    );\n29\t\n30\t    let verdict = SpanValidator::validate(&evidence, source);\n31\t\n32\t    assert_eq!(verdict.status, VerificationStatus::Verified);\n33\t}\n34\t\n35\t#[test]\n36\tfn modified_content_at_span_returns_stale_content_changed() {\n37\t    let reader = MockSpanReader::new(\n38\t        Some(32),\n39\t        Some(b\"let token = refresh();\".to_vec()),\n40\t        Some(b\"let token = refresh();\\n\".to_vec()),\n41\t    );\n42\t    let evidence = evidence_with_span(\n43\t        file_id(\"src/auth.ts\"),\n44\t        0,\n45\t        20,\n46\t        1,\n47\t        1,\n48\t        b\"let token = issue();\",\n49\t        \"let token = issue();\",\n50\t    );\n51\t\n52\t    let verdict = SpanValidator::validate_with_reader(\"memory-1:evidence:0\", &evidence, &reader)\n53\t        .expect(\"span validation succeeds\");\n54\t\n55\t    assert_eq!(verdict.status, VerificationStatus::Stale);\n56\t    assert_eq!(reason(&verdict.reason).subkind, \"ContentChanged\");\n57\t}\n58\t\n59\t#[test]\n60\tfn truncated_file_below_span_returns_file_shrunk_below_span() {\n61\t    let reader = MockSpanReader::new(Some(8), None, None);\n62\t    let evidence = evidence_with_span(\n63\t        file_id(\"src/auth.ts\"),\n64\t        0,\n65\t        20,\n66\t        1,\n67\t        1,\n68\t        b\"let token = issue();\",\n69\t        \"let token = issue();\",\n70\t    );\n71\t\n72\t    let verdict = SpanValidator::validate_with_reader(\"memory-1:evidence:0\", &evidence, &reader)\n73\t        .expect(\"span validation succeeds\");\n74\t\n75\t    assert_eq!(verdict.status, VerificationStatus::Stale);\n76\t    assert_eq!(reason(&verdict.reason).subkind, \"FileShrunkBelowSpan\");\n77\t}\n78\t\n79\t#[test]\n80\tfn crlf_flip_is_reported_as_encoding_changed() {\n81\t    let reader = MockSpanReader::new(\n82\t        Some(32),\n83\t        Some(b\"alpha\\r\\nbeta\".to_vec()),\n84\t        Some(b\"\\xef\\xbb\\xbfalpha\\r\\nbeta\\r\\n\".to_vec()),\n85\t    );\n86\t    let evidence = evidence_with_span(\n87\t        file_id(\"src/auth.ts\"),\n88\t        0,\n89\t        10,\n90\t        1,\n91\t        2,\n92\t        b\"alpha\\nbeta\",\n93\t        \"alpha\\nbeta\\n\",\n94\t    );\n95\t\n96\t    let verdict = SpanValidator::validate_with_reader(\"memory-1:evidence:0\", &evidence, &reader)\n97\t        .expect(\"span validation succeeds\");\n98\t\n99\t    assert_eq!(verdict.status, VerificationStatus::Stale);\n100\t    assert_eq!(reason(&verdict.reason).subkind, \"EncodingChanged\");\n101\t}\n102\t\n103\t#[test]\n104\tfn evidence_without_span_is_a_verified_no_op() {\n105\t    let verdict = SpanValidator::validate(\n106\t        &MemoryEvidence {\n107\t            kind: \"file\".to_string(),\n108\t            reference: Some(\"src/auth.ts\".to_string()),\n109\t            detail: None,\n110\t            captured_at: Some(100),\n111\t            span: None,\n112\t            evidence_content_hash: None,\n113\t        },\n114\t        b\"irrelevant\",\n115\t    );\n116\t\n117\t    assert_eq!(verdict.status, VerificationStatus::Verified);\n118\t}\n119\t\n120\t#[test]\n121\tfn span_validation_never_reads_the_whole_file() {\n122\t    let reader = MockSpanReader::new(\n123\t        Some(10_000),\n124\t        Some(b\"issue\".to_vec()),\n125\t        Some(b\"issue\\n\".to_vec()),\n126\t    );\n127\t    let evidence = evidence_with_span(file_id(\"src/auth.ts\"), 120, 125, 10, 10, b\"issue\", \"issue\");\n128\t\n129\t    let verdict = SpanValidator::validate_with_reader(\"memory-1:evidence:0\", &evidence, &reader)\n130\t        .expect(\"span validation succeeds\");\n131\t\n132\t    assert_eq!(verdict.status, VerificationStatus::Verified);\n133\t    assert_eq!(reader.bytes_read(), 5);\n134\t    assert_eq!(reader.line_bytes_read(), 0);\n135\t}\n136\t\n137\tfn file_id(path: &str) -> FileId {\n138\t    FileId {\n139\t        workspace_id: \"workspace-main\".to_string(),\n140\t        repo_relative_path: path.to_string(),\n141\t        content_hash: \"deadbeef\".to_string(),\n142\t    }\n143\t}\n144\t\n145\tfn evidence_with_span(\n146\t    file_id: FileId,\n147\t    byte_start: u32,\n148\t    byte_end: u32,\n149\t    line_start: u32,\n150\t    line_end: u32,\n151\t    bytes: &[u8],\n152\t    detail: &str,\n153\t) -> MemoryEvidence {\n154\t    MemoryEvidence {\n155\t        kind: \"file\".to_string(),\n156\t        reference: Some(file_id.repo_relative_path.clone()),\n157\t        detail: Some(detail.to_string()),\n158\t        captured_at: Some(100),\n159\t        span: Some(EvidenceSpan {\n160\t            file_id,\n161\t            byte_start,\n162\t            byte_end,\n163\t            line_start,\n164\t            line_end,\n165\t        }),\n166\t        evidence_content_hash: Some(hash(bytes)),\n167\t    }\n168\t}\n169\t\n170\tfn hash(bytes: &[u8]) -> [u8; 32] {\n171\t    let digest = Sha256::digest(bytes);\n172\t    let mut value = [0; 32];\n173\t    value.copy_from_slice(&digest);\n174\t    value\n175\t}\n176\t\n177\tfn reason(value: &str) -> SpanMismatchReason {\n178\t    serde_json::from_str(value).expect(\"reason payload parses\")\n179\t}\n180\t\n181\tstruct MockSpanReader {\n182\t    file_len: Option<u64>,\n183\t    range_bytes: Option<Vec<u8>>,\n184\t    line_bytes: Option<Vec<u8>>,\n185\t    bytes_read: Cell<usize>,\n186\t    line_bytes_read: Cell<usize>,\n187\t}\n188\t\n189\timpl MockSpanReader {\n190\t    fn new(\n191\t        file_len: Option<u64>,\n192\t        range_bytes: Option<Vec<u8>>,\n193\t        line_bytes: Option<Vec<u8>>,\n194\t    ) -> Self {\n195\t        Self {\n196\t            file_len,\n197\t            range_bytes,\n198\t            line_bytes,\n199\t            bytes_read: Cell::new(0),\n200\t            line_bytes_read: Cell::new(0),\n201\t        }\n202\t    }\n203\t\n204\t    fn bytes_read(&self) -> usize {\n205\t        self.bytes_read.get()\n206\t    }\n207\t\n208\t    fn line_bytes_read(&self) -> usize {\n209\t        self.line_bytes_read.get()\n210\t    }\n211\t}\n212\t\n213\timpl SpanReader for MockSpanReader {\n214\t    fn file_len(&self, _file_id: &FileId) -> Result<Option<u64>, SpanValidationError> {\n215\t        Ok(self.file_len)\n216\t    }\n217\t\n218\t    fn read_range(\n219\t        &self,\n220\t        _file_id: &FileId,\n221\t        _start: u32,\n222\t        _end: u32,\n223\t    ) -> Result<Option<Vec<u8>>, SpanValidationError> {\n224\t        if let Some(bytes) = self.range_bytes.as_ref() {\n225\t            self.bytes_read.set(self.bytes_read.get() + bytes.len());\n226\t        }\n227\t        Ok(self.range_bytes.clone())\n228\t    }\n229\t\n230\t    fn read_line_span(\n231\t        &self,\n232\t        _file_id: &FileId,\n233\t        _line_start: u32,\n234\t        _line_end: u32,\n235\t    ) -> Result<Option<Vec<u8>>, SpanValidationError> {\n236\t        if let Some(bytes) = self.line_bytes.as_ref() {\n237\t            self.line_bytes_read\n238\t                .set(self.line_bytes_read.get() + bytes.len());\n239\t        }\n240\t        Ok(self.line_bytes.clone())\n241\t    }\n242\t}\n243\t"}]},"parent_tool_use_id":null,"session_id":"0696e093-0770-442b-8dc9-5393bbfcd0b6","uuid":"adc823f4-d72b-49c4-887a-00001510d706","timestamp":"2026-05-17T13:03:13.771Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/spans_tests.rs","content":"use std::cell::Cell;\n\nuse sha2::{Digest, Sha256};\n\nuse super::{\n    SpanMismatchReason, SpanReader, SpanValidationError, SpanValidator, VerificationStatus,\n};\nuse crate::identity::FileId;\nuse crate::memory::{EvidenceSpan, MemoryEvidence};\n\n#[test]\nfn unchanged_content_at_span_returns_verified() {\n    let file_id = file_id(\"src/auth.ts\");\n    let source = b\"prefix\\nlet token = issue();\\nsuffix\\n\";\n    let span_bytes = b\"let token = issue();\";\n    let start = source\n        .windows(span_bytes.len())\n        .position(|window| window == span_bytes)\n        .expect(\"span start\");\n    let evidence = evidence_with_span(\n        file_id,\n        start as u32,\n        (start + span_bytes.len()) as u32,\n        2,\n        2,\n        span_bytes,\n        \"let token = issue();\",\n    );\n\n    let verdict = SpanValidator::validate(&evidence, source);\n\n    assert_eq!(verdict.status, VerificationStatus::Verified);\n}\n\n#[test]\nfn modified_content_at_span_returns_stale_content_changed() {\n    let reader = MockSpanReader::new(\n        Some(32),\n        Some(b\"let token = refresh();\".to_vec()),\n        Some(b\"let token = refresh();\\n\".to_vec()),\n    );\n    let evidence = evidence_with_span(\n        file_id(\"src/auth.ts\"),\n        0,\n        20,\n        1,\n        1,\n        b\"let token = issue();\",\n        \"let token = issue();\",\n    );\n\n    let verdict = SpanValidator::validate_with_reader(\"memory-1:evidence:0\", &evidence, &reader)\n        .expect(\"span validation succeeds\");\n\n    assert_eq!(verdict.status, VerificationStatus::Stale);\n    assert_eq!(reason(&verdict.reason).subkind, \"ContentChanged\");\n}\n\n#[test]\nfn truncated_file_below_span_returns_file_shrunk_below_span() {\n    let reader = MockSpanReader::new(Some(8), None, None);\n    let evidence = evidence_with_span(\n        file_id(\"src/auth.ts\"),\n        0,\n        20,\n        1,\n        1,\n        b\"let token = issue();\",\n        \"let token = issue();\",\n    );\n\n    let verdict = SpanValidator::validate_with_reader(\"memory-1:evidence:0\", &evidence, &reader)\n        .expect(\"span validation succeeds\");\n\n    assert_eq!(verdict.status, VerificationStatus::Stale);\n    assert_eq!(reason(&verdict.reason).subkind, \"FileShrunkBelowSpan\");\n}\n\n#[test]\nfn crlf_flip_is_reported_as_encoding_changed() {\n    let reader = MockSpanReader::new(\n        Some(32),\n        Some(b\"alpha\\r\\nbeta\".to_vec()),\n        Some(b\"\\xef\\xbb\\xbfalpha\\r\\nbeta\\r\\n\".to_vec()),\n    );\n    let evidence = evidence_with_span(\n        file_id(\"src/auth.ts\"),\n        0,\n        10,\n        1,\n        2,\n        b\"alpha\\nbeta\",\n        \"alpha\\nbeta\\n\",\n    );\n\n    let verdict = SpanValidator::validate_with_reader(\"memory-1:evidence:0\", &evidence, &reader)\n        .expect(\"span validation succeeds\");\n\n    assert_eq!(verdict.status, VerificationStatus::Stale);\n    assert_eq!(reason(&verdict.reason).subkind, \"EncodingChanged\");\n}\n\n#[test]\nfn evidence_without_span_is_a_verified_no_op() {\n    let verdict = SpanValidator::validate(\n        &MemoryEvidence {\n            kind: \"file\".to_string(),\n            reference: Some(\"src/auth.ts\".to_string()),\n            detail: None,\n            captured_at: Some(100),\n            span: None,\n            evidence_content_hash: None,\n        },\n        b\"irrelevant\",\n    );\n\n    assert_eq!(verdict.status, VerificationStatus::Verified);\n}\n\n#[test]\nfn span_validation_never_reads_the_whole_file() {\n    let reader = MockSpanReader::new(\n        Some(10_000),\n        Some(b\"issue\".to_vec()),\n        Some(b\"issue\\n\".to_vec()),\n    );\n    let evidence = evidence_with_span(file_id(\"src/auth.ts\"), 120, 125, 10, 10, b\"issue\", \"issue\");\n\n    let verdict = SpanValidator::validate_with_reader(\"memory-1:evidence:0\", &evidence, &reader)\n        .expect(\"span validation succeeds\");\n\n    assert_eq!(verdict.status, VerificationStatus::Verified);\n    assert_eq!(reader.bytes_read(), 5);\n    assert_eq!(reader.line_bytes_read(), 0);\n}\n\nfn file_id(path: &str) -> FileId {\n    FileId {\n        workspace_id: \"workspace-main\".to_string(),\n        repo_relative_path: path.to_string(),\n        content_hash: \"deadbeef\".to_string(),\n    }\n}\n\nfn evidence_with_span(\n    file_id: FileId,\n    byte_start: u32,\n    byte_end: u32,\n    line_start: u32,\n    line_end: u32,\n    bytes: &[u8],\n    detail: &str,\n) -> MemoryEvidence {\n    MemoryEvidence {\n        kind: \"file\".to_string(),\n        reference: Some(file_id.repo_relative_path.clone()),\n        detail: Some(detail.to_string()),\n        captured_at: Some(100),\n        span: Some(EvidenceSpan {\n            file_id,\n            byte_start,\n            byte_end,\n            line_start,\n            line_end,\n        }),\n        evidence_content_hash: Some(hash(bytes)),\n    }\n}\n\nfn hash(bytes: &[u8]) -> [u8; 32] {\n    let digest = Sha256::digest(bytes);\n    let mut value = [0; 32];\n    value.copy_from_slice(&digest);\n    value\n}\n\nfn reason(value: &str) -> SpanMismatchReason {\n    serde_json::from_str(value).expect(\"reason payload parses\")\n}\n\nstruct MockSpanReader {\n    file_len: Option<u64>,\n    range_bytes: Option<Vec<u8>>,\n    line_bytes: Option<Vec<u8>>,\n    bytes_read: Cell<usize>,\n    line_bytes_read: Cell<usize>,\n}\n\nimpl MockSpanReader {\n    fn new(\n        file_len: Option<u64>,\n        range_bytes: Option<Vec<u8>>,\n        line_bytes: Option<Vec<u8>>,\n    ) -> Self {\n        Self {\n            file_len,\n            range_bytes,\n            line_bytes,\n            bytes_read: Cell::new(0),\n            line_bytes_read: Cell::new(0),\n        }\n    }\n\n    fn bytes_read(&self) -> usize {\n        self.bytes_read.get()\n    }\n\n    fn line_bytes_read(&self) -> usize {\n        self.line_bytes_read.get()\n    }\n}\n\nimpl SpanReader for MockSpanReader {\n    fn file_len(&self, _file_id: &FileId) -> Result<Option<u64>, SpanValidationError> {\n        Ok(self.file_len)\n    }\n\n    fn read_range(\n        &self,\n        _file_id: &FileId,\n        _start: u32,\n        _end: u32,\n    ) -> Result<Option<Vec<u8>>, SpanValidationError> {\n        if let Some(bytes) = self.range_bytes.as_ref() {\n            self.bytes_read.set(self.bytes_read.get() + bytes.len());\n        }\n        Ok(self.range_bytes.clone())\n    }\n\n    fn read_line_span(\n        &self,\n        _file_id: &FileId,\n        _line_start: u32,\n        _line_end: u32,\n    ) -> Result<Option<Vec<u8>>, SpanValidationError> {\n        if let Some(bytes) = self.line_bytes.as_ref() {\n            self.line_bytes_read\n                .set(self.line_bytes_read.get() + bytes.len());\n        }\n        Ok(self.line_bytes.clone())\n    }\n}\n","numLines":243,"startLine":1,"totalLines":243}}}
