moryStore::open(&dir.path().join(\"memory.sqlite\")).expect(\"memory store\");\n200\t        let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store\"));\n201\t        let event_writer =\n202\t            EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n203\t                .with_flush_policy(FlushPolicy::Sync);\n204\t        Self {\n205\t            workspace_root: dir.path().to_path_buf(),\n206\t            runtime_db: dir.path().join(\"verification.sqlite\"),\n207\t            _dir: dir,\n208\t            memory_store,\n209\t            _event_store: event_store,\n210\t            _event_writer: event_writer,\n211\t        }\n212\t    }\n213\t\n214\t    fn file_id(&self, path: &str, content_hash: &str) -> FileId {\n215\t        FileId {\n216\t            workspace_id: \"workspace-main\".to_string(),\n217\t            repo_relative_path: path.to_string(),\n218\t            content_hash: content_hash.to_string(),\n219\t        }\n220\t    }\n221\t\n222\t    fn symbol_id(\n223\t        &self,\n224\t        file: &FileId,\n225\t        qualified_name: &str,\n226\t        byte_offset: usize,\n227\t        kind: &str,\n228\t    ) -> SymbolId {\n229\t        SymbolId {\n230\t            file: file.clone(),\n231\t            qualified_name: qualified_name.to_string(),\n232\t            byte_offset,\n233\t            kind: kind.to_string(),\n234\t        }\n235\t    }\n236\t\n237\t    fn seed_memory(&self, id: &str, evidence: Vec<MemoryEvidence>) -> String {\n238\t        let memory = Memory {\n239\t            id: id.to_string(),\n240\t            session_id: \"session-main\".to_string(),\n241\t            content: format!(\"memory {id}\"),\n242\t            memory_type: MemoryType::Observation,\n243\t            scope: MemoryScope::Branch,\n244\t            confidence: 0.8,\n245\t            linked_symbols: Vec::new(),\n246\t            linked_files: Vec::new(),\n247\t            workspace_id: Some(\"workspace-main\".to_s