{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LPrKcL87kddYz9Evqeyk4f","type":"tool_result","content":"1\tuse std::collections::BTreeMap;\n2\t\n3\tuse crate::identity::{Identity, MemoryId};\n4\tuse crate::memory::{Memory, MemoryScope, MemoryType, MemoryVerificationStatus};\n5\tuse crate::retrieval_v1::{\n6\t    Candidate, CandidateSource, MemoryScoringMetadata, RankedCandidate, ScoringContext,\n7\t};\n8\tuse crate::verification::surfacing::{\n9\t    classify_status, BundleSection, LabeledMemory, SurfacingPipeline,\n10\t};\n11\t\n12\t#[test]\n13\tfn verified_memories_land_in_trusted_and_all_other_states_are_advisory() {\n14\t    let memories = all_statuses()\n15\t        .into_iter()\n16\t        .map(|status| memory_for_status(status, status.as_str()))\n17\t        .collect::<Vec<_>>();\n18\t\n19\t    let bundle = SurfacingPipeline::partition(memories);\n20\t\n21\t    assert_eq!(bundle.trusted.len(), 1);\n22\t    assert_eq!(bundle.trusted[0].section, BundleSection::Trusted);\n23\t\n24\t    let advisory_sections = bundle\n25\t        .advisory\n26\t        .iter()\n27\t        .map(|memory| memory.section)\n28\t        .collect::<Vec<_>>();\n29\t    assert_eq!(\n30\t        advisory_sections,\n31\t        vec![\n32\t            BundleSection::Unverified,\n33\t            BundleSection::InReview,\n34\t            BundleSection::Stale,\n35\t            BundleSection::Contradicted,\n36\t            BundleSection::Superseded,\n37\t            BundleSection::Expired,\n38\t            BundleSection::Invalidated,\n39\t        ]\n40\t    );\n41\t}\n42\t\n43\t#[cfg(debug_assertions)]\n44\t#[test]\n45\t#[should_panic(expected = \"stale_in_trusted_bundle\")]\n46\tfn debug_assertion_fires_when_non_trusted_memory_is_injected_into_trusted() {\n47\t    let mut trusted = vec![LabeledMemory {\n48\t        memory_id: MemoryId {\n49\t            workspace_id: \"workspace\".to_string(),\n50\t            ulid: \"stale-memory\".to_string(),\n51\t        },\n52\t        section: BundleSection::Stale,\n53\t        label_reason: \"stale verifier label\".to_string(),\n54\t        content: \"stale guidance\".to_string(),\n55\t    }];\n56\t\n57\t    SurfacingPipeline::enforce_trusted_invariant_for_test(&mut trusted, module_path!());\n58\t}\n59\t\n60\t#[test]\n61\tfn label_reason_is_non_empty_and_uses_verifier_reason_scope_file_and_expiry() {\n62\t    let memory = memory_for_status(\n63\t        MemoryVerificationStatus::Expired,\n64\t        \"file `src/foo.rs` line 42 changed; expiry 2026-04-01\",\n65\t    );\n66\t\n67\t    let bundle = SurfacingPipeline::partition(vec![memory]);\n68\t    let reason = &bundle.advisory[0].label_reason;\n69\t\n70\t    assert!(reason.contains(\"file `src/foo.rs` line 42 changed\"));\n71\t    assert!(reason.contains(\"expiry 2026-04-01\"));\n72\t    assert!(reason.contains(\"scope branch `main`\"));\n73\t    assert!(reason.contains(\"file `src/foo.rs`\"));\n74\t}\n75\t\n76\t#[test]\n77\tfn ranker_top_n_excludes_every_non_verified_memory_regardless_of_score() {\n78\t    let verified = ranked_memory(\"verified\", 1.0);\n79\t    let stale = ranked_memory(\"stale\", 100.0);\n80\t    let contradicted = ranked_memory(\"contradicted\", 90.0);\n81\t    let ctx = scoring_context([\n82\t        (\"verified\", MemoryVerificationStatus::Verified),\n83\t        (\"stale\", MemoryVerificationStatus::Stale),\n84\t        (\"contradicted\", MemoryVerificationStatus::Contradicted),\n85\t    ]);\n86\t\n87\t    let trusted =\n88\t        SurfacingPipeline::trusted_ranked_top_n(vec![stale, contradicted, verified], &ctx, 10);\n89\t\n90\t    assert_eq!(trusted.len(), 1);\n91\t    assert_eq!(trusted[0].candidate.identity, memory_identity(\"verified\"));\n92\t}\n93\t\n94\t#[test]\n95\tfn classify_covers_all_verification_status_variants() {\n96\t    let sections = all_statuses()\n97\t        .into_iter()\n98\t        .map(|status| classify_status(&status))\n99\t        .collect::<Vec<_>>();\n100\t\n101\t    assert_eq!(\n1