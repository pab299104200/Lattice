{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ypF7FmocKS4jigvUhSVG6","type":"tool_result","content":"1\t//! Memory surfacing discipline for workflow bundles.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## Non-Negotiable Product Properties` requires:\n5\t//! \"Every stale or contradicted memory is surfaced as such, not hidden behind recency.\"\n6\t//!\n7\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n8\t//! `## 8. Verification Engine` defines the verification outputs:\n9\t//! `verified`, `unverified`, `in_review`, `stale`, `contradicted`,\n10\t//! `superseded`, `expired`, and `invalidated`.\n11\t//!\n12\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n13\t//! `## Risks — Stale Memory Leakage` names the control:\n14\t//! \"freshness indexes, graph-change-triggered verification, stale labels\n15\t//! in all memory surfaces, and tests that stale memory cannot rank as trusted.\"\n16\t\n17\tuse serde::{Deserialize, Serialize};\n18\tuse tracing::{debug, error};\n19\t\n20\tuse crate::identity::{Identity, MemoryId};\n21\tuse crate::memory::{Memory, MemoryScope, MemoryVerificationStatus};\n22\tuse crate::retrieval_v1::{RankedCandidate, ScoringContext};\n23\t\n24\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n25\t#[serde(rename_all = \"snake_case\")]\n26\tpub enum BundleSection {\n27\t    Trusted,\n28\t    Stale,\n29\t    Contradicted,\n30\t    Superseded,\n31\t    Expired,\n32\t    Invalidated,\n33\t    InReview,\n34\t    Unverified,\n35\t}\n36\t\n37\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n38\tpub struct LabeledMemory {\n39\t    pub memory_id: MemoryId,\n40\t    pub section: BundleSection,\n41\t    pub label_reason: String,\n42\t    pub content: String,\n43\t}\n44\t\n45\t#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\n46\tpub struct SurfacedBundle {\n47\t    pub trusted: Vec<LabeledMemory>,\n48\t    pub advisory: Vec<LabeledMemory>,\n49\t}\n50\t\n51\t#[derive(Clone, Debug, PartialEq, Eq)]\n52\tpub enum SurfacingError {\n53\t    RankerIntegrationNotInitialized { memory_id: String },\n54\t}\n55\t\n56\tpub trait BundleProducer {\n57\t    fn surface(memories: Vec<Memory>) -> SurfacedBundle;\n58\t}\n59\t\n60\tpub struct SurfacingPipeline;\n61\t\n62\timpl BundleProducer for SurfacingPipeline {\n63\t    fn surface(memories: Vec<Memory>) -> SurfacedBundle {\n64\t        Self::partition(memories)\n65\t    }\n66\t}\n67\t\n68\timpl SurfacingPipeline {\n69\t    pub fn partition(memories: Vec<Memory>) -> SurfacedBundle {\n70\t        Self::partition_for_caller(memories, module_path!())\n71\t    }\n72\t\n73\t    pub fn partition_for_caller(\n74\t        memories: Vec<Memory>,\n75\t        caller_module: &'static str,\n76\t    ) -> SurfacedBundle {\n77\t        let mut trusted = Vec::new();\n78\t        let mut advisory = Vec::new();\n79\t\n80\t        for memory in memories {\n81\t            let labeled = Self::label(memory);\n82\t            if labeled.section == BundleSection::Trusted {\n83\t                trusted.push(labeled);\n84\t            } else {\n85\t                advisory.push(labeled);\n86\t            }\n87\t        }\n88\t\n89\t        Self::enforce_trusted_invariant(&mut trusted, caller_module);\n90\t        debug!(\n91\t            caller_module,\n92\t            trusted_count = trusted.len(),\n93\t            advisory_count = advisory.len(),\n94\t            \"surfaced memory bundle partitioned\"\n95\t        );\n96\t        SurfacedBundle { trusted, advisory }\n97\t    }\n98\t\n99\t    pub fn classify(memory: &Memory) -> BundleSection {\n100\t        classify_status(&memory.verification_status)\n101\t    }\n102\t\n103\t    pub fn format_reason(memory: &Memory, section: BundleSection) -> String {\n104\t        let status = memory.verification_status.as_str();\n105\t        let evidence = evidence_reason(memory);\n106\t        match section {\n107\t            BundleSection::Trusted => format!(\"Verified memory; {evidence}\"),\n108\t            BundleSection::Stale => format!(\"Stale memory ({status}); {evidence}\"),\n109\t            BundleSection::Contradicted => format!(\"Contradicted memory ({status}); {evidence}\"),\n110\t            BundleSection::Superseded => format!(\"Superseded memory ({status}); {evidence}\"),\n111\t            BundleSection::Expired => format!(\"Expired memory ({status}); {evidence}\"),\n112\t            BundleSection::Invalidated => format!(\"Invalidated memory ({status}); {evidence}\"),\n113\t            BundleSection::InReview => format!(\"Memory is still in review ({status}); {evidence}\"),\n114\t            BundleSection::Unverified => format!(\"Unverified memory ({status}); {evidence}\"),\n115\t        }\n116\t    }\n117\t\n118\t    pub fn trusted_ranked_top_n(\n119\t        ranked: Vec<RankedCandidate>,\n120\t        ctx: &ScoringContext,\n121\t        top_n: usize,\n122\t    ) -> Vec<RankedCandidate> {\n123\t        ranked\n124\t            .into_iter()\n125\t            .filter(|candidate| ranked_candidate_is_trusted_memory(candidate, ctx))\n126\t            .take(top_n)\n127\t            .collect()\n128\t    }\n129\t\n130\t    #[cfg(test)]\n131\t    pub(crate) fn enforce_trusted_invariant_for_test(\n132\t        trusted: &mut Vec<LabeledMemory>,\n133\t        caller_module: &'static str,\n134\t    ) {\n135\t        Self::enforce_trusted_invariant(trusted, caller_module);\n136\t    }\n137\t\n138\t    fn label(memory: Memory) -> LabeledMemory {\n139\t        let section = Self::classify(&memory);\n140\t        let label_reason = Self::format_reason(&memory, section);\n141\t        LabeledMemory {\n142\t            memory_id: memory_id(&memory),\n143\t            section,\n144\t            label_reason,\n145\t            content: memory.content,\n146\t        }\n147\t    }\n148\t\n149\t    fn enforce_trusted_invariant(trusted: &mut Vec<LabeledMemory>, caller_module: &'static str) {\n150\t        #[cfg(debug_assertions)]\n151\t        {\n152\t            if let Some(leaked) = trusted\n153\t                .iter()\n154\t                .find(|memory| memory.section != BundleSection::Trusted)\n155\t            {\n156\t                panic!(\n157\t                    \"stale_in_trusted_bundle memory_id={} status={:?} caller_module={}\",\n158\t                    leaked.memory_id, leaked.section, caller_module\n159\t                );\n160\t            }\n161\t        }\n162\t\n163\t        #[cfg(not(debug_assertions))]\n164\t        {\n165\t            trusted.retain(|memory| {\n166\t                let is_trusted = memory.section == BundleSection::Trusted;\n167\t                if !is_trusted {\n168\t                    error!(\n169\t                        memory_id = %memory.memory_id,\n170\t                        status = ?memory.section,\n171\t                        caller_module,\n172\t                        \"stale_in_trusted_bundle\"\n173\t                    );\n174\t                }\n175\t                is_trusted\n176\t            });\n177\t        }\n178\t    }\n179\t}\n180\t\n181\tpub fn classify_status(status: &MemoryVerificationStatus) -> BundleSection {\n182\t    match status {\n183\t        MemoryVerificationStatus::Verified => BundleSection::Trusted,\n184\t        MemoryVerificationStatus::Unverified => BundleSection::Unverified,\n185\t        MemoryVerificationStatus::InReview => BundleSection::InReview,\n186\t        MemoryVerificationStatus::Stale => BundleSection::Stale,\n187\t        MemoryVerificationStatus::Contradicted => BundleSection::Contradicted,\n188\t        MemoryVerificationStatus::Superseded => BundleSection::Superseded,\n189\t        MemoryVerificationStatus::Expired => BundleSection::Expired,\n190\t        MemoryVerificationStatus::Invalidated => BundleSection::Invalidated,\n191\t    }\n192\t}\n193\t\n194\tfn ranked_candidate_is_trusted_memory(candidate: &RankedCandidate, ctx: &ScoringContext) -> bool {\n195\t    let Identity::Memory(memory_id) = &candidate.candidate.identity else {\n196\t        return true;\n197\t    };\n198\t    ctx.memory_metadata\n199\t        .get(&candidate.candidate.identity.to_string())\n200\t        .map(|metadata| metadata.verification_status == MemoryVerificationStatus::Verified)\n201\t        .unwrap_or_else(|| {\n202\t            error!(\n203\t                memory_id = %memory_id,\n204\t                \"ranker_integration_not_initialized\"\n205\t            );\n206\t            false\n207\t        })\n208\t}\n209\t\n210\tfn memory_id(memory: &Memory) -> MemoryId {\n211\t    MemoryId {\n212\t        workspace_id: memory\n213\t            .workspace_id\n214\t            .clone()\n215\t            .unwrap_or_else(|| \"unknown\".to_string()),\n216\t        ulid: memory.id.clone(),\n217\t    }\n218\t}\n219\t\n220\tfn evidence_reason(memory: &Memory) -> String {\n221\t    let stale_reason = memory\n222\t        .stale_reason\n223\t        .as_deref()\n224\t        .unwrap_or(\"no verifier reason recorded\");\n225\t    let location = memory\n226\t        .linked_files\n227\t        .first()\n228\t        .map(|file| format!(\"file `{file}`\"))\n229\t        .unwrap_or_else(|| \"no linked file\".to_string());\n230\t    let scope = format_scope(&memory.scope, memory.branch.as_deref());\n231\t    format!(\"{stale_reason}; {location}; {scope}\")\n232\t}\n233\t\n234\tfn format_scope(scope: &MemoryScope, branch: Option<&str>) -> String {\n235\t    match (scope, branch) {\n236\t        (MemoryScope::Branch, Some(branch)) => format!(\"scope branch `{branch}`\"),\n237\t        (MemoryScope::Branch, None) => \"scope branch\".to_string(),\n238\t        (MemoryScope::Session, _) => \"scope session\".to_string(),\n239\t        (MemoryScope::Repo, _) => \"scope repo\".to_string(),\n240\t        (MemoryScope::Organization, _) => \"scope organization\".to_string(),\n241\t    }\n242\t}\n243\t"}]},"parent_tool_use_id":null,"session_id":"0696e093-0770-442b-8dc9-5393bbfcd0b6","uuid":"e19f7a4d-a6ef-4b97-84bc-b1bf9dccff05","timestamp":"2026-05-17T13:01:36.535Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/surfacing.rs","content":"//! Memory surfacing discipline for workflow bundles.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Non-Negotiable Product Properties` requires:\n//! \"Every stale or contradicted memory is surfaced as such, not hidden behind recency.\"\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 8. Verification Engine` defines the verification outputs:\n//! `verified`, `unverified`, `in_review`, `stale`, `contradicted`,\n//! `superseded`, `expired`, and `invalidated`.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Risks — Stale Memory Leakage` names the control:\n//! \"freshness indexes, graph-change-triggered verification, stale labels\n//! in all memory surfaces, and tests that stale memory cannot rank as trusted.\"\n\nuse serde::{Deserialize, Serialize};\nuse tracing::{debug, error};\n\nuse crate::identity::{Identity, MemoryId};\nuse crate::memory::{Memory, MemoryScope, MemoryVerificationStatus};\nuse crate::retrieval_v1::{RankedCandidate, ScoringContext};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum BundleSection {\n    Trusted,\n    Stale,\n    Contradicted,\n    Superseded,\n    Expired,\n    Invalidated,\n    InReview,\n    Unverified,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct LabeledMemory {\n    pub memory_id: MemoryId,\n    pub section: BundleSection,\n    pub label_reason: String,\n    pub content: String,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub struct SurfacedBundle {\n    pub trusted: Vec<LabeledMemory>,\n    pub advisory: Vec<LabeledMemory>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum SurfacingError {\n    RankerIntegrationNotInitialized { memory_id: String },\n}\n\npub trait BundleProducer {\n    fn surface(memories: Vec<Memory>) -> SurfacedBundle;\n}\n\npub struct SurfacingPipeline;\n\nimpl BundleProducer for SurfacingPipeline {\n    fn surface(memories: Vec<Memory>) -> SurfacedBundle {\n        Self::partition(memories)\n    }\n}\n\nimpl SurfacingPipeline {\n    pub fn partition(memories: Vec<Memory>) -> SurfacedBundle {\n        Self::partition_for_caller(memories, module_path!())\n    }\n\n    pub fn partition_for_caller(\n        memories: Vec<Memory>,\n        caller_module: &'static str,\n    ) -> SurfacedBundle {\n        let mut trusted = Vec::new();\n        let mut advisory = Vec::new();\n\n        for memory in memories {\n            let labeled = Self::label(memory);\n            if labeled.section == BundleSection::Trusted {\n                trusted.push(labeled);\n            } else {\n                advisory.push(labeled);\n            }\n        }\n\n        Self::enforce_trusted_invariant(&mut trusted, caller_module);\n        debug!(\n            caller_module,\n            trusted_count = trusted.len(),\n            advisory_count = advisory.len(),\n            \"surfaced memory bundle partitioned\"\n        );\n        SurfacedBundle { trusted, advisory }\n    }\n\n    pub fn classify(memory: &Memory) -> BundleSection {\n        classify_status(&memory.verification_status)\n    }\n\n    pub fn format_reason(memory: &Memory, section: BundleSection) -> String {\n        let status = memory.verification_status.as_str();\n        let evidence = evidence_reason(memory);\n        match section {\n            BundleSection::Trusted => format!(\"Verified memory; {evidence}\"),\n            BundleSection::Stale => format!(\"Stale memory ({status}); {evidence}\"),\n            BundleSection::Contradicted => format!(\"Contradicted memory ({status}); {evidence}\"),\n            BundleSection::Superseded => format!(\"Superseded memory ({status}); {evidence}\"),\n            BundleSection::Expired => format!(\"Expired memory ({status}); {evidence}\"),\n            BundleSection::Invalidated => format!(\"Invalidated memory ({status}); {evidence}\"),\n            BundleSection::InReview => format!(\"Memory is still in review ({status}); {evidence}\"),\n            BundleSection::Unverified => format!(\"Unverified memory ({status}); {evidence}\"),\n        }\n    }\n\n    pub fn trusted_ranked_top_n(\n        ranked: Vec<RankedCandidate>,\n        ctx: &ScoringContext,\n        top_n: usize,\n    ) -> Vec<RankedCandidate> {\n        ranked\n            .into_iter()\n            .filter(|candidate| ranked_candidate_is_trusted_memory(candidate, ctx))\n            .take(top_n)\n            .collect()\n    }\n\n    #[cfg(test)]\n    pub(crate) fn enforce_trusted_invariant_for_test(\n        trusted: &mut Vec<LabeledMemory>,\n        caller_module: &'static str,\n    ) {\n        Self::enforce_trusted_invariant(trusted, caller_module);\n    }\n\n    fn label(memory: Memory) -> LabeledMemory {\n        let section = Self::classify(&memory);\n        let label_reason = Self::format_reason(&memory, section);\n        LabeledMemory {\n            memory_id: memory_id(&memory),\n            section,\n            label_reason,\n            content: memory.content,\n        }\n    }\n\n    fn enforce_trusted_invariant(trusted: &mut Vec<LabeledMemory>, caller_module: &'static str) {\n        #[cfg(debug_assertions)]\n        {\n            if let Some(leaked) = trusted\n                .iter()\n                .find(|memory| memory.section != BundleSection::Trusted)\n            {\n                panic!(\n                    \"stale_in_trusted_bundle memory_id={} status={:?} caller_module={}\",\n                    leaked.memory_id, leaked.section, caller_module\n                );\n            }\n        }\n\n        #[cfg(not(debug_assertions))]\n        {\n            trusted.retain(|memory| {\n                let is_trusted = memory.section == BundleSection::Trusted;\n                if !is_trusted {\n                    error!(\n                        memory_id = %memory.memory_id,\n                        status = ?memory.section,\n                        caller_module,\n                        \"stale_in_trusted_bundle\"\n                    );\n                }\n                is_trusted\n            });\n        }\n    }\n}\n\npub fn classify_status(status: &MemoryVerificationStatus) -> BundleSection {\n    match status {\n        MemoryVerificationStatus::Verified => BundleSection::Trusted,\n        MemoryVerificationStatus::Unverified => BundleSection::Unverified,\n        MemoryVerificationStatus::InReview => BundleSection::InReview,\n        MemoryVerificationStatus::Stale => BundleSection::Stale,\n        MemoryVerificationStatus::Contradicted => BundleSection::Contradicted,\n        MemoryVerificationStatus::Superseded => BundleSection::Superseded,\n        MemoryVerificationStatus::Expired => BundleSection::Expired,\n        MemoryVerificationStatus::Invalidated => BundleSection::Invalidated,\n    }\n}\n\nfn ranked_candidate_is_trusted_memory(candidate: &RankedCandidate, ctx: &ScoringContext) -> bool {\n    let Identity::Memory(memory_id) = &candidate.candidate.identity else {\n        return true;\n    };\n    ctx.memory_metadata\n        .get(&candidate.candidate.identity.to_string())\n        .map(|metadata| metadata.verification_status == MemoryVerificationStatus::Verified)\n        .unwrap_or_else(|| {\n            error!(\n                memory_id = %memory_id,\n                \"ranker_integration_not_initialized\"\n            );\n            false\n        })\n}\n\nfn memory_id(memory: &Memory) -> MemoryId {\n    MemoryId {\n        workspace_id: memory\n            .workspace_id\n            .clone()\n            .unwrap_or_else(|| \"unknown\".to_string()),\n        ulid: memory.id.clone(),\n    }\n}\n\nfn evidence_reason(memory: &Memory) -> String {\n    let stale_reason = memory\n        .stale_reason\n        .as_deref()\n        .unwrap_or(\"no verifier reason recorded\");\n    let location = memory\n        .linked_files\n        .first()\n        .map(|file| format!(\"file `{file}`\"))\n        .unwrap_or_else(|| \"no linked file\".to_string());\n    let scope = format_scope(&memory.scope, memory.branch.as_deref());\n    format!(\"{stale_reason}; {location}; {scope}\")\n}\n\nfn format_scope(scope: &MemoryScope, branch: Option<&str>) -> String {\n    match (scope, branch) {\n        (MemoryScope::Branch, Some(branch)) => format!(\"scope branch `{branch}`\"),\n        (MemoryScope::Branch, None) => \"scope branch\".to_string(),\n        (MemoryScope::Session, _) => \"scope session\".to_string(),\n        (MemoryScope::Repo, _) => \"scope repo\".to_string(),\n        (MemoryScope::Organization, _) => \"scope organization\".to_string(),\n    }\n}\n","numLines":243,"startLine":1,"totalLines":243}}}
