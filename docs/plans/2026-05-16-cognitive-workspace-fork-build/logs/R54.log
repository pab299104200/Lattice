{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MfA3wLhDWneYzuo6zQEw2F","type":"tool_result","content":"1\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n2\t//! `## 8. Verification Engine`:\n3\t//!\n4\t//! Verification checks:\n5\t//!\n6\t//! - linked files still exist\n7\t//! - linked symbols still exist\n8\t//! - cited docs still exist\n9\t//! - linked tests still exist\n10\t//! - evidence text still matches when exact spans were captured\n11\t//! - implementation still matches memory claim where deterministic checks are possible\n12\t//! - contradicted/superseded states remain coherent\n13\t//! - branch-scoped memory is not leaking into unrelated branches\n14\t//! - time-bound memory has expired\n15\t//!\n16\t//! Verification outputs:\n17\t//!\n18\t//! - `verified`\n19\t//! - `unverified`\n20\t//! - `in_review`\n21\t//! - `stale`\n22\t//! - `contradicted`\n23\t//! - `superseded`\n24\t//! - `expired`\n25\t//! - `invalidated`\n26\t//!\n27\t//! Verification must be incremental and tied to workspace changes. Large repos\n28\t//! cannot tolerate full rescans for every memory.\n29\t\n30\tuse std::collections::{HashMap, HashSet, VecDeque};\n31\tuse std::time::Instant;\n32\t\n33\tuse serde_json::json;\n34\tuse tracing::{field, info_span};\n35\t\n36\tuse super::{ExpiryError, ExpiryScanner, SpanReader, VerificationStatus, VerifierCore};\n37\tuse crate::consolidation::{\n38\t    capture_memory_state, encode_memory_state, now_unix_micros, ConsolidationJobMode,\n39\t    ConsolidationJobRuntime, PendingProposalSpec, ProposalDecision, ProposalKind,\n40\t};\n41\tuse crate::error::LatticeError;\n42\tuse crate::events::EventWriter;\n43\tuse crate::graph::CodeGraph;\n44\tuse crate::identity::{FileId, OperatorId};\n45\tuse crate::memory::{MemoryStore, MemoryVerificationStatus};\n46\tuse crate::storage::graph_store::FileIndexEntry;\n47\tuse crate::symbols::ParsedFile;\n48\tuse crate::{DateTime, Utc};\n49\t\n50\tpub trait VerificationObserver {\n51\t    fn on_verify(&self, memory_id: &str);\n52\t}\n53\t\n54\t#[derive(Clone, Debug, Default, PartialEq, Eq)]\n55\tpub struct IncrementalReport {\n56\t    pub impacted: usize,\n57\t    pub verified: u32,\n58\t    pub stale: u32,\n59\t    pub invalidated: u32,\n60\t    pub expired: u32,\n61\t    pub queued_for_retry: usize,\n62\t    pub elapsed_millis: u128,\n63\t}\n64\t\n65\t#[derive(Debug, thiserror::Error)]\n66\tpub enum IncrementalError {\n67\t    #[error(transparent)]\n68\t    Storage(#[from] LatticeError),\n69\t    #[error(transparent)]\n70\t    Verification(#[from] super::VerificationError),\n71\t    #[error(transparent)]\n72\t    Expiry(#[from] ExpiryError),\n73\t}\n74\t\n75\t#[derive(Clone, Debug, PartialEq, Eq)]\n76\tstruct PendingVerification {\n77\t    memory_id: String,\n78\t    new_snapshot_id: u64,\n79\t}\n80\t\n81\tpub struct IncrementalVerifier<'a> {\n82\t    store: &'a MemoryStore,\n83\t    runtime: &'a mut ConsolidationJobRuntime,\n84\t    graph: &'a CodeGraph,\n85\t    file_index: &'a HashMap<String, FileIndexEntry>,\n86\t    parsed_files: &'a HashMap<String, ParsedFile>,\n87\t    span_reader: &'a dyn SpanReader,\n88\t    event_writer: &'a EventWriter,\n89\t    decided_by: &'a OperatorId,\n90\t    workspace_id: &'a str,\n91\t    work_budget: usize,\n92\t    observer: Option<&'a dyn VerificationObserver>,\n93\t    pending: VecDeque<PendingVerification>,\n94\t}\n95\t\n96\timpl<'a> IncrementalVerifier<'a> {\n97\t    #[allow(clippy::too_many_arguments)]\n98\t    pub fn new(\n99\t        store: &'a MemoryStore,\n100\t        runtime: &'a mut ConsolidationJobRuntime,\n101\t        graph: &'a CodeGraph,\n102\t        file_index: &'a HashMap<String, FileIndexEntry>,\n103\t        parsed_files: &'a HashMap<String, ParsedFile>,\n104\t        span_reader: &'a dyn SpanReader,\n105\t        event_writer: &'a EventWriter,\n106\t        decided_by: &'a OperatorId,\n107\t        workspace_id: &'a str,\n108\t        work_budget: usize,\n109\t    ) -> Self {\n110\t        Self {\n111\t            store,\n112\t            runtime,\n113\t            graph,\n114\t            file_index,\n115\t            parsed_files,\n116\t            span_reader,\n117\t            event_writer,\n118\t            decided_by,\n119\t            workspace_id,\n120\t            work_budget,\n121\t            observer: None,\n122\t            pending: VecDeque::new(),\n123\t        }\n124\t    }\n125\t\n126\t    pub fn with_observer(mut self, observer: &'a dyn VerificationObserver) -> Self {\n127\t        self.observer = Some(observer);\n128\t        self\n129\t    }\n130\t\n131\t    pub fn on_graph_delta(\n132\t        &mut self,\n133\t        prior_snapshot_id: u64,\n134\t        new_snapshot_id: u64,\n135\t        changed_files: Vec<FileId>,\n136\t    ) -> Result<IncrementalReport, IncrementalError> {\n137\t        let started = Instant::now();\n138\t        let changed_file_paths = changed_file_paths(&changed_files);\n139\t        let changed_symbols = changed_symbols(self.graph, &changed_file_paths);\n140\t        let delta_impacted = self.store.find_impacted_memory_ids_for_graph_delta(\n141\t            self.workspace_id,\n142\t            &changed_file_paths,\n143\t            &changed_symbols,\n144\t        )?;\n145\t        #[cfg(debug_assertions)]\n146\t        {\n147\t            let row_count = self.store.count_memory_evidence_rows_for_graph_delta(\n148\t                self.workspace_id,\n149\t                &changed_file_paths,\n150\t                &changed_symbols,\n151\t            )?;\n152\t            debug_assert!(delta_impacted.len() <= row_count);\n153\t        }\n154\t\n155\t        self.enqueue_impacted(delta_impacted, new_snapshot_id);\n156\t        let impacted = self.pending.len();\n157\t        let span = info_span!(\n158\t            \"incremental_verification\",\n159\t            workspace_id = self.workspace_id,\n160\t            prior_snapshot = prior_snapshot_id,\n161\t            new_snapshot = new_snapshot_id,\n162\t            impacted = impacted,\n163\t            verified = field::Empty,\n164\t            stale = field::Empty,\n165\t            invalidated = field::Empty,\n166\t            expired = field::Empty,\n167\t            elapsed_ms = field::Empty\n168\t        );\n169\t        let _entered = span.enter();\n170\t\n171\t        let mut report = IncrementalReport {\n172\t            impacted,\n173\t            ..IncrementalReport::default()\n174\t        };\n175\t        let budget = self.work_budget.min(self.pending.len());\n176\t        for _ in 0..budget {\n177\t            let Some(task) = self.pending.pop_front() else {\n178\t                break;\n179\t            };\n180\t            self.process_memory(task, &mut report)?;\n181\t        }\n182\t\n183\t        report.queued_for_retry = self.pending.len();\n184\t        report.elapsed_millis = started.elapsed().as_millis();\n185\t        span.record(\"verified\", report.verified);\n186\t        span.record(\"stale\", report.stale);\n187\t        span.record(\"invalidated\", report.invalidated);\n188\t        span.record(\"expired\", report.expired);\n189\t        span.record(\"elapsed_ms\", report.elapsed_millis as i64);\n190\t        Ok(report)\n191\t    }\n192\t\n193\t    pub fn run_pending_expiry(\n194\t        &mut self,\n195\t        workspace_id: &str,\n196\t        now: DateTime<Utc>,\n197\t    ) -> Result<super::expiry::ExpiryReport, IncrementalError> {\n198\t        let mut scanner =\n199\t            ExpiryScanner::new(self.store, self.runtime, self.event_writer, self.decided_by);\n200\t        Ok(scanner.scan(workspace_id, now)?)\n201\t    }\n202\t\n203\t    fn enqueue_impacted(&mut self, memory_ids: Vec<String>, new_snapshot_id: u64) {\n204\t        let mut seen = self\n205\t            .pending\n206\t            .iter()\n207\t            .map(|item| item.memory_id.clone())\n208\t            .collect::<HashSet<_>>();\n209\t        for memory_id in memory_ids {\n210\t            if !seen.insert(memory_id.clone()) {\n211\t                continue;\n212\t            }\n213\t            self.pending.push_back(PendingVerification {\n214\t                memory_id,\n215\t                new_snapshot_id,\n216\t            });\n217\t        }\n218\t    }\n219\t\n220\t    fn process_memory(\n221\t        &mut self,\n222\t        task: PendingVerification,\n223\t        report: &mut IncrementalReport,\n224\t    ) -> Result<(), IncrementalError> {\n225\t        if let Some(observer) = self.observer {\n226\t            observer.on_verify(&task.memory_id);\n227\t        }\n228\t        if self.try_expire(&task.memory_id, task.new_snapshot_id)? {\n229\t            report.expired += 1;\n230\t            return Ok(());\n231\t        }\n232\t\n233\t        let mut verifier = VerifierCore::new(\n234\t            self.store,\n235\t            self.runtime,\n236\t            self.graph,\n237\t            self.file_index,\n238\t            self.parsed_files,\n239\t            self.span_reader,\n240\t            self.workspace_id,\n241\t        );\n242\t        let outcome = verifier.verify_memory_with_outcome(&task.memory_id)?;\n243\t        if let Some(proposal_id) = outcome.proposal_id.as_deref() {\n244\t            self.apply_proposal(proposal_id)?;\n245\t        }\n246\t        match outcome.verdict.status {\n247\t            VerificationStatus::Verified => {\n248\t                self.refresh_verified_memory(&task.memory_id, task.new_snapshot_id)?;\n249\t                report.verified += 1;\n250\t            }\n251\t            VerificationStatus::Stale => report.stale += 1,\n252\t            VerificationStatus::Invalidated => report.invalidated += 1,\n253\t            VerificationStatus::Expired => report.expired += 1,\n254\t            _ => {}\n255\t        }\n256\t        Ok(())\n257\t    }\n258\t\n259\t    fn try_expire(\n260\t        &mut self,\n261\t        memory_id: &str,\n262\t        new_snapshot_id: u64,\n263\t    ) -> Result<bool, IncrementalError> {\n264\t        let Some(expires_at) = self.store.get_expires_at(memory_id)? else {\n265\t            return Ok(false);\n266\t        };\n267\t        if expires_at.timestamp() > Utc::now().timestamp() {\n268\t            return Ok(false);\n269\t        }\n270\t        let mut scanner =\n271\t            ExpiryScanner::new(self.store, self.runtime, self.event_writer, self.decided_by);\n272\t        if scanner\n273\t            .expire_memory(memory_id, self.workspace_id, Utc::now())?\n274\t            .is_some()\n275\t        {\n276\t            self.bump_graph_snapshot_after_expiry(memory_id, new_snapshot_id)?;\n277\t            return Ok(true);\n278\t        }\n279\t        Ok(false)\n280\t    }\n281\t\n282\t    fn bump_graph_snapshot_after_expiry(\n283\t        &mut self,\n284\t        memory_id: &str,\n285\t        new_snapshot_id: u64,\n286\t    ) -> Result<(), IncrementalError> {\n287\t        let Some(memory) = self.store.get_by_id(memory_id)? else {\n288\t            return Ok(());\n289\t        };\n290\t        let prior_state = capture_memory_state(self.store, &memory)?;\n291\t        let mut proposed_state = prior_state.clone();\n292\t        proposed_state.last_verified_graph_snapshot_id = Some(new_snapshot_id);\n293\t        let proposal_id =\n294\t            self.submit_refresh(memory_id, &prior_state, &proposed_state, new_snapshot_id)?;\n295\t        self.apply_proposal(&proposal_id)?;\n296\t        Ok(())\n297\t    }\n298\t\n299\t    fn refresh_verified_memory(\n300\t        &mut self,\n301\t        memory_id: &str,\n302\t        new_snapshot_id: u64,\n303\t    ) -> Result<(), IncrementalError> {\n304\t        let memory = self\n305\t            .store\n306\t            .get_by_id(memory_id)?\n307\t            .ok_or_else(|| LatticeError::Storage(format!(\"Memory '{}' not found\", memory_id)))?;\n308\t        let prior_state = capture_memory_state(self.store, &memory)?;\n309\t        let mut proposed_state = prior_state.clone();\n310\t        proposed_state.last_verified_at = Some(Utc::now().timestamp().max(0) as u64);\n311\t        proposed_state.last_verified_graph_snapshot_id = Some(new_snapshot_id);\n312\t        proposed_state.structured_fields.verification_status = MemoryVerificationStatus::Verified;\n313\t        let proposal_id =\n314\t            self.submit_refresh(memory_id, &prior_state, &proposed_state, new_snapshot_id)?;\n315\t        self.apply_proposal(&proposal_id)?;\n316\t        Ok(())\n317\t    }\n318\t\n319\t    fn submit_refresh(\n320\t        &mut self,\n321\t        memory_id: &str,\n322\t        prior_state: &crate::consolidation::ConsolidationMemoryState,\n323\t        proposed_state: &crate::consolidation::ConsolidationMemoryState,\n324\t        new_snapshot_id: u64,\n325\t    ) -> Result<String, IncrementalError> {\n326\t        let job_id = format!(\"verify-refresh-{}-{}\", memory_id, now_unix_micros());\n327\t        let proposal_id = format!(\n328\t            \"verify-refresh-proposal-{}-{}\",\n329\t            memory_id,\n330\t            now_unix_micros()\n331\t        );\n332\t        let _ = self\n333\t            .runtime\n334\t            .submit_inline(crate::consolidation::ConsolidationJobSpec {\n335\t                job_id,\n336\t                workspace_id: self.workspace_id.to_string(),\n337\t                kind: \"refresh verified memory after incremental verification\".to_string(),\n338\t                mode: ConsolidationJobMode::Background,\n339\t                proposal: Some(PendingProposalSpec {\n340\t                    proposal_id: proposal_id.clone(),\n341\t                    target_memory_id: Some(memory_id.to_string()),\n342\t                    proposal_kind: ProposalKind::Refresh,\n343\t                    prior_state: encode_memory_state(prior_state),\n344\t                    proposed_state: encode_memory_state(proposed_state),\n345\t                    evidence: json!({\n346\t                        \"source_memory_ids\": [memory_id],\n347\t                        \"last_verified_graph_snapshot_id\": new_snapshot_id,\n348\t                    }),\n349\t                    provenance: None,\n350\t                }),\n351\t            })?;\n352\t        Ok(proposal_id)\n353\t    }\n354\t\n355\t    fn apply_proposal(&self, proposal_id: &str) -> Result<(), IncrementalError> {\n356\t        let _ = self.runtime.decide(\n357\t            proposal_id,\n358\t            ProposalDecision::Applied,\n359\t            self.store,\n360\t            self.event_writer,\n361\t            self.decided_by.value.as_str(),\n362\t        )?;\n363\t        Ok(())\n364\t    }\n365\t}\n366\t\n367\tfn changed_file_paths(changed_files: &[FileId]) -> Vec<String> {\n368\t    let mut paths = changed_files\n369\t        .iter()\n370\t        .map(|file_id| file_id.repo_relative_path.clone())\n371\t        .collect::<Vec<_>>();\n372\t    paths.sort();\n373\t    paths.dedup();\n374\t    paths\n375\t}\n376\t\n377\tfn changed_symbols(graph: &CodeGraph, changed_file_paths: &[String]) -> Vec<String> {\n378\t    let changed = changed_file_paths.iter().cloned().collect::<HashSet<_>>();\n379\t    let mut symbols = graph\n380\t        .all_nodes()\n381\t        .into_iter()\n382\t        .filter(|node| changed.contains(node.file.as_str()))\n383\t        .map(|node| node.name.clone())\n384\t        .collect::<Vec<_>>();\n385\t    symbols.sort();\n386\t    symbols.dedup();\n387\t    symbols\n388\t}\n389\t"}]},"parent_tool_use_id":null,"session_id":"0696e093-0770-442b-8dc9-5393bbfcd0b6","uuid":"621757e7-a058-4217-ac0c-dd9ce53c3e09","timestamp":"2026-05-17T13:01:43.270Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/incremental.rs","content":"//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 8. Verification Engine`:\n//!\n//! Verification checks:\n//!\n//! - linked files still exist\n//! - linked symbols still exist\n//! - cited docs still exist\n//! - linked tests still exist\n//! - evidence text still matches when exact spans were captured\n//! - implementation still matches memory claim where deterministic checks are possible\n//! - contradicted/superseded states remain coherent\n//! - branch-scoped memory is not leaking into unrelated branches\n//! - time-bound memory has expired\n//!\n//! Verification outputs:\n//!\n//! - `verified`\n//! - `unverified`\n//! - `in_review`\n//! - `stale`\n//! - `contradicted`\n//! - `superseded`\n//! - `expired`\n//! - `invalidated`\n//!\n//! Verification must be incremental and tied to workspace changes. Large repos\n//! cannot tolerate full rescans for every memory.\n\nuse std::collections::{HashMap, HashSet, VecDeque};\nuse std::time::Instant;\n\nuse serde_json::json;\nuse tracing::{field, info_span};\n\nuse super::{ExpiryError, ExpiryScanner, SpanReader, VerificationStatus, VerifierCore};\nuse crate::consolidation::{\n    capture_memory_state, encode_memory_state, now_unix_micros, ConsolidationJobMode,\n    ConsolidationJobRuntime, PendingProposalSpec, ProposalDecision, ProposalKind,\n};\nuse crate::error::LatticeError;\nuse crate::events::EventWriter;\nuse crate::graph::CodeGraph;\nuse crate::identity::{FileId, OperatorId};\nuse crate::memory::{MemoryStore, MemoryVerificationStatus};\nuse crate::storage::graph_store::FileIndexEntry;\nuse crate::symbols::ParsedFile;\nuse crate::{DateTime, Utc};\n\npub trait VerificationObserver {\n    fn on_verify(&self, memory_id: &str);\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\npub struct IncrementalReport {\n    pub impacted: usize,\n    pub verified: u32,\n    pub stale: u32,\n    pub invalidated: u32,\n    pub expired: u32,\n    pub queued_for_retry: usize,\n    pub elapsed_millis: u128,\n}\n\n#[derive(Debug, thiserror::Error)]\npub enum IncrementalError {\n    #[error(transparent)]\n    Storage(#[from] LatticeError),\n    #[error(transparent)]\n    Verification(#[from] super::VerificationError),\n    #[error(transparent)]\n    Expiry(#[from] ExpiryError),\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\nstruct PendingVerification {\n    memory_id: String,\n    new_snapshot_id: u64,\n}\n\npub struct IncrementalVerifier<'a> {\n    store: &'a MemoryStore,\n    runtime: &'a mut ConsolidationJobRuntime,\n    graph: &'a CodeGraph,\n    file_index: &'a HashMap<String, FileIndexEntry>,\n    parsed_files: &'a HashMap<String, ParsedFile>,\n    span_reader: &'a dyn SpanReader,\n    event_writer: &'a EventWriter,\n    decided_by: &'a OperatorId,\n    workspace_id: &'a str,\n    work_budget: usize,\n    observer: Option<&'a dyn VerificationObserver>,\n    pending: VecDeque<PendingVerification>,\n}\n\nimpl<'a> IncrementalVerifier<'a> {\n    #[allow(clippy::too_many_arguments)]\n    pub fn new(\n        store: &'a MemoryStore,\n        runtime: &'a mut ConsolidationJobRuntime,\n        graph: &'a CodeGraph,\n        file_index: &'a HashMap<String, FileIndexEntry>,\n        parsed_files: &'a HashMap<String, ParsedFile>,\n        span_reader: &'a dyn SpanReader,\n        event_writer: &'a EventWriter,\n        decided_by: &'a OperatorId,\n        workspace_id: &'a str,\n        work_budget: usize,\n    ) -> Self {\n        Self {\n            store,\n            runtime,\n            graph,\n            file_index,\n            parsed_files,\n            span_reader,\n            event_writer,\n            decided_by,\n            workspace_id,\n            work_budget,\n            observer: None,\n            pending: VecDeque::new(),\n        }\n    }\n\n    pub fn with_observer(mut self, observer: &'a dyn VerificationObserver) -> Self {\n        self.observer = Some(observer);\n        self\n    }\n\n    pub fn on_graph_delta(\n        &mut self,\n        prior_snapshot_id: u64,\n        new_snapshot_id: u64,\n        changed_files: Vec<FileId>,\n    ) -> Result<IncrementalReport, IncrementalError> {\n        let started = Instant::now();\n        let changed_file_paths = changed_file_paths(&changed_files);\n        let changed_symbols = changed_symbols(self.graph, &changed_file_paths);\n        let delta_impacted = self.store.find_impacted_memory_ids_for_graph_delta(\n            self.workspace_id,\n            &changed_file_paths,\n            &changed_symbols,\n        )?;\n        #[cfg(debug_assertions)]\n        {\n            let row_count = self.store.count_memory_evidence_rows_for_graph_delta(\n                self.workspace_id,\n                &changed_file_paths,\n                &changed_symbols,\n            )?;\n            debug_assert!(delta_impacted.len() <= row_count);\n        }\n\n        self.enqueue_impacted(delta_impacted, new_snapshot_id);\n        let impacted = self.pending.len();\n        let span = info_span!(\n            \"incremental_verification\",\n            workspace_id = self.workspace_id,\n            prior_snapshot = prior_snapshot_id,\n            new_snapshot = new_snapshot_id,\n            impacted = impacted,\n            verified = field::Empty,\n            stale = field::Empty,\n            invalidated = field::Empty,\n            expired = field::Empty,\n            elapsed_ms = field::Empty\n        );\n        let _entered = span.enter();\n\n        let mut report = IncrementalReport {\n            impacted,\n            ..IncrementalReport::default()\n        };\n        let budget = self.work_budget.min(self.pending.len());\n        for _ in 0..budget {\n            let Some(task) = self.pending.pop_front() else {\n                break;\n            };\n            self.process_memory(task, &mut report)?;\n        }\n\n        report.queued_for_retry = self.pending.len();\n        report.elapsed_millis = started.elapsed().as_millis();\n        span.record(\"verified\", report.verified);\n        span.record(\"stale\", report.stale);\n        span.record(\"invalidated\", report.invalidated);\n        span.record(\"expired\", report.expired);\n        span.record(\"elapsed_ms\", report.elapsed_millis as i64);\n        Ok(report)\n    }\n\n    pub fn run_pending_expiry(\n        &mut self,\n        workspace_id: &str,\n        now: DateTime<Utc>,\n    ) -> Result<super::expiry::ExpiryReport, IncrementalError> {\n        let mut scanner =\n            ExpiryScanner::new(self.store, self.runtime, self.event_writer, self.decided_by);\n        Ok(scanner.scan(workspace_id, now)?)\n    }\n\n    fn enqueue_impacted(&mut self, memory_ids: Vec<String>, new_snapshot_id: u64) {\n        let mut seen = self\n            .pending\n            .iter()\n            .map(|item| item.memory_id.clone())\n            .collect::<HashSet<_>>();\n        for memory_id in memory_ids {\n            if !seen.insert(memory_id.clone()) {\n                continue;\n            }\n            self.pending.push_back(PendingVerification {\n                memory_id,\n                new_snapshot_id,\n            });\n        }\n    }\n\n    fn process_memory(\n        &mut self,\n        task: PendingVerification,\n        report: &mut IncrementalReport,\n    ) -> Result<(), IncrementalError> {\n        if let Some(observer) = self.observer {\n            observer.on_verify(&task.memory_id);\n        }\n        if self.try_expire(&task.memory_id, task.new_snapshot_id)? {\n            report.expired += 1;\n            return Ok(());\n        }\n\n        let mut verifier = VerifierCore::new(\n            self.store,\n            self.runtime,\n            self.graph,\n            self.file_index,\n            self.parsed_files,\n            self.span_reader,\n            self.workspace_id,\n        );\n        let outcome = verifier.verify_memory_with_outcome(&task.memory_id)?;\n        if let Some(proposal_id) = outcome.proposal_id.as_deref() {\n            self.apply_proposal(proposal_id)?;\n        }\n        match outcome.verdict.status {\n            VerificationStatus::Verified => {\n                self.refresh_verified_memory(&task.memory_id, task.new_snapshot_id)?;\n                report.verified += 1;\n            }\n            VerificationStatus::Stale => report.stale += 1,\n            VerificationStatus::Invalidated => report.invalidated += 1,\n            VerificationStatus::Expired => report.expired += 1,\n            _ => {}\n        }\n        Ok(())\n    }\n\n    fn try_expire(\n        &mut self,\n        memory_id: &str,\n        new_snapshot_id: u64,\n    ) -> Result<bool, IncrementalError> {\n        let Some(expires_at) = self.store.get_expires_at(memory_id)? else {\n            return Ok(false);\n        };\n        if expires_at.timestamp() > Utc::now().timestamp() {\n            return Ok(false);\n        }\n        let mut scanner =\n            ExpiryScanner::new(self.store, self.runtime, self.event_writer, self.decided_by);\n        if scanner\n            .expire_memory(memory_id, self.workspace_id, Utc::now())?\n            .is_some()\n        {\n            self.bump_graph_snapshot_after_expiry(memory_id, new_snapshot_id)?;\n            return Ok(true);\n        }\n        Ok(false)\n    }\n\n    fn bump_graph_snapshot_after_expiry(\n        &mut self,\n        memory_id: &str,\n        new_snapshot_id: u64,\n    ) -> Result<(), IncrementalError> {\n        let Some(memory) = self.store.get_by_id(memory_id)? else {\n            return Ok(());\n        };\n        let prior_state = capture_memory_state(self.store, &memory)?;\n        let mut proposed_state = prior_state.clone();\n        proposed_state.last_verified_graph_snapshot_id = Some(new_snapshot_id);\n        let proposal_id =\n            self.submit_refresh(memory_id, &prior_state, &proposed_state, new_snapshot_id)?;\n        self.apply_proposal(&proposal_id)?;\n        Ok(())\n    }\n\n    fn refresh_verified_memory(\n        &mut self,\n        memory_id: &str,\n        new_snapshot_id: u64,\n    ) -> Result<(), IncrementalError> {\n        let memory = self\n            .store\n            .get_by_id(memory_id)?\n            .ok_or_else(|| LatticeError::Storage(format!(\"Memory '{}' not found\", memory_id)))?;\n        let prior_state = capture_memory_state(self.store, &memory)?;\n        let mut proposed_state = prior_state.clone();\n        proposed_state.last_verified_at = Some(Utc::now().timestamp().max(0) as u64);\n        proposed_state.last_verified_graph_snapshot_id = Some(new_snapshot_id);\n        proposed_state.structured_fields.verification_status = MemoryVerificationStatus::Verified;\n        let proposal_id =\n            self.submit_refresh(memory_id, &prior_state, &proposed_state, new_snapshot_id)?;\n        self.apply_proposal(&proposal_id)?;\n        Ok(())\n    }\n\n    fn submit_refresh(\n        &mut self,\n        memory_id: &str,\n        prior_state: &crate::consolidation::ConsolidationMemoryState,\n        proposed_state: &crate::consolidation::ConsolidationMemoryState,\n        new_snapshot_id: u64,\n    ) -> Result<String, IncrementalError> {\n        let job_id = format!(\"verify-refresh-{}-{}\", memory_id, now_unix_micros());\n        let proposal_id = format!(\n            \"verify-refresh-proposal-{}-{}\",\n            memory_id,\n            now_unix_micros()\n        );\n        let _ = self\n            .runtime\n            .submit_inline(crate::consolidation::ConsolidationJobSpec {\n                job_id,\n                workspace_id: self.workspace_id.to_string(),\n                kind: \"refresh verified memory after incremental verification\".to_string(),\n                mode: ConsolidationJobMode::Background,\n                proposal: Some(PendingProposalSpec {\n                    proposal_id: proposal_id.clone(),\n                    target_memory_id: Some(memory_id.to_string()),\n                    proposal_kind: ProposalKind::Refresh,\n                    prior_state: encode_memory_state(prior_state),\n                    proposed_state: encode_memory_state(proposed_state),\n                    evidence: json!({\n                        \"source_memory_ids\": [memory_id],\n                        \"last_verified_graph_snapshot_id\": new_snapshot_id,\n                    }),\n                    provenance: None,\n                }),\n            })?;\n        Ok(proposal_id)\n    }\n\n    fn apply_proposal(&self, proposal_id: &str) -> Result<(), IncrementalError> {\n        let _ = self.runtime.decide(\n            proposal_id,\n            ProposalDecision::Applied,\n            self.store,\n            self.event_writer,\n            self.decided_by.value.as_str(),\n        )?;\n        Ok(())\n    }\n}\n\nfn changed_file_paths(changed_files: &[FileId]) -> Vec<String> {\n    let mut paths = changed_files\n        .iter()\n        .map(|file_id| file_id.repo_relative_path.clone())\n        .collect::<Vec<_>>();\n    paths.sort();\n    paths.dedup();\n    paths\n}\n\nfn changed_symbols(graph: &CodeGraph, changed_file_paths: &[String]) -> Vec<String> {\n    let changed = changed_file_paths.iter().cloned().collect::<HashSet<_>>();\n    let mut symbols = graph\n        .all_nodes()\n        .into_iter()\n        .filter(|node| changed.contains(node.file.as_str()))\n        .map(|node| node.name.clone())\n        .collect::<Vec<_>>();\n    symbols.sort();\n    symbols.dedup();\n    symbols\n}\n","numLines":389,"startLine":1,"totalLines":389}}}
