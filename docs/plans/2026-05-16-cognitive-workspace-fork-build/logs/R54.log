,\n57\t    #[error(\"memory '{memory_id}' not found\")]\n58\t    MissingMemory { memory_id: String },\n59\t    #[error(\"graph snapshot is unavailable for workspace '{workspace_id}'\")]\n60\t    MissingGraphSnapshot { workspace_id: String },\n61\t}\n62\t\n63\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n64\tenum VerificationJobState {\n65\t    Queued,\n66\t    Running,\n67\t    Completed,\n68\t    Failed,\n69\t}\n70\t\n71\timpl VerificationJobState {\n72\t    fn as_str(self) -> &'static str {\n73\t        match self {\n74\t            Self::Queued => \"queued\",\n75\t            Self::Running => \"running\",\n76\t            Self::Completed => \"completed\",\n77\t            Self::Failed => \"failed\",\n78\t        }\n79\t    }\n80\t}\n81\t\n82\t#[derive(Clone, Debug, PartialEq, Eq)]\n83\tstruct VerificationJobRecord {\n84\t    job_id: String,\n85\t    target_memory_id: String,\n86\t}\n87\t\n88\tpub struct VerifierCore<'a> {\n89\t    store: &'a MemoryStore,\n90\t    runtime: &'a mut ConsolidationJobRuntime,\n91\t    graph: &'a CodeGraph,\n92\t    file_index: &'a HashMap<String, FileIndexEntry>,\n93\t    parsed_files: &'a HashMap<String, ParsedFile>,\n94\t    span_reader: &'a dyn SpanReader,\n95\t    workspace_id: &'a str,\n96\t}\n97\t\n98\timpl<'a> VerifierCore<'a> {\n99\t    pub fn new(\n100\t        store: &'a MemoryStore,\n101\t        runtime: &'a mut ConsolidationJobRuntime,\n102\t        graph: &'a CodeGraph,\n103\t        file_index: &'a HashMap<String, FileIndexEntry>,\n104\t        parsed_files: &'a HashMap<String, ParsedFile>,\n105\t        span_reader: &'a dyn SpanReader,\n106\t        workspace_id: &'a str,\n107\t    ) -> Self {\n108\t        Self {\n109\t            store,\n110\t            runtime,\n111\t            graph,\n112\t            file_index,\n113\t            parsed_files,\n114\t            span_reader,\n115\t            workspace_id,\n116\t        }\n117\t    }\n118\t\n119\t    pub fn verify_memory(\n120\t        &mut self,\n121\t        memory_id: &str,\n122\t    ) -> Result<VerificationVerdict, VerificationError> {\n123\t        Ok(self.verify_memory_with_outcome(memory_id)?.verdict)\n124\t    }\n125\t\n126\t    pub fn verify_memory_with_outcome(\n127\t        &mut self,\n128\t        memory_id: &str,\n129\t    ) -> Result<VerificationOutcome, VerificationError> {\n130\t        let job = self.enqueue_job(memory_id)?;\n131\t        self.verify_job(job)\n132\t    }\n133\t\n134\t    pub fn run_pending_jobs(\n135\t        &mut self,\n136\t        workspace_id: &str,\n137\t        budget: VerifierBudget,\n138\t    ) -> Result<VerifierReport, VerificationError> {\n139\t        let started = Instant::now();\n140\t        self.seed_jobs(workspace_id, budget.max_memories)?;\n141\t        let jobs = self.pending_jobs(workspace_id, budget.max_memories)?;\n142\t        let mut report = VerifierReport::default();\n143\t\n144\t        for job in jobs {\n145\t            match self.verify_job(job) {\n146\t                Ok(outcome) => match outcome.verdict.status {\n147\t                    VerificationStatus::Verified => report.verified += 1,\n148\t                    VerificationStatus::Stale => report.stale += 1,\n149\t                    VerificationStatus::Invalidated => report.invalidated += 1,\n150\t                    VerificationStatus::Expired => report.expired += 1,\n151\t                    _ => {}\n152\t                },\n153\t                Err(error) => warn!(error = %error, \"verification job failed\"),\n154\t            }\n155\t        }\n156\t\n157\t        report.elapsed_millis = started.elapsed().as_millis();\n158\t        info!(\n159\t            workspace_id,\n160\t            verified = report.verified,\n161\t            stale = report.stale,\n162\t            invalidated = report.invalidated,\n163\t            expired = report.expired,\n164\t            elapsed_millis = report.elapsed_millis,\n165\t            \"verifier run completed\"\n166\t        );\n167\t        Ok(report)\n168\t    }\n169\t\n170\t    fn verify_job(\n171\t        &mut self,\n172\t        job: VerificationJobRecord,\n173\t    ) -> Result<VerificationOutcome, VerificationError> {\n174\t        self.ensure_graph_snapshot()?;\n175\t        self.mark_job_state(&job.job_id, VerificationJobState::Running, None, None)?;\n176\t        let result = self.verify_memory_inner(&job.target_memory_id);\n177\t        match &result {\n178\t            Ok(outcome) => {\n179\t                self.mark_job_state(\n180\t                    &job.job_id,\n181\t                    VerificationJobState::Completed,\n182\t                    Some(outcome.verdict.status),\n183\t                    Some(outcome.verdict.reason.as_str()),\n184\t                )?;\n185\t            }\n186\t            Err(error) => {\n187\t                self.mark_job_state(\n188\t                    &job.job_id,\n189\t                    VerificationJobState::Failed,\n190\t                    None,\n191\t                    Some(&error.to_string()),\n192\t                )?;\n193\t            }\n194\t        }\n195\t        result\n196\t    }\n197\t\n198\t    fn verify_memory_inner(\n199\t        &mut self,\n200\t        memory_id: &str,\n201\t    ) -> Result<VerificationOutcome, VerificationError> {\n202\t        let memory =\n203\t            self.store\n204\t                .get_by_id(memory_id)?\n205\t                .ok_or_else(|| VerificationError::MissingMemory {\n206\t                    memory_id: memory_id.to_string(),\n207\t                })?;\n208\t        let prior_state = capture_memory_state(self.store, &memory)?;\n209\t        let evidence = prior_state.structured_fields.evidence.clone();\n210\t        let resolver = IdentityResolver::new(\n211\t            self.graph,\n212\t            self.file_index,\n213\t            self.parsed_files,\n214\t            self.workspace_id.to_string(),\n215\t            Vec::new(),\n216\t        );\n217\t        let span = info_span!(\n218\t            \"verify_memory\",\n219\t            memory_id = memory_id,\n220\t            evidence_count = evidence.len(),\n221\t            verdict = field::Empty\n222\t        );\n223\t        let _entered = span.enter();\n224\t\n225\t        let mut verdicts = Vec::new();\n226\t        for (index, entry) in evidence.iter().enumerate() {\n227\t            let outcome = match entry.kind.as_str() {\n228\t                \"file\" => FileExistenceCheck::run(entry, &resolver, self.file_index),\n229\t                \"symbol\" => {\n230\t                    SymbolExistenceCheck::run(entry, &resolver, self.file_index, self.graph)\n231\t                }\n232\t                \"doc_section\" => DocSectionExistenceCheck::run(\n233\t                    entry,\n234\t                    &resolver,\n235\t                    self.file_index,\n236\t                    self.parsed_files,\n237\t                ),\n238\t                \"test\" => TestExistenceCheck::run(entry, &resolver, self.file_index, self.graph),\n239\t                _ => {\n240\t                    warn!(\n241\t                        kind = entry.kind.as_str(),\n242\t                        \"unsupported verification evidence kind\"\n243\t                    );\n244\t                    continue;\n245\t                }\n246\t            };\n247\t            match outcome {\n248\t                Ok(verdict) => {\n249\t                    let existence_ok = verdict.status == VerificationStatus::Verified;\n250\t                    verdicts.push(verdict);\n251\t                    if existence_ok {\n252\t                        let evidence_id = evidence_row_id(memory_id, index);\n253\t                        let span_verdict =\n254\t                            self.verify_span_evidence(memory_id, &evidence_id, entry)?;\n255\t                        verdicts.push(span_verdict);\n256\t                    }\n257\t                }\n258\t                Err(error) => {\n259\t                    warn!(memory_id, evidence_kind = entry.kind.as_str(), error = %error, \"verification evidence failed\");\n260\t                    verdicts.push(VerificationVerdict::new(\n261\t                        VerificationStatus::Unverified,\n262\t                        error.to_string(),\n263\t                    ));\n264\t                }\n265\t            }\n266\t        }\n267\t\n268\t        verdicts.push(self.verify_scope(&memory));\n269\t\n270\t        let verdict = aggregate_verdicts(&verdicts);\n271\t        span.record(\"verdict\", verdict.status.as_str());\n272\t        let proposal_id = self.emit_proposal(memory_id, &prior_state, &verdict)?;\n273\t        Ok(VerificationOutcome {\n274\t            verdict,\n275\t            proposal_id,\n276\t        })\n277\t    }\n278\t\n279\t    fn verify_span_evidence(\n280\t        &self,\n281\t        memory_id: &str,\n282\t        evidence_id: &str,\n283\t        evidence: &MemoryEvidence,\n284\t    ) -> Result<VerificationVerdict, VerificationError> {\n285\t        let Some(span) = evidence.span.as_ref() else {\n286\t            return Ok(VerificationVerdict::new(\n287\t                VerificationStatus::Verified,\n288\t                \"span validation skipped because evidence has no exact span\",\n289\t            ));\n290\t        };\n291\t        let span_guard = debug_span!(\n292\t            \"validate_span\",\n293\t            memory_id,\n294\t            file_id = %span.file_id,\n295\t            byte_start = span.byte_start,\n296\t            byte_end = span.byte_end,\n297\t            verdict = field::Empty\n298\t        );\n299\t        let verdict = {\n300\t            let _entered = span_guard.enter();\n301\t            SpanValidator::validate_with_reader(evidence_id, evidence, self.span_reader)?\n302\t        };\n303\t        span_guard.record(\"verdict\", verdict.status.as_str());\n304\t        Ok(verdict)\n305\t    }\n306\t\n307\t    fn emit_proposal(\n308\t        &mut self,\n309\t        memory_id: &str,\n310\t        prior_state: &crate::consolidation::ConsolidationMemoryState,\n311\t        verdict: &VerificationVerdict,\n312\t    ) -> Result<Option<String>, VerificationError> {\n313\t        let Some((proposal_kind, proposed_state)) = project_state(prior_state, verdict) else {\n314\t            return Ok(None);\n315\t        };\n316\t        let job_id = format!(\"verify-proposal-{}-{}\", memory_id, now_unix_micros());\n317\t        let proposal_id = format!(\"verify-proposal-{}-{}\", memory_id, now_unix_micros());\n318\t        let _ = self\n319\t            .runtime\n320\t            .submit_inline(crate::consolidation::ConsolidationJobSpec {\n321\t                job_id,\n322\t                workspace_id: self.workspace_id.to_string(),\n323\t                kind: \"verify durable memory evidence\".to_string(),\n324\t                mode: ConsolidationJobMode::Background,\n325\t                proposal: Some(PendingProposalSpec {\n326\t                    proposal_id: proposal_id.clone(),\n327\t                    target_memory_id: Some(memory_id.to_string()),\n328\t                    proposal_kind,\n329\t                    prior_state: encode_memory_state(prior_state),\n330\t                    proposed_state: encode_memory_state(&proposed_state),\n331\t                    evidence: serde_json::json!({\n332\t                        \"source_memory_ids\": [memory_id],\n333\t                        \"verification_status\": verdict.status.as_str(),\n334\t                        \"reason\": verdict.reason,\n335\t                    }),\n336\t                    provenance: None,\n337\t                }),\n338\t            })?;\n339\t        Ok(Some(proposal_id))\n340\t    }\n341\t\n342\t    fn verify_scope(&self, memory: &crate::memory::Memory) -> VerificationVerdict {\n343\t        let filter = ScopeFilter {\n344\t            workspace_id: memory.workspace_id.clone().unwrap_or_default(),\n345\t            branch: memory.branch.clone().map(|name| BranchRef { name }),\n346\t            organization_id: memory.scope_organization_id.clone(),\n347\t            session_id: Some(memory.session_id.clone()),\n348\t        };\n349\t        ScopeEnforcement::audit_memory(memory, &filter)\n350\t    }\n351\t\n352\t    fn ensure_graph_snapshot(&self) -> Result<(), VerificationError> {\n353\t        if self.workspace_id.trim().is_empty() {\n354\t            return Err(VerificationError::MissingGraphSnapshot {\n355\t                workspace_id: self.workspace_id.to_string(),\n356\t            });\n357\t        }\n358\t        Ok(())\n359\t    }\n360\t\n361\t    fn enqueue_job(&mut self, memory_id: &str) -> Result<VerificationJobRecord, VerificationError> {\n362\t        let job = VerificationJobRecord {\n363\t            job_id: format!(\"verify-job-{}-{}\", memory_id, now_unix_micros()),\n364\t            target_memory_id: memory_id.to_string(),\n365\t        };\n366\t        let queued_at = now_unix_micros();\n367\t        let conn = self.runtime.lock_conn()?;\n368\t        conn.execute(\n369\t            \"INSERT INTO verification_jobs\n370\t                (job_id, workspace_id, target_memory_id, check_kind, status, verdict, reason, queued_at)\n371\t             VALUES (?1, ?2, ?3, ?4, ?5, NULL, NULL, ?6)\",\n372\t            params![\n373\t                job.job_id,\n374\t                self.workspace_id,\n375\t                job.target_memory_id,\n376\t                \"existence\",\n377\t                VerificationJobState::Queued.as_str(),\n378\t                queued_at,\n379\t            ],\n380\t        )\n381\t        .map_err(|error| LatticeError::Storage(format!(\"Failed to enqueue verification job: {error}\")))?;\n382\t        Ok(job)\n383\t    }\n384\t\n385\t    fn seed_jobs(&mut self, workspace_id: &str, max_jobs: usize) -> Result<(), VerificationError> {\n386\t        if max_jobs == 0 {\n387\t            return Ok(());\n388\t        }\n389\t        let memories = self.store.list_workspace_memories(workspace_id)?;\n390\t        for memory in memories.into_iter().take(max_jobs) {\n391\t            if self.has_active_job(&memory.id)? {\n392\t                continue;\n393\t            }\n394\t            let _ = self.enqueue_job(&memory.id)?;\n395\t        }\n396\t        Ok(())\n397\t    }\n398\t\n399\t    fn has_active_job(&mut self, memory_id: &str) -> Result<bool, VerificationError> {\n400\t        let conn = self.runtime.lock_conn()?;\n401\t        let status = conn\n402\t            .query_row(\n403\t                \"SELECT 1\n404\t                 FROM verification_jobs\n405\t                 WHERE workspace_id = ?1\n406\t                   AND target_memory_id = ?2\n407\t                   AND status IN ('queued', 'running')\n408\t                 LIMIT 1\",\n409\t                params![self.workspace_id, memory_id],\n410\t                |row| row.get::<_, i64>(0),\n411\t            )\n412\t            .optional()\n413\t            .map_err(|error| {\n414\t                LatticeError::Storage(format!(\"Failed to inspect verification queue: {error}\"))\n415\t            })?;\n416\t        Ok(status.is_some())\n417\t    }\n418\t\n419\t    fn pending_jobs(\n420\t        &mut self,\n421\t        workspace_id: &str,\n422\t        limit: usize,\n423\t    ) -> Result<Vec<VerificationJobRecord>, VerificationError> {\n424\t        let conn = self.runtime.lock_conn()?;\n425\t        let mut statement = conn\n426\t            .prepare(\n427\t                \"SELECT job_id, target_memory_id\n428\t                 FROM verification_jobs\n429\t                 WHERE workspace_id = ?1\n430\t                   AND status = 'queued'\n431\t                 ORDER BY queued_at ASC\n432\t                 LIMIT ?2\",\n433\t            )\n434\t            .map_err(|error| {\n435\t                LatticeError::Storage(format!(\"Failed to prepare verification job query: {error}\"))\n436\t            })?;\n437\t        let rows = statement\n438\t            .query_map(params![workspace_id, limit as i64], |row| {\n439\t                Ok(VerificationJobRecord {\n440\t                    job_id: row.get(0)?,\n441\t                    target_memory_id: row.get(1)?,\n442\t                })\n443\t            })\n444\t            .map_err(|error| {\n445\t                LatticeError::Storage(format!(\"Failed to query verification jobs: {error}\"))\n446\t            })?;\n447\t        let mut jobs = Vec::new();\n448\t        for row in rows {\n449\t            jobs.push(row.map_err(|error| {\n450\t                LatticeError::Storage(format!(\"Failed to decode verification job row: {error}\"))\n451\t            })?);\n452\t        }\n453\t        Ok(jobs)\n454\t    }\n455\t\n456\t    fn mark_job_state(\n457\t        &mut self,\n458\t        job_id: &str,\n459\t        state: VerificationJobState,\n460\t        verdict: Option<VerificationStatus>,\n461\t        reason: Option<&str>,\n462\t    ) -> Result<(), VerificationError> {\n463\t        let now = now_unix_micros();\n464\t        let (started_at, finished_at) = match state {\n465\t            VerificationJobState::Queued => (None, None),\n466\t            VerificationJobState::Running => (Some(now), None),\n467\t            VerificationJobState::Completed | VerificationJobState::Failed => (None, Some(now)),\n468\t        };\n469\t        let conn = self.runtime.lock_conn()?;\n470\t        conn.execute(\n471\t            \"UPDATE verification_jobs\n472\t             SET status = ?1,\n473\t                 verdict = COALESCE(?2, verdict),\n474\t                 reason = ?3,\n475\t                 started_at = COALESCE(?4, started_at),\n476\t                 finished_at = COALESCE(?5, finished_at)\n477\t             WHERE job_id = ?6\",\n478\t            params![\n479\t                state.as_str(),\n480\t                verdict.map(VerificationStatus::as_str),\n481\t                reason,\n482\t                started_at,\n483\t                finished_at,\n484\t                job_id,\n485\t            ],\n486\t        )\n487\t        .map_err(|error| {\n488\t            LatticeError::Storage(format!(\"Failed to update verification job state: {error}\"))\n489\t        })?;\n490\t        Ok(())\n491\t    }\n492\t}\n493\t\n494\tpub struct FileExistenceCheck;\n495\t\n496\timpl FileExistenceCheck {\n497\t    pub fn run(\n498\t        evidence: &MemoryEvidence,\n499\t        resolver: &IdentityResolver<'_>,\n500\t        file_index: &HashMap<String, FileIndexEntry>,\n501\t    ) -> Result<VerificationVerdict, VerificationError> {\n502\t        let reference = required_reference(evidence, \"file\")?;\n503\t        let file_id = match decode_identity(reference).ok() {\n504\t            Some(Identity::File(file_id)) => file_id,\n505\t            _ => FileId {\n506\t                workspace_id: resolver.default_workspace_id().clone(),\n507\t                repo_relative_path: reference.to_string(),\n508\t                content_hash: \"00000000\".to_string(),\n509\t            },\n510\t        };\n511\t        resolve_file_verdict(evidence, &file_id, file_index)\n512\t    }\n513\t}\n514\t\n515\tpub struct SymbolExistenceCheck;\n516\t\n517\timpl SymbolExistenceCheck {\n518\t    pub fn run(\n519\t        evidence: &MemoryEvidence,\n520\t        resolver: &IdentityResolver<'_>,\n521\t        file_index: &HashMap<String, FileIndexEntry>,\n522\t        graph: &CodeGraph,\n523\t    ) -> Result<VerificationVerdict, VerificationError> {\n524\t        let reference = required_reference(evidence, \"symbol\")?;\n525\t        let symbol_id = match resolver.resolve_symbol(resolver.default_workspace_id(), reference) {\n526\t            ResolveOutcome::Unique(symbol_id) => symbol_id,\n527\t            ResolveOutcome::Ambiguous(report) => {\n528\t                return Ok(VerificationVerdict::new(\n529\t                    VerificationStatus::Invalidated,\n530\t                    report.to_string(),\n531\t                ));\n532\t            }\n533\t            ResolveOutcome::NotFound(error) => {\n534\t                return Ok(VerificationVerdict::new(\n535\t                    VerificationStatus::Invalidated,\n536\t                    error.to_string(),\n537\t                ));\n538\t            }\n539\t        };\n540\t        if graph.get_node(&legacy_symbol_id(&symbol_id)).is_none() {\n541\t            return Ok(VerificationVerdict::new(\n542\t                VerificationStatus::Invalidated,\n543\t                format!(\"symbol `{}` no longer resolves\", symbol_id),\n544\t            ));\n545\t        }\n546\t        stale_or_verified(\n547\t            evidence,\n548\t            &symbol_id.file.repo_relative_path,\n549\t            file_index,\n550\t            format!(\"symbol `{}` exists\", symbol_id),\n551\t        )\n552\t    }\n553\t}\n554\t\n555\tpub struct DocSectionExistenceCheck;\n556\t\n557\timpl DocSectionExistenceCheck {\n558\t    pub fn run(\n559\t        evidence: &MemoryEvidence,\n560\t        _resolver: &IdentityResolver<'_>,\n561\t        file_index: &HashMap<String, FileIndexEntry>,\n562\t        parsed_files: &HashMap<String, ParsedFile>,\n563\t    ) -> Result<VerificationVerdict, VerificationError> {\n564\t        let section_id = section_identity(evidence)?;\n565\t        let path = section_id.doc.repo_relative_path.clone();\n566\t        let heading = section_id.heading_path.last().cloned().unwrap_or_default();\n567\t        let Some(parsed) = parsed_files.get(&path) else {\n568\t            return Ok(VerificationVerdict::new(\n569\t                VerificationStatus::Invalidated,\n570\t                format!(\"document section `{}` no longer resolves\", section_id),\n571\t            ));\n572\t        };\n573\t        let exists = parsed.symbols.iter().any(|symbol| {\n574\t            symbol.kind == crate::symbols::SymbolKind::Section\n575\t                && symbol.name == heading\n576\t                && symbol.id.byte_offset == section_id.byte_offset\n577\t        });\n578\t        if !exists {\n579\t            return Ok(VerificationVerdict::new(\n580\t                VerificationStatus::Invalidated,\n581\t                format!(\"document section `{}` no longer resolves\", section_id),\n582\t            ));\n583\t        }\n584\t        stale_or_verified(\n585\t            evidence,\n586\t            &path,\n587\t            file_index,\n588\t            format!(\"document section `{}` exists\", section_id),\n589\t        )\n590\t    }\n591\t}\n592\t\n593\tpub struct TestExistenceCheck;\n594\t\n595\timpl TestExistenceCheck {\n596\t    pub fn run(\n597\t        evidence: &MemoryEvidence,\n598\t        resolver: &IdentityResolver<'_>,\n599\t        file_index: &HashMap<String, FileIndexEntry>,\n600\t        graph: &CodeGraph,\n601\t    ) -> Result<VerificationVerdict, VerificationError> {\n602\t        let reference = required_reference(evidence, \"test\")?;\n603\t        let symbol_id = match resolver.resolve_test(resolver.default_workspace_id(), reference) {\n604\t            ResolveOutcome::Unique(symbol_id) => symbol_id,\n605\t            ResolveOutcome::Ambiguous(report) => {\n606\t                return Ok(VerificationVerdict::new(\n607\t                    VerificationStatus::Invalidated,\n608\t                    report.to_string(),\n609\t                ));\n610\t            }\n611\t            ResolveOutcome::NotFound(_) => {\n612\t                if let Some(identity) = decode_identity(reference).ok() {\n613\t                    if let Identity::Symbol(symbol_id) = identity {\n614\t                        if graph.get_node(&legacy_symbol_id(&symbol_id)).is_some() {\n615\t                            return stale_or_verified(\n616\t                                evidence,\n617\t                                &symbol_id.file.repo_relative_path,\n618\t                                file_index,\n619\t                                format!(\"test `{}` exists\", symbol_id),\n620\t                            );\n621\t                        }\n622\t                    }\n623\t                }\n624\t                return Ok(VerificationVerdict::new(\n625\t                    VerificationStatus::Invalidated,\n626\t                    format!(\"test `{reference}` no longer resolves\"),\n627\t                ));\n628\t            }\n629\t        };\n630\t        if graph.get_node(&legacy_symbol_id(&symbol_id)).is_none() {\n631\t            return Ok(VerificationVerdict::new(\n632\t                VerificationStatus::Invalidated,\n633\t                format!(\"test `{}` no longer resolves\", symbol_id),\n634\t            ));\n635\t        }\n636\t        stale_or_verified(\n637\t            evidence,\n638\t            &symbol_id.file.repo_relative_path,\n639\t            file_index,\n640\t            format!(\"test `{}` exists\", symbol_id),\n641\t        )\n642\t    }\n643\t}\n644\t\n645\tfn aggregate_verdicts(verdicts: &[VerificationVerdict]) -> VerificationVerdict {\n646\t    if verdicts.is_empty() {\n647\t        return VerificationVerdict::new(\n648\t            VerificationStatus::Verified,\n649\t            \"memory has no existence evidence to verify\",\n650\t        );\n651\t    }\n652\t    if let Some(verdict) = verdicts\n653\t        .iter()\n654\t        .find(|verdict| verdict.status == VerificationStatus::Invalidated)\n655\t    {\n656\t        return verdict.clone();\n657\t    }\n658\t    if let Some(verdict) = verdicts\n659\t        .iter()\n660\t        .find(|verdict| verdict.status == VerificationStatus::Stale)\n661\t    {\n662\t        return verdict.clone();\n663\t    }\n664\t    if verdicts\n665\t        .iter()\n666\t        .all(|verdict| verdict.status == VerificationStatus::Verified)\n667\t    {\n668\t        return VerificationVerdict::new(\n669\t            VerificationStatus::Verified,\n670\t            \"all existence evidence still resolves\",\n671\t        );\n672\t    }\n673\t    VerificationVerdict::new(\n674\t        VerificationStatus::Unverified,\n675\t        \"verification completed with non-deterministic evidence results\",\n676\t    )\n677\t}\n678\t\n679\tfn project_state(\n680\t    prior_state: &crate::consolidation::ConsolidationMemoryState,\n681\t    verdict: &VerificationVerdict,\n682\t) -> Option<(ProposalKind, crate::consolidation::ConsolidationMemoryState)> {\n683\t    let mut proposed_state = prior_state.clone();\n684\t    proposed_state.last_verified_at = Some((now_unix_micros() / 1_000_000) as u64);\n685\t    proposed_state.memory.is_stale = verdict.status == VerificationStatus::Stale;\n686\t    proposed_state.memory.stale_reason = match verdict.status {\n687\t        VerificationStatus::Stale => Some(verdict.reason.clone()),\n688\t        _ => None,\n689\t    };\n690\t    proposed_state.structured_fields.verification_status = map_memory_status(verdict.status);\n691\t    let proposal_kind = match verdict.status {\n692\t        VerificationStatus::Verified => ProposalKind::MarkVerified,\n693\t        VerificationStatus::Stale => ProposalKind::MarkStale,\n694\t        VerificationStatus::Invalidated => ProposalKind::MarkInvalidated,\n695\t        _ => return None,\n696\t    };\n697\t    Some((proposal_kind, proposed_state))\n698\t}\n699\t\n700\tfn map_memory_status(status: VerificationStatus) -> MemoryVerificationStatus {\n701\t    match status {\n702\t        VerificationStatus::Verified => MemoryVerificationStatus::Verified,\n703\t        VerificationStatus::Unverified => MemoryVerificationStatus::Unverified,\n704\t        VerificationStatus::InReview => MemoryVerificationStatus::InReview,\n705\t        VerificationStatus::Stale => MemoryVerificationStatus::Stale,\n706\t        VerificationStatus::Contradicted => MemoryVerificationStatus::Contradicted,\n707\t        VerificationStatus::Superseded => MemoryVerificationStatus::Superseded,\n708\t        VerificationStatus::Expired => MemoryVerificationStatus::Expired,\n709\t        VerificationStatus::Invalidated => MemoryVerificationStatus::Invalidated,\n710\t    }\n711\t}\n712\t\n713\tfn required_reference<'a>(\n714\t    evidence: &'a MemoryEvidence,\n715\t    kind: &'static str,\n716\t) -> Result<&'a str, VerificationError> {\n717\t    evidence\n718\t        .reference\n719\t        .as_deref()\n720\t        .filter(|value| !value.trim().is_empty())\n721\t        .ok_or_else(|| LatticeError::Storage(format!(\"missing {kind} evidence reference\")).into())\n722\t}\n723\t\n724\tfn evidence_row_id(memory_id: &str, index: usize) -> String {\n725\t    format!(\"{memory_id}:evidence:{index}\")\n726\t}\n727\t\n728\tfn resolve_file_verdict(\n729\t    evidence: &MemoryEvidence,\n730\t    file_id: &FileId,\n731\t    file_index: &HashMap<String, FileIndexEntry>,\n732\t) -> Result<VerificationVerdict, VerificationError> {\n733\t    if !file_index.contains_key(&file_id.repo_relative_path) {\n734\t        return Ok(VerificationVerdict::new(\n735\t            VerificationStatus::Invalidated,\n736\t            format!(\"file `{}` no longer exists\", file_id.repo_relative_path),\n737\t        ));\n738\t    }\n739\t    stale_or_verified(\n740\t        evidence,\n741\t        &file_id.repo_relative_path,\n742\t        file_index,\n743\t        format!(\"file `{}` exists\", file_id.repo_relative_path),\n744\t    )\n745\t}\n746\t\n747\tfn stale_or_verified(\n748\t    evidence: &MemoryEvidence,\n749\t    path: &str,\n750\t    file_index: &HashMap<String, FileIndexEntry>,\n751\t    verified_reason: String,\n752\t) -> Result<VerificationVerdict, VerificationError> {\n753\t    let Some(entry) = file_index.get(path) else {\n754\t        return Ok(VerificationVerdict::new(\n755\t            VerificationStatus::Invalidated,\n756\t            format!(\"path `{path}` is no longer indexed\"),\n757\t        ));\n758\t    };\n759\t    if let Some(captured_at) = evidence.captured_at {\n760\t        let snapshot_age = entry.last_indexed_at.max(0) as u64;\n761\t        if snapshot_age < captured_at {\n762\t            return Ok(VerificationVerdict::new(\n763\t                VerificationStatus::Stale,\n764\t                format!(\n765\t                    \"graph snapshot for `{path}` ({snapshot_age}) predates evidence capture ({captured_at})\"\n766\t                ),\n767\t            ));\n768\t        }\n769\t    }\n770\t    Ok(VerificationVerdict::new(\n771\t        VerificationStatus::Verified,\n772\t        verified_reason,\n773\t    ))\n774\t}\n775\t\n776\tfn legacy_symbol_id(symbol_id: &SymbolId) -> crate::symbols::SymbolId {\n777\t    crate::symbols::SymbolId {\n778\t        file: symbol_id.file.repo_relative_path.clone(),\n779\t        name: symbol_id.qualified_name.clone(),\n780\t        byte_offset: symbol_id.byte_offset,\n781\t    }\n782\t}\n783\t\n784\tfn section_identity(evidence: &MemoryEvidence) -> Result<SectionId, VerificationError> {\n785\t    let reference = required_reference(evidence, \"doc_section\")?;\n786\t    if let Some(Identity::Section(section_id)) = decode_identity(reference).ok() {\n787\t        return Ok(section_id);\n788\t    }\n789\t    let (path, heading) = reference.split_once('#').ok_or_else(|| {\n790\t        LatticeError::Storage(format!(\n791\t            \"doc_section evidence `{reference}` must be a stable section identity or path#heading\"\n792\t        ))\n793\t    })?;\n794\t    Ok(SectionId {\n795\t        doc: DocId {\n796\t            workspace_id: \"workspace-main\".to_string(),\n797\t            repo_relative_path: path.to_string(),\n798\t            content_hash: \"00000000\".to_string(),\n799\t        },\n800\t        heading_path: vec![heading.to_string()],\n801\t        byte_offset: 0,\n802\t    })\n803\t}\n804\t"}]},"parent_tool_use_id":null,"session_id":"0696e093-0770-442b-8dc9-5393bbfcd0b6","uuid":"5164b7d4-3eb4-4c51-b259-6c6b6fc044d3","timestamp":"2026-05-17T13:01:52.050Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/existence.rs","content":"use std::collections::HashMap;\nuse std::time::Instant;\n\nuse rusqlite::{params, OptionalExtension};\nuse tracing::{debug_span, field, info, info_span, warn};\n\nuse super::{\n    ScopeEnforcement, ScopeFilter, SpanReader, SpanValidationError, SpanValidator,\n    VerificationStatus, VerificationVerdict,\n};\nuse crate::consolidation::{\n    capture_memory_state, encode_memory_state, now_unix_micros, ConsolidationJobMode,\n    ConsolidationJobRuntime, PendingProposalSpec, ProposalKind,\n};\nuse crate::error::LatticeError;\nuse crate::events::BranchRef;\nuse crate::graph::CodeGraph;\nuse crate::identity::{\n    decode_identity, DocId, FileId, Identity, IdentityResolver, ResolveOutcome, SectionId, SymbolId,\n};\nuse crate::memory::{MemoryEvidence, MemoryStore, MemoryVerificationStatus};\nuse crate::storage::graph_store::FileIndexEntry;\nuse crate::symbols::ParsedFile;\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct VerifierBudget {\n    pub max_memories: usize,\n}\n\nimpl Default for VerifierBudget {\n    fn default() -> Self {\n        Self { max_memories: 32 }\n    }\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\npub struct VerifierReport {\n    pub verified: u32,\n    pub stale: u32,\n    pub invalidated: u32,\n    pub expired: u32,\n    pub elapsed_millis: u128,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct VerificationOutcome {\n    pub verdict: VerificationVerdict,\n    pub proposal_id: Option<String>,\n}\n\n#[derive(Debug, thiserror::Error)]\npub enum VerificationError {\n    #[error(transparent)]\n    Storage(#[from] LatticeError),\n    #[error(transparent)]\n    Span(#[from] SpanValidationError),\n    #[error(\"memory '{memory_id}' not found\")]\n    MissingMemory { memory_id: String },\n    #[error(\"graph snapshot is unavailable for workspace '{workspace_id}'\")]\n    MissingGraphSnapshot { workspace_id: String },\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\nenum VerificationJobState {\n    Queued,\n    Running,\n    Completed,\n    Failed,\n}\n\nimpl VerificationJobState {\n    fn as_str(self) -> &'static str {\n        match self {\n            Self::Queued => \"queued\",\n            Self::Running => \"running\",\n            Self::Completed => \"completed\",\n            Self::Failed => \"failed\",\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\nstruct VerificationJobRecord {\n    job_id: String,\n    target_memory_id: String,\n}\n\npub struct VerifierCore<'a> {\n    store: &'a MemoryStore,\n    runtime: &'a mut ConsolidationJobRuntime,\n    graph: &'a CodeGraph,\n    file_index: &'a HashMap<String, FileIndexEntry>,\n    parsed_files: &'a HashMap<String, ParsedFile>,\n    span_reader: &'a dyn SpanReader,\n    workspace_id: &'a str,\n}\n\nimpl<'a> VerifierCore<'a> {\n    pub fn new(\n        store: &'a MemoryStore,\n        runtime: &'a mut ConsolidationJobRuntime,\n        graph: &'a CodeGraph,\n        file_index: &'a HashMap<String, FileIndexEntry>,\n        parsed_files: &'a HashMap<String, ParsedFile>,\n        span_reader: &'a dyn SpanReader,\n        workspace_id: &'a str,\n    ) -> Self {\n        Self {\n            store,\n            runtime,\n            graph,\n            file_index,\n            parsed_files,\n            span_reader,\n            workspace_id,\n        }\n    }\n\n    pub fn verify_memory(\n        &mut self,\n        memory_id: &str,\n    ) -> Result<VerificationVerdict, VerificationError> {\n        Ok(self.verify_memory_with_outcome(memory_id)?.verdict)\n    }\n\n    pub fn verify_memory_with_outcome(\n        &mut self,\n        memory_id: &str,\n    ) -> Result<VerificationOutcome, VerificationError> {\n        let job = self.enqueue_job(memory_id)?;\n        self.verify_job(job)\n    }\n\n    pub fn run_pending_jobs(\n        &mut self,\n        workspace_id: &str,\n        budget: VerifierBudget,\n    ) -> Result<VerifierReport, VerificationError> {\n        let started = Instant::now();\n        self.seed_jobs(workspace_id, budget.max_memories)?;\n        let jobs = self.pending_jobs(workspace_id, budget.max_memories)?;\n        let mut report = VerifierReport::default();\n\n        for job in jobs {\n            match self.verify_job(job) {\n                Ok(outcome) => match outcome.verdict.status {\n                    VerificationStatus::Verified => report.verified += 1,\n                    VerificationStatus::Stale => report.stale += 1,\n                    VerificationStatus::Invalidated => report.invalidated += 1,\n                    VerificationStatus::Expired => report.expired += 1,\n                    _ => {}\n                },\n                Err(error) => warn!(error = %error, \"verification job failed\"),\n            }\n        }\n\n        report.elapsed_millis = started.elapsed().as_millis();\n        info!(\n            workspace_id,\n            verified = report.verified,\n            stale = report.stale,\n            invalidated = report.invalidated,\n            expired = report.expired,\n            elapsed_millis = report.elapsed_millis,\n            \"verifier run completed\"\n        );\n        Ok(report)\n    }\n\n    fn verify_job(\n        &mut self,\n        job: VerificationJobRecord,\n    ) -> Result<VerificationOutcome, VerificationError> {\n        self.ensure_graph_snapshot()?;\n        self.mark_job_state(&job.job_id, VerificationJobState::Running, None, None)?;\n        let result = self.verify_memory_inner(&job.target_memory_id);\n        match &result {\n            Ok(outcome) => {\n                self.mark_job_state(\n                    &job.job_id,\n                    VerificationJobState::Completed,\n                    Some(outcome.verdict.status),\n                    Some(outcome.verdict.reason.as_str()),\n                )?;\n            }\n            Err(error) => {\n                self.mark_job_state(\n                    &job.job_id,\n                    VerificationJobState::Failed,\n                    None,\n                    Some(&error.to_string()),\n                )?;\n            }\n        }\n        result\n    }\n\n    fn verify_memory_inner(\n        &mut self,\n        memory_id: &str,\n    ) -> Result<VerificationOutcome, VerificationError> {\n        let memory =\n            self.store\n                .get_by_id(memory_id)?\n                .ok_or_else(|| VerificationError::MissingMemory {\n                    memory_id: memory_id.to_string(),\n                })?;\n        let prior_state = capture_memory_state(self.store, &memory)?;\n        let evidence = prior_state.structured_fields.evidence.clone();\n        let resolver = IdentityResolver::new(\n            self.graph,\n            self.file_index,\n            self.parsed_files,\n            self.workspace_id.to_string(),\n            Vec::new(),\n        );\n        let span = info_span!(\n            \"verify_memory\",\n            memory_id = memory_id,\n            evidence_count = evidence.len(),\n            verdict = field::Empty\n        );\n        let _entered = span.enter();\n\n        let mut verdicts = Vec::new();\n        for (index, entry) in evidence.iter().enumerate() {\n            let outcome = match entry.kind.as_str() {\n                \"file\" => FileExistenceCheck::run(entry, &resolver, self.file_index),\n                \"symbol\" => {\n                    SymbolExistenceCheck::run(entry, &resolver, self.file_index, self.graph)\n                }\n                \"doc_section\" => DocSectionExistenceCheck::run(\n                    entry,\n                    &resolver,\n                    self.file_index,\n                    self.parsed_files,\n                ),\n                \"test\" => TestExistenceCheck::run(entry, &resolver, self.file_index, self.graph),\n                _ => {\n                    warn!(\n                        kind = entry.kind.as_str(),\n                        \"unsupported verification evidence kind\"\n                    );\n                    continue;\n                }\n            };\n            match outcome {\n                Ok(verdict) => {\n                    let existence_ok = verdict.status == VerificationStatus::Verified;\n                    verdicts.push(verdict);\n                    if existence_ok {\n                        let evidence_id = evidence_row_id(memory_id, index);\n                        let span_verdict =\n                            self.verify_span_evidence(memory_id, &evidence_id, entry)?;\n                        verdicts.push(span_verdict);\n                    }\n                }\n                Err(error) => {\n                    warn!(memory_id, evidence_kind = entry.kind.as_str(), error = %error, \"verification evidence failed\");\n                    verdicts.push(VerificationVerdict::new(\n                        VerificationStatus::Unverified,\n                        error.to_string(),\n                    ));\n                }\n            }\n        }\n\n        verdicts.push(self.verify_scope(&memory));\n\n        let verdict = aggregate_verdicts(&verdicts);\n        span.record(\"verdict\", verdict.status.as_str());\n        let proposal_id = self.emit_proposal(memory_id, &prior_state, &verdict)?;\n        Ok(VerificationOutcome {\n            verdict,\n            proposal_id,\n        })\n    }\n\n    fn verify_span_evidence(\n        &self,\n        memory_id: &str,\n        evidence_id: &str,\n        evidence: &MemoryEvidence,\n    ) -> Result<VerificationVerdict, VerificationError> {\n        let Some(span) = evidence.span.as_ref() else {\n            return Ok(VerificationVerdict::new(\n                VerificationStatus::Verified,\n                \"span validation skipped because evidence has no exact span\",\n            ));\n        };\n        let span_guard = debug_span!(\n            \"validate_span\",\n            memory_id,\n            file_id = %span.file_id,\n            byte_start = span.byte_start,\n            byte_end = span.byte_end,\n            verdict = field::Empty\n        );\n        let verdict = {\n            let _entered = span_guard.enter();\n            SpanValidator::validate_with_reader(evidence_id, evidence, self.span_reader)?\n        };\n        span_guard.record(\"verdict\", verdict.status.as_str());\n        Ok(verdict)\n    }\n\n    fn emit_proposal(\n        &mut self,\n        memory_id: &str,\n        prior_state: &crate::consolidation::ConsolidationMemoryState,\n        verdict: &VerificationVerdict,\n    ) -> Result<Option<String>, VerificationError> {\n        let Some((proposal_kind, proposed_state)) = project_state(prior_state, verdict) else {\n            return Ok(None);\n        };\n        let job_id = format!(\"verify-proposal-{}-{}\", memory_id, now_unix_micros());\n        let proposal_id = format!(\"verify-proposal-{}-{}\", memory_id, now_unix_micros());\n        let _ = self\n            .runtime\n            .submit_inline(crate::consolidation::ConsolidationJobSpec {\n                job_id,\n                workspace_id: self.workspace_id.to_string(),\n                kind: \"verify durable memory evidence\".to_string(),\n                mode: ConsolidationJobMode::Background,\n                proposal: Some(PendingProposalSpec {\n                    proposal_id: proposal_id.clone(),\n                    target_memory_id: Some(memory_id.to_string()),\n                    proposal_kind,\n                    prior_state: encode_memory_state(prior_state),\n                    proposed_state: encode_memory_state(&proposed_state),\n                    evidence: serde_json::json!({\n                        \"source_memory_ids\": [memory_id],\n                        \"verification_status\": verdict.status.as_str(),\n                        \"reason\": verdict.reason,\n                    }),\n                    provenance: None,\n                }),\n            })?;\n        Ok(Some(proposal_id))\n    }\n\n    fn verify_scope(&self, memory: &crate::memory::Memory) -> VerificationVerdict {\n        let filter = ScopeFilter {\n            workspace_id: memory.workspace_id.clone().unwrap_or_default(),\n            branch: memory.branch.clone().map(|name| BranchRef { name }),\n            organization_id: memory.scope_organization_id.clone(),\n            session_id: Some(memory.session_id.clone()),\n        };\n        ScopeEnforcement::audit_memory(memory, &filter)\n    }\n\n    fn ensure_graph_snapshot(&self) -> Result<(), VerificationError> {\n        if self.workspace_id.trim().is_empty() {\n            return Err(VerificationError::MissingGraphSnapshot {\n                workspace_id: self.workspace_id.to_string(),\n            });\n        }\n        Ok(())\n    }\n\n    fn enqueue_job(&mut self, memory_id: &str) -> Result<VerificationJobRecord, VerificationError> {\n        let job = VerificationJobRecord {\n            job_id: format!(\"verify-job-{}-{}\", memory_id, now_unix_micros()),\n            target_memory_id: memory_id.to_string(),\n        };\n        let queued_at = now_unix_micros();\n        let conn = self.runtime.lock_conn()?;\n        conn.execute(\n            \"INSERT INTO verification_jobs\n                (job_id, workspace_id, target_memory_id, check_kind, status, verdict, reason, queued_at)\n             VALUES (?1, ?2, ?3, ?4, ?5, NULL, NULL, ?6)\",\n            params![\n                job.job_id,\n                self.workspace_id,\n                job.target_memory_id,\n                \"existence\",\n                VerificationJobState::Queued.as_str(),\n                queued_at,\n            ],\n        )\n        .map_err(|error| LatticeError::Storage(format!(\"Failed to enqueue verification job: {error}\")))?;\n        Ok(job)\n    }\n\n    fn seed_jobs(&mut self, workspace_id: &str, max_jobs: usize) -> Result<(), VerificationError> {\n        if max_jobs == 0 {\n            return Ok(());\n        }\n        let memories = self.store.list_workspace_memories(workspace_id)?;\n        for memory in memories.into_iter().take(max_jobs) {\n            if self.has_active_job(&memory.id)? {\n                continue;\n            }\n            let _ = self.enqueue_job(&memory.id)?;\n        }\n        Ok(())\n    }\n\n    fn has_active_job(&mut self, memory_id: &str) -> Result<bool, VerificationError> {\n        let conn = self.runtime.lock_conn()?;\n        let status = conn\n            .query_row(\n                \"SELECT 1\n                 FROM verification_jobs\n                 WHERE workspace_id = ?1\n                   AND target_memory_id = ?2\n                   AND status IN ('queued', 'running')\n                 LIMIT 1\",\n                params![self.workspace_id, memory_id],\n                |row| row.get::<_, i64>(0),\n            )\n            .optional()\n            .map_err(|error| {\n                LatticeError::Storage(format!(\"Failed to inspect verification queue: {error}\"))\n            })?;\n        Ok(status.is_some())\n    }\n\n    fn pending_jobs(\n        &mut self,\n        workspace_id: &str,\n        limit: usize,\n    ) -> Result<Vec<VerificationJobRecord>, VerificationError> {\n        let conn = self.runtime.lock_conn()?;\n        let mut statement = conn\n            .prepare(\n                \"SELECT job_id, target_memory_id\n                 FROM verification_jobs\n                 WHERE workspace_id = ?1\n                   AND status = 'queued'\n                 ORDER BY queued_at ASC\n                 LIMIT ?2\",\n            )\n            .map_err(|error| {\n                LatticeError::Storage(format!(\"Failed to prepare verification job query: {error}\"))\n            })?;\n        let rows = statement\n            .query_map(params![workspace_id, limit as i64], |row| {\n                Ok(VerificationJobRecord {\n                    job_id: row.get(0)?,\n                    target_memory_id: row.get(1)?,\n                })\n            })\n            .map_err(|error| {\n                LatticeError::Storage(format!(\"Failed to query verification jobs: {error}\"))\n            })?;\n        let mut jobs = Vec::new();\n        for row in rows {\n            jobs.push(row.map_err(|error| {\n                LatticeError::Storage(format!(\"Failed to decode verification job row: {error}\"))\n            })?);\n        }\n        Ok(jobs)\n    }\n\n    fn mark_job_state(\n        &mut self,\n        job_id: &str,\n        state: VerificationJobState,\n        verdict: Option<VerificationStatus>,\n        reason: Option<&str>,\n    ) -> Result<(), VerificationError> {\n        let now = now_unix_micros();\n        let (started_at, finished_at) = match state {\n            VerificationJobState::Queued => (None, None),\n            VerificationJobState::Running => (Some(now), None),\n            VerificationJobState::Completed | VerificationJobState::Failed => (None, Some(now)),\n        };\n        let conn = self.runtime.lock_conn()?;\n        conn.execute(\n            \"UPDATE verification_jobs\n             SET status = ?1,\n                 verdict = COALESCE(?2, verdict),\n                 reason = ?3,\n                 started_at = COALESCE(?4, started_at),\n                 finished_at = COALESCE(?5, finished_at)\n             WHERE job_id = ?6\",\n            params![\n                state.as_str(),\n                verdict.map(VerificationStatus::as_str),\n                reason,\n                started_at,\n                finished_at,\n                job_id,\n            ],\n        )\n        .map_err(|error| {\n            LatticeError::Storage(format!(\"Failed to update verification job state: {error}\"))\n        })?;\n        Ok(())\n    }\n}\n\npub struct FileExistenceCheck;\n\nimpl FileExistenceCheck {\n    pub fn run(\n        evidence: &MemoryEvidence,\n        resolver: &IdentityResolver<'_>,\n        file_index: &HashMap<String, FileIndexEntry>,\n    ) -> Result<VerificationVerdict, VerificationError> {\n        let reference = required_reference(evidence, \"file\")?;\n        let file_id = match decode_identity(reference).ok() {\n            Some(Identity::File(file_id)) => file_id,\n            _ => FileId {\n                workspace_id: resolver.default_workspace_id().clone(),\n                repo_relative_path: reference.to_string(),\n                content_hash: \"00000000\".to_string(),\n            },\n        };\n        resolve_file_verdict(evidence, &file_id, file_index)\n    }\n}\n\npub struct SymbolExistenceCheck;\n\nimpl SymbolExistenceCheck {\n    pub fn run(\n        evidence: &MemoryEvidence,\n        resolver: &IdentityResolver<'_>,\n        file_index: &HashMap<String, FileIndexEntry>,\n        graph: &CodeGraph,\n    ) -> Result<VerificationVerdict, VerificationError> {\n        let reference = required_reference(evidence, \"symbol\")?;\n        let symbol_id = match resolver.resolve_symbol(resolver.default_workspace_id(), reference) {\n            ResolveOutcome::Unique(symbol_id) => symbol_id,\n            ResolveOutcome::Ambiguous(report) => {\n                return Ok(VerificationVerdict::new(\n                    VerificationStatus::Invalidated,\n                    report.to_string(),\n                ));\n            }\n            ResolveOutcome::NotFound(error) => {\n                return Ok(VerificationVerdict::new(\n                    VerificationStatus::Invalidated,\n                    error.to_string(),\n                ));\n            }\n        };\n        if graph.get_node(&legacy_symbol_id(&symbol_id)).is_none() {\n            return Ok(VerificationVerdict::new(\n                VerificationStatus::Invalidated,\n                format!(\"symbol `{}` no longer resolves\", symbol_id),\n            ));\n        }\n        stale_or_verified(\n            evidence,\n            &symbol_id.file.repo_relative_path,\n            file_index,\n            format!(\"symbol `{}` exists\", symbol_id),\n        )\n    }\n}\n\npub struct DocSectionExistenceCheck;\n\nimpl DocSectionExistenceCheck {\n    pub fn run(\n        evidence: &MemoryEvidence,\n        _resolver: &IdentityResolver<'_>,\n        file_index: &HashMap<String, FileIndexEntry>,\n        parsed_files: &HashMap<String, ParsedFile>,\n    ) -> Result<VerificationVerdict, VerificationError> {\n        let section_id = section_identity(evidence)?;\n        let path = section_id.doc.repo_relative_path.clone();\n        let heading = section_id.heading_path.last().cloned().unwrap_or_default();\n        let Some(parsed) = parsed_files.get(&path) else {\n            return Ok(VerificationVerdict::new(\n                VerificationStatus::Invalidated,\n                format!(\"document section `{}` no longer resolves\", section_id),\n            ));\n        };\n        let exists = parsed.symbols.iter().any(|symbol| {\n            symbol.kind == crate::symbols::SymbolKind::Section\n                && symbol.name == heading\n                && symbol.id.byte_offset == section_id.byte_offset\n        });\n        if !exists {\n            return Ok(VerificationVerdict::new(\n                VerificationStatus::Invalidated,\n                format!(\"document section `{}` no longer resolves\", section_id),\n            ));\n        }\n        stale_or_verified(\n            evidence,\n            &path,\n            file_index,\n            format!(\"document section `{}` exists\", section_id),\n        )\n    }\n}\n\npub struct TestExistenceCheck;\n\nimpl TestExistenceCheck {\n    pub fn run(\n        evidence: &MemoryEvidence,\n        resolver: &IdentityResolver<'_>,\n        file_index: &HashMap<String, FileIndexEntry>,\n        graph: &CodeGraph,\n    ) -> Result<VerificationVerdict, VerificationError> {\n        let reference = required_reference(evidence, \"test\")?;\n        let symbol_id = match resolver.resolve_test(resolver.default_workspace_id(), reference) {\n            ResolveOutcome::Unique(symbol_id) => symbol_id,\n            ResolveOutcome::Ambiguous(report) => {\n                return Ok(VerificationVerdict::new(\n                    VerificationStatus::Invalidated,\n                    report.to_string(),\n                ));\n            }\n            ResolveOutcome::NotFound(_) => {\n                if let Some(identity) = decode_identity(reference).ok() {\n                    if let Identity::Symbol(symbol_id) = identity {\n                        if graph.get_node(&legacy_symbol_id(&symbol_id)).is_some() {\n                            return stale_or_verified(\n                                evidence,\n                                &symbol_id.file.repo_relative_path,\n                                file_index,\n                                format!(\"test `{}` exists\", symbol_id),\n                            );\n                        }\n                    }\n                }\n                return Ok(VerificationVerdict::new(\n                    VerificationStatus::Invalidated,\n                    format!(\"test `{reference}` no longer resolves\"),\n                ));\n            }\n        };\n        if graph.get_node(&legacy_symbol_id(&symbol_id)).is_none() {\n            return Ok(VerificationVerdict::new(\n                VerificationStatus::Invalidated,\n                format!(\"test `{}` no longer resolves\", symbol_id),\n            ));\n        }\n        stale_or_verified(\n            evidence,\n            &symbol_id.file.repo_relative_path,\n            file_index,\n            format!(\"test `{}` exists\", symbol_id),\n        )\n    }\n}\n\nfn aggregate_verdicts(verdicts: &[VerificationVerdict]) -> VerificationVerdict {\n    if verdicts.is_empty() {\n        return VerificationVerdict::new(\n            VerificationStatus::Verified,\n            \"memory has no existence evidence to verify\",\n        );\n    }\n    if let Some(verdict) = verdicts\n        .iter()\n        .find(|verdict| verdict.status == VerificationStatus::Invalidated)\n    {\n        return verdict.clone();\n    }\n    if let Some(verdict) = verdicts\n        .iter()\n        .find(|verdict| verdict.status == VerificationStatus::Stale)\n    {\n        return verdict.clone();\n    }\n    if verdicts\n        .iter()\n        .all(|verdict| verdict.status == VerificationStatus::Verified)\n    {\n        return VerificationVerdict::new(\n            VerificationStatus::Verified,\n            \"all existence evidence still resolves\",\n        );\n    }\n    VerificationVerdict::new(\n        VerificationStatus::Unverified,\n        \"verification completed with non-deterministic evidence results\",\n    )\n}\n\nfn project_state(\n    prior_state: &crate::consolidation::ConsolidationMemoryState,\n    verdict: &VerificationVerdict,\n) -> Option<(ProposalKind, crate::consolidation::ConsolidationMemoryState)> {\n    let mut proposed_state = prior_state.clone();\n    proposed_state.last_verified_at = Some((now_unix_micros() / 1_000_000) as u64);\n    proposed_state.memory.is_stale = verdict.status == VerificationStatus::Stale;\n    proposed_state.memory.stale_reason = match verdict.status {\n        VerificationStatus::Stale => Some(verdict.reason.clone()),\n        _ => None,\n    };\n    proposed_state.structured_fields.verification_status = map_memory_status(verdict.status);\n    let proposal_kind = match verdict.status {\n        VerificationStatus::Verified => ProposalKind::MarkVerified,\n        VerificationStatus::Stale => ProposalKind::MarkStale,\n        VerificationStatus::Invalidated => ProposalKind::MarkInvalidated,\n        _ => return None,\n    };\n    Some((proposal_kind, proposed_state))\n}\n\nfn map_memory_status(status: VerificationStatus) -> MemoryVerificationStatus {\n    match status {\n        VerificationStatus::Verified => MemoryVerificationStatus::Verified,\n        VerificationStatus::Unverified => MemoryVerificationStatus::Unverified,\n        VerificationStatus::InReview => MemoryVerificationStatus::InReview,\n        VerificationStatus::Stale => MemoryVerificationStatus::Stale,\n        VerificationStatus::Contradicted => MemoryVerificationStatus::Contradicted,\n        VerificationStatus::Superseded => MemoryVerificationStatus::Superseded,\n        VerificationStatus::Expired => MemoryVerificationStatus::Expired,\n        VerificationStatus::Invalidated => MemoryVerificationStatus::Invalidated,\n    }\n}\n\nfn required_reference<'a>(\n    evidence: &'a MemoryEvidence,\n    kind: &'static str,\n) -> Result<&'a str, VerificationError> {\n    evidence\n        .reference\n        .as_deref()\n        .filter(|value| !value.trim().is_empty())\n        .ok_or_else(|| LatticeError::Storage(format!(\"missing {kind} evidence reference\")).into())\n}\n\nfn evidence_row_id(memory_id: &str, index: usize) -> String {\n    format!(\"{memory_id}:evidence:{index}\")\n}\n\nfn resolve_file_verdict(\n    evidence: &MemoryEvidence,\n    file_id: &FileId,\n    file_index: &HashMap<String, FileIndexEntry>,\n) -> Result<VerificationVerdict, VerificationError> {\n    if !file_index.contains_key(&file_id.repo_relative_path) {\n        return Ok(VerificationVerdict::new(\n            VerificationStatus::Invalidated,\n            format!(\"file `{}` no longer exists\", file_id.repo_relative_path),\n        ));\n    }\n    stale_or_verified(\n        evidence,\n        &file_id.repo_relative_path,\n        file_index,\n        format!(\"file `{}` exists\", file_id.repo_relative_path),\n    )\n}\n\nfn stale_or_verified(\n    evidence: &MemoryEvidence,\n    path: &str,\n    file_index: &HashMap<String, FileIndexEntry>,\n    verified_reason: String,\n) -> Result<VerificationVerdict, VerificationError> {\n    let Some(entry) = file_index.get(path) else {\n        return Ok(VerificationVerdict::new(\n            VerificationStatus::Invalidated,\n            format!(\"path `{path}` is no longer indexed\"),\n        ));\n    };\n    if let Some(captured_at) = evidence.captured_at {\n        let snapshot_age = entry.last_indexed_at.max(0) as u64;\n        if snapshot_age < captured_at {\n            return Ok(VerificationVerdict::new(\n                VerificationStatus::Stale,\n                format!(\n                    \"graph snapshot for `{path}` ({snapshot_age}) predates evidence capture ({captured_at})\"\n                ),\n            ));\n        }\n    }\n    Ok(VerificationVerdict::new(\n        VerificationStatus::Verified,\n        verified_reason,\n    ))\n}\n\nfn legacy_symbol_id(symbol_id: &SymbolId) -> crate::symbols::SymbolId {\n    crate::symbols::SymbolId {\n        file: symbol_id.file.repo_relative_path.clone(),\n        name: symbol_id.qualified_name.clone(),\n        byte_offset: symbol_id.byte_offset,\n    }\n}\n\nfn section_identity(evidence: &MemoryEvidence) -> Result<SectionId, VerificationError> {\n    let reference = required_reference(evidence, \"doc_section\")?;\n    if let Some(Identity::Section(section_id)) = decode_identity(reference).ok() {\n        return Ok(section_id);\n    }\n    let (path, heading) = reference.split_once('#').ok_or_else(|| {\n        LatticeError::Storage(format!(\n            \"doc_section evidence `{reference}` must be a stable section identity or path#heading\"\n        ))\n    })?;\n    Ok(SectionId {\n        doc: DocId {\n            workspace_id: \"workspace-main\".to_string(),\n            repo_relative_path: path.to_string(),\n            content_hash: \"00000000\".to_string(),\n        },\n        heading_path: vec![heading.to_string()],\n        byte_offset: 0,\n    })\n}\n","numLines":804,"startLine":1,"totalLines":804}}}
