{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JeNDPB7XHBTzrM7GwXHzpp","type":"tool_result","content":"1\tuse std::collections::HashMap;\n2\tuse std::path::PathBuf;\n3\tuse std::sync::Arc;\n4\t\n5\tuse rusqlite::Connection;\n6\tuse tempfile::tempdir;\n7\t\n8\tuse super::{VerificationStatus, VerifierCore, WorkspaceFileReader};\n9\tuse crate::consolidation::{\n10\t    ConsolidationConfig, ConsolidationJobRuntime, ConsolidationProposal, ProposalKind,\n11\t};\n12\tuse crate::events::{EventStore, EventWriter, FlushPolicy};\n13\tuse crate::graph::CodeGraph;\n14\tuse crate::identity::{FileId, SymbolId};\n15\tuse crate::memory::{\n16\t    Memory, MemoryEvidence, MemoryScope, MemoryStore, MemoryStructuredFields, MemoryType,\n17\t    MemoryVerificationStatus,\n18\t};\n19\tuse crate::storage::graph_store::{\n20\t    FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n21\t};\n22\tuse crate::symbols::{Language, ParsedFile, Symbol, SymbolKind};\n23\t\n24\t#[test]\n25\tfn live_file_evidence_emits_verified_proposal() {\n26\t    let fixture = Fixture::new();\n27\t    let file_id = fixture.file_id(\"src/auth.ts\", \"hash-auth\");\n28\t    let memory_id = fixture.seed_memory(\n29\t        \"memory-file\",\n30\t        vec![MemoryEvidence {\n31\t            kind: \"file\".to_string(),\n32\t            reference: Some(file_id.repo_relative_path.clone()),\n33\t            detail: None,\n34\t            captured_at: Some(100),\n35\t            span: None,\n36\t            evidence_content_hash: None,\n37\t        }],\n38\t    );\n39\t    let graph = fixture.graph_with_auth(false);\n40\t    let file_index = fixture.file_index(&[(\"src/auth.ts\", \"hash-auth\", 120)]);\n41\t    let parsed_files = HashMap::new();\n42\t\n43\t    let verdict = fixture.verify(&memory_id, &graph, &file_index, &parsed_files);\n44\t\n45\t    assert_eq!(verdict.status, VerificationStatus::Verified);\n46\t    assert_eq!(fixture.latest_proposal_kind(), ProposalKind::MarkVerified);\n47\t    assert_eq!(\n48\t        fixture\n49\t            .memory_store\n50\t            .get_structured_fields(&memory_id)\n51\t            .unwrap()\n52\t            .unwrap()\n53\t            .verification_status,\n54\t        MemoryVerificationStatus::Unverified\n55\t    );\n56\t}\n57\t\n58\t#[test]\n59\tfn deleting_file_emits_invalidated_proposal() {\n60\t    let fixture = Fixture::new();\n61\t    let memory_id = fixture.seed_memory(\n62\t        \"memory-delete-file\",\n63\t        vec![MemoryEvidence {\n64\t            kind: \"file\".to_string(),\n65\t            reference: Some(\"src/auth.ts\".to_string()),\n66\t            detail: None,\n67\t            captured_at: Some(100),\n68\t            span: None,\n69\t            evidence_content_hash: None,\n70\t        }],\n71\t    );\n72\t    let file_index = fixture.file_index(&[]);\n73\t    let parsed_files = HashMap::new();\n74\t\n75\t    let verdict = fixture.verify(&memory_id, &CodeGraph::new(), &file_index, &parsed_files);\n76\t\n77\t    assert_eq!(verdict.status, VerificationStatus::Invalidated);\n78\t    assert_eq!(\n79\t        fixture.latest_proposal_kind(),\n80\t        ProposalKind::MarkInvalidated\n81\t    );\n82\t}\n83\t\n84\t#[test]\n85\tfn deleted_symbol_emits_invalidated_proposal() {\n86\t    let fixture = Fixture::new();\n87\t    let file_id = fixture.file_id(\"src/auth.ts\", \"hash-auth\");\n88\t    let symbol_id = fixture.symbol_id(&file_id, \"loginUser\", 12, \"function\");\n89\t    let memory_id = fixture.seed_memory(\n90\t        \"memory-symbol\",\n91\t        vec![MemoryEvidence {\n92\t            kind: \"symbol\".to_string(),\n93\t            reference: Some(symbol_id.to_string()),\n94\t            detail: None,\n95\t            captured_at: Some(100),\n96\t            span: None,\n97\t            evidence_content_hash: None,\n98\t        }],\n99\t    );\n100\t    let file_index = fixture.file_index(&[(\"src/auth.ts\", \"hash-auth\", 120)]);\n101\t    let parsed_files = HashMap::new();\n102\t\n103\t    let verdict = fixture.verify(&memory_id, &CodeGraph::new(), &file_index, &parsed_files);\n104\t\n105\t    assert_eq!(verdict.status, VerificationStatus::Invalidated);\n106\t    assert_eq!(\n107\t        fixture.latest_proposal_kind(),\n108\t        ProposalKind::MarkInvalidated\n109\t    );\n110\t}\n111\t\n112\t#[test]\n113\tfn existing_doc_section_emits_verified_proposal() {\n114\t    let fixture = Fixture::new();\n115\t    let memory_id = fixture.seed_memory(\n116\t        \"memory-doc\",\n117\t        vec![MemoryEvidence {\n118\t            kind: \"doc_section\".to_string(),\n119\t            reference: Some(\"docs/spec.md#Verification Engine\".to_string()),\n120\t            detail: None,\n121\t            captured_at: Some(100),\n122\t            span: None,\n123\t            evidence_content_hash: None,\n124\t        }],\n125\t    );\n126\t    let graph = CodeGraph::new();\n127\t    let file_index = fixture.file_index(&[(\"docs/spec.md\", \"hash-doc\", 120)]);\n128\t    let parsed_files = fixture.doc_parsed_files(&[(\"docs/spec.md\", \"Verification Engine\", 0)]);\n129\t\n130\t    let verdict = fixture.verify(&memory_id, &graph, &file_index, &parsed_files);\n131\t\n132\t    assert_eq!(verdict.status, VerificationStatus::Verified);\n133\t    assert_eq!(fixture.latest_proposal_kind(), ProposalKind::MarkVerified);\n134\t}\n135\t\n136\t#[test]\n137\tfn deleted_test_emits_invalidated_proposal() {\n138\t    let fixture = Fixture::new();\n139\t    let file_id = fixture.file_id(\"tests/auth.test.ts\", \"hash-test\");\n140\t    let test_symbol_id = fixture.symbol_id(&file_id, \"loginUserTest\", 4, \"test\");\n141\t    let memory_id = fixture.seed_memory(\n142\t        \"memory-test\",\n143\t        vec![MemoryEvidence {\n144\t            kind: \"test\".to_string(),\n145\t            reference: Some(test_symbol_id.to_string()),\n146\t            detail: None,\n147\t            captured_at: Some(100),\n148\t            span: None,\n149\t     