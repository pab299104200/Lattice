{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pshz1jeayVzXn4Sgtbb1cp","type":"tool_result","content":"1\t//! Exact-span verification for durable memory evidence.\n2\t//!\n3\t//! This module implements the verifier contract from\n4\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## 8. Verification Engine` and\n6\t//! `## Non-Negotiable Product Properties`.\n7\t//!\n8\t//! Verification checks:\n9\t//!\n10\t//! - evidence text still matches when exact spans were captured\n11\t//!\n12\t//! Non-negotiable product property:\n13\t//!\n14\t//! - Every stale or contradicted memory is surfaced as such, not hidden behind recency.\n15\t\n16\tuse std::fs::File;\n17\tuse std::io::{BufRead, BufReader, Read, Seek, SeekFrom};\n18\tuse std::path::{Path, PathBuf};\n19\t\n20\tuse serde::{Deserialize, Serialize};\n21\tuse sha2::{Digest, Sha256};\n22\t\n23\tuse super::{VerificationStatus, VerificationVerdict};\n24\tuse crate::error::LatticeError;\n25\tuse crate::identity::FileId;\n26\tuse crate::memory::{EvidenceSpan, MemoryEvidence};\n27\t\n28\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n29\tpub enum SpanMismatch {\n30\t    ContentChanged,\n31\t    FileShrunkBelowSpan,\n32\t    EncodingChanged,\n33\t    FileMissing,\n34\t}\n35\t\n36\timpl SpanMismatch {\n37\t    pub fn as_str(self) -> &'static str {\n38\t        match self {\n39\t            Self::ContentChanged => \"ContentChanged\",\n40\t            Self::FileShrunkBelowSpan => \"FileShrunkBelowSpan\",\n41\t            Self::EncodingChanged => \"EncodingChanged\",\n42\t            Self::FileMissing => \"FileMissing\",\n43\t        }\n44\t    }\n45\t\n46\t    fn status(self) -> VerificationStatus {\n47\t        match self {\n48\t            Self::FileMissing => VerificationStatus::Invalidated,\n49\t            Self::ContentChanged | Self::FileShrunkBelowSpan | Self::EncodingChanged => {\n50\t                VerificationStatus::Stale\n51\t            }\n52\t        }\n53\t    }\n54\t}\n55\t\n56\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n57\tpub struct SpanMismatchReason {\n58\t    pub kind: String,\n59\t    pub subkind: String,\n60\t    pub evidence_id: String,\n61\t}\n62\t\n63\timpl SpanMismatchReason {\n64\t    pub fn new(evidence_id: impl Into<String>, subkind: SpanMismatch) -> Self {\n65\t        Self {\n66\t            kind: \"SpanMismatch\".to_string(),\n67\t            subkind: subkind.as_str().to_string(),\n68\t            evidence_id: evidence_id.into(),\n69\t        }\n70\t    }\n71\t\n72\t    pub fn to_json(&self) -> String {\n73\t        serde_json::to_string(self).unwrap_or_else(|_| {\n74\t            format!(\n75\t                r#\"{{\"kind\":\"SpanMismatch\",\"subkind\":\"{}\",\"evidence_id\":\"{}\"}}\"#,\n76\t                self.subkind, self.evidence_id\n77\t            )\n78\t        })\n79\t    }\n80\t}\n81\t\n82\t#[derive(Debug, thiserror::Error)]\n83\tpub enum SpanValidationError {\n84\t    #[error(\"invalid evidence span `{byte_start}..{byte_end}`\")]\n85\t    InvalidSpan { byte_start: u32, byte_end: u32 },\n86\t    #[error(\"failed to read `{path}`: {source}\")]\n87\t    ReadFailed {\n88\t        path: String,\n89\t        #[source]\n90\t        source: std::io::Error,\n91\t    },\n92\t    #[error(transparent)]\n93\t    Storage(#[from] LatticeError),\n94\t}\n95\t\n96\tpub trait SpanReader {\n97\t    fn file_len(&self, file_id: &FileId) -> Result<Option<u64>, SpanValidationError>;\n98\t    fn read_range(\n99\t        &self,\n100\t        file_id: &FileId,\n101\t        start: u32,\n102\t        end: u32,\n103\t    ) -> Result<Option<Vec<u8>>, SpanValidationError>;\n104\t    fn read_line_span(\n105\t        &self,\n106\t        file_id: &FileId,\n107\t        line_start: u32,\n108\t        line_end: u32,\n109\t    ) -> Result<Option<Vec<u8>>, SpanValidationError>;\n110\t}\n111\t\n112\tpub struct WorkspaceFileReader {\n113\t    workspace_root: PathBuf,\n114\t}\n115\t\n116\timpl WorkspaceFileReader {\n117\t    pub fn new(workspace_root: impl Into<PathBuf>) -> Self {\n118\t        Self {\n119\t            workspace_root: workspace_root.into(),\n120\t        }\n121\t    }\n122\t\n123\t    fn path_for(&self, file_id: &FileId) -> PathBuf {\n124\t        self.workspace_root.join(&file_id.repo_relative_path)\n125\t    }\n126\t}\n127\t\n128\timpl SpanReader for WorkspaceFileReader {\n129\t    fn file_len(&self, file_id: &FileId) -> Result<Option<u64>, SpanValidationError> {\n130\t        let path = self.path_for(file_id);\n131\t        match std::fs::metadata(&path) {\n132\t            Ok(metadata) => Ok(Some(metadata.len())),\n133\t            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),\n134\t            Err(error) => Err(read_failed(&path, error)),\n135\t        }\n136\t    }\n137\t\n138\t    fn read_range(\n139\t        &self,\n140\t        file_id: &FileId,\n141\t        start: u32,\n142\t        end: u32,\n143\t    ) -> Result<Option<Vec<u8>>, SpanValidationError> {\n144\t        let path = self.path_for(file_id);\n145\t        let mut file = match File::open(&path) {\n146\t            Ok(file) => file,\n147\t            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),\n148\t            Err(error) => return Err(read_failed(&path, error)),\n149\t        };\n150\t        let length = usize::try_from(end - start).expect(\"u32 range fits into usize\");\n151\t        file.seek(SeekFrom::Start(u64::from(start)))\n152\t            .map_err(|error| read_failed(&path, error))?;\n153\t        let mut bytes = vec![0; length];\n154\t        file.read_exact(&mut bytes)\n155\t            .map_err(|error| read_failed(&path, error))?;\n156\t        Ok(Some(bytes))\n157\t    }\n158\t\n159\t    fn read_line_span(\n160\t        &self,\n161\t        file_id: &FileId,\n162\t        line_start: u32,\n163\t        line_end: u32,\n164\t    ) -> Result<Option<Vec<u8>>, SpanValidationError> {\n165\t        let path = self.path_for(file_id);\n166\t        let file = match File::open(&path) {\n167\t            Ok(file) => file,\n168\t            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),\n169\t            Err(error) => return Err(read_failed(&path, error)),\n170\t        };\n171\t        let mut reader = BufReader::new(file);\n172\t        let mut current_line = 1_u32;\n173\t        let mut line = Vec::new();\n174\t        let mut collected = Vec::new();\n175\t        loop {\n176\t            line.clear();\n177\t            let read = reader\n178\t                .read_until(b'\\n', &mut line)\n179\t                .map_err(|error| read_failed(&path, error))?;\n180\t            if read == 0 {\n181\t                break;\n182\t            }\n183\t            if current_line >= line_start && current_line <= line_end {\n184\t                collected.extend_from_slice(&line);\n185\t            }\n186\t            if current_line >= line_end {\n187\t                break;\n188\t            }\n189\t            current_line += 1;\n190\t        }\n191\t        if collected.is_empty() && line_start > current_line {\n192\t            return Ok(None);\n193\t        }\n194\t        Ok(Some(collected))\n195\t    }\n196\t}\n197\t\n198\tpub struct SpanValidator;\n199\t\n200\timpl SpanValidator {\n201\t    pub fn validate(evidence: &MemoryEvidence, current_file_bytes: &[u8]) -> VerificationVerdict {\n202\t        let Some(span) = evidence.span.as_ref() else {\n203\t            return VerificationVerdict::new(\n204\t                VerificationStatus::Verified,\n205\t                \"span validation skipped because evidence has no exact span\",\n206\t            );\n207\t        };\n208\t        let start = usize::try_from(span.byte_start).expect(\"u32 span start fits into usize\");\n209\t        let end = usize::try_from(span.byte_end).expect(\"u32 span end fits into usize\");\n210\t        if start > end {\n211\t            return VerificationVerdict::new(\n212\t                VerificationStatus::Unverified,\n213\t                \"span validation skipped because evidence span is invalid\",\n214\t            );\n215\t        }\n216\t        let span_len = end - start;\n217\t        let candidate = if current_file_bytes.len() == span_len {\n218\t            current_file_bytes\n219\t        } else if end <= current_file_bytes.len() {\n220\t            &current_file_bytes[start..end]\n221\t        } else {\n222\t            return Self::mismatch_verdict(\"unknown\", SpanMismatch::FileShrunkBelowSpan);\n223\t        };\n224\t        let Some(expected_hash) = evidence.evidence_content_hash else {\n225\t            return VerificationVerdict::new(\n226\t                VerificationStatus::Unverified,\n227\t                \"span validation skipped because evidence has no captured content hash\",\n228\t            );\n229\t        };\n230\t        let actual = hash_bytes(candidate);\n231\t        if actual == expected_hash {\n232\t            return VerificationVerdict::new(\n233\t                VerificationStatus::Verified,\n234\t                \"captured span bytes still match the recorded hash\",\n235\t            );\n236\t        }\n237\t        if is_encoding_only_change(evidence, candidate) {\n238\t            return Self::mismatch_verdict(\"unknown\", SpanMismatch::EncodingChanged);\n239\t        }\n240\t        Self::mismatch_verdict(\"unknown\", SpanMismatch::ContentChanged)\n241\t    }\n242\t\n243\t    pub fn validate_with_reader(\n244\t        evidence_id: &str,\n245\t        evidence: &MemoryEvidence,\n246\t        reader: &dyn SpanReader,\n247\t    ) -> Result<VerificationVerdict, SpanValidationError> {\n248\t        let Some(span) = evidence.span.as_ref() else {\n249\t            return Ok(Self::validate(evidence, &[]));\n250\t        };\n251\t        validate_span_bounds(span)?;\n252\t        let Some(file_len) = reader.file_len(&span.file_id)? else {\n253\t            return Ok(Self::mismatch_verd