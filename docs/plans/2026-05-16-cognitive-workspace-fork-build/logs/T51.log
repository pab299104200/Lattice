+            .map_err(|e| LatticeError::Storage(format!("Failed to query impacted memories: {}", e)))?;
+        rows.collect::<Result<Vec<_>, _>>()
+            .map_err(|e| LatticeError::Storage(format!("Failed to decode impacted memory row: {}", e)))
+    }
+
