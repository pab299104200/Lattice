+                "UPDATE memories
+                 SET expires_at = ?1
+                 WHERE id = ?2 AND is_invalidated = 0",
+                params![expires_at.unix_seconds(), id],
+            )
+            .map_err(|e| LatticeError::Storage(format!("Failed to update expires_at: {}", e)))?;
+        if updated == 0 {
