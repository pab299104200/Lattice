+    fn find_impacted_memory_ids_impl(
+        &self,
+        workspace_id: &str,
+        changed_files: &[String],
+        changed_symbols: &[String],
+        distinct_memories: bool,
+    ) -> Result<Vec<String>, LatticeError> {
