+    pub fn get_last_verified_graph_snapshot_id(&self, id: &str) -> Result<Option<u64>, LatticeError> {
+        let value = self
+            .conn
+            .query_row(
+                "SELECT last_verified_graph_snapshot_id
+                 FROM memories
+                 WHERE id = ?1 AND is_invalidated = 0
+                 LIMIT 1",
+                params![id],
+                |row| row.get::<_, Option<i64>>(0),
+            )
+            .optional()
+            .map_err(|e| {
+                LatticeError::Storage(format!(
+                    "Failed to load last_verified_graph_snapshot_id: {}",
