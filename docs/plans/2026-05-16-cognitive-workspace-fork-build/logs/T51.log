        let count: i64 = self
            .conn
            .query_row(
                "SELECT COUNT(*)
                 FROM memory_accesses
                 WHERE memory_id = ?1
                   AND accessed_at >= ?2",
                params![memory_id, cutoff as i64],
                |row| row.get(0),
            )
            .map_err(|e| {
                LatticeError::Storage(format!("Failed to count memory accesses: {}", e))
            })?;
        Ok(count.max(0) as u64)
    }

