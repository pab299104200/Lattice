+            return Ok(Vec::new());
+        }
+
+        let select = if distinct_memories {
+            "SELECT DISTINCT e.memory_id"
+        } else {
+            "SELECT e.memory_id"
+        };
+        let conditions = reference_filters
+            .iter()
+            .map(|filter| {
+                if filter.is_like {
+                    "(e.kind = ? AND e.reference LIKE ? ESCAPE '\\')"
+                } else {
+                    "(e.kind = ? AND e.reference = ?)"
+                }
+            })
