+        if reference_filters.is_empty() {
+            return Ok(Vec::new());
+        }
+
+        let select = if distinct_memories {
+            "SELECT DISTINCT e.memory_id"
+        } else {
+            "SELECT e.memory_id"
+        };
+        let conditions = reference_filters
+            .iter()
+            .map(|filter| {
+                if filter.is_like {
+                    "(e.kind = ? AND e.reference LIKE ? ESCAPE '\\')"
+                } else {
+                    "(e.kind = ? AND e.reference = ?)"
+                }
+            })
+            .collect::<Vec<_>>()
+            .join(" OR ");
+        let sql = format!(
+            "{select}
+             FROM memory_evidence e
+             INNER JOIN memories m ON m.id = e.memory_id
+             WHERE m.is_invalidated = 0
+               AND m.workspace_id = ?
+               AND ({conditions})"
+        );
+
+        let mut bind_values = Vec::with_capacity(1 + reference_filters.len() * 2);
+        bind_values.push(Value::Text(workspace_id.to_string()));
+        for filter in reference_filters {
+            bind_values.push(Value::Text(filter.kind));
+            bind_values.push(Value::Text(filter.reference));
+        }
+
+        let mut statement = self
+            .conn
+            .prepare(&sql)
+            .map_err(|e| LatticeError::Storage(format!("Failed to prepare impacted-memory query: {}", e)))?;
+        let rows = statement
+            .query_map(params_from_iter(bind_values.iter()), |row| row.get::<_, String>(0))
+            .map_err(|e| LatticeError::Storage(format!("Failed to query impacted memories: {}", e)))?;
+        rows.collect::<Result<Vec<_>, _>>()
+            .map_err(|e| LatticeError::Storage(format!("Failed to decode impacted memory row: {}", e)))
+    }
