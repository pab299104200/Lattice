+            .conn
+            .prepare(&sql)
+            .map_err(|e| LatticeError::Storage(format!("Failed to prepare impacted-memory query: {}", e)))?;
+        let rows = statement
+            .query_map(params_from_iter(bind_values.iter()), |row| row.get::<_, String>(0))
+            .map_err(|e| LatticeError::Storage(format!("Failed to query impacted memories: {}", e)))?;
+        rows.collect::<Result<Vec<_>, _>>()
+            .map_err(|e| LatticeError::Storage(format!("Failed to decode impacted memory row: {}", e)))
+    }
