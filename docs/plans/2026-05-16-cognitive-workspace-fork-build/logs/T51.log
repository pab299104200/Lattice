+                    })
+                },
+            )
+            .optional()
+            .map_err(|e| {
+                LatticeError::Storage(format!(
+                    "Failed to load existing verification metadata: {}",
+                    e
+                ))
+            })?
+            .map_or(Ok(ExistingVerificationMetadata::default()), Ok)
+    }
