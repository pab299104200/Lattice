                        supersedes_memory_id, superseded_by_memory_id,
                        contradicts_memory_ids, contradicted_by_memory_ids,
                        freshness_policy, freshness_policy_detail,
                        provenance_json, evidence_json
                 FROM memories
                 WHERE id = ?1 AND is_invalidated = 0
                 LIMIT 1",
            )
            .map_err(|e| {
