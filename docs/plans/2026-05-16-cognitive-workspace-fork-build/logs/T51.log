+fn build_graph_delta_reference_filters(
+    changed_files: &[String],
+    changed_symbols: &[String],
+) -> Vec<GraphDeltaReferenceFilter> {
+    let mut filters = Vec::new();
+    let mut seen = HashSet::new();
+
+    for file in changed_files {
+        push_graph_delta_filter(&mut filters, &mut seen, "file", file);
+        push_graph_delta_filter(&mut filters, &mut seen, "symbol_file", file);
+    }
+
+    for symbol in changed_symbols {
+        push_graph_delta_filter(&mut filters, &mut seen, "symbol", symbol);
+    }
+
+    filters
+}
+
+fn push_graph_delta_filter(
+    filters: &mut Vec<GraphDeltaReferenceFilter>,
+    seen: &mut HashSet<(String, String)>,
+    kind: &str,
+    reference: &str,
+) {
+    let key = (kind.to_string(), reference.to_string());
+    if !seen.insert(key.clone()) {
+        return;
+    }
+    filters.push(GraphDeltaReferenceFilter {
+        kind: key.0,
+        reference: key.1,
+    });
+}
