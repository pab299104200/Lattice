{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UaDCuYjsuDH9m4zQ4TQHXG","type":"tool_result","content":"1390\t                },\n1391\t                {\n1392\t                    \"name\": \"delete_observation\",\n1393\t                    \"description\": \"Delete a stored observation by ID. The memory will no longer appear in listings or search results.\",\n1394\t                    \"inputSchema\": {\n1395\t                        \"type\": \"object\",\n1396\t                        \"properties\": {\n1397\t                            \"id\": {\n1398\t                                \"type\": \"string\",\n1399\t                                \"description\": \"The memory ID to delete (from list_observations or save_observation response)\"\n1400\t                            }\n1401\t                        },\n1402\t                        \"required\": [\"id\"]\n1403\t                    }\n1404\t                },\n1405\t                {\n1406\t                    \"name\": \"update_observation\",\n1407\t                    \"description\": \"Update the content of an existing observation in-place. Clears stale flags.\",\n1408\t                    \"inputSchema\": {\n1409\t                        \"type\": \"object\",\n1410\t                        \"properties\": {\n1411\t                            \"id\": {\n1412\t                                \"type\": \"string\",\n1413\t                                \"description\": \"The memory ID to update\"\n1414\t                            },\n1415\t                            \"content\": {\n1416\t                                \"type\": \"string\",\n1417\t                                \"description\": \"The new content for this observation\"\n1418\t                            }\n1419\t                        },\n1420\t                        \"required\": [\"id\", \"content\"]\n1421\t                    }\n1422\t                }\n1423\t            ]\n1424\t        });\n1425\t    