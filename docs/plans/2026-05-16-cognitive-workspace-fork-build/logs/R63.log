{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019TQMqN7KR53Ju1FAiobR5t","type":"tool_result","content":"1\t//! Memory V2 MCP surface for task-scoped retrieval, durable writes, and\n2\t//! auditable memory evolution.\n3\t//!\n4\t//! This module implements the task's `### 9. MCP Surface` and\n5\t//! `### 4. Memory Graph` contracts from\n6\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`.\n7\t//!\n8\t//! \"Tool surface discipline: ten new memory tools is a meaningful cognitive\n9\t//! load for clients. Before shipping Phase 8, audit whether\n10\t//! `propose_memory_evolution` + `apply_memory_evolution` can collapse into a\n11\t//! single tool with an `action` parameter, and whether `verify_memory` +\n12\t//! `explain_memory` can be unified. The goal is the smallest surface that\n13\t//! covers all assistant workflows. Consolidate before stabilizing the MCP\n14\t//! contract.\"\n15\t\n16\tuse lattice_core::identity::{encode_identity, Identity, MemoryId};\n17\tuse lattice_core::memory::{\n18\t    Memory, MemoryAccessRecord, MemoryClass, MemoryEvidence, MemoryLinkRecord, MemoryScoreRecord,\n19\t    MemoryStructuredFields, MemoryType, MemoryVerificationStatus,\n20\t};\n21\tuse lattice_core::memory::model::{\n22\t    MemoryAssertionType, MemoryFreshnessPolicy, MemoryProvenance,\n23\t};\n24\tuse serde::{Deserialize, Serialize};\n25\t\n26\tpub mod consolidate_session;\n27\tpub mod get_task_memory;\n28\tpub mod get_event_trace;\n29\tpub mod get_memory_metrics;\n30\tpub mod list_memory_conflicts;\n31\tpub mod propose_memory_evolution;\n32\tpub mod save_memory;\n33\tpub mod verify_explain_memory;\n34\t\n35\t#[cfg(test)]\n36\tmod admin_tools_tests;\n37\t#[cfg(test)]\n38\tmod memory_tools_tests;\n39\t#[cfg(test)]\n40\tmod verify_explain_tests;\n41\t\n42\t/// The compact memory bundle returned for a task-scoped retrieval.\n43\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n44\tpub struct TaskMemoryBundle {\n45\t    /// The task whose active and durable memory context was retrieved.\n46\t    pub task_id: String,\n47\t    /// The working-memory checkpoint used as the active context source, when present.\n48\t    pub checkpoint_id: Option<i64>,\n49\t    /// The current verification status of the task's working-memory state.\n50\t    pub working_memory_verification_status: String,\n51\t    /// The compact memory records returned for the task.\n52\t    pub memories: Vec<MemoryRecord>,\n53\t}\n54\t\n55\t/// The fully annotated memory record returned by Memory V2 tools.\n56\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n57\tpub struct MemoryRecord {\n58\t    /// Stable memory id.\n59\t    pub id: String,\n60\t    /// Encoded expansion handle for the memory identity.\n61\t    pub expansion_handle: String,\n62\t    /// Human-readable memory content.\n63\t    pub content: String,\n64\t    /// Spec-level memory class.\n65\t    pub memory_class: MemoryClass,\n66\t    /// Assertion type recorded for the claim.\n67\t    pub assertion_type: MemoryAssertionType,\n68\t    /// Durability scope for visibility.\n69\t    pub scope: String,\n70\t    /// Stored confidence score.\n71\t    pub confidence: f64,\n72\t    /// Optional explanation for the confidence score.\n73\t    pub confidence_reason: Option<String>,\n74\t    /// Current verification status.\n75\t    pub verification_status: String,\n76\t    /// Current freshness status for the memory surface.\n77\t    pub freshness_status: String,\n78\t    /// Contradiction state summary.\n79\t    pub contradiction_state: String,\n80\t    /// Supersession state summary.\n81\t    pub supersession_state: String,\n82\t    /// Why the memory was included in the response.\n83\t    pub inclusion_reason: String,\n84\t    /// Approximate evidence strength for the claim.\n85\t    pub evidence_strength: f64,\n86\t    /// Files linked to the memory.\n87\t    pub linked_files: Vec<String>,\n88\t    /// Symbols linked to the memory.\n89\t    pub linked_symbols: Vec<String>,\n90\t    /// Docs linked to the memory.\n91\t    pub linked_docs: Vec<String>,\n92\t    /// Tests linked to the memory.\n93\t    pub linked_tests: Vec<String>,\n94\t    /// Memory ids linked from the memory.\n95\t    pub linked_memories: Vec<String>,\n96\t    /// Validity conditions for the claim.\n97\t    pub validity_conditions: Vec<String>,\n98\t    /// Invalidation triggers for the claim.\n99\t    pub invalidation_triggers: Vec<String>,\n100\t    /// Structured provenance entries.\n101\t    pub provenance: Vec<MemoryProvenance>,\n102\t    /// Structured evidence entries.\n103\t    pub evidence: Vec<MemoryEvidence>,\n104\t    /// Memory-to-memory links.\n105\t    pub links: Vec<MemoryLinkRecord>,\n106\t    /// Access history rows for the memory.\n107\t    pub access_history: Vec<MemoryAccessRecord>,\n108\t    /// Usefulness scores for the memory.\n109\t    pub usefulness_scores: Vec<MemoryScoreRecord>,\n110\t    /// Optional source query captured with the memory.\n111\t    pub source_query: Option<String>,\n112\t    /// Optional branch for branch-scoped memory.\n113\t    pub branch: Option<String>,\n114\t    /// Optional refresh key.\n115\t    pub refresh_key: Option<String>,\n116\t    /// Optional last verification timestamp.\n117\t    pub last_verified_at: Option<u64>,\n118\t    /// Optional verification graph snapshot id.\n119\t    pub last_verified_graph_snapshot_id: Option<u64>,\n120\t}\n121\t\n122\t/// The action accepted by the unified memory evolution tool.\n123\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n124\t#[serde(rename_all = \"snake_case\")]\n125\tpub enum EvolutionAction {\n126\t    /// Persist a proposal without mutating durable memory.\n127\t    Propose,\n128\t    /// Apply a previously staged proposal.\n129\t    Apply,\n130\t    /// Reject a previously staged proposal.\n131\t    Reject,\n132\t}\n133\t\n134\t/// The auditable proposal returned by the unified memory evolution tool.\n135\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n136\tpub struct EvolutionProposal {\n137\t    /// Proposal id persisted in the consolidation proposal store.\n138\t    pub proposal_id: String,\n139\t    /// Action executed by the tool.\n140\t    pub action: EvolutionAction,\n141\t    /// Source memory targeted by the proposal, when any.\n142\t    pub source_memory_id: Option<String>,\n143\t    /// Consolidation proposal kind inferred for the delta.\n144\t    pub proposal_kind: String,\n145\t    /// Current proposal decision state.\n146\t    pub decision: String,\n147\t    /// Prior state snapshot for auditable evolution.\n148\t    pub prior_state: serde_json::Value,\n149\t    /// Proposed state snapshot or applied state snapshot.\n150\t    pub proposed_state: serde_json::Value,\n151\t    /// Optional deprecation warning attached by shimmed calls.\n152\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n153\t    pub deprecation_warning: Option<String>,\n154\t}\n155\t\n156\tpub(crate) fn coarse_memory_type(memory_class: &MemoryClass) -> MemoryType {\n157\t    match memory_class {\n158\t        MemoryClass::Decision => MemoryType::Decision,\n159\t        MemoryClass::Pattern\n160\t        | MemoryClass::WorkflowOutcome\n161\t        | MemoryClass::FailurePattern\n162\t        | MemoryClass::Procedure\n163\t        | MemoryClass::Preference\n164\t        | MemoryClass::ArchitectureInvariant\n165\t        | MemoryClass::DocsContract => MemoryType::Pattern,\n166\t        MemoryClass::AntiPattern | MemoryClass::CounterMemory => MemoryType::AntiPattern,\n167\t        MemoryClass::Observation | MemoryClass::Constraint => MemoryType::Observation,\n168\t        MemoryClass::OpenQuestion => MemoryType::Exploration,\n169\t    }\n170\t}\n171\t\n172\tpub(crate) fn default_assertion_type(memory_class: &MemoryClass) -> MemoryAssertionType {\n173\t    match memory_class {\n174\t        MemoryClass::Observation => MemoryAssertionType::Observation,\n175\t        MemoryClass::Decision => MemoryAssertionType::Decision,\n176\t        MemoryClass::Constraint => MemoryAssertionType::Constraint,\n177\t        MemoryClass::Pattern | MemoryClass::ArchitectureInvariant | MemoryClass::DocsContract => {\n178\t            MemoryAssertionType::Pattern\n179\t        }\n180\t        MemoryClass::AntiPattern => MemoryAssertionType::AntiPattern,\n181\t        MemoryClass::WorkflowOutcome | MemoryClass::FailurePattern => {\n182\t            MemoryAssertionType::WorkflowOutcome\n183\t        }\n184\t        MemoryClass::Procedure => MemoryAssertionType::Procedure,\n185\t        MemoryClass::Preference => MemoryAssertionType::Preference,\n186\t        MemoryClass::OpenQuestion => MemoryAssertionType::Question,\n187\t        MemoryClass::CounterMemory => MemoryAssertionType::Counter,\n188\t    }\n189\t}\n190\t\n191\tpub(crate) fn expansion_handle(memory: &Memory, workspace_id: &str) -> String {\n192\t    encode_identity(&Identity::Memory(MemoryId {\n193\t        workspace_id: memory\n194\t            .workspace_id\n195\t            .clone()\n196\t            .unwrap_or_else(|| workspace_id.to_string()),\n197\t        ulid: memory.id.clone(),\n198\t    }))\n199\t}\n200\t\n201\tpub(crate) fn freshness_status(\n202\t    memory: &Memory,\n203\t    fields: &MemoryStructuredFields,\n204\t    expires_at: Option<lattice_core::DateTime<lattice_core::Utc>>,\n205\t) -> String {\n206\t    if matches!(fields.verification_status, MemoryVerificationStatus::Expired) {\n207\t        return \"expired\".to_string();\n208\t    }\n209\t    let now = std::time::SystemTime::now()\n210\t        .duration_since(std::time::UNIX_EPOCH)\n211\t        .unwrap_or_default()\n212\t        .as_secs() as i64;\n213\t    if expires_at.is_some_and(|value| value.unix_seconds() <= now) {\n214\t        return \"expired\".to_string();\n215\t    }\n216\t    if memory.is_stale || matches!(fields.verification_status, MemoryVerificationStatus::Stale) {\n217\t        return \"stale\".to_string();\n218\t    }\n219\t    match fields.freshness_policy {\n220\t        MemoryFreshnessPolicy::ManualReview => \"manual_review\".to_string(),\n221\t        MemoryFreshnessPolicy::TimeBound => \"time_bound\".to_string(),\n222\t        MemoryFreshnessPolicy::BranchScoped => \"branch_scoped\".to_string(),\n223\t        MemoryFreshnessPolicy::RepoScoped => \"repo_scoped\".to_string(),\n224\t        MemoryFreshnessPolicy::SessionScoped => \"session_scoped\".to_string(),\n225\t    }\n226\t}\n227\t\n228\tpub(crate) fn contradiction_state(fields: &MemoryStructuredFields) -> String {\n229\t    if !fields.contradicted_by_memory_ids.is_empty() {\n230\t        \"contradicted_by_other_memory\".to_string()\n231\t    } else if !fields.contradicts_memory_ids.is_empty() {\n232\t        \"contradicts_other_memory\".to_string()\n233\t    } else {\n234\t        \"none\".to_string()\n235\t    }\n236\t}\n237\t\n238\tpub(crate) fn supersession_state(fields: &MemoryStructuredFields) -> String {\n239\t    if fields.superseded_by_memory_id.is_some() {\n240\t        \"superseded\".to_string()\n241\t    } else if fields.supersedes_memory_id.is_some() {\n242\t        \"supersedes_other_memory\".to_string()\n243\t    } else {\n244\t        \"none\".to_string()\n245\t    }\n246\t}\n247\t\n248\tpub(crate) fn evidence_strength(\n249\t    fields: &MemoryStructuredFields,\n250\t    scores: &[MemoryScoreRecord],\n251\t    access_count: u32,\n252\t) -> f64 {\n253\t    let evidence_weight = (fields.evidence.len() as f64 * 0.12).min(0.6);\n254\t    let provenance_weight = (fields.provenance.len() as f64 * 0.08).min(0.24);\n255\t    let score_weight = scores\n256\t        .iter()\n257\t        .map(|score| score.value.max(0.0) as f64)\n258\t        .fold(0.0_f64, f64::max)\n259\t        .min(1.0)\n260\t        * 0.12;\n261\t    let access_weight = (f64::from(access_count.min(8)) / 8.0) * 0.04;\n262\t    (0.1 + evidence_weight + provenance_weight + score_weight + access_weight).min(1.0)\n263\t}\n264\t"}]},"parent_tool_use_id":null,"session_id":"589d9a30-530c-4e7c-8151-20cc70f1285a","uuid":"54ebafbc-fec1-4765-a999-ba006e20084e","timestamp":"2026-05-17T14:41:43.880Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/memory_v2/mod.rs","content":"//! Memory V2 MCP surface for task-scoped retrieval, durable writes, and\n//! auditable memory evolution.\n//!\n//! This module implements the task's `### 9. MCP Surface` and\n//! `### 4. Memory Graph` contracts from\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`.\n//!\n//! \"Tool surface discipline: ten new memory tools is a meaningful cognitive\n//! load for clients. Before shipping Phase 8, audit whether\n//! `propose_memory_evolution` + `apply_memory_evolution` can collapse into a\n//! single tool with an `action` parameter, and whether `verify_memory` +\n//! `explain_memory` can be unified. The goal is the smallest surface that\n//! covers all assistant workflows. Consolidate before stabilizing the MCP\n//! contract.\"\n\nuse lattice_core::identity::{encode_identity, Identity, MemoryId};\nuse lattice_core::memory::{\n    Memory, MemoryAccessRecord, MemoryClass, MemoryEvidence, MemoryLinkRecord, MemoryScoreRecord,\n    MemoryStructuredFields, MemoryType, MemoryVerificationStatus,\n};\nuse lattice_core::memory::model::{\n    MemoryAssertionType, MemoryFreshnessPolicy, MemoryProvenance,\n};\nuse serde::{Deserialize, Serialize};\n\npub mod consolidate_session;\npub mod get_task_memory;\npub mod get_event_trace;\npub mod get_memory_metrics;\npub mod list_memory_conflicts;\npub mod propose_memory_evolution;\npub mod save_memory;\npub mod verify_explain_memory;\n\n#[cfg(test)]\nmod admin_tools_tests;\n#[cfg(test)]\nmod memory_tools_tests;\n#[cfg(test)]\nmod verify_explain_tests;\n\n/// The compact memory bundle returned for a task-scoped retrieval.\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct TaskMemoryBundle {\n    /// The task whose active and durable memory context was retrieved.\n    pub task_id: String,\n    /// The working-memory checkpoint used as the active context source, when present.\n    pub checkpoint_id: Option<i64>,\n    /// The current verification status of the task's working-memory state.\n    pub working_memory_verification_status: String,\n    /// The compact memory records returned for the task.\n    pub memories: Vec<MemoryRecord>,\n}\n\n/// The fully annotated memory record returned by Memory V2 tools.\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct MemoryRecord {\n    /// Stable memory id.\n    pub id: String,\n    /// Encoded expansion handle for the memory identity.\n    pub expansion_handle: String,\n    /// Human-readable memory content.\n    pub content: String,\n    /// Spec-level memory class.\n    pub memory_class: MemoryClass,\n    /// Assertion type recorded for the claim.\n    pub assertion_type: MemoryAssertionType,\n    /// Durability scope for visibility.\n    pub scope: String,\n    /// Stored confidence score.\n    pub confidence: f64,\n    /// Optional explanation for the confidence score.\n    pub confidence_reason: Option<String>,\n    /// Current verification status.\n    pub verification_status: String,\n    /// Current freshness status for the memory surface.\n    pub freshness_status: String,\n    /// Contradiction state summary.\n    pub contradiction_state: String,\n    /// Supersession state summary.\n    pub supersession_state: String,\n    /// Why the memory was included in the response.\n    pub inclusion_reason: String,\n    /// Approximate evidence strength for the claim.\n    pub evidence_strength: f64,\n    /// Files linked to the memory.\n    pub linked_files: Vec<String>,\n    /// Symbols linked to the memory.\n    pub linked_symbols: Vec<String>,\n    /// Docs linked to the memory.\n    pub linked_docs: Vec<String>,\n    /// Tests linked to the memory.\n    pub linked_tests: Vec<String>,\n    /// Memory ids linked from the memory.\n    pub linked_memories: Vec<String>,\n    /// Validity conditions for the claim.\n    pub validity_conditions: Vec<String>,\n    /// Invalidation triggers for the claim.\n    pub invalidation_triggers: Vec<String>,\n    /// Structured provenance entries.\n    pub provenance: Vec<MemoryProvenance>,\n    /// Structured evidence entries.\n    pub evidence: Vec<MemoryEvidence>,\n    /// Memory-to-memory links.\n    pub links: Vec<MemoryLinkRecord>,\n    /// Access history rows for the memory.\n    pub access_history: Vec<MemoryAccessRecord>,\n    /// Usefulness scores for the memory.\n    pub usefulness_scores: Vec<MemoryScoreRecord>,\n    /// Optional source query captured with the memory.\n    pub source_query: Option<String>,\n    /// Optional branch for branch-scoped memory.\n    pub branch: Option<String>,\n    /// Optional refresh key.\n    pub refresh_key: Option<String>,\n    /// Optional last verification timestamp.\n    pub last_verified_at: Option<u64>,\n    /// Optional verification graph snapshot id.\n    pub last_verified_graph_snapshot_id: Option<u64>,\n}\n\n/// The action accepted by the unified memory evolution tool.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum EvolutionAction {\n    /// Persist a proposal without mutating durable memory.\n    Propose,\n    /// Apply a previously staged proposal.\n    Apply,\n    /// Reject a previously staged proposal.\n    Reject,\n}\n\n/// The auditable proposal returned by the unified memory evolution tool.\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct EvolutionProposal {\n    /// Proposal id persisted in the consolidation proposal store.\n    pub proposal_id: String,\n    /// Action executed by the tool.\n    pub action: EvolutionAction,\n    /// Source memory targeted by the proposal, when any.\n    pub source_memory_id: Option<String>,\n    /// Consolidation proposal kind inferred for the delta.\n    pub proposal_kind: String,\n    /// Current proposal decision state.\n    pub decision: String,\n    /// Prior state snapshot for auditable evolution.\n    pub prior_state: serde_json::Value,\n    /// Proposed state snapshot or applied state snapshot.\n    pub proposed_state: serde_json::Value,\n    /// Optional deprecation warning attached by shimmed calls.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub deprecation_warning: Option<String>,\n}\n\npub(crate) fn coarse_memory_type(memory_class: &MemoryClass) -> MemoryType {\n    match memory_class {\n        MemoryClass::Decision => MemoryType::Decision,\n        MemoryClass::Pattern\n        | MemoryClass::WorkflowOutcome\n        | MemoryClass::FailurePattern\n        | MemoryClass::Procedure\n        | MemoryClass::Preference\n        | MemoryClass::ArchitectureInvariant\n        | MemoryClass::DocsContract => MemoryType::Pattern,\n        MemoryClass::AntiPattern | MemoryClass::CounterMemory => MemoryType::AntiPattern,\n        MemoryClass::Observation | MemoryClass::Constraint => MemoryType::Observation,\n        MemoryClass::OpenQuestion => MemoryType::Exploration,\n    }\n}\n\npub(crate) fn default_assertion_type(memory_class: &MemoryClass) -> MemoryAssertionType {\n    match memory_class {\n        MemoryClass::Observation => MemoryAssertionType::Observation,\n        MemoryClass::Decision => MemoryAssertionType::Decision,\n        MemoryClass::Constraint => MemoryAssertionType::Constraint,\n        MemoryClass::Pattern | MemoryClass::ArchitectureInvariant | MemoryClass::DocsContract => {\n            MemoryAssertionType::Pattern\n        }\n        MemoryClass::AntiPattern => MemoryAssertionType::AntiPattern,\n        MemoryClass::WorkflowOutcome | MemoryClass::FailurePattern => {\n            MemoryAssertionType::WorkflowOutcome\n        }\n        MemoryClass::Procedure => MemoryAssertionType::Procedure,\n        MemoryClass::Preference => MemoryAssertionType::Preference,\n        MemoryClass::OpenQuestion => MemoryAssertionType::Question,\n        MemoryClass::CounterMemory => MemoryAssertionType::Counter,\n    }\n}\n\npub(crate) fn expansion_handle(memory: &Memory, workspace_id: &str) -> String {\n    encode_identity(&Identity::Memory(MemoryId {\n        workspace_id: memory\n            .workspace_id\n            .clone()\n            .unwrap_or_else(|| workspace_id.to_string()),\n        ulid: memory.id.clone(),\n    }))\n}\n\npub(crate) fn freshness_status(\n    memory: &Memory,\n    fields: &MemoryStructuredFields,\n    expires_at: Option<lattice_core::DateTime<lattice_core::Utc>>,\n) -> String {\n    if matches!(fields.verification_status, MemoryVerificationStatus::Expired) {\n        return \"expired\".to_string();\n    }\n    let now = std::time::SystemTime::now()\n        .duration_since(std::time::UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_secs() as i64;\n    if expires_at.is_some_and(|value| value.unix_seconds() <= now) {\n        return \"expired\".to_string();\n    }\n    if memory.is_stale || matches!(fields.verification_status, MemoryVerificationStatus::Stale) {\n        return \"stale\".to_string();\n    }\n    match fields.freshness_policy {\n        MemoryFreshnessPolicy::ManualReview => \"manual_review\".to_string(),\n        MemoryFreshnessPolicy::TimeBound => \"time_bound\".to_string(),\n        MemoryFreshnessPolicy::BranchScoped => \"branch_scoped\".to_string(),\n        MemoryFreshnessPolicy::RepoScoped => \"repo_scoped\".to_string(),\n        MemoryFreshnessPolicy::SessionScoped => \"session_scoped\".to_string(),\n    }\n}\n\npub(crate) fn contradiction_state(fields: &MemoryStructuredFields) -> String {\n    if !fields.contradicted_by_memory_ids.is_empty() {\n        \"contradicted_by_other_memory\".to_string()\n    } else if !fields.contradicts_memory_ids.is_empty() {\n        \"contradicts_other_memory\".to_string()\n    } else {\n        \"none\".to_string()\n    }\n}\n\npub(crate) fn supersession_state(fields: &MemoryStructuredFields) -> String {\n    if fields.superseded_by_memory_id.is_some() {\n        \"superseded\".to_string()\n    } else if fields.supersedes_memory_id.is_some() {\n        \"supersedes_other_memory\".to_string()\n    } else {\n        \"none\".to_string()\n    }\n}\n\npub(crate) fn evidence_strength(\n    fields: &MemoryStructuredFields,\n    scores: &[MemoryScoreRecord],\n    access_count: u32,\n) -> f64 {\n    let evidence_weight = (fields.evidence.len() as f64 * 0.12).min(0.6);\n    let provenance_weight = (fields.provenance.len() as f64 * 0.08).min(0.24);\n    let score_weight = scores\n        .iter()\n        .map(|score| score.value.max(0.0) as f64)\n        .fold(0.0_f64, f64::max)\n        .min(1.0)\n        * 0.12;\n    let access_weight = (f64::from(access_count.min(8)) / 8.0) * 0.04;\n    (0.1 + evidence_weight + provenance_weight + score_weight + access_weight).min(1.0)\n}\n","numLines":264,"startLine":1,"totalLines":264}}}
