{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mvq9gcDGRTG4Cvs7TJT6QR","type":"tool_result","content":"1\tuse super::{\n2\t    emit_standard_events, empty_memory_rationale, event_episodes, file_identity,\n3\t    memory_highlights, render_choice, risks_from_memories, stable_handles, verification_commands,\n4\t    workflow_record, ContextItem, Pivot, RiskNote, StableIdentity, WorkflowBundle,\n5\t    WorkflowEventSink, WorkflowRequest,\n6\t};\n7\tuse lattice_core::intelligence::PlanEditBundle;\n8\tuse lattice_core::query::ContextCapsule;\n9\tuse serde_json::json;\n10\t\n11\t/// Compose the redesigned `plan_edit` bundle with ordered patch steps and\n12\t/// stable-identity edit anchors.\n13\tpub fn run(\n14\t    workspace_id: &str,\n15\t    request: &WorkflowRequest,\n16\t    plan: &PlanEditBundle,\n17\t    capsule: &ContextCapsule,\n18\t    sink: &mut dyn WorkflowEventSink,\n19\t) -> WorkflowBundle {\n20\t    emit_standard_events(sink, \"plan_edit\");\n21\t    let memories = memory_highlights(workspace_id, &capsule.memories, \"matched edit plan\");\n22\t    let files = plan.edit_files.iter().map(|item| item.file.clone()).collect::<Vec<_>>();\n23\t    let tests = plan.tests.iter().map(|item| item.file.clone()).collect::<Vec<_>>();\n24\t    let steps = ordered_steps(workspace_id, plan);\n25\t    let mut risks = risks_from_memories(&memories);\n26\t    risks.extend(plan.risks.iter().map(|risk| RiskNote {\n27\t        severity: risk.level.clone(),\n28\t        identity: Some(StableIdentity::File(file_identity(workspace_id, &risk.file))),\n29\t        message: risk.reason.clone(),\n30\t        mitigation: \"Review affected callers and update docs before verification.\".to_string(),\n31\t    }));\n32\t\n33\t    WorkflowBundle {\n34\t        overview: plan.overview.clone(),\n35\t        ranked_pivots: pivots_from_plan(workspace_id, plan),\n36\t        relevant_context: context_from_plan(workspace_id, plan),\n37\t        memory_empty_rationale: empty_memory_rationale(&memories),\n38\t        memory_highlights: memories,\n39\t        event_episodes: event_episodes(workspace_id, \"plan_edit\"),\n40\t        suggested_next_expansion: None,\n41\t        stable_handles: stable_handles(&files),\n42\t        risks,\n43\t        render_choice: render_choice(request),\n44\t        verification_commands: verification_commands(&files, &tests),\n45\t        workflow_record: workflow_record(\"plan_edit\", request, &files, &plan.rationale),\n46\t        structured_payload: json!({\n47\t            \"legacy\": plan,\n48\t            \"ordered_edit_steps\": steps,\n49\t        }),\n50\t    }\n51\t}\n52\t\n53\tfn ordered_steps(workspace_id: &str, plan: &PlanEditBundle) -> Vec<serde_json::Value> {\n54\t    plan.candidate_spans\n55\t        .iter()\n56\t        .enumerate()\n57\t        .map(|(index, span)| {\n58\t            json!({\n59\t                \"order\": index + 1,\n60\t                \"file_identity\": file_identity(workspace_id, &span.file),\n61\t                \"symbol_handle\": span.symbol_handle,\n62\t                \"file\": span.file,\n63\t                \"symbol\": span.symbol,\n64\t                \"line_span\": span.line_span,\n65\t                \"reason\": span.reason,\n66\t            })\n67\t        })\n68\t        .collect()\n69\t}\n70\t\n71\tfn pivots_from_plan(workspace_id: &str, plan: &PlanEditBundle) -> Vec<Pivot> {\n72\t    plan.candidate_spans\n73\t        .iter()\n74\t        .map(|span| Pivot {\n75\t            identity: StableIdentity::File(file_identity(workspace_id, &span.file)),\n76\t            kind: \"edit_span\".to_string(),\n77\t            label: span.symbol.clone(),\n78\t            file: Some(span.file.clone()),\n79\t            symbol: Some(span.symbol.clone()),\n80\t            line: Some(span.start_line),\n81\t            score: 1.0,\n82\t            inclusion_reason: span.reason.clone(),\n83\t        })\n84\t        .collect()\n85\t}\n86\t\n87\tfn context_from_plan(workspace_