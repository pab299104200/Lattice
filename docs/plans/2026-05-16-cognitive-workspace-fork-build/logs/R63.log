{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GyUxi2w7HFL2TmHjUSB9Yv","type":"tool_result","content":"1\t//! Workflow Engine V2 edit-planning contract.\n2\t//!\n3\t//! Bound to `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## Phase 8: Workflow Engine V2` and `## MCP Tool Contract Principles`.\n5\t//! The shared bundle below intentionally mirrors the spec field list:\n6\t//! overview, ranked pivots, relevant context, memory highlights, event\n7\t//! episodes where relevant, suggested next expansion, stable handles, risks or\n8\t//! uncertainty, compact/full render choice, and structured payload.\n9\t\n10\tuse lattice_core::events::EventKind;\n11\tuse lattice_core::identity::{ContextHandleId, EventId, FileId, MemoryId, SymbolId};\n12\tuse lattice_core::intelligence::TaskBundle;\n13\tuse lattice_core::memory::MemoryVerificationStatus;\n14\tuse lattice_core::query::ContextCapsule;\n15\tuse serde::{Deserialize, Serialize};\n16\tuse serde_json::{json, Value};\n17\t\n18\tpub mod context_capsule;\n19\tpub mod diagnose_failure;\n20\tpub mod docs_capsule;\n21\t#[cfg(test)]\n22\tmod composition_tests;\n23\t#[cfg(test)]\n24\tmod discovery_workflows_tests;\n25\t#[cfg(test)]\n26\tmod edit_workflows_tests;\n27\tpub mod impact_from_diff;\n28\tpub mod outcome_capture;\n29\tpub mod plan_edit;\n30\tpub mod prepare_change;\n31\tpub mod relevant_tests;\n32\tpub mod trace_scenario;\n33\t\n34\t/// Render choices shared by workflow v2 discovery and edit tools.\n35\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n36\tpub enum WorkflowRenderChoice {\n37\t    /// Focused response with the smallest useful working set.\n38\t    Focused,\n39\t    /// Compact response for default assistant use.\n40\t    Compact,\n41\t    /// Full response with broader candidates.\n42\t    Full,\n43\t    /// Diagnostic response with extra explanations.\n44\t    Diagnostic,\n45\t}\n46\t\n47\timpl WorkflowRenderChoice {\n48\t    /// Parse a user-supplied mode string.\n49\t    pub fn from_mode_str(value: Option<&str>) -> Self {\n50\t        match value {\n51\t            Some(\"focused\") | Some(\"tiny\") => Self::Focused,\n52\t            Some(\"full\") => Self::Full,\n53\t            Some(\"diagnostic\") => Self::Diagnostic,\n54\t            _ => Self::Compact,\n55\t        }\n56\t    }\n57\t}\n58\t\n59\t/// Build an expansion seed from a workflow-v2 JSON-compatible bundle.\n60\tpub fn build_expand_seed<T: Serialize>(bundle: &T) -> lattice_core::intelligence::ExpandContextSeed {\n61\t    let value = serde_json::to_value(bundle).unwrap_or_else(|_| json!({}));\n62\t    lattice_core::intelligence::ExpandContextSeed {\n63\t        query: value\n64\t            .get(\"query\")\n65\t            .or_else(|| value.get(\"scenario\"))\n66\t            .or_else(|| value.get(\"overview\"))\n67\t            .and_then(Value::as_str)\n68\t            .map(ToString::to_string),\n69\t        files: collect_string_values(&value, &[\"file\", \"repo_relative_path\"]),\n70\t        symbols: collect_string_values(&value, &[\"symbol\", \"qualified_name\"]),\n71\t        tests: collect_test_files(&value),\n72\t        memories: value\n73\t            .get(\"memory_highlights\")\n74\t            .and_then(Value::as_array)\n75\t            .cloned()\n76\t            .unwrap_or_default(),\n77\t    }\n78\t}\n79\t\n80\tfn collect_string_values(value: &Value, keys: &[&str]) -> Vec<String> {\n81\t    let mut values = Vec::new();\n82\t    collect_string_values_inner(value, keys, &mut values);\n83\t    values.sort();\n84\t    values.dedup();\n85\t    values\n86\t}\n87\t\n88\tfn collect_string_values_inner(value: &Value, keys: &[&str], values: &mut Vec<String>) {\n89\t    match value {\n90\t        Value::Object(object) => {\n91\t            for key in keys {\n92\t                if let Some(item) = object.get(*key).and_then(Value::as_str) {\n93\t                    values.push(item.to_string());\n94\t                }\n95\t            }\n96\t            for child in object.values() {\n97\t                collect_string_values_inner(child, keys, values);\n98\t            }\n99\t        }\n100\t        Value::Array(items) => {\n101\t            for item in items {\n102\t                collect_string_values_inner(item, keys, values);\n103\t            }\n104\t        }\n105\t        _ => {}\n106\t    }\n107\t}\n108\t\n109\tfn collect_test_files(value: &Value) -> Vec<String> {\n110\t    value\n111\t        .get(\"tests\")\n112\t        .and_then(Value::as_array)\n113\t        .map(|items| {\n114\t            items\n115\t                .iter()\n116\t                .filter_map(|item| item.get(\"file\").and_then(Value::as_str))\n117\t                .map(ToString::to_string)\n118\t                .collect()\n119\t        })\n120\t        .unwrap_or_default()\n121\t}\n122\t\n123\t/// Assistant-facing response shared by Phase 8 workflow tools.\n124\t#[derive(Debug, Clone, Serialize, Deserialize)]\n125\tpub struct WorkflowBundle {\n126\t    /// Human-readable summary of what the workflow selected and why.\n127\t    pub overview: String,\n128\t    /// Ranked code, doc, memory, or failure pivots with stable identities.\n129\t    pub ranked_pivots: Vec<Pivot>,\n130\t    /// Bounded supporting context that should be read before broad discovery.\n131\t    pub relevant_context: Vec<ContextItem>,\n132\t    /// Memory evidence with inclusion reason and verification lifecycle labels.\n133\t    pub memory_highlights: Vec<MemoryHighlight>,\n134\t    /// Explicit reason when no memories were available or relevant.\n135\t    pub memory_empty_rationale: Option<String>,\n136\t    /// Prior event-log episodes that are relevant to this workflow result.\n137\t    pub event_episodes: Vec<EventEpisode>,\n138\t    /// Recommended next expansion target.\n139\t    pub suggested_next_expansion: Option<ExpansionHint>,\n140\t    /// Stable handles copied out for clients that prefer a flat handle list.\n141\t    pub stable_handles: Vec<String>,\n142\t    /// Risks, stale evidence labels, contradictions, and uncertainty notes.\n143\t    pub risks: Vec<RiskNote>,\n144\t    /// Render shape selected for this response.\n145\t    pub render_choice: RenderChoice,\n146\t    /// Commands inferred from affected build targets and recommended tests.\n147\t    pub verification_commands: Vec<String>,\n148\t    /// Stable record of inputs, anchors, selected candidates, and exclusions.\n149\t    pub workflow_record: WorkflowRecord,\n150\t    /// Tool-specific payload retained for backward-compatible clients.\n151\t    pub structured_payload: Value,\n152\t}\n153\t\n154\t/// A ranked workflow pivot.\n155\t#[derive(Debug, Clone, Serialize, Deserialize)]\n156\tpub struct Pivot {\n157\t    /// Stable identity for the pivot.\n158\t    pub identity: StableIdentity,\n159\t    /// File, symbol, doc, memory, or event.\n160\t    pub kind: String,\n161\t    /// Display label for compact rendering.\n162\t    pub label: String,\n163\t    /// Repo-relative path when applicable.\n164\t    pub file: Option<String>,\n165\t    /// Symbol or heading name when applicable.\n166\t    pub symbol: Option<String>,\n167\t    /// One-based source line when applicable.\n168\t    pub line: Option<usize>,\n169\t    /// Ranked confidence score.\n170\t    pub score: f64,\n171\t    /// Reason this pivot was selected.\n172\t    pub inclusion_reason: String,\n173\t}\n174\t\n175\t/// Supporting context item.\n176\t#[derive(Debug, Clone, Serialize, Deserialize)]\n177\tpub struct ContextItem {\n178\t    /// Stable identity for the context item.\n179\t    pub identity: StableIdentity,\n180\t    /// Context kind such as file, symbol, doc, test, or memory.\n181\t    pub kind: String,\n182\t    /// Compact display label.\n183\t    pub label: String,\n184\t    /// Repo-relative file when applicable.\n185\t    pub file: Option<String>,\n186\t    /// Summary of the context item.\n187\t    pub summary: String,\n188\t    /// Reason the item was included.\n189\t    pub inclusion_reason: String,\n190\t}\n191\t\n192\t/// Memory evidence surfaced by a workflow.\n193\t#[derive(Debug, Clone, Serialize, Deserialize)]\n194\tpub struct MemoryHighlight {\n195\t    /// Stable memory identity.\n196\t    pub memory_id: MemoryId,\n197\t    /// Compact memory content.\n198\t    pub content: String,\n199\t    /// Memory type.\n200\t    pub memory_type: String,\n201\t    /// Session, branch, repo, or organization scope.\n202\t    pub scope: String,\n203\t    /// Reason retrieval included this memory.\n204\t    pub inclusion_reason: String,\n205\t    /// Evidence strength label.\n206\t    pub evidence_strength: String,\n207\t    /// Verification lifecycle state.\n208\t    pub verification_status: String,\n209\t    /// Freshness state derived from stale and verification fields.\n210\t    pub freshness_status: String,\n211\t    /// Contradiction or supersession state.\n212\t    pub contradiction_state: String,\n213\t    /// Expansion target for this memory.\n214\t    pub expansion_target: String,\n215\t    /// Required warning label for stale or otherwise unsafe statuses.\n216\t    pub stale_label: Option<String>,\n217\t}\n218\t\n219\t/// Prior event-log episode relevant to the workflow.\n220\t#[derive(Debug, Clone, Serialize, Deserialize)]\n221\tpub struct EventEpisode {\n222\t    /// Stable event identity.\n223\t    pub event_id: EventId,\n224\t    /// Event kind such as workflow_failed or tool_called.\n225\t    pub event_kind: String,\n226\t    /// Compact event summary.\n227\t    pub summary: String,\n228\t    /// Reason this episode was included.\n229\t    pub inclusion_reason: String,\n230\t}\n231\t\n232\t/// Risk or uncertainty surfaced by the workflow.\n233\t#[derive(Debug, Clone, Serialize, Deserialize)]\n234\tpub struct RiskNote {\n235\t    /// Risk severity: info, warning, or error.\n236\t    pub severity: String,\n237\t    /// Stable identity this risk is about when applicable.\n238\t    pub identity: Option<StableIdentity>,\n239\t    /// Risk summary.\n240\t    pub message: String,\n241\t    /// Recommended mitigation.\n242\t    pub mitigation: String,\n243\t}\n244\t\n245\t/// Suggested expansion target.\n246\t#[derive(Debug, Clone, Serialize, Deserialize)]\n247\tpub struct ExpansionHint {\n248\t    /// Stable focus string accepted by expand_context.\n249\t    pub focus: String,\n250\t    /// Reason this expansion is the next best step.\n251\t    pub reason: String,\n252\t}\n253\t\n254\t/// Stable identity wrapper for workflow payloads.\n255\t#[derive(Debug, Clone, Serialize, Deserialize)]\n256\t#[serde(tag = \"kind\", content = \"value\")]\n257\tpub enum StableIdentity {\n258\t    /// Stable file identity.\n259\t    File(FileId),\n260\t    /// Stable symbol identity.\n261\t    Symbol(SymbolId),\n262\t    /// Stable memory identity.\n263\t    Memory(MemoryId),\n264\t    /// Stable event identity.\n265\t    Event(EventId),\n266\t    /// Stable context handle identity.\n267\t    ContextHandle(ContextHandleId),\n268\t    /// Legacy expansion handle retained for backward compatibility.\n269\t    LegacyHandle(String),\n270\t}\n271\t\n272\t/// Render mode selected by the workflow.\n273\t#[derive(Debug, Clone, Serialize, Deserialize)]\n274\tpub struct RenderChoice {\n275\t    /// compact or full.\n276\t    pub mode: String,\n277\t    /// Why this render mode was selected.\n278\t    pub reason: String,\n279\t}\n280\t\n281\t/// Recorded workflow composition metadata.\n282\t#[derive(Debug, Clone, Serialize, Deserialize)]\n283\tpub struct WorkflowRecord {\n284\t    /// Tool name.\n285\t    pub tool: String,\n286\t    /// Raw query or failure input.\n287\t    pub input: String,\n288\t    /// Resolved anchors used by retrieval and ranking.\n289\t    pub resolved_anchors: Vec<StableIdentity>,\n290\t    /// Selected candidate handles.\n291\t    pub selected_candidates: Vec<String>,\n292\t    /// Excluded high-scoring candidates and reasons.\n293\t    pub excluded_high_scoring_candidates: Vec<String>,\n294\t    /// Working-memory operation summary.\n295\t    pub working_memory_summary: String,\n296\t}\n297\t\n298\t/// Inputs common to edit-planning workflows.\n299\t#[derive(Debug, Clone, Serialize, Deserialize)]\n300\tpub struct WorkflowRequest {\n301\t    /// Query, scenario, or failure text.\n302\t    pub input: String,\n303\t    /// Optional starting files.\n304\t    pub entry_files: Vec<String>,\n305\t    /// Optional starting symbols.\n306\t    pub entry_symbols: Vec<String>,\n307\t    /// compact or full.\n308\t    pub render_mode: String,\n309\t}\n310\t\n311\t/// Event capture abstraction used by tests and MCP integration.\n312\tpub trait WorkflowEventSink {\n313\t    /// Record one workflow event.\n314\t    fn record_event(&mut self, kind: EventKind, summary: &str);\n315\t}\n316\t\n317\t/// In-memory event sink for unit tests.\n318\t#[derive(Debug, Default)]\n319\tpub struct VecEventSink {\n320\t    /// Recorded event kinds in order.\n321\t    pub events: Vec<EventKind>,\n322\t}\n323\t\n324\timpl WorkflowEventSink for VecEventSink {\n325\t    fn record_event(&mut self, kind: EventKind, _summary: &str) {\n326\t        self.events.push(kind);\n327\t    }\n328\t}\n329\t\n330\tpub(crate) fn emit_standard_events(sink: &mut dyn WorkflowEventSink, tool: &str) {\n331\t    sink.record_event(EventKind::AssistantTaskStarted, \"workflow v2 task started\");\n332\t    sink.record_event(EventKind::ToolCalled, tool);\n333\t    sink.record_event(EventKind::ContextBundleReturned, \"workflow v2 bundle returned\");\n334\t    sink.record_event(EventKind::MemoryRetrieved, \"workflow v2 memories retrieved\");\n335\t    sink.record_event(EventKind::PlanCreated, \"workflow v2 plan created\");\n336\t}\n337\t\n338\tpub(crate) fn file_identity(workspace_id: &str, file: &str) -> FileId {\n339\t    FileId {\n340\t        workspace_id: workspace_id.to_string(),\n341\t        repo_relative_path: file.to_string(),\n342\t        content_hash: \"unknown\".to_string(),\n343\t    }\n344\t}\n345\t\n346\tpub(crate) fn memory_identity(workspace_id: &str, id: &str) -> MemoryId {\n347\t    MemoryId {\n348\t        workspace_id: workspace_id.to_string(),\n349\t        ulid: id.to_string(),\n350\t    }\n351\t}\n352\t\n353\tpub(crate) fn event_identity(workspace_id: &str, id: &str) -> EventId {\n354\t    EventId {\n355\t        workspace_id: workspace_id.to_string(),\n356\t        ulid: id.to_string(),\n357\t    }\n358\t}\n359\t\n360\tpub(crate) fn memory_highlights(\n361\t    workspace_id: &str,\n362\t    memories: &[Value],\n363\t    fallback_reason: &str,\n364\t) -> Vec<MemoryHighlight> {\n365\t    memories\n366\t        .iter()\n367\t        .enumerate()\n368\t        .filter_map(|(index, value)| memory_highlight(workspace_id, value, index, fallback_reason))\n369\t        .collect()\n370\t}\n371\t\n372\tfn memory_highlight(\n373\t    workspace_id: &str,\n374\t    value: &Value,\n375\t    index: usize,\n376\t    fallback_reason: &str,\n377\t) -> Option<MemoryHighlight> {\n378\t    let object = value.as_object()?;\n379\t    let content = string_field(object, &[\"content\", \"summary\"])?;\n380\t    let status = string_field(object, &[\"verification_status\"])\n381\t        .unwrap_or_else(|| \"unverified\".to_string());\n382\t    let is_stale = object\n383\t        .get(\"is_stale\")\n384\t        .and_then(Value::as_bool)\n385\t        .unwrap_or(false);\n386\t    let memory_id = string_field(object, &[\"id\", \"memory_id\"])\n387\t        .unwrap_or_else(|| format!(\"memory-{index}\"));\n388\t    let status_kind = MemoryVerificationStatus::from_str(&status);\n389\t    let stale_label = stale_label(status_kind, is_stale);\n390\t    Some(MemoryHighlight {\n391\t        memory_id: memory_identity(workspace_id, &memory_id),\n392\t        content,\n393\t        memory_type: string_field(object, &[\"memory_type\", \"type\"])\n394\t            .unwrap_or_else(|| \"observation\".to_string()),\n395\t        scope: string_field(object, &[\"scope\"]).unwrap_or_else(|| \"session\".to_string()),\n396\t        inclusion_reason: string_field(object, &[\"inclusion_reason\"])\n397\t            .unwrap_or_else(|| fallback_reason.to_string()),\n398\t        evidence_strength: evidence_strength(object),\n399\t        verification_status: status,\n400\t        freshness_status: freshness_status(status_kind, is_stale).to_string(),\n401\t        contradiction_state: contradiction_state(object, status_kind),\n402\t        expansion_target: format!(\"memory:{memory_id}\"),\n403\t        stale_label,\n404\t    })\n405\t}\n406\t\n407\tfn string_field(\n408\t    object: &serde_json::Map<String, Value>,\n409\t    keys: &[&str],\n410\t) -> Option<String> {\n411\t    keys.iter()\n412\t        .filter_map(|key| object.get(*key).and_then(Value::as_str))\n413\t        .map(str::trim)\n414\t        .filter(|value| !value.is_empty())\n415\t        .map(ToString::to_string)\n416\t        .next()\n417\t}\n418\t\n419\tfn evidence_strength(object: &serde_json::Map<String, Value>) -> String {\n420\t    object\n421\t        .get(\"confidence\")\n422\t        .and_then(Value::as_f64)\n423\t        .map(|score| {\n424\t            if score >= 0.8 {\n425\t                \"strong\"\n426\t            } else if score >= 0.45 {\n427\t                \"moderate\"\n428\t            } else {\n429\t                \"weak\"\n430\t            }\n431\t        })\n432\t        .unwrap_or(\"unverified\")\n433\t        .to_string()\n434\t}\n435\t\n436\tfn stale_label(status: MemoryVerificationStatus, is_stale: bool) -> Option<String> {\n437\t    let unsafe_status = matches!(\n438\t        status,\n439\t        MemoryVerificationStatus::Stale\n440\t            | MemoryVerificationStatus::Contradicted\n441\t            | MemoryVerificationStatus::Superseded\n442\t            | MemoryVerificationStatus::Expired\n443\t            | MemoryVerificationStatus::Invalidated\n444\t    );\n445\t    if unsafe_status || is_stale {\n446\t        Some(format!(\"STALE_OR_UNTRUSTED: {}\", status.as_str()))\n447\t    } else {\n448\t        None\n449\t    }\n450\t}\n451\t\n452\tfn freshness_status(status: MemoryVerificationStatus, is_stale: bool) -> &'static str {\n453\t    if is_stale || matches!(status, MemoryVerificationStatus::Stale) {\n454\t        \"stale\"\n455\t    } else if matches!(status, MemoryVerificationStatus::Expired) {\n456\t        \"expired\"\n457\t    } else {\n458\t        \"fresh\"\n459\t    }\n460\t}\n461\t\n462\tfn contradiction_state(\n463\t    object: &serde_json::Map<String, Value>,\n464\t    status: MemoryVerificationStatus,\n465\t) -> String {\n466\t    if matches!(status, MemoryVerificationStatus::Contradicted) {\n467\t        return \"contradicted\".to_string();\n468\t    }\n469\t    if matches!(status, MemoryVerificationStatus::Superseded) {\n470\t        return \"superseded\".to_string();\n471\t    }\n472\t    if object\n473\t        .get(\"contradicted_by_memory_ids\")\n474\t        .and_then(Value::as_array)\n475\t        .is_some_and(|items| !items.is_empty())\n476\t    {\n477\t        return \"has_contradictions\".to_string();\n478\t    }\n479\t    \"none\".to_string()\n480\t}\n481\t\n482\tpub(crate) fn risks_from_memories(memories: &[MemoryHighlight]) -> Vec<RiskNote> {\n483\t    memories\n484\t        .iter()\n485\t        .filter_map(|memory| {\n486\t            memory.stale_label.as_ref().map(|label| RiskNote {\n487\t                severity: \"warning\".to_string(),\n488\t                identity: Some(StableIdentity::Memory(memory.memory_id.clone())),\n489\t                message: format!(\"Memory is not trusted guidance: {label}\"),\n490\t                mitigation: \"Use it only as historical evidence and verify against current code.\"\n491\t                    .to_string(),\n492\t            })\n493\t        })\n494\t        .collect()\n495\t}\n496\t\n497\tpub(crate) fn verification_commands(files: &[String], tests: &[String]) -> Vec<String> {\n498\t    let mut commands = Vec::new();\n499\t    if files.iter().any(|file| file.ends_with(\".rs\")) || tests.iter().any(|file| file.ends_with(\".rs\")) {\n500\t        commands.push(\"cd daemon && cargo test --workspace\".to_string());\n501\t    }\n502\t    if files.iter().any(|file| file.starts_with(\"daemon/crates/lattice-daemon\"))\n503\t        || tests.iter().any(|file| file.contains(\"lattice-daemon\"))\n504\t    {\n505\t        commands.push(\"cd daemon && cargo test -p lattice-daemon --lib\".to_string());\n506\t    }\n507\t    if files.iter().any(|file| file.ends_with(\".ts\") || file.ends_with(\".tsx\")) {\n508\t        commands.push(\"cd extension && npm run compile\".to_string());\n509\t    }\n510\t    commands.extend(tests.iter().map(|file| {\n511\t        if file.ends_with(\".rs\") {\n512\t            format!(\"cd daemon && cargo test {}\", file.replace('/', \"::\"))\n513\t        } else {\n514\t            format!(\"Run targeted test file {file}\")\n515\t        }\n516\t    }));\n517\t    if commands.is_empty() {\n518\t        commands.push(\"cd daemon && cargo test --workspace\".to_string());\n519\t    }\n520\t    commands.sort();\n521\t    commands.dedup();\n522\t    commands\n523\t}\n524\t\n525\tpub(crate) fn bundle_from_task(\n526\t    workspace_id: &str,\n527\t    request: &WorkflowRequest,\n528\t    task: &TaskBundle,\n529\t    capsule: &ContextCapsule,\n530\t) -> WorkflowBundle {\n531\t    let memories = memory_highlights(workspace_id, &capsule.memories, \"matched workflow query\");\n532\t    let mut risks = risks_from_memories(&memories);\n533\t    risks.extend(task.risks.iter().map(|risk| RiskNote {\n534\t        severity: risk.level.clone(),\n535\t        identity: Some(StableIdentity::File(file_identity(workspace_id, &risk.file))),\n536\t        message: risk.reason.clone(),\n537\t        mitigation: \"Inspect dependents and run the recommended tests before editing.\".to_string(),\n538\t    }));\n539\t    let files = task.primary_files.iter().map(|item| item.file.clone()).collect::<Vec<_>>();\n540\t    let tests = task.tests.iter().map(|item| item.file.clone()).collect::<Vec<_>>();\n541\t    WorkflowBundle {\n542\t        overview: task.overview.clone(),\n543\t        ranked_pivots: task\n544\t            .symbols\n545\t            .iter()\n546\t            .map(|symbol| Pivot {\n547\t                identity: StableIdentity::LegacyHandle(\n548\t                    symbol.symbol_handle.clone().unwrap_or_else(|| format!(\"symbol:{}\", symbol.symbol)),\n549\t                ),\n550\t                kind: \"symbol\".to_string(),\n551\t                label: symbol.symbol.clone(),\n552\t                file: Some(symbol.file.clone()),\n553\t                symbol: Some(symbol.symbol.clone()),\n554\t                line: Some(symbol.line),\n555\t                score: symbol.score,\n556\t                inclusion_reason: symbol.evidence.join(\"; \"),\n557\t            })\n558\t            .collect(),\n559\t        relevant_context: task\n560\t            .primary_files\n561\t            .iter()\n562\t            .chain(task.secondary_files.iter())\n563\t            .map(|file| ContextItem {\n564\t                identity: StableIdentity::File(file_identity(workspace_id, &file.file)),\n565\t                kind: \"file\".to_string(),\n566\t                label: file.file.clone(),\n567\t                file: Some(file.file.clone()),\n568\t                summary: file.reasons.join(\"; \"),\n569\t                inclusion_reason: file.reasons.join(\"; \"),\n570\t            })\n571\t            .collect(),\n572\t        memory_empty_rationale: empty_memory_rationale(&memories),\n573\t        memory_highlights: memories,\n574\t        event_episodes: event_episodes(workspace_id, \"prepare_change\"),\n575\t        suggested_next_expansion: expansion_from_value(&serde_json::to_value(&task.suggested_expand).ok()),\n576\t        stable_handles: stable_handles(&files),\n577\t        risks,\n578\t        render_choice: render_choice(request),\n579\t        verification_commands: verification_commands(&files, &tests),\n580\t        workflow_record: workflow_record(\"prepare_change\", request, &files, &task.rationale),\n581\t        structured_payload: serde_json::to_value(task).unwrap_or_else(|_| json!({})),\n582\t    }\n583\t}\n584\t\n585\tfn expansion_from_value(value: &Option<Value>) -> Option<ExpansionHint> {\n586\t    let object = value.as_ref()?.as_object()?;\n587\t    Some(ExpansionHint {\n588\t        focus: object.get(\"focus\")?.as_str()?.to_string(),\n589\t        reason: object.get(\"reason\")?.as_str()?.to_string(),\n590\t    })\n591\t}\n592\t\n593\tpub(crate) fn render_choice(request: &WorkflowRequest) -> RenderChoice {\n594\t    RenderChoice {\n595\t        mode: request.render_mode.clone(),\n596\t        reason: \"MCP request selected the workflow render mode\".to_string(),\n597\t    }\n598\t}\n599\t\n600\tpub(crate) fn empty_memory_rationale(memories: &[MemoryHighlight]) -> Option<String> {\n601\t    if memories.is_empty() {\n602\t        Some(\"No relevant memory matched the resolved anchors.\".to_string())\n603\t    } else {\n604\t        None\n605\t    }\n606\t}\n607\t\n608\tpub(crate) fn event_episodes(workspace_id: &str, tool: &str) -> Vec<EventEpisode> {\n609\t    vec![EventEpisode {\n610\t        event_id: event_identity(workspace_id, &format!(\"{tool}:current\")),\n611\t        event_kind: \"tool_called\".to_string(),\n612\t        summary: format!(\"{tool} composed graph, memory, event, and working-memory context\"),\n613\t        inclusion_reason: \"current workflow execution\".to_string(),\n614\t    }]\n615\t}\n616\t\n617\tpub(crate) fn stable_handles(files: &[String]) -> Vec<String> {\n618\t    files.iter().map(|file| format!(\"file_id:{file}\")).collect()\n619\t}\n620\t\n621\tpub(crate) fn workflow_record(\n622\t    tool: &str,\n623\t    request: &WorkflowRequest,\n624\t    selected: &[String],\n625\t    rationale: &[String],\n626\t) -> WorkflowRecord {\n627\t    WorkflowRecord {\n628\t        tool: tool.to_string(),\n629\t        input: request.input.clone(),\n630\t        resolved_anchors: request\n631\t            .entry_files\n632\t            .iter()\n633\t            .map(|file| StableIdentity::File(file_identity(\"workspace\", file)))\n634\t            .collect(),\n635\t        selected_candidates: selected.to_vec(),\n636\t        excluded_high_scoring_candidates: Vec::new(),\n637\t        working_memory_summary: if rationale.is_empty() {\n638\t            \"working memory considered; no additional rationale returned\".to_string()\n639\t        } else {\n640\t            rationale.join(\"; \")\n641\t        },\n642\t    }\n643\t}\n644\t"}]},"parent_tool_use_id":null,"session_id":"589d9a30-530c-4e7c-8151-20cc70f1285a","uuid":"8ba4540c-9cd1-4478-9666-f7c5b7617e8c","timestamp":"2026-05-17T14:41:16.352Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/workflow_v2/mod.rs","content":"//! Workflow Engine V2 edit-planning contract.\n//!\n//! Bound to `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 8: Workflow Engine V2` and `## MCP Tool Contract Principles`.\n//! The shared bundle below intentionally mirrors the spec field list:\n//! overview, ranked pivots, relevant context, memory highlights, event\n//! episodes where relevant, suggested next expansion, stable handles, risks or\n//! uncertainty, compact/full render choice, and structured payload.\n\nuse lattice_core::events::EventKind;\nuse lattice_core::identity::{ContextHandleId, EventId, FileId, MemoryId, SymbolId};\nuse lattice_core::intelligence::TaskBundle;\nuse lattice_core::memory::MemoryVerificationStatus;\nuse lattice_core::query::ContextCapsule;\nuse serde::{Deserialize, Serialize};\nuse serde_json::{json, Value};\n\npub mod context_capsule;\npub mod diagnose_failure;\npub mod docs_capsule;\n#[cfg(test)]\nmod composition_tests;\n#[cfg(test)]\nmod discovery_workflows_tests;\n#[cfg(test)]\nmod edit_workflows_tests;\npub mod impact_from_diff;\npub mod outcome_capture;\npub mod plan_edit;\npub mod prepare_change;\npub mod relevant_tests;\npub mod trace_scenario;\n\n/// Render choices shared by workflow v2 discovery and edit tools.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\npub enum WorkflowRenderChoice {\n    /// Focused response with the smallest useful working set.\n    Focused,\n    /// Compact response for default assistant use.\n    Compact,\n    /// Full response with broader candidates.\n    Full,\n    /// Diagnostic response with extra explanations.\n    Diagnostic,\n}\n\nimpl WorkflowRenderChoice {\n    /// Parse a user-supplied mode string.\n    pub fn from_mode_str(value: Option<&str>) -> Self {\n        match value {\n            Some(\"focused\") | Some(\"tiny\") => Self::Focused,\n            Some(\"full\") => Self::Full,\n            Some(\"diagnostic\") => Self::Diagnostic,\n            _ => Self::Compact,\n        }\n    }\n}\n\n/// Build an expansion seed from a workflow-v2 JSON-compatible bundle.\npub fn build_expand_seed<T: Serialize>(bundle: &T) -> lattice_core::intelligence::ExpandContextSeed {\n    let value = serde_json::to_value(bundle).unwrap_or_else(|_| json!({}));\n    lattice_core::intelligence::ExpandContextSeed {\n        query: value\n            .get(\"query\")\n            .or_else(|| value.get(\"scenario\"))\n            .or_else(|| value.get(\"overview\"))\n            .and_then(Value::as_str)\n            .map(ToString::to_string),\n        files: collect_string_values(&value, &[\"file\", \"repo_relative_path\"]),\n        symbols: collect_string_values(&value, &[\"symbol\", \"qualified_name\"]),\n        tests: collect_test_files(&value),\n        memories: value\n            .get(\"memory_highlights\")\n            .and_then(Value::as_array)\n            .cloned()\n            .unwrap_or_default(),\n    }\n}\n\nfn collect_string_values(value: &Value, keys: &[&str]) -> Vec<String> {\n    let mut values = Vec::new();\n    collect_string_values_inner(value, keys, &mut values);\n    values.sort();\n    values.dedup();\n    values\n}\n\nfn collect_string_values_inner(value: &Value, keys: &[&str], values: &mut Vec<String>) {\n    match value {\n        Value::Object(object) => {\n            for key in keys {\n                if let Some(item) = object.get(*key).and_then(Value::as_str) {\n                    values.push(item.to_string());\n                }\n            }\n            for child in object.values() {\n                collect_string_values_inner(child, keys, values);\n            }\n        }\n        Value::Array(items) => {\n            for item in items {\n                collect_string_values_inner(item, keys, values);\n            }\n        }\n        _ => {}\n    }\n}\n\nfn collect_test_files(value: &Value) -> Vec<String> {\n    value\n        .get(\"tests\")\n        .and_then(Value::as_array)\n        .map(|items| {\n            items\n                .iter()\n                .filter_map(|item| item.get(\"file\").and_then(Value::as_str))\n                .map(ToString::to_string)\n                .collect()\n        })\n        .unwrap_or_default()\n}\n\n/// Assistant-facing response shared by Phase 8 workflow tools.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct WorkflowBundle {\n    /// Human-readable summary of what the workflow selected and why.\n    pub overview: String,\n    /// Ranked code, doc, memory, or failure pivots with stable identities.\n    pub ranked_pivots: Vec<Pivot>,\n    /// Bounded supporting context that should be read before broad discovery.\n    pub relevant_context: Vec<ContextItem>,\n    /// Memory evidence with inclusion reason and verification lifecycle labels.\n    pub memory_highlights: Vec<MemoryHighlight>,\n    /// Explicit reason when no memories were available or relevant.\n    pub memory_empty_rationale: Option<String>,\n    /// Prior event-log episodes that are relevant to this workflow result.\n    pub event_episodes: Vec<EventEpisode>,\n    /// Recommended next expansion target.\n    pub suggested_next_expansion: Option<ExpansionHint>,\n    /// Stable handles copied out for clients that prefer a flat handle list.\n    pub stable_handles: Vec<String>,\n    /// Risks, stale evidence labels, contradictions, and uncertainty notes.\n    pub risks: Vec<RiskNote>,\n    /// Render shape selected for this response.\n    pub render_choice: RenderChoice,\n    /// Commands inferred from affected build targets and recommended tests.\n    pub verification_commands: Vec<String>,\n    /// Stable record of inputs, anchors, selected candidates, and exclusions.\n    pub workflow_record: WorkflowRecord,\n    /// Tool-specific payload retained for backward-compatible clients.\n    pub structured_payload: Value,\n}\n\n/// A ranked workflow pivot.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct Pivot {\n    /// Stable identity for the pivot.\n    pub identity: StableIdentity,\n    /// File, symbol, doc, memory, or event.\n    pub kind: String,\n    /// Display label for compact rendering.\n    pub label: String,\n    /// Repo-relative path when applicable.\n    pub file: Option<String>,\n    /// Symbol or heading name when applicable.\n    pub symbol: Option<String>,\n    /// One-based source line when applicable.\n    pub line: Option<usize>,\n    /// Ranked confidence score.\n    pub score: f64,\n    /// Reason this pivot was selected.\n    pub inclusion_reason: String,\n}\n\n/// Supporting context item.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct ContextItem {\n    /// Stable identity for the context item.\n    pub identity: StableIdentity,\n    /// Context kind such as file, symbol, doc, test, or memory.\n    pub kind: String,\n    /// Compact display label.\n    pub label: String,\n    /// Repo-relative file when applicable.\n    pub file: Option<String>,\n    /// Summary of the context item.\n    pub summary: String,\n    /// Reason the item was included.\n    pub inclusion_reason: String,\n}\n\n/// Memory evidence surfaced by a workflow.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct MemoryHighlight {\n    /// Stable memory identity.\n    pub memory_id: MemoryId,\n    /// Compact memory content.\n    pub content: String,\n    /// Memory type.\n    pub memory_type: String,\n    /// Session, branch, repo, or organization scope.\n    pub scope: String,\n    /// Reason retrieval included this memory.\n    pub inclusion_reason: String,\n    /// Evidence strength label.\n    pub evidence_strength: String,\n    /// Verification lifecycle state.\n    pub verification_status: String,\n    /// Freshness state derived from stale and verification fields.\n    pub freshness_status: String,\n    /// Contradiction or supersession state.\n    pub contradiction_state: String,\n    /// Expansion target for this memory.\n    pub expansion_target: String,\n    /// Required warning label for stale or otherwise unsafe statuses.\n    pub stale_label: Option<String>,\n}\n\n/// Prior event-log episode relevant to the workflow.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct EventEpisode {\n    /// Stable event identity.\n    pub event_id: EventId,\n    /// Event kind such as workflow_failed or tool_called.\n    pub event_kind: String,\n    /// Compact event summary.\n    pub summary: String,\n    /// Reason this episode was included.\n    pub inclusion_reason: String,\n}\n\n/// Risk or uncertainty surfaced by the workflow.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct RiskNote {\n    /// Risk severity: info, warning, or error.\n    pub severity: String,\n    /// Stable identity this risk is about when applicable.\n    pub identity: Option<StableIdentity>,\n    /// Risk summary.\n    pub message: String,\n    /// Recommended mitigation.\n    pub mitigation: String,\n}\n\n/// Suggested expansion target.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct ExpansionHint {\n    /// Stable focus string accepted by expand_context.\n    pub focus: String,\n    /// Reason this expansion is the next best step.\n    pub reason: String,\n}\n\n/// Stable identity wrapper for workflow payloads.\n#[derive(Debug, Clone, Serialize, Deserialize)]\n#[serde(tag = \"kind\", content = \"value\")]\npub enum StableIdentity {\n    /// Stable file identity.\n    File(FileId),\n    /// Stable symbol identity.\n    Symbol(SymbolId),\n    /// Stable memory identity.\n    Memory(MemoryId),\n    /// Stable event identity.\n    Event(EventId),\n    /// Stable context handle identity.\n    ContextHandle(ContextHandleId),\n    /// Legacy expansion handle retained for backward compatibility.\n    LegacyHandle(String),\n}\n\n/// Render mode selected by the workflow.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct RenderChoice {\n    /// compact or full.\n    pub mode: String,\n    /// Why this render mode was selected.\n    pub reason: String,\n}\n\n/// Recorded workflow composition metadata.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct WorkflowRecord {\n    /// Tool name.\n    pub tool: String,\n    /// Raw query or failure input.\n    pub input: String,\n    /// Resolved anchors used by retrieval and ranking.\n    pub resolved_anchors: Vec<StableIdentity>,\n    /// Selected candidate handles.\n    pub selected_candidates: Vec<String>,\n    /// Excluded high-scoring candidates and reasons.\n    pub excluded_high_scoring_candidates: Vec<String>,\n    /// Working-memory operation summary.\n    pub working_memory_summary: String,\n}\n\n/// Inputs common to edit-planning workflows.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct WorkflowRequest {\n    /// Query, scenario, or failure text.\n    pub input: String,\n    /// Optional starting files.\n    pub entry_files: Vec<String>,\n    /// Optional starting symbols.\n    pub entry_symbols: Vec<String>,\n    /// compact or full.\n    pub render_mode: String,\n}\n\n/// Event capture abstraction used by tests and MCP integration.\npub trait WorkflowEventSink {\n    /// Record one workflow event.\n    fn record_event(&mut self, kind: EventKind, summary: &str);\n}\n\n/// In-memory event sink for unit tests.\n#[derive(Debug, Default)]\npub struct VecEventSink {\n    /// Recorded event kinds in order.\n    pub events: Vec<EventKind>,\n}\n\nimpl WorkflowEventSink for VecEventSink {\n    fn record_event(&mut self, kind: EventKind, _summary: &str) {\n        self.events.push(kind);\n    }\n}\n\npub(crate) fn emit_standard_events(sink: &mut dyn WorkflowEventSink, tool: &str) {\n    sink.record_event(EventKind::AssistantTaskStarted, \"workflow v2 task started\");\n    sink.record_event(EventKind::ToolCalled, tool);\n    sink.record_event(EventKind::ContextBundleReturned, \"workflow v2 bundle returned\");\n    sink.record_event(EventKind::MemoryRetrieved, \"workflow v2 memories retrieved\");\n    sink.record_event(EventKind::PlanCreated, \"workflow v2 plan created\");\n}\n\npub(crate) fn file_identity(workspace_id: &str, file: &str) -> FileId {\n    FileId {\n        workspace_id: workspace_id.to_string(),\n        repo_relative_path: file.to_string(),\n        content_hash: \"unknown\".to_string(),\n    }\n}\n\npub(crate) fn memory_identity(workspace_id: &str, id: &str) -> MemoryId {\n    MemoryId {\n        workspace_id: workspace_id.to_string(),\n        ulid: id.to_string(),\n    }\n}\n\npub(crate) fn event_identity(workspace_id: &str, id: &str) -> EventId {\n    EventId {\n        workspace_id: workspace_id.to_string(),\n        ulid: id.to_string(),\n    }\n}\n\npub(crate) fn memory_highlights(\n    workspace_id: &str,\n    memories: &[Value],\n    fallback_reason: &str,\n) -> Vec<MemoryHighlight> {\n    memories\n        .iter()\n        .enumerate()\n        .filter_map(|(index, value)| memory_highlight(workspace_id, value, index, fallback_reason))\n        .collect()\n}\n\nfn memory_highlight(\n    workspace_id: &str,\n    value: &Value,\n    index: usize,\n    fallback_reason: &str,\n) -> Option<MemoryHighlight> {\n    let object = value.as_object()?;\n    let content = string_field(object, &[\"content\", \"summary\"])?;\n    let status = string_field(object, &[\"verification_status\"])\n        .unwrap_or_else(|| \"unverified\".to_string());\n    let is_stale = object\n        .get(\"is_stale\")\n        .and_then(Value::as_bool)\n        .unwrap_or(false);\n    let memory_id = string_field(object, &[\"id\", \"memory_id\"])\n        .unwrap_or_else(|| format!(\"memory-{index}\"));\n    let status_kind = MemoryVerificationStatus::from_str(&status);\n    let stale_label = stale_label(status_kind, is_stale);\n    Some(MemoryHighlight {\n        memory_id: memory_identity(workspace_id, &memory_id),\n        content,\n        memory_type: string_field(object, &[\"memory_type\", \"type\"])\n            .unwrap_or_else(|| \"observation\".to_string()),\n        scope: string_field(object, &[\"scope\"]).unwrap_or_else(|| \"session\".to_string()),\n        inclusion_reason: string_field(object, &[\"inclusion_reason\"])\n            .unwrap_or_else(|| fallback_reason.to_string()),\n        evidence_strength: evidence_strength(object),\n        verification_status: status,\n        freshness_status: freshness_status(status_kind, is_stale).to_string(),\n        contradiction_state: contradiction_state(object, status_kind),\n        expansion_target: format!(\"memory:{memory_id}\"),\n        stale_label,\n    })\n}\n\nfn string_field(\n    object: &serde_json::Map<String, Value>,\n    keys: &[&str],\n) -> Option<String> {\n    keys.iter()\n        .filter_map(|key| object.get(*key).and_then(Value::as_str))\n        .map(str::trim)\n        .filter(|value| !value.is_empty())\n        .map(ToString::to_string)\n        .next()\n}\n\nfn evidence_strength(object: &serde_json::Map<String, Value>) -> String {\n    object\n        .get(\"confidence\")\n        .and_then(Value::as_f64)\n        .map(|score| {\n            if score >= 0.8 {\n                \"strong\"\n            } else if score >= 0.45 {\n                \"moderate\"\n            } else {\n                \"weak\"\n            }\n        })\n        .unwrap_or(\"unverified\")\n        .to_string()\n}\n\nfn stale_label(status: MemoryVerificationStatus, is_stale: bool) -> Option<String> {\n    let unsafe_status = matches!(\n        status,\n        MemoryVerificationStatus::Stale\n            | MemoryVerificationStatus::Contradicted\n            | MemoryVerificationStatus::Superseded\n            | MemoryVerificationStatus::Expired\n            | MemoryVerificationStatus::Invalidated\n    );\n    if unsafe_status || is_stale {\n        Some(format!(\"STALE_OR_UNTRUSTED: {}\", status.as_str()))\n    } else {\n        None\n    }\n}\n\nfn freshness_status(status: MemoryVerificationStatus, is_stale: bool) -> &'static str {\n    if is_stale || matches!(status, MemoryVerificationStatus::Stale) {\n        \"stale\"\n    } else if matches!(status, MemoryVerificationStatus::Expired) {\n        \"expired\"\n    } else {\n        \"fresh\"\n    }\n}\n\nfn contradiction_state(\n    object: &serde_json::Map<String, Value>,\n    status: MemoryVerificationStatus,\n) -> String {\n    if matches!(status, MemoryVerificationStatus::Contradicted) {\n        return \"contradicted\".to_string();\n    }\n    if matches!(status, MemoryVerificationStatus::Superseded) {\n        return \"superseded\".to_string();\n    }\n    if object\n        .get(\"contradicted_by_memory_ids\")\n        .and_then(Value::as_array)\n        .is_some_and(|items| !items.is_empty())\n    {\n        return \"has_contradictions\".to_string();\n    }\n    \"none\".to_string()\n}\n\npub(crate) fn risks_from_memories(memories: &[MemoryHighlight]) -> Vec<RiskNote> {\n    memories\n        .iter()\n        .filter_map(|memory| {\n            memory.stale_label.as_ref().map(|label| RiskNote {\n                severity: \"warning\".to_string(),\n                identity: Some(StableIdentity::Memory(memory.memory_id.clone())),\n                message: format!(\"Memory is not trusted guidance: {label}\"),\n                mitigation: \"Use it only as historical evidence and verify against current code.\"\n                    .to_string(),\n            })\n        })\n        .collect()\n}\n\npub(crate) fn verification_commands(files: &[String], tests: &[String]) -> Vec<String> {\n    let mut commands = Vec::new();\n    if files.iter().any(|file| file.ends_with(\".rs\")) || tests.iter().any(|file| file.ends_with(\".rs\")) {\n        commands.push(\"cd daemon && cargo test --workspace\".to_string());\n    }\n    if files.iter().any(|file| file.starts_with(\"daemon/crates/lattice-daemon\"))\n        || tests.iter().any(|file| file.contains(\"lattice-daemon\"))\n    {\n        commands.push(\"cd daemon && cargo test -p lattice-daemon --lib\".to_string());\n    }\n    if files.iter().any(|file| file.ends_with(\".ts\") || file.ends_with(\".tsx\")) {\n        commands.push(\"cd extension && npm run compile\".to_string());\n    }\n    commands.extend(tests.iter().map(|file| {\n        if file.ends_with(\".rs\") {\n            format!(\"cd daemon && cargo test {}\", file.replace('/', \"::\"))\n        } else {\n            format!(\"Run targeted test file {file}\")\n        }\n    }));\n    if commands.is_empty() {\n        commands.push(\"cd daemon && cargo test --workspace\".to_string());\n    }\n    commands.sort();\n    commands.dedup();\n    commands\n}\n\npub(crate) fn bundle_from_task(\n    workspace_id: &str,\n    request: &WorkflowRequest,\n    task: &TaskBundle,\n    capsule: &ContextCapsule,\n) -> WorkflowBundle {\n    let memories = memory_highlights(workspace_id, &capsule.memories, \"matched workflow query\");\n    let mut risks = risks_from_memories(&memories);\n    risks.extend(task.risks.iter().map(|risk| RiskNote {\n        severity: risk.level.clone(),\n        identity: Some(StableIdentity::File(file_identity(workspace_id, &risk.file))),\n        message: risk.reason.clone(),\n        mitigation: \"Inspect dependents and run the recommended tests before editing.\".to_string(),\n    }));\n    let files = task.primary_files.iter().map(|item| item.file.clone()).collect::<Vec<_>>();\n    let tests = task.tests.iter().map(|item| item.file.clone()).collect::<Vec<_>>();\n    WorkflowBundle {\n        overview: task.overview.clone(),\n        ranked_pivots: task\n            .symbols\n            .iter()\n            .map(|symbol| Pivot {\n                identity: StableIdentity::LegacyHandle(\n                    symbol.symbol_handle.clone().unwrap_or_else(|| format!(\"symbol:{}\", symbol.symbol)),\n                ),\n                kind: \"symbol\".to_string(),\n                label: symbol.symbol.clone(),\n                file: Some(symbol.file.clone()),\n                symbol: Some(symbol.symbol.clone()),\n                line: Some(symbol.line),\n                score: symbol.score,\n                inclusion_reason: symbol.evidence.join(\"; \"),\n            })\n            .collect(),\n        relevant_context: task\n            .primary_files\n            .iter()\n            .chain(task.secondary_files.iter())\n            .map(|file| ContextItem {\n                identity: StableIdentity::File(file_identity(workspace_id, &file.file)),\n                kind: \"file\".to_string(),\n                label: file.file.clone(),\n                file: Some(file.file.clone()),\n                summary: file.reasons.join(\"; \"),\n                inclusion_reason: file.reasons.join(\"; \"),\n            })\n            .collect(),\n        memory_empty_rationale: empty_memory_rationale(&memories),\n        memory_highlights: memories,\n        event_episodes: event_episodes(workspace_id, \"prepare_change\"),\n        suggested_next_expansion: expansion_from_value(&serde_json::to_value(&task.suggested_expand).ok()),\n        stable_handles: stable_handles(&files),\n        risks,\n        render_choice: render_choice(request),\n        verification_commands: verification_commands(&files, &tests),\n        workflow_record: workflow_record(\"prepare_change\", request, &files, &task.rationale),\n        structured_payload: serde_json::to_value(task).unwrap_or_else(|_| json!({})),\n    }\n}\n\nfn expansion_from_value(value: &Option<Value>) -> Option<ExpansionHint> {\n    let object = value.as_ref()?.as_object()?;\n    Some(ExpansionHint {\n        focus: object.get(\"focus\")?.as_str()?.to_string(),\n        reason: object.get(\"reason\")?.as_str()?.to_string(),\n    })\n}\n\npub(crate) fn render_choice(request: &WorkflowRequest) -> RenderChoice {\n    RenderChoice {\n        mode: request.render_mode.clone(),\n        reason: \"MCP request selected the workflow render mode\".to_string(),\n    }\n}\n\npub(crate) fn empty_memory_rationale(memories: &[MemoryHighlight]) -> Option<String> {\n    if memories.is_empty() {\n        Some(\"No relevant memory matched the resolved anchors.\".to_string())\n    } else {\n        None\n    }\n}\n\npub(crate) fn event_episodes(workspace_id: &str, tool: &str) -> Vec<EventEpisode> {\n    vec![EventEpisode {\n        event_id: event_identity(workspace_id, &format!(\"{tool}:current\")),\n        event_kind: \"tool_called\".to_string(),\n        summary: format!(\"{tool} composed graph, memory, event, and working-memory context\"),\n        inclusion_reason: \"current workflow execution\".to_string(),\n    }]\n}\n\npub(crate) fn stable_handles(files: &[String]) -> Vec<String> {\n    files.iter().map(|file| format!(\"file_id:{file}\")).collect()\n}\n\npub(crate) fn workflow_record(\n    tool: &str,\n    request: &WorkflowRequest,\n    selected: &[String],\n    rationale: &[String],\n) -> WorkflowRecord {\n    WorkflowRecord {\n        tool: tool.to_string(),\n        input: request.input.clone(),\n        resolved_anchors: request\n            .entry_files\n            .iter()\n            .map(|file| StableIdentity::File(file_identity(\"workspace\", file)))\n            .collect(),\n        selected_candidates: selected.to_vec(),\n        excluded_high_scoring_candidates: Vec::new(),\n        working_memory_summary: if rationale.is_empty() {\n            \"working memory considered; no additional rationale returned\".to_string()\n        } else {\n            rationale.join(\"; \")\n        },\n    }\n}\n","numLines":644,"startLine":1,"totalLines":644}}}
