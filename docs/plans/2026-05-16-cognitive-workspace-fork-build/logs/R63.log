{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GBVrKNFM5qbp1dBFuLpzKo","type":"tool_result","content":"1\tuse super::EvolutionAction;\n2\tuse lattice_core::consolidation::{ConsolidationProposal, ProposalKind, ProposalTarget};\n3\tuse lattice_core::memory::{Memory, MemoryStore, MemoryStructuredFields, MemoryVerificationStatus};\n4\tuse serde::{Deserialize, Serialize};\n5\tuse serde_json::{json, Value};\n6\t\n7\t/// Arguments for the unified `propose_memory_evolution` tool.\n8\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n9\tpub struct ProposeMemoryEvolutionArgs {\n10\t    /// Whether to propose, apply, or reject a memory evolution.\n11\t    pub action: EvolutionAction,\n12\t    /// Existing proposal id for apply/reject.\n13\t    #[serde(default)]\n14\t    pub proposal_id: Option<String>,\n15\t    /// Source memory id for a new proposal.\n16\t    #[serde(default)]\n17\t    pub memory_id: Option<String>,\n18\t    /// Proposed content replacement.\n19\t    #[serde(default)]\n20\t    pub content: Option<String>,\n21\t    /// Linked files to append or replace in the proposed state.\n22\t    #[serde(default)]\n23\t    pub linked_files: Vec<String>,\n24\t    /// Linked symbols to append or replace in the proposed state.\n25\t    #[serde(default)]\n26\t    pub linked_symbols: Vec<String>,\n27\t    /// Linked docs to append or replace in the proposed state.\n28\t    #[serde(default)]\n29\t    pub linked_docs: Vec<String>,\n30\t    /// Linked tests to append or replace in the proposed state.\n31\t    #[serde(default)]\n32\t    pub linked_tests: Vec<String>,\n33\t    /// Linked memories to append or replace in the proposed state.\n34\t    #[serde(default)]\n35\t    pub linked_memories: Vec<String>,\n36\t    /// Validity conditions to persist in the proposed state.\n37\t    #[serde(default)]\n38\t    pub validity_conditions: Vec<String>,\n39\t    /// Invalidation triggers to persist in the proposed state.\n40\t    #[serde(default)]\n41\t    pub invalidation_triggers: Vec<String>,\n42\t    /// Optional target memory id that supersedes the source memory.\n43\t    #[serde(default)]\n44\t    pub superseded_by_memory_id: Option<String>,\n45\t    /// Optional invalidation reason.\n46\t    #[serde(default)]\n47\t    pub invalidate_reason: Option<String>,\n48\t    /// Optional decision reason or proposal summary.\n49\t    #[serde(default)]\n50\t    pub reason: Option<String>,\n51\t    /// Optional operator/assistant identifier recorded on apply/reject.\n52\t    #[serde(default)]\n53\t    pub decided_by: Option<String>,\n54\t}\n55\t\n56\tpub fn tool_definition() -> Value {\n57\t    json!({\n58\t        \"name\": \"propose_memory_evolution\",\n59\t        \"description\": \"Persist, apply, or reject auditable memory evolution proposals with provenance-preserving transactional updates.\",\n60\t        \"inputSchema\": {\n61\t            \"type\": \"object\",\n62\t            \"properties\": {\n63\t                \"action\": {\"type\": \"string\", \"enum\": [\"propose\", \"apply\", \"reject\"]},\n64\t                \"proposal_id\": {\"type\": \"string\"},\n65\t                \"memory_id\": {\"type\": \"string\"},\n66\t                \"content\": {\"type\": \"string\"},\n67\t                \"linked_files\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n68\t                \"linked_symbols\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n69\t                \"linked_docs\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n70\t                \"linked_tests\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n71\t                \"linked_memories\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n72\t                \"validity_conditions\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n73\t                \"invalidation_triggers\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n74\t                \"superseded_by_memory_id\": {\"type\": \"string\"},\n75\t                \"invalidate_reason\": {\"type\": \"string\"},\n76\t                \"reason\": {\"type\": \"string\"},\n77\t                \"decided_by\": {\"type\": \"string\"}\n78\t            },\n79\t            \"required\": [\"action\"]\n80\t        }\n81\t    })\n82\t}\n83\t\n84\tpub fn apply_shim_tool_definition() -> Value {\n85\t    json!({\n86\t        \"name\": \"apply_memory_evolution\",\n87\t        \"description\": \"Deprecated shim for propose_memory_evolution(action=apply). Returns a deprecation warning while forwarding to the unified tool.\",\n88\t        \"inputSchema\": {\n89\t            \"type\": \"object\",\n90\t            \"properties\": {\n91\t                \"proposal_id\": {\"type\": \"string\"},\n92\t                \"reason\": {\"type\": \"string\"},\n93\t                \"decided_by\": {\"type\": \"string\"}\n94\t            },\n95\t            \"required\": [\"proposal_id\"]\n96\t        }\n97\t    })\n98\t}\n99\t\n100\tpub fn parse_args(args: &Value) -> Result<ProposeMemoryEvolutionArgs, String> {\n101\t    serde_json::from_value(args.clone())\n102\t        .map_err(|error| format!(\"Invalid propose_memory_evolution arguments: {error}\"))\n103\t}\n104\t\n105\tpub fn parse_apply_shim_args(args: &Value) -> Result<ProposeMemoryEvolutionArgs, String> {\n106\t    let proposal_id = args\n107\t        .get(\"proposal_id\")\n108\t        .and_then(Value::as_str)\n109\t        .ok_or_else(|| \"apply_memory_evolution requires proposal_id\".to_string())?;\n110\t    Ok(ProposeMemoryEvolutionArgs {\n111\t        action: EvolutionAction::Apply,\n112\t        proposal_id: Some(proposal_id.to_string()),\n113\t        memory_id: None,\n114\t        content: None,\n115\t        linked_files: Vec::new(),\n116\t        linked_symbols: Vec::new(),\n117\t        linked_docs: Vec::new(),\n118\t        linked_tests: Vec::new(),\n119\t        linked_memories: Vec::new(),\n120\t        validity_conditions: Vec::new(),\n121\t        invalidation_triggers: Vec::new(),\n122\t        superseded_by_memory_id: None,\n123\t        invalidate_reason: None,\n124\t        reason: args.get(\"reason\").and_then(Value::as_str).map(str::to_string),\n125\t        decided_by: args\n126\t            .get(\"decided_by\")\n127\t            .and_then(Value::as_str)\n128\t            .map(str::to_string),\n129\t    })\n130\t}\n131\t\n132\tpub fn validate_args(args: &ProposeMemoryEvolutionArgs) -> Result<(), String> {\n133\t    match args.action {\n134\t        EvolutionAction::Propose => {\n135\t            if args.memory_id.as_deref().unwrap_or(\"\").trim().is_empty() {\n136\t                return Err(\"propose_memory_evolution(action=propose) requires memory_id\".to_string());\n137\t            }\n138\t        }\n139\t        EvolutionAction::Apply | EvolutionAction::Reject => {\n140\t            if args.proposal_id.as_deref().unwrap_or(\"\").trim().is_empty() {\n141\t                return Err(format!(\n142\t                    \"propose_memory_evolution(action={}) requires proposal_id\",\n143\t                    match args.action {\n144\t                        EvolutionAction::Apply => \"apply\",\n145\t                        EvolutionAction::Reject => \"reject\",\n146\t                        EvolutionAction::Propose => \"propose\",\n147\t                    }\n148\t                ));\n149\t            }\n150\t        }\n151\t    }\n152\t    Ok(())\n153\t}\n154\t\n155\tpub fn proposal_kind(args: &ProposeMemoryEvolutionArgs) -> ProposalKind {\n156\t    if args.invalidate_reason.is_some() {\n157\t        ProposalKind::MarkInvalidated\n158\t    } else if args.superseded_by_memory_id.is_some() {\n159\t        ProposalKind::Supersede\n160\t    } else {\n161\t        ProposalKind::UpdateMemory\n162\t    }\n163\t}\n164\t\n165\tpub fn build_proposal(\n166\t    _workspace_id: &str,\n167\t    store: &MemoryStore,\n168\t    args: &ProposeMemoryEvolutionArgs,\n169\t) -> Result<ConsolidationProposal, String> {\n170\t    let memory_id = args.memory_id.as_deref().ok_or_else(|| \"missing memory_id\".to_string())?;\n171\t    let memory = store\n172\t        .get_by_id(memory_id)\n173\t        .map_err(|error| format!(\"Failed to load source memory: {error}\"))?\n174\t        .ok_or_else(|| format!(\"Memory `{memory_id}` was not found\"))?;\n175\t    let prior_fields = store\n176\t        .get_structured_fields(memory_id)\n177\t        .map_err(|error| format!(\"Failed to load source structured fields: {error}\"))?\n178\t        .unwrap_or_default();\n179\t    let prior_state = capture_state_json(store, &memory, &prior_fields)?;\n180\t    let next = apply_delta(memory.clone(), prior_fields, args);\n181\t    let proposed_state = capture_state_json(store, &next.0, &next.1)?;\n182\t    Ok(ConsolidationProposal {\n183\t        proposal_id: format!(\"memory-evolution-{}-{}\", memory_id, now_unix_micros()),\n184\t        job_id: format!(\"memory-evolution-job-{}-{}\", memory_id, now_unix_micros()),\n185\t        target: ProposalTarget::ExistingMemory(memory_id.to_string()),\n186\t        proposal_kind: proposal_kind(args),\n187\t        prior_state,\n188\t        proposed_state,\n189\t        evidence: json!({\n190\t            \"source_memory_ids\": [memory_id],\n191\t            \"reason\": args.reason,\n192\t            \"invalidate_reason\": args.invalidate_reason,\n193\t            \"superseded_by_memory_id\": args.superseded_by_memory_id,\n194\t        }),\n195\t        provenance: None,\n196\t    })\n197\t}\n198\t\n199\tfn apply_delta(\n200\t    mut memory: Memory,\n201\t    mut fields: MemoryStructuredFields,\n202\t    args: &ProposeMemoryEvolutionArgs,\n203\t) -> (Memory, MemoryStructuredFields) {\n204\t    if let Some(content) = args.content.as_ref() {\n205\t        memory.content = content.clone();\n206\t    }\n207\t    if !args.linked_files.is_empty() {\n208\t        memory.linked_files = args.linked_files.clone();\n209\t    }\n210\t    if !args.linked_symbols.is_empty() {\n2