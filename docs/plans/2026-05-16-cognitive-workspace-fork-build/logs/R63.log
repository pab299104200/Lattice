38\t    let response = handler\n139\t        .handle(\n140\t            \"tools/call\",\n141\t            json!({\n142\t                \"name\": \"save_memory\",\n143\t                \"arguments\": {\n144\t                    \"content\": \"Refresh token invariants rely on session scope\",\n145\t                    \"memory_class\": \"constraint\",\n146\t                    \"assertion_type\": \"constraint\",\n147\t                    \"scope\": \"repo\",\n148\t                    \"confidence\": 0.74,\n149\t                    \"confidence_reason\": \"Observed in handler and tests\",\n150\t                    \"freshness_policy\": \"manual_review\",\n151\t                    \"validity_conditions\": [\"session middleware stays enabled\"],\n152\t                    \"invalidation_triggers\": [\"refresh handler rewrite\"],\n153\t                    \"provenance_event_ids\": [\"evt-refresh\"],\n154\t                    \"linked_files\": [\"src/auth.rs\"],\n155\t                    \"linked_symbols\": [\"refresh_token\"],\n156\t                    \"linked_docs\": [\"docs/auth.md#Refresh\"],\n157\t                    \"linked_tests\": [\"tests/auth_refresh.rs::refresh_token\"],\n158\t                    \"linked_memories\": [\"mem-upstream\"],\n159\t                    \"source_query\": \"refresh token failures\",\n160\t                    \"refresh_key\": \"auth::refresh\"\n161\t                }\n162\t            }),\n163\t        )\n164\t        .await\n165\t        .expect(\"save_memory succeeds\");\n166\t    let payload = parse_tool_payload(&response);\n167\t    assert_eq!(payload[\"memory\"][\"verification_status\"].as_str(), Some(\"unverified\"));\n168\t    let memory_id = payload[\"memory_id\"].as_str().expect(\"memory id\");\n169\t\n170\t    let store = memory_store.lock().await;\n171\t    let fields = store\n172\t        .get_structured_fields(memory_id)\n173\t        .expect(\"fields query\")\n174\t        .expect(\"fields exist\");\n175\t    assert_eq!(fields.memory_class, MemoryClass::Constraint);\n176\t    assert_eq!(fields.assertion_type, MemoryAssertionType::Constraint);\n177\t    assert_eq!(fields.linked_docs, vec![\"docs/auth.md#Refresh\".to_string()]);\n178\t    assert_eq!(\n179\t        fields.linked_tests,\n180\t        vec![\"tests/auth_refresh.rs::refresh_token\".to_string()]\n181\t    );\n182\t    assert_eq!(fields.linked_memories, vec![\"mem-upstream\".to_string()]);\n183\t    assert_eq!(\n184\t        fields.validity_conditions,\n185\t        vec![\"session middleware stays enabled\".to_string()]\n186\t    );\n187\t    assert_eq!(\n188\t        fields.invalidation_triggers,\n189\t        vec![\"refresh handler rewrite\".to_string()]\n190\t    );\n191\t    let queued_jobs: i64 = store\n192\t        .with_connection(|conn| {\n193\t            conn.query_row(\n194\t                \"SELECT COUNT(*) FROM verification_jobs WHERE target_memory_id = ?1 AND status = 'queued'\",\n195\t                [memory_id],\n196\t                |row| row.get(0),\n197\t            )\n198\t            .map_err(|error| lattice_core::LatticeError::Storage(error.to_string()))\n199\t        })\n200\t        .expect(\"verification job count\");\n201\t    assert_eq!(queued_jobs, 1);\n202\t    drop(store);\n203\t\n204\t    let events = read_events(&event_store);\n205\t    assert!(events.iter().any(|event| matches!(event.payload, EventPayload::MemoryCreated(_))));\n206\t    cleanup_paths(&workspace_root, &context_cache_path);\n207\t}\n208\t\n209\t#[tokio::test]\n210\tasync fn propose_apply_and_reject_memory_evolution_are_auditable() {\n211\t    let (handler, memory_store, event_store, workspace_root, context_cache_path) =\n212\t        build_handler(\"memory-evolution\");\n213\t    let memory_id = {\n214\t        let mut store = memory_store.lock().await;\n215\t        let id = store\n216\t            .store(seed_memory(\"refresh behavior old\", MemoryScope::Repo))\n217\t            .expect(\"store memory\");\n218\t        let mut