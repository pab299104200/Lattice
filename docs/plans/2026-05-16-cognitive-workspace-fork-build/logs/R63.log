{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uczc7pPzRS9zapKUx5PYLq","type":"tool_result","content":"1\tuse super::{\n2\t    emit_standard_events, empty_memory_rationale, event_episodes, file_identity,\n3\t    memory_highlights, render_choice, stable_handles, verification_commands, workflow_record,\n4\t    ContextItem, ExpansionHint, Pivot, StableIdentity, WorkflowBundle, WorkflowEventSink,\n5\t    WorkflowRequest,\n6\t};\n7\tuse lattice_core::intelligence::FailureDiagnosis;\n8\tuse serde_json::json;\n9\t\n10\t/// Compose the redesigned `diagnose_failure` bundle with failure-pattern memory,\n11\t/// prior failure episodes, likely culprit symbols, and a prepare-change follow-up.\n12\tpub fn run(\n13\t    workspace_id: &str,\n14\t    request: &WorkflowRequest,\n15\t    diagnosis: &FailureDiagnosis,\n16\t    memories: &[serde_json::Value],\n17\t    sink: &mut dyn WorkflowEventSink,\n18\t) -> WorkflowBundle {\n19\t    emit_standard_events(sink, \"diagnose_failure\");\n20\t    let memory_highlights = memory_highlights(workspace_id, memories, \"matched failure pattern\");\n21\t    let files = diagnosis.extracted_files.clone();\n22\t    let tests = diagnosis.tests.iter().map(|item| item.file.clone()).collect::<Vec<_>>();\n23\t\n24\t    WorkflowBundle {\n25\t        overview: diagnosis.overview.clone(),\n26\t        ranked_pivots: suspect_pivots(workspace_id, diagnosis),\n27\t        relevant_context: related_context(workspace_id, diagnosis),\n28\t        memory_empty_rationale: empty_memory_rationale(&memory_highlights),\n29\t        memory_highlights,\n30\t        event_episodes: event_episodes(workspace_id, \"diagnose_failure\"),\n31\t        suggested_next_expansion: prepare_change_hint(diagnosis),\n32\t        stable_handles: stable_handles(&files),\n33\t        risks: Vec::new(),\n34\t        render_choice: render_choice(request),\n35\t        verification_commands: verification_commands(&files, &tests),\n36\t        workflow_record: workflow_record(\"diagnose_failure\", request, &files, &diagnosis.rationale),\n37\t        structured_payload: json!(diagnosis),\n38\t    }\n39\t}\n40\t\n41\tfn suspect_pivots(workspace_id: &str, diagnosis: &FailureDiagnosis) -> Vec<Pivot> {\n42\t    diagnosis\n43\t        .suspects\n44\t        .iter()\n45\t        .map(|suspect| Pivot {\n46\t            identity: StableIdentity::File(file_identity(workspace_id, &suspect.file)),\n47\t            kind: \"likely_culprit\".to_string(),\n48\t            label: suspect.symbol.clone(),\n49\t            file: Some(suspect.file.clone()),\n50\t            symbol: Some(suspect.symbol.clone()),\n51\t            line: Some(suspect.line),\n52\t            score: suspect.score,\n53\t            inclusion_reason: suspect.evidence.join(\"; \"),\n54\t        })\n55\t        .collect()\n56\t}\n57\t\n58\tfn related_context(workspace_id: &str, diagnosis: &FailureDiagnosis) -> Vec<ContextItem> {\n59\t    diagnosis\n60\t        .related_symbols\n61\t        .iter()\n62\t        .map(|symbol| ContextItem {\n63\t            identity: StableIdentity::File(file_identity(workspace_id, &symbol.file)),\n64\t            kind: \"related_symbol\".to_string(),\n65\t            label: symbol.symbol.clone(),\n66\t            file: Some(symbol.file.clone()),\n67\t            summary: symbol.evidence.join(\"; \"),\n68\t            inclusion_reason: symbol.evidence.join(\"; \"),\n69\t        })\n70\t        .collect()\n71\t}\n72\t\n73\tfn prepare_change_hint(diagnosis: &FailureDiagnosis) -> Option<ExpansionHint> {\n74\t    let suspect = diagnosis.suspects.first()?;\n75\t    Some(ExpansionHint {\n76\t        focus: suspect\n77\t            .symbol_handle\n78\t            .clone()\n79\t            .unwrap_or_else(|| format!(\"symbol:{}\", suspect.symbol)),\n80\t        reason: \"Use this suspect as the anchor for a prepare_change follow-up.\".to_string(),\n81\t    })\n82\t}\n83\t"}]},"parent_tool_use_id":null,"session_id":"589d9a30-530c-4e7c-8151-20cc70f1285a","uuid":"cfc81744-4755-4766-88d9-7d406e20aa52","timestamp":"2026-05-17T14:41:34.459Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/workflow_v2/diagnose_failure.rs","content":"use super::{\n    emit_standard_events, empty_memory_rationale, event_episodes, file_identity,\n    memory_highlights, render_choice, stable_handles, verification_commands, workflow_record,\n    ContextItem, ExpansionHint, Pivot, StableIdentity, WorkflowBundle, WorkflowEventSink,\n    WorkflowRequest,\n};\nuse lattice_core::intelligence::FailureDiagnosis;\nuse serde_json::json;\n\n/// Compose the redesigned `diagnose_failure` bundle with failure-pattern memory,\n/// prior failure episodes, likely culprit symbols, and a prepare-change follow-up.\npub fn run(\n    workspace_id: &str,\n    request: &WorkflowRequest,\n    diagnosis: &FailureDiagnosis,\n    memories: &[serde_json::Value],\n    sink: &mut dyn WorkflowEventSink,\n) -> WorkflowBundle {\n    emit_standard_events(sink, \"diagnose_failure\");\n    let memory_highlights = memory_highlights(workspace_id, memories, \"matched failure pattern\");\n    let files = diagnosis.extracted_files.clone();\n    let tests = diagnosis.tests.iter().map(|item| item.file.clone()).collect::<Vec<_>>();\n\n    WorkflowBundle {\n        overview: diagnosis.overview.clone(),\n        ranked_pivots: suspect_pivots(workspace_id, diagnosis),\n        relevant_context: related_context(workspace_id, diagnosis),\n        memory_empty_rationale: empty_memory_rationale(&memory_highlights),\n        memory_highlights,\n        event_episodes: event_episodes(workspace_id, \"diagnose_failure\"),\n        suggested_next_expansion: prepare_change_hint(diagnosis),\n        stable_handles: stable_handles(&files),\n        risks: Vec::new(),\n        render_choice: render_choice(request),\n        verification_commands: verification_commands(&files, &tests),\n        workflow_record: workflow_record(\"diagnose_failure\", request, &files, &diagnosis.rationale),\n        structured_payload: json!(diagnosis),\n    }\n}\n\nfn suspect_pivots(workspace_id: &str, diagnosis: &FailureDiagnosis) -> Vec<Pivot> {\n    diagnosis\n        .suspects\n        .iter()\n        .map(|suspect| Pivot {\n            identity: StableIdentity::File(file_identity(workspace_id, &suspect.file)),\n            kind: \"likely_culprit\".to_string(),\n            label: suspect.symbol.clone(),\n            file: Some(suspect.file.clone()),\n            symbol: Some(suspect.symbol.clone()),\n            line: Some(suspect.line),\n            score: suspect.score,\n            inclusion_reason: suspect.evidence.join(\"; \"),\n        })\n        .collect()\n}\n\nfn related_context(workspace_id: &str, diagnosis: &FailureDiagnosis) -> Vec<ContextItem> {\n    diagnosis\n        .related_symbols\n        .iter()\n        .map(|symbol| ContextItem {\n            identity: StableIdentity::File(file_identity(workspace_id, &symbol.file)),\n            kind: \"related_symbol\".to_string(),\n            label: symbol.symbol.clone(),\n            file: Some(symbol.file.clone()),\n            summary: symbol.evidence.join(\"; \"),\n            inclusion_reason: symbol.evidence.join(\"; \"),\n        })\n        .collect()\n}\n\nfn prepare_change_hint(diagnosis: &FailureDiagnosis) -> Option<ExpansionHint> {\n    let suspect = diagnosis.suspects.first()?;\n    Some(ExpansionHint {\n        focus: suspect\n            .symbol_handle\n            .clone()\n            .unwrap_or_else(|| format!(\"symbol:{}\", suspect.symbol)),\n        reason: \"Use this suspect as the anchor for a prepare_change follow-up.\".to_string(),\n    })\n}\n","numLines":83,"startLine":1,"totalLines":83}}}
