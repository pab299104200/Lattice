{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JcoCf9itBHAzcmvcyePs6i","type":"tool_result","content":"1\t//! Workflow-outcome capture for Phase 8 MCP tools.\n2\t//!\n3\t//! Bound to `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## Phase 8: Workflow Engine V2`,\n5\t//! `## MCP Tool Contract Principles`,\n6\t//! `## Event Log`, and\n7\t//! `## Phase 2: Event Log Substrate`.\n8\t//!\n9\t//! \"Every workflow tool should record:\n10\t//!\n11\t//! - inputs\n12\t//! - resolved anchors\n13\t//! - selected candidates\n14\t//! - excluded high-scoring candidates where useful\n15\t//! - response summary\n16\t//! - downstream use events\"\n17\t\n18\tuse std::collections::{HashMap, HashSet};\n19\tuse std::sync::Mutex;\n20\tuse std::time::Instant;\n21\t\n22\tuse lattice_core::events::StableRef;\n23\tuse lattice_core::identity::{ContextHandleId, EventId, FileId, MemoryId, SymbolId};\n24\tuse serde_json::{json, Value};\n25\t\n26\tuse crate::rpc::event_capture::EventCapture;\n27\tuse crate::rpc::event_capture_support::{compact_text, memory_ids_from_value, parse_tool_payload};\n28\tuse crate::rpc::session_metrics::SessionMetrics;\n29\t\n30\t#[derive(Debug, Default)]\n31\tstruct RecorderState {\n32\t    handle_origins: HashMap<String, EventId>,\n33\t    memory_origins: HashMap<String, EventId>,\n34\t}\n35\t\n36\t#[derive(Debug, Clone)]\n37\tstruct PreparedOutcome {\n38\t    input_summary: String,\n39\t    resolved_anchors: Vec<StableRef>,\n40\t    selected_candidates: Vec<String>,\n41\t    excluded_candidates: Vec<String>,\n42\t    response_summary: String,\n43\t    downstream_references: Vec<StableRef>,\n44\t    output_handle: Option<String>,\n45\t    output_handle_id: Option<ContextHandleId>,\n46\t    output_memory_ids: Vec<MemoryId>,\n47\t    success: bool,\n48\t    retryable: bool,\n49\t    had_plan: bool,\n50\t    irrelevant_files_opened: usize,\n51\t}\n52\t\n53\t#[derive(Debug, Default)]\n54\tpub struct WorkflowOutcomeRecorder {\n55\t    state: Mutex<RecorderState>,\n56\t}\n57\t\n58\timpl WorkflowOutcomeRecorder {\n59\t    pub fn new() -> Self {\n60\t        Self::default()\n61\t    }\n62\t\n63\t    pub fn should_record(tool: &str) -> bool {\n64\t        matches!(\n65\t            tool,\n66\t            \"prepare_change\"\n67\t                | \"plan_edit\"\n68\t                | \"trace_scenario\"\n69\t                | \"diagnose_failure\"\n70\t                | \"get_context_capsule\"\n71\t                | \"get_docs_capsule\"\n72\t                | \"find_relevant_tests\"\n73\t                | \"impact_from_diff\"\n74\t                | \"expand_context\"\n75\t                | \"get_task_memory\"\n76\t                | \"save_memory\"\n77\t                | \"propose_memory_evolution\"\n78\t                | \"apply_memory_evolution\"\n79\t                | \"verify_explain_memory\"\n80\t                | \"verify_memory\"\n81\t                | \"explain_memory\"\n82\t                | \"list_memory_conflicts\"\n83\t                | \"consolidate_session\"\n84\t                | \"get_memory_metrics\"\n85\t                | \"record_workflow_outcome\"\n86\t        )\n87\t    }\n88\t\n89\t    pub fn record(\n90\t        &self,\n91\t        capture: &EventCapture,\n92\t        metrics: &mut SessionMetrics,\n93\t        tool: &str,\n94\t        arguments: &Value,\n95\t        result: &Result<Value, (i32, String)>,\n96\t        terminal_event: &EventId,\n97\t    ) -> Result<EventId, String> {\n98\t        let started_at = Instant::now();\n99\t        let prepared = self.prepare(tool, arguments, result)?;\n100\t        let summary = summarize_outcome(&prepared);\n101\t        tracing::info!(\n102\t            tool,\n103\t            task_id = capture\n104\t                .current_task_id()\n105\t                .as_ref()\n106\t                .map(|value| value.value.as_str())\n107\t                .unwrap_or(\"\"),\n108\t            session_id = capture.session_id().value.as_str(),\n109\t            outcome = if prepared.success { \"success\" } else { \"failure\" },\n110\t            excluded_count = prepared.excluded_candidates.len(),\n111\t            latency_ms = started_at.elapsed().as_millis() as u64,\n112\t            \"workflow outcome recorded\"\n113\t        );\n114\t        if prepared.had_plan {\n115\t            capture\n116\t                .record_plan_created(tool.to_string(), &[])\n117\t                .map_err(|error| error.to_string())?;\n118\t        }\n119\t        let event_id = capture\n120\t            .record_workflow_outcome_detailed(\n121\t                prepared.success,\n122\t                tool,\n123\t                &summary,\n124\t                std::slice::from_ref(terminal_event),\n125\t                &prepared\n126\t                    .resolved_anchors\n127\t                    .iter()\n128\t                    .chain(prepared.downstream_references.iter())\n129\t                    .cloned()\n130\t                    .collect::<Vec<_>>(),\n131\t                prepared.output_handle_id.clone(),\n132\t                &prepared.output_memory_ids,\n133\t                prepared.retryable,\n134\t            )\n135\t            .map_err(|error| error.to_string())?;\n136\t        self.remember_origins(&prepared, &event_id);\n137\t        metrics.record_workflow_outcome(\n138\t            prepared.success,\n139\t            prepared.had_plan,\n140\t            prepared.irrelevant_files_opened,\n141\t        );\n142\t        Ok(event_id)\n143\t    }\n144\t\n145\t    fn prepare(\n146\t        &self,\n147\t        tool: &str,\n148\t        arguments: &Value,\n149\t        result: &Result<Value, (i32, String)>,\n150\t    ) -> Result<PreparedOutcome, String> {\n151\t        let payload = result\n152\t            .as_ref()\n153\t            .ok()\n154\t            .and_then(parse_tool_payload);\n155\t        let success = result.is_ok();\n156\t        let output_memory_ids = payload\n157\t            .as_ref()\n158\t            .map(|value| memory_ids_from_value(value, &workspace_id(arguments, result)))\n159\t            .unwrap_or_default();\n160\t        let output_handle = payload\n161\t            .as_ref()\n162\t            .and_then(|value| value.get(\"context_handle\").and_then(Value::as_str))\n163\t            .map(ToString::to_string);\n164\t        let output_handle_id = payload\n165\t            .as_ref()\n166\t            .and_then(|value| value.get(\"context_handle_identity\"))\n167\t            .and_then(|value| value.get(\"fields\"))\n168\t            .cloned()\n169\t            .and_then(|value| serde_json::from_value(value).ok());\n170\t        let resolved_anchors = collect_resolved_anchors(arguments, payload.as_ref());\n171\t        let selected_candidates = collect_selected_candidates(tool, payload.as_ref());\n172\t        let excluded_candidates = collect_excluded_candidates(payload.as_ref(), &selected_candidates);\n173\t        let downstream_references = self.collect_downstream_references(arguments);\n174\t        let irrelevant_files_opened = excluded_candidates\n175\t            .iter()\n176\t            .filter(|candidate| candidate.contains('/'))\n177\t            .count();\n178\t        Ok(PreparedOutcome {\n179\t            input_summary: input_summary(tool, arguments, payload.as_ref()),\n180\t            resolved_anchors,\n181\t            selected_candidates,\n182\t            excluded_candidates,\n183\t            response_summary: response_summary(tool, payload.as_ref(), result),\n184\t            downstream_references,\n185\t            output_handle,\n186\t            output_handle_id,\n187\t            output_memory_ids,\n188\t            success,\n189\t            retryable: false,\n190\t            had_plan: matches!(\n191\t                tool,\n192\t                \"prepare_change\" | \"plan_edit\" | \"trace_scenario\" | \"diagnose_failure\"\n193\t            ),\n194\t            irrelevant_files_opened,\n195\t        })\n196\t    }\n197\t\n198\t    fn collect_downstream_references(&self, arguments: &Value) -> Vec<StableRef> {\n199\t        let mut refs = Vec::new();\n200\t        let state = match self.state.lock() {\n201\t            Ok(state) => state,\n202\t            Err(_) => return refs,\n203\t        };\n204\t        if let Some(handle) = arguments.get(\"handle\").and_then(Value::as_str) {\n205\t            if let Some(event_id) = state.handle_origins.get(handle) {\n206\t                refs.push(StableRef::EventRef(event_id.clone()));\n207\t            }\n208\t        }\n209\t        for memory_id in collect_argument_memory_ids(arguments) {\n210\t            if let Some(event_id) = state.memory_origins.get(&memory_id) {\n211\t                refs.push(StableRef::EventRef(event_id.clone()));\n212\t            }\n213\t        }\n214\t        refs\n215\t    }\n216\t\n217\t    fn remember_origins(&self, prepared: &PreparedOutcome, event_id: &EventId) {\n218\t        let Ok(mut state) = self.state.lock() else {\n219\t            return;\n220\t        };\n221\t        if let Some(handle) = prepared.output_handle.as_ref() {\n222\t            state.handle_origins.insert(handle.clone(), event_id.clone());\n223\t        }\n224\t        for memory_id in &prepared.output_memory_ids {\n225\t            state\n226\t                .memory_origins\n227\t                .insert(memory_id.ulid.clone(), event_id.clone());\n228\t        }\n229\t    }\n230\t}\n231\t\n232\tfn workspace_id(arguments: &Value, result: &Result<Value, (i32, String)>) -> String {\n233\t    arguments\n234\t        .get(\"workspace_id\")\n235\t        .and_then(Value::as_str)\n236\t        .map(ToString::to_string)\n237\t        .or_else(|| {\n238\t            result\n239\t                .as_ref()\n240\t                .ok()\n241\t                .and_then(parse_tool_payload)\n242\t                .as_ref()\n243\t                .and_then(|value| value.get(\"memory_id\"))\n244\t                .and_then(Value::as_object)\n245\t                .and_then(|value| value.get(\"workspace_id\"))\n246\t                .and_then(Value::as_str)\n247\t                .map(ToString::to_string)\n248\t        })\n249\t        .unwrap_or_default()\n250\t}\n251\t\n252\tfn input_summary(tool: &str, arguments: &Value, payload: Option<&Value>) -> String {\n253\t    payload\n254\t        .and_then(|value| value.get(\"workflow_record\"))\n255\t        .and_then(|value| value.get(\"input\"))\n256\t        .and_then(Value::as_str)\n257\t        .or_else(|| {\n258\t            [\"query\", \"scenario\", \"task\", \"focus\", \"content\", \"session_id\"]\n259\t                .iter()\n260\t                .find_map(|key| arguments.get(*key).and_then(Value::as_str))\n261\t        })\n262\t        .map(ToString::to_string)\n263\t        .unwrap_or_else(|| compact_text(&format!(\"{tool}:{}\", arguments), 220))\n264\t}\n265\t\n266\tfn response_summary(\n267\t    tool: &str,\n268\t    payload: Option<&Value>,\n269\t    result: &Result<Value, (i32, String)>,\n270\t) -> String {\n271\t    if let Some(payload) = payload {\n272\t        if let Some(overview) = payload.get(\"overview\").and_then(Value::as_str) {\n273\t            return overview.to_string();\n274\t        }\n275\t        if let Some(summary) = payload.get(\"summary_lines\").and_then(Value::as_array) {\n276\t            let joined = summary\n277\t                .iter()\n278\t                .filter_map(Value::as_str)\n279\t                .collect::<Vec<_>>()\n280\t                .join(\"; \");\n281\t            if !joined.is_empty() {\n282\t                return joined;\n283\t            }\n284\t        }\n285\t        if let Some(status) = payload.get(\"status\").and_then(Value::as_str) {\n286\t            return format!(\"{tool}:{status}\");\n287\t        }\n288\t    }\n289\t    match result {\n290\t        Ok(value) => compact_text(&value.to_string(), 260),\n291\t        Err((code, message)) => format!(\"error {code}: {}\", compact_text(message, 220)),\n292\t    }\n293\t}\n294\t\n295\tfn collect_resolved_anchors(arguments: &Value, payload: Option<&Value>) -> Vec<StableRef> {\n296\t    let mut refs = Vec::new();\n297\t    if let Some(items) = payload\n298\t        .and_then(|value| value.get(\"workflow_record\"))\n299\t        .and_then(|value| value.get(\"resolved_anchors\"))\n300\t        .and_then(Value::as_array)\n301\t    {\n302\t        refs.extend(items.iter().filter_map(stable_ref_from_identity));\n303\t    }\n304\t    refs.extend(parse_file_refs(arguments, \"entry_files\"));\n305\t    refs.extend(parse_symbol_refs(arguments, \"entry_symbols\"));\n306\t    dedupe_refs(refs)\n307\t}\n308\t\n309\tfn collect_selected_candidates(tool: &str, payload: Option<&Value>) -> Vec<String> {\n310\t    if let Some(candidates) = payload\n311\t        .and_then(|value| value.get(\"workflow_record\"))\n312\t        .and_then(|value| value.get(\"selected_candidates\"))\n313\t        .and_then(Value::as_array)\n314\t    {\n315\t        let selected: Vec<_> = candidates\n316\t            .iter()\n317\t            .filter_map(Value::as_str)\n318\t            .map(ToString::to_string)\n319\t            .collect();\n320\t        if !selected.is_empty() {\n321\t            return selected;\n322\t        }\n323\t    }\n324\t    match tool {\n325\t        \"save_memory\" => payload\n326\t            .and_then(|value| value.get(\"memory_id\"))\n327\t            .and_then(Value::as_str)\n328\t            .map(|value| vec![format!(\"memory:{value}\")])\n329\t            .unwrap_or_default(),\n330\t        \"verify_explain_memory\" | \"verify_memory\" | \"explain_memory\" => payload\n331\t            .and_then(|value| value.get(\"status\"))\n332\t            .and_then(Value::as_str)\n333\t            .map(|value| vec![format!(\"verification:{value}\")])\n334\t            .unwrap_or_default(),\n335\t        _ => Vec::new(),\n336\t    }\n337\t}\n338\t\n339\tfn collect_excluded_candidates(\n340\t    payload: Option<&Value>,\n341\t    selected_candidates: &[String],\n342\t) -> Vec<String> {\n343\t    if let Some(candidates) = payload\n344\t        .and_then(|value| value.get(\"workflow_record\"))\n345\t        .and_then(|value| value.get(\"excluded_high_scoring_candidates\"))\n346\t        .and_then(Value::as_array)\n347\t    {\n348\t        let excluded: Vec<_> = candidates\n349\t            .iter()\n350\t            .filter_map(Value::as_str)\n351\t            .map(ToString::to_string)\n352\t            .collect();\n353\t        if !excluded.is_empty() {\n354\t            return excluded;\n355\t        }\n356\t    }\n357\t    let selected: HashSet<_> = selected_candidates.iter().cloned().collect();\n358\t    payload\n359\t        .and_then(|value| value.get(\"ranked_pivots\"))\n360\t        .and_then(Value::as_array)\n361\t        .map(|items| {\n362\t            items.iter()\n363\t                .filter_map(|item| {\n364\t                    let file = item.get(\"file\").and_then(Value::as_str)?;\n365\t                    if selected.contains(file) {\n366\t                        return None;\n367\t                    }\n368\t                    Some(format!(\"{file} rejected: ranked pivot was not selected for the compact result\"))\n369\t                })\n370\t                .take(3)\n371\t                .collect()\n372\t        })\n373\t        .unwrap_or_default()\n374\t}\n375\t\n376\tfn parse_file_refs(arguments: &Value, key: &str) -> Vec<StableRef> {\n377\t    arguments\n378\t        .get(key)\n379\t        .and_then(Value::as_array)\n380\t        .into_iter()\n381\t        .flatten()\n382\t        .filter_map(Value::as_str)\n383\t        .map(|file| {\n384\t            StableRef::FileRef(FileId {\n385\t                workspace_id: \"workspace\".to_string(),\n386\t                repo_relative_path: file.to_string(),\n387\t                content_hash: \"unknown\".to_string(),\n388\t            })\n389\t        })\n390\t        .collect()\n391\t}\n392\t\n393\tfn parse_symbol_refs(arguments: &Value, key: &str) -> Vec<StableRef> {\n394\t    arguments\n395\t        .get(key)\n396\t        .and_then(Value::as_array)\n397\t        .into_iter()\n398\t        .flatten()\n399\t        .filter_map(Value::as_str)\n400\t        .map(|symbol| {\n401\t            StableRef::SymbolRef(SymbolId {\n402\t                file: FileId {\n403\t                    workspace_id: \"workspace\".to_string(),\n404\t                    repo_relative_path: String::new(),\n405\t                    content_hash: \"unknown\".to_string(),\n406\t                },\n407\t                qualified_name: symbol.to_string(),\n408\t                byte_offset: 0,\n409\t                kind: \"symbol\".to_string(),\n410\t            })\n411\t        })\n412\t        .collect()\n413\t}\n414\t\n415\tfn stable_ref_from_identity(value: &Value) -> Option<StableRef> {\n416\t    let kind = value.get(\"kind\")?.as_str()?;\n417\t    let encoded = value.get(\"value\")?;\n418\t    match kind {\n419\t        \"File\" => serde_json::from_value::<FileId>(encoded.clone())\n420\t            .ok()\n421\t            .map(StableRef::FileRef),\n422\t        \"Symbol\" => serde_json::from_value::<SymbolId>(encoded.clone())\n423\t            .ok()\n424\t            .map(StableRef::SymbolRef),\n425\t        \"Memory\" => serde_json::from_value::<MemoryId>(encoded.clone())\n426\t            .ok()\n427\t            .map(StableRef::MemoryRef),\n428\t        \"Event\" => serde_json::from_value::<EventId>(encoded.clone())\n429\t            .ok()\n430\t            .map(StableRef::EventRef),\n431\t        \"ContextHandle\" => serde_json::from_value::<ContextHandleId>(encoded.clone())\n432\t            .ok()\n433\t            .map(StableRef::ContextHandleRef),\n434\t        _ => None,\n435\t    }\n436\t}\n437\t\n438\tfn collect_argument_memory_ids(arguments: &Value) -> Vec<String> {\n439\t    let mut ids = Vec::new();\n440\t    collect_argument_memory_ids_inner(arguments, &mut ids);\n441\t    ids.sort();\n442\t    ids.dedup();\n443\t    ids\n444\t}\n445\t\n446\tfn collect_argument_memory_ids_inner(value: &Value, ids: &mut Vec<String>) {\n447\t    match value {\n448\t        Value::Object(object) => {\n449\t            if let Some(id) = object.get(\"memory_id\") {\n450\t                if let Some(value) = id.as_str() {\n451\t                    ids.push(value.to_string());\n452\t                } else if let Some(ulid) = id.get(\"ulid\").and_then(Value::as_str) {\n453\t                    ids.push(ulid.to_string());\n454\t                }\n455\t            }\n456\t            for key in [\"linked_memories\", \"memory_ids\"] {\n457\t                if let Some(items) = object.get(key).and_then(Value::as_array) {\n458\t                    ids.extend(items.iter().filter_map(Value::as_str).map(ToString::to_string));\n459\t                }\n460\t            }\n461\t            for child in object.values() {\n462\t                collect_argument_memory_ids_inner(child, ids);\n463\t            }\n464\t        }\n465\t        Value::Array(items) => {\n466\t            for child in items {\n467\t                collect_argument_memory_ids_inner(child, ids);\n468\t            }\n469\t        }\n470\t        _ => {}\n471\t    }\n472\t}\n473\t\n474\tfn dedupe_refs(items: Vec<StableRef>) -> Vec<StableRef> {\n475\t    let mut deduped = Vec::new();\n476\t    let mut seen = HashSet::new();\n477\t    for item in items {\n478\t        let key = format!(\"{item:?}\");\n479\t        if seen.insert(key) {\n480\t            deduped.push(item);\n481\t        }\n482\t    }\n483\t    deduped\n484\t}\n485\t\n486\tfn summarize_outcome(prepared: &PreparedOutcome) -> String {\n487\t    json!({\n488\t        \"input\": compact_text(&prepared.input_summary, 180),\n489\t        \"anchors\": prepared\n490\t            .resolved_anchors\n491\t            .iter()\n492\t            .map(|item| format!(\"{item:?}\"))\n493\t            .collect::<Vec<_>>(),\n494\t        \"selected\": prepared.selected_candidates,\n495\t        \"excluded\": prepared.excluded_candidates,\n496\t        \"summary\": compact_text(&prepared.response_summary, 220),\n497\t        \"downstream_use_events\": prepared\n498\t            .downstream_references\n499\t            .iter()\n500\t            .filter_map(|item| match item {\n501\t                StableRef::EventRef(event_id) => Some(event_id.ulid.clone()),\n502\t                _ => None,\n503\t            })\n504\t            .collect::<Vec<_>>(),\n505\t    })\n506\t    .to_string()\n507\t}\n508\t"}]},"parent_tool_use_id":null,"session_id":"589d9a30-530c-4e7c-8151-20cc70f1285a","uuid":"07123817-fdfc-44ba-8030-9f3a010d5128","timestamp":"2026-05-17T14:41:37.219Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/workflow_v2/outcome_capture.rs","content":"//! Workflow-outcome capture for Phase 8 MCP tools.\n//!\n//! Bound to `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 8: Workflow Engine V2`,\n//! `## MCP Tool Contract Principles`,\n//! `## Event Log`, and\n//! `## Phase 2: Event Log Substrate`.\n//!\n//! \"Every workflow tool should record:\n//!\n//! - inputs\n//! - resolved anchors\n//! - selected candidates\n//! - excluded high-scoring candidates where useful\n//! - response summary\n//! - downstream use events\"\n\nuse std::collections::{HashMap, HashSet};\nuse std::sync::Mutex;\nuse std::time::Instant;\n\nuse lattice_core::events::StableRef;\nuse lattice_core::identity::{ContextHandleId, EventId, FileId, MemoryId, SymbolId};\nuse serde_json::{json, Value};\n\nuse crate::rpc::event_capture::EventCapture;\nuse crate::rpc::event_capture_support::{compact_text, memory_ids_from_value, parse_tool_payload};\nuse crate::rpc::session_metrics::SessionMetrics;\n\n#[derive(Debug, Default)]\nstruct RecorderState {\n    handle_origins: HashMap<String, EventId>,\n    memory_origins: HashMap<String, EventId>,\n}\n\n#[derive(Debug, Clone)]\nstruct PreparedOutcome {\n    input_summary: String,\n    resolved_anchors: Vec<StableRef>,\n    selected_candidates: Vec<String>,\n    excluded_candidates: Vec<String>,\n    response_summary: String,\n    downstream_references: Vec<StableRef>,\n    output_handle: Option<String>,\n    output_handle_id: Option<ContextHandleId>,\n    output_memory_ids: Vec<MemoryId>,\n    success: bool,\n    retryable: bool,\n    had_plan: bool,\n    irrelevant_files_opened: usize,\n}\n\n#[derive(Debug, Default)]\npub struct WorkflowOutcomeRecorder {\n    state: Mutex<RecorderState>,\n}\n\nimpl WorkflowOutcomeRecorder {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    pub fn should_record(tool: &str) -> bool {\n        matches!(\n            tool,\n            \"prepare_change\"\n                | \"plan_edit\"\n                | \"trace_scenario\"\n                | \"diagnose_failure\"\n                | \"get_context_capsule\"\n                | \"get_docs_capsule\"\n                | \"find_relevant_tests\"\n                | \"impact_from_diff\"\n                | \"expand_context\"\n                | \"get_task_memory\"\n                | \"save_memory\"\n                | \"propose_memory_evolution\"\n                | \"apply_memory_evolution\"\n                | \"verify_explain_memory\"\n                | \"verify_memory\"\n                | \"explain_memory\"\n                | \"list_memory_conflicts\"\n                | \"consolidate_session\"\n                | \"get_memory_metrics\"\n                | \"record_workflow_outcome\"\n        )\n    }\n\n    pub fn record(\n        &self,\n        capture: &EventCapture,\n        metrics: &mut SessionMetrics,\n        tool: &str,\n        arguments: &Value,\n        result: &Result<Value, (i32, String)>,\n        terminal_event: &EventId,\n    ) -> Result<EventId, String> {\n        let started_at = Instant::now();\n        let prepared = self.prepare(tool, arguments, result)?;\n        let summary = summarize_outcome(&prepared);\n        tracing::info!(\n            tool,\n            task_id = capture\n                .current_task_id()\n                .as_ref()\n                .map(|value| value.value.as_str())\n                .unwrap_or(\"\"),\n            session_id = capture.session_id().value.as_str(),\n            outcome = if prepared.success { \"success\" } else { \"failure\" },\n            excluded_count = prepared.excluded_candidates.len(),\n            latency_ms = started_at.elapsed().as_millis() as u64,\n            \"workflow outcome recorded\"\n        );\n        if prepared.had_plan {\n            capture\n                .record_plan_created(tool.to_string(), &[])\n                .map_err(|error| error.to_string())?;\n        }\n        let event_id = capture\n            .record_workflow_outcome_detailed(\n                prepared.success,\n                tool,\n                &summary,\n                std::slice::from_ref(terminal_event),\n                &prepared\n                    .resolved_anchors\n                    .iter()\n                    .chain(prepared.downstream_references.iter())\n                    .cloned()\n                    .collect::<Vec<_>>(),\n                prepared.output_handle_id.clone(),\n                &prepared.output_memory_ids,\n                prepared.retryable,\n            )\n            .map_err(|error| error.to_string())?;\n        self.remember_origins(&prepared, &event_id);\n        metrics.record_workflow_outcome(\n            prepared.success,\n            prepared.had_plan,\n            prepared.irrelevant_files_opened,\n        );\n        Ok(event_id)\n    }\n\n    fn prepare(\n        &self,\n        tool: &str,\n        arguments: &Value,\n        result: &Result<Value, (i32, String)>,\n    ) -> Result<PreparedOutcome, String> {\n        let payload = result\n            .as_ref()\n            .ok()\n            .and_then(parse_tool_payload);\n        let success = result.is_ok();\n        let output_memory_ids = payload\n            .as_ref()\n            .map(|value| memory_ids_from_value(value, &workspace_id(arguments, result)))\n            .unwrap_or_default();\n        let output_handle = payload\n            .as_ref()\n            .and_then(|value| value.get(\"context_handle\").and_then(Value::as_str))\n            .map(ToString::to_string);\n        let output_handle_id = payload\n            .as_ref()\n            .and_then(|value| value.get(\"context_handle_identity\"))\n            .and_then(|value| value.get(\"fields\"))\n            .cloned()\n            .and_then(|value| serde_json::from_value(value).ok());\n        let resolved_anchors = collect_resolved_anchors(arguments, payload.as_ref());\n        let selected_candidates = collect_selected_candidates(tool, payload.as_ref());\n        let excluded_candidates = collect_excluded_candidates(payload.as_ref(), &selected_candidates);\n        let downstream_references = self.collect_downstream_references(arguments);\n        let irrelevant_files_opened = excluded_candidates\n            .iter()\n            .filter(|candidate| candidate.contains('/'))\n            .count();\n        Ok(PreparedOutcome {\n            input_summary: input_summary(tool, arguments, payload.as_ref()),\n            resolved_anchors,\n            selected_candidates,\n            excluded_candidates,\n            response_summary: response_summary(tool, payload.as_ref(), result),\n            downstream_references,\n            output_handle,\n            output_handle_id,\n            output_memory_ids,\n            success,\n            retryable: false,\n            had_plan: matches!(\n                tool,\n                \"prepare_change\" | \"plan_edit\" | \"trace_scenario\" | \"diagnose_failure\"\n            ),\n            irrelevant_files_opened,\n        })\n    }\n\n    fn collect_downstream_references(&self, arguments: &Value) -> Vec<StableRef> {\n        let mut refs = Vec::new();\n        let state = match self.state.lock() {\n            Ok(state) => state,\n            Err(_) => return refs,\n        };\n        if let Some(handle) = arguments.get(\"handle\").and_then(Value::as_str) {\n            if let Some(event_id) = state.handle_origins.get(handle) {\n                refs.push(StableRef::EventRef(event_id.clone()));\n            }\n        }\n        for memory_id in collect_argument_memory_ids(arguments) {\n            if let Some(event_id) = state.memory_origins.get(&memory_id) {\n                refs.push(StableRef::EventRef(event_id.clone()));\n            }\n        }\n        refs\n    }\n\n    fn remember_origins(&self, prepared: &PreparedOutcome, event_id: &EventId) {\n        let Ok(mut state) = self.state.lock() else {\n            return;\n        };\n        if let Some(handle) = prepared.output_handle.as_ref() {\n            state.handle_origins.insert(handle.clone(), event_id.clone());\n        }\n        for memory_id in &prepared.output_memory_ids {\n            state\n                .memory_origins\n                .insert(memory_id.ulid.clone(), event_id.clone());\n        }\n    }\n}\n\nfn workspace_id(arguments: &Value, result: &Result<Value, (i32, String)>) -> String {\n    arguments\n        .get(\"workspace_id\")\n        .and_then(Value::as_str)\n        .map(ToString::to_string)\n        .or_else(|| {\n            result\n                .as_ref()\n                .ok()\n                .and_then(parse_tool_payload)\n                .as_ref()\n                .and_then(|value| value.get(\"memory_id\"))\n                .and_then(Value::as_object)\n                .and_then(|value| value.get(\"workspace_id\"))\n                .and_then(Value::as_str)\n                .map(ToString::to_string)\n        })\n        .unwrap_or_default()\n}\n\nfn input_summary(tool: &str, arguments: &Value, payload: Option<&Value>) -> String {\n    payload\n        .and_then(|value| value.get(\"workflow_record\"))\n        .and_then(|value| value.get(\"input\"))\n        .and_then(Value::as_str)\n        .or_else(|| {\n            [\"query\", \"scenario\", \"task\", \"focus\", \"content\", \"session_id\"]\n                .iter()\n                .find_map(|key| arguments.get(*key).and_then(Value::as_str))\n        })\n        .map(ToString::to_string)\n        .unwrap_or_else(|| compact_text(&format!(\"{tool}:{}\", arguments), 220))\n}\n\nfn response_summary(\n    tool: &str,\n    payload: Option<&Value>,\n    result: &Result<Value, (i32, String)>,\n) -> String {\n    if let Some(payload) = payload {\n        if let Some(overview) = payload.get(\"overview\").and_then(Value::as_str) {\n            return overview.to_string();\n        }\n        if let Some(summary) = payload.get(\"summary_lines\").and_then(Value::as_array) {\n            let joined = summary\n                .iter()\n                .filter_map(Value::as_str)\n                .collect::<Vec<_>>()\n                .join(\"; \");\n            if !joined.is_empty() {\n                return joined;\n            }\n        }\n        if let Some(status) = payload.get(\"status\").and_then(Value::as_str) {\n            return format!(\"{tool}:{status}\");\n        }\n    }\n    match result {\n        Ok(value) => compact_text(&value.to_string(), 260),\n        Err((code, message)) => format!(\"error {code}: {}\", compact_text(message, 220)),\n    }\n}\n\nfn collect_resolved_anchors(arguments: &Value, payload: Option<&Value>) -> Vec<StableRef> {\n    let mut refs = Vec::new();\n    if let Some(items) = payload\n        .and_then(|value| value.get(\"workflow_record\"))\n        .and_then(|value| value.get(\"resolved_anchors\"))\n        .and_then(Value::as_array)\n    {\n        refs.extend(items.iter().filter_map(stable_ref_from_identity));\n    }\n    refs.extend(parse_file_refs(arguments, \"entry_files\"));\n    refs.extend(parse_symbol_refs(arguments, \"entry_symbols\"));\n    dedupe_refs(refs)\n}\n\nfn collect_selected_candidates(tool: &str, payload: Option<&Value>) -> Vec<String> {\n    if let Some(candidates) = payload\n        .and_then(|value| value.get(\"workflow_record\"))\n        .and_then(|value| value.get(\"selected_candidates\"))\n        .and_then(Value::as_array)\n    {\n        let selected: Vec<_> = candidates\n            .iter()\n            .filter_map(Value::as_str)\n            .map(ToString::to_string)\n            .collect();\n        if !selected.is_empty() {\n            return selected;\n        }\n    }\n    match tool {\n        \"save_memory\" => payload\n            .and_then(|value| value.get(\"memory_id\"))\n            .and_then(Value::as_str)\n            .map(|value| vec![format!(\"memory:{value}\")])\n            .unwrap_or_default(),\n        \"verify_explain_memory\" | \"verify_memory\" | \"explain_memory\" => payload\n            .and_then(|value| value.get(\"status\"))\n            .and_then(Value::as_str)\n            .map(|value| vec![format!(\"verification:{value}\")])\n            .unwrap_or_default(),\n        _ => Vec::new(),\n    }\n}\n\nfn collect_excluded_candidates(\n    payload: Option<&Value>,\n    selected_candidates: &[String],\n) -> Vec<String> {\n    if let Some(candidates) = payload\n        .and_then(|value| value.get(\"workflow_record\"))\n        .and_then(|value| value.get(\"excluded_high_scoring_candidates\"))\n        .and_then(Value::as_array)\n    {\n        let excluded: Vec<_> = candidates\n            .iter()\n            .filter_map(Value::as_str)\n            .map(ToString::to_string)\n            .collect();\n        if !excluded.is_empty() {\n            return excluded;\n        }\n    }\n    let selected: HashSet<_> = selected_candidates.iter().cloned().collect();\n    payload\n        .and_then(|value| value.get(\"ranked_pivots\"))\n        .and_then(Value::as_array)\n        .map(|items| {\n            items.iter()\n                .filter_map(|item| {\n                    let file = item.get(\"file\").and_then(Value::as_str)?;\n                    if selected.contains(file) {\n                        return None;\n                    }\n                    Some(format!(\"{file} rejected: ranked pivot was not selected for the compact result\"))\n                })\n                .take(3)\n                .collect()\n        })\n        .unwrap_or_default()\n}\n\nfn parse_file_refs(arguments: &Value, key: &str) -> Vec<StableRef> {\n    arguments\n        .get(key)\n        .and_then(Value::as_array)\n        .into_iter()\n        .flatten()\n        .filter_map(Value::as_str)\n        .map(|file| {\n            StableRef::FileRef(FileId {\n                workspace_id: \"workspace\".to_string(),\n                repo_relative_path: file.to_string(),\n                content_hash: \"unknown\".to_string(),\n            })\n        })\n        .collect()\n}\n\nfn parse_symbol_refs(arguments: &Value, key: &str) -> Vec<StableRef> {\n    arguments\n        .get(key)\n        .and_then(Value::as_array)\n        .into_iter()\n        .flatten()\n        .filter_map(Value::as_str)\n        .map(|symbol| {\n            StableRef::SymbolRef(SymbolId {\n                file: FileId {\n                    workspace_id: \"workspace\".to_string(),\n                    repo_relative_path: String::new(),\n                    content_hash: \"unknown\".to_string(),\n                },\n                qualified_name: symbol.to_string(),\n                byte_offset: 0,\n                kind: \"symbol\".to_string(),\n            })\n        })\n        .collect()\n}\n\nfn stable_ref_from_identity(value: &Value) -> Option<StableRef> {\n    let kind = value.get(\"kind\")?.as_str()?;\n    let encoded = value.get(\"value\")?;\n    match kind {\n        \"File\" => serde_json::from_value::<FileId>(encoded.clone())\n            .ok()\n            .map(StableRef::FileRef),\n        \"Symbol\" => serde_json::from_value::<SymbolId>(encoded.clone())\n            .ok()\n            .map(StableRef::SymbolRef),\n        \"Memory\" => serde_json::from_value::<MemoryId>(encoded.clone())\n            .ok()\n            .map(StableRef::MemoryRef),\n        \"Event\" => serde_json::from_value::<EventId>(encoded.clone())\n            .ok()\n            .map(StableRef::EventRef),\n        \"ContextHandle\" => serde_json::from_value::<ContextHandleId>(encoded.clone())\n            .ok()\n            .map(StableRef::ContextHandleRef),\n        _ => None,\n    }\n}\n\nfn collect_argument_memory_ids(arguments: &Value) -> Vec<String> {\n    let mut ids = Vec::new();\n    collect_argument_memory_ids_inner(arguments, &mut ids);\n    ids.sort();\n    ids.dedup();\n    ids\n}\n\nfn collect_argument_memory_ids_inner(value: &Value, ids: &mut Vec<String>) {\n    match value {\n        Value::Object(object) => {\n            if let Some(id) = object.get(\"memory_id\") {\n                if let Some(value) = id.as_str() {\n                    ids.push(value.to_string());\n                } else if let Some(ulid) = id.get(\"ulid\").and_then(Value::as_str) {\n                    ids.push(ulid.to_string());\n                }\n            }\n            for key in [\"linked_memories\", \"memory_ids\"] {\n                if let Some(items) = object.get(key).and_then(Value::as_array) {\n                    ids.extend(items.iter().filter_map(Value::as_str).map(ToString::to_string));\n                }\n            }\n            for child in object.values() {\n                collect_argument_memory_ids_inner(child, ids);\n            }\n        }\n        Value::Array(items) => {\n            for child in items {\n                collect_argument_memory_ids_inner(child, ids);\n            }\n        }\n        _ => {}\n    }\n}\n\nfn dedupe_refs(items: Vec<StableRef>) -> Vec<StableRef> {\n    let mut deduped = Vec::new();\n    let mut seen = HashSet::new();\n    for item in items {\n        let key = format!(\"{item:?}\");\n        if seen.insert(key) {\n            deduped.push(item);\n        }\n    }\n    deduped\n}\n\nfn summarize_outcome(prepared: &PreparedOutcome) -> String {\n    json!({\n        \"input\": compact_text(&prepared.input_summary, 180),\n        \"anchors\": prepared\n            .resolved_anchors\n            .iter()\n            .map(|item| format!(\"{item:?}\"))\n            .collect::<Vec<_>>(),\n        \"selected\": prepared.selected_candidates,\n        \"excluded\": prepared.excluded_candidates,\n        \"summary\": compact_text(&prepared.response_summary, 220),\n        \"downstream_use_events\": prepared\n            .downstream_references\n            .iter()\n            .filter_map(|item| match item {\n                StableRef::EventRef(event_id) => Some(event_id.ulid.clone()),\n                _ => None,\n            })\n            .collect::<Vec<_>>(),\n    })\n    .to_string()\n}\n","numLines":508,"startLine":1,"totalLines":508}}}
