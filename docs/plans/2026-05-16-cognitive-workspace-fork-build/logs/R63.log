ok\"\n\"name\": \"get_session_context\"\n\"name\": \"get_session_metrics\"\n\"name\": \"get_skeleton\"\n\"name\": \"get_symbol\"\n\"name\": \"get_working_set_context\"\n\"name\": \"impact_from_diff\"\n\"name\": \"index_status\"\n\"name\": \"lattice\"\n\"name\": \"list_observations\"\n\"name\": \"list_stale_memories\"\n\"name\": \"plan_edit\"\n\"name\": \"prepare_change\"\n\"name\": \"promote_observation\"\n\"name\": \"record_workflow_outcome\"\n\"name\": \"refresh_memory\"\n\"name\": \"save_observation\"\n\"name\": \"search_logic_flow\"\n\"name\": \"search_memory\"\n\"name\": \"search_symbols\"\n\"name\": \"submit_lsp_edges\"\n\"name\": \"summarize_subsystem\"\n\"name\": \"trace_scenario\"\n\"name\": \"update_observation\"\n\"name\": \"workspace_setup\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
