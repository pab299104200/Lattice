+#[allow(dead_code)]
+fn file_id(path: &str) -> FileId {
+    FileId {
+        workspace_id: "workspace-main".to_string(),
+        repo_relative_path: path.to_string(),
+        content_hash: "abcdef12".to_string(),
+    }
+}
