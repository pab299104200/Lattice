+    pub(crate) fn runtime(&self, max_queue_depth: usize) -> ConsolidationJobRuntime {
+        ConsolidationJobRuntime::new(
+            self.conn(),
+            ConsolidationConfig {
+                max_queue_depth,
+                llm_budget_catalog: None,
+            },
+        )
+        .expect("runtime opens")
+    }
