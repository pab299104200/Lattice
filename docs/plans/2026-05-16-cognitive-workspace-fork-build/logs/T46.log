+    }
+
+    pub(crate) fn memory_count(&self) -> usize {
+        self.memory_store.list_all().expect("memories list").len()
+    }
+
+    pub(crate) fn structured_fields(&self, memory_id: &str) -> MemoryStructuredFields {
+        self.memory_store
+            .get_structured_fields(memory_id)
+            .expect("fields load")
