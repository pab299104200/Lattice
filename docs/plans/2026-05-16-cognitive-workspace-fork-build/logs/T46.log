+    fn replay_driver<'a>(&'a self, conn: &'a Connection) -> ReplayDriver<'a> {
+        ReplayDriver::new(
+            &self.event_reader,
+            self.event_store.clone(),
+            conn,
+            &self.memory_store,
+            &self.event_writer,
+            &self.clock,
+        )
+    }
