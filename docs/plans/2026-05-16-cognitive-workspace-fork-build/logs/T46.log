+    pub(crate) fn reverse_proposal(&self, proposal_id: &str) -> ReverseOutcome {
+        let conn = self.conn();
+        self.replay_driver(&conn)
+            .reverse(proposal_id)
+            .expect("reverse succeeds")
+    }
