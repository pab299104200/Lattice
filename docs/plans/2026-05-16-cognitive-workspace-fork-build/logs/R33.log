{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EJQD8RdJCQtz2kCtBsMVg4","type":"tool_result","content":"1\tuse crate::retrieval_v1::{classify_intent, IntentLabel};\n2\t\n3\tuse super::capsule::QueryIntent;\n4\t\n5\t/// Per-intent tuning parameters.\n6\t#[derive(Debug, Clone)]\n7\tpub struct IntentParams {\n8\t    /// Number of top-k semantic search results.\n9\t    pub semantic_k: usize,\n10\t    /// Number of graph hops from semantic hits.\n11\t    pub hop_depth: usize,\n12\t    /// Weight for semantic similarity in ranking.\n13\t    pub w_semantic: f64,\n14\t    /// Weight for centrality in ranking.\n15\t    pub w_centrality: f64,\n16\t    /// Weight for recency in ranking.\n17\t    pub w_recency: f64,\n18\t    /// Weight for caller count in ranking.\n19\t    pub w_caller: f64,\n20\t    /// Base token budget for the capsule.\n21\t    pub base_token_budget: usize,\n22\t}\n23\t\n24\timpl IntentParams {\n25\t    /// Get tuning parameters for a given intent.\n26\t    pub fn for_intent(intent: QueryIntent) -> Self {\n27\t        match intent {\n28\t            QueryIntent::Explore => IntentParams {\n29\t                semantic_k: 25,\n30\t                hop_depth: 2,\n31\t                w_semantic: 0.4,\n32\t                w_centrality: 0.3,\n33\t                w_recency: 0.1,\n34\t                w_caller: 0.2,\n35\t                base_token_budget: 4000,\n36\t            },\n37\t            QueryIntent::FixBug => IntentParams {\n38\t                semantic_k: 8,\n39\t                hop_depth: 3,\n40\t                w_semantic: 0.5,\n41\t                w_centrality: 0.2,\n42\t                w_recency: 0.2,\n43\t                w_caller: 0.1,\n44\t                base_token_budget: 4000,\n45\t            },\n46\t            QueryIntent::Refactor => IntentParams {\n47\t                semantic_k: 12,\n48\t                hop_depth: 2,\n49\t                w_semantic: 0.3,\n50\t                w_centrality: 0.4,\n51\t                w_recency: 0.1,\n52\t                w_caller: 0.2,\n53\t                base_token_budget: 4000,\n54\t            },\n55\t            QueryIntent::AddFeature => IntentParams {\n56\t                semantic_k: 10,\n57\t                hop_depth: 2,\n58\t                w_semantic: 0.4,\n59\t                w_centrality: 0.3,\n60\t                w_recency: 0.1,\n61\t                w_caller: 0.2,\n62\t                base_token_budget: 4000,\n63\t            },\n64\t            QueryIntent::Unknown => IntentParams {\n65\t                semantic_k: 8,\n66\t                hop_depth: 2,\n67\t                w_semantic: 0.4,\n68\t                w_centrality: 0.3,\n69\t                w_recency: 0.1,\n70\t                w_caller: 0.2,\n71\t                base_token_budget: 4000,\n72\t            },\n73\t        }\n74\t    }\n75\t}\n76\t\n77\t/// Detect the intent of a query based on keyword matching.\n78\t/// Returns the intent with the highest keyword match count.\n79\t/// Falls back to Explore for keyword-heavy queries (4+ content words) since\n80\t/// a long descriptive phrase without action verbs indicates understanding intent.\n81\t/// Only returns Unknown for very short ambiguous queries.\n82\tpub fn detect_intent(query: &str) -> QueryIntent {\n83\t    let classification = classify_intent(query);\n84\t    map_label_to_query_intent(classification.primary_label)\n85\t}\n86\t\n87\tfn map_label_to_query_intent(label: IntentLabel) -> QueryIntent {\n88\t    match label {\n89\t        IntentLabel::Debug\n90\t        | IntentLabel::AddTest\n91\t        | IntentLabel::Migration\n92\t        | IntentLabel::Performance => QueryIntent::FixBug,\n93\t        IntentLabel::Refactor | IntentLabel::Review => QueryIntent::Refactor,\n94\t        IntentLabel::Explain | IntentLabel::UpdateDocs => QueryIntent::Explore,\n95\t        IntentLabel::AddFeature | IntentLabel::ModifyFeature => QueryIntent::AddFeature,\n96\t        IntentLabel::Unknown => QueryIntent::Unknown,\n97\t    }\n98\t}\n99\t"}]},"parent_tool_use_id":null,"session_id":"6bc825b2-855a-40f4-bda9-b6466b178977","uuid":"6c5c17ed-b9a6-4eba-9a22-6c9b57e2d408","timestamp":"2026-05-17T09:15:17.141Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/query/intent.rs","content":"use crate::retrieval_v1::{classify_intent, IntentLabel};\n\nuse super::capsule::QueryIntent;\n\n/// Per-intent tuning parameters.\n#[derive(Debug, Clone)]\npub struct IntentParams {\n    /// Number of top-k semantic search results.\n    pub semantic_k: usize,\n    /// Number of graph hops from semantic hits.\n    pub hop_depth: usize,\n    /// Weight for semantic similarity in ranking.\n    pub w_semantic: f64,\n    /// Weight for centrality in ranking.\n    pub w_centrality: f64,\n    /// Weight for recency in ranking.\n    pub w_recency: f64,\n    /// Weight for caller count in ranking.\n    pub w_caller: f64,\n    /// Base token budget for the capsule.\n    pub base_token_budget: usize,\n}\n\nimpl IntentParams {\n    /// Get tuning parameters for a given intent.\n    pub fn for_intent(intent: QueryIntent) -> Self {\n        match intent {\n            QueryIntent::Explore => IntentParams {\n                semantic_k: 25,\n                hop_depth: 2,\n                w_semantic: 0.4,\n                w_centrality: 0.3,\n                w_recency: 0.1,\n                w_caller: 0.2,\n                base_token_budget: 4000,\n            },\n            QueryIntent::FixBug => IntentParams {\n                semantic_k: 8,\n                hop_depth: 3,\n                w_semantic: 0.5,\n                w_centrality: 0.2,\n                w_recency: 0.2,\n                w_caller: 0.1,\n                base_token_budget: 4000,\n            },\n            QueryIntent::Refactor => IntentParams {\n                semantic_k: 12,\n                hop_depth: 2,\n                w_semantic: 0.3,\n                w_centrality: 0.4,\n                w_recency: 0.1,\n                w_caller: 0.2,\n                base_token_budget: 4000,\n            },\n            QueryIntent::AddFeature => IntentParams {\n                semantic_k: 10,\n                hop_depth: 2,\n                w_semantic: 0.4,\n                w_centrality: 0.3,\n                w_recency: 0.1,\n                w_caller: 0.2,\n                base_token_budget: 4000,\n            },\n            QueryIntent::Unknown => IntentParams {\n                semantic_k: 8,\n                hop_depth: 2,\n                w_semantic: 0.4,\n                w_centrality: 0.3,\n                w_recency: 0.1,\n                w_caller: 0.2,\n                base_token_budget: 4000,\n            },\n        }\n    }\n}\n\n/// Detect the intent of a query based on keyword matching.\n/// Returns the intent with the highest keyword match count.\n/// Falls back to Explore for keyword-heavy queries (4+ content words) since\n/// a long descriptive phrase without action verbs indicates understanding intent.\n/// Only returns Unknown for very short ambiguous queries.\npub fn detect_intent(query: &str) -> QueryIntent {\n    let classification = classify_intent(query);\n    map_label_to_query_intent(classification.primary_label)\n}\n\nfn map_label_to_query_intent(label: IntentLabel) -> QueryIntent {\n    match label {\n        IntentLabel::Debug\n        | IntentLabel::AddTest\n        | IntentLabel::Migration\n        | IntentLabel::Performance => QueryIntent::FixBug,\n        IntentLabel::Refactor | IntentLabel::Review => QueryIntent::Refactor,\n        IntentLabel::Explain | IntentLabel::UpdateDocs => QueryIntent::Explore,\n        IntentLabel::AddFeature | IntentLabel::ModifyFeature => QueryIntent::AddFeature,\n        IntentLabel::Unknown => QueryIntent::Unknown,\n    }\n}\n","numLines":99,"startLine":1,"totalLines":99}}}
