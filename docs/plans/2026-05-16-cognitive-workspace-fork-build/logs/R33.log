{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KNhYdmhP2k4551zapr9hWU","type":"tool_result","content":"1\tuse super::{RankedCandidate, SignalKind, SignalScore};\n2\t\n3\tconst MAX_REASON_CHARS: usize = 120;\n4\tconst MAX_SIGNAL_COUNT: usize = 3;\n5\t\n6\tpub fn compact_inclusion_reason(candidate: &RankedCandidate) -> String {\n7\t    let mut parts = Vec::new();\n8\t    parts.push(compact_text(\n9\t        &candidate.candidate.preliminary_inclusion_reason,\n10\t        52,\n11\t    ));\n12\t\n13\t    let signal_summary = top_signal_summary(&candidate.signal_scores);\n14\t    if !signal_summary.is_empty() {\n15\t        parts.push(signal_summary);\n16\t    }\n17\t\n18\t    clamp_reason(&parts.join(\"; \"))\n19\t}\n20\t\n21\tfn top_signal_summary(signal_scores: &[SignalScore]) -> String {\n22\t    let mut positive = signal_scores\n23\t        .iter()\n24\t        .filter(|score| score.raw > 0.0)\n25\t        .collect::<Vec<_>>();\n26\t    positive.sort_by(|left, right| {\n27\t        right\n28\t            .weighted\n29\t            .partial_cmp(&left.weighted)\n30\t            .unwrap_or(std::cmp::Ordering::Equal)\n31\t            .then_with(|| signal_label(left.signal).cmp(signal_label(right.signal)))\n32\t    });\n33\t    positive.dedup_by(|left, right| left.signal == right.signal);\n34\t\n35\t    let labels = positive\n36\t        .into_iter()\n37\t        .take(MAX_SIGNAL_COUNT)\n38\t        .map(|score| signal_label(score.signal))\n39\t        .collect::<Vec<_>>();\n40\t    if labels.is_empty() {\n41\t        String::new()\n42\t    } else {\n43\t        format!(\"signals: {}\", labels.join(\", \"))\n44\t    }\n45\t}\n46\t\n47\tfn clamp_reason(value: &str) -> String {\n48\t    let single_line = value.split_whitespace().collect::<Vec<_>>().join(\" \");\n49\t    compact_text(&single_line, MAX_REASON_CHARS)\n50\t}\n51\t\n52\tfn compact_text(value: &str, limit: usize) -> String {\n53\t    let trimmed = value.trim();\n54\t    let char_count = trimmed.chars().count();\n55\t    if char_count <= limit {\n56\t        return trimmed.to_string();\n57\t    }\n58\t    let keep = limit.saturating_sub(1);\n59\t    let prefix = trimmed.chars().take(keep).collect::<String>();\n60\t    format!(\"{prefix}…\")\n61\t}\n62\t\n63\tfn signal_label(signal: SignalKind) -> &'static str {\n64\t    match signal {\n65\t        SignalKind::TaskTypeCompatibility => \"task fit\",\n66\t        SignalKind::GraphProximity => \"graph proximity\",\n67\t        SignalKind::ExactIdentifierMatch => \"exact id\",\n68\t        SignalKind::SemanticSimilarity => \"semantic match\",\n69\t        SignalKind::VerificationStatus => \"verification\",\n70\t        SignalKind::Freshness => \"freshness\",\n71\t        SignalKind::Scope => \"scope\",\n72\t        SignalKind::EvidenceStrength => \"evidence\",\n73\t        SignalKind::ContradictionOrSupersessionState => \"consistency\",\n74\t        SignalKind::PastUsefulness => \"past usefulness\",\n75\t        SignalKind::RecentSuccessfulReuse => \"recent reuse\",\n76\t        SignalKind::UserPreferenceCompatibility => \"user preference\",\n77\t        SignalKind::TokenCost => \"token cost\",\n78\t    }\n79\t}\n80\t"}]},"parent_tool_use_id":null,"session_id":"6bc825b2-855a-40f4-bda9-b6466b178977","uuid":"a79d1c13-81a6-4c06-9522-c6e433eb727f","timestamp":"2026-05-17T09:16:13.664Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/retrieval_v1/inclusion_reasons.rs","content":"use super::{RankedCandidate, SignalKind, SignalScore};\n\nconst MAX_REASON_CHARS: usize = 120;\nconst MAX_SIGNAL_COUNT: usize = 3;\n\npub fn compact_inclusion_reason(candidate: &RankedCandidate) -> String {\n    let mut parts = Vec::new();\n    parts.push(compact_text(\n        &candidate.candidate.preliminary_inclusion_reason,\n        52,\n    ));\n\n    let signal_summary = top_signal_summary(&candidate.signal_scores);\n    if !signal_summary.is_empty() {\n        parts.push(signal_summary);\n    }\n\n    clamp_reason(&parts.join(\"; \"))\n}\n\nfn top_signal_summary(signal_scores: &[SignalScore]) -> String {\n    let mut positive = signal_scores\n        .iter()\n        .filter(|score| score.raw > 0.0)\n        .collect::<Vec<_>>();\n    positive.sort_by(|left, right| {\n        right\n            .weighted\n            .partial_cmp(&left.weighted)\n            .unwrap_or(std::cmp::Ordering::Equal)\n            .then_with(|| signal_label(left.signal).cmp(signal_label(right.signal)))\n    });\n    positive.dedup_by(|left, right| left.signal == right.signal);\n\n    let labels = positive\n        .into_iter()\n        .take(MAX_SIGNAL_COUNT)\n        .map(|score| signal_label(score.signal))\n        .collect::<Vec<_>>();\n    if labels.is_empty() {\n        String::new()\n    } else {\n        format!(\"signals: {}\", labels.join(\", \"))\n    }\n}\n\nfn clamp_reason(value: &str) -> String {\n    let single_line = value.split_whitespace().collect::<Vec<_>>().join(\" \");\n    compact_text(&single_line, MAX_REASON_CHARS)\n}\n\nfn compact_text(value: &str, limit: usize) -> String {\n    let trimmed = value.trim();\n    let char_count = trimmed.chars().count();\n    if char_count <= limit {\n        return trimmed.to_string();\n    }\n    let keep = limit.saturating_sub(1);\n    let prefix = trimmed.chars().take(keep).collect::<String>();\n    format!(\"{prefix}…\")\n}\n\nfn signal_label(signal: SignalKind) -> &'static str {\n    match signal {\n        SignalKind::TaskTypeCompatibility => \"task fit\",\n        SignalKind::GraphProximity => \"graph proximity\",\n        SignalKind::ExactIdentifierMatch => \"exact id\",\n        SignalKind::SemanticSimilarity => \"semantic match\",\n        SignalKind::VerificationStatus => \"verification\",\n        SignalKind::Freshness => \"freshness\",\n        SignalKind::Scope => \"scope\",\n        SignalKind::EvidenceStrength => \"evidence\",\n        SignalKind::ContradictionOrSupersessionState => \"consistency\",\n        SignalKind::PastUsefulness => \"past usefulness\",\n        SignalKind::RecentSuccessfulReuse => \"recent reuse\",\n        SignalKind::UserPreferenceCompatibility => \"user preference\",\n        SignalKind::TokenCost => \"token cost\",\n    }\n}\n","numLines":80,"startLine":1,"totalLines":80}}}
