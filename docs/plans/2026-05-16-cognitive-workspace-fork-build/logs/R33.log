{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WbXvfXxVonnkjosVaftc5h","type":"tool_result","content":"1\t//! Retrieval V1 compact response shaper.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## 7. Retrieval Engine` and `## Phase 4: Retrieval V1` require the\n5\t//! retrieval pipeline to deduplicate and compress ranked candidates, then emit\n6\t//! a compact bundle where every result carries an inclusion reason and an\n7\t//! expansion handle.\n8\t\n9\tuse std::collections::{BTreeMap, BTreeSet, HashSet};\n10\t\n11\tuse serde::{Deserialize, Serialize};\n12\t\n13\tuse crate::identity::{decode_identity, encode_identity, Identity, IdentityKind};\n14\t\n15\tuse super::inclusion_reasons::compact_inclusion_reason;\n16\tuse super::{\n17\t    CandidateSource, DiagnosticMode, RankedCandidate, RankingDiagnostics, SignalKind, SignalScore,\n18\t};\n19\t\n20\tconst CHARS_PER_TOKEN_ESTIMATE: usize = 4;\n21\tconst MIN_SNIPPET_CHARS: usize = 24;\n22\tconst SNIPPET_TRIM_STEP: usize = 16;\n23\t\n24\t/// `## 5. Working Memory` and `## Phase 5: Working Memory` require the bundle\n25\t/// schema to remain stable so working-memory checkpoints can store selected and\n26\t/// excluded retrieval items without rewriting the Retrieval V1 result shape.\n27\tpub mod schema {\n28\t    use super::*;\n29\t\n30\t    #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n31\t    pub struct BudgetReport {\n32\t        pub token_budget: usize,\n33\t        pub estimated_tokens: usize,\n34\t        pub trimmed_snippets: usize,\n35\t        pub dropped_results: usize,\n36\t        pub truncated: bool,\n37\t    }\n38\t\n39\t    #[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n40\t    pub struct BundleResult {\n41\t        pub identity: Identity,\n42\t        pub kind: IdentityKind,\n43\t        pub headline: String,\n44\t        pub snippet: String,\n45\t        pub inclusion_reason: String,\n46\t        pub expansion_handle: String,\n47\t        pub source: Vec<CandidateSource>,\n48\t        pub score: f32,\n49\t    }\n50\t\n51\t    #[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n52\t    pub struct RetrievalBundle {\n53\t        pub task_id: String,\n54\t        pub intent_summary: String,\n55\t        pub anchors_summary: String,\n56\t        pub results: Vec<BundleResult>,\n57\t        pub diagnostics: Option<RankingDiagnostics>,\n58\t        pub budget_report: BudgetReport,\n59\t    }\n60\t}\n61\t\n62\tpub use schema::{BudgetReport, BundleResult, RetrievalBundle};\n63\t\n64\t#[derive(Debug, Clone, PartialEq, Eq)]\n65\tpub struct ShaperBudget {\n66\t    pub max_tokens: usize,\n67\t}\n68\t\n69\t#[derive(Debug, Clone, PartialEq, Eq)]\n70\tpub struct ShaperContext {\n71\t    pub pins: HashSet<Identity>,\n72\t    pub budget: ShaperBudget,\n73\t}\n74\t\n75\t#[derive(Debug, Clone)]\n76\tstruct MergedCandidate {\n77\t    best: RankedCandidate,\n78\t    sources: BTreeSet<CandidateSource>,\n79\t    signal_scores: BTreeMap<SignalKind, SignalScore>,\n80\t}\n81\t\n82\timpl Default for ShaperBudget {\n83\t    fn default() -> Self {\n84\t        Self { max_tokens: 320 }\n85\t    }\n86\t}\n87\t\n88\tpub fn shape_retrieval_bundle(\n89\t    task_id: impl Into<String>,\n90\t    intent_summary: impl Into<String>,\n91\t    anchors_summary: impl Into<String>,\n92\t    ranked: Vec<RankedCandidate>,\n93\t    mode: DiagnosticMode,\n94\t    diagnostics: Option<RankingDiagnostics>,\n95\t    ctx: &ShaperContext,\n96\t) -> RetrievalBundle {\n97\t    let deduped = deduplicate_ranked_candidates(ranked);\n98\t    let mut results = deduped\n99\t        .into_iter()\n100\t        .map(bundle_result_from_merged)\n101\t        .collect::<Vec<_>>();\n102\t    let budget_report = compress_results(&mut results, ctx);\n103\t    RetrievalBundle {\n104\t        task_id: task_id.into(),\n105\t        intent_summary: intent_summary.into(),\n106\t        anchors_summary: anchors_summary.into(),\n107\t        results,\n108\t        diagnostics: diagnostics.filter(|_| matches!(mode, DiagnosticMode::Diagnostic)),\n109\t        budget_report,\n110\t    }\n111\t}\n112\t\n113\tfn deduplicate_ranked_candidates(ranked: Vec<RankedCandidate>) -> Vec<MergedCandidate> {\n114\t    let mut merged = BTreeMap::<String, MergedCandidate>::new();\n115\t    let mut order = Vec::<String>::new();\n116\t\n117\t    for ranked_candidate in ranked {\n118\t        let key = ranked_candidate.candidate.identity.to_string();\n119\t        let entry = merged.entry(key.clone()).or_insert_with(|| {\n120\t            order.push(key.clone());\n121\t            MergedCandidate {\n122\t                best: ranked_candidate.clone(),\n123\t                sources: BTreeSet::new(),\n124\t                signal_scores: BTreeMap::new(),\n125\t            }\n126\t        });\n127\t\n128\t        if ranked_candidate.total_score > entry.best.total_score {\n129\t            entry.best = ranked_candidate.clone();\n130\t        }\n131\t        entry.sources.insert(ranked_candidate.candidate.source);\n132\t        merge_signal_scores(&mut entry.signal_scores, &ranked_candidate.signal_scores);\n133\t    }\n134\t\n135\t    order\n136\t        .into_iter()\n137\t        .filter_map(|key| merged.remove(&key))\n138\t        .collect()\n139\t}\n140\t\n141\tfn merge_signal_scores(merged: &mut BTreeMap<SignalKind, SignalScore>, scores: &[SignalScore]) {\n142\t    for score in scores {\n143\t        let replace = merged\n144\t            .get(&score.signal)\n145\t            .map(|current| score.raw > current.raw)\n146\t            .unwrap_or(true);\n147\t        if replace {\n148\t            merged.insert(score.signal, score.clone());\n149\t        }\n150\t    }\n151\t}\n152\t\n153\tfn bundle_result_from_merged(mut merged: MergedCandidate) -> BundleResult {\n154\t    merged.best.signal_scores = merged.signal_scores.into_values().collect();\n155\t    let identity = merged.best.candidate.identity.clone();\n156\t    let expansion_handle = expansion_handle_for_identity(&identity);\n157\t    let inclusion_reason = compact_inclusion_reason(&merged.best);\n158\t    BundleResult {\n159\t        kind: identity.kind(),\n160\t        headline: headline_for_identity(&identity),\n161\t        snippet: snippet_for_candidate(&merged.best),\n162\t        inclusion_reason,\n163\t        expansion_handle,\n164\t        source: merged.sources.into_iter().collect(),\n165\t        score: merged.best.total_score,\n166\t        identity,\n167\t    }\n168\t}\n169\t\n170\tfn headline_for_identity(identity: &Identity) -> String {\n171\t    match identity {\n172\t        Identity::File(file) => file.repo_relative_path.clone(),\n173\t        Identity::Symbol(symbol) => symbol.qualified_name.clone(),\n174\t        Identity::Doc(doc) => doc.repo_relative_path.clone(),\n175\t        Identity::Section(section) => format!(\n176\t            \"{}#{}\",\n177\t            section.doc.repo_relative_path,\n178\t            section.heading_path.join(\" > \")\n179\t        ),\n180\t        Identity::Event(event) => format!(\"event {}\", event.ulid),\n181\t        Identity::Memory(memory) => format!(\"memory {}\", memory.ulid),\n182\t        Identity::ContextHandle(handle) => format!(\"handle {}\", handle.ulid),\n183\t    }\n184\t}\n185\t\n186\tfn snippet_for_candidate(candidate: &RankedCandidate) -> String {\n187\t    let detail = candidate\n188\t        .signal_scores\n189\t        .iter()\n190\t        .filter(|score| score.raw > 0.0)\n191\t        .max_by(|left, right| {\n192\t            left.weighted\n193\t                .partial_cmp(&right.weighted)\n194\t                .unwrap_or(std::cmp::Ordering::Equal)\n195\t        })\n196\t        .map(|score| score.reason.as_str())\n197\t        .unwrap_or(candidate.candidate.preliminary_inclusion_reason.as_str());\n198\t    detail.split_whitespace().collect::<Vec<_>>().join(\" \")\n199\t}\n200\t\n201\tfn expansion_handle_for_identity(identity: &Identity) -> String {\n202\t    let handle = encode_identity(identity);\n203\t    debug_assert_eq!(\n204\t        decode_identity(&handle).expect(\"retrieval bundle expansion handle must decode\"),\n205\t        identity.clone(),\n206\t        \"retrieval bundle expansion handle must round-trip to the same identity\"\n207\t    );\n208\t    handle\n209\t}\n210\t\n211\tfn compress_results(results: &mut Vec<BundleResult>, ctx: &ShaperContext) -> BudgetReport {\n212\t    let initial_lengths = results\n213\t        .iter()\n214\t        .map(|result| result.snippet.len())\n215\t        .collect::<Vec<_>>();\n216\t    trim_snippets_to_budget(results, ctx.budget.max_tokens);\n217\t\n218\t    let mut dropped_results = 0;\n219\t    while estimate_bundle_tokens(results) > ctx.budget.max_tokens {\n220\t        let Some(index) = droppable_trailing_index(results, &ctx.pins) else {\n221\t            break;\n222\t        };\n223\t        results.remove(index);\n224\t        dropped_results += 1;\n225\t    }\n226\t\n227\t    let trimmed_snippets = results\n228\t        .iter()\n229\t        .zip(initial_lengths.iter())\n230\t        .filter(|(result, original)| result.snippet.len() < **original)\n231\t        .count();\n232\t    let estimated_tokens = estimate_bundle_tokens(results);\n233\t    BudgetReport {\n234\t        token_budget: ctx.budget.max_tokens,\n235\t        estimated_tokens,\n236\t        trimmed_snippets,\n237\t        dropped_results,\n238\t        truncated: trimmed_snippets > 0\n239\t            || dropped_results > 0\n240\t            || estimated_tokens > ctx.budget.max_tokens,\n241\t    }\n242\t}\n243\t\n244\tfn trim_snippets_to_budget(results: &mut [BundleResult], max_tokens: usize) {\n245\t    while estimate_bundle_tokens(results) > max_tokens {\n246\t        let Some((index, snippet_len)) = longest_trim_candidate(results) else {\n247\t            break;\n248\t        };\n249\t        if snippet_len <= MIN_SNIPPET_CHARS {\n250\t            break;\n251\t        }\n252\t        let new_len = snippet_len\n253\t            .saturating_sub(SNIPPET_TRIM_STEP)\n254\t            .max(MIN_SNIPPET_CHARS);\n255\t        results[index].snippet = truncate_chars(&results[index].snippet, new_len);\n256\t    }\n257\t}\n258\t\n259\tfn longest_trim_candidate(results: &[BundleResult]) -> Option<(usize, usize)> {\n260\t    results\n261\t        .iter()\n262\t        .enumerate()\n263\t        .map(|(index, result)| (index, result.snippet.chars().count()))\n264\t        .max_by_key(|(_, len)| *len)\n265\t}\n266\t\n267\tfn droppable_trailing_index(results: &[BundleResult], pins: &HashSet<Identity>) -> Option<usize> {\n268\t    results\n269\t        .iter()\n270\t        .enumerate()\n271\t        .rev()\n272\t        .find(|(_, result)| !pins.contains(&result.identity))\n273\t        .map(|(index, _)| index)\n274\t}\n275\t\n276\tfn estimate_bundle_tokens(results: &[BundleResult]) -> usize {\n277\t    let chars = results\n278\t        .iter()\n279\t        .map(|result| {\n280\t            result.headline.chars().count()\n281\t                + result.snippet.chars().count()\n282\t                + result.inclusion_reason.chars().count()\n283\t                + result.expansion_handle.chars().count()\n284\t                + result.source.len() * 12\n285\t                + 24\n286\t        })\n287\t        .sum::<usize>();\n288\t    chars.div_ceil(CHARS_PER_TOKEN_ESTIMATE)\n289\t}\n290\t\n291\tfn truncate_chars(value: &str, limit: usize) -> String {\n292\t    let char_count = value.chars().count();\n293\t    if char_count <= limit {\n294\t        return value.to_string();\n295\t    }\n296\t    if limit == 0 {\n297\t        return String::new();\n298\t    }\n299\t    if limit <= 1 {\n300\t        return \"…\".to_string();\n301\t    }\n302\t    let prefix = value.chars().take(limit - 1).collect::<String>();\n303\t    format!(\"{prefix}…\")\n304\t}\n305\t"}]},"parent_tool_use_id":null,"session_id":"6bc825b2-855a-40f4-bda9-b6466b178977","uuid":"827b56c7-0600-4c29-a119-7506eb3c128d","timestamp":"2026-05-17T09:16:09.145Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/retrieval_v1/shaper.rs","content":"//! Retrieval V1 compact response shaper.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 7. Retrieval Engine` and `## Phase 4: Retrieval V1` require the\n//! retrieval pipeline to deduplicate and compress ranked candidates, then emit\n//! a compact bundle where every result carries an inclusion reason and an\n//! expansion handle.\n\nuse std::collections::{BTreeMap, BTreeSet, HashSet};\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::identity::{decode_identity, encode_identity, Identity, IdentityKind};\n\nuse super::inclusion_reasons::compact_inclusion_reason;\nuse super::{\n    CandidateSource, DiagnosticMode, RankedCandidate, RankingDiagnostics, SignalKind, SignalScore,\n};\n\nconst CHARS_PER_TOKEN_ESTIMATE: usize = 4;\nconst MIN_SNIPPET_CHARS: usize = 24;\nconst SNIPPET_TRIM_STEP: usize = 16;\n\n/// `## 5. Working Memory` and `## Phase 5: Working Memory` require the bundle\n/// schema to remain stable so working-memory checkpoints can store selected and\n/// excluded retrieval items without rewriting the Retrieval V1 result shape.\npub mod schema {\n    use super::*;\n\n    #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n    pub struct BudgetReport {\n        pub token_budget: usize,\n        pub estimated_tokens: usize,\n        pub trimmed_snippets: usize,\n        pub dropped_results: usize,\n        pub truncated: bool,\n    }\n\n    #[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n    pub struct BundleResult {\n        pub identity: Identity,\n        pub kind: IdentityKind,\n        pub headline: String,\n        pub snippet: String,\n        pub inclusion_reason: String,\n        pub expansion_handle: String,\n        pub source: Vec<CandidateSource>,\n        pub score: f32,\n    }\n\n    #[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n    pub struct RetrievalBundle {\n        pub task_id: String,\n        pub intent_summary: String,\n        pub anchors_summary: String,\n        pub results: Vec<BundleResult>,\n        pub diagnostics: Option<RankingDiagnostics>,\n        pub budget_report: BudgetReport,\n    }\n}\n\npub use schema::{BudgetReport, BundleResult, RetrievalBundle};\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct ShaperBudget {\n    pub max_tokens: usize,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct ShaperContext {\n    pub pins: HashSet<Identity>,\n    pub budget: ShaperBudget,\n}\n\n#[derive(Debug, Clone)]\nstruct MergedCandidate {\n    best: RankedCandidate,\n    sources: BTreeSet<CandidateSource>,\n    signal_scores: BTreeMap<SignalKind, SignalScore>,\n}\n\nimpl Default for ShaperBudget {\n    fn default() -> Self {\n        Self { max_tokens: 320 }\n    }\n}\n\npub fn shape_retrieval_bundle(\n    task_id: impl Into<String>,\n    intent_summary: impl Into<String>,\n    anchors_summary: impl Into<String>,\n    ranked: Vec<RankedCandidate>,\n    mode: DiagnosticMode,\n    diagnostics: Option<RankingDiagnostics>,\n    ctx: &ShaperContext,\n) -> RetrievalBundle {\n    let deduped = deduplicate_ranked_candidates(ranked);\n    let mut results = deduped\n        .into_iter()\n        .map(bundle_result_from_merged)\n        .collect::<Vec<_>>();\n    let budget_report = compress_results(&mut results, ctx);\n    RetrievalBundle {\n        task_id: task_id.into(),\n        intent_summary: intent_summary.into(),\n        anchors_summary: anchors_summary.into(),\n        results,\n        diagnostics: diagnostics.filter(|_| matches!(mode, DiagnosticMode::Diagnostic)),\n        budget_report,\n    }\n}\n\nfn deduplicate_ranked_candidates(ranked: Vec<RankedCandidate>) -> Vec<MergedCandidate> {\n    let mut merged = BTreeMap::<String, MergedCandidate>::new();\n    let mut order = Vec::<String>::new();\n\n    for ranked_candidate in ranked {\n        let key = ranked_candidate.candidate.identity.to_string();\n        let entry = merged.entry(key.clone()).or_insert_with(|| {\n            order.push(key.clone());\n            MergedCandidate {\n                best: ranked_candidate.clone(),\n                sources: BTreeSet::new(),\n                signal_scores: BTreeMap::new(),\n            }\n        });\n\n        if ranked_candidate.total_score > entry.best.total_score {\n            entry.best = ranked_candidate.clone();\n        }\n        entry.sources.insert(ranked_candidate.candidate.source);\n        merge_signal_scores(&mut entry.signal_scores, &ranked_candidate.signal_scores);\n    }\n\n    order\n        .into_iter()\n        .filter_map(|key| merged.remove(&key))\n        .collect()\n}\n\nfn merge_signal_scores(merged: &mut BTreeMap<SignalKind, SignalScore>, scores: &[SignalScore]) {\n    for score in scores {\n        let replace = merged\n            .get(&score.signal)\n            .map(|current| score.raw > current.raw)\n            .unwrap_or(true);\n        if replace {\n            merged.insert(score.signal, score.clone());\n        }\n    }\n}\n\nfn bundle_result_from_merged(mut merged: MergedCandidate) -> BundleResult {\n    merged.best.signal_scores = merged.signal_scores.into_values().collect();\n    let identity = merged.best.candidate.identity.clone();\n    let expansion_handle = expansion_handle_for_identity(&identity);\n    let inclusion_reason = compact_inclusion_reason(&merged.best);\n    BundleResult {\n        kind: identity.kind(),\n        headline: headline_for_identity(&identity),\n        snippet: snippet_for_candidate(&merged.best),\n        inclusion_reason,\n        expansion_handle,\n        source: merged.sources.into_iter().collect(),\n        score: merged.best.total_score,\n        identity,\n    }\n}\n\nfn headline_for_identity(identity: &Identity) -> String {\n    match identity {\n        Identity::File(file) => file.repo_relative_path.clone(),\n        Identity::Symbol(symbol) => symbol.qualified_name.clone(),\n        Identity::Doc(doc) => doc.repo_relative_path.clone(),\n        Identity::Section(section) => format!(\n            \"{}#{}\",\n            section.doc.repo_relative_path,\n            section.heading_path.join(\" > \")\n        ),\n        Identity::Event(event) => format!(\"event {}\", event.ulid),\n        Identity::Memory(memory) => format!(\"memory {}\", memory.ulid),\n        Identity::ContextHandle(handle) => format!(\"handle {}\", handle.ulid),\n    }\n}\n\nfn snippet_for_candidate(candidate: &RankedCandidate) -> String {\n    let detail = candidate\n        .signal_scores\n        .iter()\n        .filter(|score| score.raw > 0.0)\n        .max_by(|left, right| {\n            left.weighted\n                .partial_cmp(&right.weighted)\n                .unwrap_or(std::cmp::Ordering::Equal)\n        })\n        .map(|score| score.reason.as_str())\n        .unwrap_or(candidate.candidate.preliminary_inclusion_reason.as_str());\n    detail.split_whitespace().collect::<Vec<_>>().join(\" \")\n}\n\nfn expansion_handle_for_identity(identity: &Identity) -> String {\n    let handle = encode_identity(identity);\n    debug_assert_eq!(\n        decode_identity(&handle).expect(\"retrieval bundle expansion handle must decode\"),\n        identity.clone(),\n        \"retrieval bundle expansion handle must round-trip to the same identity\"\n    );\n    handle\n}\n\nfn compress_results(results: &mut Vec<BundleResult>, ctx: &ShaperContext) -> BudgetReport {\n    let initial_lengths = results\n        .iter()\n        .map(|result| result.snippet.len())\n        .collect::<Vec<_>>();\n    trim_snippets_to_budget(results, ctx.budget.max_tokens);\n\n    let mut dropped_results = 0;\n    while estimate_bundle_tokens(results) > ctx.budget.max_tokens {\n        let Some(index) = droppable_trailing_index(results, &ctx.pins) else {\n            break;\n        };\n        results.remove(index);\n        dropped_results += 1;\n    }\n\n    let trimmed_snippets = results\n        .iter()\n        .zip(initial_lengths.iter())\n        .filter(|(result, original)| result.snippet.len() < **original)\n        .count();\n    let estimated_tokens = estimate_bundle_tokens(results);\n    BudgetReport {\n        token_budget: ctx.budget.max_tokens,\n        estimated_tokens,\n        trimmed_snippets,\n        dropped_results,\n        truncated: trimmed_snippets > 0\n            || dropped_results > 0\n            || estimated_tokens > ctx.budget.max_tokens,\n    }\n}\n\nfn trim_snippets_to_budget(results: &mut [BundleResult], max_tokens: usize) {\n    while estimate_bundle_tokens(results) > max_tokens {\n        let Some((index, snippet_len)) = longest_trim_candidate(results) else {\n            break;\n        };\n        if snippet_len <= MIN_SNIPPET_CHARS {\n            break;\n        }\n        let new_len = snippet_len\n            .saturating_sub(SNIPPET_TRIM_STEP)\n            .max(MIN_SNIPPET_CHARS);\n        results[index].snippet = truncate_chars(&results[index].snippet, new_len);\n    }\n}\n\nfn longest_trim_candidate(results: &[BundleResult]) -> Option<(usize, usize)> {\n    results\n        .iter()\n        .enumerate()\n        .map(|(index, result)| (index, result.snippet.chars().count()))\n        .max_by_key(|(_, len)| *len)\n}\n\nfn droppable_trailing_index(results: &[BundleResult], pins: &HashSet<Identity>) -> Option<usize> {\n    results\n        .iter()\n        .enumerate()\n        .rev()\n        .find(|(_, result)| !pins.contains(&result.identity))\n        .map(|(index, _)| index)\n}\n\nfn estimate_bundle_tokens(results: &[BundleResult]) -> usize {\n    let chars = results\n        .iter()\n        .map(|result| {\n            result.headline.chars().count()\n                + result.snippet.chars().count()\n                + result.inclusion_reason.chars().count()\n                + result.expansion_handle.chars().count()\n                + result.source.len() * 12\n                + 24\n        })\n        .sum::<usize>();\n    chars.div_ceil(CHARS_PER_TOKEN_ESTIMATE)\n}\n\nfn truncate_chars(value: &str, limit: usize) -> String {\n    let char_count = value.chars().count();\n    if char_count <= limit {\n        return value.to_string();\n    }\n    if limit == 0 {\n        return String::new();\n    }\n    if limit <= 1 {\n        return \"…\".to_string();\n    }\n    let prefix = value.chars().take(limit - 1).collect::<String>();\n    format!(\"{prefix}…\")\n}\n","numLines":305,"startLine":1,"totalLines":305}}}
