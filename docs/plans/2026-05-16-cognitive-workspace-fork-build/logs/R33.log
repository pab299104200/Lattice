{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CMdqjYbQMCQxXmdGNL6m7n","type":"tool_result","content":"1\tuse thiserror::Error;\n2\t\n3\tuse super::kinds::{\n4\t    ContextHandleId, DocId, EventId, FileId, Identity, MemoryId, SectionId, SymbolId,\n5\t};\n6\t\n7\t#[derive(Clone, Debug, Error, PartialEq, Eq)]\n8\tpub enum IdentityDecodeError {\n9\t    #[error(\"identity string is empty\")]\n10\t    Empty,\n11\t    #[error(\"identity string is missing a recognized prefix\")]\n12\t    MissingPrefix,\n13\t    #[error(\"identity string has malformed {field}: {reason}\")]\n14\t    MalformedField {\n15\t        field: &'static str,\n16\t        reason: &'static str,\n17\t    },\n18\t}\n19\t\n20\tpub fn encode_identity(identity: &Identity) -> String {\n21\t    match identity {\n22\t        Identity::File(value) => encode_file(value),\n23\t        Identity::Symbol(value) => encode_symbol(value),\n24\t        Identity::Doc(value) => encode_doc(value),\n25\t        Identity::Section(value) => encode_section(value),\n26\t        Identity::Event(value) => encode_workspace_ulid(\"event\", &value.workspace_id, &value.ulid),\n27\t        Identity::Memory(value) => {\n28\t            encode_workspace_ulid(\"memory\", &value.workspace_id, &value.ulid)\n29\t        }\n30\t        Identity::ContextHandle(value) => encode_context_handle(value),\n31\t    }\n32\t}\n33\t\n34\tpub fn decode_identity(value: &str) -> Result<Identity, IdentityDecodeError> {\n35\t    if value.is_empty() {\n36\t        return Err(IdentityDecodeError::Empty);\n37\t    }\n38\t    let Some((prefix, payload)) = value.split_once(':') else {\n39\t        return Err(IdentityDecodeError::MissingPrefix);\n40\t    };\n41\t    match prefix {\n42\t        \"file\" => decode_file(payload).map(Identity::File),\n43\t        \"symbol\" => decode_symbol(payload).map(Identity::Symbol),\n44\t        \"doc\" => decode_doc(payload).map(Identity::Doc),\n45\t        \"section\" => decode_section(payload).map(Identity::Section),\n46\t        \"event\" => decode_event(payload).map(Identity::Event),\n47\t        \"memory\" => decode_memory(payload).map(Identity::Memory),\n48\t        \"handle\" => decode_context_handle(payload).map(Identity::ContextHandle),\n49\t        _ => Err(IdentityDecodeError::MissingPrefix),\n50\t    }\n51\t}\n52\t\n53\tfn encode_file(value: &FileId) -> String {\n54\t    format!(\n55\t        \"file:{}/{}@{}\",\n56\t        escape(&value.workspace_id),\n57\t        escape(&value.repo_relative_path),\n58\t        value.content_hash\n59\t    )\n60\t}"}]},"parent_tool_use_id":null,"session_id":"6bc825b2-855a-40f4-bda9-b6466b178977","uuid":"2097d250-bd37-45e6-b5be-53ff388eed14","timestamp":"2026-05-17T09:19:21.584Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/identity/encoding.rs","content":"use thiserror::Error;\n\nuse super::kinds::{\n    ContextHandleId, DocId, EventId, FileId, Identity, MemoryId, SectionId, SymbolId,\n};\n\n#[derive(Clone, Debug, Error, PartialEq, Eq)]\npub enum IdentityDecodeError {\n    #[error(\"identity string is empty\")]\n    Empty,\n    #[error(\"identity string is missing a recognized prefix\")]\n    MissingPrefix,\n    #[error(\"identity string has malformed {field}: {reason}\")]\n    MalformedField {\n        field: &'static str,\n        reason: &'static str,\n    },\n}\n\npub fn encode_identity(identity: &Identity) -> String {\n    match identity {\n        Identity::File(value) => encode_file(value),\n        Identity::Symbol(value) => encode_symbol(value),\n        Identity::Doc(value) => encode_doc(value),\n        Identity::Section(value) => encode_section(value),\n        Identity::Event(value) => encode_workspace_ulid(\"event\", &value.workspace_id, &value.ulid),\n        Identity::Memory(value) => {\n            encode_workspace_ulid(\"memory\", &value.workspace_id, &value.ulid)\n        }\n        Identity::ContextHandle(value) => encode_context_handle(value),\n    }\n}\n\npub fn decode_identity(value: &str) -> Result<Identity, IdentityDecodeError> {\n    if value.is_empty() {\n        return Err(IdentityDecodeError::Empty);\n    }\n    let Some((prefix, payload)) = value.split_once(':') else {\n        return Err(IdentityDecodeError::MissingPrefix);\n    };\n    match prefix {\n        \"file\" => decode_file(payload).map(Identity::File),\n        \"symbol\" => decode_symbol(payload).map(Identity::Symbol),\n        \"doc\" => decode_doc(payload).map(Identity::Doc),\n        \"section\" => decode_section(payload).map(Identity::Section),\n        \"event\" => decode_event(payload).map(Identity::Event),\n        \"memory\" => decode_memory(payload).map(Identity::Memory),\n        \"handle\" => decode_context_handle(payload).map(Identity::ContextHandle),\n        _ => Err(IdentityDecodeError::MissingPrefix),\n    }\n}\n\nfn encode_file(value: &FileId) -> String {\n    format!(\n        \"file:{}/{}@{}\",\n        escape(&value.workspace_id),\n        escape(&value.repo_relative_path),\n        value.content_hash\n    )\n}","numLines":60,"startLine":1,"totalLines":330}}}
