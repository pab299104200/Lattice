{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019LFwtyKiKW3SbZEPCFESQx","type":"tool_result","content":"1\tuse std::collections::{BTreeMap, HashSet};\n2\t\n3\tuse crate::identity::{decode_identity, FileId, Identity, MemoryId, SymbolId};\n4\tuse crate::retrieval_v1::{\n5\t    classify_intent, schema::RetrievalBundle, shape_retrieval_bundle, Candidate, CandidateSource,\n6\t    DiagnosticMode, RankedCandidate, RankingDiagnostics, ResolvedAnchor, ScoringWeights,\n7\t    ShaperBudget, ShaperContext, SignalKind, SignalScore,\n8\t};\n9\t\n10\tconst WORKSPACE: &str = \"workspace-main\";\n11\t\n12\t#[test]\n13\tfn every_bundle_result_has_compact_inclusion_reason() {\n14\t    let ranked = vec![file_ranked(\"src/auth.rs\", 9.0, CandidateSource::Fts)];\n15\t    let bundle = shape_retrieval_bundle(\n16\t        \"task-31\",\n17\t        \"review auth\",\n18\t        \"auth anchors\",\n19\t        ranked,\n20\t        DiagnosticMode::Compact,\n21\t        None,\n22\t        &context(320, []),\n23\t    );\n24\t\n25\t    assert_eq!(bundle.results.len(), 1);\n26\t    let reason = &bundle.results[0].inclusion_reason;\n27\t    assert!(!reason.is_empty());\n28\t    assert!(reason.len() <= 120);\n29\t}\n30\t\n31\t#[test]\n32\tfn every_expansion_handle_resolves_back_to_original_identity() {\n33\t    let ranked = vec![\n34\t        file_ranked(\"src/auth.rs\", 8.0, CandidateSource::Fts),\n35\t        symbol_ranked(\"src/auth.rs\", \"auth::login\", 64, 7.5),\n36\t        memory_ranked(\"01ARZ3NDEKTSV4RRFFQ69G5FAV\", 7.0),\n37\t    ];\n38\t    let bundle = shape_retrieval_bundle(\n39\t        \"task-31\",\n40\t        \"review auth\",\n41\t        \"auth anchors\",\n42\t        ranked,\n43\t        DiagnosticMode::Compact,\n44\t        None,\n45\t        &context(400, []),\n46\t    );\n47\t\n48\t    for result in bundle.results {\n49\t        let decoded = decode_identity(&result.expansion_handle).expect(\"decode expansion handle\");\n50\t        assert_eq!(decoded, result.identity);\n51\t    }\n52\t}\n53\t\n54\t#[test]\n55\tfn deduplication_merges_signal_scores_and_sources() {\n56\t    let identity = file_identity(\"src/auth.rs\");\n57\t    let ranked = vec![\n58\t        ranked_candidate(\n59\t            identity.clone(),\n60\t            CandidateSource::Fts,\n61\t            5.0,\n62\t            vec![\n63\t                signal(SignalKind::TaskTypeCompatibility, 0.4, 0.4, \"task\"),\n64\t                signal(SignalKind::SemanticSimilarity, 0.3, 0.3, \"semantic low\"),\n65\t            ],\n66\t            \"fts candidate\",\n67\t        ),\n68\t        ranked_candidate(\n69\t            identity,\n70\t            CandidateSource::Embeddings,\n71\t            7.0,\n72\t            vec![\n73\t                signal(SignalKind::TaskTypeCompatibility, 0.8, 0.8, \"task high\"),\n74\t                signal(SignalKind::SemanticSimilarity, 0.9, 0.9, \"semantic high\"),\n75\t            ],\n76\t            \"embedding candidate\",\n77\t        ),\n78\t    ];\n79\t\n80\t    let bundle = shape_retrieval_bundle(\n81\t        \"task-31\",\n82\t        \"review auth\",\n83\t        \"auth anchors\",\n84\t        ranked,\n85\t        DiagnosticMode::Compact,\n86\t        None,\n87\t        &context(320, []),\n88\t    );\n89\t\n90\t    assert_eq!(bundle.results.len(), 1);\n91\t    assert_eq!(\n92\t        bundle.results[0].source,\n93\t        vec![CandidateSource::Fts, CandidateSource::Embeddings]\n94\t    );\n95\t    assert_eq!(bundle.results[0].score, 7.0);\n96\t}\n97\t\n98\t#[test]\n99\tfn compression_respects_budget_without_dropping_pinned_results() {\n100\t    let pinned = file_identity(\"src/pinned.rs\");\n101\t    let ranked = vec![\n102\t        ranked_with_long_snippet(pinned.clone(), CandidateSource::Fts, 9.0),\n103\t        ranked_with_long_snippet(\n104\t            file_identity(\"src/other-a.rs\"),\n105\t            CandidateSource::Embeddings,\n106\t            5.0,\n107\t        ),\n108\t        ranked_with_long_snippet(\n109\t            file_identity(\"src/other-b.rs\"),\n110\t            CandidateSource::MemoryLinks,\n111\t            4.0,\n112\t        ),\n113\t    ];\n114\t    let bundle = shape_retrieval_bundle(\n115\t        \"task-31\",\n116\t        \"review auth\",\n117\t        \"auth anchors\",\n118\t        ranked,\n119\t        DiagnosticMode::Compact,\n120\t        None,\n121\t        &ShaperContext {\n122\t            pins: HashSet::from([pinned.clone()]),\n123\t            budget: ShaperBudget { max_tokens: 75 },\n124\t        },\n125\t    );\n126\t\n127\t    assert!(bundle\n128\t        .results\n129\t        .iter()\n130\t        .any(|result| result.identity == pinned));\n131\t    assert!(bundle.budget_report.truncated);\n132\t    assert!(\n133\t        bundle.budget_report.dropped_results >= 1 || bundle.budget_report.trimmed_snippets >= 1\n134\t    );\n135\t}\n136\t\n137\t#[test]\n138\tfn diagnostic_mode_populates_diagnostics_and_compact_mode_does_not() {\n139\t    let ranked = vec![file_ranked(\"src/auth.rs\", 9.0, CandidateSource::Fts)];\n140\t    let diagnostics = sample_diagnostics(ranked.clone());\n141\t\n142\t    let compact = shape_retrieval_bundle(\n143\t        \"task-31\",\n144\t        \"review auth\",\n145\t        \"auth anchors\",\n146\t        ranked.clone(),\n147\t        DiagnosticMode::Compact,\n148\t        Some(diagnostics.clone()),\n149\t        &context(320, []),\n150\t    );\n151\t    let diagnostic = shape_retrieval_bundle(\n152\t        \"task-31\",\n153\t        \"review auth\",\n154\t        \"auth anchors\",\n155\t        ranked,\n156\t        DiagnosticMode::Diagnostic,\n157\t        Some(diagnostics),\n158\t        &context(320, []),\n159\t    );\n160\t\n161\t    assert!(compact.diagnostics.is_none());\n162\t    assert!(diagnostic.diagnostics.is_some());\n163\t}\n164\t\n165\t#[test]\n166\tfn serde_round_trip_preserves_schema_for_phase_five_checkpointing() {\n167\t    let ranked = vec![symbol_ranked(\"src/auth.rs\", \"auth::login\", 64, 7.5)];\n168\t    let bundle = shape_retrieval_bundle(\n169\t        \"task-31\",\n170\t        \"review auth\",\n171\t        \"auth anchors\",\n172\t        ranked,\n173\t        DiagnosticMode::Compact,\n174\t        None,\n175\t        &context(320, []),\n176\t    );\n177\t\n178\t    let encoded = serde_json::to_string(&bundle).expect(\"serialize bundle\");\n179\t    let decoded: RetrievalBundle = serde_json::from_str(&encoded).expect(\"deserialize bundle\");\n180\t\n181\t    assert_eq!(decoded, bundle);\n182\t}\n183\t\n184\t#[test]\n185\tfn truncation_flag_is_set_when_results_are_dropped() {\n186\t    let ranked = vec![\n187\t        ranked_with_long_snippet(file_identity(\"src/a.rs\"), CandidateSource::Fts, 8.0),\n188\t        ranked_with_long_snippet(file_identity(\"src/b.rs\"), CandidateSource::Embeddings, 7.0),\n189\t        ranked_with_long_snippet(file_identity(\"src/c.rs\"), CandidateSource::MemoryLinks, 6.0),\n190\t    ];\n191\t\n192\t    let bundle = shape_retrieval_bundle(\n193\t        \"task-31\",\n194\t        \"review auth\",\n195\t        \"auth anchors\",\n196\t        ranked,\n197\t        DiagnosticMode::Compact,\n198\t        None,\n199\t        &context(60, []),\n200\t    );\n201\t\n202\t    assert!(bundle.budget_report.truncated);\n203\t    assert!(bundle.budget_report.dropped_results > 0 || bundle.budget_report.trimmed_snippets > 0);\n204\t}\n205\t\n206\tfn context<const N: usize>(max_tokens: usize, pins: [Identity; N]) -> ShaperContext {\n207\t    ShaperContext {\n208\t        pins: HashSet::from(pins),\n209\t        budget: ShaperBudget { max_tokens },\n210\t    }\n211\t}\n212\t\n213\tfn file_ranked(path: &str, total_score: f32, source: CandidateSource) -> RankedCandidate {\n214\t    ranked_candidate(\n215\t        file_identity(path),\n216\t        source,\n217\t        total_score,\n218\t        vec![\n219\t            signal(SignalKind::TaskTypeCompatibility, 1.0, 1.0, \"task fit\"),\n220\t            signal(SignalKind::ExactIdentifierMatch, 0.8, 0.8, \"exact id\"),\n221\t        ],\n222\t        \"exact path symbol lookup result\",\n223\t    )\n224\t}\n225\t\n226\tfn symbol_ranked(path: &str, name: &str, byte_offset: usize, total_score: f32) -> RankedCandidate {\n227\t    ranked_candidate(\n228\t        symbol_identity(path, name, byte_offset),\n229\t        CandidateSource::CodeGraphTraversal,\n230\t        total_score,\n231\t        vec![\n232\t            signal(SignalKind::GraphProximity, 1.0, 1.1, \"graph proximity\"),\n233\t            signal(SignalKind::TaskTypeCompatibility, 0.8, 0.8, \"task fit\"),\n234\t        ],\n235\t        \"graph traversal result\",\n236\t    )\n237\t}\n238\t\n239\tfn memory_ranked(ulid: &str, total_score: f32) -> RankedCandidate {\n240\t    ranked_candidate(\n241\t        Identity::Memory(MemoryId {\n242\t            workspace_id: WORKSPACE.to_string(),\n243\t            ulid: ulid.to_string(),\n244\t        }),\n245\t        CandidateSource::MemoryLinks,\n246\t        total_score,\n247\t        vec![\n248\t            signal(SignalKind::EvidenceStrength, 0.8, 0.8, \"evidence\"),\n249\t            signal(SignalKind::VerificationStatus, 1.0, 1.0, \"verified\"),\n250\t        ],\n251\t        \"memory graph retrieval result\",\n252\t    )\n253\t}\n254\t\n255\tfn ranked_with_long_snippet(\n256\t    identity: Identity,\n257\t    source: CandidateSource,\n258\t    total_score: f32,\n259\t) -> RankedCandidate {\n260\t    ranked_candidate(\n261\t        identity,\n262\t        source,\n263\t        total_score,\n264\t        vec![\n265\t            signal(SignalKind::SemanticSimilarity, 1.0, 1.0, \"semantic\"),\n266\t            signal(SignalKind::TaskTypeCompatibility, 0.9, 0.9, \"task\"),\n267\t        ],\n268\t        \"this is an intentionally long retrieval explanation used to force snippet trimming before result dropping happens in the response shaper\",\n269\t    )\n270\t}\n271\t\n272\tfn ranked_candidate(\n273\t    identity: Identity,\n274\t    source: CandidateSource,\n275\t    total_score: f32,\n276\t    signal_scores: Vec<SignalScore>,\n277\t    preliminary_reason: &str,\n278\t) -> RankedCandidate {\n279\t    RankedCandidate {\n280\t        candidate: Candidate {\n281\t            identity,\n282\t            source,\n283\t            seed_anchor: None,\n284\t            raw_score: total_score as f64,\n285\t            preliminary_inclusion_reason: preliminary_reason.to_string(),\n286\t            expansion_handle_hint: None,\n287\t            traversal_path: Vec::new(),\n288\t            budget_exhausted: false,\n289\t        },\n290\t        total_score,\n291\t        signal_scores,\n292\t        inclusion_reason: preliminary_reason.to_string(),\n293\t    }\n294\t}\n295\t\n296\tfn sample_diagnostics(ranked: Vec<RankedCandidate>) -> RankingDiagnostics {\n297\t    RankingDiagnostics {\n298\t        intent: classify_intent(\"review auth\"),\n299\t        anchors: Vec::<ResolvedAnchor>::new(),\n300\t        candidates_per_source: BTreeMap::from([(CandidateSource::Fts, ranked.len())]),\n301\t        ranked,\n302\t        weights: ScoringWeights::default(),\n303\t        budget_exhaustion_flags: crate::retrieval_v1::BudgetExhaustionFlags {\n304\t            any_budget_exhausted: false,\n305\t            exhausted_sources: Vec::new(),\n306\t        },\n307\t    }\n308\t}\n309\t\n310\tfn signal(signal: SignalKind, raw: f32, weighted: f32, reason: &str) -> SignalScore {\n311\t    SignalScore {\n312\t        signal,\n313\t        raw,\n314\t        weighted,\n315\t        reason: reason.to_string(),\n316\t    }\n317\t}\n318\t\n319\tfn file_identity(path: &str) -> Identity {\n320\t    Identity::File(FileId {\n321\t        workspace_id: WORKSPACE.to_string(),\n322\t        repo_relative_path: path.to_string(),\n323\t        content_hash: \"abcdef12\".to_string(),\n324\t    })\n325\t}\n326\t\n327\tfn symbol_identity(path: &str, name: &str, byte_offset: usize) -> Identity {\n328\t    Identity::Symbol(SymbolId {\n329\t        file: FileId {\n330\t            workspace_id: WORKSPACE.to_string(),\n331\t            repo_relative_path: path.to_string(),\n332\t            content_hash: \"abcdef12\".to_string(),\n333\t        },\n334\t        qualified_name: name.to_string(),\n335\t        byte_offset,\n336\t        kind: \"function\".to_string(),\n337\t    })\n338\t}\n339\t"}]},"parent_tool_use_id":null,"session_id":"6bc825b2-855a-40f4-bda9-b6466b178977","uuid":"b1e76dfe-845d-485e-87ab-c844600279b1","timestamp":"2026-05-17T09:17:10.809Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/retrieval_v1/shaper_tests.rs","content":"use std::collections::{BTreeMap, HashSet};\n\nuse crate::identity::{decode_identity, FileId, Identity, MemoryId, SymbolId};\nuse crate::retrieval_v1::{\n    classify_intent, schema::RetrievalBundle, shape_retrieval_bundle, Candidate, CandidateSource,\n    DiagnosticMode, RankedCandidate, RankingDiagnostics, ResolvedAnchor, ScoringWeights,\n    ShaperBudget, ShaperContext, SignalKind, SignalScore,\n};\n\nconst WORKSPACE: &str = \"workspace-main\";\n\n#[test]\nfn every_bundle_result_has_compact_inclusion_reason() {\n    let ranked = vec![file_ranked(\"src/auth.rs\", 9.0, CandidateSource::Fts)];\n    let bundle = shape_retrieval_bundle(\n        \"task-31\",\n        \"review auth\",\n        \"auth anchors\",\n        ranked,\n        DiagnosticMode::Compact,\n        None,\n        &context(320, []),\n    );\n\n    assert_eq!(bundle.results.len(), 1);\n    let reason = &bundle.results[0].inclusion_reason;\n    assert!(!reason.is_empty());\n    assert!(reason.len() <= 120);\n}\n\n#[test]\nfn every_expansion_handle_resolves_back_to_original_identity() {\n    let ranked = vec![\n        file_ranked(\"src/auth.rs\", 8.0, CandidateSource::Fts),\n        symbol_ranked(\"src/auth.rs\", \"auth::login\", 64, 7.5),\n        memory_ranked(\"01ARZ3NDEKTSV4RRFFQ69G5FAV\", 7.0),\n    ];\n    let bundle = shape_retrieval_bundle(\n        \"task-31\",\n        \"review auth\",\n        \"auth anchors\",\n        ranked,\n        DiagnosticMode::Compact,\n        None,\n        &context(400, []),\n    );\n\n    for result in bundle.results {\n        let decoded = decode_identity(&result.expansion_handle).expect(\"decode expansion handle\");\n        assert_eq!(decoded, result.identity);\n    }\n}\n\n#[test]\nfn deduplication_merges_signal_scores_and_sources() {\n    let identity = file_identity(\"src/auth.rs\");\n    let ranked = vec![\n        ranked_candidate(\n            identity.clone(),\n            CandidateSource::Fts,\n            5.0,\n            vec![\n                signal(SignalKind::TaskTypeCompatibility, 0.4, 0.4, \"task\"),\n                signal(SignalKind::SemanticSimilarity, 0.3, 0.3, \"semantic low\"),\n            ],\n            \"fts candidate\",\n        ),\n        ranked_candidate(\n            identity,\n            CandidateSource::Embeddings,\n            7.0,\n            vec![\n                signal(SignalKind::TaskTypeCompatibility, 0.8, 0.8, \"task high\"),\n                signal(SignalKind::SemanticSimilarity, 0.9, 0.9, \"semantic high\"),\n            ],\n            \"embedding candidate\",\n        ),\n    ];\n\n    let bundle = shape_retrieval_bundle(\n        \"task-31\",\n        \"review auth\",\n        \"auth anchors\",\n        ranked,\n        DiagnosticMode::Compact,\n        None,\n        &context(320, []),\n    );\n\n    assert_eq!(bundle.results.len(), 1);\n    assert_eq!(\n        bundle.results[0].source,\n        vec![CandidateSource::Fts, CandidateSource::Embeddings]\n    );\n    assert_eq!(bundle.results[0].score, 7.0);\n}\n\n#[test]\nfn compression_respects_budget_without_dropping_pinned_results() {\n    let pinned = file_identity(\"src/pinned.rs\");\n    let ranked = vec![\n        ranked_with_long_snippet(pinned.clone(), CandidateSource::Fts, 9.0),\n        ranked_with_long_snippet(\n            file_identity(\"src/other-a.rs\"),\n            CandidateSource::Embeddings,\n            5.0,\n        ),\n        ranked_with_long_snippet(\n            file_identity(\"src/other-b.rs\"),\n            CandidateSource::MemoryLinks,\n            4.0,\n        ),\n    ];\n    let bundle = shape_retrieval_bundle(\n        \"task-31\",\n        \"review auth\",\n        \"auth anchors\",\n        ranked,\n        DiagnosticMode::Compact,\n        None,\n        &ShaperContext {\n            pins: HashSet::from([pinned.clone()]),\n            budget: ShaperBudget { max_tokens: 75 },\n        },\n    );\n\n    assert!(bundle\n        .results\n        .iter()\n        .any(|result| result.identity == pinned));\n    assert!(bundle.budget_report.truncated);\n    assert!(\n        bundle.budget_report.dropped_results >= 1 || bundle.budget_report.trimmed_snippets >= 1\n    );\n}\n\n#[test]\nfn diagnostic_mode_populates_diagnostics_and_compact_mode_does_not() {\n    let ranked = vec![file_ranked(\"src/auth.rs\", 9.0, CandidateSource::Fts)];\n    let diagnostics = sample_diagnostics(ranked.clone());\n\n    let compact = shape_retrieval_bundle(\n        \"task-31\",\n        \"review auth\",\n        \"auth anchors\",\n        ranked.clone(),\n        DiagnosticMode::Compact,\n        Some(diagnostics.clone()),\n        &context(320, []),\n    );\n    let diagnostic = shape_retrieval_bundle(\n        \"task-31\",\n        \"review auth\",\n        \"auth anchors\",\n        ranked,\n        DiagnosticMode::Diagnostic,\n        Some(diagnostics),\n        &context(320, []),\n    );\n\n    assert!(compact.diagnostics.is_none());\n    assert!(diagnostic.diagnostics.is_some());\n}\n\n#[test]\nfn serde_round_trip_preserves_schema_for_phase_five_checkpointing() {\n    let ranked = vec![symbol_ranked(\"src/auth.rs\", \"auth::login\", 64, 7.5)];\n    let bundle = shape_retrieval_bundle(\n        \"task-31\",\n        \"review auth\",\n        \"auth anchors\",\n        ranked,\n        DiagnosticMode::Compact,\n        None,\n        &context(320, []),\n    );\n\n    let encoded = serde_json::to_string(&bundle).expect(\"serialize bundle\");\n    let decoded: RetrievalBundle = serde_json::from_str(&encoded).expect(\"deserialize bundle\");\n\n    assert_eq!(decoded, bundle);\n}\n\n#[test]\nfn truncation_flag_is_set_when_results_are_dropped() {\n    let ranked = vec![\n        ranked_with_long_snippet(file_identity(\"src/a.rs\"), CandidateSource::Fts, 8.0),\n        ranked_with_long_snippet(file_identity(\"src/b.rs\"), CandidateSource::Embeddings, 7.0),\n        ranked_with_long_snippet(file_identity(\"src/c.rs\"), CandidateSource::MemoryLinks, 6.0),\n    ];\n\n    let bundle = shape_retrieval_bundle(\n        \"task-31\",\n        \"review auth\",\n        \"auth anchors\",\n        ranked,\n        DiagnosticMode::Compact,\n        None,\n        &context(60, []),\n    );\n\n    assert!(bundle.budget_report.truncated);\n    assert!(bundle.budget_report.dropped_results > 0 || bundle.budget_report.trimmed_snippets > 0);\n}\n\nfn context<const N: usize>(max_tokens: usize, pins: [Identity; N]) -> ShaperContext {\n    ShaperContext {\n        pins: HashSet::from(pins),\n        budget: ShaperBudget { max_tokens },\n    }\n}\n\nfn file_ranked(path: &str, total_score: f32, source: CandidateSource) -> RankedCandidate {\n    ranked_candidate(\n        file_identity(path),\n        source,\n        total_score,\n        vec![\n            signal(SignalKind::TaskTypeCompatibility, 1.0, 1.0, \"task fit\"),\n            signal(SignalKind::ExactIdentifierMatch, 0.8, 0.8, \"exact id\"),\n        ],\n        \"exact path symbol lookup result\",\n    )\n}\n\nfn symbol_ranked(path: &str, name: &str, byte_offset: usize, total_score: f32) -> RankedCandidate {\n    ranked_candidate(\n        symbol_identity(path, name, byte_offset),\n        CandidateSource::CodeGraphTraversal,\n        total_score,\n        vec![\n            signal(SignalKind::GraphProximity, 1.0, 1.1, \"graph proximity\"),\n            signal(SignalKind::TaskTypeCompatibility, 0.8, 0.8, \"task fit\"),\n        ],\n        \"graph traversal result\",\n    )\n}\n\nfn memory_ranked(ulid: &str, total_score: f32) -> RankedCandidate {\n    ranked_candidate(\n        Identity::Memory(MemoryId {\n            workspace_id: WORKSPACE.to_string(),\n            ulid: ulid.to_string(),\n        }),\n        CandidateSource::MemoryLinks,\n        total_score,\n        vec![\n            signal(SignalKind::EvidenceStrength, 0.8, 0.8, \"evidence\"),\n            signal(SignalKind::VerificationStatus, 1.0, 1.0, \"verified\"),\n        ],\n        \"memory graph retrieval result\",\n    )\n}\n\nfn ranked_with_long_snippet(\n    identity: Identity,\n    source: CandidateSource,\n    total_score: f32,\n) -> RankedCandidate {\n    ranked_candidate(\n        identity,\n        source,\n        total_score,\n        vec![\n            signal(SignalKind::SemanticSimilarity, 1.0, 1.0, \"semantic\"),\n            signal(SignalKind::TaskTypeCompatibility, 0.9, 0.9, \"task\"),\n        ],\n        \"this is an intentionally long retrieval explanation used to force snippet trimming before result dropping happens in the response shaper\",\n    )\n}\n\nfn ranked_candidate(\n    identity: Identity,\n    source: CandidateSource,\n    total_score: f32,\n    signal_scores: Vec<SignalScore>,\n    preliminary_reason: &str,\n) -> RankedCandidate {\n    RankedCandidate {\n        candidate: Candidate {\n            identity,\n            source,\n            seed_anchor: None,\n            raw_score: total_score as f64,\n            preliminary_inclusion_reason: preliminary_reason.to_string(),\n            expansion_handle_hint: None,\n            traversal_path: Vec::new(),\n            budget_exhausted: false,\n        },\n        total_score,\n        signal_scores,\n        inclusion_reason: preliminary_reason.to_string(),\n    }\n}\n\nfn sample_diagnostics(ranked: Vec<RankedCandidate>) -> RankingDiagnostics {\n    RankingDiagnostics {\n        intent: classify_intent(\"review auth\"),\n        anchors: Vec::<ResolvedAnchor>::new(),\n        candidates_per_source: BTreeMap::from([(CandidateSource::Fts, ranked.len())]),\n        ranked,\n        weights: ScoringWeights::default(),\n        budget_exhaustion_flags: crate::retrieval_v1::BudgetExhaustionFlags {\n            any_budget_exhausted: false,\n            exhausted_sources: Vec::new(),\n        },\n    }\n}\n\nfn signal(signal: SignalKind, raw: f32, weighted: f32, reason: &str) -> SignalScore {\n    SignalScore {\n        signal,\n        raw,\n        weighted,\n        reason: reason.to_string(),\n    }\n}\n\nfn file_identity(path: &str) -> Identity {\n    Identity::File(FileId {\n        workspace_id: WORKSPACE.to_string(),\n        repo_relative_path: path.to_string(),\n        content_hash: \"abcdef12\".to_string(),\n    })\n}\n\nfn symbol_identity(path: &str, name: &str, byte_offset: usize) -> Identity {\n    Identity::Symbol(SymbolId {\n        file: FileId {\n            workspace_id: WORKSPACE.to_string(),\n            repo_relative_path: path.to_string(),\n            content_hash: \"abcdef12\".to_string(),\n        },\n        qualified_name: name.to_string(),\n        byte_offset,\n        kind: \"function\".to_string(),\n    })\n}\n","numLines":339,"startLine":1,"totalLines":339}}}
