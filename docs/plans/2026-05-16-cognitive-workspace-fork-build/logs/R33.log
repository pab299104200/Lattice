hts,\n240\t) -> SignalScore {\n241\t    let identity_text = candidate.identity.to_string();\n242\t    for anchor in anchors {\n243\t        if anchor_matches_identity(anchor, &candidate.identity, &identity_text) {\n244\t            return signal(\n245\t                SignalKind::ExactIdentifierMatch,\n246\t                1.0,\n247\t                weights,\n248\t                format!(\"candidate identity matches anchor `{}`\", anchor.anchor_text),\n249\t            );\n250\t        }\n251\t    }\n252\t    skipped(\n253\t        SignalKind::ExactIdentifierMatch,\n254\t        weights,\n255\t        \"exact identifier match\",\n256\t    )\n257\t}\n258\t\n259\tpub fn semantic_similarity(\n260\t    candidate: &Candidate,\n261\t    weights: &ScoringWeights,\n262\t    ctx: &ScoringContext,\n263\t) -> SignalScore {\n264\t    let key = candidate.identity.to_string();\n265\t    let raw = ctx.semantic_similarity.get(&key).copied().or_else(|| {\n266\t        (candidate.source == CandidateSource::Embeddings).then_some(candidate.raw_score as f32)\n267\t    });\n268\t    match raw {\n269\t        Some(score) => signal(\n270\t            SignalKind::SemanticSimilarity,\n271\t            score.clamp(0.0, 1.0),\n272\t            weights,\n273\t            format!(\"semantic similarity {:.3} supplied for candidate\", score),\n274\t        ),\n275\t        None => skipped(\n276\t            SignalKind::SemanticSimilarity,\n277\t            weights,\n278\t            \"semantic similarity\",\n279\t        ),\n280\t    }\n281\t}\n282\t\n283\tpub fn verification_status(\n284\t    candidate: &Candidate,\n285\t    weights: &ScoringWeights,\n286\t    mode: DiagnosticMode,\n287\t    ctx: &ScoringContext,\n288\t) -> SignalScore {\n289\t    let Some(metadata) = memory_metadata(candidate, ctx) else {\n290\t        return skipped(\n291\t            SignalKind::VerificationStatus,\n292\t            weights,\n293\t            \"verification status\",\n294\t        );\n295\t    };\n296\t    let raw = verification_raw(metadata);\n297\t    let mut score = signal(\n298\t        SignalKind::VerificationStatus,\n299\t        raw,\n300\t        weights,\n301\t        format!(\n302\t            \"memory verification status is {:?}\",\n303\t            metadata.verification_status\n304\t        ),\n305\t    );\n306\t    apply_untrusted_penalty(&mut score, candidate, metadata, weights, mode, ctx);\n307\t    score\n308\t}\n309\t\n310\tpub fn freshness(\n311\t    candidate: &Candidate,\n312\t    weights: &ScoringWeights,\n313\t    ctx: &ScoringContext,\n314\t) -> SignalScore {\n315\t    let Some(now) = ctx.now_unix_seconds else {\n316\t        return skipped(SignalKind::Freshness, weights, \"freshness timestamp\");\n317\t    };\n318\t    let Some(timestamp) = freshness_timestamp(candidate, ctx) else {\n319\t        return skipped(SignalKind::Freshness, weights, \"freshness timestamp\");\n320\t    };\n321\t    let age = now.saturating_sub(timestamp);\n322\t    let raw = 1.0 - ((age.min(FRESHNESS_WINDOW_SECONDS) as f32) / FRESHNESS_WINDOW_SECONDS as f32);\n323\t    signal(\n324\t        SignalKind::Freshness,\n325\t        raw,\n326\t        weights,\n327\t        format!(\"candidate age is {} second(s)\", age),\n328\t    )\n329\t}\n330\t\n331\tpub fn scope(candidate: &Candidate, weights: &ScoringWeights, ctx: &ScoringContext) -> SignalScore {\n332\t    let Some(metadata) = memory_metadata(candidate, ctx) else {\n333\t        return skipped(SignalKind::Scope, weights, \"scope\");\n334\t    };\n335\t    let raw = match metadata.scope {\n336\t        MemoryScope::Repo => 1.0,\n337\t        MemoryScope::Branch => 0.8,\n338\t        MemoryScope::Session => 0.45,\n339\t    };\n340\t    signal(\n341\t        SignalKind::Scope,\n342\t        raw,\n343\t        weights,\n344\t        format!(\"memory scope is {:?}\", metadata.scope),\n345\t    )\n346\t}\n347\t\n348\tpub fn evidence_strength(\n349\t    candidate: &Candidate,"}]},"parent_tool_use_id":null,"session_id":"6bc825b2