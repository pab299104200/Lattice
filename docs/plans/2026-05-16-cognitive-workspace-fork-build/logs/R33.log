d={} signals=[{}] reason={}\",\n                 i + 1, r.total_score, r.candidate.identity, positive.join(\", \"), r.inclusion_reason);\n    }\n    println!(\"bundle.budget_report = {:?}\", run.bundle.budget_report);\n    println!(\"bundle.results ({}):\", run.bundle.results.len());\n    for (i, b) in run.bundle.results.iter().enumerate() {\n        println!(\"  #{} score={:.3} kind={:?} headline={}\", i + 1, b.score, b.kind, b.headline);\n        println!(\"     handle = {}\", b.expansion_handle);\n        println!(\"     sources = {:?}\", b.source);\n        println!(\"     reason ({} chars) = {}\", b.inclusion_reason.len(), b.inclusion_reason);\n    }\n    println!(\"end {label}\");\n}\nEOF\ncp /tmp/r33_trace_test.rs /home/pete/cadres/lattice/daemon/crates/lattice-core/src/retrieval_v1/r33_trace.rs","description":"Write temporary trace test"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":6544,"cache_read_input_tokens":156483,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6544},"output_tokens":43,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6bc825b2-855a-40f4-bda9-b6466b178977","uuid":"954fc9ce-ecfb-4fd9-95c0-92cea748f7a8","request_id":"req_011Cb7tZ2HjWqJZvTxeucjgi"}
