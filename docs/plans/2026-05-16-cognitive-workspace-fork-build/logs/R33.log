{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013Lgu3JTPsqLw1SAWWv3rm3","type":"tool_result","content":"1\tuse std::collections::BTreeMap;\n2\t\n3\tuse serde::{Deserialize, Serialize};\n4\t\n5\tconst IMPERATIVE_SCAN_LIMIT: usize = 4;\n6\tpub const MAX_INTENT_TASK_CHARS: usize = 2048;\n7\t\n8\t/// Intent labels for Retrieval V1 task statements.\n9\t#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]\n10\tpub enum IntentLabel {\n11\t    /// Biases `diagnose_failure`, `trace_scenario`, and bug-fix retrieval paths.\n12\t    Debug,\n13\t    /// Biases `prepare_change`, `plan_edit`, and refactor-heavy graph expansion.\n14\t    Refactor,\n15\t    /// Biases `get_context_capsule`, `summarize_subsystem`, and `expand_context`.\n16\t    Explain,\n17\t    /// Biases `prepare_change` and feature-entrypoint retrieval for new capabilities.\n18\t    AddFeature,\n19\t    /// Biases `prepare_change` and `plan_edit` for changing an existing capability.\n20\t    ModifyFeature,\n21\t    /// Biases `find_relevant_tests` and regression-oriented edit planning.\n22\t    AddTest,\n23\t    /// Biases `get_docs_capsule`, `find_stale_docs`, and documentation edits.\n24\t    UpdateDocs,\n25\t    /// Biases migration-aware planning and schema-touching retrieval paths.\n26\t    Migration,\n27\t    /// Biases benchmark, hot-path, and cost-sensitive retrieval paths.\n28\t    Performance,\n29\t    /// Biases `impact_from_diff`, review checklists, and audit-style retrieval.\n30\t    Review,\n31\t    /// Fallback when no deterministic task signal fires.\n32\t    Unknown,\n33\t}\n34\t\n35\t/// Finite, inspectable feature kinds used by the classifier.\n36\t#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]\n37\tpub enum IntentFeatureKind {\n38\t    LemmaMatch,\n39\t    ImperativeVerb,\n40\t    ErrorKeyword,\n41\t    FileTokenShape,\n42\t    SymbolTokenShape,\n43\t    QuestionForm,\n44\t    DescriptivePhrase,\n45\t}\n46\t\n47\t/// A literal feature that contributed to one or more labels.\n48\t#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n49\tpub struct IntentFeature {\n50\t    pub kind: IntentFeatureKind,\n51\t    pub value: String,\n52\t}\n53\t\n54\t/// Diagnostic tuple for explainable ranking stages.\n55\tpub type IntentDiagnostic = (IntentLabel, Vec<IntentFeature>, f64);\n56\t\n57\t/// Inspectable classifier output for Retrieval V1.\n58\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n59\tpub struct IntentClassification {\n60\t    pub primary_label: IntentLabel,\n61\t    pub secondary_labels: Vec<IntentLabel>,\n62\t    pub feature_scores: BTreeMap<IntentLabel, f64>,\n63\t    pub contributing_features: BTreeMap<IntentLabel, Vec<IntentFeature>>,\n64\t    pub fired_features: Vec<IntentFeature>,\n65\t    pub inspected_text: String,\n66\t    pub input_was_truncated: bool,\n67\t}\n68\t\n69\timpl IntentClassification {\n70\t    pub fn diagnostics(&self) -> Vec<IntentDiagnostic> {\n71\t        let mut diagnostics = Vec::new();\n72\t        for label in ordered_labels() {\n73\t            let score = self.feature_scores.get(&label).copied().unwrap_or(0.0);\n74\t            if score <= 0.0 && label != IntentLabel::Unknown {\n75\t                continue;\n76\t            }\n77\t            let features = self\n78\t                .contributing_features\n79\t                .get(&label)\n80\t                .cloned()\n81\t                .unwrap_or_default();\n82\t            diagnostics.push((label, features, score));\n83\t        }\n84\t        diagnostics.sort_by(|left, right| compare_labels(left.0, right.0, left.2, right.2));\n85\t        diagnostics\n86\t    }\n87\t}\n88\t\n89\t/// Feature-based and inspectable scoring is required by\n90\t/// `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md#ranking-complexity`.\n91\tpub fn classify_intent(task_text: &str) -> IntentClassification {\n92\t    let prepared = PreparedTask::new(task_text);\n93\t    if prepared.inspected_text.is_empty() {\n94\t        return unknown_classification(prepared);\n95\t    }\n96\t\n97\t    let mut scores = ScoreCard::new();\n98\t    add_rule_features(&prepared, &mut scores);\n99\t    add_question_features(&prepared, &mut scores);\n100\t    add_shape_features(&prepared, &mut scores);\n101\t    add_descriptive_phrase_fallback(&prepared, &mut scores);\n102\t\n103\t    finalize_classification(prepared, scores)\n104\t}\n105\t\n106\t#[derive(Debug, Clone)]\n107\tstruct PreparedTask {\n108\t    inspected_text: String,\n109\t    tokens: Vec<String>,\n110\t    raw_tokens: Vec<String>,\n111\t    input_was_truncated: bool,\n112\t}\n113\t\n114\timpl PreparedTask {\n115\t    fn new(task_text: &str) -> Self {\n116\t        let trimmed = task_text.trim();\n117\t        let total_chars = trimmed.chars().count();\n118\t        let inspected_text: String = trimmed.chars().take(MAX_INTENT_TASK_CHARS).collect();\n119\t        let input_was_truncated = total_chars > MAX_INTENT_TASK_CHARS;\n120\t        let raw_tokens = split_raw_tokens(&inspected_text);\n121\t        let tokens = normalize_tokens(&inspected_text);\n122\t\n123\t        Self {\n124\t            inspected_text,\n125\t            tokens,\n126\t            raw_tokens,\n127\t            input_was_truncated,\n128\t        }\n129\t    }\n130\t}\n131\t\n132\t#[derive(Default)]\n133\tstruct ScoreCard {\n134\t    scores: BTreeMap<IntentLabel, f64>,\n135\t    features: BTreeMap<IntentLabel, Vec<IntentFeature>>,\n136\t}\n137\t\n138\timpl ScoreCard {\n139\t    fn new() -> Self {\n140\t        let mut scores = BTreeMap::new();\n141\t        let mut features = BTreeMap::new();\n142\t        for label in ordered_labels() {\n143\t            scores.insert(label, 0.0);\n144\t            features.insert(label, Vec::new());\n145\t        }\n146\t        Self { scores, features }\n147\t    }\n148\t\n149\t    fn add(&mut self, label: IntentLabel, feature: IntentFeature, score: