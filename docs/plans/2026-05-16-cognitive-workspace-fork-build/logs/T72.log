+function resolveReferenceUri(reference: string): vscode.Uri | undefined {
+    const raw = reference.trim();
+    if (!raw) {
+        return undefined;
+    }
+    if (raw.startsWith('http://') || raw.startsWith('https://')) {
+        return vscode.Uri.parse(raw);
+    }
+    const fileLike = raw.split('#')[0].split('::')[0];
+    if (!fileLike) {
