+function toReviewPanelMessage(message: WebviewMessage): ReviewPanelMessage {
+    return {
+        command: message.command,
+        filterKey: message.filterKey,
+        sortKey: message.sortKey,
+        page: message.page,
+        pageSize: message.pageSize,
+        memoryId: message.memoryId,
+    };
+}
