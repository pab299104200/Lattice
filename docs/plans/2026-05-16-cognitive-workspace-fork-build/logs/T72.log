+        if (!selection) {
+            return;
+        }
+        this.staleViewState.selectedStatuses = normalizeFilterSelection(
+            selection.map((item) => item.value),
+            STALE_STATUS_VALUES
+        );
+        await this.refreshState();
+    }
+
