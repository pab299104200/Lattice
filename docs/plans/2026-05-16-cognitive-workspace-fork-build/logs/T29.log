pub enum AnchorKind {
    Path,
    Symbol,
    Error,
    Command,
    Api,
    ConfigKey,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
pub struct SourceSpan {
