    /// Compact single-char code for token-efficient output.
    pub fn short_code(&self) -> &'static str {
        match self {
            EdgeKind::Calls => "C",
            EdgeKind::Imports => "I",
            EdgeKind::Implements => "M",
            EdgeKind::Extends => "E",
            EdgeKind::TypeRef => "T",
            EdgeKind::Contains => "N",
            EdgeKind::LinksTo => "L",
            EdgeKind::Mentions => "R",
