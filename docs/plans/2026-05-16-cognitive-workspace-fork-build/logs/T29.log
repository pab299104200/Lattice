    /// Return structured assertion metadata for a single non-invalidated memory.
    pub fn get_structured_fields(
        &self,
        id: &str,
    ) -> Result<Option<MemoryStructuredFields>, LatticeError> {
        let mut stmt = self
            .conn
            .prepare(
