+        scope_organization_id: None,
+        refresh_key: None,
+        source_query: None,
+        created_at: 0,
+        last_accessed: 0,
+        access_count: 0,
+        is_stale: false,
+        stale_reason: None,
+        verification_status: crate::memory::MemoryVerificationStatus::Unverified,
+    }
+}
