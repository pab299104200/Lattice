        ],
    )
}

fn execute_insert_cached(
    statement: &mut CachedStatement<'_>,
    row: &InsertEnvelopeRow,
) -> Result<usize, rusqlite::Error> {
    statement.execute(params![
        row.event_uuid,
        row.workspace_id,
        row.branch,
        row.session_id,
        row.task_id,
        row.actor_kind,
        row.actor_detail,
