+        confidence: 0.5 + (index as f64 / 100.0).min(0.49),
+        linked_symbols: vec![format!("symbol_{index}")],
+        linked_files: vec![format!("src/{index}.rs")],
+        workspace_id: Some(WORKSPACE.to_string()),
