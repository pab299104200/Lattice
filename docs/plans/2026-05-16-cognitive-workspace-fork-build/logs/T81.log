impl MemoryLink {
    pub fn try_new(
        link_id: MemoryLinkId,
        source: MemoryId,
        target: MemoryLinkTarget,
        link_type: MemoryLinkType,
        strength: f32,
        reason: String,
        evidence_event_id: Option<crate::identity::EventId>,
