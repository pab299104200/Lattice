+struct TempDbFixture {
+    _dir: TempDir,
+    memory_path: PathBuf,
+}
+
+impl TempDbFixture {
+    fn new() -> Self {
+        let dir = TempDir::new().expect("tempdir");
+        let memory_path = dir.path().join("memory.sqlite");
+        MemoryStore::open(&memory_path).expect("memory schema initializes");
