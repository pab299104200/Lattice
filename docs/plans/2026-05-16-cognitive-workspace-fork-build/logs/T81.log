+        let event_store = Arc::new(EventStore::open_in_memory().unwrap());
+        let event_writer = EventWriter::new(event_store.clone(), WORKSPACE.to_string(), 4096);
+        Self {
+            consolidation_path: dir.path().join(format!("{label}-consolidation.sqlite")),
