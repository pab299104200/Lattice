+        .collect::<Vec<_>>();
+    let expected = (0..events.len())
+        .map(|index| format!("{session}:{index:03}"))
+        .collect::<Vec<_>>();
+    assert_eq!(summaries, expected, "per-session event ordering changed");
+}
