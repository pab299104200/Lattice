   187	    /// BFS traversal in both directions up to `hops` hops. Excludes the start node.
   188	    pub fn n_hop_neighbors(&self, id: &SymbolId, hops: usize) -> Vec<&GraphNode> {
   189	        let idx = match self.index.get(id) {
   190	            Some(&idx) => idx,
   191	            None => return Vec::new(),
   192	        };
   193	
   194	        let mut visited = HashSet::new();
   195	        visited.insert(idx);
   196	        let mut queue = VecDeque::new();
   197	        queue.push_back((idx, 0usize));
   198	        let mut result = Vec::new();
   199	
   200	        while let Some((current, depth)) = queue.pop_front() {
   201	            if depth >= hops {
   202	                continue;
   203	            }
   204	
   205	            // Both directions
   206	            for direction in &[Direction::Outgoing, Direction::Incoming] {
   207	                for neighbor in self.graph.neighbors_directed(current, *direction) {
   208	                    if visited.insert(neighbor) {
   209	                        result.push(&self.graph[neighbor]);
   210	                        queue.push_back((neighbor, depth + 1));
   211	                    }
   212	                }
   213	            }
   214	        }
   215	
   216	        result
   217	    }
