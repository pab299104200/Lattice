   155	    /// Get outgoing dependencies of a node (symbols this node depends on).
   156	    pub fn get_dependencies(&self, id: &SymbolId) -> Vec<(&GraphNode, EdgeKind)> {
   157	        let idx = match self.index.get(id) {
   158	            Some(&idx) => idx,
   159	            None => return Vec::new(),
   160	        };
   161	
   162	        self.graph
   163	            .neighbors_directed(idx, Direction::Outgoing)
   164	            .filter_map(|neighbor_idx| {
   165	                let edge = self.graph.edges_connecting(idx, neighbor_idx).next()?;
   166	                Some((&self.graph[neighbor_idx], *edge.weight()))
   167	            })
   168	            .collect()
   169	    }
