   111	                .map_err(|e| LatticeError::Storage(format!("Failed to prepare edge insert: {}", e)))?;
   112	
   113	            for (from_node, to_node, edge_kind) in graph.all_edges() {
   114	                insert_edge
   115	                    .execute(params![
   116	                        &from_node.id.file,
   117	                        &from_node.id.name,
   118	                        from_node.id.byte_offset as i64,
   119	                        &to_node.id.file,
   120	                        &to_node.id.name,
   121	                        to_node.id.byte_offset as i64,
   122	                        format!("{:?}", edge_kind),
   123	                    ])
   124	                    .map_err(|e| LatticeError::Storage(format!("Failed to insert edge: {}", e)))?;
   125	            }
   126	        }
   127	
   128	        tx.commit()
   129	            .map_err(|e| LatticeError::Storage(format!("Failed to commit transaction: {}", e)))?;
   130	
   131	        Ok(())
   132	    }
