   171	    /// Get incoming dependents of a node (symbols that depend on this node).
   172	    pub fn get_dependents(&self, id: &SymbolId) -> Vec<(&GraphNode, EdgeKind)> {
   173	        let idx = match self.index.get(id) {
   174	            Some(&idx) => idx,
   175	            None => return Vec::new(),
   176	        };
   177	
   178	        self.graph
   179	            .neighbors_directed(idx, Direction::Incoming)
   180	            .filter_map(|neighbor_idx| {
   181	                let edge = self.graph.edges_connecting(neighbor_idx, idx).next()?;
   182	                Some((&self.graph[neighbor_idx], *edge.weight()))
   183	            })
   184	            .collect()
   185	    }
