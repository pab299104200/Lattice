   129	    /// Add an edge between two nodes. Skips duplicates.
   130	    pub fn add_edge(&mut self, from: &SymbolId, to: &SymbolId, kind: EdgeKind) {
   131	        let from_idx = match self.index.get(from) {
   132	            Some(&idx) => idx,
   133	            None => return,
   134	        };
   135	        let to_idx = match self.index.get(to) {
   136	            Some(&idx) => idx,
   137	            None => return,
   138	        };
   139	
   140	        // Check for duplicate edge
   141	        for edge in self.graph.edges_connecting(from_idx, to_idx) {
   142	            if *edge.weight() == kind {
   143	                return;
   144	            }
   145	        }
   146	
   147	        self.graph.add_edge(from_idx, to_idx, kind);
   148	    }
