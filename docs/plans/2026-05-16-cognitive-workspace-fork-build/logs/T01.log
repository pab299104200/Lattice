   134	    pub fn load_file_index(&self) -> Result<HashMap<String, FileIndexEntry>, LatticeError> {
   135	        let mut stmt = self
   136	            .conn
   137	            .prepare(
   138	                "SELECT file, content_hash, mtime_ns, size_bytes, parser_version, schema_version, last_indexed_at FROM file_index",
   139	            )
   140	            .map_err(|e| LatticeError::Storage(format!("Failed to prepare file index query: {}", e)))?;
   141	
   142	        let rows = stmt
   143	            .query_map([], |row| {
   144	                Ok(FileIndexEntry {
   145	                    file: row.get(0)?,
   146	                    content_hash: row.get(1)?,
   147	                    mtime_ns: row.get(2)?,
   148	                    size_bytes: row.get(3)?,
   149	                    parser_version: row.get(4)?,
   150	                    schema_version: row.get(5)?,
   151	                    last_indexed_at: row.get(6)?,
   152	                })
   153	            })
   154	            .map_err(|e| LatticeError::Storage(format!("Failed to query file index: {}", e)))?;
   155	
   156	        let mut entries = HashMap::new();
   157	        for row in rows {
   158	            let entry = row.map_err(|e| {
   159	                LatticeError::Storage(format!("Failed to read file index row: {}", e))
   160	            })?;
   161	            entries.insert(entry.file.clone(), entry);
   162	        }
   163	        Ok(entries)
   164	    }
   165	
   166	    pub fn save_file_index(&self, entries: &[FileIndexEntry]) -> Result<(), LatticeError> {
   167	        let tx = self.conn.unchecked_transaction().map_err(|e| {
   168	            LatticeError::Storage(format!("Failed to begin file index transaction: {}", e))
   169	        })?;
   170	        tx.execute("DELETE FROM file_index", [])
   171	            .map_err(|e| LatticeError::Storage(format!("Failed to clear file index: {}", e)))?;
   172	        {
   173	            let mut insert = tx
   174	                .prepare(
   175	                    "INSERT INTO file_index (file, content_hash, mtime_ns, size_bytes, parser_version, schema_version, last_indexed_at) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)",
   176	                )
   177	                .map_err(|e| LatticeError::Storage(format!("Failed to prepare file index insert: {}", e)))?;
   178	            for entry in entries {
   179	                insert
   180	                    .execute(params![
   181	                        &entry.file,
   182	                        &entry.content_hash,
   183	                        entry.mtime_ns,
   184	                        entry.size_bytes,
   185	                        entry.parser_version,
   186	                        entry.schema_version,
   187	                        entry.last_indexed_at,
   188	                    ])
   189	                    .map_err(|e| {
   190	                        LatticeError::Storage(format!("Failed to insert file index row: {}", e))
   191	                    })?;
   192	            }
   193	        }
   194	        tx.commit()
   195	            .map_err(|e| LatticeError::Storage(format!("Failed to commit file index: {}", e)))?;
   196	        Ok(())
   197	    }
   198	
   199	    pub fn load_parsed_files(&self) -> Result<HashMap<String, ParsedFile>, LatticeError> {
   200	        let mut stmt = self
   201	            .conn
   202	            .prepare("SELECT file, payload FROM parsed_files")
   203	            .map_err(|e| {
   204	                LatticeError::Storage(format!("Failed to prepare parsed files query: {}", e))
   205	            })?;
   206	        let rows = stmt
   207	            .query_map([], |row| {
   208	                let file: String = row.get(0)?;
   209	                let payload: String = row.get(1)?;
   210	                Ok((file, payload))
   211	            })
   212	            .map_err(|e| LatticeError::Storage(format!("Failed to query parsed files: {}", e)))?;
   213	
   214	        let mut files = HashMap::new();
   215	        for row in rows {
   216	            let (file, payload) = row.map_err(|e| {
   217	                LatticeError::Storage(format!("Failed to read parsed file row: {}", e))
   218	            })?;
   219	            let parsed: ParsedFile = serde_json::from_str(&payload).map_err(|e| {
   220	                LatticeError::Storage(format!("Failed to deserialize parsed file {}: {}", file, e))
   221	            })?;
   222	            files.insert(file, parsed);
   223	        }
   224	        Ok(files)
   225	    }
   226	
   227	    pub fn save_parsed_files(
   228	        &self,
   229	        parsed_files: &HashMap<String, ParsedFile>,
   230	    ) -> Result<(), LatticeError> {
   231	        let tx = self.conn.unchecked_transaction().map_err(|e| {
   232	            LatticeError::Storage(format!("Failed to begin parsed files transaction: {}", e))
   233	        })?;
   234	        tx.execute("DELETE FROM parsed_files", [])
   235	            .map_err(|e| LatticeError::Storage(format!("Failed to clear parsed files: {}", e)))?;
   236	        {
   237	            let mut insert = tx
   238	                .prepare("INSERT INTO parsed_files (file, payload) VALUES (?1, ?2)")
   239	                .map_err(|e| {
   240	                    LatticeError::Storage(format!("Failed to prepare parsed file insert: {}", e))
   241	                })?;
   242	            for (file, parsed) in parsed_files {
   243	                let payload = serde_json::to_string(parsed).map_err(|e| {
   244	                    LatticeError::Storage(format!(
   245	                        "Failed to serialize parsed file {}: {}",
   246	                        file, e
   247	                    ))
   248	                })?;
   249	                insert.execute(params![file, payload]).map_err(|e| {
   250	                    LatticeError::Storage(format!("Failed to insert parsed file {}: {}", file, e))
   251	                })?;
   252	            }
   253	        }
   254	        tx.commit()
   255	            .map_err(|e| LatticeError::Storage(format!("Failed to commit parsed files: {}", e)))?;
   256	        Ok(())
   257	    }
