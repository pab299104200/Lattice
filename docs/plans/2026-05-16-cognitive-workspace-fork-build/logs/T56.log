+#[test]
+fn diagnose_failure_recovers_injected_failure_pattern() {
+    let fixture = Fixture::new();
+    let bundle = fixture.diagnose_bundle();
+    assert!(bundle
+        .memory_highlights
+        .iter()
+        .any(|memory| memory.memory_type == "pattern"));
