+pub(crate) fn memory_highlights(
+    workspace_id: &str,
+    memories: &[Value],
+    fallback_reason: &str,
+) -> Vec<MemoryHighlight> {
+    memories
+        .iter()
+        .enumerate()
+        .filter_map(|(index, value)| memory_highlight(workspace_id, value, index, fallback_reason))
+        .collect()
+}
