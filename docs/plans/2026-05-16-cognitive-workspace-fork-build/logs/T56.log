-            Self::Full | Self::Diagnostic => 10,
+fn collect_string_values_inner(value: &Value, keys: &[&str], values: &mut Vec<String>) {
+    match value {
+        Value::Object(object) => {
+            for key in keys {
+                if let Some(item) = object.get(*key).and_then(Value::as_str) {
+                    values.push(item.to_string());
+                }
+            }
+            for child in object.values() {
+                collect_string_values_inner(child, keys, values);
+            }
         }
-    }
-
-    /// Maximum memories to keep for this render mode.
-    pub fn memory_limit(self) -> usize {
-        match self {
-            Self::Focused => 1,
-            Self::Compact => 3,
-            Self::Full | Self::Diagnostic => 6,
+        Value::Array(items) => {
+            for item in items {
+                collect_string_values_inner(item, keys, values);
+            }
         }
+        _ => {}
     }
 }
 
