+) -> Option<String> {
+    keys.iter()
+        .filter_map(|key| object.get(*key).and_then(Value::as_str))
+        .map(str::trim)
+        .filter(|value| !value.is_empty())
+        .map(ToString::to_string)
+        .next()
+}
+
+fn evidence_strength(object: &serde_json::Map<String, Value>) -> String {
