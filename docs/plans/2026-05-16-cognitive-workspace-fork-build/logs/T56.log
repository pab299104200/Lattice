+pub(crate) fn file_identity(workspace_id: &str, file: &str) -> FileId {
+    FileId {
+        workspace_id: workspace_id.to_string(),
+        repo_relative_path: file.to_string(),
+        content_hash: "unknown".to_string(),
+    }
+}
