    pub fn from_scope(scope: &MemoryScope) -> Self {
        match scope {
            MemoryScope::Session => MemoryFreshnessPolicy::SessionScoped,
            MemoryScope::Branch => MemoryFreshnessPolicy::BranchScoped,
            MemoryScope::Repo => MemoryFreshnessPolicy::RepoScoped,
