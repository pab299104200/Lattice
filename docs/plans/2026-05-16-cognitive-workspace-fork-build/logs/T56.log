+            format!("cd daemon && cargo test {}", file.replace('/', "::"))
+        } else {
+            format!("Run targeted test file {file}")
+        }
+    }));
+    if commands.is_empty() {
+        commands.push("cd daemon && cargo test --workspace".to_string());
     }
+    commands.sort();
+    commands.dedup();
