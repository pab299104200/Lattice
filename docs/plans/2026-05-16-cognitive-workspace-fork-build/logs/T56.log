+    WorkflowBundle {
+        overview: task.overview.clone(),
+        ranked_pivots: task
+            .symbols
+            .iter()
+            .map(|symbol| Pivot {
+                identity: StableIdentity::LegacyHandle(
+                    symbol.symbol_handle.clone().unwrap_or_else(|| format!("symbol:{}", symbol.symbol)),
