+fn freshness_status(status: MemoryVerificationStatus, is_stale: bool) -> &'static str {
+    if is_stale || matches!(status, MemoryVerificationStatus::Stale) {
+        "stale"
+    } else if matches!(status, MemoryVerificationStatus::Expired) {
+        "expired"
+    } else {
+        "fresh"
     }
 }
 
