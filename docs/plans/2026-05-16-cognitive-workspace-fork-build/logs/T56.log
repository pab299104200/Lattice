+            .cloned()
+            .unwrap_or_default(),
     }
+}
+
+fn collect_string_values(value: &Value, keys: &[&str]) -> Vec<String> {
+    let mut values = Vec::new();
+    collect_string_values_inner(value, keys, &mut values);
+    values.sort();
+    values.dedup();
+    values
