+pub struct WorkflowBundle {
+    /// Human-readable summary of what the workflow selected and why.
+    pub overview: String,
+    /// Ranked code, doc, memory, or failure pivots with stable identities.
+    pub ranked_pivots: Vec<Pivot>,
