+) -> WorkflowBundle {
+    let memories = memory_highlights(workspace_id, &capsule.memories, "matched workflow query");
+    let mut risks = risks_from_memories(&memories);
+    risks.extend(task.risks.iter().map(|risk| RiskNote {
