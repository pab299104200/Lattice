+fn contradiction_state(
+    object: &serde_json::Map<String, Value>,
+    status: MemoryVerificationStatus,
+) -> String {
+    if matches!(status, MemoryVerificationStatus::Contradicted) {
+        return "contradicted".to_string();
     }
