+                message: format!("Memory is not trusted guidance: {label}"),
+                mitigation: "Use it only as historical evidence and verify against current code."
+                    .to_string(),
+            })
+        })
+        .collect()
 }
 
-/// Build a stable `expand_context` focus token for file/symbol pairs.
-pub fn expansion_focus(file: Option<&str>, symbol: Option<&str>) -> String {
