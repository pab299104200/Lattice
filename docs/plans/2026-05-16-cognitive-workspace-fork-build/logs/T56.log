+        commands.push("cd daemon && cargo test -p lattice-daemon --lib".to_string());
+    }
+    if files.iter().any(|file| file.ends_with(".ts") || file.ends_with(".tsx")) {
+        commands.push("cd extension && npm run compile".to_string());
