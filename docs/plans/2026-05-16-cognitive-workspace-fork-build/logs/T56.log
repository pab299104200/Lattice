+        files: collect_string_values(&value, &["file", "repo_relative_path"]),
+        symbols: collect_string_values(&value, &["symbol", "qualified_name"]),
+        tests: collect_test_files(&value),
+        memories: value
+            .get("memory_highlights")
+            .and_then(Value::as_array)
+            .cloned()
+            .unwrap_or_default(),
