/// The kind of relationship between two symbols.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
pub enum EdgeKind {
    Calls,
    Imports,
    Implements,
    Extends,
    TypeRef,
    Contains,
    LinksTo,
    Mentions,
    CoChanges,
}

impl EdgeKind {
    /// Compact single-char code for token-efficient output.
    pub fn short_code(&self) -> &'static str {
        match self {
            EdgeKind::Calls => "C",
            EdgeKind::Imports => "I",
            EdgeKind::Implements => "M",
            EdgeKind::Extends => "E",
            EdgeKind::TypeRef => "T",
            EdgeKind::Contains => "N",
            EdgeKind::LinksTo => "L",
            EdgeKind::Mentions => "R",
            EdgeKind::CoChanges => "X",
        }
    }
}

