+
+pub(crate) fn risks_from_memories(memories: &[MemoryHighlight]) -> Vec<RiskNote> {
+    memories
+        .iter()
+        .filter_map(|memory| {
+            memory.stale_label.as_ref().map(|label| RiskNote {
