+        status,
+        MemoryVerificationStatus::Stale
+            | MemoryVerificationStatus::Contradicted
+            | MemoryVerificationStatus::Superseded
+            | MemoryVerificationStatus::Expired
+            | MemoryVerificationStatus::Invalidated
