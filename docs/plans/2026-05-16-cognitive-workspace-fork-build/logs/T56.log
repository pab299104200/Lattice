+pub(crate) fn verification_commands(files: &[String], tests: &[String]) -> Vec<String> {
+    let mut commands = Vec::new();
+    if files.iter().any(|file| file.ends_with(".rs")) || tests.iter().any(|file| file.ends_with(".rs")) {
