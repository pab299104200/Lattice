-        match self {
-            Self::Focused => 1,
-            Self::Compact => 3,
-            Self::Full | Self::Diagnostic => 6,
+        Value::Array(items) => {
+            for item in items {
+                collect_string_values_inner(item, keys, values);
+            }
         }
+        _ => {}
     }
 }
 
