+    let status = string_field(object, &["verification_status"])
+        .unwrap_or_else(|| "unverified".to_string());
+    let is_stale = object
+        .get("is_stale")
+        .and_then(Value::as_bool)
+        .unwrap_or(false);
+    let memory_id = string_field(object, &["id", "memory_id"])
+        .unwrap_or_else(|| format!("memory-{index}"));
