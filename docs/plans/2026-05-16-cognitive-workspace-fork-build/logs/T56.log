+                symbol: Some(symbol.symbol.clone()),
+                line: Some(symbol.line),
+                score: symbol.score,
+                inclusion_reason: symbol.evidence.join("; "),
+            })
+            .collect(),
+        relevant_context: task
+            .primary_files
