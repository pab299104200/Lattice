+//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`
+//! `### 3. Event Log`.
+
+pub mod envelope;
+pub mod kinds;
+
+#[cfg(test)]
+mod tests;
+
+pub type DocSectionId = crate::identity::SectionId;
+
+pub use envelope::{
+    Actor, BranchRef, CompactSummary, EventEnvelope, EventModelError, PayloadHash,
+    PayloadLocation, SessionId, StableRef, TaskId,
+};
+pub use kinds::{
+    AssistantTaskStartedPayload, ContextBundleReturnedPayload, DiagnosticObservedPayload,
+    DiagnosticSeverity, EventKind, EventPayload, FileReadPayload, MemoryConsolidatedPayload,
+    MemoryCreatedPayload, MemoryExpandedPayload, MemoryInvalidatedPayload,
+    MemoryRetrievedPayload, MemoryUpdatedPayload, PatchAppliedPayload, PlanCreatedPayload,
+    TestRunCompletedPayload, TestRunStartedPayload, TestRunStatus, ToolCalledPayload,
+    ToolResultPayload, ToolResultStatus, UserCorrectionPayload, UserPreferenceObservedPayload,
+    WorkflowFailedPayload, WorkflowSucceededPayload,
+};
