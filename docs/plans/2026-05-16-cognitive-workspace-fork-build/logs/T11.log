            MemoryVerificationStatus::Stale => "stale",
            MemoryVerificationStatus::Contradicted => "contradicted",
            MemoryVerificationStatus::Superseded => "superseded",
        }
    }

    pub fn from_str(s: &str) -> Self {
        match s {
