+    FileId {
+        workspace_id: "workspace-main".to_string(),
+        repo_relative_path: "src/events/mod.rs".to_string(),
+        content_hash: "abcdef12".to_string(),
+    }
+}
+
+fn symbol_id() -> SymbolId {
+    SymbolId {
+        file: file_id(),
+        qualified_name: "events::build_payload".to_string(),
+        byte_offset: 128,
