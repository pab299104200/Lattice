+    pub reason: String,
+}
+
+/// Payload for `patch_applied`.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PatchAppliedPayload {
+    /// Stable patch or edit operation id.
+    pub patch_id: String,
