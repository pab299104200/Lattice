+        let count: i64 = self
+            .conn
+            .query_row(
+                "SELECT COUNT(*)
+                 FROM memory_accesses
+                 WHERE memory_id = ?1
+                   AND accessed_at >= ?2",
+                params![memory_id, cutoff as i64],
