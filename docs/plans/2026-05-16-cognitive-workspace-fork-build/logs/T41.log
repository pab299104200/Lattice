+                    score.value,
+                    score.computed_at as i64,
+                    score.computed_from_window_secs as i64,
+                    score.sample_size as i64,
+                ],
+            )
+            .map_err(|e| LatticeError::Storage(format!("Failed to write memory score: {}", e)))?;
