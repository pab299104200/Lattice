+                    (access_id, memory_id, accessed_at, inclusion_reason, was_used)
+                 VALUES (?1, ?2, ?3, ?4, ?5)",
+                params![
+                    access_id,
+                    memory_id,
+                    accessed_at as i64,
+                    inclusion_reason,
+                    was_used.map(|value| if value { 1 } else { 0 }),
+                ],
+            )
+            .map_err(|e| LatticeError::Storage(format!("Failed to record memory access: {}", e)))?;
+        Ok(())
+    }
