+                 WHERE id = ?1 AND is_invalidated = 0
+                 LIMIT 1",
+                params![id],
+                |row| row.get::<_, Option<i64>>(0),
+            )
+            .optional()
+            .map_err(|e| {
+                LatticeError::Storage(format!("Failed to load last_verified_at: {}", e))
+            })?
+            .flatten();
+        Ok(value.map(|timestamp| timestamp.max(0) as u64))
+    }
