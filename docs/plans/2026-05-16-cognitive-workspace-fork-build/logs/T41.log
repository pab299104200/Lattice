+fn duplicate_detector_emits_supersession_proposal() {
+    let fixture = Fixture::new();
+    let older_id = fixture.seed_memory("Duplicate login memory", vec!["src/auth.ts"], vec!["loginUser"], 10);
+    let newer_id = fixture.seed_memory("Duplicate login memory", vec!["src/auth.ts"], vec!["loginUser"], 20);
+
+    reset_direct_write_count();
+    let mut runtime = fixture.runtime();
+    let mut detector = DuplicateDetector::new(&fixture.memory_store, &mut runtime);
