+                    computed_at: row.get::<_, i64>(2)?.max(0) as u64,
+                    computed_from_window_secs: row.get::<_, i64>(3)?.max(0) as u64,
+                    sample_size: row.get::<_, i64>(4)?.max(0) as u32,
+                })
+            })
+            .optional()
+            .map_err(|e| {
+                LatticeError::Storage(format!("Failed to load latest memory score: {}", e))
+            })?;
+        Ok(score)
+    }
