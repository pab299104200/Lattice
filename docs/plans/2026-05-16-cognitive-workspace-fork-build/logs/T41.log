+            "usefulness_prior" => Self::UsefulnessPrior,
+            "recent_usefulness" => Self::RecentUsefulness,
+            "retrieval_accuracy" => Self::RetrievalAccuracy,
+            "regression_risk" => Self::RegressionRisk,
