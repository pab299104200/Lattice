        let graph_state = GraphSnapshot::from_graph(graph);
        let memory_state = MemorySnapshot::from_store(memory)?;
        let taken_at = DateTime::from_unix_seconds(now_unix_seconds());
        Ok(Self::with_hash(
            taken_at,
            up_to_event_id,
            graph_state,
            memory_state,
        )?)
    }

