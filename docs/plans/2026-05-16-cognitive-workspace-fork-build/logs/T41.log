+                })
+            })
+            .map_err(|e| {
+                LatticeError::Storage(format!("Failed to execute memory access query: {}", e))
+            })?;
+        rows.collect::<Result<Vec<_>, _>>()
+            .map_err(|e| LatticeError::Storage(format!("Failed to read memory access row: {}", e)))
+    }
