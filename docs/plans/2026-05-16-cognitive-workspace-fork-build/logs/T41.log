+                        entry.kind,
+                        entry.reference,
+                        entry.detail,
+                        entry.captured_at.map(|value| value as i64),
+                    ],
+                )
+                .map_err(|e| {
+                    LatticeError::Storage(format!("Failed to sync memory evidence row: {}", e))
+                })?;
+        }
         Ok(())
     }
 
@@ -1885,6 +2228,24 @@
     )
 }
 
+#[cfg(test)]
+pub fn reset_direct_write_count() {
+    DIRECT_WRITE_COUNT.store(0, Ordering::Relaxed);
+}
+
+#[cfg(test)]
+pub fn direct_write_count() -> usize {
+    DIRECT_WRITE_COUNT.load(Ordering::Relaxed)
+}
+
+#[cfg(not(test))]
+fn record_direct_write() {}
+
+#[cfg(test)]
+fn record_direct_write() {
+    DIRECT_WRITE_COUNT.fetch_add(1, Ordering::Relaxed);
+}
