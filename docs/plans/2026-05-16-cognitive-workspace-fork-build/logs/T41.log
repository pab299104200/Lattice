+    fixture.seed_memory("Duplicate login memory", vec!["src/auth.ts"], vec!["loginUser"], 10);
+    fixture.seed_memory("Duplicate login memory", vec!["src/auth.ts"], vec!["loginUser"], 20);
+    reset_direct_write_count();
 
-    assert_eq!(runtime.config().max_queue_depth, ConsolidationConfig::default().max_queue_depth);
+    let mut runtime = fixture.runtime();
+    let mut detector = DuplicateDetector::new(&fixture.memory_store, &mut runtime);
+    detector.scan("workspace-main", Some(ProposalKind::Supersede)).unwrap();
+
+    assert_eq!(direct_write_count(), 0);
+    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 2);
+    let proposal = fixture.load_only_proposal();
+    assert!(proposal.prior_state.get("memory").is_some());
+    assert!(proposal.proposed_state.get("memory").is_some());
+}
