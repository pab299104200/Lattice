+    pub fn get_last_verified_at(&self, id: &str) -> Result<Option<u64>, LatticeError> {
+        let value = self
+            .conn
+            .query_row(
+                "SELECT last_verified_at
+                 FROM memories
+                 WHERE id = ?1 AND is_invalidated = 0
+                 LIMIT 1",
+                params![id],
