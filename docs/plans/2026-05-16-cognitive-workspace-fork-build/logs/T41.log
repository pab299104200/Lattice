+            )
+            .map_err(|e| {
+                LatticeError::Storage(format!("Failed to count memory accesses: {}", e))
+            })?;
+        Ok(count.max(0) as u64)
+    }
+
+    pub fn list_memory_accesses(&self, memory_id: &str) -> Result<Vec<MemoryAccessRecord>, LatticeError> {
