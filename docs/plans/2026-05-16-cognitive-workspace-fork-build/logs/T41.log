+                    access_id: row.get(0)?,
+                    accessed_at: row.get::<_, i64>(1)?.max(0) as u64,
+                    inclusion_reason: row.get(2)?,
+                    was_used: row.get::<_, Option<i64>>(3)?.map(|value| value != 0),
+                })
+            })
+            .map_err(|e| {
