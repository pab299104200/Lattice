+            self.store_memory(repo_memory("mem-repo-leak", "workspace-other", None)),
+            self.store_memory(org_memory("mem-org-leak", "org-a")),
+        ]
+    }
+
+    fn run_scope_leak_queries(&self) -> Vec<Vec<Memory>> {
+        vec![
+            self.memory_store
+                .list_all_scoped(
