+) {
+    assert!(!bundle.trusted.iter().any(|memory| memory.memory_id.ulid == memory_id));
+    assert_eq!(
+        bundle
+            .advisory
+            .iter()
+            .find(|memory| memory.memory_id.ulid == memory_id)
+            .expect("memory in advisory")
