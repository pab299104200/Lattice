                     confidence_reason = ?3,
                     supersedes_memory_id = ?4,
                     superseded_by_memory_id = ?5,
                     contradicts_memory_ids = ?6,
                     contradicted_by_memory_ids = ?7,
                     freshness_policy = ?8,
                     freshness_policy_detail = ?9,
                     provenance_json = ?10,
