+        &self,
+        memories: Vec<Memory>,
+        scope: &ScopeFilter,
+        context: &str,
+    ) -> Result<Vec<Memory>, LatticeError> {
+        let mut allowed = Vec::with_capacity(memories.len());
+        for memory in memories {
+            if scope_allows(&memory, scope) {
+                allowed.push(memory);
+                continue;
+            }
+            self.handle_scope_boundary_failure(&memory, scope, context)?;
+        }
+        Ok(allowed)
