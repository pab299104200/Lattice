        })?;
        let evidence_json = serde_json::to_string(&fields.evidence).map_err(|e| {
            LatticeError::Storage(format!("Failed to serialize evidence metadata: {}", e))
        })?;

        let updated = self
            .conn
            .execute(
                "UPDATE memories
