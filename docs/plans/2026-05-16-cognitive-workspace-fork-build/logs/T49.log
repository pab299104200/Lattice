+        _line_end: u32,
+    ) -> Result<Option<Vec<u8>>, SpanValidationError> {
+        if let Some(bytes) = self.line_bytes.as_ref() {
+            self.line_bytes_read
+                .set(self.line_bytes_read.get() + bytes.len());
+        }
+        Ok(self.line_bytes.clone())
+    }
 }
