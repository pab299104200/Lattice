+        .map(|anchor| anchor.source_span)
+        .expect("symbol span");
+    let resolved = resolve_anchors(anchors, &fixture.resolver);
+    let resolved_span = resolved
+        .iter()
+        .find(|anchor| anchor.anchor_text.contains("src/auth.rs::login_user"))
+        .map(|anchor| anchor.source_span)
+        .expect("resolved span");
