+        .build();
+    let task = "Investigate missing file `src/missing.rs`";
+    let resolved = resolve_anchors(extract_anchors(task, &classify_intent(task)), &fixture.resolver);
+    let path = resolved
+        .into_iter()
+        .find(|anchor| anchor.kind == AnchorKind::Path)
+        .expect("path anchor");
+
+    match path.resolution {
+        AnchorResolution::Unresolved { reason } => {
