{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012hsWY9frWvjY6DDuKt2CUF","type":"tool_result","content":"1\t//! Phase 9 regression coverage for `## Measurable Success Criteria` and\n2\t//! `## Phase 9: Metrics And Evaluation`.\n3\t//!\n4\t//! Initial targets:\n5\t//!\n6\t//! - 30 percent fewer discovery tool calls on benchmark tasks\n7\t//! - 40 percent fewer irrelevant file reads\n8\t//! - 80 percent memory inclusion precision on curated memory benchmarks\n9\t//! - zero trusted display of known contradicted memory\n10\t//! - zero trusted display of known stale memory without stale label\n11\t//! - 90 percent correct relevant-test recommendation on curated tasks\n12\t\n13\tuse std::collections::{BTreeMap, BTreeSet};\n14\tuse std::fs;\n15\tuse std::path::{Path, PathBuf};\n16\tuse std::sync::Arc;\n17\t\n18\tuse serde::{Deserialize, Serialize};\n19\tuse tempfile::TempDir;\n20\tuse tracing::info;\n21\t\n22\tuse super::report::{\n23\t    RegressionReport, RegressionReportRow, ReportInput, ReportRowStatus, SuccessCriteriaThresholds,\n24\t};\n25\tuse crate::events::{\n26\t    Actor, BranchRef, CompactSummary, EventPayload, EventQuery, EventReader, EventStore,\n27\t    EventWriter, FileReadPayload, FlushPolicy, PartialEnvelope, PatchAppliedPayload,\n28\t    PlanCreatedPayload, QueryOrder, SessionId, TaskId, ToolCalledPayload, WorkflowSucceededPayload,\n29\t};\n30\tuse crate::graph::CodeGraph;\n31\tuse crate::identity::{FileId, MemoryId, WorkspaceId};\n32\tuse crate::indexer::Indexer;\n33\tuse crate::intelligence::{\n34\t    find_relevant_tests, prepare_change, BundleMode, ProjectRule, RulesDetector,\n35\t};\n36\tuse crate::metrics::{\n37\t    AnchorRecallSample, MemorySurfaceRecord, MetricSampleScope, MetricScope, MetricSignal,\n38\t    MetricSource, MetricValue, MetricsCollector, TestRecommendationSample,\n39\t};\n40\tuse crate::query::QueryEngine;\n41\tuse crate::verification::VerificationStatus;\n42\tuse crate::DateTime;\n43\t\n44\tconst SESSION_ID: &str = \"t69-regression\";\n45\tconst FIXED_TIME: i64 = 1_779_000_000;\n46\t\n47\tmacro_rules! success_criteria_tests {\n48\t    ($($name:ident: $signal:expr, $threshold:ident;)*) => {$(\n49\t        #[test]\n50\t        fn $name() {\n51\t            let run = MetricsTestHarness::run().expect(\"T69 metrics harness run\");\n52\t            assert_report_row_passes(&run, $signal, Some(run.thresholds.$threshold));\n53\t        }\n54\t    )*};\n55\t}\n56\t\n57\tsuccess_criteria_tests! {\n58\t    test_discovery_tool_calls_at_least_30pct_below_baseline: MetricSignal::ToolCallsPerSuccessfulTask, discovery_tool_calls_reduction;\n59\t    test_irrelevant_file_reads_at_least_40pct_below_baseline: MetricSignal::IrrelevantFilesOpenedPerTask, irrelevant_file_reads_reduction;\n60\t    test_memory_inclusion_precision_at_least_80pct: MetricSignal::MemoryInclusionPrecision, memory_inclusion_precision;\n61\t    test_zero_trusted_display_of_contradicted_memory: MetricSignal::ContradictionMissedRate, contradiction_missed_rate;\n62\t    test_zero_trusted_display_of_stale_memory_without_label: MetricSignal::StaleMemorySurfacedRate, stale_memory_unlabeled_rate;\n63\t    test_relevant_test_recommendation_at_least_90pct: MetricSignal::TestsRecommendedVsNeeded, tests_recommended_vs_needed;\n64\t}\n65\t\n66\tstruct MetricsTestHarness {\n67\t    root: TempDir,\n68\t    event_store: Arc<EventStore>,\n69\t    writer: EventWriter,\n70\t    tasks: Vec<GoldenTask>,\n71\t}\n72\t\n73\tstruct HarnessRun {\n74\t    _root: TempDir,\n75\t    report: RegressionReport,\n76\t    thresholds: SuccessCriteriaThresholds,\n77\t}\n78\t\n79\t#[derive(Clone, Debug, Deserialize)]\n80\tstruct GoldenTask {\n81\t    task_id: String,\n82\t    repo: String,\n83\t    #[serde(rename = \"intent\")]\n84\t    _intent: String,\n85\t    task_prompt: String,\n86\t    expected_anchors: Vec<ExpectedAnchor>,\n87\t    expected_tests: Vec<String>,\n88\t}\n89\t\n90\t#[derive(Clone, Debug, Deserialize)]\n91\tstruct ExpectedAnchor {\n92\t    file: String,\n93\t    symbol: String,\n94\t}\n95\t\n96\t#[derive(Clone, Debug, Deserialize)]\n97\tstruct LegacyBaselineMetric {\n98\t    name: String,\n99\t    candidate_count: u64,\n100\t}\n101\t\n102\t#[derive(Clone, Debug, Serialize)]\n103\tstruct FixtureBenchmarkReport {\n104\t    fixture: String,\n105\t    task_reports: Vec<TaskReport>,\n106\t    metrics: Vec<MetricValue>,\n107\t}\n108\t\n109\t#[derive(Clone, Debug, Serialize)]\n110\tstruct TaskReport {\n111\t    task_id: String,\n112\t    tool_reports: Vec<ToolReport>,\n113\t    returned_anchors: Vec<String>,\n114\t    expected_anchors: Vec<String>,\n115\t    expected_tests: Vec<String>,\n116\t    recommended_tests: Vec<String>,\n117\t}\n118\t\n119\t#[derive(Clone, Debug, Serialize)]\n120\tstruct ToolReport {\n121\t    tool: String,\n122\t}\n123\t\n124\timpl MetricsTestHarness {\n125\t    fn run() -> Result<HarnessRun, String> {\n126\t        assert_baseline_file_exists()?;\n127\t        let mut harness = Self::new()?;\n128\t        let task_reports = harness.run_fixture_tasks()?;\n129\t        let events = harness.read_session_events()?;\n130\t        let metrics = harness.collect_metrics(&events, &task_reports);\n131\t        let benchmark_path = harness.write_benchmark_report(&task_reports, &metrics)?;\n132\t        let report = harness.build_report(&benchmark_path, &metrics)?;\n133\t        assert_temp_event_store_exists(harness.root.path())?;\n134\t        Ok(HarnessRun {\n135\t            _root: harness.root,\n136\t            report,\n137\t            thresholds: SuccessCriteriaThresholds::initial(),\n138\t        })\n139\t    }\n140\t\n141\t    fn new() -> Result<Self, String> {\n142\t        let root = TempDir::new().map_err(|error| format!(\"create T69 temp root: {error}\"))?;\n143\t        fs::create_dir_all(root.path().join(\".lattice\"))\n144\t            .map_err(|error| format!(\"create isolated .lattice directory: {error}\"))?;\n145\t        let event_store = Arc::new(\n146\t        