+         VALUES (?1, ?2)",
+        params![2, now_unix_micros()],
+    )?;
+    tx.commit()?;
+    debug!(
+        migration_id = EVENT_SCHEMA_MIGRATION_ID,
+        target_version = 2,
+        "applied event compaction control schema"
+    );
+    Ok(())
+}
+
 fn now_unix_micros() -> i64 {
     SystemTime::now()
         .duration_since(UNIX_EPOCH)
