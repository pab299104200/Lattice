@@ -6,7 +6,7 @@
 use super::store::EventStoreError;
 
 pub const EVENT_SCHEMA_MIGRATION_ID: &str = "p2_001_events";
-pub const EVENT_SCHEMA_TARGET_VERSION: i64 = 1;
+pub const EVENT_SCHEMA_TARGET_VERSION: i64 = 2;
 
