+        "CREATE TABLE IF NOT EXISTS event_compaction_control (
+            id INTEGER PRIMARY KEY CHECK (id = 1),
+            allow_delete INTEGER NOT NULL DEFAULT 0 CHECK (allow_delete IN (0, 1))
