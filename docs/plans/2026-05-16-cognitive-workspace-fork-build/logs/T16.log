+    pub fn compactable_event_count_after(&self, row_id: i64) -> Result<u64, EventStoreError> {
+        let conn = self.lock_conn()?;
+        let count: i64 = conn.query_row(
+            "SELECT COUNT(*) FROM events
+             WHERE event_id > ?1
+               AND NOT (kind = 'memory_consolidated'
