    pub value: String,
}

/// Actor responsible for an event.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
pub enum Actor {
    /// Assistant-generated event attributed to a model id.
    Assistant {
        /// Model name that produced the event.
        model: String,
    },
    /// Direct user-authored event.
    User,
