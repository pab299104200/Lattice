+            Some(row) => Some(EventCursor {
+                row_id: row.get(0)?,
+                event_uuid: row.get(1)?,
+                workspace_id: row.get(2)?,
+                branch: row.get(3)?,
+            }),
+            None => None,
+        };
+        Ok(cursor)
+    }
