+    pub fn latest_cursor(&self) -> Result<Option<EventCursor>, EventStoreError> {
+        let conn = self.lock_conn()?;
+        let mut statement = conn.prepare(
+            "SELECT event_id, event_uuid, workspace_id, branch
+             FROM events
+             ORDER BY event_id DESC
+             LIMIT 1",
