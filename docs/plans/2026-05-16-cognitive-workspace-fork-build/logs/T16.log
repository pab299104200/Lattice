 }
 
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct EventCursor {
+    pub row_id: i64,
+    pub event_uuid: String,
+    pub workspace_id: String,
+    pub branch: String,
+}
+
 pub struct EventStore {
