import { ReviewI18n } from '../i18n';

export function renderStatusBadge(status: string, i18n: ReviewI18n): string {
    const tone = badgeTone(status);
    const label = i18n.has(`reviewStatus.${status}`)
        ? i18n.t(`reviewStatus.${status}`)
        : humanize(status);
    return `<span class="status-badge status-badge--${escapeHtml(tone)}">${escapeHtml(label)}</span>`;
}

function badgeTone(status: string): string {
    switch (status) {
        case 'verified':
        case 'applied':
            return 'success';
        case 'stale':
        case 'expired':
        case 'pending':
        case 'in_review':
            return 'warning';
        case 'contradicted':
        case 'invalidated':
        case 'rejected':
            return 'error';
        case 'superseded':
            return 'info';
        default:
            return 'neutral';
    }
}

function humanize(value: string): string {
    return value
        .split('_')
        .filter(Boolean)
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join(' ');
}

function escapeHtml(value: string): string {
    return value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
}

