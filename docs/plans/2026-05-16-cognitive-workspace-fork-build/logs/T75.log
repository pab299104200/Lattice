+        { label: allLabel, value: '' },
+        ...values.map((value) => ({ label: value, value })),
+    ];
+    const selection = await vscode.window.showQuickPick(picks, {
+        title,
+        placeHolder: placeholder,
+        ignoreFocusOut: true,
+    });
