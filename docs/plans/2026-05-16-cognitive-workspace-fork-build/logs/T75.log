        '<p>' + escape(route ? route.description : copy.overviewDescription) + '</p>' +
        '<p>' + escape(support.mode === 'unsupported' ? copy.routeUnavailable : copy.routePlaceholder) + '</p>' +
        '<small>' + escape(support.reason) + '</small>' +
