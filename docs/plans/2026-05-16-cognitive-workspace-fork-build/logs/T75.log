+    }
+    if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+        return '';
+    }
+    const record = value as Record<string, unknown>;
+    const type = typeof record.type === 'string' ? record.type : '';
+    const label = typeof record.label === 'string' ? record.label : '';
+    if (label) {
