+            return false;
+        }
+        if (state.sessionId && event.sessionId !== state.sessionId) {
+            return false;
+        }
+        if (state.taskId && event.taskId !== state.taskId) {
+            return false;
+        }
+        if (state.workspaceId && event.workspaceId !== state.workspaceId) {
+            return false;
+        }
+        if (state.branch && event.branch !== state.branch) {
