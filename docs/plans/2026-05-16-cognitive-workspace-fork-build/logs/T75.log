+    identity: string;
+    decision: 'included' | 'excluded' | 'expanded';
+    score: number;
+    topSignals: ReviewRetrievalCandidateSignal[];
+    reason: string;
+    allSignals: ReviewRetrievalCandidateSignal[];
+}
+
+export interface ReviewRetrievalExcludedCandidate {
+    identity: string;
+    source: string;
