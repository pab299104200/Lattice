@@ -202,3 +211,12 @@
 fn reference_label(reference: &StableRef) -> String {
     serde_json::to_string(reference).unwrap_or_else(|_| "reference".to_string())
 }
+
+fn actor_label(actor: &lattice_core::events::Actor) -> String {
