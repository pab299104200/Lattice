     .collect()\n243\t    }\n244\t\n245\t    fn contradiction_pair(&self) -> ContradictionCandidatePair {\n246\t        let first = memory(\"mem-a\", \"The build uses cargo check for verification.\");\n247\t        let second = memory(\"mem-b\", \"The build never uses cargo check.\");\n248\t        self.memory_store.store(first.clone()).unwrap();\n249\t        self.memory_store.store(second.clone()).unwrap();\n250\t        ContradictionCandidatePair {\n251\t            first,\n252\t            second,\n253\t            deterministic_reason: \"overlapping build verification assertions\".to_string(),\n254\t        }\n255\t    }\n256\t\n257\t    fn diagnostic_cluster(&self) -> DiagnosticCluster {\n258\t        self.append_task_event(\"diag-task\", diagnostic(\"diag-a\", \"borrow checker failure\"));\n259\t        self.append_task_event(\"diag-task\", diagnostic(\"diag-b\", \"borrow checker failure\"));\n260\t        let events = EventQuery::new()\n261\t            .workspace(\"workspace-main\")\n262\t            .task(\"diag-task\")\n263\t            .order(QueryOrder::OldestFirst)\n264\t            .execute(&EventReader::new(self.event_store.clone()))\n265\t            .unwrap();\n266\t        DiagnosticCluster {\n267\t            cluster_id: \"borrow-checker\".to_string(),\n268\t            diagnostics: events,\n269\t        }\n270\t    }\n271\t\n272\t    fn append_task_event(&self, task_id: &str, payload: EventPayload) -> EventId {\n273\t        let kind = payload.kind();\n274\t        self.event_writer\n275\t            .append(PartialEnvelope {\n276\t                workspace_id: Some(\"workspace-main\".to_string()),\n277\t                branch: BranchRef {\n278\t                    name: \"main\".to_string(),\n279\t                },\n280\t                session_id: SessionId {\n281\t                    value: \"session-main\".to_string(),\n282\t                },\n283\t                task_id: Some(TaskId {\n284\t                    value: task_id.to_string(),\n285\t                }),\n286\t                actor: Actor::Daemon,\n287\t                kind,\n288\t                references: Vec::new(),\n289\t                summary: CompactSummary::new(kind.as_str()).unwrap(),\n290\t                payload,\n291\t            })\n292\t            .unwrap()\n293\t    }\n294\t}\n295\t\n296\t#[derive(Clone)]\n297\tstruct FakeDriver {\n298\t    responses: Arc<Mutex<Vec<Result<String, LlmDriverError>>>>,\n299\t    calls: Arc<Mutex<Vec<LlmRequest>>>,\n300\t}\n301\t\n302\timpl FakeDriver {\n303\t    fn new() -> Self {\n304\t        Self {\n305\t            responses: Arc::new(Mutex::new(Vec::new())),\n306\t            calls: Arc::new(Mutex::new(Vec::new())),\n307\t        }\n308\t    }\n309\t\n310\t    fn push_ok(&self, response: String) {\n311\t        self.responses.lock().unwrap().push(Ok(response));\n312\t    }\n313\t\n314\t    fn push_error(&self, error: LlmDriverError) {\n315\t        self.responses.lock().unwrap().push(Err(error));\n316\t    }\n317\t\n318\t    fn call_count(&self) -> usize {\n319\t        self.calls.lock().unwrap().len()\n320\t    }\n321\t}\n322\t\n323\timpl LlmDriver for FakeDriver {\n324\t    fn complete(&self, request: LlmRequest) -> Result<LlmResponse, LlmDriverError> {\n325\t        self.calls.lock().unwrap().push(request);\n326\t        self.responses\n327\t            .lock()\n328\t            .unwrap()\n329\t            .pop()\n330\t            .unwrap_or_else(|| Err(LlmDriverError::Failed(\"missing fake response\".to_string())))\n331\t            .map(|content| LlmResponse { content })\n332\t    }\n333\t\n334\t    fn name(&self) -> &str {\n335\t        \"fake-llm\"\n336\t    }\n337\t}\n338\t\n339\tstruct DbPath(std::path::PathBuf);\n340\t\n341\timpl DbPath {\n342\t    fn path(&self) -> &std::path::Path {\n343\t        self.0.as_path()\n344\t    }\n345\t}\n346\t\n347\tfn background_ctx() -> LlmJobContext {\n348\t    LlmJobContext {\n349\t        workspace_id: \"workspace-main\".to_string(),\n350\t        mode: ConsolidationMode::Background,\n351\t        budget_catalog: BudgetCatalog::default(),\n352\t    }\n353\t}\n354\t\n355\tfn synchronous_ctx() -> LlmJobContext {\n356\t    LlmJobContext {\n357\t        workspace_id: \"workspace-main\".to_string(),\n358\t        mode: ConsolidationMode::SynchronousPostTask,\n359\t        budget_catalog: BudgetCatalog::default(),\n360\t    }\n361\t}\n362\t\n363\tfn tool_called(tool: &str, summary: &str) -> EventPayload {\n364\t    EventPayload::ToolCalled(ToolCalledPayload {\n365\t        call_id: format!(\"call-{tool}\"),\n366\t        tool_name: tool.to_string(),\n367\t        context_handle_id: None,\n368\t        source_event_id: None,\n369\t        input_summary: summary.to_string(),\n370\t    })\n371\t}\n372\t\n373\tfn tool_result(tool: &str, summary: &str) -> EventPayload {\n374\t    EventPayload::ToolResult(ToolResultPayload {\n375\t        call_id: format!(\"call-{tool}\"),\n376\t        tool_name: tool.to_string(),\n377\t        status: ToolResultStatus::Succeeded,\n378\t        tool_call_event_id: None,\n379\t        output_context_handle_id: None,\n380\t        created_memory_ids: Vec::new(),\n381\t        output_summary: summary.to_string(),\n382\t    })\n383\t}\n384\t\n385\tfn workflow_succeeded(summary: &str) -> EventPayload {\n386\t    EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n387\t        workflow_name: \"workflow-build\".to_string(),\n388\t        terminal_event_id: None,\n389\t        output_context_handle_id: None,\n390\t        memory_ids: Vec::new(),\n391\t        result_summary: summary.to_string(),\n392\t    })\n393\t}\n394\t\n395\tfn diagnostic(id: &str, message: &str) -> EventPayload {\n396\t    EventPayload::DiagnosticObserved(DiagnosticObservedPayload {\n397\t        diagnostic_id: id.to_string(),\n398\t        source_event_id: None,\n399\t        file_id: FileId {\n400\t            workspace_id: \"workspace-main\".to_string(),\n401\t            repo_relative_path: \"src/lib.rs\".to_string(),\n402\t            content_hash: \"abcdef12\".to_string(),\n403\t        },\n404\t        symbol_id: None,\n405\t        severity: DiagnosticSeverity::Error,\n406\t        message: message.to_string(),\n407\t    })\n408\t}\n409\t\n410\tfn memory(id: &str, content: &str) -> Memory {\n411\t    Memory {\n412\t        id: id.to_string(),\n413\t        session_id: \"session-main\".to_string(),\n414\t        content: content.to_string(),\n415\t        memory_type: MemoryType::Observation,\n416\t        scope: MemoryScope::Session,\n417\t        confidence: 0.9,\n418\t        linked_symbols: Vec::new(),\n419\t        linked_files: Vec::new(),\n420\t        workspace_id: Some(\"workspace-main\".to_string()),\n421\t        branch: Some(\"main\".to_string()),\n422\t        refresh_key: None,\n423\t        source_query: None,\n424\t        created_at: 1,\n425\t        last_accessed: 1,\n426\t        access_count: 0,\n427\t        is_stale: false,\n428\t        stale_reason: None,\n429\t    }\n430\t}\n431\t\n432\tfn proposal_count(path: &std::path::Path) -> i64 {\n433\t    Connection::open(path)\n434\t        .unwrap()\n435\t        .query_row(\"SELECT COUNT(*) FROM consolidation_proposals\", [], |row| {\n436\t            row.get(0)\n437\t        })\n438\t        .unwrap()\n439\t}\n440\t\n441\tfn failure_event_count(fixture: &Fixture) -> usize {\n442\t    EventQuery::new()\n443\t        .workspace(\"workspace-main\")\n444\t        .branch(\"main\")\n445\t        .kind(EventKind::ConsolidationFailed)\n446\t        .execute(&EventReader::new(fixture.event_store.clone()))\n447\t        .unwrap()\n448\t        .len()\n449\t}\n450\t\n451\tfn episode_response() -> String {\n452\t    json!({\n453\t        \"summary\": \"Implemented the build workflow and verified it.\",\n454\t        \"outcome\": \"success\",\n455\t        \"salient_facts\": [\"cargo test passed\"],\n456\t        \"linked_files\": [\"src/lib.rs\"],\n457\t        \"linked_symbols\": [\"build_workflow\"],\n458\t        \"confidence\": 0.91\n459\t    })\n460\t    .to_string()\n461\t}\n462\t\n463\tfn procedure_response() -> String {\n464\t    json!({\n465\t        \"title\": \"Build verification procedure\",\n466\t        \"steps\": [\"Inspect code\", \"Run cargo test\", \"Record result\"],\n467\t        \"preconditions\": [\"Rust workspace is present\"],\n468\t        \"postconditions\": [\"Tests pass\"],\n469\t        \"tools_used\": [\"cargo test\"],\n470\t        \"confidence\": 0.88\n471\t    })\n472\t    .to_string()\n473\t}\n474\t\n475\tfn contradiction_response() -> String {\n476\t    json!({\n477\t        \"is_contradiction\": true,\n478\t        \"contradicted_memory_id\": \"mem-b\",\n479\t        \"contradicting_memory_id\": \"mem-a\",\n480\t        \"rationale\": \"One asserts cargo check is never used while the other says it is used.\"\n481\t    })\n482\t    .to_string()\n483\t}\n484\t\n485\tfn failure_pattern_response() -> String {\n486\t    json!({\n487\t        \"summary\": \"Repeated borrow checker failures after shared state edits.\",\n488\t        \"recurrence_signal\": \"Two diagnostics share the same compiler failure shape.\",\n489\t        \"likely_causes\": [\"mutable aliasing in shared state\"],\n490\t        \"recovery_steps\": [\"isolate ownership\", \"add regression test\"],\n491\t        \"confidence\": 0.84\n492\t    })\n493\t    .to_string()\n494\t}\n495\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"a61f5d6b-7a6f-49aa-ae85-c77089cdaf4b","timestamp":"2026-05-17T11:42:44.919Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/llm/llm_tests.rs","content":"        .unwrap();\n        let event_store = Arc::new(EventStore::open_in_memory().unwrap());\n        let event_writer =\n            EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096);\n        Self {\n            _dir: dir,\n            consolidation_db,\n            memory_store,\n            runtime,\n            event_store,\n            event_writer,\n            driver: FakeDriver::new(),\n        }\n    }\n\n    fn services(&mut self) -> LlmJobServices<'_> {\n        LlmJobServices {\n            driver: &self.driver,\n            runtime: &mut self.runtime,\n            memory_store: &self.memory_store,\n            event_writer: &self.event_writer,\n        }\n    }\n\n    fn task_slice(&self, task_id: &str) -> Vec<crate::events::EventEnvelope> {\n        self.append_task_event(task_id, tool_called(\"read\", \"inspect sources\"));\n        self.append_task_event(task_id, tool_result(\"read\", \"loaded source\"));\n        self.append_task_event(task_id, workflow_succeeded(\"implemented change\"));\n        EventQuery::new()\n            .workspace(\"workspace-main\")\n            .task(task_id)\n            .order(QueryOrder::OldestFirst)\n            .execute(&EventReader::new(self.event_store.clone()))\n            .unwrap()\n    }\n\n    fn workflow_occurrences(&self) -> Vec<WorkflowOccurrence> {\n        (0..3)\n            .map(|index| WorkflowOccurrence {\n                occurrence_id: format!(\"occurrence-{index}\"),\n                events: self.task_slice(&format!(\"workflow-{index}\")),\n            })\n            .collect()\n    }\n\n    fn contradiction_pair(&self) -> ContradictionCandidatePair {\n        let first = memory(\"mem-a\", \"The build uses cargo check for verification.\");\n        let second = memory(\"mem-b\", \"The build never uses cargo check.\");\n        self.memory_store.store(first.clone()).unwrap();\n        self.memory_store.store(second.clone()).unwrap();\n        ContradictionCandidatePair {\n            first,\n            second,\n            deterministic_reason: \"overlapping build verification assertions\".to_string(),\n        }\n    }\n\n    fn diagnostic_cluster(&self) -> DiagnosticCluster {\n        self.append_task_event(\"diag-task\", diagnostic(\"diag-a\", \"borrow checker failure\"));\n        self.append_task_event(\"diag-task\", diagnostic(\"diag-b\", \"borrow checker failure\"));\n        let events = EventQuery::new()\n            .workspace(\"workspace-main\")\n            .task(\"diag-task\")\n            .order(QueryOrder::OldestFirst)\n            .execute(&EventReader::new(self.event_store.clone()))\n            .unwrap();\n        DiagnosticCluster {\n            cluster_id: \"borrow-checker\".to_string(),\n            diagnostics: events,\n        }\n    }\n\n    fn append_task_event(&self, task_id: &str, payload: EventPayload) -> EventId {\n        let kind = payload.kind();\n        self.event_writer\n            .append(PartialEnvelope {\n                workspace_id: Some(\"workspace-main\".to_string()),\n                branch: BranchRef {\n                    name: \"main\".to_string(),\n                },\n                session_id: SessionId {\n                    value: \"session-main\".to_string(),\n                },\n                task_id: Some(TaskId {\n                    value: task_id.to_string(),\n                }),\n                actor: Actor::Daemon,\n                kind,\n                references: Vec::new(),\n                summary: CompactSummary::new(kind.as_str()).unwrap(),\n                payload,\n            })\n            .unwrap()\n    }\n}\n\n#[derive(Clone)]\nstruct FakeDriver {\n    responses: Arc<Mutex<Vec<Result<String, LlmDriverError>>>>,\n    calls: Arc<Mutex<Vec<LlmRequest>>>,\n}\n\nimpl FakeDriver {\n    fn new() -> Self {\n        Self {\n            responses: Arc::new(Mutex::new(Vec::new())),\n            calls: Arc::new(Mutex::new(Vec::new())),\n        }\n    }\n\n    fn push_ok(&self, response: String) {\n        self.responses.lock().unwrap().push(Ok(response));\n    }\n\n    fn push_error(&self, error: LlmDriverError) {\n        self.responses.lock().unwrap().push(Err(error));\n    }\n\n    fn call_count(&self) -> usize {\n        self.calls.lock().unwrap().len()\n    }\n}\n\nimpl LlmDriver for FakeDriver {\n    fn complete(&self, request: LlmRequest) -> Result<LlmResponse, LlmDriverError> {\n        self.calls.lock().unwrap().push(request);\n        self.responses\n            .lock()\n            .unwrap()\n            .pop()\n            .unwrap_or_else(|| Err(LlmDriverError::Failed(\"missing fake response\".to_string())))\n            .map(|content| LlmResponse { content })\n    }\n\n    fn name(&self) -> &str {\n        \"fake-llm\"\n    }\n}\n\nstruct DbPath(std::path::PathBuf);\n\nimpl DbPath {\n    fn path(&self) -> &std::path::Path {\n        self.0.as_path()\n    }\n}\n\nfn background_ctx() -> LlmJobContext {\n    LlmJobContext {\n        workspace_id: \"workspace-main\".to_string(),\n        mode: ConsolidationMode::Background,\n        budget_catalog: BudgetCatalog::default(),\n    }\n}\n\nfn synchronous_ctx() -> LlmJobContext {\n    LlmJobContext {\n        workspace_id: \"workspace-main\".to_string(),\n        mode: ConsolidationMode::SynchronousPostTask,\n        budget_catalog: BudgetCatalog::default(),\n    }\n}\n\nfn tool_called(tool: &str, summary: &str) -> EventPayload {\n    EventPayload::ToolCalled(ToolCalledPayload {\n        call_id: format!(\"call-{tool}\"),\n        tool_name: tool.to_string(),\n        context_handle_id: None,\n        source_event_id: None,\n        input_summary: summary.to_string(),\n    })\n}\n\nfn tool_result(tool: &str, summary: &str) -> EventPayload {\n    EventPayload::ToolResult(ToolResultPayload {\n        call_id: format!(\"call-{tool}\"),\n        tool_name: tool.to_string(),\n        status: ToolResultStatus::Succeeded,\n        tool_call_event_id: None,\n        output_context_handle_id: None,\n        created_memory_ids: Vec::new(),\n        output_summary: summary.to_string(),\n    })\n}\n\nfn workflow_succeeded(summary: &str) -> EventPayload {\n    EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n        workflow_name: \"workflow-build\".to_string(),\n        terminal_event_id: None,\n        output_context_handle_id: None,\n        memory_ids: Vec::new(),\n        result_summary: summary.to_string(),\n    })\n}\n\nfn diagnostic(id: &str, message: &str) -> EventPayload {\n    EventPayload::DiagnosticObserved(DiagnosticObservedPayload {\n        diagnostic_id: id.to_string(),\n        source_event_id: None,\n        file_id: FileId {\n            workspace_id: \"workspace-main\".to_string(),\n            repo_relative_path: \"src/lib.rs\".to_string(),\n            content_hash: \"abcdef12\".to_string(),\n        },\n        symbol_id: None,\n        severity: DiagnosticSeverity::Error,\n        message: message.to_string(),\n    })\n}\n\nfn memory(id: &str, content: &str) -> Memory {\n    Memory {\n        id: id.to_string(),\n        session_id: \"session-main\".to_string(),\n        content: content.to_string(),\n        memory_type: MemoryType::Observation,\n        scope: MemoryScope::Session,\n        confidence: 0.9,\n        linked_symbols: Vec::new(),\n        linked_files: Vec::new(),\n        workspace_id: Some(\"workspace-main\".to_string()),\n        branch: Some(\"main\".to_string()),\n        refresh_key: None,\n        source_query: None,\n        created_at: 1,\n        last_accessed: 1,\n        access_count: 0,\n        is_stale: false,\n        stale_reason: None,\n    }\n}\n\nfn proposal_count(path: &std::path::Path) -> i64 {\n    Connection::open(path)\n        .unwrap()\n        .query_row(\"SELECT COUNT(*) FROM consolidation_proposals\", [], |row| {\n            row.get(0)\n        })\n        .unwrap()\n}\n\nfn failure_event_count(fixture: &Fixture) -> usize {\n    EventQuery::new()\n        .workspace(\"workspace-main\")\n        .branch(\"main\")\n        .kind(EventKind::ConsolidationFailed)\n        .execute(&EventReader::new(fixture.event_store.clone()))\n        .unwrap()\n        .len()\n}\n\nfn episode_response() -> String {\n    json!({\n        \"summary\": \"Implemented the build workflow and verified it.\",\n        \"outcome\": \"success\",\n        \"salient_facts\": [\"cargo test passed\"],\n        \"linked_files\": [\"src/lib.rs\"],\n        \"linked_symbols\": [\"build_workflow\"],\n        \"confidence\": 0.91\n    })\n    .to_string()\n}\n\nfn procedure_response() -> String {\n    json!({\n        \"title\": \"Build verification procedure\",\n        \"steps\": [\"Inspect code\", \"Run cargo test\", \"Record result\"],\n        \"preconditions\": [\"Rust workspace is present\"],\n        \"postconditions\": [\"Tests pass\"],\n        \"tools_used\": [\"cargo test\"],\n        \"confidence\": 0.88\n    })\n    .to_string()\n}\n\nfn contradiction_response() -> String {\n    json!({\n        \"is_contradiction\": true,\n        \"contradicted_memory_id\": \"mem-b\",\n        \"contradicting_memory_id\": \"mem-a\",\n        \"rationale\": \"One asserts cargo check is never used while the other says it is used.\"\n    })\n    .to_string()\n}\n\nfn failure_pattern_response() -> String {\n    json!({\n        \"summary\": \"Repeated borrow checker failures after shared state edits.\",\n        \"recurrence_signal\": \"Two diagnostics share the same compiler failure shape.\",\n        \"likely_causes\": [\"mutable aliasing in shared state\"],\n        \"recovery_steps\": [\"isolate ownership\", \"add regression test\"],\n        \"confidence\": 0.84\n    })\n    .to_string()\n}\n","numLines":296,"startLine":200,"totalLines":495}}}
docs/plans/2026-05-16-cognitive-workspace-fork-build/logs/R47.log:115:{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VpN68F8yRZnioCaASoqcfk","type":"tool_result","content":"1\tuse std::io::Write;\n2\tuse std::sync::{Arc, Mutex};\n3\t\n4\tuse rusqlite::{params, Connection};\n5\tuse serde_json::json;\n6\tuse tempfile::tempdir;\n7\tuse tracing_subscriber::fmt::MakeWriter;\n8\t\n9\tuse super::*;\n10\tuse crate::events::{EventKind, EventPayload, EventQuery, EventReader, EventStore, EventWriter};\n11\tuse crate::memory::{Memory, MemoryScope, MemoryStore, MemoryType};\n12\t\n13\t#[test]\n14\tfn deterministic_job_emits_proposal_without_mutating_memory() {\n15\t    let fixture = Fixture::new();\n16\t    let mut runtime = fixture.runtime(8);\n17\t    runtime\n18\t        .submit(create_memory_job(\n19\t            \"job-create\",\n20\t            \"proposal-create\",\n21\t            \"created memory\",\n22\t        ))\n23\t        .expect(\"job enqueues\");\n24\t\n25\t    let proposals = runtime.run_due().expect(\"job runs\");\n26\t\n27\t    assert_eq!(proposals.len(), 1);\n28\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n29\t    assert_eq!(\n30\t        proposal_decision(fixture.consolidation_db.path(), \"proposal-create\"),\n31\t        \"pending\"\n32\t    );\n33\t}\n34\t\n35\t#[test]\n36\tfn apply_materializes_memory_and_writes_consolidated_event_with_states() {\n37\t    let fixture = Fixture::new();\n38\t    let mut runtime = fixture.runtime(8);\n39\t    runtime\n40\t        .submit(create_memory_job(\n41\t            \"job-apply\",\n42\t            \"proposal-apply\",\n43\t            \"applied memory\",\n44\t        ))\n45\t        .expect(\"job enqueues\");\n46\t    runtime.run_due().expect(\"job runs\");\n47\t\n48\t    let outcome = runtime\n49\t        .decide(\n50\t            \"proposal-apply\",\n51\t            ProposalDecision::Applied,\n52\t            &fixture.memory_store,\n53\t            &fixture.event_writer,\n54\t            \"operator\",\n55\t        )\n56\t        .expect(\"proposal applies\");\n57\t\n58\t    assert_eq!(\n59\t        outcome,\n60\t        Some(ApplyOutcome::Applied {\n61\t            memory_id: \"mem-proposal-apply\".to_string()\n62\t        })\n63\t    );\n64\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 1);\n65\t    let event = fixture.memory_consolidated_event();\n66\t    match event.payload {\n67\t        EventPayload::MemoryConsolidated(payload) => {\n68\t            assert_eq!(payload.proposal_id.as_deref(), Some(\"proposal-apply\"));\n69\t            assert!(payload.prior_state_json.unwrap().contains(\"{}\"));\n70\t            assert!(payload\n71\t                .proposed_state_json\n72\t                .unwrap()\n73\t                .contains(\"applied memory\"));\n74\t        }\n75\t        _ => panic!(\"expected memory_consolidated payload\"),\n76\t    }\n77\t}\n78\t\n79\t#[test]\n80\tfn reject_leaves_memory_unchanged_and_records_decision() {\n81\t    let fixture = Fixture::new();\n82\t    let mut runtime = fixture.runtime(8);\n83\t    runtime\n84\t        .submit(create_memory_job(\n85\t            \"job-reject\",\n86\t            \"proposal-reject\",\n87\t            \"rejected memory\",\n88\t        ))\n89\t        .expect(\"job enqueues\");\n90\t    runtime.run_due().expect(\"job runs\");\n91\t\n92\t    let outcome = runtime\n93\t        .decide(\n94\t            \"proposal-reject\",\n95\t            ProposalDecision::Rejected,\n96\t            &fixture.memory_store,\n97\t            &fixture.event_writer,\n98\t            \"operator\",\n99\t        )\n100\t        .expect(\"proposal rejects\");\n101\t\n102\t    assert_eq!(outcome, None);\n103\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n104\t    assert_eq!(\n105\t        proposal_decision(fixture.consolidation_db.path(), \"proposal-reject\"),\n106\t        \"rejected\"\n107\t    );\n108\t}\n109\t\n110\t#[test]\n111\tfn double_apply_is_no_op_after_first_decision() {\n112\t    let fixture = Fixture::new();\n113\t    let mut runtime = fixture.runtime(8);\n114\t    runtime\n115\t        .submit(create_memory_job(\n116\t            \"job-double\",\n117\t            \"proposal-double\",\n118\t            \"single memory\",\n119\t        ))\n120\t        .expect(\"job enqueues\");\n121\t    runtime.run_due().expect(\"job runs\");\n122\t\n123\t    runtime\n124\t        .decide(\n125\t            \"proposal-double\",\n126\t            ProposalDecision::Applied,\n127\t            &fixture.memory_store,\n128\t            &fixture.event_writer,\n129\t            \"operator\",\n130\t        )\n131\t        .expect(\"first apply succeeds\");\n132\t    let second = runtime\n133\t        .decide(\n134\t            \"proposal-double\",\n135\t            ProposalDecision::Applied,\n136\t            &fixture.memory_store,\n137\t            &fixture.event_writer,\n138\t            \"operator\",\n139\t        )\n140\t        .expect(\"second apply is handled\");\n141\t\n142\t    assert_eq!(\n143\t        second,\n144\t        Some(ApplyOutcome::AlreadyDecided {\n145\t            decision: ProposalDecision::Applied\n146\t        })\n147\t    );\n148\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 1);\n149\t}\n150\t\n151\t#[test]\n152\tfn queue_drops_jobs_after_depth_bound_and_logs_warning() {\n153\t    let conn = Connection::open_in_memory().expect(\"db opens\");\n154\t    initialize_schema(&conn).expect(\"schema initializes\");\n155\t    let conn = Arc::new(Mutex::new(conn));\n156\t    let logs = Arc::new(Mutex::new(Vec::new()));\n157\t    let subscriber = tracing_subscriber::fmt()\n158\t        .with_writer(BufferWriter(logs.clone()))\n159\t        .with_ansi(false)\n160\t        .finish();\n161\t    let _guard = tracing::subscriber::set_default(subscriber);\n162\t    let mut queue = BoundedJobQueue::new(1, conn);\n163\t\n164\t    let first = queue\n165\t        .enqueue(create_memory_job(\"job-one\", \"proposal-one\", \"one\"))\n166\t        .expect(\"first enqueue succeeds\");\n167\t    let second = queue\n168\t        .enqueue(create_memory_job(\"job-two\", \"proposal-two\", \"two\"))\n169\t        .expect(\"second enqueue returns outcome\");\n170\t\n171\t    assert_eq!(first, EnqueueOutcome::Queued { depth: 1 });\n172\t    assert!(matches!(second, EnqueueOutcome::Dropped { .. }));\n173\t    let log_text = String::from_utf8(logs.lock().unwrap().clone()).unwrap();\n174\t    assert!(log_text.contains(\"consolidation queue full; dropping job\"));\n175\t}\n176\t\n177\t#[test]\n178\tfn consolidation_schema_round_trips_under_memory_store_migration() {\n179\t    let dir = tempdir().expect(\"tempdir\");\n180\t    let path = dir.path().join(\"memory.sqlite\");\n181\t    let store = MemoryStore::open(&path).expect(\"memory store opens\");\n182\t    drop(store);\n183\t    let conn = Connection::open(&path).expect(\"db reopens\");\n184\t    conn.execute(\n185\t        \"INSERT INTO consolidation_jobs\n186\t            (job_id, workspace_id, kind, mode, status, enqueued_at)\n187\t         VALUES ('job-schema', 'workspace-main', 'schema_test', 'background', 'queued', 1)\",\n188\t        [],\n189\t    )\n190\t    .expect(\"job inserts\");\n191\t    let count: i64 = conn\n192\t        .query_row(\"SELECT COUNT(*) FROM consolidation_jobs\", [], |row| {\n193\t            row.get(0)\n194\t        })\n195\t        .expect(\"job count reads\");\n196\t    assert_eq!(count, 1);\n197\t}\n198\t\n199\tstruct Fixture {\n200\t    _dir: tempfile::TempDir,\n201\t    consolidation_db: DbPath,\n202\t    memory_store: MemoryStore,\n203\t    event_store: Arc<EventStore>,\n204\t    event_writer: EventWriter,\n205\t}\n206\t\n207\timpl Fixture {\n208\t    fn new() -> Self {\n209\t        let dir = tempdir().expect(\"tempdir\");\n210\t        let memory_store = MemoryStore::open(&dir.path().join(\"memory.sqlite\")).unwrap();\n211\t        let event_store = Arc::new(EventStore::open_in_memory().unwrap());\n212\t        let event_writer =\n213\t            EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096);\n214\t        Self {\n215\t            consolidation_db: DbPath(dir.path().join(\"consolidation.sqlite\")),\n216\t            _dir: dir,\n217\t            memory_store,\n218\t            event_store,\n219\t            event_writer,\n220\t        }\n221\t    }\n222\t\n223\t    fn runtime(&self, max_queue_depth: usize) -> ConsolidationJobRuntime {\n224\t        let conn = Connection::open(self.consolidation_db.path()).expect(\"db opens\");\n225\t        ConsolidationJobRuntime::new(\n226\t            conn,\n227\t            ConsolidationConfig {\n228\t                max_queue_depth,\n229\t                llm_budget_catalog: None,\n230\t            },\n231\t        )\n232\t        .unwrap()\n233\t    }\n234\t\n235\t    fn memory_consolidated_event(&self) -> crate::events::EventEnvelope {\n236\t        let reader = EventReader::new(self.event_store.clone());\n237\t        let events = EventQuery::new()\n238\t            .workspace(\"workspace-main\")\n239\t            .branch(\"main\")\n240\t            .kind(EventKind::MemoryConsolidated)\n241\t            .execute(&reader)\n242\t            .expect(\"events query succeeds\");\n243\t        events.into_iter().next().expect(\"event exists\")\n244\t    }\n245\t}\n246\t\n247\tstruct DbPath(std::path::PathBuf);\n248\t\n249\timpl DbPath {\n250\t    fn path(&self) -> &std::path::Path {\n251\t        self.0.as_path()\n252\t    }\n253\t}\n254\t\n255\t#[derive(Clone)]\n256\tstruct BufferWriter(Arc<Mutex<Vec<u8>>>);\n257\t\n258\timpl<'a> MakeWriter<'a> for BufferWriter {\n259\t    type Writer = BufferGuard;\n260\t\n261\t    fn make_writer(&'a self) -> Self::Writer {\n262\t        BufferGuard(self.0.clone())\n263\t    }\n264\t}\n265\t\n266\tstruct BufferGuard(Arc<Mutex<Vec<u8>>>);\n267\t\n268\timpl Write for BufferGuard {\n269\t    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {\n270\t        self.0.lock().unwrap().extend_from_slice(buf);\n271\t        Ok(buf.len())\n272\t    }\n273\t\n274\t    fn flush(&mut self) -> std::io::Result<()> {\n275\t        Ok(())\n276\t    }\n277\t}\n278\t\n279\tfn create_memory_job(job_id: &str, proposal_id: &str, content: &str) -> ConsolidationJobSpec {\n280\t    ConsolidationJobSpec {\n281\t        job_id: job_id.to_string(),\n282\t        workspace_id: \"workspace-main\".to_string(),\n283\t        kind: \"deterministic_test\".to_string(),\n284\t        mode: ConsolidationJobMode::Background,\n285\t        proposal: Some(PendingProposalSpec {\n286\t            proposal_id: proposal_id.to_string(),\n287\t            target_memory_id: None,\n288\t            proposal_kind: ProposalKind::CreateMemory,\n289\t            prior_state: empty_state(),\n290\t            proposed_state: serde_json::to_value(memory(proposal_id, content)).unwrap(),\n291\t            evidence: json!({ \"source_memory_ids\": [] }),\n292\t            provenance: None,\n293\t        }),\n294\t    }\n295\t}\n296\t\n297\tfn memory(proposal_id: &str, content: &str) -> Memory {\n298\t    Memory {\n299\t        id: format!(\"mem-{proposal_id}\"),\n300\t        session_id: \"session-main\".to_string(),\n301\t        content: content.to_string(),\n302\t        memory_type: MemoryType::Observation,\n303\t        scope: MemoryScope::Session,\n304\t        confidence: 1.0,\n305\t        linked_symbols: Vec::new(),\n306\t        linked_files: Vec::new(),\n307\t        workspace_id: Some(\"workspace-main\".to_string()),\n308\t        branch: Some(\"main\".to_string()),\n309\t        refresh_key: None,\n310\t        source_query: None,\n311\t        created_at: 1,\n312\t        last_accessed: 1,\n313\t        access_count: 0,\n314\t        is_stale: false,\n315\t        stale_reason: None,\n316\t    }\n317\t}\n318\t\n319\tfn proposal_decision(path: &std::path::Path, proposal_id: &str) -> String {\n320\t    let conn = Connection::open(path).expect(\"db opens\");\n321\t    conn.query_row(\n322\t        \"SELECT decision FROM consolidation_proposals WHERE proposal_id = ?1\",\n323\t        params![proposal_id],\n324\t        |row| row.get(0),\n325\t    )\n326\t    .expect(\"decision reads\")\n327\t}\n328\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"6ea401d4-b38b-428f-ade6-0bdd3310fc1e","timestamp":"2026-05-17T11:43:07.681Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/proposal_tests.rs","content":"use std::io::Write;\nuse std::sync::{Arc, Mutex};\n\nuse rusqlite::{params, Connection};\nuse serde_json::json;\nuse tempfile::tempdir;\nuse tracing_subscriber::fmt::MakeWriter;\n\nuse super::*;\nuse crate::events::{EventKind, EventPayload, EventQuery, EventReader, EventStore, EventWriter};\nuse crate::memory::{Memory, MemoryScope, MemoryStore, MemoryType};\n\n#[test]\nfn deterministic_job_emits_proposal_without_mutating_memory() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime(8);\n    runtime\n        .submit(create_memory_job(\n            \"job-create\",\n            \"proposal-create\",\n            \"created memory\",\n        ))\n        .expect(\"job enqueues\");\n\n    let proposals = runtime.run_due().expect(\"job runs\");\n\n    assert_eq!(proposals.len(), 1);\n    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n    assert_eq!(\n        proposal_decision(fixture.consolidation_db.path(), \"proposal-create\"),\n        \"pending\"\n    );\n}\n\n#[test]\nfn apply_materializes_memory_and_writes_consolidated_event_with_states() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime(8);\n    runtime\n        .submit(create_memory_job(\n            \"job-apply\",\n            \"proposal-apply\",\n            \"applied memory\",\n        ))\n        .expect(\"job enqueues\");\n    runtime.run_due().expect(\"job runs\");\n\n    let outcome = runtime\n        .decide(\n            \"proposal-apply\",\n            ProposalDecision::Applied,\n            &fixture.memory_store,\n            &fixture.event_writer,\n            \"operator\",\n        )\n        .expect(\"proposal applies\");\n\n    assert_eq!(\n        outcome,\n        Some(ApplyOutcome::Applied {\n            memory_id: \"mem-proposal-apply\".to_string()\n        })\n    );\n    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 1);\n    let event = fixture.memory_consolidated_event();\n    match event.payload {\n        EventPayload::MemoryConsolidated(payload) => {\n            assert_eq!(payload.proposal_id.as_deref(), Some(\"proposal-apply\"));\n            assert!(payload.prior_state_json.unwrap().contains(\"{}\"));\n            assert!(payload\n                .proposed_state_json\n                .unwrap()\n                .contains(\"applied memory\"));\n        }\n        _ => panic!(\"expected memory_consolidated payload\"),\n    }\n}\n\n#[test]\nfn reject_leaves_memory_unchanged_and_records_decision() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime(8);\n    runtime\n        .submit(create_memory_job(\n            \"job-reject\",\n            \"proposal-reject\",\n            \"rejected memory\",\n        ))\n        .expect(\"job enqueues\");\n    runtime.run_due().expect(\"job runs\");\n\n    let outcome = runtime\n        .decide(\n            \"proposal-reject\",\n            ProposalDecision::Rejected,\n            &fixture.memory_store,\n            &fixture.event_writer,\n            \"operator\",\n        )\n        .expect(\"proposal rejects\");\n\n    assert_eq!(outcome, None);\n    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n    assert_eq!(\n        proposal_decision(fixture.consolidation_db.path(), \"proposal-reject\"),\n        \"rejected\"\n    );\n}\n\n#[test]\nfn double_apply_is_no_op_after_first_decision() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime(8);\n    runtime\n        .submit(create_memory_job(\n            \"job-double\",\n            \"proposal-double\",\n            \"single memory\",\n        ))\n        .expect(\"job enqueues\");\n    runtime.run_due().expect(\"job runs\");\n\n    runtime\n        .decide(\n            \"proposal-double\",\n            ProposalDecision::Applied,\n            &fixture.memory_store,\n            &fixture.event_writer,\n            \"operator\",\n        )\n        .expect(\"first apply succeeds\");\n    let second = runtime\n        .decide(\n            \"proposal-double\",\n            ProposalDecision::Applied,\n            &fixture.memory_store,\n            &fixture.event_writer,\n            \"operator\",\n        )\n        .expect(\"second apply is handled\");\n\n    assert_eq!(\n        second,\n        Some(ApplyOutcome::AlreadyDecided {\n            decision: ProposalDecision::Applied\n        })\n    );\n    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 1);\n}\n\n#[test]\nfn queue_drops_jobs_after_depth_bound_and_logs_warning() {\n    let conn = Connection::open_in_memory().expect(\"db opens\");\n    initialize_schema(&conn).expect(\"schema initializes\");\n    let conn = Arc::new(Mutex::new(conn));\n    let logs = Arc::new(Mutex::new(Vec::new()));\n    let subscriber = tracing_subscriber::fmt()\n        .with_writer(BufferWriter(logs.clone()))\n        .with_ansi(false)\n        .finish();\n    let _guard = tracing::subscriber::set_default(subscriber);\n    let mut queue = BoundedJobQueue::new(1, conn);\n\n    let first = queue\n        .enqueue(create_memory_job(\"job-one\", \"proposal-one\", \"one\"))\n        .expect(\"first enqueue succeeds\");\n    let second = queue\n        .enqueue(create_memory_job(\"job-two\", \"proposal-two\", \"two\"))\n        .expect(\"second enqueue returns outcome\");\n\n    assert_eq!(first, EnqueueOutcome::Queued { depth: 1 });\n    assert!(matches!(second, EnqueueOutcome::Dropped { .. }));\n    let log_text = String::from_utf8(logs.lock().unwrap().clone()).unwrap();\n    assert!(log_text.contains(\"consolidation queue full; dropping job\"));\n}\n\n#[test]\nfn consolidation_schema_round_trips_under_memory_store_migration() {\n    let dir = tempdir().expect(\"tempdir\");\n    let path = dir.path().join(\"memory.sqlite\");\n    let store = MemoryStore::open(&path).expect(\"memory store opens\");\n    drop(store);\n    let conn = Connection::open(&path).expect(\"db reopens\");\n    conn.execute(\n        \"INSERT INTO consolidation_jobs\n            (job_id, workspace_id, kind, mode, status, enqueued_at)\n         VALUES ('job-schema', 'workspace-main', 'schema_test', 'background', 'queued', 1)\",\n        [],\n    )\n    .expect(\"job inserts\");\n    let count: i64 = conn\n        .query_row(\"SELECT COUNT(*) FROM consolidation_jobs\", [], |row| {\n            row.get(0)\n        })\n        .expect(\"job count reads\");\n    assert_eq!(count, 1);\n}\n\nstruct Fixture {\n    _dir: tempfile::TempDir,\n    consolidation_db: DbPath,\n    memory_store: MemoryStore,\n    event_store: Arc<EventStore>,\n    event_writer: EventWriter,\n}\n\nimpl Fixture {\n    fn new() -> Self {\n        let dir = tempdir().expect(\"tempdir\");\n        let memory_store = MemoryStore::open(&dir.path().join(\"memory.sqlite\")).unwrap();\n        let event_store = Arc::new(EventStore::open_in_memory().unwrap());\n        let event_writer =\n            EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096);\n        Self {\n            consolidation_db: DbPath(dir.path().join(\"consolidation.sqlite\")),\n            _dir: dir,\n            memory_store,\n            event_store,\n            event_writer,\n        }\n    }\n\n    fn runtime(&self, max_queue_depth: usize) -> ConsolidationJobRuntime {\n        let conn = Connection::open(self.consolidation_db.path()).expect(\"db opens\");\n        ConsolidationJobRuntime::new(\n            conn,\n            ConsolidationConfig {\n                max_queue_depth,\n                llm_budget_catalog: None,\n            },\n        )\n        .unwrap()\n    }\n\n    fn memory_consolidated_event(&self) -> crate::events::EventEnvelope {\n        let reader = EventReader::new(self.event_store.clone());\n        let events = EventQuery::new()\n            .workspace(\"workspace-main\")\n            .branch(\"main\")\n            .kind(EventKind::MemoryConsolidated)\n            .execute(&reader)\n            .expect(\"events query succeeds\");\n        events.into_iter().next().expect(\"event exists\")\n    }\n}\n\nstruct DbPath(std::path::PathBuf);\n\nimpl DbPath {\n    fn path(&self) -> &std::path::Path {\n        self.0.as_path()\n    }\n}\n\n#[derive(Clone)]\nstruct BufferWriter(Arc<Mutex<Vec<u8>>>);\n\nimpl<'a> MakeWriter<'a> for BufferWriter {\n    type Writer = BufferGuard;\n\n    fn make_writer(&'a self) -> Self::Writer {\n        BufferGuard(self.0.clone())\n    }\n}\n\nstruct BufferGuard(Arc<Mutex<Vec<u8>>>);\n\nimpl Write for BufferGuard {\n    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {\n        self.0.lock().unwrap().extend_from_slice(buf);\n        Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> std::io::Result<()> {\n        Ok(())\n    }\n}\n\nfn create_memory_job(job_id: &str, proposal_id: &str, content: &str) -> ConsolidationJobSpec {\n    ConsolidationJobSpec {\n        job_id: job_id.to_string(),\n        workspace_id: \"workspace-main\".to_string(),\n        kind: \"deterministic_test\".to_string(),\n        mode: ConsolidationJobMode::Background,\n        proposal: Some(PendingProposalSpec {\n            proposal_id: proposal_id.to_string(),\n            target_memory_id: None,\n            proposal_kind: ProposalKind::CreateMemory,\n            prior_state: empty_state(),\n            proposed_state: serde_json::to_value(memory(proposal_id, content)).unwrap(),\n            evidence: json!({ \"source_memory_ids\": [] }),\n            provenance: None,\n        }),\n    }\n}\n\nfn memory(proposal_id: &str, content: &str) -> Memory {\n    Memory {\n        id: format!(\"mem-{proposal_id}\"),\n        session_id: \"session-main\".to_string(),\n        content: content.to_string(),\n        memory_type: MemoryType::Observation,\n        scope: MemoryScope::Session,\n        confidence: 1.0,\n        linked_symbols: Vec::new(),\n        linked_files: Vec::new(),\n        workspace_id: Some(\"workspace-main\".to_string()),\n        branch: Some(\"main\".to_string()),\n        refresh_key: None,\n        source_query: None,\n        created_at: 1,\n        last_accessed: 1,\n        access_count: 0,\n        is_stale: false,\n        stale_reason: None,\n    }\n}\n\nfn proposal_decision(path: &std::path::Path, proposal_id: &str) -> String {\n    let conn = Connection::open(path).expect(\"db opens\");\n    conn.query_row(\n        \"SELECT decision FROM consolidation_proposals WHERE proposal_id = ?1\",\n        params![proposal_id],\n        |row| row.get(0),\n    )\n    .expect(\"decision reads\")\n}\n","numLines":328,"startLine":1,"totalLines":328}}}
docs/plans/2026-05-16-cognitive-workspace-fork-build/logs/R47.log:119:{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FzUq63CdA2iG78NUkhrrpe","type":"tool_result","content":"1\tuse std::path::{Path, PathBuf};\n2\tuse std::sync::Arc;\n3\tuse std::time::{Duration, Instant};\n4\t\n5\tuse rusqlite::Connection;\n6\tuse serde_json::Value;\n7\tuse tempfile::tempdir;\n8\t\n9\tuse super::{\n10\t    ConsolidationConfig, ConsolidationJobMode, ConsolidationJobRuntime, EpisodeOutcome,\n11\t    SessionConsolidationConfig, SessionConsolidationOutcome, SessionConsolidator,\n12\t};\n13\tuse crate::events::{\n14\t    Actor, AssistantTaskStartedPayload, BranchRef, CompactSummary, EventKind, EventPayload,\n15\t    EventReader, EventStore, EventWriter, FlushPolicy, PartialEnvelope, SessionId, TaskId,\n16\t    ToolCalledPayload, WorkflowSucceededPayload,\n17\t};\n18\tuse crate::identity::FileId;\n19\tuse crate::memory::MemoryStore;\n20\t\n21\t#[test]\n22\tfn small_task_slice_emits_create_memory_proposal_with_deterministic_summary() {\n23\t    let fixture = FileFixture::new();\n24\t    fixture.append_small_task(\"task-small\");\n25\t    let mut consolidator = fixture.consolidator();\n26\t    let outcome = consolidator\n27\t        .on_task_complete(\n28\t            \"workspace-main\",\n29\t            &task_id(\"task-small\"),\n30\t            EpisodeOutcome::Success,\n31\t        )\n32\t        .expect(\"task consolidates\");\n33\t\n34\t    match outcome {\n35\t        SessionConsolidationOutcome::Proposed {\n36\t            proposal_kind,\n37\t            proposal_id,\n38\t            ..\n39\t        } => {\n40\t            assert_eq!(proposal_kind.as_str(), \"create_memory\");\n41\t            let proposal = load_proposal(&fixture.memory_db_path, &proposal_id);\n42\t            assert_eq!(proposal.0, \"create_memory\");\n43\t            assert_eq!(\n44\t                proposal\n45\t                    .1\n46\t                    .get(\"summary_text\")\n47\t                    .and_then(Value::as_str)\n48\t                    .expect(\"summary text present\"),\n49\t                \"Task task-small: 1 tools, 1 files, outcome=success\"\n50\t            );\n51\t            assert_eq!(\n52\t                proposal\n53\t                    .1\n54\t                    .get(\"tools_used\")\n55\t                    .and_then(Value::as_array)\n56\t                    .expect(\"tools array present\")\n57\t                    .len(),\n58\t                1\n59\t            );\n60\t        }\n61\t        other => panic!(\"expected proposed outcome, got {other:?}\"),\n62\t    }\n63\t}\n64\t\n65\t#[test]\n66\tfn oversized_task_slice_redirects_to_background_mode() {\n67\t    let fixture = FileFixture::new();\n68\t    fixture.append_large_task(\"task-large\", 250);\n69\t    let mut consolidator = fixture.consolidator();\n70\t    let outcome = consolidator\n71\t        .on_task_complete(\n72\t            \"workspace-main\",\n73\t            &task_id(\"task-large\"),\n74\t            EpisodeOutcome::Success,\n75\t        )\n76\t        .expect(\"task redirect succeeds\");\n77\t\n78\t    match outcome {\n79\t        SessionConsolidationOutcome::RedirectedToBackground { job_id, .. } => {\n80\t            let (mode, status) = load_job(&fixture.memory_db_path, &job_id);\n81\t            assert_eq!(mode, ConsolidationJobMode::Background.as_str());\n82\t            assert_eq!(status, \"queued\");\n83\t        }\n84\t        other => panic!(\"expected redirect outcome, got {other:?}\"),\n85\t    }\n86\t}\n87\t\n88\t#[test]\n89\tfn session_consolidation_never_mutates_memories_directly() {\n90\t    let fixture = FileFixture::new();\n91\t    fixture.append_small_task(\"task-no-mutate\");\n92\t    let mut consolidator = fixture.consolidator();\n93\t    assert_eq!(\n94\t        consolidator\n95\t            .memory_store()\n96\t            .list_all()\n97\t            .expect(\"memories list\")\n98\t            .len(),\n99\t        0\n100\t    );\n101\t\n102\t    consolidator\n103\t        .on_task_complete(\n104\t            \"workspace-main\",\n105\t            &task_id(\"task-no-mutate\"),\n106\t            EpisodeOutcome::Success,\n107\t        )\n108\t        .expect(\"task consolidates\");\n109\t\n110\t    assert_eq!(\n111\t        consolidator\n112\t            .memory_store()\n113\t            .list_all()\n114\t            .expect(\"memories list\")\n115\t            .len(),\n116\t        0\n117\t    );\n118\t}\n119\t\n120\t#[test]\n121\tfn session_consolidation_hot_path_stays_under_five_milliseconds_p99() {\n122\t    let mut fixture = BudgetFixture::new();\n123\t    let mut samples = Vec::new();\n124\t\n125\t    for index in 0..16 {\n126\t        let task = format!(\"task-budget-warmup-{index}\");\n127\t        fixture.append_small_task(&task);\n128\t        fixture\n129\t            .consolidator\n130\t            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n131\t            .expect(\"warmup task consolidates\");\n132\t    }\n133\t\n134\t    for index in 0..64 {\n135\t        let task = format!(\"task-budget-{index}\");\n136\t        fixture.append_small_task(&task);\n137\t        let started = Instant::now();\n138\t        fixture\n139\t            .consolidator\n140\t            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n141\t            .expect(\"task consolidates\");\n142\t        samples.push(started.elapsed());\n143\t    }\n144\t\n145\t    samples.sort();\n146\t    let p99 = percentile_99(&samples);\n147\t    debug_assert!(p99 <= Duration::from_millis(5));\n148\t    assert!(p99 <= Duration::from_millis(5), \"p99 was {:?}\", p99);\n149\t}\n150\t\n151\t#[test]\n152\tfn session_module_forbids_llm_references() {\n153\t    let source = std::fs::read_to_string(session_source_path()).expect(\"session source reads\");\n154\t    assert!(!source.contains(\"consolidation::llm\"));\n155\t    assert!(!source.contains(\"llm::\"));\n156\t}\n157\t\n158\tstruct FileFixture {\n159\t    _dir: tempfile::TempDir,\n160\t    memory_db_path: PathBuf,\n161\t    event_store: Arc<EventStore>,\n162\t    writer: EventWriter,\n163\t}\n164\t\n165\timpl FileFixture {\n166\t    fn new() -> Self {\n167\t        let dir = tempdir().expect(\"tempdir\");\n168\t        let memory_db_path = dir.path().join(\"memories.sqlite\");\n169\t        let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n170\t        let writer = EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n171\t            .with_flush_policy(FlushPolicy::Sync);\n172\t        Self {\n173\t            _dir: dir,\n174\t            memory_db_path,\n175\t            event_store,\n176\t            writer,\n177\t        }\n178\t    }\n179\t\n180\t    fn consolidator(&self) -> SessionConsolidator {\n181\t        SessionConsolidator::new(\n182\t            EventReader::new(self.event_store.clone()),\n183\t            MemoryStore::open(&self.memory_db_path).expect(\"memory store opens\"),\n184\t            ConsolidationJobRuntime::new(\n185\t                Connection::open(&self.memory_db_path).expect(\"consolidation db opens\"),\n186\t                ConsolidationConfig::default(),\n187\t            )\n188\t            .expect(\"runtime opens\"),\n189\t            SessionConsolidationConfig::default(),\n190\t        )\n191\t    }\n192\t\n193\t    fn append_small_task(&self, task_id_value: &str) {\n194\t        let task_id = task_id(task_id_value);\n195\t        self.append_event(\n196\t            task_id.clone(),\n197\t            EventKind::AssistantTaskStarted,\n198\t            EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n199\t                context_handle_id: None,\n200\t                seed_event_ids: Vec::new(),\n201\t                initial_memory_ids: Vec::new(),\n202\t                objective: \"small task\".to_string(),\n203\t            }),\n204\t            Vec::new(),\n205\t            \"Task started\",\n206\t        );\n207\t        self.append_event(\n208\t            task_id.clone(),\n209\t            EventKind::ToolCalled,\n210\t            EventPayload::ToolCalled(ToolCalledPayload {\n211\t                call_id: format!(\"call-{task_id_value}\"),\n212\t                tool_name: \"get_context_capsule\".to_string(),\n213\t                context_handle_id: None,\n214\t                source_event_id: None,\n215\t                input_summary: \"query=small\".to_string(),\n216\t            }),\n217\t            vec![crate::events::StableRef::FileRef(file_id(\"src/lib.rs\"))],\n218\t            \"Tool called\",\n219\t        );\n220\t        self.append_event(\n221\t            task_id,\n222\t            EventKind::WorkflowSucceeded,\n223\t            EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n224\t                workflow_name: \"prepare_change\".to_string(),\n225\t                terminal_event_id: None,\n226\t                output_context_handle_id: None,\n227\t                memory_ids: Vec::new(),\n228\t                result_summary: \"success\".to_string(),\n229\t            }),\n230\t            Vec::new(),\n231\t            \"Workflow succeeded\",\n232\t        );\n233\t    }\n234\t\n235\t    fn append_large_task(&self, task_id_value: &str, event_count: usize) {\n236\t        let task_id = task_id(task_id_value);\n237\t        self.append_event(\n238\t            task_id.clone(),\n239\t            EventKind::AssistantTaskStarted,\n240\t            EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n241\t                context_handle_id: None,\n242\t                seed_event_ids: Vec::new(),\n243\t                initial_memory_ids: Vec::new(),\n244\t                objective: \"large task\".to_string(),\n245\t            }),\n246\t            Vec::new(),\n247\t            \"Task started\",\n248\t        );\n249\t        for index in 0..event_count.saturating_sub(2) {\n250\t            self.append_event(\n251\t                task_id.clone(),\n252\t                EventKind::ToolCalled,\n253\t                EventPayload::ToolCalled(ToolCalledPayload {\n254\t                    call_id: format!(\"call-{task_id_value}-{index}\"),\n255\t                    tool_name: \"get_context_capsule\".to_string(),\n256\t                    context_handle_id: None,\n257\t                    source_event_id: None,\n258\t                    input_summary: \"query=scan\".to_string(),\n259\t                }),\n260\t                vec![crate::events::StableRef::FileRef(file_id(&format!(\n261\t                    \"src/file-{index}.rs\"\n262\t                )))],\n263\t                \"Tool called\",\n264\t            );\n265\t        }\n266\t        self.append_event(\n267\t            task_id,\n268\t            EventKind::WorkflowSucceeded,\n269\t            EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n270\t                workflow_name: \"prepare_change\".to_string(),\n271\t                terminal_event_id: None,\n272\t                output_context_handle_id: None,\n273\t                memory_ids: Vec::new(),\n274\t                result_summary: \"success\".to_string(),\n275\t            }),\n276\t            Vec::new(),\n277\t            \"Workflow succeeded\",\n278\t        );\n279\t    }\n280\t\n281\t    fn append_event(\n282\t        &self,\n283\t        task_id: TaskId,\n284\t        kind: EventKind,\n285\t        payload: EventPayload,\n286\t        references: Vec<crate::events::StableRef>,\n287\t        summary: &str,\n288\t    ) {\n289\t        self.writer\n290\t            .append(PartialEnvelope {\n291\t                workspace_id: None,\n292\t                branch: BranchRef {\n293\t                    name: \"main\".to_string(),\n294\t                },\n295\t                session_id: SessionId {\n296\t                    value: \"session-main\".to_string(),\n297\t                },\n298\t                task_id: Some(task_id),\n299\t                actor: Actor::Daemon,\n300\t                kind,\n301\t                references,\n302\t                summary: CompactSummary::new(summary).expect(\"summary fits\"),\n303\t                payload,\n304\t            })\n305\t            .expect(\"event appends\");\n306\t    }\n307\t}\n308\t\n309\tstruct BudgetFixture {\n310\t    writer: EventWriter,\n311\t    consolidator: SessionConsolidator,\n312\t}\n313\t\n314\timpl BudgetFixture {\n315\t    fn new() -> Self {\n316\t        let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n317\t        let writer = EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n318\t            .with_flush_policy(FlushPolicy::Sync);\n319\t        let consolidator = SessionConsolidator::new(\n320\t            EventReader::new(event_store.clone()),\n321\t            MemoryStore::open_in_memory().expect(\"memory store opens\"),\n322\t            ConsolidationJobRuntime::new(\n323\t                Connection::open_in_memory().expect(\"consolidation db opens\"),\n324\t                ConsolidationConfig::default(),\n325\t            )\n326\t            .expect(\"runtime opens\"),\n327\t            SessionConsolidationConfig::default(),\n328\t        );\n329\t        Self {\n330\t            writer,\n331\t            consolidator,\n332\t        }\n333\t    }\n334\t\n335\t    fn append_small_task(&self, task_id_value: &str) {\n336\t        let task_id = task_id(task_id_value);\n337\t        self.writer\n338\t            .append(PartialEnvelope {\n339\t                workspace_id: None,\n340\t                branch: BranchRef {\n341\t                    name: \"main\".to_string(),\n342\t                },\n343\t                session_id: SessionId {\n344\t                    value: \"session-budget\".to_string(),\n345\t                },\n346\t                task_id: Some(task_id.clone()),\n347\t                actor: Actor::Daemon,\n348\t                kind: EventKind::AssistantTaskStarted,\n349\t                references: Vec::new(),\n350\t                summary: CompactSummary::new(\"Task started\").expect(\"summary fits\"),\n351\t                payload: EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n352\t                    context_handle_id: None,\n353\t                    seed_event_ids: Vec::new(),\n354\t                    initial_memory_ids: Vec::new(),\n355\t                    objective: \"budget\".to_string(),\n356\t                }),\n357\t            })\n358\t            .expect(\"event appends\");\n359\t        self.writer\n360\t            .append(PartialEnvelope {\n361\t                workspace_id: None,\n362\t                branch: BranchRef {\n363\t                    name: \"main\".to_string(),\n364\t                },\n365\t                session_id: SessionId {\n366\t                    value: \"session-budget\".to_string(),\n367\t                },\n368\t                task_id: Some(task_id.clone()),\n369\t                actor: Actor::Daemon,\n370\t                kind: EventKind::ToolCalled,\n371\t                references: vec![crate::events::StableRef::FileRef(file_id(\"src/lib.rs\"))],\n372\t                summary: CompactSummary::new(\"Tool called\").expect(\"summary fits\"),\n373\t                payload: EventPayload::ToolCalled(ToolCalledPayload {\n374\t                    call_id: format!(\"call-{task_id_value}\"),\n375\t                    tool_name: \"get_context_capsule\".to_string(),\n376\t                    context_handle_id: None,\n377\t                    source_event_id: None,\n378\t                    input_summary: \"budget\".to_string(),\n379\t                }),\n380\t            })\n381\t            .expect(\"event appends\");\n382\t        self.writer\n383\t            .append(PartialEnvelope {\n384\t                workspace_id: None,\n385\t                branch: BranchRef {\n386\t                    name: \"main\".to_string(),\n387\t                },\n388\t                session_id: SessionId {\n389\t                    value: \"session-budget\".to_string(),\n390\t                },\n391\t                task_id: Some(task_id),\n392\t                actor: Actor::Daemon,\n393\t                kind: EventKind::WorkflowSucceeded,\n394\t                references: Vec::new(),\n395\t                summary: CompactSummary::new(\"Workflow succeeded\").expect(\"summary fits\"),\n396\t                payload: EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n397\t                    workflow_name: \"prepare_change\".to_string(),\n398\t                    terminal_event_id: None,\n399\t                    output_context_handle_id: None,\n400\t                    memory_ids: Vec::new(),\n401\t                    result_summary: \"success\".to_string(),\n402\t                }),\n403\t            })\n404\t            .expect(\"event appends\");\n405\t    }\n406\t}\n407\t\n408\tfn load_proposal(path: &Path, proposal_id: &str) -> (String, Value) {\n409\t    let conn = Connection::open(path).expect(\"db opens\");\n410\t    conn.query_row(\n411\t        \"SELECT proposal_kind, proposed_state FROM consolidation_proposals WHERE proposal_id = ?1\",\n412\t        [proposal_id],\n413\t        |row| Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?)),\n414\t    )\n415\t    .map(|(kind, proposed_state)| {\n416\t        (\n417\t            kind,\n418\t            serde_json::from_str::<Value>(&proposed_state).expect(\"proposal json parses\"),\n419\t        )\n420\t    })\n421\t    .expect(\"proposal loads\")\n422\t}\n423\t\n424\tfn load_job(path: &Path, job_id: &str) -> (String, String) {\n425\t    let conn = Connection::open(path).expect(\"db opens\");\n426\t    conn.query_row(\n427\t        \"SELECT mode, status FROM consolidation_jobs WHERE job_id = ?1\",\n428\t        [job_id],\n429\t        |row| Ok((row.get(0)?, row.get(1)?)),\n430\t    )\n431\t    .expect(\"job loads\")\n432\t}\n433\t\n434\tfn percentile_99(samples: &[Duration]) -> Duration {\n435\t    let index = ((samples.len() as f64 * 0.99).ceil() as usize).saturating_sub(1);\n436\t    samples[index]\n437\t}\n438\t\n439\tfn file_id(path: &str) -> FileId {\n440\t    FileId {\n441\t        workspace_id: \"workspace-main\".to_string(),\n442\t        repo_relative_path: path.to_string(),\n443\t        content_hash: \"hash\".to_string(),\n444\t    }\n445\t}\n446\t\n447\tfn task_id(value: &str) -> TaskId {\n448\t    TaskId {\n449\t        value: value.to_string(),\n450\t    }\n451\t}\n452\t\n453\tfn session_source_path() -> PathBuf {\n454\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n455\t        .join(\"src\")\n456\t        .join(\"consolidation\")\n457\t        .join(\"session.rs\")\n458\t}\n459\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"344d63c8-767a-4bf9-b5d0-ba24c28297b1","timestamp":"2026-05-17T11:43:15.025Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/session_tests.rs","content":"use std::path::{Path, PathBuf};\nuse std::sync::Arc;\nuse std::time::{Duration, Instant};\n\nuse rusqlite::Connection;\nuse serde_json::Value;\nuse tempfile::tempdir;\n\nuse super::{\n    ConsolidationConfig, ConsolidationJobMode, ConsolidationJobRuntime, EpisodeOutcome,\n    SessionConsolidationConfig, SessionConsolidationOutcome, SessionConsolidator,\n};\nuse crate::events::{\n    Actor, AssistantTaskStartedPayload, BranchRef, CompactSummary, EventKind, EventPayload,\n    EventReader, EventStore, EventWriter, FlushPolicy, PartialEnvelope, SessionId, TaskId,\n    ToolCalledPayload, WorkflowSucceededPayload,\n};\nuse crate::identity::FileId;\nuse crate::memory::MemoryStore;\n\n#[test]\nfn small_task_slice_emits_create_memory_proposal_with_deterministic_summary() {\n    let fixture = FileFixture::new();\n    fixture.append_small_task(\"task-small\");\n    let mut consolidator = fixture.consolidator();\n    let outcome = consolidator\n        .on_task_complete(\n            \"workspace-main\",\n            &task_id(\"task-small\"),\n            EpisodeOutcome::Success,\n        )\n        .expect(\"task consolidates\");\n\n    match outcome {\n        SessionConsolidationOutcome::Proposed {\n            proposal_kind,\n            proposal_id,\n            ..\n        } => {\n            assert_eq!(proposal_kind.as_str(), \"create_memory\");\n            let proposal = load_proposal(&fixture.memory_db_path, &proposal_id);\n            assert_eq!(proposal.0, \"create_memory\");\n            assert_eq!(\n                proposal\n                    .1\n                    .get(\"summary_text\")\n                    .and_then(Value::as_str)\n                    .expect(\"summary text present\"),\n                \"Task task-small: 1 tools, 1 files, outcome=success\"\n            );\n            assert_eq!(\n                proposal\n                    .1\n                    .get(\"tools_used\")\n                    .and_then(Value::as_array)\n                    .expect(\"tools array present\")\n                    .len(),\n                1\n            );\n        }\n        other => panic!(\"expected proposed outcome, got {other:?}\"),\n    }\n}\n\n#[test]\nfn oversized_task_slice_redirects_to_background_mode() {\n    let fixture = FileFixture::new();\n    fixture.append_large_task(\"task-large\", 250);\n    let mut consolidator = fixture.consolidator();\n    let outcome = consolidator\n        .on_task_complete(\n            \"workspace-main\",\n            &task_id(\"task-large\"),\n            EpisodeOutcome::Success,\n        )\n        .expect(\"task redirect succeeds\");\n\n    match outcome {\n        SessionConsolidationOutcome::RedirectedToBackground { job_id, .. } => {\n            let (mode, status) = load_job(&fixture.memory_db_path, &job_id);\n            assert_eq!(mode, ConsolidationJobMode::Background.as_str());\n            assert_eq!(status, \"queued\");\n        }\n        other => panic!(\"expected redirect outcome, got {other:?}\"),\n    }\n}\n\n#[test]\nfn session_consolidation_never_mutates_memories_directly() {\n    let fixture = FileFixture::new();\n    fixture.append_small_task(\"task-no-mutate\");\n    let mut consolidator = fixture.consolidator();\n    assert_eq!(\n        consolidator\n            .memory_store()\n            .list_all()\n            .expect(\"memories list\")\n            .len(),\n        0\n    );\n\n    consolidator\n        .on_task_complete(\n            \"workspace-main\",\n            &task_id(\"task-no-mutate\"),\n            EpisodeOutcome::Success,\n        )\n        .expect(\"task consolidates\");\n\n    assert_eq!(\n        consolidator\n            .memory_store()\n            .list_all()\n            .expect(\"memories list\")\n            .len(),\n        0\n    );\n}\n\n#[test]\nfn session_consolidation_hot_path_stays_under_five_milliseconds_p99() {\n    let mut fixture = BudgetFixture::new();\n    let mut samples = Vec::new();\n\n    for index in 0..16 {\n        let task = format!(\"task-budget-warmup-{index}\");\n        fixture.append_small_task(&task);\n        fixture\n            .consolidator\n            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n            .expect(\"warmup task consolidates\");\n    }\n\n    for index in 0..64 {\n        let task = format!(\"task-budget-{index}\");\n        fixture.append_small_task(&task);\n        let started = Instant::now();\n        fixture\n            .consolidator\n            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n            .expect(\"task consolidates\");\n        samples.push(started.elapsed());\n    }\n\n    samples.sort();\n    let p99 = percentile_99(&samples);\n    debug_assert!(p99 <= Duration::from_millis(5));\n    assert!(p99 <= Duration::from_millis(5), \"p99 was {:?}\", p99);\n}\n\n#[test]\nfn session_module_forbids_llm_references() {\n    let source = std::fs::read_to_string(session_source_path()).expect(\"session source reads\");\n    assert!(!source.contains(\"consolidation::llm\"));\n    assert!(!source.contains(\"llm::\"));\n}\n\nstruct FileFixture {\n    _dir: tempfile::TempDir,\n    memory_db_path: PathBuf,\n    event_store: Arc<EventStore>,\n    writer: EventWriter,\n}\n\nimpl FileFixture {\n    fn new() -> Self {\n        let dir = tempdir().expect(\"tempdir\");\n        let memory_db_path = dir.path().join(\"memories.sqlite\");\n        let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n        let writer = EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n            .with_flush_policy(FlushPolicy::Sync);\n        Self {\n            _dir: dir,\n            memory_db_path,\n            event_store,\n            writer,\n        }\n    }\n\n    fn consolidator(&self) -> SessionConsolidator {\n        SessionConsolidator::new(\n            EventReader::new(self.event_store.clone()),\n            MemoryStore::open(&self.memory_db_path).expect(\"memory store opens\"),\n            ConsolidationJobRuntime::new(\n                Connection::open(&self.memory_db_path).expect(\"consolidation db opens\"),\n                ConsolidationConfig::default(),\n            )\n            .expect(\"runtime opens\"),\n            SessionConsolidationConfig::default(),\n        )\n    }\n\n    fn append_small_task(&self, task_id_value: &str) {\n        let task_id = task_id(task_id_value);\n        self.append_event(\n            task_id.clone(),\n            EventKind::AssistantTaskStarted,\n            EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n                context_handle_id: None,\n                seed_event_ids: Vec::new(),\n                initial_memory_ids: Vec::new(),\n                objective: \"small task\".to_string(),\n            }),\n            Vec::new(),\n            \"Task started\",\n        );\n        self.append_event(\n            task_id.clone(),\n            EventKind::ToolCalled,\n            EventPayload::ToolCalled(ToolCalledPayload {\n                call_id: format!(\"call-{task_id_value}\"),\n                tool_name: \"get_context_capsule\".to_string(),\n                context_handle_id: None,\n                source_event_id: None,\n                input_summary: \"query=small\".to_string(),\n            }),\n            vec![crate::events::StableRef::FileRef(file_id(\"src/lib.rs\"))],\n            \"Tool called\",\n        );\n        self.append_event(\n            task_id,\n            EventKind::WorkflowSucceeded,\n            EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n                workflow_name: \"prepare_change\".to_string(),\n                terminal_event_id: None,\n                output_context_handle_id: None,\n                memory_ids: Vec::new(),\n                result_summary: \"success\".to_string(),\n            }),\n            Vec::new(),\n            \"Workflow succeeded\",\n        );\n    }\n\n    fn append_large_task(&self, task_id_value: &str, event_count: usize) {\n        let task_id = task_id(task_id_value);\n        self.append_event(\n            task_id.clone(),\n            EventKind::AssistantTaskStarted,\n            EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n                context_handle_id: None,\n                seed_event_ids: Vec::new(),\n                initial_memory_ids: Vec::new(),\n                objective: \"large task\".to_string(),\n            }),\n            Vec::new(),\n            \"Task started\",\n        );\n        for index in 0..event_count.saturating_sub(2) {\n            self.append_event(\n                task_id.clone(),\n                EventKind::ToolCalled,\n                EventPayload::ToolCalled(ToolCalledPayload {\n                    call_id: format!(\"call-{task_id_value}-{index}\"),\n                    tool_name: \"get_context_capsule\".to_string(),\n                    context_handle_id: None,\n                    source_event_id: None,\n                    input_summary: \"query=scan\".to_string(),\n                }),\n                vec![crate::events::StableRef::FileRef(file_id(&format!(\n                    \"src/file-{index}.rs\"\n                )))],\n                \"Tool called\",\n            );\n        }\n        self.append_event(\n            task_id,\n            EventKind::WorkflowSucceeded,\n            EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n                workflow_name: \"prepare_change\".to_string(),\n                terminal_event_id: None,\n                output_context_handle_id: None,\n                memory_ids: Vec::new(),\n                result_summary: \"success\".to_string(),\n            }),\n            Vec::new(),\n            \"Workflow succeeded\",\n        );\n    }\n\n    fn append_event(\n        &self,\n        task_id: TaskId,\n        kind: EventKind,\n        payload: EventPayload,\n        references: Vec<crate::events::StableRef>,\n        summary: &str,\n    ) {\n        self.writer\n            .append(PartialEnvelope {\n                workspace_id: None,\n                branch: BranchRef {\n                    name: \"main\".to_string(),\n                },\n                session_id: SessionId {\n                    value: \"session-main\".to_string(),\n                },\n                task_id: Some(task_id),\n                actor: Actor::Daemon,\n                kind,\n                references,\n                summary: CompactSummary::new(summary).expect(\"summary fits\"),\n                payload,\n            })\n            .expect(\"event appends\");\n    }\n}\n\nstruct BudgetFixture {\n    writer: EventWriter,\n    consolidator: SessionConsolidator,\n}\n\nimpl BudgetFixture {\n    fn new() -> Self {\n        let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n        let writer = EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n            .with_flush_policy(FlushPolicy::Sync);\n        let consolidator = SessionConsolidator::new(\n            EventReader::new(event_store.clone()),\n            MemoryStore::open_in_memory().expect(\"memory store opens\"),\n            ConsolidationJobRuntime::new(\n                Connection::open_in_memory().expect(\"consolidation db opens\"),\n                ConsolidationConfig::default(),\n            )\n            .expect(\"runtime opens\"),\n            SessionConsolidationConfig::default(),\n        );\n        Self {\n            writer,\n            consolidator,\n        }\n    }\n\n    fn append_small_task(&self, task_id_value: &str) {\n        let task_id = task_id(task_id_value);\n        self.writer\n            .append(PartialEnvelope {\n                workspace_id: None,\n                branch: BranchRef {\n                    name: \"main\".to_string(),\n                },\n                session_id: SessionId {\n                    value: \"session-budget\".to_string(),\n                },\n                task_id: Some(task_id.clone()),\n                actor: Actor::Daemon,\n                kind: EventKind::AssistantTaskStarted,\n                references: Vec::new(),\n                summary: CompactSummary::new(\"Task started\").expect(\"summary fits\"),\n                payload: EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n                    context_handle_id: None,\n                    seed_event_ids: Vec::new(),\n                    initial_memory_ids: Vec::new(),\n                    objective: \"budget\".to_string(),\n                }),\n            })\n            .expect(\"event appends\");\n        self.writer\n            .append(PartialEnvelope {\n                workspace_id: None,\n                branch: BranchRef {\n                    name: \"main\".to_string(),\n                },\n                session_id: SessionId {\n                    value: \"session-budget\".to_string(),\n                },\n                task_id: Some(task_id.clone()),\n                actor: Actor::Daemon,\n                kind: EventKind::ToolCalled,\n                references: vec![crate::events::StableRef::FileRef(file_id(\"src/lib.rs\"))],\n                summary: CompactSummary::new(\"Tool called\").expect(\"summary fits\"),\n                payload: EventPayload::ToolCalled(ToolCalledPayload {\n                    call_id: format!(\"call-{task_id_value}\"),\n                    tool_name: \"get_context_capsule\".to_string(),\n                    context_handle_id: None,\n                    source_event_id: None,\n                    input_summary: \"budget\".to_string(),\n                }),\n            })\n            .expect(\"event appends\");\n        self.writer\n            .append(PartialEnvelope {\n                workspace_id: None,\n                branch: BranchRef {\n                    name: \"main\".to_string(),\n                },\n                session_id: SessionId {\n                    value: \"session-budget\".to_string(),\n                },\n                task_id: Some(task_id),\n                actor: Actor::Daemon,\n                kind: EventKind::WorkflowSucceeded,\n                references: Vec::new(),\n                summary: CompactSummary::new(\"Workflow succeeded\").expect(\"summary fits\"),\n                payload: EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n                    workflow_name: \"prepare_change\".to_string(),\n                    terminal_event_id: None,\n                    output_context_handle_id: None,\n                    memory_ids: Vec::new(),\n                    result_summary: \"success\".to_string(),\n                }),\n            })\n            .expect(\"event appends\");\n    }\n}\n\nfn load_proposal(path: &Path, proposal_id: &str) -> (String, Value) {\n    let conn = Connection::open(path).expect(\"db opens\");\n    conn.query_row(\n        \"SELECT proposal_kind, proposed_state FROM consolidation_proposals WHERE proposal_id = ?1\",\n        [proposal_id],\n        |row| Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?)),\n    )\n    .map(|(kind, proposed_state)| {\n        (\n            kind,\n            serde_json::from_str::<Value>(&proposed_state).expect(\"proposal json parses\"),\n        )\n    })\n    .expect(\"proposal loads\")\n}\n\nfn load_job(path: &Path, job_id: &str) -> (String, String) {\n    let conn = Connection::open(path).expect(\"db opens\");\n    conn.query_row(\n        \"SELECT mode, status FROM consolidation_jobs WHERE job_id = ?1\",\n        [job_id],\n        |row| Ok((row.get(0)?, row.get(1)?)),\n    )\n    .expect(\"job loads\")\n}\n\nfn percentile_99(samples: &[Duration]) -> Duration {\n    let index = ((samples.len() as f64 * 0.99).ceil() as usize).saturating_sub(1);\n    samples[index]\n}\n\nfn file_id(path: &str) -> FileId {\n    FileId {\n        workspace_id: \"workspace-main\".to_string(),\n        repo_relative_path: path.to_string(),\n        content_hash: \"hash\".to_string(),\n    }\n}\n\nfn task_id(value: &str) -> TaskId {\n    TaskId {\n        value: value.to_string(),\n    }\n}\n\nfn session_source_path() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"src\")\n        .join(\"consolidation\")\n        .join(\"session.rs\")\n}\n","numLines":459,"startLine":1,"totalLines":459}}}
