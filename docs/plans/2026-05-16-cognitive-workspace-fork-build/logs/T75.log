+      "references": "References",
+      "summary": "Summary",
+      "payload": "Payload"
+    },
+    "pagination": {
+      "showing": "Showing {start}-{end} of {total}",
+      "previous": "Previous",
+      "next": "Next",
+      "page": "Page {page} of {totalPages}"
+    },
+    "filters": {
+      "all": "All",
+      "kindButton": "Kind ({count})",
+      "actorButton": "Actor ({count})",
+      "sessionButton": "Session",
+      "taskButton": "Task",
