+    reason: string;
+    allSignals: ReviewRetrievalCandidateSignal[];
+}
+
 export interface ReviewRetrievalExplanation {
     requestId: string;
-    supported: false;
+    supported: boolean;
     reason: string;
+    request?: ReviewRetrievalExplanationRequest;
