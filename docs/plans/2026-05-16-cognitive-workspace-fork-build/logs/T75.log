    function lookup(tree, key) {
      const parts = key.split('.');
      let current = tree;
      for (const part of parts) {
        if (!current || typeof current === 'string') {
          return undefined;
        }
        current = current[part];
      }
      return typeof current === 'string' ? current : undefined;
    }

