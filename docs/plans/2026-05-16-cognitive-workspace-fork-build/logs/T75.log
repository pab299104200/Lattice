                return Err(MetricsSurfaceError::CrossScopeQuery {
                    memory_key: memory.memory_key.clone(),
                    memory_scope: memory.scope.clone(),
                    allowed_scopes: report.allowed_memory_scopes.clone(),
                });
            }
        }
        Ok(())
    }

