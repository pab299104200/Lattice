     pub expansion_handle: String,
     /// Event kind.
     pub kind: String,
+    /// Actor attached to the event envelope.
+    pub actor: String,
     /// UTC timestamp for the event.
     pub timestamp: DateTime<Utc>,
+    /// Workspace id attached to the event.
+    pub workspace_id: String,
