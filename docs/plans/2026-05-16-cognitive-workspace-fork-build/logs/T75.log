          &fixture.operator(\"auto-policy\"),\n114\t        )\n115\t        .unwrap();\n116\t    let queue = fixture.review_queue();\n117\t\n118\t    let outcome = queue\n119\t        .decide(\n120\t            \"proposal-repo\",\n121\t            ProposalDecision::Applied,\n122\t            &fixture.operator(\"reviewer-1\"),\n123\t            Some(\"promote durable fact\".to_string()),\n124\t        )\n125\t        .unwrap();\n126\t\n127\t    match outcome {\n128\t        ReviewDecisionOutcome::Applied { outcome } => {\n129\t            assert_eq!(\n130\t                outcome,\n131\t                ApplyOutcome::Applied {\n132\t                    memory_id: \"mem-proposal-repo\".to_string()\n133\t                }\n134\t            );\n135\t        }\n136\t        other => panic!(\"unexpected outcome: {other:?}\"),\n137\t    }\n138\t    assert_eq!(\n139\t        proposal_decision(&fixture.db_path, \"proposal-repo\"),\n140\t        \"applied\"\n141\t    );\n142\t    assert_eq!(\n143\t        proposal_decision_reason(&fixture.db_path, \"proposal-repo\").as_deref(),\n144\t        Some(\"promote durable fact\")\n145\t    );\n146\t    let event = fixture.memory_consolidated_event();\n147\t    match event.payload {\n148\t        EventPayload::MemoryConsolidated(payload) => {\n149\t            assert_eq!(payload.decided_by.as_deref(), Some(\"reviewer-1\"));\n150\t            assert_eq!(\n151\t                payload.decision_reason.as_deref(),\n152\t                Some(\"promote durable fact\")\n153\t            );\n154\t            assert_eq!(payload.proposal_id.as_deref(), Some(\"proposal-repo\"));\n155\t        }\n156\t        _ => panic!(\"expected memory_consolidated\"),\n157\t    }\n158\t}\n159\t\n160\t#[test]\n161\tfn decide_reject_leaves_memory_unchanged_and_records_rejection() {\n162\t    let fixture = Fixture::new();\n163\t    let mut runtime = fixture.runtime();\n164\t    runtime.submit(job_for_scope(\"repo\")).unwrap();\n165\t    runtime\n166\t        .execute_ready(\n167\t            &fixture.memory_store,\n168\t            &fixture.event_writer,\n169\t            &fixture.operator(\"auto-policy\"),\n170\t        )\n171\t        .unwrap();\n172\t    let queue = fixture.review_queue();\n173\t\n174\t    let outcome = queue\n175\t        .decide(\n176\t            \"proposal-repo\",\n177\t            ProposalDecision::Rejected,\n178\t            &fixture.operator(\"reviewer-2\"),\n179\t            Some(\"insufficient evidence\".to_string()),\n180\t        )\n181\t        .unwrap();\n182\t\n183\t    match outcome {\n184\t        ReviewDecisionOutcome::Rejected { outcome } => {\n185\t            assert_eq!(outcome, RejectOutcome::Rejected);\n186\t        }\n187\t        other => panic!(\"unexpected outcome: {other:?}\"),\n188\t    }\n189\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n190\t    assert_eq!(\n191\t        proposal_decision(&fixture.db_path, \"proposal-repo\"),\n192\t        \"rejected\"\n193\t    );\n194\t    assert_eq!(\n195\t        proposal_decision_reason(&fixture.db_path, \"proposal-repo\").as_deref(),\n196\t        Some(\"insufficient evidence\")\n197\t    );\n198\t}\n199\t\n200\t#[test]\n201\tfn list_pending_returns_oldest_first_and_honors_filters() {\n202\t    let fixture = Fixture::new();\n203\t    let mut runtime = fixture.runtime();\n204\t    runtime.submit(job_for_scope(\"repo\")).unwrap();\n205\t    runtime.submit(job_for_scope(\"organization\")).unwrap();\n206\t    runtime\n207\t        .execute_ready(\n208\t            &fixture.memory_store,\n209\t            &fixture.event_writer,\n210\t            &fixture.operator(\"auto-policy\"),\n211\t        )\n212\t        .unwrap();\n213\t    fixture.set_enqueued_at(\"job-repo\", 10);\n214\t    fixture.set_enqueued_at(\"job-organization\", 20);\n215\t\n216\t    let queue = fixture.review_queue();\n217\t    let items = queue\n218\t        .list_pending(\"workspace-main\", &ReviewQueueFilter::default())\n219\t        .unwrap();\n22