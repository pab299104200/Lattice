+            const named = detail as Record<string, unknown>;
+            const suffix = typeof named.model === 'string'
+                ? named.model
+                : typeof named.name === 'string'
+                    ? named.name
+                    : '';
+            return suffix ? `${kind}:${suffix}` : kind;
