+            return;
+        }
+        this.eventTraceState.sessionId = kind === 'session' ? selection : undefined;
+        this.eventTraceState.taskId = kind === 'task' ? selection : undefined;
+        this.eventTraceState.workspaceId = kind === 'workspace'
