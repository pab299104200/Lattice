+            }],
+        );
+
+        ResolverFixture { resolver, workspace }
+    }
+
+    fn make_graph() -> CodeGraph {
+        let mut graph = CodeGraph::new();
+        add_node(&mut graph, "repo/src/lib.rs", "shared", 10, SymbolKind::Function);
+        add_node(&mut graph, "repo/src/other.rs", "shared", 22, SymbolKind::Function);
