diff --git a/daemon/crates/lattice-core/src/identity/ambiguity.rs b/daemon/crates/lattice-core/src/identity/ambiguity.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0e81bb5c0124d82b44f3d676b4063b580050b81b
--- /dev/null
