+            }],
+        )
+    }
+
+    fn make_graph() -> CodeGraph {
+        let mut graph = CodeGraph::new();
+        add_node(&mut graph, "repo/src/lib.rs", "shared", 10, SymbolKind::Function);
+        add_node(&mut graph, "repo/src/other.rs", "shared", 22, SymbolKind::Function);
+        add_node(&mut graph, "repo/src/unique.rs", "only_here", 34, SymbolKind::Function);
+        add_node(
+            &mut graph,
+            "repo/tests/auth_test.rs",
+            "test_login",
+            48,
+            SymbolKind::Function,
+        );
+        graph
+    }
+
+    fn add_node(
+        graph: &mut CodeGraph,
+        file: &str,
+        name: &str,
+        byte_offset: usize,
