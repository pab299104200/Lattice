index 32a60d24c71d4a09d6fc28027f94e834077928ac..a4d1e3b3c137f7245791c48f15c4f86bae4a8020
--- a/daemon/crates/lattice-core/src/identity/mod.rs
+++ b/daemon/crates/lattice-core/src/identity/mod.rs
@@ -8,13 +8,17 @@
 //! `## Contract` by providing a migration path from the legacy graph
 //! `SymbolId`.
 
+pub mod ambiguity;
 pub mod encoding;
 pub mod kinds;
+pub mod resolver;
 
 #[cfg(test)]
 mod tests;
 
+pub use ambiguity::{AmbiguityReport, ResolveOutcome};
 pub use encoding::{decode_identity, encode_identity, IdentityDecodeError};
 pub use kinds::{
