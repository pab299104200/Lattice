   306	        if doc.workspace_id != *workspace {
   307	            return ResolveOutcome::NotFound(ResolveError::NotFound {
   308	                kind: "document",
   309	                query: doc.to_string(),
   310	            });
   311	        }
   312	
   313	        let Some(stored_path) = self.stored_path_for_doc(workspace, doc) else {
   314	            return ResolveOutcome::NotFound(ResolveError::NotFound {
   315	                kind: "document",
   316	                query: doc.to_string(),
   317	            });
   318	        };
   319	
   320	        let Some(parsed_file) = self.parsed_files.get(&stored_path) else {
   321	            return ResolveOutcome::NotFound(ResolveError::NotFound {
   322	                kind: "section",
   323	                query: heading.to_string(),
   324	            });
   325	        };
   326	
   327	        let wanted = normalize_heading(heading);
   328	        let candidates = parsed_file
   329	            .symbols
   330	            .iter()
   331	            .filter(|symbol| symbol.kind == SymbolKind::Section)
   332	            .filter(|symbol| normalize_heading(&symbol.name) == wanted)
   333	            .map(|symbol| SectionId {
   334	                doc: doc.clone(),
   335	                heading_path: vec![symbol.name.clone()],
   336	                byte_offset: symbol.id.byte_offset,
   337	            })
   338	            .collect::<Vec<_>>();
   339	
   340	        match candidates.len() {
   341	            0 => ResolveOutcome::NotFound(ResolveError::NotFound {
   342	                kind: "section",
   343	                query: heading.to_string(),
   344	            }),
   345	            1 => ResolveOutcome::Unique(candidates[0].clone()),
   346	            _ => ResolveOutcome::Ambiguous(AmbiguityReport::new(
   347	                heading,
   348	                candidates,
   349	                section_disambiguation_hint(),
   350	            )),
   351	        }
   352	    }
   353	
   354	    fn resolve_test_uncached(
   355	        &self,
   356	        workspace: &WorkspaceId,
   357	        test_name: &str,
   358	    ) -> ResolveOutcome<SymbolId> {
   359	        if let Err(error) = self.ensure_workspace_indexed(workspace) {
   360	            return ResolveOutcome::NotFound(error);
   361	        }
   362	        let wanted = normalize_symbol_name(test_name);
   363	        if wanted.is_empty() {
   364	            return ResolveOutcome::NotFound(ResolveError::Malformed {
   365	                kind: "test",
   366	                query: test_name.to_string(),
   367	                reason: "expected a non-empty test name",
   368	            });
   369	        }
   370	
   371	        let candidates = self
   372	            .workspace_nodes(workspace)
   373	            .into_iter()
   374	            .filter(|node| is_test_node(node))
   375	            .filter(|node| normalize_symbol_name(&node.name) == wanted)
   376	            .filter_map(|node| self.symbol_id_for_node(workspace, node, Some("test")))
   377	            .collect::<Vec<_>>();
   378	
   379	        match candidates.len() {
   380	            0 => ResolveOutcome::NotFound(ResolveError::NotFound {
   381	                kind: "test",
   382	                query: test_name.to_string(),
   383	            }),
   384	            1 => ResolveOutcome::Unique(candidates[0].clone()),
   385	            _ => ResolveOutcome::Ambiguous(AmbiguityReport::new(
   386	                test_name,
   387	                candidates,
   388	                test_disambiguation_hint(),
   389	            )),
   390	        }
   391	    }
   392	
   393	    fn resolve_event_ref_uncached(
   394	        &self,
   395	        workspace: &WorkspaceId,
   396	        ref_str: &str,
   397	    ) -> Result<EventId, ResolveError> {
   398	        if let Some(event_id) = self.resolve_event_identity(workspace, ref_str)? {
   399	            return Ok(event_id);
   400	        }
   401	        if !self.workspace_has_events(workspace) {
   402	            return Err(ResolveError::WorkspaceNotIndexed {
   403	                workspace_id: workspace.clone(),
   404	            });
   405	        }
   406	        let trimmed = ref_str.trim();
   407	        if !is_canonical_ulid(trimmed) {
   408	            return Err(ResolveError::Malformed {
   409	                kind: "event",
   410	                query: ref_str.to_string(),
   411	                reason: "expected a canonical ULID or stable event identity",
   412	            });
   413	        }
   414	        if let Some(event_id) = self.event_index.get(trimmed) {
   415	            return Ok(event_id.clone());
   416	        }
   417	        if self.event_ref_appears_ahead_of_index(workspace, trimmed) {
   418	            return Err(ResolveError::IndexLagBehind {
   419	                latest_event_id: self.latest_event_id.clone().expect("checked above"),
   420	            });
   421	        }
   422	        Err(ResolveError::NotFound {
   423	            kind: "event",
   424	            query: ref_str.to_string(),
   425	        })
   426	    }
   427	
   428	    fn resolve_symbol_identity(
   429	        &self,
   430	        workspace: &WorkspaceId,
   431	        qualified_name: &str,
   432	    ) -> Option<ResolveOutcome<SymbolId>> {
   433	        let identity = decode_identity(qualified_name).ok()?;
   434	        match identity {
   435	            Identity::Symbol(symbol_id) if symbol_id.file.workspace_id == *workspace => {
   436	                Some(ResolveOutcome::Unique(symbol_id))
   437	            }
   438	            Identity::Symbol(symbol_id) => Some(ResolveOutcome::NotFound(ResolveError::NotFound {
   439	                kind: "symbol",
   440	                query: symbol_id.to_string(),
   441	            })),
   442	            _ => None,
   443	        }
   444	    }
   445	
   446	    fn resolve_event_identity(
   447	        &self,
   448	        workspace: &WorkspaceId,
   449	        ref_str: &str,
   450	    ) -> Result<Option<EventId>, ResolveError> {
   451	        let Some(identity) = decode_identity(ref_str).ok() else {
   452	            return Ok(None);
   453	        };
   454	        match identity {
   455	            Identity::Event(event_id) if event_id.workspace_id == *workspace => Ok(Some(event_id)),
   456	            Identity::Event(event_id) => Err(ResolveError::NotFound {
   457	                kind: "event",
   458	                query: event_id.to_string(),
   459	            }),
   460	            _ => Ok(None),
   461	        }
   462	    }
   463	
   464	    fn collect_symbol_candidates(
   465	        &self,
   466	        workspace: &WorkspaceId,
   467	        file_hint: Option<&str>,
   468	        wanted: &str,
   469	    ) -> Vec<SymbolId> {
   470	        let wanted_lower = wanted.to_lowercase();
   471	        self.workspace_nodes(workspace)
   472	            .into_iter()
   473	            .filter(|node| node.kind != SymbolKind::Document && node.kind != SymbolKind::Section)
   474	            .filter(|node| {
   475	                file_hint
   476	                    .map(|hint| self.node_matches_file_hint(workspace, node, hint))
   477	                    .unwrap_or(true)
   478	            })
   479	            .filter(|node| normalize_symbol_name(&node.name).to_lowercase() == wanted_lower)
   480	            .filter_map(|node| self.symbol_id_for_node(workspace, node, None))
   481	            .collect()
   482	    }
   483	
   484	    fn workspace_nodes(&self, workspace: &WorkspaceId) -> Vec<&GraphNode> {
   485	        self.graph
   486	            .all_nodes()
   487	            .into_iter()
   488	            .filter(|node| self.node_in_workspace(workspace, node))
   489	            .collect()
   490	    }
   491	
   492	    fn node_in_workspace(&self, workspace: &WorkspaceId, node: &GraphNode) -> bool {
   493	        self.relative_path_in_workspace(workspace, &node.file).is_some()
   494	    }
   495	
   496	    fn node_matches_file_hint(
   497	        &self,
   498	        workspace: &WorkspaceId,
   499	        node: &GraphNode,
   500	        file_hint: &str,
   501	    ) -> bool {
   502	        let wanted = normalize_path(file_hint);
   503	        let Some(relative_path) = self.relative_path_in_workspace(workspace, &node.file) else {
   504	            return false;
   505	        };
   506	        relative_path == wanted
   507	            || relative_path.ends_with(&format!("/{wanted}"))
   508	            || relative_path.rsplit('/').next() == Some(wanted.as_str())
   509	    }
   510	
   511	    fn ensure_workspace_indexed(&self, workspace: &WorkspaceId) -> Result<(), ResolveError> {
   512	        if self.workspace_has_files(workspace) || self.workspace_has_nodes(workspace) {
   513	            Ok(())
   514	        } else {
   515	            Err(ResolveError::WorkspaceNotIndexed {
   516	                workspace_id: workspace.clone(),
   517	            })
   518	        }
   519	    }
   520	
   521	    fn workspace_has_files(&self, workspace: &WorkspaceId) -> bool {
   522	        self.file_index
   523	            .keys()
   524	            .any(|path| self.relative_path_in_workspace(workspace, path).is_some())
   525	    }
   526	
   527	    fn workspace_has_nodes(&self, workspace: &WorkspaceId) -> bool {
   528	        self.graph
   529	            .all_nodes()
   530	            .into_iter()
   531	            .any(|node| self.node_in_workspace(workspace, node))
   532	    }
   533	
   534	    fn workspace_has_events(&self, workspace: &WorkspaceId) -> bool {
   535	        self.event_index
   536	            .values()
   537	            .any(|event_id| event_id.workspace_id == *workspace)
   538	    }
   539	
   540	    fn event_ref_appears_ahead_of_index(&self, workspace: &WorkspaceId, ulid: &str) -> bool {
   541	        self.latest_event_id
   542	            .as_ref()
   543	            .filter(|latest| latest.workspace_id == *workspace)
   544	            .map(|latest| ulid > latest.ulid.as_str())
   545	            .unwrap_or(false)
   546	    }
   547	
   548	    fn file_id_for_stored_path(
   549	        &self,
   550	        workspace: &WorkspaceId,
   551	        stored_path: &str,
   552	    ) -> Result<FileId, ResolveError> {
   553	        let Some(repo_relative_path) = self.relative_path_in_workspace(workspace, stored_path) else {
   554	            return Err(ResolveError::NotFound {
   555	                kind: "file",
   556	                query: stored_path.to_string(),
   557	            });
   558	        };
   559	        Ok(FileId {
   560	            workspace_id: workspace.clone(),
   561	            repo_relative_path,
   562	            content_hash: self
   563	                .file_index
   564	                .get(stored_path)
   565	                .map(|entry| entry.content_hash.clone())
   566	                .unwrap_or_else(|| DEFAULT_CONTENT_HASH.to_string()),
   567	        })
   568	    }
   569	
   570	    fn symbol_id_for_node(
   571	        &self,
   572	        workspace: &WorkspaceId,
   573	        node: &GraphNode,
   574	        forced_kind: Option<&str>,
   575	    ) -> Option<SymbolId> {
   576	        let file = self.file_id_for_stored_path(workspace, &node.file).ok()?;
   577	        Some(SymbolId {
   578	            file,
   579	            qualified_name: node.name.clone(),
   580	            byte_offset: node.id.byte_offset,
   581	            kind: forced_kind
   582	                .map(str::to_string)
   583	                .unwrap_or_else(|| format!("{:?}", node.kind).to_lowercase()),
   584	        })
   585	    }
   586	
   587	    fn stored_path_for_doc(&self, workspace: &WorkspaceId, doc: &DocId) -> Option<String> {
   588	        self.file_index.keys().find_map(|stored_path| {
   589	            let relative_path = self.relative_path_in_workspace(workspace, stored_path)?;
   590	            if relative_path == doc.repo_relative_path {
   591	                Some(stored_path.clone())
   592	            } else {
   593	                None
   594	            }
   595	        })
   596	    }
   597	
   598	    fn relative_path_in_workspace(
   599	        &self,
   600	        workspace: &WorkspaceId,
   601	        stored_path: &str,
   602	    ) -> Option<String> {
   603	        let normalized = normalize_path(stored_path);
   604	        let prefix = format!("{workspace}/");
   605	        if normalized == *workspace {
   606	            return Some(String::new());
   607	        }
   608	        if let Some(stripped) = normalized.strip_prefix(&prefix) {
   609	            return Some(stripped.to_string());
   610	        }
   611	        if workspace == &self.default_workspace && !self.is_namespaced_path(&normalized) {
   612	            return Some(normalized);
   613	        }
   614	        None
   615	    }
   616	
   617	    fn is_namespaced_path(&self, path: &str) -> bool {
   618	        let first_segment = path.split('/').next().unwrap_or(path);
   619	        first_segment == self.default_workspace
   620	            || self
   621	                .file_index
   622	                .keys()
   623	                .filter_map(|item| normalize_path(item).split('/').next().map(str::to_string))
   624	                .any(|segment| segment == first_segment)
   625	    }
   626	}
   627	
   628	fn unique_or_ambiguous_symbol(query: &str, candidates: Vec<SymbolId>) -> ResolveOutcome<SymbolId> {
   629	    match candidates.len() {
   630	        0 => ResolveOutcome::NotFound(ResolveError::NotFound {
   631	            kind: "symbol",
   632	            query: query.to_string(),
   633	        }),
   634	        1 => ResolveOutcome::Unique(candidates[0].clone()),
   635	        _ => {
   636	            let files = candidates
   637	                .iter()
   638	                .map(|candidate| candidate.file.repo_relative_path.clone())
   639	                .collect::<Vec<_>>();
   640	            let distinct_files = files.iter().collect::<std::collections::HashSet<_>>().len();
   641	            ResolveOutcome::Ambiguous(AmbiguityReport::new(
   642	                query,
   643	                candidates,
   644	                symbol_disambiguation_hint(distinct_files > 1),
   645	            ))
   646	        }
   647	    }
   648	}
   649	
   650	fn split_symbol_target(target: &str) -> (Option<&str>, &str) {
   651	    let trimmed = target.trim();
   652	    if let Some((file, symbol)) = trimmed.rsplit_once("::") {
   653	        if looks_like_path(file) {
   654	            return (Some(file), symbol);
   655	        }
   656	    }
   657	    if let Some((file, symbol)) = trimmed.rsplit_once(':') {
   658	        if looks_like_path(file) {
   659	            return (Some(file), symbol);
   660	        }
   661	    }
   662	    (None, trimmed)
   663	}
   664	
   665	fn looks_like_path(value: &str) -> bool {
   666	    value.contains('/') || value.contains('\\') || value.contains('.')
   667	}
   668	
   669	fn normalize_path(path: &str) -> String {
   670	    path.replace('\\', "/")
   671	        .trim()
   672	        .trim_start_matches("./")
   673	        .trim_start_matches('/')
   674	        .to_string()
   675	}
   676	
   677	fn normalize_symbol_name(value: &str) -> String {
   678	    value.trim().trim_matches(':').to_string()
   679	}
   680	
   681	fn normalize_heading(value: &str) -> String {
   682	    value.trim().to_lowercase()
   683	}
   684	
   685	fn is_test_node(node: &GraphNode) -> bool {
   686	    let lower_name = node.name.to_lowercase();
   687	    let lower_file = node.file.to_lowercase();
   688	    lower_name.starts_with("test")
   689	        || lower_name.ends_with("test")
   690	        || lower_file.contains("/tests/")
   691	        || lower_file.contains("_test.")
   692	        || lower_file.contains(".test.")
   693	}
   694	
   695	fn is_canonical_ulid(value: &str) -> bool {
   696	    value.len() == 26
   697	        && value
   698	            .chars()
   699	            .all(|ch| matches!(ch, '0'..='9' | 'A'..='Z') && ch != 'I' && ch != 'L' && ch != 'O' && ch != 'U')
   700	}
