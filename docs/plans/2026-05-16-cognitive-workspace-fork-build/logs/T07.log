 //! `## Contract` by providing a migration path from the legacy graph
 //! `SymbolId`.
 
+pub mod ambiguity;
 pub mod encoding;
 pub mod kinds;
+pub mod resolver;
 
 #[cfg(test)]
 mod tests;
 
