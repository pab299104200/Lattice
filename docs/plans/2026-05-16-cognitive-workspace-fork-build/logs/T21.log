+        None,
+        "branch auth memory",
+    );
+    store.insert_memory(
+        "org-memory",
+        MemoryScope::Organization,
+        None,
+        None,
+        None,
+        None,
+        Some("org-1"),
+        "org memory",
+    );
+
+    assert_eq!(
