+
+    /// Explicit unscoped path for migrations, snapshots, and legacy admin flows.
+    pub fn query_unscoped_admin(
+        &self,
+        keyword: Option<&str>,
+        limit: usize,
+    ) -> Result<Vec<Memory>, LatticeError> {
