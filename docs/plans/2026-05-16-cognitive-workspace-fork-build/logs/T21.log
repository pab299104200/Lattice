+    store.insert_memory(
+        "user-a-memory",
+        MemoryScope::User,
+        None,
+        None,
+        None,
+        Some("user-a"),
+        None,
+        "user A preference",
+    );
+    store.insert_memory(
+        "user-b-memory",
+        MemoryScope::User,
+        None,
+        None,
+        None,
