+        None,
+        Some("feature/a"),
+        Some("workspace-1"),
+        None,
+        None,
+        "feature A memory",
+    );
+    store.insert_memory(
+        "branch-b-memory",
+        MemoryScope::Branch,
+        None,
+        Some("feature/b"),
+        Some("workspace-1"),
