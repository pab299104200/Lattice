                    ON memories(superseded_by_memory_id);",
            )
            .map_err(|e| {
                LatticeError::Storage(format!("Failed to initialize memory indexes: {}", e))
            })?;

        self.conn
            .execute_batch(
                "CREATE VIRTUAL TABLE IF NOT EXISTS memories_fts USING fts5(
                    memory_id UNINDEXED,
                    content,
                    linked_symbols,
