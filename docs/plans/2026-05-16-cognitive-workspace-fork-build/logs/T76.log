+                    this.indexingHealthState.refreshingSection = message.value;
+                    await this.refreshState();
+                    this.indexingHealthState.refreshingSection = undefined;
+                    await this.refreshState();
+                }
+                return;
+            default:
+                return;
+        }
+    }
