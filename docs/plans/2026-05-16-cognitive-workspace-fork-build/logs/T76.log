+                return;
+            case 'retryConsolidationJob':
+                if (message.value) {
+                    await this.retryConsolidationJob(message.value);
+                }
+                return;
+            case 'openConsolidationFailures':
+                await this.openConsolidationFailureTrace();
+                return;
+            default:
+                return;
+        }
+    }
