+            if (!traceResult.ok) {
+                throw traceResult.error;
+            }
+            const jobs = dedupeJobs(traceResult.value.events
+                .map((event) => toConsolidationJob(event))
+                .filter((job): job is ReviewConsolidationJob => job !== undefined));
+            return {
+                workspaceId,
+                jobs,
+                queueDepth: buildQueueDepth(jobs),
+            };
+        });
     }
 
