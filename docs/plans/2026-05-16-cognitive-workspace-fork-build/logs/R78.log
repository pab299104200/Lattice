9\t    function renderSummary(overview) {\n330\t      const languages = Object.keys(overview.indexStatus.languages || {}).join(', ') || copy.none;\n331\t      return '<section class=\"summary-grid\" aria-label=\"' + escapeAttr(copy.overview) + '\">' +\n332\t        summaryCard(copy.summaryIndexing, overview.indexStatus.status || copy.unknown) +\n333\t        summaryCard(copy.summaryMemories, String(overview.memoryList.count || 0)) +\n334\t        summaryCard(copy.summaryMetrics, String((overview.metrics.signals || []).length)) +\n335\t        summaryCard(copy.summaryGraph, String(overview.indexStatus.nodes || 0)) +\n336\t        '</section><section class=\"kv\">' +\n337\t        kvItem(copy.daemonStatus, overview.indexStatus.status || copy.unknown) +\n338\t        kvItem(copy.memoryCount, String(overview.memoryList.count || 0)) +\n339\t        kvItem(copy.signalCount, String((overview.metrics.signals || []).length)) +\n340\t        kvItem(copy.nodeCount, String(overview.indexStatus.nodes || 0)) +\n341\t        kvItem(copy.fileCount, String(overview.indexStatus.files || 0)) +\n342\t        kvItem(copy.edgeCount, String(overview.indexStatus.edges || 0)) +\n343\t        kvItem(copy.languages, languages) +\n344\t        '</section>';\n345\t    }\n346\t    function renderRoute(payload) {\n347\t      if (payload.routeView && payload.routeView.html) { return payload.routeView.html; }\n348\t      const route = payload.routes.find((entry) => entry.id === payload.activeRoute);\n349\t      const support = payload.capabilities[payload.activeRoute];\n350\t      const supportLabel = support.mode === 'direct' ? copy.capabilityDirect : support.mode === 'composed' ? copy.capabilityComposed : copy.capabilityUnavailable;\n351\t      return '<section class=\"placeholder\" data-testid=\"review-route-' + escapeAttr(payload.activeRoute) + '\"><div class=\"support ' + escapeAttr(support.mode) + '\">' + escape(copy.routeSupport) + ': ' + escape(supportLabel) + '</div><h3>' + escape(route ? route.label : copy.overview) + '</h3><p>' + escape(route ? route.description : copy.overviewDescription) + '</p><p>' + escape(support.mode === 'unsupported' ? copy.routeUnavailable : copy.routePlaceholder) + '</p><small>' + escape(support.reason) + '</small></section>';\n352\t    }\n353\t    function summaryCard(label, value) { return '<div class=\"card\"><small>' + escape(label) + '</small><strong>' + escape(value) + '</strong></div>'; }\n354\t    function kvItem(label, value) { return '<div><span>' + escape(label) + '</span><strong>' + escape(value) + '</strong></div>'; }\n355\t    function escape(value) { return String(value).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('\"', '&quot;').replaceAll(\"'\", '&#39;'); }\n356\t    function escapeAttr(value) { return escape(value); }\n357\t    document.addEventListener('click', (event) => {\n358\t      const target = event.target;\n359\t      if (!(target instanceof Element)) { return; }\n360\t      const action = target.closest('[data-command]');\n361\t      if (!action) { return; }\n362\t      const command = action.getAttribute('data-command');\n363\t      vscode.postMessage({\n364\t        command,\n365\t        route: action.getAttribute('data-route'),\n366\t        filterKey: action.getAttribute('data-filter-key'),\n367\t        sortKey: action.getAttribute('data-sort-key'),\n368\t        sortBy: action.getAttribute('data-sort-by'),\n369\t        memoryId: action.getAttribute('data-memory-id'),\n370\t        value: action.getAttribute('data-value'),\n371\t        eventId: action.getAttribute('data-event-id'),\n372\t        page: numberOrUndefined(action.getAttribute('data-page')),\n373\t        pageSize: numberOrUndefined(action.getAttribute('data-page-size')),\n374\t      });\n375\t    });\n376\t    function numberOrUndefined(value) {\n377\t      if (value === null || value === '') { return undefined; }\n378\t      const parsed = Number(value);\n379\t      return Number.isFinite(parsed) ? parsed : undefined;\n380\t    }\n381\t    window.addEventListener('message', (event) => {\n382\t      const message = event.data;\n383\t      if (message.type === 'state') {\n384\t        state.loading = false;\n385\t        state.error = '';\n386\t        state.payload = message;\n387\t        render();\n388\t        return;\n389\t      }\n390\t      if (message.type === 'error') {\n391\t        state.loading = false;\n392\t        state.error = message.message || copy.error;\n393\t        render();\n394\t      }\n395\t    });\n396\t    render();\n397\t    vscode.postMessage({ command: 'ready' });\n398\t  </script>\n399\t</body>\n400\t</html>`;\n401\t}\n402\t\n403\tfunction escapeHtml(value: string): string {\n404\t    return value\n405\t        .replaceAll('&', '&amp;')\n406\t        .replaceAll('<', '&lt;')\n407\t        .replaceAll('>', '&gt;')\n408\t        .replaceAll('\"', '&quot;')\n409\t        .replaceAll(\"'\", '&#39;');\n410\t}\n411\t"}]},"parent_tool_use_id":"toolu_01NtDyqaaGS9LUZAbVA9SvGe","session_id":"3f5c8929-5870-493f-9d77-6b17226dfdaa","uuid":"4dceb4a9-256b-4c1b-af14-2d70044a5994","timestamp":"2026-05-17T18:18:11.814Z","subagent_type":"Explore","task_description":"Audit StatusBadge and modal patterns"}
