\n254\t      color: var(--accent-foreground);\n255\t      border-color: transparent;\n256\t    }\n257\t    .sr-only {\n258\t      position: absolute;\n259\t      width: 1px;\n260\t      height: 1px;\n261\t      padding: 0;\n262\t      margin: -1px;\n263\t      overflow: hidden;\n264\t      clip: rect(0, 0, 0, 0);\n265\t      border: 0;\n266\t      white-space: nowrap;\n267\t    }\n268\t    .kv { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }\n269\t    .kv div {\n270\t      border: 1px solid var(--border);\n271\t      border-radius: 12px;\n272\t      padding: 10px 12px;\n273\t      background: color-mix(in srgb, var(--surface) 86%, transparent);\n274\t    }\n275\t    .kv span { display: block; color: var(--muted); font-size: 11px; margin-bottom: 6px; }\n276\t    .skeleton {\n277\t      height: 76px;\n278\t      border-radius: 14px;\n279\t      border: 1px solid var(--border);\n280\t      background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 14%, transparent), transparent);\n281\t      background-size: 240px 100%;\n282\t      animation: shimmer 1.2s infinite linear;\n283\t    }\n284\t    @keyframes shimmer { from { background-position: -240px 0; } to { background-position: 240px 0; } }\n285\t    @media (max-width: 900px) {\n286\t      .shell { grid-template-columns: 1fr; }\n287\t      .nav { border-right: 0; border-bottom: 1px solid var(--border); }\n288\t    }\n289\t  </style>\n290\t</head>\n291\t<body>\n292\t  <div id=\"app\"></div>\n293\t  <script nonce=\"${nonce}\">\n294\t    const vscode = acquireVsCodeApi();\n295\t    const copy = ${bootstrap};\n296\t    const state = { loading: true, error: '', payload: undefined };\n297\t\n298\t    function root() { return document.getElementById('app'); }\n299\t    function render() {\n300\t      const host = root();\n301\t      if (!host) { return; }\n302\t      if (state.loading) {\n303\t        host.innerHTML = '<div class=\"content\"><div class=\"toolbar