{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TRuj2633FGtv35ANUfmDj8","type":"tool_result","content":"1\t/// <reference lib=\"dom\" />\n2\t\n3\tdeclare function renderStatusBadge(status: string, i18n: { t: (key: string, params?: Record<string, string | number>) => string }): string;\n4\tdeclare function openProposalDialog(\n5\t    options: {\n6\t        proposal: Record<string, unknown>;\n7\t        onApply: (reason?: string) => Promise<unknown>;\n8\t        onReject: (reason: string) => Promise<unknown>;\n9\t    },\n10\t    i18n: { t: (key: string, params?: Record<string, string | number>) => string }\n11\t): HTMLDialogElement;\n12\tdeclare function reportReviewViewError(route: string, message: string): void;\n13\t\n14\texport function mountPromotionQueue(\n15\t    host: HTMLElement,\n16\t    bridge: {\n17\t        listPromotionProposals: () => Promise<Record<string, unknown>>;\n18\t        applyPromotion: (proposalId: string, reason?: string) => Promise<unknown>;\n19\t        rejectPromotion: (proposalId: string, reason: string) => Promise<unknown>;\n20\t    },\n21\t    i18n: { t: (key: string, params?: Record<string, string | number>) => string }\n22\t): void {\n23\t    let rows: PromotionRow[] = [];\n24\t    let sortKey: PromotionSortKey = 'createdAt';\n25\t    let sortDirection: 'asc' | 'desc' = 'desc';\n26\t\n27\t    void load();\n28\t\n29\t    async function load(): Promise<void> {\n30\t        renderLoading(host);\n31\t        try {\n32\t            const report = await bridge.listPromotionProposals();\n33\t            rows = readProposalRows(report);\n34\t            renderTable();\n35\t        } catch (error) {\n36\t            const message = errorMessage(error);\n37\t            renderError(host, message);\n38\t            reportReviewViewError('promotionQueue', message);\n39\t        }\n40\t    }\n41\t\n42\t    function renderTable(): void {\n43\t        host.innerHTML = '';\n44\t        const container = document.createElement('section');\n45\t        container.className = 'queue-surface';\n46\t        container.setAttribute('data-testid', 'review-promotion-queue');\n47\t        container.appendChild(renderNotes());\n48\t        if (rows.length === 0) {\n49\t            container.appendChild(renderEmptyState(i18n.t('promotionQueue.empty')));\n50\t            host.appendChild(container);\n51\t            return;\n52\t        }\n53\t        const table = document.createElement('table');\n54\t        table.className = 'review-table';\n55\t        table.append(createHead(), createBody());\n56\t        container.appendChild(table);\n57\t        host.appendChild(container);\n58\t    }\n59\t\n60\t    function renderNotes(): HTMLElement {\n61\t        const note = document.createElement('div');\n62\t        note.className = 'banner info';\n63\t        note.textContent = i18n.t('promotionQueue.description');\n64\t        return note;\n65\t    }\n66\t\n67\t    function createHead(): HTMLElement {\n68\t        const thead = document.createElement('thead');\n69\t        const row = document.createElement('tr');\n70\t        row.append(\n71\t            sortableHeader('proposedClass', i18n.t('promotionQueue.columns.proposedClass')),\n72\t            plainHeader(i18n.t('promotionQueue.columns.currentScope')),\n73\t            plainHeader(i18n.t('promotionQueue.columns.targetScope')),\n74\t            sortableHeader('confidence', i18n.t('promotionQueue.columns.confidence')),\n75\t            sortableHeader('evidenceCount', i18n.t('promotionQueue.columns.evidenceCount')),\n76\t            sortableHeader('createdAt', i18n.t('promotionQueue.columns.createdAt')),\n77\t            sortableHeader('status', i18n.t('promotionQueue.columns.status')),\n78\t            plainHeader(i18n.t('promotionQueue.columns.actions')),\n79\t        );\n80\t        thead.appendChild(row);\n81\t        return thead;\n82\t    }\n83\t\n84\t    function createBody(): HTMLElement {\n85\t        const tbody = document.createElement('tbody');\n86\t        for (const entry of sortedRows()) {\n87\t            const row = document.createElement('tr');\n88\t            row.append(\n89\t                textCell(entry.proposedClass),\n90\t                textCell(entry.currentScope),\n91\t                textCell(entry.targetScope),\n92\t                textCell(formatPercent(entry.confidence)),\n93\t                textCell(String(entry.evidenceCount)),\n94\t                textCell(formatTimestamp(entry.createdAt)),\n95\t                badgeCell(entry.status),\n96\t                actionCell(entry),\n97\t            );\n98\t            tbody.appendChild(row);\n99\t        }\n100\t        return tbody;\n101\t    }\n102\t\n103\t    function sortedRows(): PromotionRow[] {\n104\t        const factor = sortDirection === 'asc' ? 1 : -1;\n105\t        return [...rows].sort((left, right) => {\n106\t            const leftValue = sortableValue(left, sortKey);\n107\t            const rightValue = sortableValue(right, sortKey);\n108\t            if (leftValue < rightValue) {\n109\t                return -1 * factor;\n110\t            }\n111\t            if (leftValue > rightValue) {\n112\t                return 1 * factor;\n113\t            }\n114\t            return 0;\n115\t        });\n116\t    }\n117\t\n118\t    function sortableHeader(key: PromotionSortKey, label: string): HTMLElement {\n119\t        const cell = document.createElement('th');\n120\t        const button = document.createElement('button');\n121\t        button.type = 'button';\n122\t        button.className = 'table-sort';\n123\t        button.textContent = sortLabel(key, label);\n124\t        button.addEventListener('click', () => {\n125\t            if (sortKey === key) {\n126\t                sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';\n127\t            } else {\n128\t                sortKey = key;\n129\t                sortDirection = key === 'proposedClass' || key === 'status' ? 'asc' : 'desc';\n130\t            }\n131\t            renderTable();\n132\t        });\n133\t        cell.appendChild(button);\n134\t        return cell;\n135\t    }\n136\t\n137\t    function sortLabel(key: PromotionSortKey, label: string): string {\n138\t        if (sortKey !== key) {\n139\t            return label;\n140\t        }\n141\t        return `${label} ${sortDirection === 'asc' ? '↑' : '↓'}`;\n142\t    }\n143\t\n144\t    function badgeCell(status: string): HTMLElement {\n145\t        const cell = document.createElement('td');\n146\t        cell.innerHTML = renderStatusBadge(status, i18n);\n147\t        return cell;\n148\t    }\n149\t\n150\t    function actionCell(entry: PromotionRow): HTMLElement {\n151\t        const cell = document.createElement('td');\n152\t        const actions = document.createElement('div');\n153\t        actions.className = 'table-actions';\n154\t        actions.append(\n155\t            queueAction(i18n.t('promotionQueue.actions.review'), () => openDialog(entry, 'review')),\n156\t            queueAction(i18n.t('promotionQueue.actions.accept'), () => openDialog(entry, 'accept')),\n157\t            queueAction(i18n.t('promotionQueue.actions.reject'), () => openDialog(entry, 'reject')),\n158\t        );\n159\t        cell.appendChild(actions);\n160\t        return cell;\n161\t    }\n162\t\n163\t    function openDialog(entry: PromotionRow, mode: 'review' | 'accept' | 'reject'): void {\n164\t        openProposalDialog(\n165\t            {\n166\t                proposal: {\n167\t                    title: i18n.t('proposalDialog.promotionTitle', { value: entry.proposedClass }),\n168\t                    summary: entry.summary,\n169\t                    proposalKind: entry.proposalKind,\n170\t                    status: i18n.t(`reviewStatus.${entry.status}`),\n171\t                    proposedClass: entry.proposedClass,\n172\t                    currentScope: entry.currentScope,\n173\t                    targetScope: entry.targetScope,\n174\t                    confidence: ent