  proposedClass: string;\n229\t    currentScope: string;\n230\t    targetScope: string;\n231\t    confidence: number;\n232\t    evidenceCount: number;\n233\t    createdAt: number;\n234\t    status: string;\n235\t    priorState?: unknown;\n236\t    proposedState?: unknown;\n237\t    evidence?: unknown;\n238\t    provenance?: unknown;\n239\t}\n240\t\n241\tfunction readProposalRows(report: Record<string, unknown>): PromotionRow[] {\n242\t    const proposals = Array.isArray(report.proposals) ? report.proposals : [];\n243\t    return proposals\n244\t        .map((entry) => asRecord(entry))\n245\t        .filter((entry): entry is Record<string, unknown> => entry !== undefined)\n246\t        .map((entry) => {\n247\t            const proposed = extractState(entry.proposedState);\n248\t            const prior = extractState(entry.priorState);\n249\t            return {\n250\t                proposalId: stringValue(entry.proposalId),\n251\t                proposalKind: stringValue(entry.proposalKind),\n252\t                summary: stringValue(entry.summary),\n253\t                proposedClass: stringValue(proposed.memory_class ?? proposed.memoryClass ?? entry.proposedClass) || '—',\n254\t                currentScope: stringValue(prior.scope ?? entry.currentScope) || '—',\n255\t                targetScope: stringValue(proposed.scope ?? entry.targetScope) || '—',\n256\t                confidence: numberValue(proposed.confidence ?? entry.confidence),\n257\t                evidenceCount: numberValue(entry.evidenceCount),\n258\t                createdAt: numberValue(entry.createdAt),\n259\t                status: stringValue(entry.decision || entry.status || 'pending'),\n260\t                priorState: entry.priorState,\n261\t                proposedState: entry.proposedState,\n262\t                evidence: entry.evidence,\n263\t                provenance: entry.provenance,\n264\t            };\n265\t        });\n266\t}\n267\t\n268\tfunction extractState(value: unknown): Record<string, unknown> {\n269\t    const record = asRecord(value);\n270\t    if (!record) {\n271\t        return {};\n272\t    }\n273\t    const nested = asRecord(record.memory);\n274\t    return nested ?? record;\n275\t}\n276\t\n277\tfunction sortableValue(row: PromotionRow, key: PromotionSortKey): number | string {\n278\t    switch (key) {\n279\t        case 'proposedClass':\n280\t            return row.proposedClass.toLowerCase();\n281\t        case 'confidence':\n282\t            return row.confidence;\n283\t        case 'evidenceCount':\n284\t            return row.evidenceCount;\n285\t        case 'createdAt':\n286\t            return row.createdAt;\n287\t        case 'status':\n288\t            return row.status.toLowerCase();\n289\t    }\n290\t}\n291\t\n292\tfunction plainHeader(label: string): HTMLElement {\n293\t    const cell = document.createElement('th');\n294\t    cell.textContent = label;\n295\t    return cell;\n296\t}\n297\t\n298\tfunction textCell(value: string): HTMLElement {\n299\t    const cell = document.createElement('td');\n300\t    cell.textContent = value;\n301\t    return cell;\n302\t}\n303\t\n304\tfunction queueAction(label: string, onClick: () => void): HTMLElement {\n305\t    const button = document.createElement('button');\n306\t    button.type = 'button';\n307\t    button.className = 'table-action';\n308\t    button.textContent = label;\n309\t    button.addEventListener('click', onClick);\n310\t    return button;\n311\t}\n312\t\n313\tfunction renderLoading(host: HTMLElement): void {\n314\t    host.innerHTML = '<div class=\"queue-surface\"><div class=\"skeleton\"></div><div class=\"skeleton\"></div><div class=\"skeleton\"></div></div>';\n315\t}\n316\t\n317\tfunction renderError(host: HTMLElement, message: string): void {\n318\t    host.innerHTML = `<div class=\"queue-surface\"><div class=\"banner error\" role=\"alert\">${escapeHtml(message)}</div></div>`;\n319\t}\n320\t\n321\tfunction renderEmptyState(message: string): HTMLElement {\n322\t    const box = document.createElement('div');\n323\t    box.className = 'placeholder';\n324\t    const title = document.createElement('h3');\n325\t    title.textContent = message;\n326\t    box.appendChild(title);\n327\t    return box;\n328\t}\n329\t\n330\tfunction asRecord(value: unknown): Record<string, unknown> | undefined {\n331\t    return typeof value === 'object' && value !== null && !Array.isArray(value)\n332\t        ? value as Record<string, unknown>\n333\t        : undefined;\n334\t}\n335\t\n336\tfunction stringValue(value: unknown): string {\n337\t    return typeof value === 'string' ? value : '';\n338\t}\n339\t\n340\tfunction numberValue(value: unknown): number {\n341\t    return typeof value === 'number' ? value : 0;\n342\t}\n343\t\n344\tfunction formatPercent(value: number): string {\n345\t    return value ? `${(value * 100).toFixed(1)}%` : '—';\n346\t}\n347\t\n348\tfunction formatTimestamp(value: number): string {\n349\t    if (!value) {\n350\t        return '—';\n351\t    }\n352\t    const millis = value > 1_000_000_000_000 ? Math.floor(value / 1000) : value * 1000;\n353\t    return new Date(millis).toLocaleString();\n354\t}\n355\t\n356\tfunction errorMessage(error: unknown): string {\n357\t    return error instanceof Error && error.message ? error.message : 'Request failed.';\n358\t}\n359\t\n360\tfunction escapeHtml(value: string): string {\n361\t    return value\n362\t        .replaceAll('&', '&amp;')\n363\t        .replaceAll('<', '&lt;')\n364\t        .replaceAll('>', '&gt;')\n365\t        .replaceAll('\"', '&quot;')\n366\t        .replaceAll(\"'\", '&#39;');\n367\t}\n368\t"}]},"parent_tool_use_id":"toolu_01QKg7EhpqnfNi9aRGKUBr62","session_id":"3f5c8929-5870-493f-9d77-6b17226dfdaa","uuid":"cea9b1e1-2c32-4cee-a597-6f728d61a49a","timestamp":"2026-05-17T18:17:58.061Z","subagent_type":"Explore","task_description":"Audit pagination, sort headers, states"}
