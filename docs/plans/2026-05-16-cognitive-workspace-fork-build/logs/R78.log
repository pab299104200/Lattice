 async function hydrateRows(payload: Record<string, unknown>): Promise<ContradictionRow[]> {\n44\t        const conflicts = Array.isArray(payload.conflicts) ? payload.conflicts : [];\n45\t        const items = conflicts\n46\t            .map((entry) => asRecord(entry))\n47\t            .filter((entry): entry is Record<string, unknown> => entry !== undefined);\n48\t        const ids = new Set<string>();\n49\t        for (const entry of items) {\n50\t            ids.add(stringValue(entry.source));\n51\t            ids.add(stringValue(entry.target));\n52\t        }\n53\t        const details = new Map<string, Record<string, unknown>>();\n54\t        await Promise.all(\n55\t            [...ids]\n56\t                .filter((id) => id.length > 0)\n57\t                .map(async (id) => {\n58\t                    try {\n59\t                        details.set(id, await bridge.getMemoryEvidence(id));\n60\t                    } catch {\n61\t                        details.set(id, {});\n62\t                    }\n63\t                }),\n64\t        );\n65\t        return items.map((entry) => {\n66\t            const sourceId = stringValue(entry.source);\n67\t            const targetId = stringValue(entry.target);\n68\t            const source = details.get(sourceId) ?? {};\n69\t            const target = details.get(targetId) ?? {};\n70\t            return {\n71\t                sourceId,\n72\t                targetId,\n73\t                memoryA: memoryLabel(sourceId, source),\n74\t                memoryB: memoryLabel(targetId, target),\n75\t                linkType: stringValue(entry.linkType),\n76\t                detectedBy: stringValue(entry.createdBy),\n77\t                createdAt: numberValue(entry.createdAt),\n78\t                status: stringValue(entry.linkVerificationStatus || 'pending'),\n79\t                reason: stringValue(entry.reason),\n80\t                sourceMemory: source,\n81\t                targetMemory: target,\n82\t            };\n83\t        });\n84\t    }\n85\t\n86\t    function renderTable(): void {\n87\t        host.innerHTML = '';\n88\t        const container = document.createElement('section');\n89\t        container.className = 'queue-surface';\n90\t        container.setAttribute('data-testid', 'review-contradiction-queue');\n91\t        container.appendChild(renderInfoBanner());\n92\t        if (rows.length === 0) {\n93\t            container.appendChild(renderEmptyState(i18n.t('contradictionQueue.empty')));\n94\t            host.appendChild(container);\n95\t            return;\n96\t        }\n97\t        const table = document.createElement('table');\n98\t        table.className = 'review-table';\n99\t        table.append(createHead(), createBody());\n100\t        container.appendChild(table);\n101\t        host.appendChild(container);\n102\t    }\n103\t\n104\t    function renderInfoBanner(): HTMLElement {\n105\t        const note = document.createElement('div');\n106\t        note.className = 'banner info';\n107\t        note.textContent = i18n.t('contradictionQueue.description');\n108\t        return note;\n109\t    }\n110\t\n111\t    function createHead(): HTMLElement {\n112\t        const thead = document.createElement('thead');\n113\t        const row = document.createElement('tr');\n114\t        row.append(\n115\t            plainHeader(i18n.t('contradictionQueue.columns.memoryA')),\n116\t            plainHeader(i18n.t('contradictionQueue.columns.memoryB')),\n117\t            plainHeader(i18n.t('contradictionQueue.columns.linkType')),\n118\t            plainHeader(i18n.t('contradictionQueue.columns.detectedBy')),\n119\t            sortableHeader('createdAt', i18n.t('contradictionQueue.columns.createdAt')),\n120\t            sortableHeader('status', i18n.t('contradictionQueue.columns.status')),\n121\t            plainHeader(i18n.t('contradictionQueue.columns.actions')),\n122\t        );\n123\t        thead.appendChild(row);\n124\t        return thead;\n125\t    }\n126\t\n127\t    function createBody(): HTMLElement {\n128\t        const tbody = document.createElement('tbody');\n129\t        for (const entry of sortedRows()) {\n130\t            const row = document.createElement('tr');\n131\t            row.append(\n132\t                textCell(entry.memoryA),\n133\t                textCell(entry.memoryB),\n134\t                textCell(entry.linkType),\n135\t                textCell(entry.detectedBy),\n136\t                textCell(formatTimestamp(entry.createdAt)),\n137\t                badgeCell(entry.status),\n138\t                actionCell(entry),\n139\t            );\n140\t            tbody.appendChild(row);\n141\t        }\n142\t        return tbody;\n143\t    }\n144\t\n145\t    function sortedRows(): ContradictionRow[] {\n146\t        const factor = sortDirection === 'asc' ? 1 : -1;\n147\t        return [...rows].sort((left, right) => {\n148\t            const leftValue = sortableValue(left, sortKey);\n149\t            const rightValue = sortableValue(right, sortKey);\n150\t            if (leftValue < rightValue) {\n151\t                return -1 * factor;\n152\t            }\n153\t            if (leftValue > rightValue) {\n154\t                return 1 * factor;\n155\t            }\n156\t            return 0;\n157\t        });\n158\t    }\n159\t\n160\t    function sortableHeader(key: ContradictionSortKey, label: string): HTMLElement {\n161\t        const cell = document.createElement('th');\n162\t        const button = document.createElement('button');\n163\t        button.type = 'button';\n164\t        button.className = 'table-sort';\n165\t        button.textContent = sortLabel(key, label);\n166\t        button.addEventListener('click', () => {\n167\t            if (sortKey === key) {\n168\t                sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';\n169\t            } else {\n170\t                sortKey = key;\n171\t                sortDirection = key === 'status' ? 'asc' : 'desc';\n172\t            }\n173\t            renderTable();\n174\t        });\n175\t        cell.appendChild(button);\n176\t        return cell;\n177\t    }\n178\t\n179\t    function sortLabel(key: ContradictionSortKey, label: string): string {\n180\t        if (sortKey !== key) {\n181\t            return label;\n182\t        }\n183\t        return `${label} ${sortDirection === 'asc' ? '↑' : '↓'}`;\n184\t    }\n185\t\n186\t    function badgeCell(status: string): HTMLElement {\n187\t        const cell = document.createElement('td');\n188\t        cell.innerHTML = renderStatusBadge(status, i18n);\n189\t        return cell;\n190\t    }\n191\t\n192\t    function actionCell(entry: ContradictionRow): HTMLElement {\n193\t        const cell = document.createElement('td');\n194\t        const actions = document.createElement('div');\n195\t        actions.className = 'table-actions';\n196\t        actions.append(\n197\t            queueAction(i18n.t('contradictionQueue.actions.review'), () => openDialog(entry, 'review')),\n198\t            queueAction(i18n.t('contradictionQueue.actions.accept'), () => openDialog(entry, 'accept')),\n199\t            queueAction(i18n.t('contradictionQueue.actions.reject'), () => openDialog(entry, 'reject')),\n200\t        );\n201\t        cell.appendChild(actions);\n202\t        return cell;\n203\t    }\n204\t\n205\t    function openDialog(entry: ContradictionRow, mode: 'review' | 'accept' | 'reject'): void {\n206\t        openProposalDialog(\n207\t            {\n208\t                proposal: {\n209\t                    title: i18n.t('proposalDialog.contradictionTitle'),\n210\t                    summary: entry.reason,\n211\t                    proposalKind: contradictionProposalKind(entry),\n212\t                    status: i18n.t(`reviewStatus.${entry.status}`),\n213\t                    proposedClass: stringValue(entry.targetMemory.memoryClass) || 'Memory',\n214\t                    currentScope: stringValue(entry.targetMemory.scope) || '—',\n215\t                    targetScope: stringValue(entry.targetMemory.scope) || '—',\n216\t                    createdAt: entry.createdAt,\n217\t                    evidenceCount: 2,\n218\t                    expectedEffect: contradictionEffect(entry, i18n),\n219\t                    priorState: entry.targetMemory,\n220\t                    proposedState: predictedState(entry),\n221\t                    evidence: {\n222\t                        source_memory_ids: [entry.sourceId, entry.targetId],\n223\t                        link_type: entry.linkType,\n224\t                        detected_by: entry.detectedBy,\n225\t                        reason: entry.reason,\n226\t                    },\n227\t                    provenance: {\n228\t                        model: entry.detectedBy,\n229\t                    },\n230\t                    initialMode: mode,\n231\t                },\n232\t                onApply: async (reason?: string) => {\n233\t                    await bridge.applyContradictionResolution({\n234\t                        sourceMemoryId: entry.sourceId,\n235\t                        targetMemoryId: entry.targetId,\n236\t                        linkType: entry.linkType,\n237\t                        reason,\n238\t                        detectedBy: entry.detectedBy,\n239\t                    });\n240\t                    await load();\n241\t                },\n242\t                onReject: async (reason: string) => {\n243\t                    await bridge.rejectContradictionResolution({\n244\t                        sourceMemoryId: entry.sourceId,\n245\t                        targetMemoryId: entry.targetId,\n246\t                        linkType: entry.linkType,\n247\t                        reason,\n248\t                        detectedBy: entry.detectedBy,\n249\t                    });\n250\t                    await load();\n251\t                },\n252\t            },\n253\t            i18n,\n254\t        );\n255\t    }\n256\t}\n257\t\n258\texport function serializeContradictionQueue(): string {\n259\t    return [\n260\t        mountContradictionQueue,\n261\t        contradictionProposalKind,\n262\t        contradictionEffect,\n263\t        predictedState,\n264\t        sortableValue,\n265\t        plainHeader,\n266\t        textCell,\n267\t        queueAction,\n268\t        memoryLabel,\n269\t        renderLoading,\n270\t        renderError,\n271\t        renderEmptyState,\n272\t        asRecord,\n273\t        stringValue,\n274\t        numberValue,\n275\t        formatTimestamp,\n276\t        errorMessage,\n277\t        escapeHtml,\n278\t    ].map((entry) => entry.toString()).join('\\n');\n279\t}\n280\t\n281\ttype ContradictionSortKey = 'createdAt' | 'status';\n282\t\n283\tinterface ContradictionRow {\n284\t    sourceId: string;\n285\t    targetId: string;\n286\t    memoryA: string;\n287\t    memoryB: string;\n288\t    linkType: string;\n289\t    detectedBy: string;\n290\t    createdAt: number;\n291\t    status: string;\n292\t    reason: string;\n293\t    sourceMemory: Record<string, unknown>;\n294\t    targetMemory: Record<string, unknown>;\n295\t}\n296\t\n297\tfunction contradictionProposalKind(entry: ContradictionRow): string {\n298\t    return entry.linkType === 'supersedes' ? 'supersede' : 'mark_invalidated';\n299\t}\n300\t\n301\tfunction contradictionEffect(\n302\t    entry: ContradictionRow,\n303\t    i18n: { t: (key: string, params?: Record<string, string | number>) => string }\n304\t): string {\n305\t    if (entry.linkType === 'supersedes') {\n306\t        return i18n.t('proposalDialog.supersedeEffect', { value: entry.targetId });\n307\t    }\n308\t    return i18n.t('proposalDialog.invalidateEffect', { value: entry.targetId });\n309\t}\n310\t\n311\tfunction predictedState(entry: ContradictionRow): Record<string, unknown> {\n312\t    const next = { ...entry.targetMemory };\n313\t    if (entry.linkType === 'supersedes') {\n314\t        next.verificationStatus = 'superseded';\n315\t        next.supersededBy = entry.sourceId;\n316\t        return next;\n317\t    }\n318\t    next.verificationStatus = 'invalidated';\n319\t    next.staleReason = entry.reason;\n320\t    return next;\n321\t}\n322\t\n323\tfunction sortableValue(row: ContradictionRow, key: ContradictionSortKey): number | string {\n324\t    switch (key) {\n325\t        case 'createdAt':\n326\t            return row.createdAt;\n327\t        case 'status':\n328\t            return row.status.toLowerCase();\n329\t    }\n330\t}\n331\t\n332\tfunction plainHeader(label: string): HTMLElement {\n333\t    const cell = document.createElement('th');\n334\t    cell.textContent = label;\n335\t    return cell;\n336\t}\n337\t\n338\tfunction textCell(value: string): HTMLElement {\n339\t    const cell = document.createElement('td');\n340\t    cell.textContent = value;\n341\t    return cell;\n342\t}\n343\t\n344\tfunction queueAction(label: string, onClick: () => void): HTMLElement {\n345\t    const button = document.createElement('button');\n346\t    button.type = 'button';\n347\t    button.className = 'table-action';\n348\t    button.textContent = label;\n349\t    button.addEventListener('click', onClick);\n350\t    return button;\n351\t}\n352\t\n353\tfunction memoryLabel(memoryId: string, memory: Record<string, unknown>): string {\n354\t    const content = stringValue(memory.content);\n355\t    if (content) {\n356\t        return content.length > 72 ? `${content.slice(0, 69)}...` : content;\n357\t    }\n358\t    return memoryId;\n359\t}\n360\t\n361\tfunction renderLoading(host: HTMLElement): void {\n362\t    host.innerHTML = '<div class=\"queue-surface\"><div class=\"skeleton\"></div><div class=\"skeleton\"></div><div class=\"skeleton\"></div></div>';\n363\t}\n364\t\n365\tfunction renderError(host: HTMLElement, message: string): void {\n366\t    host.innerHTML = `<div class=\"queue-surface\"><div class=\"banner error\" role=\"alert\">${escapeHtml(message)}</div></div>`;\n367\t}\n368\t\n369\tfunction renderEmptyState(message: string): HTMLElement {\n370\t    const box = document.createElement('div');\n371\t    box.className = 'placeholder';\n372\t    const title = document.createElement('h3');\n373\t    title.textContent = message;\n374\t    box.appendChild(title);\n375\t    return box;\n376\t}\n377\t\n378\tfunction asRecord(value: unknown): Record<string, unknown> | undefined {\n379\t    return typeof value === 'object' && value !== null && !Array.isArray(value)\n380\t        ? value as Record<string, unknown>\n381\t        : undefined;\n382\t}\n383\t\n384\tfunction stringValue(value: unknown): string {\n385\t    return typeof value === 'string' ? value : '';\n386\t}\n387\t\n388\tfunction numberValue(value: unknown): number {\n389\t    return typeof value === 'number' ? value : 0;\n390\t}\n391\t\n392\tfunction formatTimestamp(value: number): string {\n393\t    if (!value) {\n394\t        return '—';\n395\t    }\n396\t    const millis = value > 1_000_000_000_000 ? Math.floor(value / 1000) : value * 1000;\n397\t    return new Date(millis).toLocaleString();\n398\t}\n399\t\n400\tfunction errorMessage(error: unknown): string {\n401\t    return error instanceof Error && error.message ? error.message : 'Request failed.';\n402\t}\n403\t\n404\tfunction escapeHtml(value: string): string {\n405\t    return value\n406\t        .replaceAll('&', '&amp;')\n407\t        .replaceAll('<', '&lt;')\n408\t        .replaceAll('>', '&gt;')\n409\t        .replaceAll('\"', '&quot;')\n410\t        .replaceAll(\"'\", '&#39;');\n411\t}\n412\t"}]},"parent_tool_use_id":"toolu_01YL1bW3bEAsvfd93Vq2Fj4H","session_id":"3f5c8929-5870-493f-9d77-6b17226dfdaa","uuid":"d277968d-3b4e-4545-acaf-950e318478cd","timestamp":"2026-05-17T18:17:52.121Z","subagent_type":"Explore","task_description":"Audit mutation error handling"}
