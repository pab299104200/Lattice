{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J191XykvksMS7DGHftj96x","type":"tool_result","content":"1\timport * as crypto from 'crypto';\n2\timport * as vscode from 'vscode';\n3\timport { ReviewI18n } from './i18n';\n4\t\n5\texport function renderReviewPanelHtml(webview: vscode.Webview, i18n: ReviewI18n): string {\n6\t    const nonce = crypto.randomBytes(16).toString('hex');\n7\t    const bootstrap = JSON.stringify({\n8\t        title: i18n.t('reviewPanel.title'),\n9\t        subtitle: i18n.t('reviewPanel.subtitle'),\n10\t        loading: i18n.t('reviewPanel.loading'),\n11\t        empty: i18n.t('reviewPanel.empty'),\n12\t        error: i18n.t('reviewPanel.error'),\n13\t        refresh: i18n.t('reviewPanel.refresh'),\n14\t        retry: i18n.t('reviewPanel.retry'),\n15\t        overview: i18n.t('reviewPanel.overview'),\n16\t        overviewDescription: i18n.t('reviewPanel.overviewDescription'),\n17\t        routePlaceholder: i18n.t('reviewPanel.routePlaceholder'),\n18\t        routeUnavailable: i18n.t('reviewPanel.routeUnavailable'),\n19\t        capabilityDirect: i18n.t('reviewPanel.capabilityDirect'),\n20\t        capabilityComposed: i18n.t('reviewPanel.capabilityComposed'),\n21\t        capabilityUnavailable: i18n.t('reviewPanel.capabilityUnavailable'),\n22\t        summaryIndexing: i18n.t('reviewPanel.summaryIndexing'),\n23\t        summaryMemories: i18n.t('reviewPanel.summaryMemories'),\n24\t        summaryMetrics: i18n.t('reviewPanel.summaryMetrics'),\n25\t        summaryGraph: i18n.t('reviewPanel.summaryGraph'),\n26\t        daemonStatus: i18n.t('reviewOverview.daemonStatus'),\n27\t        memoryCount: i18n.t('reviewOverview.memoryCount'),\n28\t        signalCount: i18n.t('reviewOverview.signalCount'),\n29\t        nodeCount: i18n.t('reviewOverview.nodeCount'),\n30\t        fileCount: i18n.t('reviewOverview.fileCount'),\n31\t        edgeCount: i18n.t('reviewOverview.edgeCount'),\n32\t        languages: i18n.t('reviewOverview.languages'),\n33\t        none: i18n.t('reviewOverview.none'),\n34\t        unknown: i18n.t('reviewOverview.unknown'),\n35\t        routeSupport: i18n.t('reviewOverview.routeSupport'),\n36\t    });\n37\t    const csp = [\n38\t        \"default-src 'none'\",\n39\t        `img-src ${webview.cspSource} data:`,\n40\t        `style-src ${webview.cspSource} 'unsafe-inline'`,\n41\t        `script-src 'nonce-${nonce}'`,\n42\t    ].join('; ');\n43\t\n44\t    return `<!DOCTYPE html>\n45\t<html lang=\"en\">\n46\t<head>\n47\t  <meta charset=\"UTF-8\" />\n48\t  <meta http-equiv=\"Content-Security-Policy\" content=\"${csp}\" />\n49\t  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n50\t  <title>${escapeHtml(i18n.t('reviewPanel.title'))}</title>\n51\t  <style>\n52\t    :root {\n53\t      color-scheme: light dark;\n54\t      --border: color-mix(in srgb, var(--vscode-panel-border) 72%, transparent);\n55\t      --muted: var(--vscode-descriptionForeground);\n56\t      --surface: color-mix(in srgb, var(--vscode-editor-background) 92%, var(--vscode-sideBar-background));\n57\t      --surface-alt: color-mix(in srgb, var(--vscode-editor-background) 84%, var(--vscode-sideBar-background));\n58\t      --accent: var(--vscode-button-background);\n59\t      --accent-foreground: var(--vscode-button-foreground);\n60\t      --warning: var(--vscode-editorWarning-foreground);\n61\t      --error: var(--vscode-errorForeground);\n62\t      --success: var(--vscode-testing-iconPassed);\n63\t    }\n64\t    * { box-sizing: border-box; }\n65\t    body {\n66\t      margin: 0;\n67\t      font-family: var(--vscode-font-family);\n68\t      color: var(--vscode-foreground);\n69\t      background: radial-gradient(circle at top right, color-mix(in srgb, var(--accent) 12%, transparent), transparent 42%),\n70\t        linear-gradient(180deg, var(--surface), var(--vscode-editor-background));\n71\t    }\n72\t    button, input, textarea, select { font: inherit; color: inherit; }\n73\t    button