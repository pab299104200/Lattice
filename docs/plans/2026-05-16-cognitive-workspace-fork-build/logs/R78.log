 async function hydrateRows(payload: Record<string, unknown>): Promise<ContradictionRow[]> {\n44\t        const conflicts = Array.isArray(payload.conflicts) ? payload.conflicts : [];\n45\t        const items = conflicts\n46\t            .map((entry) => asRecord(entry))\n47\t            .filter((entry): entry is Record<string, unknown> => entry !== undefined);\n48\t        const ids = new Set<string>();\n49\t        for (const entry of items) {\n50\t            ids.add(stringValue(entry.source));\n51\t            ids.add(stringValue(entry.target));\n52\t        }\n53\t        const details = new Map<string, Record<string, unknown>>();\n54\t        await Promise.all(\n55\t            [...ids]\n56\t                .filter((id) => id.length > 0)\n57\t                .map(async (id) => {\n58\t                    try {\n59\t                        details.set(id, await bridge.getMemoryEvidence(id));\n60\t                    } catch {\n61\t                        details.set(id, {});\n62\t                    }\n63\t                }),\n64\t        );\n65\t        return items.map((entry) => {\n66\t            const sourceId = stringValue(entry.source);\n67\t            const targetId = stringValue(entry.target);\n68\t            const source = details.get(sourceId) ?? {};\n69\t            const target = details.get(targetId) ?? {};\n70\t            return {\n71\t                sourceId,\n72\t                targetId,\n73\t                memoryA: memoryLabel(sourceId, source),\n74\t                memoryB: memoryLabel(targetId, target),\n75\t                linkType: stringValue(entry.linkType),\n76\t                detectedBy: stringValue(entry.createdBy),\n77\t                createdAt: numberValue(entry.createdAt),\n78\t                status: stringValue(entry.linkVerificationStatus || 'pending'),\n79\t                reason: stringValue(entry.reason),\n80\t                sourceMemory: source,\n81\t                targetMemory: target,\n82\t            };\n83\t        });\n84\t    }\n85\t\n86\t    function renderTable(): void {\n87\t        host.innerHTML = '';\n88\t        const container = document.createElement('section');\n89\t        container.className = 'queue-surface';\n90\t        container.setAttribute('data-testid', 'review-contradiction-queue');\n91\t        container.appendChild(renderInfoBanner());\n92\t        if (rows.length === 0) {\n93\t            container.appendChild(renderEmptyState(i18n.t('contradictionQueue.empty')));\n94\t            host.appendChild(container);\n95\t            return;\n96\t        }\n97\t        const table = document.createElement('table');\n98\t        table.className = 'review-table';\n99\t        table.append(createHead(), createBody());\n100\t        container.appendChild(table);\n101\t        host.appendChild(container);\n102\t    }\n103\t\n104\t    function renderInfoBanner(): HTMLElement {\n105\t        const note = document.createElement('div');\n106\t        note.className = 'banner info';\n107\t        note.textContent = i18n.t('contradictionQueue.description');\n108\t        return note;\n109\t    }\n110\t\n111\t    function createHead(): HTMLElement {\n112\t        const thead = document.createElement('thead');\n113\t        const row = document.createElement('tr');\n114\t        row.append(\n115\t            plainHeader(i18n.t('contradictionQueue.columns.memoryA')),\n116\t            plainHeader(i18n.t('contradictionQueue.columns.memoryB')),\n117\t            plainHeader(i18n.t('contradictionQueue.columns.linkType')),\n118\t            plainHeader(i18n.t('contradictionQueue.columns.detectedBy')),\n119\t            sortableHeader('createdAt', i18n.t('contradictionQueue.columns.createdAt')),\n120\t            sortableHeader('status', i18n.t('contradictionQueue.columns.status')),\n121\t            plainHeader(i18n.t('contradictionQueue.columns.actions')),\n122\t        );\n123\t        thead.appendChild(row);\n124\t        return thead;\n125\t    }\n126\t\n127\t    function