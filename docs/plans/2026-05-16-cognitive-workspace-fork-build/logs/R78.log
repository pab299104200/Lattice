{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SVmWPyXg5fwpoZJM9P2Rbk","type":"tool_result","content":"1\timport { escapeAttr, escapeHtml } from './components/html';\n2\timport { ReviewI18n } from './i18n';\n3\timport { ReviewRpcBridgeContract } from './rpcBridge';\n4\timport { ReviewFamilyCount, ReviewGraphDiagnosticRow, ReviewWorkspaceGraphHealth } from './rpcPayloads';\n5\t\n6\ttype FamilySortKey = 'family' | 'count';\n7\ttype DiagnosticSortKey = 'identity' | 'reason';\n8\ttype SortDirection = 'asc' | 'desc';\n9\ttype GraphPanel = 'nodes' | 'edges' | 'brokenReferences' | 'staleEdges' | 'orphanSymbols';\n10\t\n11\texport interface WorkspaceGraphHealthViewState {\n12\t    inlineError?: string;\n13\t    health?: ReviewWorkspaceGraphHealth;\n14\t    nodePage: number;\n15\t    edgePage: number;\n16\t    brokenPage: number;\n17\t    stalePage: number;\n18\t    orphanPage: number;\n19\t    pageSize: number;\n20\t    nodeSortBy: FamilySortKey;\n21\t    edgeSortBy: FamilySortKey;\n22\t    diagnosticSortBy: DiagnosticSortKey;\n23\t    nodeSortDirection: SortDirection;\n24\t    edgeSortDirection: SortDirection;\n25\t    diagnosticSortDirection: SortDirection;\n26\t    refreshingPanel?: GraphPanel;\n27\t}\n28\t\n29\texport interface WorkspaceGraphHealthHost {\n30\t    readonly state: WorkspaceGraphHealthViewState;\n31\t    remember(health: ReviewWorkspaceGraphHealth): void;\n32\t    reportError?(message: string): void;\n33\t    setContent(markup: string): void;\n34\t}\n35\t\n36\texport async function mountWorkspaceGraphHealthView(\n37\t    host: WorkspaceGraphHealthHost,\n38\t    bridge: ReviewRpcBridgeContract,\n39\t    i18n: ReviewI18n\n40\t): Promise<void> {\n41\t    try {\n42\t        const result = await bridge.getWorkspaceGraphHealth();\n43\t        if (!result.ok) {\n44\t            host.reportError?.(result.error.message);\n45\t            host.setContent(renderError(i18n, result.error.message));\n46\t            return;\n47\t        }\n48\t        host.remember(result.value);\n49\t        host.setContent(renderView(result.value, host.state, i18n));\n50\t    } catch (error) {\n51\t        const message = error instanceof Error ? error.message : String(error);\n52\t        host.reportError?.(message);\n53\t        host.setContent(renderError(i18n, message));\n54\t    }\n55\t}\n56\t\n57\tfunction renderView(\n58\t    health: ReviewWorkspaceGraphHealth,\n59\t    state: WorkspaceGraphHealthViewState,\n60\t    i18n: ReviewI18n\n61\t): string {\n62\t    const nodeTable = renderFamilyTable(\n63\t        'nodes',\n64\t        health.nodeFamilies,\n65\t        state.nodeSortBy,\n66\t        state.nodeSortDirection,\n67\t        state.nodePage,\n68\t        state.pageSize,\n69\t        state,\n70\t        i18n\n71\t    );\n72\t    const edgeTable = renderFamilyTable(\n73\t        'edges',\n74\t        health.edgeFamilies,\n75\t        state.edgeSortBy,\n76\t        state.edgeSortDirection,\n77\t        state.edgePage,\n78\t        state.pageSize,\n79\t        state,\n80\t        i18n\n81\t    );\n82\t    return `<section class=\"route-stack\" data-testid=\"review-workspace-graph-health\">\n83\t  <div class=\"route-toolbar\">\n84\t    <div>\n85\t      <h3>${escapeHtml(i18n.t('workspaceGraphHealthView.title'))}</h3>\n86\t      <p>${escapeHtml(i18n.t('workspaceGraphHealthView.subtitle', { workspace: health.snapshot.workspace }))}</p>\n87\t    </div>\n88\t  </div>\n89\t  ${state.inlineError ? `<div class=\"banner error\" role=\"alert\">${escapeHtml(state.inlineError)}</div>` : ''}\n90\t  <div class=\"summary-grid\">\n91\t    ${summaryCard(i18n.t('workspaceGraphHealthView.summary.nodes'), health.snapshot.nodes.toLocaleString())}\n92\t    ${summaryCard(i18n.t('workspaceGraphHealthView.summary.edges'), health.snapshot.edges.toLocaleString())}\n93\t    ${summaryCard(i18n.t('workspaceGraphHealthView.summary.files'), health.snapshot.files.toLocaleString())}\n94\t    ${summaryCard(i18n.t('workspaceGraphHealthView.summary.languages'), Object.keys(health.snapshot.languages).length.toLocaleString())}\n95\t  </div>\n96\t  ${renderPanel('nodes', i18n.t('workspaceGraphHealthView.sections.nodeFamilies'), nodeTable, state, i18n)}\n97\t  ${renderPanel('edges', i18n.t('workspaceGraphHealthView.sections.edgeFamilies'), edgeTable, state, i18n)}\n98\t  ${renderPanel('brokenReferences', i18n.t('workspaceGraphHealthView.sections.brokenReferences'), renderDiagnosticTable('brokenReferences', health.brokenReferences, state, i18n), state, i18n)}\n99\t  ${renderPanel('staleEdges', i18n.t('workspaceGraphHealthView.sections.staleEdges'), renderDiagnosticTable('staleEdges', health.staleEdges, state, i18n), state, i18n)}\n100\t  ${renderPanel('orphanSymbols', i18n.t('workspaceGraphHealthView.sections.orphanSymbols'), renderDiagnosticTable('orphanSymbols', health.orphanSymbols, state, i18n), state, i18n)}\n101\t  ${health.notes.length ? `<div class=\"placeholder compact\"><h3>${escapeHtml(i18n.t('workspaceGraphHealthView.notesTitle'))}</h3><p>${escapeHtml(health.notes.join(' '))}</p></div>` : ''}\n102\t</section>`;\n103\t}\n104\t\n105\tfunction renderPanel(\n106\t    panel: GraphPanel,\n107\t    title: string,\n108\t    body: string,\n109\t    state: WorkspaceGraphHealthViewState,\n110\t    i18n: ReviewI18n\n111\t): string {\n112\t    const actionKey = panel === 'nodes' || panel === 'edges'\n113\t        ? 'workspaceGraphHealthView.actions.refresh'\n114\t        : 'workspaceGraphHealthView.actions.recompute';\n115\t    const active = state.refreshingPanel === panel;\n116\t    return `<section class=\"panel-block\">\n117\t  <div class=\"route-toolbar compact\">\n118\t    <h4>${escapeHtml(title)}</h4>\n119\t    <div class=\"toolbar-actions\">\n120\t      <button type=\"button\" data-command=\"refreshWorkspaceGraphPanel\" data-value=\"${escapeAttr(panel)}\" ${active ? 'disabled' : ''}>${escapeHtml(i18n.t(active ? 'workspaceGraphHealthView.actions.refreshing' : actionKey))}</button>\n121\t    </div>\n122\t  </div>\n123\t  ${body}\n124\t</section>`;\n125\t}\n126\t\n127\tfunction renderFamilyTable(\n128\t    panel: 'nodes' | 'edges',\n129\t    families: ReviewFamilyCount[],\n130\t    sortBy: FamilySortKey,\n131\t    sortDirection: SortDirection,\n132\t    page: number,\n133\t    pageSize: number,\n134\t    state: WorkspaceGraphHealthViewState,\n135\t    i18n: ReviewI18n\n136\t): string {\n137\t    const sorted = [...families].sort((left, right) => compareFamilies(left, right, sortBy));\n138\t    if (sortDirection === 'desc') {\n139\t        sorted.reverse();\n140\t    }\n141\t    const paged = paginate(sorted, page, pageSize);\n142\t    const rows = paged.items.map((family) => `<tr><td>${escapeHtml(family.family)}</td><td>${escapeHtml(family.count === undefined ? i18n.t('workspaceGraphHealthView.notReported') : family.count.toLocaleString())}</td><td>${escapeHtml(family.note ?? '')}</td></tr>`).join('');\n143\t    return `<div class=\"table-shell\"><table class=\"data-table\" aria-label=\"${escapeAttr(i18n.t(`workspaceGraphHealthView.${panel}.tableLabel`))}\">\n144\t  <thead><tr>\n145\t    <th><button type=\"button\" class=\"table-sort\" data-command=\"sortWorkspaceGraphFamilies\" data-value=\"${escapeAttr(panel)}:family\">${escapeHtml(i18n.t('workspaceGraphHealthView.columns.family'))} ${sortIndicator(sortBy === 'family', sortDirection)}</button></th>\n146\t    <th><button type=\"button\" class=\"table-sort\" data-command=\"sortWorkspaceGraphFamilies\" data-value=\"${escapeAttr(panel)}:count\">${escapeHtml(i18n.t('workspaceGraphHealthView.columns.count'))} ${sortIndicator(sortBy === 'count', sortDirection)}</button></th>\n147\t    <th>${escapeHtml(i18n.t('workspaceGraphHealthView.columns.notes'))}</th>\n148\t  </tr></thead>\n149\t  <tbody>${rows}</tbody>\n150\t</table></div>\n151\t${renderPagination(panel === 'nodes' ? 'pageWorkspaceGraphNodes' : 'pageWorkspaceGraphEdges', sorted.length, page, pageSize, state, i18n)}`;\n152\t}\n153\t\n154\tfunction renderDiagnosticTable(\n155\t    panel: 'brokenReferences' | 'staleEdges' | 'orphanSymbols',\n156\t    rows: ReviewGraphDiagnosticRow[],\n157\t    state: WorkspaceGraphHealthViewState,\n158\t    i18n: ReviewI18n\n159\t): string {\n160\t    const sorted = [...rows].sort((left, right) => compareDiagnostics(left, right, state.diagnosticSortBy));\n161\t    if (state.diagnosticSortDirection === 'desc') {\n162\t        sorted.reverse();\n163\t    }\n164\t    const page = panel === 'brokenReferences'\n165\t        ? state.brokenPage\n166\t        : panel === 'staleEdges'\n167\t            ? state.stalePage\n168\t            : state.orphanPage;\n169\t    const paged = paginate(sorted, page, state.pageSize);\n170\t    if (!rows.length) {\n171\t        return `<div class=\"placeholder compact\"><h3>${escapeHtml(i18n.t(`workspaceGraphHealthView.${panel}.empty`))}</h3></div>`;\n172\t    }\n173\t    const command = panel === 'brokenReferences'\n174\t        ? 'openWorkspaceGraphReference'\n175\t        : panel === 'staleEdges'\n176\t            ? 'openWorkspaceGraphEvidence'\n177\t            : 'openWorkspaceGraphReference';\n178\t    const tableRows = paged.items.map((row) => `<tr>\n179\t  <td>${escapeHtml(row.identity)}</td>\n180\t  <td>${escapeHtml(row.reason)}</td>\n181\t  <td>${escapeHtml(row.detail ?? '')}</td>\n182\t  <td><button type=\"button\" data-command=\"${escapeAttr(command)}\" data-value=\"${escapeAttr(row.reference ?? row.relatedMemoryId ?? row.identity)}\">${escapeHtml(i18n.t('workspaceGraphHealthView.actions.inspect'))}</button></td>\n183\t</tr>`).join('');\n184\t    const pageCommand = panel === 'brokenReferences'\n185\t        ? 'pageWorkspaceGraphBroken'\n186\t        : panel === 'staleEdges'\n187\t            ? 'pageWorkspaceGraphStale'\n188\t            : 'pageWorkspaceGraphOrphan';\n189\t    return `<div class=\"table-shell\"><table class=\"data-table\" aria-label=\"${escapeAttr(i18n.t(`workspaceGraphHealthView.${panel}.tableLabel`))}\">\n190\t  <thead><tr>\n191\t    <th><button type=\"button\" class=\"table-sort\" data-command=\"sortWorkspaceGraphDiagnostics\" data-value=\"identity\">${escapeHtml(i18n.t('workspaceGraphHealthView.columns.identity'))} ${sortIndicator(state.diagnosticSortBy === 'identity', state.diagnosticSortDirection)}</button></th>\n192\t    <th><button type=\"button\" class=\"table-sort\" data-command=\"sortWorkspaceGraphDiagnostics\" data-value=\"reason\">${escapeHtml(i18n.t('workspaceGraphHealthView.columns.reason'))} ${sortIndicator(state.diagnosticSortBy === 'reason', state.diagnosticSortDirection)}</button></th>\n193\t    <th>${escapeHtml(i18n.t('workspaceGraphHealthView.columns.detail'))}</th>\n194\t    <th>${escapeHtml(i18n.t('workspaceGraphHealthView.columns.actions'))}</th>\n195\t  </tr></thead>\n196\t  <tbody>${tableRows}</tbody>\n197\t</table></div>\n198\t${renderPagination(pageCommand, sorted.length, page, state.pageSize, state, i18n)}`;\n199\t}\n200\t\n201\tfunction renderPagination(\n202\t    command: string,\n203\t    total: number,\n204\t    page: number,\n205\t    pageSize: number,\n206\t    state: WorkspaceGraphHealthViewState,\n207\t    i18n: ReviewI18n\n208\t): string {\n209\t    if (total === 0) {\n210\t        return '';\n211\t    }\n212\t    const totalPages = Math.max(1, Math.ceil(total / pageSize));\n213\t    const safePage = Math.min(Math.max(page, 1), totalPages);\n214\t    const start = (safePage - 1) * pageSize + 1;\n215\t    const end = Math.min(total, safePage * pageSize);\n216\t    return `<div class=\"pagination-bar\">\n217\t  <span>${escapeHtml(i18n.t('workspaceGraphHealthView.pagination.showing', { start, end, total }))}</span>\n218\t  <div class=\"row-actions\">\n219\t    <button type=\"button\" data-command=\"${escapeAttr(command)}\" data-page=\"${safePage - 1}\" ${safePage <= 1 ? 'disabled' : ''}>${escapeHtml(i18n.t('workspaceGraphHealthView.pagination.previous'))}</button>\n220\t    <span>${escapeHtml(i18n.t('workspaceGraphHealthView.pagination.page', { page: safePage, totalPages }))}</span>\n221\t    <button type=\"button\" data-command=\"${escapeAttr(command)}\" data-page=\"${safePage + 1}\" ${safePage >= totalPages ? 'disabled' : ''}>${escapeHtml(i18n.t('workspaceGraphHealthView.pagination.next'))}</button>\n222\t    <button type=\"button\" data-command=\"setWorkspaceGraphPageSize\" data-page-size=\"10\" ${state.pageSize === 10 ? 'disabled' : ''}>10/page</button>\n223\t    <button type=\"button\" data-command=\"setWorkspaceGraphPageSize\" data-page-size=\"25\" ${state.pageSize === 25 ? 'disabled' : ''}>25/page</button>\n224\t  </div>\n225\t</div>`;\n226\t}\n227\t\n228\tfunction compareFamilies(left: ReviewFamilyCount, right: ReviewFamilyCount, sortBy: FamilySortKey): number {\n229\t    if (sortBy === 'family') {\n230\t        return left.family.localeCompare(right.family);\n231\t    }\n232\t    return (left.count ?? -1) - (right.count ?? -1);\n233\t}\n234\t\n235\tfunction compareDiagnostics(left: ReviewGraphDiagnosticRow, right: ReviewGraphDiagnosticRow, sortBy: DiagnosticSortKey): number {\n236\t    return sortBy === 'identity'\n237\t        ? left.identity.localeCompare(right.identity)\n238\t        : left.reason.localeCompare(right.reason);\n239\t}\n240\t\n241\tfunction paginate<T>(items: T[], page: number, pageSize: number): { items: T[] } {\n242\t    const totalPages = Math.max(1, Math.ceil(items.length / pageSize));\n243\t    const safePage = Math.min(Math.max(page, 1), totalPages);\n244\t    const start = (safePage - 1) * pageSize;\n245\t    return { items: items.slice(start, start + pageSize) };\n246\t}\n247\t\n248\tfunction sortIndicator(active: boolean, direction: SortDirection): string {\n249\t    if (!active) {\n250\t        return '↕';\n251\t    }\n252\t    return direction === 'asc' ? '↑' : '↓';\n253\t}\n254\t\n255\tfunction summaryCard(label: string, value: string): string {\n256\t    return `<div class=\"card\"><small>${escapeHtml(label)}</small><strong>${escapeHtml(value)}</strong></div>`;\n257\t}\n258\t\n259\tfunction renderError(i18n: ReviewI18n, message: string): string {\n260\t    return `<section class=\"route-stack\" data-testid=\"review-workspace-graph-health\"><div class=\"banner error\" role=\"alert\"><strong>${escapeHtml(i18n.t('workspaceGraphHealthView.errorTitle'))}</strong><p>${escapeHtml(message)}</p></div></section>`;\n261\t}\n262\t"}]},"parent_tool_use_id":"toolu_01YL1bW3bEAsvfd93Vq2Fj4H","session_id":"3f5c8929-5870-493f-9d77-6b17226dfdaa","uuid":"49e700e9-f2e4-44ec-ad95-52df2431b0a7","timestamp":"2026-05-17T18:17:54.966Z","subagent_type":"Explore","task_description":"Audit mutation error handling"}
