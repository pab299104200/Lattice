{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013YfhxnXtPzUvZy2qtr8W4K","type":"tool_result","content":"1\t/// <reference lib=\"dom\" />\n2\t\n3\tdeclare function renderStatusBadge(status: string, i18n: { t: (key: string, params?: Record<string, string | number>) => string }): string;\n4\tdeclare function openProposalDialog(\n5\t    options: {\n6\t        proposal: Record<string, unknown>;\n7\t        onApply: (reason?: string) => Promise<unknown>;\n8\t        onReject: (reason: string) => Promise<unknown>;\n9\t    },\n10\t    i18n: { t: (key: string, params?: Record<string, string | number>) => string }\n11\t): HTMLDialogElement;\n12\tdeclare function reportReviewViewError(route: string, message: string): void;\n13\t\n14\texport function mountPromotionQueue(\n15\t    host: HTMLElement,\n16\t    bridge: {\n17\t        listPromotionProposals: () => Promise<Record<string, unknown>>;\n18\t        applyPromotion: (proposalId: string, reason?: string) => Promise<unknown>;\n19\t        rejectPromotion: (proposalId: string, reason: string) => Promise<unknown>;\n20\t    },\n21\t    i18n: { t: (key: string, params?: Record<string, string | number>) => string }\n22\t): void {\n23\t    let rows: PromotionRow[] = [];\n24\t    let sortKey: PromotionSortKey = 'createdAt';\n25\t    let sortDirection: 'asc' | 'desc' = 'desc';\n26\t\n27\t    void load();\n28\t\n29\t    async function load(): Promise<void> {\n30\t        renderLoading(host);\n31\t        try {\n32\t            const report = await bridge.listPromotionProposals();\n33\t            rows = readProposalRows(report);\n34\t            renderTable();\n35\t        } catch (error) {\n36\t            const message = errorMessage(error);\n37\t            renderError(host, message);\n38\t            reportReviewViewError('promotionQueue', message);\n39\t        }\n40\t    }\n41\t\n42\t    function renderTable(): void {\n43\t        host.innerHTML = '';\n44\t        const container = document.createElement('section');\n45\t        container.className = 'queue-surface';\n46\t        container.setAttribute('data-testid', 'review-promotion-queue');\n47\t        container.appendChild(renderNotes());\n48\t        if (rows.length === 0) {\n49\t            container.appendChild(renderEmptyState(i18n.t('promotionQueue.empty')));\n50\t            host.appendChild(container);\n51\t            return;\n52\t        }\n53\t        const table = document.createElement('table');\n54\t        table.className = 'review-table';\n55\t        table.append(createHead(), createBody());\n56\t        container.appendChild(table);\n57\t        host.appendChild(container);\n58\t    }\n59\t\n60\t    function renderNotes(): HTMLElement {\n61\t        const note = document.createElement('div');\n62\t        note.className = 'banner info';\n63\t        note.textContent = i18n.t('promotionQueue.description');\n64\t        return note;\n65\t    }\n66\t\n67\t    function createHead(): HTMLElement {\n68\t        const thead = document.createElement('thead');\n69\t        const row = document.createElement('tr');\n70\t        row.append(\n71\t            sortableHeader('proposedClass', i18n.t('promotionQueue.columns.proposedClass')),\n72\t            plainHeader(i18n.t('promotionQueue.columns.currentScope')),\n73\t            plainHeader(i18n.t('promotionQueue.columns.targetScope')),\n74\t            sortableHeader('confidence', i18n.t('promotionQueue.columns.confidence')),\n75\t            sortableHeader('evidenceCount', i18n.t('promotionQueue.columns.evidenceCount')),\n76\t            sortableHeader('createdAt', i18n.t('promotionQueue.columns.createdAt')),\n77\t            sortableHeader('status', i18n.t('promotionQueue.columns.status')),\n78\t            plainHeader(i18n.t('promotionQueue.columns.actions')),\n79\t        );\n80\t        thead.appendChild(row);\n81\t        return thead;\n82\t    }\n83\t\n84\t    function createBody(): HTMLElement {\n85\t        const tbody = document.createElement('tbody');\n86\t        for (const entry of sortedRows()) {\n87\t            const row = document.createElement('tr');\n88\t            row.append(\n89\t                textCell(entry.proposedClass),\n90\t                textCell(entry.currentScope),\n91\t                textCell(entry.targetScope),\n92\t                textCell(formatPercent(entry.confidence)),\n93\t                textCell(String(entry.evidenceCount)),\n94\t                textCell(formatTimestamp(entry.createdAt)),\n95\t                badgeCell(entry.status),\n96\t                actionCell(entry),\n97\t            );\n98\t            tbody.appendChild(row);\n99\t        }\n100\t        return tbody;\n101\t    }\n102\t\n103\t    function sortedRows(): PromotionRow[] {\n104\t        const factor = sortDirection === 'asc' ? 1 : -1;\n105\t        return [...rows].sort((left, right) => {\n106\t            const leftValue = sortableValue(left, sortKey);\n107\t            const rightValue = sortableValue(right, sortKey);\n108\t            if (leftValue < rightValue) {\n109\t                return -1 * factor;\n110\t            }\n111\t            if (leftValue > rightValue) {\n112\t                return 1 * factor;\n113\t            }\n114\t            return 0;\n115\t        });\n116\t    }\n117\t\n118\t    function sortableHeader(key: PromotionSortKey, label: string): HTMLElement {\n119\t        const cell = document.createElement('th');\n120\t        const button = document.createElement('button');\n121\t        button.type = 'button';\n122\t        button.className = 'table-sort';\n123\t        button.textContent = sortLabel(key, label);\n124\t        button.addEventListener('click', () => {\n125\t            if (sortKey === key) {\n126\t                sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';\n127\t            } else {\n128\t                sortKey = key;\n129\t                sortDirection = key === 'proposedClass' || key === 'status' ? 'asc' : 'desc';\n130\t            }\n131\t            renderTable();\n132\t        });\n133\t        cell.appendChild(button);\n134\t        return cell;\n135\t    }\n136\t\n137\t    function sortLabel(key: PromotionSortKey, label: string): string {\n138\t        if (sortKey !== key) {\n139\t            return label;\n140\t        }\n141\t        return `${label} ${sortDirection === 'asc' ? '↑' : '↓'}`;\n142\t    }\n143\t\n144\t    function badgeCell(status: string): HTMLElement {\n145\t        const cell = document.createElement('td');\n146\t        cell.innerHTML = renderStatusBadge(status, i18n);\n147\t        return cell;\n148\t    }\n149\t\n150\t    function actionCell(entry: PromotionRow): HTMLElement {\n151\t        const cell = document.createElement('td');\n152\t        const actions = document.createElement('div');\n153\t        actions.className = 'table-actions';\n154\t        actions.append(\n155\t            queueAction(i18n.t('promotionQueue.actions.review'), () => openDialog(entry, 'review')),\n156\t            queueAction(i18n.t('promotionQueue.actions.accept'), () => openDialog(entry, 'accept')),\n157\t            queueAction(i18n.t('promotionQueue.actions.reject'), () => openDialog(entry, 'reject')),\n158\t        );\n159\t        cell.appendChild(actions);\n160\t        return cell;\n161\t    }\n162\t\n163\t    function openDialog(entry: PromotionRow, mode: 'review' | 'accept' | 'reject'): void {\n164\t        openProposalDialog(\n165\t            {\n166\t                proposal: {\n167\t                    title: i18n.t('proposalDialog.promotionTitle', { value: entry.proposedClass }),\n168\t                    summary: entry.summary,\n169\t                    proposalKind: entry.proposalKind,\n170\t                    status: i18n.t(`reviewStatus.${entry.status}`),\n171\t                    proposedClass: entry.proposedClass,\n172\t                    currentScope: entry.currentScope,\n173\t                    targetScope: entry.targetScope,\n174\t                    confidence: entry.confidence,\n175\t                    evidenceCount: entry.evidenceCount,\n176\t                    createdAt: entry.createdAt,\n177\t                    expectedEffect: i18n.t('proposalDialog.promotionEffect', {\n178\t                        value: `${entry.proposedClass} ${entry.targetScope}`,\n179\t                    }),\n180\t                    priorState: entry.priorState,\n181\t                    proposedState: entry.proposedState,\n182\t                    evidence: entry.evidence,\n183\t                    provenance: entry.provenance,\n184\t                    initialMode: mode,\n185\t                },\n186\t                onApply: async (reason?: string) => {\n187\t                    await bridge.applyPromotion(entry.proposalId, reason);\n188\t                    await load();\n189\t                },\n190\t                onReject: async (reason: string) => {\n191\t                    await bridge.rejectPromotion(entry.proposalId, reason);\n192\t                    await load();\n193\t                },\n194\t            },\n195\t            i18n,\n196\t        );\n197\t    }\n198\t}\n199\t\n200\texport function serializePromotionQueue(): string {\n201\t    return [\n202\t        mountPromotionQueue,\n203\t        readProposalRows,\n204\t        extractState,\n205\t        sortableValue,\n206\t        plainHeader,\n207\t        textCell,\n208\t        queueAction,\n209\t        renderLoading,\n210\t        renderError,\n211\t        renderEmptyState,\n212\t        asRecord,\n213\t        stringValue,\n214\t        numberValue,\n215\t        formatPercent,\n216\t        formatTimestamp,\n217\t        errorMessage,\n218\t        escapeHtml,\n219\t    ].map((entry) => entry.toString()).join('\\n');\n220\t}\n221\t\n222\ttype PromotionSortKey = 'proposedClass' | 'confidence' | 'evidenceCount' | 'createdAt' | 'status';\n223\t\n224\tinterface PromotionRow {\n225\t    proposalId: string;\n226\t    proposalKind: string;\n227\t    summary: string;\n228\t    proposedClass: string;\n229\t    currentScope: string;\n230\t    targetScope: string;\n231\t    confidence: number;\n232\t    evidenceCount: number;\n233\t    createdAt: number;\n234\t    status: string;\n235\t    priorState?: unknown;\n236\t    proposedState?: unknown;\n237\t    evidence?: unknown;\n238\t    provenance?: unknown;\n239\t}\n240\t\n241\tfunction readProposalRows(report: Record<string, unknown>): PromotionRow[] {\n242\t    const proposals = Array.isArray(report.proposals) ? report.proposals : [];\n243\t    return proposals\n244\t        .map((entry) => asRecord(entry))\n245\t        .filter((entry): entry is Record<string, unknown> => entry !== undefined)\n246\t        .map((entry) => {\n247\t            const proposed = extractState(entry.proposedState);\n248\t            const prior = extractState(entry.priorState);\n249\t            return {\n250\t                proposalId: stringValue(entry.proposalId),\n251\t                proposalKind: stringValue(entry.proposalKind),\n252\t                summary: stringValue(entry.summary),\n253\t                proposedClass: stringValue(proposed.memory_class ?? proposed.memoryClass ?? entry.proposedClass) || '—',\n254\t                currentScope: stringValue(prior.scope ?? entry.currentScope) || '—',\n255\t                targetScope: stringValue(proposed.scope ?? entry.targetScope) || '—',\n256\t                confidence: numberValue(proposed.confidence ?? entry.confidence),\n257\t                evidenceCount: numberValue(entry.evidenceCount),\n258\t                createdAt: numberValue(entry.createdAt),\n259\t                status: stringValue(entry.decision || entry.status || 'pending'),\n260\t                priorState: entry.priorState,\n261\t                proposedState: entry.proposedState,\n262\t                evidence: entry.evidence,\n263\t                provenance: entry.provenance,\n264\t            };\n265\t        });\n266\t}\n267\t\n268\tfunction extractState(value: unknown): Record<string, unknown> {\n269\t    const record = asRecord(value);\n270\t    if (!record) {\n271\t        return {};\n272\t    }\n273\t    const nested = asRecord(record.memory);\n274\t    return nested ?? record;\n275\t}\n276\t\n277\tfunction sortableValue(row: PromotionRow, key: PromotionSortKey): number | string {\n278\t    switch (key) {\n279\t        case 'proposedClass':\n280\t            return row.proposedClass.toLowerCase();\n281\t        case 'confidence':\n282\t            return row.confidence;\n283\t        case 'evidenceCount':\n284\t            return row.evidenceCount;\n285\t        case 'createdAt':\n286\t            return row.createdAt;\n287\t        case 'status':\n288\t            return row.status.toLowerCase();\n289\t    }\n290\t}\n291\t\n292\tfunction plainHeader(label: string): HTMLElement {\n293\t    const cell = document.createElement('th');\n294\t    cell.textContent = label;\n295\t    return cell;\n296\t}\n297\t\n298\tfunction textCell(value: string): HTMLElement {\n299\t    const cell = document.createElement('td');\n300\t    cell.textContent = value;\n301\t    return cell;\n302\t}\n303\t\n304\tfunction queueAction(label: string, onClick: () => void): HTMLElement {\n305\t    const button = document.createElement('button');\n306\t    button.type = 'button';\n307\t    button.className = 'table-action';\n308\t    button.textContent = label;\n309\t    button.addEventListener('click', onClick);\n310\t    return button;\n311\t}\n312\t\n313\tfunction renderLoading(host: HTMLElement): void {\n314\t    host.innerHTML = '<div class=\"queue-surface\"><div class=\"skeleton\"></div><div class=\"skeleton\"></div><div class=\"skeleton\"></div></div>';\n315\t}\n316\t\n317\tfunction renderError(host: HTMLElement, message: string): void {\n318\t    host.innerHTML = `<div class=\"queue-surface\"><div class=\"banner error\" role=\"alert\">${escapeHtml(message)}</div></div>`;\n319\t}\n320\t\n321\tfunction renderEmptyState(message: string): HTMLElement {\n322\t    const box = document.createElement('div');\n323\t    box.className = 'placeholder';\n324\t    const title = document.createElement('h3');\n325\t    title.textContent = message;\n326\t    box.appendChild(title);\n327\t    return box;\n328\t}\n329\t\n330\tfunction asRecord(value: unknown): Record<string, unknown> | undefined {\n331\t    return typeof value === 'object' && value !== null && !Array.isArray(value)\n332\t        ? value as Record<string, unknown>\n333\t        : undefined;\n334\t}\n335\t\n336\tfunction stringValue(value: unknown): string {\n337\t    return typeof value === 'string' ? value : '';\n338\t}\n339\t\n340\tfunction numberValue(value: unknown): number {\n341\t    return typeof value === 'number' ? value : 0;\n342\t}\n343\t\n344\tfunction formatPercent(value: number): string {\n345\t    return value ? `${(value * 100).toFixed(1)}%` : '—';\n346\t}\n347\t\n348\tfunction formatTimestamp(value: number): string {\n349\t    if (!value) {\n350\t        return '—';\n351\t    }\n352\t    const millis = value > 1_000_000_000_000 ? Math.floor(value / 1000) : value * 1000;\n353\t    return new Date(millis).toLocaleString();\n354\t}\n355\t\n356\tfunction errorMessage(error: unknown): string {\n357\t    return error instanceof Error && error.message ? error.message : 'Request failed.';\n358\t}\n359\t\n360\tfunction escapeHtml(value: string): string {\n361\t    return value\n362\t        .replaceAll('&', '&amp;')\n363\t        .replaceAll('<', '&lt;')\n364\t        .replaceAll('>', '&gt;')\n365\t        .replaceAll('\"', '&quot;')\n366\t        .replaceAll(\"'\", '&#39;');\n367\t}\n368\t"}]},"parent_tool_use_id":"toolu_01YL1bW3bEAsvfd93Vq2Fj4H","session_id":"3f5c8929-5870-493f-9d77-6b17226dfdaa","uuid":"fdcbc0d1-b634-49b3-b19e-deeba6c25054","timestamp":"2026-05-17T18:17:51.887Z","subagent_type":"Explore","task_description":"Audit mutation error handling"}
