{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AJ8Um4bSfgbxarEFeEEicj","type":"tool_result","content":"1\t/// <reference lib=\"dom\" />\n2\t\n3\texport type VerificationStatus =\n4\t    | 'verified'\n5\t    | 'unverified'\n6\t    | 'in_review'\n7\t    | 'stale'\n8\t    | 'contradicted'\n9\t    | 'superseded'\n10\t    | 'expired'\n11\t    | 'invalidated'\n12\t    | 'pending'\n13\t    | 'applied'\n14\t    | 'rejected'\n15\t    | 'reverted'\n16\t    | 'queued'\n17\t    | 'running'\n18\t    | 'proposed'\n19\t    | 'failed'\n20\t    | 'dropped';\n21\t\n22\tinterface ReviewI18nLike {\n23\t    t: (key: string, params?: Record<string, string | number>) => string;\n24\t}\n25\t\n26\tinterface StatusPresentation {\n27\t    className: string;\n28\t    labelKey: string;\n29\t}\n30\t\n31\tconst STATUS_PRESENTATION: Record<string, StatusPresentation> = {\n32\t    verified: { className: 'status-badge--success', labelKey: 'reviewStatus.verified' },\n33\t    unverified: { className: 'status-badge--muted', labelKey: 'reviewStatus.unverified' },\n34\t    in_review: { className: 'status-badge--warning', labelKey: 'reviewStatus.in_review' },\n35\t    stale: { className: 'status-badge--warning', labelKey: 'reviewStatus.stale' },\n36\t    contradicted: { className: 'status-badge--danger', labelKey: 'reviewStatus.contradicted' },\n37\t    superseded: { className: 'status-badge--info', labelKey: 'reviewStatus.superseded' },\n38\t    expired: { className: 'status-badge--danger', labelKey: 'reviewStatus.expired' },\n39\t    invalidated: { className: 'status-badge--danger', labelKey: 'reviewStatus.invalidated' },\n40\t    pending: { className: 'status-badge--warning', labelKey: 'reviewStatus.pending' },\n41\t    applied: { className: 'status-badge--success', labelKey: 'reviewStatus.applied' },\n42\t    rejected: { className: 'status-badge--danger', labelKey: 'reviewStatus.rejected' },\n43\t    reverted: { className: 'status-badge--muted', labelKey: 'reviewStatus.reverted' },\n44\t    queued: { className: 'status-badge--muted', labelKey: 'reviewStatus.queued' },\n45\t    running: { className: 'status-badge--info', labelKey: 'reviewStatus.running' },\n46\t    proposed: { className: 'status-badge--warning', labelKey: 'reviewStatus.proposed' },\n47\t    failed: { className: 'status-badge--danger', labelKey: 'reviewStatus.failed' },\n48\t    dropped: { className: 'status-badge--danger', labelKey: 'reviewStatus.dropped' },\n49\t};\n50\t\n51\t// Single source of truth for proposal + verification status styling across the review surface.\n52\texport function renderStatusBadge(status: VerificationStatus | string, i18n: ReviewI18nLike): string {\n53\t    const normalized = typeof status === 'string' ? status.trim().toLowerCase() : '';\n54\t    const presentation = STATUS_PRESENTATION[normalized] ?? {\n55\t        className: 'status-badge--muted',\n56\t        labelKey: 'reviewPanel.statusUnknown',\n57\t    };\n58\t    const label = i18n.t(presentation.labelKey)\n59\t        .replaceAll('&', '&amp;')\n60\t        .replaceAll('<', '&lt;')\n61\t        .replaceAll('>', '&gt;')\n62\t        .replaceAll('\"', '&quot;')\n63\t        .replaceAll(\"'\", '&#39;');\n64\t    return `<span class=\"status-badge ${presentation.className}\">${label}</span>`;\n65\t}\n66\t"}]},"parent_tool_use_id":"toolu_01NtDyqaaGS9LUZAbVA9SvGe","session_id":"3f5c8929-5870-493f-9d77-6b17226dfdaa","uuid":"8938753f-ba01-425b-a9e6-12c004e045b7","timestamp":"2026-05-17T18:18:05.871Z","subagent_type":"Explore","task_description":"Audit StatusBadge and modal patterns"}
