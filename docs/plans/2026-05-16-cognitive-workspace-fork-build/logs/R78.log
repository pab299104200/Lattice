{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DxHZ17c8xATs1nUMntQwgL","type":"tool_result","content":"1\timport { escapeAttr, escapeHtml } from './components/html';\n2\timport { renderStatusBadge } from './components/StatusBadge';\n3\timport { ReviewI18n } from './i18n';\n4\timport { ReviewRpcBridgeContract } from './rpcBridge';\n5\timport { ReviewConsolidationJob, ReviewConsolidationQueueData } from './rpcPayloads';\n6\t\n7\ttype ConsolidationQueueSortKey = 'status' | 'kind' | 'mode' | 'createdAt' | 'duration';\n8\ttype SortDirection = 'asc' | 'desc';\n9\t\n10\texport interface ConsolidationQueueViewState {\n11\t    inlineError?: string;\n12\t    jobs?: ReviewConsolidationQueueData;\n13\t    page: number;\n14\t    pageSize: number;\n15\t    selectedKinds: string[];\n16\t    selectedModes: string[];\n17\t    selectedStatuses: string[];\n18\t    sortBy: ConsolidationQueueSortKey;\n19\t    sortDirection: SortDirection;\n20\t    retryingJobId?: string;\n21\t}\n22\t\n23\texport interface ConsolidationQueueHost {\n24\t    readonly state: ConsolidationQueueViewState;\n25\t    remember(data: ReviewConsolidationQueueData): void;\n26\t    reportError?(message: string): void;\n27\t    setContent(markup: string): void;\n28\t}\n29\t\n30\texport async function mountConsolidationQueueView(\n31\t    host: ConsolidationQueueHost,\n32\t    bridge: ReviewRpcBridgeContract,\n33\t    i18n: ReviewI18n\n34\t): Promise<void> {\n35\t    try {\n36\t        const [jobsResult, depthResult] = await Promise.all([\n37\t            bridge.listConsolidationJobs(),\n38\t            bridge.getConsolidationQueueDepth(),\n39\t        ]);\n40\t        if (!jobsResult.ok) {\n41\t            host.reportError?.(jobsResult.error.message);\n42\t            host.setContent(renderError(i18n, jobsResult.error.message));\n43\t            return;\n44\t        }\n45\t        if (!depthResult.ok) {\n46\t            host.reportError?.(depthResult.error.message);\n47\t            host.setContent(renderError(i18n, depthResult.error.message));\n48\t            return;\n49\t        }\n50\t        const data = {\n51\t            ...jobsResult.value,\n52\t            queueDepth: depthResult.value,\n53\t        };\n54\t        host.remember(data);\n55\t        host.setContent(renderView(data, host.state, i18n));\n56\t    } catch (error) {\n57\t        const message = error instanceof Error ? error.message : String(error);\n58\t        host.reportError?.(message);\n59\t        host.setContent(renderError(i18n, message));\n60\t    }\n61\t}\n62\t\n63\tfunction renderView(\n64\t    data: ReviewConsolidationQueueData,\n65\t    state: ConsolidationQueueViewState,\n66\t    i18n: ReviewI18n\n67\t): string {\n68\t    const filtered = filterJobs(data.jobs, state);\n69\t    const sorted = sortJobs(filtered, state);\n70\t    const page = paginate(sorted, state.page, state.pageSize);\n71\t    const rows = page.items.map((job) => renderRow(job, state, i18n)).join('');\n72\t    const droppedBanner = data.queueDepth.droppedCount > 0\n73\t        ? `<div class=\"banner warning\" role=\"status\">\n74\t  <strong>${escapeHtml(i18n.t('consolidationQueueView.queue.droppedTitle', { count: data.queueDepth.droppedCount }))}</strong>\n75\t  <p>${escapeHtml(i18n.t('consolidationQueueView.queue.droppedMessage'))}</p>\n76\t  <div class=\"row-actions\">\n77\t    <button type=\"button\" data-command=\"openConsolidationFailures\">${escapeHtml(i18n.t('consolidationQueueView.actions.openFailures'))}</button>\n78\t  </div>\n79\t</div>`\n80\t        : '';\n81\t    return `<section class=\"route-stack\" data-testid=\"review-consolidation-queue\">\n82\t  <div class=\"route-toolbar\">\n83\t    <div>\n84\t      <h3>${escapeHtml(i18n.t('consolidationQueueView.title'))}</h3>\n85\t      <p>${escapeHtml(i18n.t('consolidationQueueView.subtitle'))}</p>\n86\t    </div>\n87\t    <div class=\"toolbar-actions\">\n88\t      ${filterButton('pickConsolidationStatuses', i18n.t('consolidationQueueView.filters.statusButton', { count: countLabel(state.selectedStatuses, data.jobs, 'status') }))}\n89\t      ${filterButton('pickConsolidationKinds', i18n.t('consolidationQueueView.filters.kindButton', { count: countLabel(state.selectedKinds, data.jobs, 'kind') }))}\n90\t      ${filterButton('pickConsolidationModes', i18n.t('consolidationQueueView.filters.modeButton', { count: countLabel(state.selectedModes, data.jobs, 'mode') }))}\n91\t      <button type=\"button\" data-command=\"clearConsolidationFilters\">${escapeHtml(i18n.t('consolidationQueueView.actions.clearFilters'))}</button>\n92\t    </div>\n93\t  </div>\n94\t  ${state.inlineError ? `<div class=\"banner error\" role=\"alert\">${escapeHtml(state.inlineError)}</div>` : ''}\n95\t  ${renderQueueSummary(data, i18n)}\n96\t  ${droppedBanner}\n97\t  <div class=\"filter-summary\">\n98\t    <span class=\"filter-pill\">${escapeHtml(i18n.t('consolidationQueueView.filters.activeStatus', { value: summarize(state.selectedStatuses, 'consolidationQueueView.status', i18n) }))}</span>\n99\t    <span class=\"filter-pill\">${escapeHtml(i18n.t('consolidationQueueView.filters.activeKind', { value: summarize(state.selectedKinds, 'consolidationQueueView.kind', i18n) }))}</span>\n100\t    <span class=\"filter-pill\">${escapeHtml(i18n.t('consolidationQueueView.filters.activeMode', { value: summarize(state.selectedModes, 'consolidationQueueView.mode', i18n) }))}</span>\n101\t  </div>\n102\t  ${rows ? renderTable(rows, state, i18n) : renderEmpty(filtered.length === 0 && data.jobs.length > 0, i18n)}\n103\t  ${renderPagination(sorted.length, state, i18n)}\n104\t</section>`;\n105\t}\n106\t\n107\tfunction renderQueueSummary(data: ReviewConsolidationQueueData, i18n: ReviewI18n): string {\n108\t    return `<div class=\"summary-grid\">\n109\t  ${summaryCard(i18n.t('consolidationQueueView.queue.currentDepth'), `${data.queueDepth.currentDepth}`)}\n110\t  ${summaryCard(i18n.t('consolidationQueueView.queue.maxDepth'), `${data.queueDepth.maxDepth}`)}\n111\t  ${summaryCard(i18n.t('consolidationQueueView.queue.droppedCount'), `${data.queueDepth.droppedCount}`)}\n112\t  ${summaryCard(i18n.t('consolidationQueueView.queue.visibleJobs'), `${data.jobs.length}`)}\n113\t</div>`;\n114\t}\n115\t\n116\tfunction renderTable(rows: string, state: ConsolidationQueueViewState, i18n: ReviewI18n): string {\n117\t    return `<div class=\"table-shell\"><table class=\"data-table\" aria-label=\"${escapeAttr(i18n.t('consolidationQueueView.tableLabel'))}\">\n118\t  <thead><tr>\n119\t    ${sortableHeader('status', state, i18n, 'consolidationQueueView.columns.status')}\n120\t    ${sortableHeader('kind', state, i18n, 'consolidationQueueView.columns.kind')}\n121\t    ${sortableHeader('mode', state, i18n, 'consolidationQueueView.columns.mode')}\n122\t    ${sortableHeader('createdAt', state, i18n, 'consolidationQueueView.columns.createdAt')}\n123\t    <th>${escapeHtml(i18n.t('consolidationQueueView.columns.startedAt'))}</th>\n124\t    <th>${escapeHtml(i18n.t('consolidationQueueView.columns.completedAt'))}</th>\n125\t    ${sortableHeader('duration', state, i18n, 'consolidationQueueView.columns.duration')}\n126\t    <th>${escapeHtml(i18n.t('consolidationQueueView.columns.llmModel'))}</th>\n127\t    <th>${escapeHtml(i18n.t('consolidationQueueView.columns.resultSummary'))}</th>\n128\t    <th>${escapeHtml(i18n.t('consolidationQueueView.columns.actions'))}</th>\n129\t  </tr></thead>\n130\t  <tbody>${rows}</tbody>\n131\t</table></div>`;\n132\t}\n133\t\n134\tfunction renderRow(job: ReviewConsolidationJob, state: ConsolidationQueueViewState, i18n: ReviewI18n): string {\n135\t    const retryDisabled = !job.sessionId || state.retryingJobId === job.jobId;\n136\t    return `<tr>\n137\t  <td>${renderStatusBadge(job.status, i18n)}</td>\n138\t  <td>${escapeHtml(labelFor(job.kind, 'consolidationQueueView.kind', i18n))}</td>\n139\t  <td>${escapeHtml(labelFor(job.mode, 'consolidationQueueView.mode', i18n))}</td>\n140\t  <td>${escapeHtml(formatTimestamp(job.createdAt, i18n))}</td>\n141\t  <td>${escapeHtml(formatTimestamp(job.startedAt, i18n))}</td>\n142\t  <td>${escapeHtml(formatTimestamp(job.completedAt, i18n))}</td>\n143\t  <td>${escapeHtml(formatDuration(job.durationMs, i18n))}</td>\n144\t  <td>${escapeHtml(job.llmModel ?? i18n.t('consolidationQueueView.notAvailable'))}</td>\n145\t  <td><div class=\"cell-stack\"><span>${escapeHtml(job.resultSummary)}</span><small>${escapeHtml(job.jobId)}</small></div></td>\n146\t  <td>\n147\t    <div class=\"row-actions\">\n148\t      <button type=\"button\" data-command=\"openConsolidationEventTrace\" data-value=\"${escapeAttr(job.jobId)}\">${escapeHtml(i18n.t('consolidationQueueView.actions.inspect'))}</button>\n149\t      <button type=\"button\" data-command=\"retryConsolidationJob\" data-value=\"${escapeAttr(job.jobId)}\" ${retryDisabled ? 'disabled' : ''}>${escapeHtml(state.retryingJobId === job.jobId ? i18n.t('consolidationQueueView.actions.retrying') : i18n.t('consolidationQueueView.actions.retry'))}</button>\n150\t    </div>\n151\t  </td>\n152\t</tr>`;\n153\t}\n154\t\n155\tfunction renderPagination(total: number, state: ConsolidationQueueViewState, i18n: ReviewI18n): string {\n156\t    if (total === 0) {\n157\t        return '';\n158\t    }\n159\t    const totalPages = Math.max(1, Math.ceil(total / state.pageSize));\n160\t    const safePage = clampPage(state.page, totalPages);\n161\t    const start = (safePage - 1) * state.pageSize + 1;\n162\t    const end = Math.min(total, safePage * state.pageSize);\n163\t    return `<div class=\"pagination-bar\">\n164\t  <span>${escapeHtml(i18n.t('consolidationQueueView.pagination.showing', { start, end, total }))}</span>\n165\t  <div class=\"row-actions\">\n166\t    <button type=\"button\" data-command=\"pageConsolidationQueue\" data-page=\"${safePage - 1}\" ${safePage <= 1 ? 'disabled' : ''}>${escapeHtml(i18n.t('consolidationQueueView.pagination.previous'))}</button>\n167\t    <span>${escapeHtml(i18n.t('consolidationQueueView.pagination.page', { page: safePage, totalPages }))}</span>\n168\t    <button type=\"button\" data-command=\"pageConsolidationQueue\" data-page=\"${safePage + 1}\" ${safePage >= totalPages ? 'disabled' : ''}>${escapeHtml(i18n.t('consolidationQueueView.pagination.next'))}</button>\n169\t    ${pageSizeButton(25, state.pageSize)}\n170\t    ${pageSizeButton(50, state.pageSize)}\n171\t    ${pageSizeButton(100, state.pageSize)}\n172\t  </div>\n173\t</div>`;\n174\t}\n175\t\n176\tfunction renderEmpty(filtered: boolean, i18n: ReviewI18n): string {\n177\t    const message = filtered\n178\t        ? i18n.t('consolidationQueueView.emptyFiltered')\n179\t        : i18n.t('consolidationQueueView.empty');\n180\t    return `<div class=\"placeholder\"><h3>${escapeHtml(message)}</h3></div>`;\n181\t}\n182\t\n183\tfunction renderError(i18n: ReviewI18n, message: string): string {\n184\t    return `<section class=\"route-stack\" data-testid=\"review-consolidation-queue\"><div class=\"banner error\" role=\"alert\"><strong>${escapeHtml(i18n.t('consolidationQueueView.errorTitle'))}</strong><p>${escapeHtml(message)}</p></div></section>`;\n185\t}\n186\t\n187\tfunction filterJobs(jobs: ReviewConsolidationJob[], state: ConsolidationQueueViewState): ReviewConsolidationJob[] {\n188\t    return jobs.filter((job) => {\n189\t        if (state.selectedStatuses.length && !state.selectedStatuses.includes(job.status)) {\n190\t            return false;\n191\t        }\n192\t        if (state.selectedKinds.length && !state.selectedKinds.includes(job.kind)) {\n193\t            return false;\n194\t        }\n195\t        if (state.selectedModes.length && !state.selectedModes.includes(job.mode)) {\n196\t            return false;\n197\t        }\n198\t        return true;\n199\t    });\n200\t}\n201\t\n202\tfunction sortJobs(jobs: ReviewConsolidationJob[], state: ConsolidationQueueViewState): ReviewConsolidationJob[] {\n203\t    const sorted = [...jobs].sort((left, right) => compareJobs(left, right, state.sortBy));\n204\t    return state.sortDirection === 'desc' ? sorted.reverse() : sorted;\n205\t}\n206\t\n207\tfunction compareJobs(left: ReviewConsolidationJob, right: ReviewConsolidationJob, sortBy: ConsolidationQueueSortKey): number {\n208\t    switch (sortBy) {\n209\t        case 'status':\n210\t            return left.status.localeCompare(right.status);\n211\t        case 'kind':\n212\t            return left.kind.localeCompare(right.kind);\n213\t        case 'mode':\n214\t            return left.mode.localeCompare(right.mode);\n215\t        case 'duration':\n216\t            return (left.durationMs ?? -1) - (right.durationMs ?? -1);\n217\t        case 'createdAt':\n218\t        default:\n219\t            return (Date.parse(left.createdAt ?? '') || 0) - (Date.parse(right.createdAt ?? '') || 0);\n220\t    }\n221\t}\n222\t\n223\tfunction paginate<T>(items: T[], page: number, pageSize: number): { items: T[] } {\n224\t    const totalPages = Math.max(1, Math.ceil(items.length / pageSize));\n225\t    const safePage = clampPage(page, totalPages);\n226\t    const start = (safePage - 1) * pageSize;\n227\t    return { items: items.slice(start, start + pageSize) };\n228\t}\n229\t\n230\tfunction clampPage(page: number, totalPages: number): number {\n231\t    return Math.min(Math.max(page, 1), totalPages);\n232\t}\n233\t\n234\tfunction sortableHeader(\n235\t    sortBy: ConsolidationQueueSortKey,\n236\t    state: ConsolidationQueueViewState,\n237\t    i18n: ReviewI18n,\n238\t    key: string\n239\t): string {\n240\t    const direction = state.sortBy === sortBy ? (state.sortDirection === 'asc' ? '↑' : '↓') : '↕';\n241\t    return `<th><button type=\"button\" class=\"table-sort\" data-command=\"sortConsolidationQueue\" data-sort-by=\"${escapeAttr(sortBy)}\">${escapeHtml(i18n.t(key))} ${direction}</button></th>`;\n242\t}\n243\t\n244\tfunction labelFor(value: string, prefix: string, i18n: ReviewI18n): string {\n245\t    return i18n.has(`${prefix}.${value}`) ? i18n.t(`${prefix}.${value}`) : value;\n246\t}\n247\t\n248\tfunction summarize(values: string[], prefix: string, i18n: ReviewI18n): string {\n249\t    if (!values.length) {\n250\t        return i18n.t('consolidationQueueView.filters.all');\n251\t    }\n252\t    return values.map((value) => labelFor(value, prefix, i18n)).join(', ');\n253\t}\n254\t\n255\tfunction formatTimestamp(value: string | undefined, i18n: ReviewI18n): string {\n256\t    if (!value) {\n257\t        return i18n.t('consolidationQueueView.notAvailable');\n258\t    }\n259\t    const timestamp = Date.parse(value);\n260\t    if (Number.isNaN(timestamp)) {\n261\t        return value;\n262\t    }\n263\t    return new Date(timestamp).toLocaleString();\n264\t}\n265\t\n266\tfunction formatDuration(durationMs: number | undefined, i18n: ReviewI18n): string {\n267\t    if (durationMs === undefined) {\n268\t        return i18n.t('consolidationQueueView.notAvailable');\n269\t    }\n270\t    if (durationMs < 1000) {\n271\t        return i18n.t('consolidationQueueView.durationMs', { value: durationMs });\n272\t    }\n273\t    return i18n.t('consolidationQueueView.durationSeconds', { value: (durationMs / 1000).toFixed(1) });\n274\t}\n275\t\n276\tfunction filterButton(command: string, label: string): string {\n277\t    return `<button type=\"button\" data-command=\"${escapeAttr(command)}\">${escapeHtml(label)}</button>`;\n278\t}\n279\t\n280\tfunction summaryCard(label: string, value: string): string {\n281\t    return `<div class=\"card\"><small>${escapeHtml(label)}</small><strong>${escapeHtml(value)}</strong></div>`;\n282\t}\n283\t\n284\tfunction pageSizeButton(size: number, active: number): string {\n285\t    return `<button type=\"button\" data-command=\"setConsolidationQueuePageSize\" data-page-size=\"${size}\" ${size === active ? 'disabled' : ''}>${size}/page</button>`;\n286\t}\n287\t\n288\tfunction countLabel(values: string[], jobs: ReviewConsolidationJob[], field: 'status' | 'kind' | 'mode'): number {\n289\t    if (values.length) {\n290\t        return values.length;\n291\t    }\n292\t    return new Set(jobs.map((job) => job[field])).size;\n293\t}\n294\t"}]},"parent_tool_use_id":"toolu_01YL1bW3bEAsvfd93Vq2Fj4H","session_id":"3f5c8929-5870-493f-9d77-6b17226dfdaa","uuid":"2de153c2-a84e-480b-bef2-02495be15daa","timestamp":"2026-05-17T18:17:54.809Z","subagent_type":"Explore","task_description":"Audit mutation error handling"}
