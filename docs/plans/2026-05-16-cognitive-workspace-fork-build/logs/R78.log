{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XZVkYWqPvwv5FPbC34KLcV","type":"tool_result","content":"1\timport { ReviewI18n } from './i18n';\n2\timport { renderStatusBadge } from './components/StatusBadge';\n3\timport { ReviewRpcBridgeContract } from './rpcBridge';\n4\timport { ReviewMemory } from './rpcPayloads';\n5\t\n6\t// Status taxonomy from `## 8. Verification Engine`; stale surfacing requirement from\n7\t// `## Stale Memory Leakage` in docs/plans/2026-05-16-cognitive-workspace-fork-plan.md.\n8\texport const STALE_FAMILY_STATUSES = [\n9\t    'stale',\n10\t    'contradicted',\n11\t    'superseded',\n12\t    'expired',\n13\t    'invalidated',\n14\t] as const;\n15\t\n16\ttype StaleSortKey = 'status' | 'memoryClass' | 'scope' | 'staleSince';\n17\ttype SortDirection = 'asc' | 'desc';\n18\t\n19\texport interface StaleViewState {\n20\t    selectedStatuses: string[];\n21\t    selectedScopes: string[];\n22\t    sortBy: StaleSortKey;\n23\t    sortDirection: SortDirection;\n24\t    reverifyInFlightId?: string;\n25\t    rowErrors: Record<string, string>;\n26\t}\n27\t\n28\texport interface StaleViewHost {\n29\t    readonly state: StaleViewState;\n30\t    reportError?(message: string): void;\n31\t    setContent(markup: string): void;\n32\t}\n33\t\n34\texport async function mountStaleView(\n35\t    host: StaleViewHost,\n36\t    bridge: ReviewRpcBridgeContract,\n37\t    i18n: ReviewI18n\n38\t): Promise<void> {\n39\t    try {\n40\t        const result = await bridge.listStaleMemories(undefined, 200);\n41\t        if (!result.ok) {\n42\t            host.reportError?.(result.error.message);\n43\t            host.setContent(renderError(i18n, result.error.message));\n44\t            return;\n45\t        }\n46\t        const staleMemories = result.value.memories.filter((memory) =>\n47\t            STALE_FAMILY_STATUSES.includes(memory.verificationStatus as typeof STALE_FAMILY_STATUSES[number])\n48\t        );\n49\t        host.setContent(renderTable(staleMemories, host.state, i18n));\n50\t    } catch (error) {\n51\t        const message = error instanceof Error ? error.message : String(error);\n52\t        host.reportError?.(message);\n53\t        host.setContent(renderError(i18n, message));\n54\t    }\n55\t}\n56\t\n57\tfunction renderTable(memories: ReviewMemory[], state: StaleViewState, i18n: ReviewI18n): string {\n58\t    const scopes = uniqueValues(memories.map((memory) => memory.scope));\n59\t    const filtered = applyFilters(memories, state);\n60\t    const rows = sortMemories(filtered, state).map((memory) => renderRow(memory, state, i18n)).join('');\n61\t    const activeStatuses = state.selectedStatuses.length\n62\t        ? state.selectedStatuses.map((status) => i18n.t(`reviewStatus.${status}`)).join(', ')\n63\t        : i18n.t('staleView.allStatuses');\n64\t    const activeScopes = state.selectedScopes.length\n65\t        ? state.selectedScopes.map((scope) => i18n.t(`staleView.scope.${scope}`)).join(', ')\n66\t        : i18n.t('staleView.allScopes');\n67\t    const emptyMessage = memories.length === 0\n68\t        ? i18n.t('staleView.empty')\n69\t        : i18n.t('staleView.emptyFiltered');\n70\t\n71\t    return `<section class=\"route-stack\" data-testid=\"review-stale-view\">\n72\t  <div class=\"route-toolbar\">\n73\t    <div>\n74\t      <h3>${escapeHtml(i18n.t('staleView.title'))}</h3>\n75\t      <p>${escapeHtml(i18n.t('staleView.loadingHint'))}</p>\n76\t    </div>\n77\t    <div class=\"toolbar-actions\">\n78\t      <button data-command=\"pickStaleStatusFilters\">${escapeHtml(i18n.t('staleView.filterStatus'))}</button>\n79\t      <button data-command=\"pickStaleScopeFilters\">${escapeHtml(i18n.t('staleView.filterScope'))}</button>\n80\t    </div>\n81\t  </div>\n82\t  <div class=\"filter-bar\">\n83\t    <span class=\"filter-pill\">${escapeHtml(i18n.t('staleView.activeStatus', { value: activeStatuses }))}</span>\n84\t    <span class=\"filter-pill\">${escapeHtml(i18n.t('staleView.activeScope', { value: activeScopes }))}</span>\n85\t    <span class=\"filter-pill\">${escapeHtml(i18n.t('staleView.scopeCount', { count: scopes.length }))}</span>\n86\t  </div>\n87\t  ${rows\n88\t        ? `<div class=\"table-shell\"><table class=\"data-table\">\n89\t      <thead>\n90\t        <tr>\n91\t          ${renderHeader('status', state, i18n, 'staleView.column.status')}\n92\t          ${renderHeader('memoryClass', state, i18n, 'staleView.column.class')}\n93\t          ${renderHeader('scope', state, i18n, 'staleView.column.scope')}\n94\t          <th>${escapeHtml(i18n.t('staleView.column.content'))}</th>\n95\t          ${renderHeader('staleSince', state, i18n, 'staleView.column.staleSince')}\n96\t          <th>${escapeHtml(i18n.t('staleView.column.reason'))}</th>\n97\t          <th>${escapeHtml(i18n.t('staleView.column.actions'))}</th>\n98\t        </tr>\n99\t      </thead>\n100\t      <tbody>${rows}</tbody>\n101\t    </table></div>`\n102\t        : `<div class=\"placeholder\"><h3>${escapeHtml(emptyMessage)}</h3></div>`}\n103\t</section>`;\n104\t}\n105\t\n106\tfunction renderHeader(\n107\t    sortBy: StaleSortKey,\n108\t    state: StaleViewState,\n109\t    i18n: ReviewI18n,\n110\t    key: string\n111\t): string {\n112\t    const isActive = state.sortBy === sortBy;\n113\t    const direction = isActive && state.sortDirection === 'asc' ? '↑' : isActive ? '↓' : '↕';\n114\t    return `<th><button class=\"table-sort\" data-command=\"sortStaleView\" data-sort-by=\"${escapeHtml(sortBy)}\">\n115\t${escapeHtml(i18n.t(key))} ${escapeHtml(direction)}</button></th>`;\n116\t}\n117\t\n118\tfunction renderRow(memory: ReviewMemory, state: StaleViewState, i18n: ReviewI18n): string {\n119\t    const isReverifying = state.reverifyInFlightId === memory.id;\n120\t    const rowError = state.rowErrors[memory.id];\n121\t    const staleSince = formatTimestamp(memory.lastVerifiedAt ?? memory.createdAt, i18n);\n122\t    return `<tr class=\"row-link\" data-command=\"openEvidenceInspector\" data-memory-id=\"${escapeHtml(memory.id)}\">\n123\t  <td>${renderStatusBadge(memory.verificationStatus, i18n)}</td>\n124\t  <td>${escapeHtml(formatClass(memory.memoryClass, i18n))}</td>\n125\t  <td>${escapeHtml(formatScope(memory.scope, i18n))}</td>\n126\t  <td>\n127\t    <div class=\"cell-stack\">\n128\t      <button class=\"link-button\" data-command=\"openEvidenceInspector\" data-memory-id=\"${escapeHtml(memory.id)}\">\n129\t        ${escapeHtml(truncate(memory.content, 96))}\n130\t      </button>\n131\t      <small>${escapeHtml(memory.id)}</small>\n132\t    </div>\n133\t  </td>\n134\t  <td>${escapeHtml(staleSince)}</td>\n135\t  <td>${escapeHtml(formatStaleReason(memory, i18n))}</td>\n136\t  <td>\n137\t    <div class=\"row-actions\">\n138\t      <button data-command=\"openEvidenceInspector\" data-memory-id=\"${escapeHtml(memory.id)}\">\n139\t        ${escapeHtml(i18n.t('staleView.inspectEvidence'))}\n140\t      </button>\n141\t      <button data-command=\"reverifyStaleMemory\" data-memory-id=\"${escapeHtml(memory.id)}\" ${isReverifying ? 'disabled' : ''}>\n142\t        ${isReverifying ? escapeHtml(i18n.t('staleView.reverifyLoading')) : escapeHtml(i18n.t('staleView.reverify'))}\n143\t      </button>\n144\t    </div>\n145\t    ${rowError ? `<div class=\"inline-error\" role=\"alert\">${escapeHtml(rowError)}</div>` : ''}\n146\t  </td>\n147\t</tr>`;\n148\t}\n149\t\n150\tfunction applyFilters(memories: ReviewMemory[], state: StaleViewState): ReviewMemory[] {\n151\t    return memories.filter((memory) => {\n152\t        if (state.selectedStatuses.length && !state.selectedStatuses.includes(memory.verificationStatus)) {\n153\t            return false;\n154\t        }\n155\t        if (state.selectedScopes.length && !state.selectedScopes.includes(memory.scope)) {\n156\t            return false;\n157\t        }\n158\t        return true;\n159\t    });\n160\t}\n161\t\n162\tfunction sortMemories(memories: ReviewMemory[], state: StaleViewState): ReviewMemory[] {\n163\t    const sorted = [...memories].sort((left, right) => compareMemory(left, right, state.sortBy));\n164\t    return state.sortDirection === 'desc' ? sorted.reverse() : sorted;\n165\t}\n166\t\n167\tfunction compareMemory(left: ReviewMemory, right: ReviewMemory, sortBy: StaleSortKey): number {\n168\t    switch (sortBy) {\n169\t        case 'memoryClass':\n170\t            return left.memoryClass.localeCompare(right.memoryClass);\n171\t        case 'scope':\n172\t            return left.scope.localeCompare(right.scope);\n173\t        case 'staleSince':\n174\t            return (left.lastVerifiedAt ?? left.createdAt ?? 0) - (right.lastVerifiedAt ?? right.createdAt ?? 0);\n175\t        case 'status':\n176\t        default:\n177\t            return left.verificationStatus.localeCompare(right.verificationStatus);\n178\t    }\n179\t}\n180\t\n181\tfunction renderError(i18n: ReviewI18n, message: string): string {\n182\t    return `<section class=\"route-stack\" data-testid=\"review-stale-view\"><div class=\"banner error\" role=\"alert\">\n183\t  <strong>${escapeHtml(i18n.t('staleView.errorTitle'))}</strong>\n184\t  <p>${escapeHtml(message)}</p>\n185\t</div></section>`;\n186\t}\n187\t\n188\tfunction formatStaleReason(memory: ReviewMemory, i18n: ReviewI18n): string {\n189\t    const rawReason = memory.staleReason?.trim();\n190\t    if (!rawReason) {\n191\t        return i18n.t(`staleView.statusReason.${memory.verificationStatus}`);\n192\t    }\n193\t    const normalized = rawReason.toLowerCase().replaceAll(' ', '_').replaceAll('-', '_');\n194\t    if (i18n.has(`staleView.reason.${normalized}`)) {\n195\t        return i18n.t(`staleView.reason.${normalized}`);\n196\t    }\n197\t    return rawReason;\n198\t}\n199\t\n200\tfunction formatClass(memoryClass: string, i18n: ReviewI18n): string {\n201\t    return i18n.has(`staleView.class.${memoryClass}`)\n202\t        ? i18n.t(`staleView.class.${memoryClass}`)\n203\t        : memoryClass;\n204\t}\n205\t\n206\tfunction formatScope(scope: string, i18n: ReviewI18n): string {\n207\t    return i18n.has(`staleView.scope.${scope}`) ? i18n.t(`staleView.scope.${scope}`) : scope;\n208\t}\n209\t\n210\tfunction truncate(value: string, length: number): string {\n211\t    return value.length <= length ? value : `${value.slice(0, length - 1)}…`;\n212\t}\n213\t\n214\tfunction formatTimestamp(value: number | undefined, i18n: ReviewI18n): string {\n215\t    if (!value) {\n216\t        return i18n.t('staleView.notAvailable');\n217\t    }\n218\t    return new Date(value * 1000).toLocaleString();\n219\t}\n220\t\n221\tfunction uniqueValues(values: string[]): string[] {\n222\t    return [...new Set(values.filter(Boolean))].sort((left, right) => left.localeCompare(right));\n223\t}\n224\t\n225\tfunction escapeHtml(value: string): string {\n226\t    return value\n227\t        .replaceAll('&', '&amp;')\n228\t        .replaceAll('<', '&lt;')\n229\t        .replaceAll('>', '&gt;')\n230\t        .replaceAll('\"', '&quot;')\n231\t        .replaceAll(\"'\", '&#39;');\n232\t}\n233\t"}]},"parent_tool_use_id":"toolu_01QKg7EhpqnfNi9aRGKUBr62","session_id":"3f5c8929-5870-493f-9d77-6b17226dfdaa","uuid":"66a1142a-9aa8-4d4f-8399-e13063f617e6","timestamp":"2026-05-17T18:17:58.459Z","subagent_type":"Explore","task_description":"Audit pagination, sort headers, states"}
