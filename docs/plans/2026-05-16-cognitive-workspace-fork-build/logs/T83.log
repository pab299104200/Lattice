+    assert!(
+        indexer
+            .graph()
+            .get_dependencies(&crate::symbols::SymbolId {
+                file: "src/app.ts".to_string(),
+                name: "runApp".to_string(),
+                byte_offset: 40,
+            })
+            .is_empty(),
+        "ignored import targets must not be resolved via a broad workspace read"
+    );
+}
