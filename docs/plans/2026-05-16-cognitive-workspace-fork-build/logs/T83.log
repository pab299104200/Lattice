        .unwrap();

    // Index files that reference each other
    mgr.index_file(
        "frontend",
        "src/api.ts",
        r#"
import { UserService } from 'backend-api';
export function fetchUser() { return UserService.getUser(); }
"#,
    )
    .unwrap();
    mgr.index_file(
        "backend",
        "src/service.ts",
