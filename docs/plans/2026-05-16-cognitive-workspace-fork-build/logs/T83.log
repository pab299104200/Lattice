ent).expect(\"parent dir creates\");\n243\t        }\n244\t        std::fs::write(full_path, contents).expect(\"file writes\");\n245\t    }\n246\t\n247\t    fn delete_file(&self, path: &str) {\n248\t        let full_path = self.workspace_root.join(path);\n249\t        if full_path.exists() {\n250\t            std::fs::remove_file(full_path).expect(\"file deletes\");\n251\t        }\n252\t    }\n253\t\n254\t    fn seed_plain_memory(&self, id: &str, content: &str) -> String {\n255\t        self.store_memory(base_memory(id, content, MemoryScope::Branch, vec![]))\n256\t    }\n257\t\n258\t    fn seed_file_memory(&self, id: &str, path: &str) -> String {\n259\t        let memory_id = self.store_memory(base_memory(\n260\t            id,\n261\t            &format!(\"memory {id}\"),\n262\t            MemoryScope::Branch,\n263\t            vec![path.to_string()],\n264\t        ));\n265\t        self.set_fields(&memory_id, file_fields(path));\n266\t        memory_id\n267\t    }\n268\t\n269\t    fn seed_span_memory(&self, id: &str, path: &str, contents: &str) -> String {\n270\t        self.write_file(path, contents);\n271\t        let file_id = self.file_id(path, \"hash-auth-v1\");\n272\t        let span = EvidenceSpan {\n273\t            file_id: file_id.clone(),\n274\t            byte_start: 0,\n275\t            byte_end: contents.len() as u32,\n276\t            line_start: 1,\n277\t            line_end: 1,\n278\t        };\n279\t        let evidence = MemoryEvidence {\n280\t            kind: \"file\".to_string(),\n281\t            reference: Some(path.to_string()),\n282\t            detail: None,\n283\t            captured_at: Some(100),\n284\t            span: Some(span),\n285\t            evidence_content_hash: Some(hash_bytes(contents.as_bytes())),\n286\t        };\n287\t        let memory_id = self.store_memory(base_memory(\n288\t            id,\n289\t            &format!(\"memory {id}\"),\n290\t            MemoryScope::Branch,\n291\t            vec![path.to_string()],\n292\t        ));\n293\t        self.set_fields(&memory_id, fields_with_evidence(vec![evidence]));\n294\t        memory_id\n295\t    }\n296\t\n297\t    fn seed_scope_leak_fixture(&self) -> Vec<String> {\n298\t        vec![\n299\t            self.store_memory(base_memory(\n300\t                \"mem-session-leak\",\n301\t                \"session leak\",\n302\t                MemoryScope::Session,\n303\t                vec![],\n304\t            )),\n305\t            self.store_memory(branch_memory(\"mem-branch-leak\", \"feat/one\", None)),\n306\t            self.store_memory(repo_memory(\"mem-repo-leak\", \"workspace-other\", None)),\n307\t            self.store_memory(org_memory(\"mem-org-leak\", \"org-a\")),\n308\t        ]\n309\t    }\n310\t\n311\t    fn run_scope_leak_queries(&self) -> Vec<Option<Memory>> {\n312\t        vec![\n313\t            self.memory_store\n314\t                .get_by_id_scoped(\n315\t                    \"mem-session-leak\",\n316\t                    &ScopeFilter::new(\"workspace-main\", Some(branch(\"main\")), None)\n317\t                        .for_session(\"different-session\"),\n318\t                )\n319\t                .expect(\"session scope lookup\"),\n320\t            self.memory_store\n321\t                .get_by_id_scoped(\n322\t                    \"mem-branch-leak\",\n323\t                    &ScopeFilter::new(\"workspace-main\", Some(branch(\"feat/two\")), None),\n324\t                )\n325\t                .expect(\"branch scope lookup\"),\n326\t            self.memory_store\n327\t                .get_by_id_scoped(\n328\t                    \"mem-repo-leak\",\n329\t                    &ScopeFilter::new(\"workspace-main\", Some(branch(\"main\")), None),\n330\t                )\n331\t                .expect(\"repo scope lookup\"),\n332\t            self.memory_store\n333\t                .get_by_id_scoped(\n334\t                    \"mem-org-leak\",\n335\t                    &ScopeFilter::new(\n336\t                       