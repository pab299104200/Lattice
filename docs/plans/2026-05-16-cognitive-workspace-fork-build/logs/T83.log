             attempted_workspace_id = scope.workspace_id.as_str(),\n                attempted_branch = scope.branch.as_ref().map(|branch| branch.name.as_str()),\n                memory_scope = memory.scope.as_str(),\n                \"scope_leak_blocked\"\n            );\n            self.record_scope_filtered(memory, scope)?;\n            Ok(())\n        }\n    }\n\n    fn record_scope_filtered(\n        &self,\n        memory: &Memory,\n        scope: &ScopeFilter,\n    ) -> Result<(), LatticeError> {\n        tracing::warn!(\n            memory_id = memory.id.as_str(),\n            attempted_workspace_id = scope.workspace_id.as_str(),\n            attempted_branch = scope.branch.as_ref().map(|branch| branch.name.as_str()),\n            memory_scope = memory.scope.as_str(),\n            \"scope_leak_blocked\"\n        );\n        self.conn\n            .execute(\n                \"INSERT INTO memory_scope_filter_events\n                    (memory_id, attempted_workspace_id, attempted_branch, memory_scope, created_at)\n                 VALUES (?1, ?2, ?3, ?4, ?5)\",\n                params![\n                    memory.id,\n                    scope.workspace_id,\n                    scope.branch.as_ref().map(|branch| branch.name.as_str()),\n                    memory.scope.as_str(),\n                    now_epoch_secs() as i64,\n                ],\n            )\n            .map_err(|e| {\n                LatticeError::Storage(format!(\"Failed to record memory scope filter event: {}\", e))\n            })?;\n        Ok(())\n    }\n\n    fn find_impacted_memory_ids_impl(\n        &self,\n        workspace_id: &str,\n        changed_files: &[String],\n        changed_symbols: &[String],\n        distinct_memories: bool,\n    ) -> Result<Vec<String>, LatticeError> {\n        if changed_files.is_empty() && changed_symbols.is_empty() {\n            return Ok(Vec::new());","numLines":100,"startLine":2160,"totalLines":2897}}}
docs/plans/2026-05-16-cognitive-workspace-fork-build/logs/R54.log:63:{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y8jv5UL3akEpjrV6woMjsq","type":"tool_result","content":"1\tuse std::collections::HashMap;\n2\tuse std::path::PathBuf;\n3\tuse std::sync::{Arc, Mutex};\n4\t\n5\tuse rusqlite::Connection;\n6\tuse tempfile::tempdir;\n7\t\n8\tuse super::{ExpiryScanner, IncrementalVerifier, VerificationObserver, WorkspaceFileReader};\n9\tuse crate::consolidation::{ConsolidationConfig, ConsolidationJobRuntime};\n10\tuse crate::events::{EventStore, EventWriter, FlushPolicy};\n11\tuse crate::graph::CodeGraph;\n12\tuse crate::identity::{FileId, OperatorId};\n13\tuse crate::memory::{\n14\t    Memory, MemoryEvidence, MemoryScope, MemoryStore, MemoryStructuredFields, MemoryType,\n15\t    MemoryVerificationStatus,\n16\t};\n17\tuse crate::storage::graph_store::{\n18\t    FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n19\t};\n20\tuse crate::symbols::Language;\n21\tuse crate::DateTime;\n22\t\n23\t#[test]\n24\tfn graph_delta_reverifies_only_impacted_memories() {\n25\t    let fixture = Fixture::new();\n26\t    let changed_file = fixture.file_id(\"src/auth.ts\", \"hash-auth\");\n27\t    let unchanged_file = fixture.file_id(\"src/billing.ts\", \"hash-billing\");\n28\t    let graph = fixture.graph_with_files(&[\n29\t        (&changed_file, \"loginUser\", 12),\n30\t        (&unchanged_file, \"chargeInvoice\", 24),\n31\t    ]);\n32\t    let file_index = fixture.file_index(&[\n33\t        (&changed_file, \"hash-auth\", 200),\n34\t        (&unchanged_file, \"hash-billing\", 200),\n35\t    ]);\n36\t    let parsed_files = HashMap::new();\n37\t    let reader = WorkspaceFileReader::new(fixture.workspace_root.clone());\n38\t    let observer = CountingObserver::default();\n39\t\n40\t    fixture.seed_memory(\"mem-file\", file_evidence(&changed_file.repo_relative_path));\n41\t    fixture.seed_memory(\"mem-symbol\", symbol_evidence(\"loginUser\"));\n42\t    fixture.seed_memory(\n43\t        \"mem-other\",\n44\t        file_evidence(&unchanged_file.repo_relative_path),\n45\t    );\n46\t\n47\t    let mut runtime = fixture.runtime();\n48\t    let operator = operator();\n49\t    let mut verifier = IncrementalVerifier::new(\n50\t        &fixture.memory_store,\n51\t        &mut runtime,\n52\t        &graph,\n53\t        &file_index,\n54\t        &parsed_files,\n55\t        &reader,\n56\t        &fixture.event_writer,\n57\t        &operator,\n58\t        \"workspace-main\",\n59\t        32,\n60\t    )\n61\t    .with_observer(&observer);\n62\t\n63\t    let report = verifier\n64\t        .on_graph_delta(1, 2, vec![changed_file.clone()])\n65\t        .expect(\"delta verification succeeds\");\n66\t\n67\t    assert_eq!(report.impacted, 2);\n68\t    assert_eq!(observer.memory_ids(), vec![\"mem-file\", \"mem-symbol\"]);\n69\t}\n70\t\n71\t#[test]\n72\tfn expiry_scanner_marks_expired_and_is_idempotent() {\n73\t    let fixture = Fixture::new();\n74\t    let expired_memory = fixture.seed_memory(\"mem-expired\", file_evidence(\"src/auth.ts\"));\n75\t    fixture\n76\t        .memory_store\n77\t        .set_expires_at(&expired_memory, DateTime::from_unix_seconds(10))\n78\t        .expect(\"expiry stores\");\n79\t    let operator = operator();\n80\t    let mut runtime = fixture.runtime();\n81\t    let mut scanner = ExpiryScanner::new(\n82\t        &fixture.memory_store,\n83\t        &mut runtime,\n84\t        &fixture.event_writer,\n85\t        &operator,\n86\t    );\n87\t\n88\t    let first = scanner\n89\t        .scan(\"workspace-main\", DateTime::from_unix_seconds(20))\n90\t        .expect(\"first expiry scan succeeds\");\n91\t    let second = scanner\n92\t        .scan(\"workspace-main\", DateTime::from_unix_seconds(20))\n93\t        .expect(\"second expiry scan succeeds\");\n94\t\n95\t    assert_eq!(first.expired, 1);\n96\t    assert_eq!(second.expired, 0);\n97\t    assert_eq!(\n98\t        fixture\n99\t            .memory_store\n100\t            .get_structured_fields(&expired_memory)\n101\t            .expect(\"fields load\")\n102\t            .expect(\"memory exists\")\n103\t            .verification_status,\n104\t        MemoryVerificationStatus::Expired\n105\t    );\n106\t}\n107\t\n108\t#[test]\n109\tfn successful_verification_advances_last_verified_graph_snapshot_id() {\n110\t    let fixture = Fixture::new();\n111\t    let changed_file = fixture.file_id(\"src/auth.ts\", \"hash-auth\");\n112\t    let graph = fixture.graph_with_files(&[(&changed_file, \"loginUser\", 12)]);\n113\t    let file_index = fixture.file_index(&[(&changed_file, \"hash-auth\", 200)]);\n114\t    let parsed_files = HashMap::new();\n115\t    let reader = WorkspaceFileReader::new(fixture.workspace_root.clone());\n116\t\n117\t    let memory_id = fixture.seed_memory(\n118\t        \"mem-verified\",\n119\t        file_evidence(&changed_file.repo_relative_path),\n120\t    );\n121\t    let mut runtime = fixture.runtime();\n122\t    let operator = operator();\n123\t    let mut verifier = IncrementalVerifier::new(\n124\t        &fixture.memory_store,\n125\t        &mut runtime,\n126\t        &graph,\n127\t        &file_index,\n128\t        &parsed_files,\n129\t        &reader,\n130\t        &fixture.event_writer,\n131\t        &operator,\n132\t        \"workspace-main\",\n133\t        8,\n134\t    );\n135\t\n136\t    let report = verifier\n137\t        .on_graph_delta(4, 8, vec![changed_file])\n138\t        .expect(\"verification succeeds\");\n139\t\n140\t    assert_eq!(report.verified, 1);\n141\t    assert_eq!(\n142\t        fixture\n143\t            .memory_store\n144\t            .get_last_verified_graph_snapshot_id(&memory_id)\n145\t            .expect(\"snapshot id loads\"),\n146\t        Some(8)\n147\t    );\n148\t}\n149\t\n150\t#[test]\n151\tfn deleted_file_invalidates_verified_memory_on_next_delta() {\n152\t    let fixture = Fixture::new();\n153\t    let changed_file = fixture.file_id(\"src/auth.ts\", \"hash-auth\");\n154\t    let parsed_files = HashMap::new();\n155\t    let reader = WorkspaceFileReader::new(fixture.workspace_root.clone());\n156\t\n157\t    let memory_id = fixture.seed_memory(\n158\t        \"mem-delete\",\n159\t        file_evidence(&changed_file.repo_relative_path),\n160\t    );\n161\t    fixture.set_verification_status(&memory_id, MemoryVerificationStatus::Verified);\n162\t    let empty_graph = CodeGraph::new();\n163\t    let empty_file_index = HashMap::new();\n164\t\n165\t    let mut runtime = fixture.runtime();\n166\t    let operator = operator();\n167\t    let mut verifier = IncrementalVerifier::new(\n168\t        &fixture.memory_store,\n169\t        &mut runtime,\n170\t        &empty_graph,\n171\t        &empty_file_index,\n172\t        &parsed_files,\n173\t        &reader,\n174\t        &fixture.event_writer,\n175\t        &operator,\n176\t        \"workspace-main\",\n177\t        8,\n178\t    );\n179\t\n180\t    let report = verifier\n181\t        .on_graph_delta(8, 9, vec![changed_file])\n182\t        .expect(\"verification succeeds\");\n183\t\n184\t    assert_eq!(report.invalidated, 1);\n185\t    assert_eq!(\n186\t        fixture\n187\t            .memory_store\n188\t            .get_structured_fields(&memory_id)\n189\t            .expect(\"fields load\")\n190\t            .expect(\"memory exists\")\n191\t            .verification_status,\n192\t        MemoryVerificationStatus::Invalidated\n193\t    );\n194\t}\n195\t\n196\t#[test]\n197\tfn bounded_work_budget_reenqueues_remaining_memories() {\n198\t    let fixture = Fixture::new();\n199\t    let changed_file = fixture.file_id(\"src/auth.ts\", \"hash-auth\");\n200\t    let graph = fixture.graph_with_files(&[(&changed_file, \"loginUser\", 12)]);\n201\t    let file_index = fixture.file_index(&[(&changed_file, \"hash-auth\", 200)]);\n202\t    let parsed_files = HashMap::new();\n203\t    let reader = WorkspaceFileReader::new(fixture.workspace_root.clone());\n204\t    let observer = CountingObserver::default();\n205\t\n206\t    for index in 0..1000 {\n207\t        fixture.seed_memory(\n208\t            &format!(\"mem-{index}\"),\n209\t            file_evidence(&changed_file.repo_relative_path),\n210\t        );\n211\t    }\n212\t\n213\t    let mut runtime = fixture.runtime();\n214\t    let operator = operator();\n215\t    let mut verifier = IncrementalVerifier::new(\n216\t        &fixture.memory_store,\n217\t        &mut runtime,\n218\t        &graph,\n219\t        &file_index,\n220\t        &parsed_files,\n221\t        &reader,\n222\t        &fixture.event_writer,\n223\t        &operator,\n224\t        \"workspace-main\",\n225\t        50,\n226\t    )\n227\t    .with_observer(&observer);\n228\t\n229\t    let report = verifier\n230\t        .on_graph_delta(1, 2, vec![changed_file])\n231\t        .expect(\"delta verification succeeds\");\n232\t\n233\t    assert_eq!(report.impacted, 1000);\n234\t    assert_eq!(report.verified, 50);\n235\t    assert_eq!(report.queued_for_retry, 950);\n236\t    assert_eq!(observer.memory_ids().len(), 50);\n237\t}\n238\t\n239\t#[derive(Default)]\n240\tstruct CountingObserver {\n241\t    memory_ids: Mutex<Vec<String>>,\n242\t}\n243\t\n244\timpl CountingObserver {\n245\t    fn memory_ids(&self) -> Vec<String> {\n246\t        self.memory_ids.lock().expect(\"observer lock\").clone()\n247\t    }\n248\t}\n249\t\n250\timpl VerificationObserver for CountingObserver {\n251\t    fn on_verify(&self, memory_id: &str) {\n252\t        self.memory_ids\n253\t            .lock()\n254\t            .expect(\"observer lock\")\n255\t            .push(memory_id.to_string());\n256\t    }\n257\t}\n258\t\n259\tstruct Fixture {\n260\t    _dir: tempfile::TempDir,\n261\t    workspace_root: PathBuf,\n262\t    memory_store: MemoryStore,\n263\t    runtime_db: PathBuf,\n264\t    _event_store: Arc<EventStore>,\n265\t    event_writer: EventWriter,\n266\t}\n267\t\n268\timpl Fixture {\n269\t    fn new() -> Self {\n270\t        let dir = tempdir().expect(\"tempdir\");\n271\t        let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store\"));\n272\t        let event_writer =\n273\t            EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n274\t                .with_flush_policy(FlushPolicy::Sync);\n275\t        Self {\n276\t            workspace_root: dir.path().to_path_buf(),\n277\t            memory_store: MemoryStore::open(&dir.path().join(\"memory.sqlite\"))\n278\t                .expect(\"memory store\"),\n279\t            runtime_db: dir.path().join(\"verification.sqlite\"),\n280\t            _event_store: event_store,\n281\t            event_writer,\n282\t            _dir: dir,\n283\t        }\n284\t    }\n285\t\n286\t    fn runtime(&self) -> ConsolidationJobRuntime {\n287\t        ConsolidationJobRuntime::new(\n288\t            Connection::open(&self.runtime_db).expect(\"verification db opens\"),\n289\t            ConsolidationConfig::default(),\n290\t        )\n291\t        .expect(\"runtime opens\")\n292\t    }\n293\t\n294\t    fn seed_memory(&self, id: &str, evidence: MemoryEvidence) -> String {\n295\t        let memory = Memory {\n296\t            id: id.to_string(),\n297\t            session_id: \"session-main\".to_string(),\n298\t            content: format!(\"memory {id}\"),\n299\t            memory_type: MemoryType::Observation,\n300\t            scope: MemoryScope::Branch,\n301\t            confidence: 0.9,\n302\t            linked_symbols: Vec::new(),\n303\t            linked_files: Vec::new(),\n304\t            workspace_id: Some(\"workspace-main\".to_string()),\n305\t            branch: Some(\"main\".to_string()),\n306\t            scope_organization_id: None,\n307\t            refresh_key: Some(format!(\"refresh-{id}\")),\n308\t            source_query: Some(\"verification test\".to_string()),\n309\t            created_at: 100,\n310\t            last_accessed: 100,\n311\t            access_count: 0,\n312\t            is_stale: false,\n313\t            stale_reason: None,\n314\t            verification_status: crate::memory::MemoryVerificationStatus::Unverified,\n315\t        };\n316\t        let stored_id = self.memory_store.store(memory).expect(\"memory stores\");\n317\t        let mut fields = MemoryStructuredFields::default();\n318\t        fields.evidence = vec![evidence];\n319\t        self.memory_store\n320\t            .update_structured_fields(&stored_id, &fields)\n321\t            .expect(\"fields update\");\n322\t        stored_id\n323\t    }\n324\t\n325\t    fn set_verification_status(&self, memory_id: &str, status: MemoryVerificationStatus) {\n326\t        let mut fields = self\n327\t            .memory_store\n328\t            .get_structured_fields(memory_id)\n329\t            .expect(\"fields load\")\n330\t            .expect(\"memory exists\");\n331\t        fields.verification_status = status;\n332\t        self.memory_store\n333\t            .update_structured_fields(memory_id, &fields)\n334\t            .expect(\"fields update\");\n335\t    }\n336\t\n337\t    fn file_id(&self, path: &str, content_hash: &str) -> FileId {\n338\t        FileId {\n339\t            workspace_id: \"workspace-main\".to_string(),\n340\t            repo_relative_path: path.to_string(),\n341\t            content_hash: content_hash.to_string(),\n342\t        }\n343\t    }\n344\t\n345\t    fn graph_with_files(&self, nodes: &[(&FileId, &str, usize)]) -> CodeGraph {\n346\t        let mut graph = CodeGraph::new();\n347\t        for (file_id, name, byte_offset) in nodes {\n348\t            graph.add_node(\n349\t                crate::symbols::SymbolId {\n350\t                    file: file_id.repo_relative_path.clone(),\n351\t                    name: (*name).to_string(),\n352\t                    byte_offset: *byte_offset,\n353\t                },\n354\t                crate::symbols::SymbolKind::Function,\n355\t                (*name).to_string(),\n356\t                \"function\".to_string(),\n357\t                String::new(),\n358\t                file_id.repo_relative_path.clone(),\n359\t                1,\n360\t                1,\n361\t                true,\n362\t                Language::TypeScript,\n363\t            );\n364\t        }\n365\t        graph\n366\t    }\n367\t\n368\t    fn file_index(&self, files: &[(&FileId, &str, i64)]) -> HashMap<String, FileIndexEntry> {\n369\t        files\n370\t            .iter()\n371\t            .map(|(file_id, content_hash, last_indexed_at)| {\n372\t                (\n373\t                    file_id.repo_relative_path.clone(),\n374\t                    FileIndexEntry {\n375\t                        file: file_id.repo_relative_path.clone(),\n376\t                        content_hash: (*content_hash).to_string(),\n377\t                        mtime_ns: 0,\n378\t                        size_bytes: 128,\n379\t                        parser_version: FILE_INDEX_PARSER_VERSION,\n380\t                        schema_version: FILE_INDEX_SCHEMA_VERSION,\n381\t                        last_indexed_at: *last_indexed_at,\n382\t                    },\n383\t                )\n384\t            })\n385\t            .collect()\n386\t    }\n387\t}\n388\t\n389\tfn operator() -> OperatorId {\n390\t    OperatorId {\n391\t        value: \"verification-bot\".to_string(),\n392\t    }\n393\t}\n394\t\n395\tfn file_evidence(path: &str) -> MemoryEvidence {\n396\t    MemoryEvidence {\n397\t        kind: \"file\".to_string(),\n398\t        reference: Some(path.to_string()),\n399\t        detail: None,\n400\t        captured_at: Some(100),\n401\t        span: None,\n402\t        evidence_content_hash: None,\n403\t    }\n404\t}\n405\t\n406\tfn symbol_evidence(symbol_name: &str) -> MemoryEvidence {\n407\t    MemoryEvidence {\n408\t        kind: \"symbol\".to_string(),\n409\t        reference: Some(symbol_name.to_string()),\n410\t        detail: None,\n411\t        captured_at: Some(100),\n412\t        span: None,\n413\t        evidence_content_hash: None,\n414\t    }\n415\t}\n416\t"}]},"parent_tool_use_id":null,"session_id":"0696e093-0770-442b-8dc9-5393bbfcd0b6","uuid":"b0f58e1b-6973-4346-a546-df1170103256","timestamp":"2026-05-17T13:03:09.926Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/incremental_tests.rs","content":"use std::collections::HashMap;\nuse std::path::PathBuf;\nuse std::sync::{Arc, Mutex};\n\nuse rusqlite::Connection;\nuse tempfile::tempdir;\n\nuse super::{ExpiryScanner, IncrementalVerifier, VerificationObserver, WorkspaceFileReader};\nuse crate::consolidation::{ConsolidationConfig, ConsolidationJobRuntime};\nuse crate::events::{EventStore, EventWriter, FlushPolicy};\nuse crate::graph::CodeGraph;\nuse crate::identity::{FileId, OperatorId};\nuse crate::memory::{\n    Memory, MemoryEvidence, MemoryScope, MemoryStore, MemoryStructuredFields, MemoryType,\n    MemoryVerificationStatus,\n};\nuse crate::storage::graph_store::{\n    FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n};\nuse crate::symbols::Language;\nuse crate::DateTime;\n\n#[test]\nfn graph_delta_reverifies_only_impacted_memories() {\n    let fixture = Fixture::new();\n    let changed_file = fixture.file_id(\"src/auth.ts\", \"hash-auth\");\n    let unchanged_file = fixture.file_id(\"src/billing.ts\", \"hash-billing\");\n    let graph = fixture.graph_with_files(&[\n        (&changed_file, \"loginUser\", 12),\n        (&unchanged_file, \"chargeInvoice\", 24),\n    ]);\n    let file_index = fixture.file_index(&[\n        (&changed_file, \"hash-auth\", 200),\n        (&unchanged_file, \"hash-billing\", 200),\n    ]);\n    let parsed_files = HashMap::new();\n    let reader = WorkspaceFileReader::new(fixture.workspace_root.clone());\n    let observer = CountingObserver::default();\n\n    fixture.seed_memory(\"mem-file\", file_evidence(&changed_file.repo_relative_path));\n    fixture.seed_memory(\"mem-symbol\", symbol_evidence(\"loginUser\"));\n    fixture.seed_memory(\n        \"mem-other\",\n        file_evidence(&unchanged_file.repo_relative_path),\n    );\n\n    let mut runtime = fixture.runtime();\n    let operator = operator();\n    let mut verifier = IncrementalVerifier::new(\n        &fixture.memory_store,\n        &mut runtime,\n        &graph,\n        &file_index,\n        &parsed_files,\n        &reader,\n        &fixture.event_writer,\n        &operator,\n        \"workspace-main\",\n        32,\n    )\n    .with_observer(&observer);\n\n    let report = verifier\n        .on_graph_delta(1, 2, vec![changed_file.clone()])\n        .expect(\"delta verification succeeds\");\n\n    assert_eq!(report.impacted, 2);\n    assert_eq!(observer.memory_ids(), vec![\"mem-file\", \"mem-symbol\"]);\n}\n\n#[test]\nfn expiry_scanner_marks_expired_and_is_idempotent() {\n    let fixture = Fixture::new();\n    let expired_memory = fixture.seed_memory(\"mem-expired\", file_evidence(\"src/auth.ts\"));\n    fixture\n        .memory_store\n        .set_expires_at(&expired_memory, DateTime::from_unix_seconds(10))\n        .expect(\"expiry stores\");\n    let operator = operator();\n    let mut runtime = fixture.runtime();\n    let mut scanner = ExpiryScanner::new(\n        &fixture.memory_store,\n        &mut runtime,\n        &fixture.event_writer,\n        &operator,\n    );\n\n    let first = scanner\n        .scan(\"workspace-main\", DateTime::from_unix_seconds(20))\n        .expect(\"first expiry scan succeeds\");\n    let second = scanner\n        .scan(\"workspace-main\", DateTime::from_unix_seconds(20))\n        .expect(\"second expiry scan succeeds\");\n\n    assert_eq!(first.expired, 1);\n    assert_eq!(second.expired, 0);\n    assert_eq!(\n        fixture\n            .memory_store\n            .get_structured_fields(&expired_memory)\n            .expect(\"fields load\")\n            .expect(\"memory exists\")\n            .verification_status,\n        MemoryVerificationStatus::Expired\n    );\n}\n\n#[test]\nfn successful_verification_advances_last_verified_graph_snapshot_id() {\n    let fixture = Fixture::new();\n    let changed_file = fixture.file_id(\"src/auth.ts\", \"hash-auth\");\n    let graph = fixture.graph_with_files(&[(&changed_file, \"loginUser\", 12)]);\n    let file_index = fixture.file_index(&[(&changed_file, \"hash-auth\", 200)]);\n    let parsed_files = HashMap::new();\n    let reader = WorkspaceFileReader::new(fixture.workspace_root.clone());\n\n    let memory_id = fixture.seed_memory(\n        \"mem-verified\",\n        file_evidence(&changed_file.repo_relative_path),\n    );\n    let mut runtime = fixture.runtime();\n    let operator = operator();\n    let mut verifier = IncrementalVerifier::new(\n        &fixture.memory_store,\n        &mut runtime,\n        &graph,\n        &file_index,\n        &parsed_files,\n        &reader,\n        &fixture.event_writer,\n        &operator,\n        \"workspace-main\",\n        8,\n    );\n\n    let report = verifier\n        .on_graph_delta(4, 8, vec![changed_file])\n        .expect(\"verification succeeds\");\n\n    assert_eq!(report.verified, 1);\n    assert_eq!(\n        fixture\n            .memory_store\n            .get_last_verified_graph_snapshot_id(&memory_id)\n            .expect(\"snapshot id loads\"),\n        Some(8)\n    );\n}\n\n#[test]\nfn deleted_file_invalidates_verified_memory_on_next_delta() {\n    let fixture = Fixture::new();\n    let changed_file = fixture.file_id(\"src/auth.ts\", \"hash-auth\");\n    let parsed_files = HashMap::new();\n    let reader = WorkspaceFileReader::new(fixture.workspace_root.clone());\n\n    let memory_id = fixture.seed_memory(\n        \"mem-delete\",\n        file_evidence(&changed_file.repo_relative_path),\n    );\n    fixture.set_verification_status(&memory_id, MemoryVerificationStatus::Verified);\n    let empty_graph = CodeGraph::new();\n    let empty_file_index = HashMap::new();\n\n    let mut runtime = fixture.runtime();\n    let operator = operator();\n    let mut verifier = IncrementalVerifier::new(\n        &fixture.memory_store,\n        &mut runtime,\n        &empty_graph,\n        &empty_file_index,\n        &parsed_files,\n        &reader,\n        &fixture.event_writer,\n        &operator,\n        \"workspace-main\",\n        8,\n    );\n\n    let report = verifier\n        .on_graph_delta(8, 9, vec![changed_file])\n        .expect(\"verification succeeds\");\n\n    assert_eq!(report.invalidated, 1);\n    assert_eq!(\n        fixture\n            .memory_store\n            .get_structured_fields(&memory_id)\n            .expect(\"fields load\")\n            .expect(\"memory exists\")\n            .verification_status,\n        MemoryVerificationStatus::Invalidated\n    );\n}\n\n#[test]\nfn bounded_work_budget_reenqueues_remaining_memories() {\n    let fixture = Fixture::new();\n    let changed_file = fixture.file_id(\"src/auth.ts\", \"hash-auth\");\n    let graph = fixture.graph_with_files(&[(&changed_file, \"loginUser\", 12)]);\n    let file_index = fixture.file_index(&[(&changed_file, \"hash-auth\", 200)]);\n    let parsed_files = HashMap::new();\n    let reader = WorkspaceFileReader::new(fixture.workspace_root.clone());\n    let observer = CountingObserver::default();\n\n    for index in 0..1000 {\n        fixture.seed_memory(\n            &format!(\"mem-{index}\"),\n            file_evidence(&changed_file.repo_relative_path),\n        );\n    }\n\n    let mut runtime = fixture.runtime();\n    let operator = operator();\n    let mut verifier = IncrementalVerifier::new(\n        &fixture.memory_store,\n        &mut runtime,\n        &graph,\n        &file_index,\n        &parsed_files,\n        &reader,\n        &fixture.event_writer,\n        &operator,\n        \"workspace-main\",\n        50,\n    )\n    .with_observer(&observer);\n\n    let report = verifier\n        .on_graph_delta(1, 2, vec![changed_file])\n        .expect(\"delta verification succeeds\");\n\n    assert_eq!(report.impacted, 1000);\n    assert_eq!(report.verified, 50);\n    assert_eq!(report.queued_for_retry, 950);\n    assert_eq!(observer.memory_ids().len(), 50);\n}\n\n#[derive(Default)]\nstruct CountingObserver {\n    memory_ids: Mutex<Vec<String>>,\n}\n\nimpl CountingObserver {\n    fn memory_ids(&self) -> Vec<String> {\n        self.memory_ids.lock().expect(\"observer lock\").clone()\n    }\n}\n\nimpl VerificationObserver for CountingObserver {\n    fn on_verify(&self, memory_id: &str) {\n        self.memory_ids\n            .lock()\n            .expect(\"observer lock\")\n            .push(memory_id.to_string());\n    }\n}\n\nstruct Fixture {\n    _dir: tempfile::TempDir,\n    workspace_root: PathBuf,\n    memory_store: MemoryStore,\n    runtime_db: PathBuf,\n    _event_store: Arc<EventStore>,\n    event_writer: EventWriter,\n}\n\nimpl Fixture {\n    fn new() -> Self {\n        let dir = tempdir().expect(\"tempdir\");\n        let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store\"));\n        let event_writer =\n            EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n                .with_flush_policy(FlushPolicy::Sync);\n        Self {\n            workspace_root: dir.path().to_path_buf(),\n            memory_store: MemoryStore::open(&dir.path().join(\"memory.sqlite\"))\n                .expect(\"memory store\"),\n            runtime_db: dir.path().join(\"verification.sqlite\"),\n            _event_store: event_store,\n            event_writer,\n            _dir: dir,\n        }\n    }\n\n    fn runtime(&self) -> ConsolidationJobRuntime {\n        ConsolidationJobRuntime::new(\n            Connection::open(&self.runtime_db).expect(\"verification db opens\"),\n            ConsolidationConfig::default(),\n        )\n        .expect(\"runtime opens\")\n    }\n\n    fn seed_memory(&self, id: &str, evidence: MemoryEvidence) -> String {\n        let memory = Memory {\n            id: id.to_string(),\n            session_id: \"session-main\".to_string(),\n            content: format!(\"memory {id}\"),\n            memory_type: MemoryType::Observation,\n            scope: MemoryScope::Branch,\n            confidence: 0.9,\n            linked_symbols: Vec::new(),\n            linked_files: Vec::new(),\n            workspace_id: Some(\"workspace-main\".to_string()),\n            branch: Some(\"main\".to_string()),\n            scope_organization_id: None,\n            refresh_key: Some(format!(\"refresh-{id}\")),\n            source_query: Some(\"verification test\".to_string()),\n            created_at: 100,\n            last_accessed: 100,\n            access_count: 0,\n            is_stale: false,\n            stale_reason: None,\n            verification_status: crate::memory::MemoryVerificationStatus::Unverified,\n        };\n        let stored_id = self.memory_store.store(memory).expect(\"memory stores\");\n        let mut fields = MemoryStructuredFields::default();\n        fields.evidence = vec![evidence];\n        self.memory_store\n            .update_structured_fields(&stored_id, &fields)\n            .expect(\"fields update\");\n        stored_id\n    }\n\n    fn set_verification_status(&self, memory_id: &str, status: MemoryVerificationStatus) {\n        let mut fields = self\n            .memory_store\n            .get_structured_fields(memory_id)\n            .expect(\"fields load\")\n            .expect(\"memory exists\");\n        fields.verification_status = status;\n        self.memory_store\n            .update_structured_fields(memory_id, &fields)\n            .expect(\"fields update\");\n    }\n\n    fn file_id(&self, path: &str, content_hash: &str) -> FileId {\n        FileId {\n            workspace_id: \"workspace-main\".to_string(),\n            repo_relative_path: path.to_string(),\n            content_hash: content_hash.to_string(),\n        }\n    }\n\n    fn graph_with_files(&self, nodes: &[(&FileId, &str, usize)]) -> CodeGraph {\n        let mut graph = CodeGraph::new();\n        for (file_id, name, byte_offset) in nodes {\n            graph.add_node(\n                crate::symbols::SymbolId {\n                    file: file_id.repo_relative_path.clone(),\n                    name: (*name).to_string(),\n                    byte_offset: *byte_offset,\n                },\n                crate::symbols::SymbolKind::Function,\n                (*name).to_string(),\n                \"function\".to_string(),\n                String::new(),\n                file_id.repo_relative_path.clone(),\n                1,\n                1,\n                true,\n                Language::TypeScript,\n            );\n        }\n        graph\n    }\n\n    fn file_index(&self, files: &[(&FileId, &str, i64)]) -> HashMap<String, FileIndexEntry> {\n        files\n            .iter()\n            .map(|(file_id, content_hash, last_indexed_at)| {\n                (\n                    file_id.repo_relative_path.clone(),\n                    FileIndexEntry {\n                        file: file_id.repo_relative_path.clone(),\n                        content_hash: (*content_hash).to_string(),\n                        mtime_ns: 0,\n                        size_bytes: 128,\n                        parser_version: FILE_INDEX_PARSER_VERSION,\n                        schema_version: FILE_INDEX_SCHEMA_VERSION,\n                        last_indexed_at: *last_indexed_at,\n                    },\n                )\n            })\n            .collect()\n    }\n}\n\nfn operator() -> OperatorId {\n    OperatorId {\n        value: \"verification-bot\".to_string(),\n    }\n}\n\nfn file_evidence(path: &str) -> MemoryEvidence {\n    MemoryEvidence {\n        kind: \"file\".to_string(),\n        reference: Some(path.to_string()),\n        detail: None,\n        captured_at: Some(100),\n        span: None,\n        evidence_content_hash: None,\n    }\n}\n\nfn symbol_evidence(symbol_name: &str) -> MemoryEvidence {\n    MemoryEvidence {\n        kind: \"symbol\".to_string(),\n        reference: Some(symbol_name.to_string()),\n        detail: None,\n        captured_at: Some(100),\n        span: None,\n        evidence_content_hash: None,\n    }\n}\n","numLines":416,"startLine":1,"totalLines":416}}}
