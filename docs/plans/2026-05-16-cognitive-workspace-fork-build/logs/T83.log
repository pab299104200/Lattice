+        &[],
+        &[],
+        BundleMode::Compact,
+    );
+
+    assert!(capsule.pivots.is_empty(), "unexpected pivots: {:?}", capsule.pivots);
+    assert!(capsule.context.is_empty(), "unexpected context: {:?}", capsule.context);
+    assert!(
