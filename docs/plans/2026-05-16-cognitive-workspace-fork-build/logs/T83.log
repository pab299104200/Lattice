               attempted_workspace_id = scope.workspace_id.as_str(),\n2211\t                attempted_branch = scope.branch.as_ref().map(|branch| branch.name.as_str()),\n2212\t                memory_scope = memory.scope.as_str(),\n2213\t                \"scope_leak_blocked\"\n2214\t            );\n2215\t            self.record_scope_filtered(memory, scope)?;\n2216\t            Ok(())\n2217\t        }\n2218\t    }\n2219\t\n2220\t    fn record_scope_filtered(\n2221\t        &self,\n2222\t        memory: &Memory,\n2223\t        scope: &ScopeFilter,\n2224\t    ) -> Result<(), LatticeError> {\n2225\t        tracing::warn!(\n2226\t            memory_id = memory.id.as_str(),\n2227\t            attempted_workspace_id = scope.workspace_id.as_str(),\n2228\t            attempted_branch = scope.branch.as_ref().map(|branch| branch.name.as_str()),\n2229\t            memory_scope = memory.scope.as_str(),\n2230\t            \"scope_leak_blocked\"\n2231\t        );\n2232\t        self.conn\n2233\t            .execute(\n2234\t                \"INSERT INTO memory_scope_filter_events\n2235\t                    (memory_id, attempted_workspace_id, attempted_branch, memory_scope, created_at)\n2236\t                 VALUES (?1, ?2, ?3, ?4, ?5)\",\n2237\t                params![\n2238\t                    memory.id,\n2239\t                    scope.workspace_id,\n2240\t                    scope.branch.as_ref().map(|branch| branch.name.as_str()),\n2241\t                    memory.scope.as_str(),\n2242\t                    now_epoch_secs() as i64,\n2243\t                ],\n2244\t            )\n2245\t            .map_err(|e| {\n2246\t                LatticeError::Storage(format!(\"Failed to record memory scope filter event: {}\", e))\n2247\t            })?;\n2248\t        Ok(())\n2249\t    }\n2250\t\n2251\t    fn find_impacted_memory_ids_impl(\n2252\t        &self,\n2253\t        workspace_id: &str,\n2254\t        changed_files: &[String],\n2255\t        changed_symbols: &[String],\n2256\t   