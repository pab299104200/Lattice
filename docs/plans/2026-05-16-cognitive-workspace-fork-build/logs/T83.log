         &fixture.handler,\n112\t            \"tools/call\",\n113\t            json!({\"name\": tool_name, \"arguments\": {}}),\n114\t        )\n115\t        .await;\n116\t    }\n117\t\n118\t    let events = fixture.events();\n119\t    let called = events\n120\t        .iter()\n121\t        .filter(|event| event.kind == EventKind::ToolCalled)\n122\t        .count();\n123\t    let results = events\n124\t        .iter()\n125\t        .filter(|event| event.kind == EventKind::ToolResult)\n126\t        .count();\n127\t    assert_eq!(called, instrumented_tool_names().len());\n128\t    assert_eq!(results, instrumented_tool_names().len());\n129\t}\n130\t\n131\t#[test]\n132\tfn event_capture_new_rejects_workspace_mismatch() {\n133\t    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n134\t    let writer = Arc::new(EventWriter::new(store, \"workspace-a\".to_string(), 4096));\n135\t    let error = EventCapture::new(\n136\t        writer,\n137\t        \"workspace-b\".to_string(),\n138\t        \"main\".to_string(),\n139\t        SessionId {\n140\t            value: \"session-a\".to_string(),\n141\t        },\n142\t    )\n143\t    .expect_err(\"workspace mismatch is rejected\");\n144\t\n145\t    assert_eq!(\n146\t        error.to_string(),\n147\t        \"event capture workspace `workspace-b` does not match writer workspace `workspace-a`\"\n148\t    );\n149\t}\n150\t\n151\t#[test]\n152\tfn batched_flush_writer_records_multiple_tool_calls_for_same_session() {\n153\t    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n154\t    let writer = Arc::new(\n155\t        EventWriter::new(store.clone(), \"workspace-a\".to_string(), 4096)\n156\t            .with_flush_policy(FlushPolicy::Batched { interval_ms: 250 }),\n157\t    );\n158\t    let capture = EventCapture::new(\n159\t        writer,\n160\t        \"workspace-a\".to_string(),\n161\t        \"main\".to_string(),\n162\t        SessionId {\n163\t            value: 