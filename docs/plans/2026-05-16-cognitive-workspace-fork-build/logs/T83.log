> self.tool_find_stale_docs(arguments).await,\n1398\t                \"diagnose_failure\" => self.tool_diagnose_failure(arguments).await,\n1399\t                \"record_workflow_outcome\" => self.tool_record_workflow_outcome(arguments).await,\n1400\t                \"expand_context\" => self.tool_expand_context(arguments).await,\n1401\t                \"get_symbol\" => self.tool_get_symbol(arguments).await,\n1402\t                \"get_dependents\" => self.tool_get_dependents(arguments).await,\n1403\t                \"get_dependencies\" => self.tool_get_dependencies(arguments).await,\n1404\t                \"get_impact_graph\" | \"blast_radius\" => self.tool_blast_radius(arguments).await,\n1405\t                \"search_symbols\" => self.tool_search_symbols(arguments).await,\n1406\t                \"get_skeleton\" | \"get_file_context\" => self.tool_get_file_context(arguments).await,\n1407\t                \"save_observation\" | \"store_memory\" => self.tool_store_memory(arguments).await,\n1408\t                \"get_session_context\" => self.tool_get_session_context(arguments).await,\n1409\t                \"search_memory\" | \"recall_memories\" => self.tool_search_memory(arguments).await,\n1410\t                \"list_observations\" => self.tool_list_observations(arguments).await,\n1411\t                \"list_stale_memories\" => self.tool_list_stale_memories(arguments).await,\n1412\t                \"promote_observation\" => self.tool_promote_observation(arguments).await,\n1413\t                \"refresh_memory\" => self.tool_refresh_memory(arguments).await,\n1414\t                \"delete_observation\" => self.tool_delete_observation(arguments).await,\n1415\t                \"update_observation\" => self.tool_update_observation(arguments).await,\n1416\t                \"search_logic_flow\" => self.tool_search_logic_flow(arguments).await,\n1417\t                \"submit_lsp_edges\" => self.tool_submit_lsp_edges(arguments).await,\n1418\t                \"workspace_setup\" => self.tool_workspace_setup(arguments).await,\n1419\t                \"index_status\" => self.tool_index_status(arguments).await,\n1420\t                \"get_session_metrics\" => self.tool_get_session_metrics(arguments).await,\n1421\t                \"get_project_rules\" => self.tool_get_project_rules(arguments).await,\n1422\t                _ => Err((-32602, format!(\"Unknown tool: {}\", tool_name))),\n1423\t            }\n1424\t        }\n1425\t        .instrument(span)\n1426\t        .await;\n1427\t\n1428\t        if let Ok(ref value) = result {\n1429\t            if tool_name != \"get_session_metrics\" {\n1430\t                self.record_tool_metrics(tool_name, value).await;\n1431\t            }\n1432\t        }\n1433\t        self.capture_tool_result(tool_name, &result, tool_called_event);\n1434\t\n1435\t        result\n1436\t    }\n1437\t\n1438\t    fn capture_tool_called(\n1439\t        &self,"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"d55ce210-da4a-44a0-aa2f-e7f3055ef0c2","timestamp":"2026-05-17T05:59:17.499Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/mcp.rs","content":"                }\n            ]\n        })\n    }\n\n    async fn handle_tools_call(&self, params: &Value) -> Result<Value, (i32, String)> {\n        let tool_name = params[\"name\"]\n            .as_str()\n            .ok_or((-32602, \"Missing tool name\".to_string()))?;\n        let arguments = &params[\"arguments\"];\n        let span = tracing::info_span!(\"tool\", name = tool_name);\n        let tool_called_event = self.capture_tool_called(tool_name, arguments);\n\n        let result = async {\n            match tool_name {\n                \"get_context_capsule\" | \"query_context\" => self.tool_query_context(arguments).await,\n                \"prepare_change\" => self.tool_prepare_change(arguments).await,\n                \"plan_edit\" => self.tool_plan_edit(arguments).await,\n                \"trace_scenario\" => self.tool_trace_scenario(arguments).await,\n                \"find_relevant_tests\" => self.tool_find_relevant_tests(arguments).await,\n                \"impact_from_diff\" => self.tool_impact_from_diff(arguments).await,\n                \"get_working_set_context\" => self.tool_get_working_set_context(arguments).await,\n                \"summarize_subsystem\" => self.tool_summarize_subsystem(arguments).await,\n                \"get_repo_playbook\" => self.tool_get_repo_playbook(arguments).await,\n                \"get_docs_capsule\" => self.tool_get_docs_capsule(arguments).await,\n                \"get_backlinks\" => self.tool_get_backlinks(arguments).await,\n                \"get_outgoing_links\" => self.tool_get_outgoing_links(arguments).await,\n                \"find_stale_docs\" => self.tool_find_stale_docs(arguments).await,\n                \"diagnose_failure\" => self.tool_diagnose_failure(arguments).await,\n                \"record_workflow_outcome\" => self.tool_record_workflow_outcome(arguments).await,\n                \"expand_context\" => self.tool_expand_context(arguments).await,\n                \"get_symbol\" => self.tool_get_symbol(arguments).await,\n                \"get_dependents\" => self.tool_get_dependents(arguments).await,\n                \"get_dependencies\" => self.tool_get_dependencies(arguments).await,\n                \"get_impact_graph\" | \"blast_radius\" => self.tool_blast_radius(arguments).await,\n                \"search_symbols\" => self.tool_search_symbols(arguments).await,\n                \"get_skeleton\" | \"get_file_context\" => self.tool_get_file_context(arguments).await,\n                \"save_observation\" | \"store_memory\" => self.tool_store_memory(arguments).await,\n                \"get_session_context\" => self.tool_get_session_context(arguments).await,\n                \"search_memory\" | \"recall_memories\" => self.tool_search_memory(arguments).await,\n                \"list_observations\" => self.tool_list_observations(arguments).await,\n                \"list_stale_memories\" => self.tool_list_stale_memories(arguments).await,\n                \"promote_observation\" => self.tool_promote_observation(arguments).await,\n                \"refresh_memory\" => self.tool_refresh_memory(arguments).await,\n                \"delete_observation\" => self.tool_delete_observation(arguments).await,\n                \"update_observation\" => self.tool_update_observation(arguments).await,\n                \"search_logic_flow\" => self.tool_search_logic_flow(arguments).await,\n                \"submit_lsp_edges\" => self.tool_submit_lsp_edges(arguments).await,\n                \"workspace_setup\" => self.tool_workspace_setup(arguments).await,\n                \"index_status\" => self.tool_index_status(arguments).await,\n                \"get_session_metrics\" => self.tool_get_session_metrics(arguments).await,\n                \"get_project_rules\" => self.tool_get_project_rules(arguments).await,\n                _ => Err((-32602, format!(\"Unknown tool: {}\", tool_name))),\n            }\n        }\n        .instrument(span)\n        .await;\n\n        if let Ok(ref value) = result {\n            if tool_name != \"get_session_metrics\" {\n                self.record_tool_metrics(tool_name, value).await;\n            }\n        }\n        self.capture_tool_result(tool_name, &result, tool_called_event);\n\n        result\n    }\n\n    fn capture_tool_called(\n        &self,","numLines":70,"startLine":1370,"totalLines":9309}}}
docs/plans/2026-05-16-cognitive-workspace-fork-build/logs/R18.log:132:{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013JbHMH8fLduC4W4Jq9oicM","type":"tool_result","content":"1\t# Event Log Capture And Compaction\n2\t\n3\tThis note records the Phase 2 MCP event-capture contract. The compaction snapshot\n4\tformat and scheduler are owned by T16; this section is intentionally limited to\n5\tthe event sequences emitted by T15 so later compaction and retrieval work can\n6\tdepend on stable history.\n7\t\n8\t## MCP Capture Sequence\n9\t\n10\tEvery `tools/call` dispatched through `McpHandler::handle_tools_call` emits:\n11\t\n12\t1. `AssistantTaskStarted` once for the session task.\n13\t2. `ToolCalled` before dispatch, with the tool name and compact input summary.\n14\t3. `ToolResult` after dispatch, including structured success or error status.\n15\t4. `WorkflowSucceeded` or `WorkflowFailed` for the terminal workflow outcome.\n16\t\n17\tTool errors still return through JSON-RPC unchanged. Capture write errors are\n18\tlogged with `tracing::warn!` and do not mask the tool result.\n19\t\n20\t## Tool Event Matrix\n21\t\n22\tAll currently dispatched MCP tools emit the base sequence above, including:\n23\t\n24\t- Workflow bundles: `get_context_capsule`, `prepare_change`, `plan_edit`,\n25\t  `trace_scenario`, `impact_from_diff`, `get_working_set_context`,\n26\t  `summarize_subsystem`, `get_repo_playbook`, `get_docs_capsule`,\n27\t  `diagnose_failure`, `expand_context`.\n28\t- Discovery and graph tools: `find_relevant_tests`, `get_backlinks`,\n29\t  `get_outgoing_links`, `find_stale_docs`, `get_symbol`, `get_dependents`,\n30\t  `get_dependencies`, `get_impact_graph`, `search_symbols`, `get_skeleton`,\n31\t  `search_logic_flow`, `submit_lsp_edges`, `workspace_setup`, `index_status`,\n32\t  `get_project_rules`.\n33\t- Memory tools: `record_workflow_outcome`, `save_observation`,\n34\t  `get_session_context`, `search_memory`, `list_observations`,\n35\t  `list_stale_memories`, `promote_observation`, `refresh_memory`,\n36\t  `delete_observation`, `update_observation`.\n37\t- Session surface: `get_session_metrics`.\n38\t\n39\tTools that return a stable context handle additionally emit\n40\t`ContextBundleReturned`. Tools that materialize memory ids in the returned\n41\tpayload emit `MemoryRetrieved`. `plan_edit` emits `PlanCreated`.\n42\t\n43\t## Durability And Hot Path\n44\t\n45\t`ToolCalled`, `ToolResult`, and context bundle events use the batched writer\n46\tpolicy to avoid adding synchronous fsync latency to hot-path tools. Terminal\n47\tworkflow and memory lifecycle events use synchronous flushes so downstream\n48\thistory consumers can rely on the outcome before proceeding.\n49\t\n50\t## Workspace Scope\n51\t\n52\t`EventCapture::new` rejects writer/session workspace mismatches. Events are\n53\twritten with the session id assigned at daemon startup and the workspace id of\n54\tthe active root, so later readers can scope history by workspace and session\n55\twithout relying on transient tool names or process-local handles.\n56\t\n57\t## Phase 2 Budget Evidence\n58\t\n59\tT17 adds ignored measurement-mode tests in\n60\t`daemon/crates/lattice-core/src/events/budget_tests.rs` and writes the captured\n61\tartifacts to `daemon/target/event_budget/`.\n62\t\n63\t### Measurement environment\n64\t\n65\t- CPU: Intel(R) Core(TM) i7-10610U CPU @ 1.80GHz\n66\t- Store mode: in-memory SQLite\n67\t- Writer mode: append-only `EventWriter::append` with\n68\t  `FlushPolicy::Batched { interval_ms: 250 }`\n69\t- SQLite semantics under this harness: `journal_mode=MEMORY`,\n70\t  `synchronous=NORMAL`\n71\t- Concurrency control: the ignored budget tests serialize themselves with a\n72\t  global mutex so each case measures the writer hot path instead of benchmark\n73\t  self-contention\n74\t\n75\t### Captured P99 results\n76\t\n77\t- `prepare_change`: payload 1514 bytes, 10_000 measured iterations,\n78\t  P50 664 us, P95 801 us, P99 3710 us\n79\t- `get_context_capsule`: payload 383 bytes, 10_000 measured iterations,\n80\t  P50 289 us, P95 353 us, P99 3314 us\n81\t- `prepare_change` spill path: payload 586 bytes with inline ceiling 256 bytes,\n82\t  2_000 measured iterations, P50 361 us, P95 3380 us, P99 3427 us\n83\t\n84\t### Notes on the passing configuration\n85\t\n86\t- The writer now hashes the already-serialized payload bytes instead of\n87\t  canonicalizing the same typed payload twice on every append.\n88\t- Spilled payload writes reuse a per-writer row-id cache keyed by payload hash so\n89\t  repeated large payloads do not re-hit the side-table lookup path after warmup.\n90\t- The reader replay path now orders streamed reads by append-only `event_id`,\n91\t  which aligns the public replay contract with the storage substrate’s total\n92\t  order.\n93\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"c5d2df30-6366-4b65-91a7-ea7eb8296694","timestamp":"2026-05-17T05:59:37.562Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/docs/architecture/2026-05-16-event-log-compaction.md","content":"# Event Log Capture And Compaction\n\nThis note records the Phase 2 MCP event-capture contract. The compaction snapshot\nformat and scheduler are owned by T16; this section is intentionally limited to\nthe event sequences emitted by T15 so later compaction and retrieval work can\ndepend on stable history.\n\n## MCP Capture Sequence\n\nEvery `tools/call` dispatched through `McpHandler::handle_tools_call` emits:\n\n1. `AssistantTaskStarted` once for the session task.\n2. `ToolCalled` before dispatch, with the tool name and compact input summary.\n3. `ToolResult` after dispatch, including structured success or error status.\n4. `WorkflowSucceeded` or `WorkflowFailed` for the terminal workflow outcome.\n\nTool errors still return through JSON-RPC unchanged. Capture write errors are\nlogged with `tracing::warn!` and do not mask the tool result.\n\n## Tool Event Matrix\n\nAll currently dispatched MCP tools emit the base sequence above, including:\n\n- Workflow bundles: `get_context_capsule`, `prepare_change`, `plan_edit`,\n  `trace_scenario`, `impact_from_diff`, `get_working_set_context`,\n  `summarize_subsystem`, `get_repo_playbook`, `get_docs_capsule`,\n  `diagnose_failure`, `expand_context`.\n- Discovery and graph tools: `find_relevant_tests`, `get_backlinks`,\n  `get_outgoing_links`, `find_stale_docs`, `get_symbol`, `get_dependents`,\n  `get_dependencies`, `get_impact_graph`, `search_symbols`, `get_skeleton`,\n  `search_logic_flow`, `submit_lsp_edges`, `workspace_setup`, `index_status`,\n  `get_project_rules`.\n- Memory tools: `record_workflow_outcome`, `save_observation`,\n  `get_session_context`, `search_memory`, `list_observations`,\n  `list_stale_memories`, `promote_observation`, `refresh_memory`,\n  `delete_observation`, `update_observation`.\n- Session surface: `get_session_metrics`.\n\nTools that return a stable context handle additionally emit\n`ContextBundleReturned`. Tools that materialize memory ids in the returned\npayload emit `MemoryRetrieved`. `plan_edit` emits `PlanCreated`.\n\n## Durability And Hot Path\n\n`ToolCalled`, `ToolResult`, and context bundle events use the batched writer\npolicy to avoid adding synchronous fsync latency to hot-path tools. Terminal\nworkflow and memory lifecycle events use synchronous flushes so downstream\nhistory consumers can rely on the outcome before proceeding.\n\n## Workspace Scope\n\n`EventCapture::new` rejects writer/session workspace mismatches. Events are\nwritten with the session id assigned at daemon startup and the workspace id of\nthe active root, so later readers can scope history by workspace and session\nwithout relying on transient tool names or process-local handles.\n\n## Phase 2 Budget Evidence\n\nT17 adds ignored measurement-mode tests in\n`daemon/crates/lattice-core/src/events/budget_tests.rs` and writes the captured\nartifacts to `daemon/target/event_budget/`.\n\n### Measurement environment\n\n- CPU: Intel(R) Core(TM) i7-10610U CPU @ 1.80GHz\n- Store mode: in-memory SQLite\n- Writer mode: append-only `EventWriter::append` with\n  `FlushPolicy::Batched { interval_ms: 250 }`\n- SQLite semantics under this harness: `journal_mode=MEMORY`,\n  `synchronous=NORMAL`\n- Concurrency control: the ignored budget tests serialize themselves with a\n  global mutex so each case measures the writer hot path instead of benchmark\n  self-contention\n\n### Captured P99 results\n\n- `prepare_change`: payload 1514 bytes, 10_000 measured iterations,\n  P50 664 us, P95 801 us, P99 3710 us\n- `get_context_capsule`: payload 383 bytes, 10_000 measured iterations,\n  P50 289 us, P95 353 us, P99 3314 us\n- `prepare_change` spill path: payload 586 bytes with inline ceiling 256 bytes,\n  2_000 measured iterations, P50 361 us, P95 3380 us, P99 3427 us\n\n### Notes on the passing configuration\n\n- The writer now hashes the already-serialized payload bytes instead of\n  canonicalizing the same typed payload twice on every append.\n- Spilled payload writes reuse a per-writer row-id cache keyed by payload hash so\n  repeated large payloads do not re-hit the side-table lookup path after warmup.\n- The reader replay path now orders streamed reads by append-only `event_id`,\n  which aligns the public replay contract with the storage substrate’s total\n  order.\n","numLines":93,"startLine":1,"totalLines":93}}}
