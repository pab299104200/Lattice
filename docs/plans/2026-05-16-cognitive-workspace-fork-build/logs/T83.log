+#[test]
+fn test_branch_and_session_scoped_memories_do_not_leak() {
+    let store = MemoryStore::open_in_memory().expect("memory store");
+    store
+        .store(scoped_memory(
+            "session-a",
+            MemoryScope::Branch,
+            Some("workspace-a"),
+            Some("main"),
+            None,
+            "branch memory main",
+        ))
+        .expect("branch memory stores");
+    store
