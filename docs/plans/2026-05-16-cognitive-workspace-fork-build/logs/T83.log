#[test]
fn test_branch_scope_never_leaks_across_branches() {
    let store = TestMemoryStore::open();
    store.insert_memory(
        "branch-a-memory",
        MemoryScope::Branch,
        None,
        Some("feature/a"),
        Some("workspace-1"),
        None,
        None,
        "feature A memory",
    );
    store.insert_memory(
        "branch-b-memory",
        MemoryScope::Branch,
        None,
        Some("feature/b"),
        Some("workspace-1"),
        None,
        None,
        "feature B memory",
    );

