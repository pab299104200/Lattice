+            .is_empty(),
+        "branch-scoped memories from main must not leak into feature/x"
+    );
+    assert!(
+        store
+            .list_all_scoped(&session_scope)
+            .expect("session query succeeds")
+            .is_empty(),
+        "session-scoped memories from session-s1 must not leak into session-s2"
+    );
+}
