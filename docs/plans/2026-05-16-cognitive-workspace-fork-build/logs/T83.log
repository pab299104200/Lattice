docs/plans/2026-05-16-cognitive-workspace-fork-build/logs/R54.log:22:{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QXXTSrKqBiSocyweBLZTnJ","type":"tool_result","content":"1\t//! Verification engine core for durable memory evidence.\n2\t//!\n3\t//! This module implements the verifier contract from\n4\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## 8. Verification Engine`,\n6\t//! `## Phase 7: Verification And Freshness`, and\n7\t//! `## Storage Design`.\n8\t//!\n9\t//! Verification checks:\n10\t//!\n11\t//! - linked files still exist\n12\t//! - linked symbols still exist\n13\t//! - cited docs still exist\n14\t//! - linked tests still exist\n15\t//! - evidence text still matches when exact spans were captured\n16\t//! - implementation still matches memory claim where deterministic checks are possible\n17\t//! - contradicted/superseded states remain coherent\n18\t//! - branch-scoped memory is not leaking into unrelated branches\n19\t//! - time-bound memory has expired\n20\t//!\n21\t//! Verification outputs:\n22\t//!\n23\t//! - `verified`\n24\t//! - `unverified`\n25\t//! - `in_review`\n26\t//! - `stale`\n27\t//! - `contradicted`\n28\t//! - `superseded`\n29\t//! - `expired`\n30\t//! - `invalidated`\n31\t\n32\tuse std::fmt;\n33\tuse std::str::FromStr;\n34\t\n35\tuse rusqlite::Connection;\n36\tuse serde::{Deserialize, Serialize};\n37\t\n38\tuse crate::error::LatticeError;\n39\t\n40\tpub mod existence;\n41\tpub mod expiry;\n42\tpub mod incremental;\n43\tpub mod scope_enforcement;\n44\tpub mod spans;\n45\tpub mod surfacing;\n46\t\n47\t#[cfg(test)]\n48\tmod existence_tests;\n49\t#[cfg(test)]\n50\tmod incremental_tests;\n51\t#[cfg(test)]\n52\tmod integration_tests;\n53\t#[cfg(test)]\n54\tmod scope_leak_tests;\n55\t#[cfg(test)]\n56\tmod spans_tests;\n57\t#[cfg(test)]\n58\tmod surfacing_tests;\n59\t\n60\tpub use existence::{\n61\t    VerificationError, VerificationOutcome, VerifierBudget, VerifierCore, VerifierReport,\n62\t};\n63\tpub use expiry::{ExpiryError, ExpiryReport, ExpiryScanner};\n64\tpub use incremental::{\n65\t    IncrementalError, IncrementalReport, IncrementalVerifier, VerificationObserver,\n66\t};\n67\tpub use scope_enforcement::{\n68\t    allows, MemoryScopeFilteredEvent, OrganizationId, ScopeEnforcement, ScopeFilter,\n69\t    ScopeFilterError,\n70\t};\n71\tpub use spans::{\n72\t    SpanMismatch, SpanMismatchReason, SpanReader, SpanValidationError, SpanValidator,\n73\t    WorkspaceFileReader,\n74\t};\n75\tpub use surfacing::{\n76\t    classify_status, BundleProducer, BundleSection, LabeledMemory, SurfacedBundle, SurfacingError,\n77\t    SurfacingPipeline,\n78\t};\n79\t\n80\tconst VERIFICATION_SCHEMA_SQL: &str = include_str!(\"schema.sql\");\n81\t\n82\tpub fn initialize_schema(conn: &Connection) -> Result<(), LatticeError> {\n83\t    conn.execute_batch(VERIFICATION_SCHEMA_SQL)\n84\t        .map_err(|error| {\n85\t            LatticeError::Storage(format!(\"Failed to initialize verification schema: {error}\"))\n86\t        })?;\n87\t    Ok(())\n88\t}\n89\t\n90\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n91\t#[serde(rename_all = \"snake_case\")]\n92\tpub enum VerificationStatus {\n93\t    Verified,\n94\t    Unverified,\n95\t    InReview,\n96\t    Stale,\n97\t    Contradicted,\n98\t    Superseded,\n99\t    Expired,\n100\t    Invalidated,\n101\t}\n102\t\n103\timpl VerificationStatus {\n104\t    pub const VALUES: &'static [&'static str] = &[\n105\t        \"verified\",\n106\t        \"unverified\",\n107\t        \"in_review\",\n108\t        \"stale\",\n109\t        \"contradicted\",\n110\t        \"superseded\",\n111\t        \"expired\",\n112\t        \"invalidated\",\n113\t    ];\n114\t\n115\t    pub fn as_str(self) -> &'static str {\n116\t        match self {\n117\t            Self::Verified => \"verified\",\n118\t            Self::Unverified => \"unverified\",\n119\t            Self::InReview => \"in_review\",\n120\t            Self::Stale => \"stale\",\n121\t            Self::Contradicted => \"contradicted\",\n122\t            Self::Superseded => \"superseded\",\n123\t            Self::Expired => \"expired\",\n124\t            Self::Invalidated => \"invalidated\",\n125\t        }\n126\t    }\n127\t}\n128\t\n129\timpl fmt::Display for VerificationStatus {\n130\t    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n131\t        formatter.write_str(self.as_str())\n132\t    }\n133\t}\n134\t\n135\timpl FromStr for VerificationStatus {\n136\t    type Err = LatticeError;\n137\t\n138\t    fn from_str(value: &str) -> Result<Self, Self::Err> {\n139\t        match value {\n140\t            \"verified\" => Ok(Self::Verified),\n141\t            \"unverified\" => Ok(Self::Unverified),\n142\t            \"in_review\" => Ok(Self::InReview),\n143\t            \"stale\" => Ok(Self::Stale),\n144\t            \"contradicted\" => Ok(Self::Contradicted),\n145\t            \"superseded\" => Ok(Self::Superseded),\n146\t            \"expired\" => Ok(Self::Expired),\n147\t            \"invalidated\" => Ok(Self::Invalidated),\n148\t            other => Err(LatticeError::Storage(format!(\n149\t                \"Unknown verification status '{other}'\"\n150\t            ))),\n151\t        }\n152\t    }\n153\t}\n154\t\n155\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n156\tpub struct VerificationVerdict {\n157\t    pub status: VerificationStatus,\n158\t    pub reason: String,\n159\t}\n160\t\n161\timpl VerificationVerdict {\n162\t    pub fn new(status: VerificationStatus, reason: impl Into<String>) -> Self {\n163\t        Self {\n164\t            status,\n165\t            reason: reason.into(),\n166\t        }\n167\t    }\n168\t}\n169\t"}]},"parent_tool_use_id":null,"session_id":"0696e093-0770-442b-8dc9-5393bbfcd0b6","uuid":"29e62d6f-12a4-4e12-83c8-f838cffebd3f","timestamp":"2026-05-17T13:01:31.326Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/mod.rs","content":"//! Verification engine core for durable memory evidence.\n//!\n//! This module implements the verifier contract from\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 8. Verification Engine`,\n//! `## Phase 7: Verification And Freshness`, and\n//! `## Storage Design`.\n//!\n//! Verification checks:\n//!\n//! - linked files still exist\n//! - linked symbols still exist\n//! - cited docs still exist\n//! - linked tests still exist\n//! - evidence text still matches when exact spans were captured\n//! - implementation still matches memory claim where deterministic checks are possible\n//! - contradicted/superseded states remain coherent\n//! - branch-scoped memory is not leaking into unrelated branches\n//! - time-bound memory has expired\n//!\n//! Verification outputs:\n//!\n//! - `verified`\n//! - `unverified`\n//! - `in_review`\n//! - `stale`\n//! - `contradicted`\n//! - `superseded`\n//! - `expired`\n//! - `invalidated`\n\nuse std::fmt;\nuse std::str::FromStr;\n\nuse rusqlite::Connection;\nuse serde::{Deserialize, Serialize};\n\nuse crate::error::LatticeError;\n\npub mod existence;\npub mod expiry;\npub mod incremental;\npub mod scope_enforcement;\npub mod spans;\npub mod surfacing;\n\n#[cfg(test)]\nmod existence_tests;\n#[cfg(test)]\nmod incremental_tests;\n#[cfg(test)]\nmod integration_tests;\n#[cfg(test)]\nmod scope_leak_tests;\n#[cfg(test)]\nmod spans_tests;\n#[cfg(test)]\nmod surfacing_tests;\n\npub use existence::{\n    VerificationError, VerificationOutcome, VerifierBudget, VerifierCore, VerifierReport,\n};\npub use expiry::{ExpiryError, ExpiryReport, ExpiryScanner};\npub use incremental::{\n    IncrementalError, IncrementalReport, IncrementalVerifier, VerificationObserver,\n};\npub use scope_enforcement::{\n    allows, MemoryScopeFilteredEvent, OrganizationId, ScopeEnforcement, ScopeFilter,\n    ScopeFilterError,\n};\npub use spans::{\n    SpanMismatch, SpanMismatchReason, SpanReader, SpanValidationError, SpanValidator,\n    WorkspaceFileReader,\n};\npub use surfacing::{\n    classify_status, BundleProducer, BundleSection, LabeledMemory, SurfacedBundle, SurfacingError,\n    SurfacingPipeline,\n};\n\nconst VERIFICATION_SCHEMA_SQL: &str = include_str!(\"schema.sql\");\n\npub fn initialize_schema(conn: &Connection) -> Result<(), LatticeError> {\n    conn.execute_batch(VERIFICATION_SCHEMA_SQL)\n        .map_err(|error| {\n            LatticeError::Storage(format!(\"Failed to initialize verification schema: {error}\"))\n        })?;\n    Ok(())\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum VerificationStatus {\n    Verified,\n    Unverified,\n    InReview,\n    Stale,\n    Contradicted,\n    Superseded,\n    Expired,\n    Invalidated,\n}\n\nimpl VerificationStatus {\n    pub const VALUES: &'static [&'static str] = &[\n        \"verified\",\n        \"unverified\",\n        \"in_review\",\n        \"stale\",\n        \"contradicted\",\n        \"superseded\",\n        \"expired\",\n        \"invalidated\",\n    ];\n\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::Verified => \"verified\",\n            Self::Unverified => \"unverified\",\n            Self::InReview => \"in_review\",\n            Self::Stale => \"stale\",\n            Self::Contradicted => \"contradicted\",\n            Self::Superseded => \"superseded\",\n            Self::Expired => \"expired\",\n            Self::Invalidated => \"invalidated\",\n        }\n    }\n}\n\nimpl fmt::Display for VerificationStatus {\n    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n        formatter.write_str(self.as_str())\n    }\n}\n\nimpl FromStr for VerificationStatus {\n    type Err = LatticeError;\n\n    fn from_str(value: &str) -> Result<Self, Self::Err> {\n        match value {\n            \"verified\" => Ok(Self::Verified),\n            \"unverified\" => Ok(Self::Unverified),\n            \"in_review\" => Ok(Self::InReview),\n            \"stale\" => Ok(Self::Stale),\n            \"contradicted\" => Ok(Self::Contradicted),\n            \"superseded\" => Ok(Self::Superseded),\n            \"expired\" => Ok(Self::Expired),\n            \"invalidated\" => Ok(Self::Invalidated),\n            other => Err(LatticeError::Storage(format!(\n                \"Unknown verification status '{other}'\"\n            ))),\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct VerificationVerdict {\n    pub status: VerificationStatus,\n    pub reason: String,\n}\n\nimpl VerificationVerdict {\n    pub fn new(status: VerificationStatus, reason: impl Into<String>) -> Self {\n        Self {\n            status,\n            reason: reason.into(),\n        }\n    }\n}\n","numLines":169,"startLine":1,"totalLines":169}}}
docs/plans/2026-05-16-cognitive-workspace-fork-build/logs/R54.log:34:{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pshz1jeayVzXn4Sgtbb1cp","type":"tool_result","content":"1\t//! Exact-span verification for durable memory evidence.\n2\t//!\n3\t//! This module implements the verifier contract from\n4\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## 8. Verification Engine` and\n6\t//! `## Non-Negotiable Product Properties`.\n7\t//!\n8\t//! Verification checks:\n9\t//!\n10\t//! - evidence text still matches when exact spans were captured\n11\t//!\n12\t//! Non-negotiable product property:\n13\t//!\n14\t//! - Every stale or contradicted memory is surfaced as such, not hidden behind recency.\n15\t\n16\tuse std::fs::File;\n17\tuse std::io::{BufRead, BufReader, Read, Seek, SeekFrom};\n18\tuse std::path::{Path, PathBuf};\n19\t\n20\tuse serde::{Deserialize, Serialize};\n21\tuse sha2::{Digest, Sha256};\n22\t\n23\tuse super::{VerificationStatus, VerificationVerdict};\n24\tuse crate::error::LatticeError;\n25\tuse crate::identity::FileId;\n26\tuse crate::memory::{EvidenceSpan, MemoryEvidence};\n27\t\n28\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n29\tpub enum SpanMismatch {\n30\t    ContentChanged,\n31\t    FileShrunkBelowSpan,\n32\t    EncodingChanged,\n33\t    FileMissing,\n34\t}\n35\t\n36\timpl SpanMismatch {\n37\t    pub fn as_str(self) -> &'static str {\n38\t        match self {\n39\t            Self::ContentChanged => \"ContentChanged\",\n40\t            Self::FileShrunkBelowSpan => \"FileShrunkBelowSpan\",\n41\t            Self::EncodingChanged => \"EncodingChanged\",\n42\t            Self::FileMissing => \"FileMissing\",\n43\t        }\n44\t    }\n45\t\n46\t    fn status(self) -> VerificationStatus {\n47\t        match self {\n48\t            Self::FileMissing => VerificationStatus::Invalidated,\n49\t            Self::ContentChanged | Self::FileShrunkBelowSpan | Self::EncodingChanged => {\n50\t                VerificationStatus::Stale\n51\t            }\n52\t        }\n53\t    }\n54\t}\n55\t\n56\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n57\tpub struct SpanMismatchReason {\n58\t    pub kind: String,\n59\t    pub subkind: String,\n60\t    pub evidence_id: String,\n61\t}\n62\t\n63\timpl SpanMismatchReason {\n64\t    pub fn new(evidence_id: impl Into<String>, subkind: SpanMismatch) -> Self {\n65\t        Self {\n66\t            kind: \"SpanMismatch\".to_string(),\n67\t            subkind: subkind.as_str().to_string(),\n68\t            evidence_id: evidence_id.into(),\n69\t        }\n70\t    }\n71\t\n72\t    pub fn to_json(&self) -> String {\n73\t        serde_json::to_string(self).unwrap_or_else(|_| {\n74\t            format!(\n75\t                r#\"{{\"kind\":\"SpanMismatch\",\"subkind\":\"{}\",\"evidence_id\":\"{}\"}}\"#,\n76\t                self.subkind, self.evidence_id\n77\t            )\n78\t        })\n79\t    }\n80\t}\n81\t\n82\t#[derive(Debug, thiserror::Error)]\n83\tpub enum SpanValidationError {\n84\t    #[error(\"invalid evidence span `{byte_start}..{byte_end}`\")]\n85\t    InvalidSpan { byte_start: u32, byte_end: u32 },\n86\t    #[error(\"failed to read `{path}`: {source}\")]\n87\t    ReadFailed {\n88\t        path: String,\n89\t        #[source]\n90\t        source: std::io::Error,\n91\t    },\n92\t    #[error(transparent)]\n93\t    Storage(#[from] LatticeError),\n94\t}\n95\t\n96\tpub trait SpanReader {\n97\t    fn file_len(&self, file_id: &FileId) -> Result<Option<u64>, SpanValidationError>;\n98\t    fn read_range(\n99\t        &self,\n100\t        file_id: &FileId,\n101\t        start: u32,\n102\t        end: u32,\n103\t    ) -> Result<Option<Vec<u8>>, SpanValidationError>;\n104\t    fn read_line_span(\n105\t        &self,\n106\t        file_id: &FileId,\n107\t        line_start: u32,\n108\t        line_end: u32,\n109\t    ) -> Result<Option<Vec<u8>>, SpanValidationError>;\n110\t}\n111\t\n112\tpub struct WorkspaceFileReader {\n113\t    workspace_root: PathBuf,\n114\t}\n115\t\n116\timpl WorkspaceFileReader {\n117\t    pub fn new(workspace_root: impl Into<PathBuf>) -> Self {\n118\t        Self {\n119\t            workspace_root: workspace_root.into(),\n120\t        }\n121\t    }\n122\t\n123\t    fn path_for(&self, file_id: &FileId) -> PathBuf {\n124\t        self.workspace_root.join(&file_id.repo_relative_path)\n125\t    }\n126\t}\n127\t\n128\timpl SpanReader for WorkspaceFileReader {\n129\t    fn file_len(&self, file_id: &FileId) -> Result<Option<u64>, SpanValidationError> {\n130\t        let path = self.path_for(file_id);\n131\t        match std::fs::metadata(&path) {\n132\t            Ok(metadata) => Ok(Some(metadata.len())),\n133\t            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),\n134\t            Err(error) => Err(read_failed(&path, error)),\n135\t        }\n136\t    }\n137\t\n138\t    fn read_range(\n139\t        &self,\n140\t        file_id: &FileId,\n141\t        start: u32,\n142\t        end: u32,\n143\t    ) -> Result<Option<Vec<u8>>, SpanValidationError> {\n144\t        let path = self.path_for(file_id);\n145\t        let mut file = match File::open(&path) {\n146\t            Ok(file) => file,\n147\t            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),\n148\t            Err(error) => return Err(read_failed(&path, error)),\n149\t        };\n150\t        let length = usize::try_from(end - start).expect(\"u32 range fits into usize\");\n151\t        file.seek(SeekFrom::Start(u64::from(start)))\n152\t            .map_err(|error| read_failed(&path, error))?;\n153\t        let mut bytes = vec![0; length];\n154\t        file.read_exact(&mut bytes)\n155\t            .map_err(|error| read_failed(&path, error))?;\n156\t        Ok(Some(bytes))\n157\t    }\n158\t\n159\t    fn read_line_span(\n160\t        &self,\n161\t        file_id: &FileId,\n162\t        line_start: u32,\n163\t        line_end: u32,\n164\t    ) -> Result<Option<Vec<u8>>, SpanValidationError> {\n165\t        let path = self.path_for(file_id);\n166\t        let file = match File::open(&path) {\n167\t            Ok(file) => file,\n168\t            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),\n169\t            Err(error) => return Err(read_failed(&path, error)),\n170\t        };\n171\t        let mut reader = BufReader::new(file);\n172\t        let mut current_line = 1_u32;\n173\t        let mut line = Vec::new();\n174\t        let mut collected = Vec::new();\n175\t        loop {\n176\t            line.clear();\n177\t            let read = reader\n178\t                .read_until(b'\\n', &mut line)\n179\t                .map_err(|error| read_failed(&path, error))?;\n180\t            if read == 0 {\n181\t                break;\n182\t            }\n183\t            if current_line >= line_start && current_line <= line_end {\n184\t                collected.extend_from_slice(&line);\n185\t            }\n186\t            if current_line >= line_end {\n187\t                break;\n188\t            }\n189\t            current_line += 1;\n190\t        }\n191\t        if collected.is_empty() && line_start > current_line {\n192\t            return Ok(None);\n193\t        }\n194\t        Ok(Some(collected))\n195\t    }\n196\t}\n197\t\n198\tpub struct SpanValidator;\n199\t\n200\timpl SpanValidator {\n201\t    pub fn validate(evidence: &MemoryEvidence, current_file_bytes: &[u8]) -> VerificationVerdict {\n202\t        let Some(span) = evidence.span.as_ref() else {\n203\t            return VerificationVerdict::new(\n204\t                VerificationStatus::Verified,\n205\t                \"span validation skipped because evidence has no exact span\",\n206\t            );\n207\t        };\n208\t        let start = usize::try_from(span.byte_start).expect(\"u32 span start fits into usize\");\n209\t        let end = usize::try_from(span.byte_end).expect(\"u32 span end fits into usize\");\n210\t        if start > end {\n211\t            return VerificationVerdict::new(\n212\t                VerificationStatus::Unverified,\n213\t                \"span validation skipped because evidence span is invalid\",\n214\t            );\n215\t        }\n216\t        let span_len = end - start;\n217\t        let candidate = if current_file_bytes.len() == span_len {\n218\t            current_file_bytes\n219\t        } else if end <= current_file_bytes.len() {\n220\t            &current_file_bytes[start..end]\n221\t        } else {\n222\t            return Self::mismatch_verdict(\"unknown\", SpanMismatch::FileShrunkBelowSpan);\n223\t        };\n224\t        let Some(expected_hash) = evidence.evidence_content_hash else {\n225\t            return VerificationVerdict::new(\n226\t                VerificationStatus::Unverified,\n227\t                \"span validation skipped because evidence has no captured content hash\",\n228\t            );\n229\t        };\n230\t        let actual = hash_bytes(candidate);\n231\t        if actual == expected_hash {\n232\t            return VerificationVerdict::new(\n233\t                VerificationStatus::Verified,\n234\t                \"captured span bytes still match the recorded hash\",\n235\t            );\n236\t        }\n237\t        if is_encoding_only_change(evidence, candidate) {\n238\t            return Self::mismatch_verdict(\"unknown\", SpanMismatch::EncodingChanged);\n239\t        }\n240\t        Self::mismatch_verdict(\"unknown\", SpanMismatch::ContentChanged)\n241\t    }\n242\t\n243\t    pub fn validate_with_reader(\n244\t        evidence_id: &str,\n245\t        evidence: &MemoryEvidence,\n246\t        reader: &dyn SpanReader,\n247\t    ) -> Result<VerificationVerdict, SpanValidationError> {\n248\t        let Some(span) = evidence.span.as_ref() else {\n249\t            return Ok(Self::validate(evidence, &[]));\n250\t        };\n251\t        validate_span_bounds(span)?;\n252\t        let Some(file_len) = reader.file_len(&span.file_id)? else {\n253\t            return Ok(Self::mismatch_verdict(\n254\t                evidence_id,\n255\t                SpanMismatch::FileMissing,\n256\t            ));\n257\t        };\n258\t        if u64::from(span.byte_end) > file_len {\n259\t            return Ok(Self::mismatch_verdict(\n260\t                evidence_id,\n261\t                SpanMismatch::FileShrunkBelowSpan,\n262\t            ));\n263\t        }\n264\t        let Some(range_bytes) = reader.read_range(&span.file_id, span.byte_start, span.byte_end)?\n265\t        else {\n266\t            return Ok(Self::mismatch_verdict(\n267\t                evidence_id,\n268\t                SpanMismatch::FileMissing,\n269\t            ));\n270\t        };\n271\t        let basic = Self::validate(evidence, &range_bytes);\n272\t        if basic.status == VerificationStatus::Verified {\n273\t            return Ok(basic);\n274\t        }\n275\t        if reason_subkind(&basic.reason).as_deref() != Some(\"ContentChanged\") {\n276\t            return Ok(Self::with_evidence_id(evidence_id, basic));\n277\t        }\n278\t        let Some(line_bytes) =\n279\t            reader.read_line_span(&span.file_id, span.line_start, span.line_end)?\n280\t        else {\n281\t            return Ok(Self::mismatch_verdict(\n282\t                evidence_id,\n283\t                SpanMismatch::FileMissing,\n284\t            ));\n285\t        };\n286\t        if is_encoding_only_change(evidence, &line_bytes) {\n287\t            return Ok(Self::mismatch_verdict(\n288\t                evidence_id,\n289\t                SpanMismatch::EncodingChanged,\n290\t            ));\n291\t        }\n292\t        Ok(Self::mismatch_verdict(\n293\t            evidence_id,\n294\t            SpanMismatch::ContentChanged,\n295\t        ))\n296\t    }\n297\t\n298\t    fn with_evidence_id(evidence_id: &str, verdict: VerificationVerdict) -> VerificationVerdict {\n299\t        match reason_subkind(&verdict.reason).as_deref() {\n300\t            Some(\"ContentChanged\") => {\n301\t                Self::mismatch_verdict(evidence_id, SpanMismatch::ContentChanged)\n302\t            }\n303\t            Some(\"FileShrunkBelowSpan\") => {\n304\t                Self::mismatch_verdict(evidence_id, SpanMismatch::FileShrunkBelowSpan)\n305\t            }\n306\t            Some(\"EncodingChanged\") => {\n307\t                Self::mismatch_verdict(evidence_id, SpanMismatch::EncodingChanged)\n308\t            }\n309\t            Some(\"FileMissing\") => Self::mismatch_verdict(evidence_id, SpanMismatch::FileMissing),\n310\t            _ => verdict,\n311\t        }\n312\t    }\n313\t\n314\t    pub fn mismatch_verdict(evidence_id: &str, mismatch: SpanMismatch) -> VerificationVerdict {\n315\t        VerificationVerdict::new(\n316\t            mismatch.status(),\n317\t            SpanMismatchReason::new(evidence_id, mismatch).to_json(),\n318\t        )\n319\t    }\n320\t}\n321\t\n322\tfn read_failed(path: &Path, source: std::io::Error) -> SpanValidationError {\n323\t    SpanValidationError::ReadFailed {\n324\t        path: path.display().to_string(),\n325\t        source,\n326\t    }\n327\t}\n328\t\n329\tfn validate_span_bounds(span: &EvidenceSpan) -> Result<(), SpanValidationError> {\n330\t    if span.byte_start <= span.byte_end {\n331\t        return Ok(());\n332\t    }\n333\t    Err(SpanValidationError::InvalidSpan {\n334\t        byte_start: span.byte_start,\n335\t        byte_end: span.byte_end,\n336\t    })\n337\t}\n338\t\n339\tfn hash_bytes(bytes: &[u8]) -> [u8; 32] {\n340\t    let digest = Sha256::digest(bytes);\n341\t    let mut hash = [0; 32];\n342\t    hash.copy_from_slice(&digest);\n343\t    hash\n344\t}\n345\t\n346\tfn is_encoding_only_change(evidence: &MemoryEvidence, current_bytes: &[u8]) -> bool {\n347\t    let Some(detail) = evidence.detail.as_ref() else {\n348\t        return false;\n349\t    };\n350\t    normalize_text(detail.as_bytes()) == normalize_text(current_bytes)\n351\t}\n352\t\n353\tfn normalize_text(bytes: &[u8]) -> Vec<u8> {\n354\t    let without_bom = bytes.strip_prefix(&[0xEF, 0xBB, 0xBF]).unwrap_or(bytes);\n355\t    without_bom\n356\t        .iter()\n357\t        .copied()\n358\t        .filter(|byte| *byte != b'\\r')\n359\t        .collect()\n360\t}\n361\t\n362\tfn reason_subkind(reason: &str) -> Option<String> {\n363\t    serde_json::from_str::<serde_json::Value>(reason)\n364\t        .ok()\n365\t        .and_then(|value| {\n366\t            value\n367\t                .get(\"subkind\")\n368\t                .and_then(|value| value.as_str())\n369\t                .map(str::to_string)\n370\t        })\n371\t}\n372\t"}]},"parent_tool_use_id":null,"session_id":"0696e093-0770-442b-8dc9-5393bbfcd0b6","uuid":"26878497-849c-4140-a528-43bfe20a733e","timestamp":"2026-05-17T13:01:55.274Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/spans.rs","content":"//! Exact-span verification for durable memory evidence.\n//!\n//! This module implements the verifier contract from\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 8. Verification Engine` and\n//! `## Non-Negotiable Product Properties`.\n//!\n//! Verification checks:\n//!\n//! - evidence text still matches when exact spans were captured\n//!\n//! Non-negotiable product property:\n//!\n//! - Every stale or contradicted memory is surfaced as such, not hidden behind recency.\n\nuse std::fs::File;\nuse std::io::{BufRead, BufReader, Read, Seek, SeekFrom};\nuse std::path::{Path, PathBuf};\n\nuse serde::{Deserialize, Serialize};\nuse sha2::{Digest, Sha256};\n\nuse super::{VerificationStatus, VerificationVerdict};\nuse crate::error::LatticeError;\nuse crate::identity::FileId;\nuse crate::memory::{EvidenceSpan, MemoryEvidence};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum SpanMismatch {\n    ContentChanged,\n    FileShrunkBelowSpan,\n    EncodingChanged,\n    FileMissing,\n}\n\nimpl SpanMismatch {\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::ContentChanged => \"ContentChanged\",\n            Self::FileShrunkBelowSpan => \"FileShrunkBelowSpan\",\n            Self::EncodingChanged => \"EncodingChanged\",\n            Self::FileMissing => \"FileMissing\",\n        }\n    }\n\n    fn status(self) -> VerificationStatus {\n        match self {\n            Self::FileMissing => VerificationStatus::Invalidated,\n            Self::ContentChanged | Self::FileShrunkBelowSpan | Self::EncodingChanged => {\n                VerificationStatus::Stale\n            }\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct SpanMismatchReason {\n    pub kind: String,\n    pub subkind: String,\n    pub evidence_id: String,\n}\n\nimpl SpanMismatchReason {\n    pub fn new(evidence_id: impl Into<String>, subkind: SpanMismatch) -> Self {\n        Self {\n            kind: \"SpanMismatch\".to_string(),\n            subkind: subkind.as_str().to_string(),\n            evidence_id: evidence_id.into(),\n        }\n    }\n\n    pub fn to_json(&self) -> String {\n        serde_json::to_string(self).unwrap_or_else(|_| {\n            format!(\n                r#\"{{\"kind\":\"SpanMismatch\",\"subkind\":\"{}\",\"evidence_id\":\"{}\"}}\"#,\n                self.subkind, self.evidence_id\n            )\n        })\n    }\n}\n\n#[derive(Debug, thiserror::Error)]\npub enum SpanValidationError {\n    #[error(\"invalid evidence span `{byte_start}..{byte_end}`\")]\n    InvalidSpan { byte_start: u32, byte_end: u32 },\n    #[error(\"failed to read `{path}`: {source}\")]\n    ReadFailed {\n        path: String,\n        #[source]\n        source: std::io::Error,\n    },\n    #[error(transparent)]\n    Storage(#[from] LatticeError),\n}\n\npub trait SpanReader {\n    fn file_len(&self, file_id: &FileId) -> Result<Option<u64>, SpanValidationError>;\n    fn read_range(\n        &self,\n        file_id: &FileId,\n        start: u32,\n        end: u32,\n    ) -> Result<Option<Vec<u8>>, SpanValidationError>;\n    fn read_line_span(\n        &self,\n        file_id: &FileId,\n        line_start: u32,\n        line_end: u32,\n    ) -> Result<Option<Vec<u8>>, SpanValidationError>;\n}\n\npub struct WorkspaceFileReader {\n    workspace_root: PathBuf,\n}\n\nimpl WorkspaceFileReader {\n    pub fn new(workspace_root: impl Into<PathBuf>) -> Self {\n        Self {\n            workspace_root: workspace_root.into(),\n        }\n    }\n\n    fn path_for(&self, file_id: &FileId) -> PathBuf {\n        self.workspace_root.join(&file_id.repo_relative_path)\n    }\n}\n\nimpl SpanReader for WorkspaceFileReader {\n    fn file_len(&self, file_id: &FileId) -> Result<Option<u64>, SpanValidationError> {\n        let path = self.path_for(file_id);\n        match std::fs::metadata(&path) {\n            Ok(metadata) => Ok(Some(metadata.len())),\n            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),\n            Err(error) => Err(read_failed(&path, error)),\n        }\n    }\n\n    fn read_range(\n        &self,\n        file_id: &FileId,\n        start: u32,\n        end: u32,\n    ) -> Result<Option<Vec<u8>>, SpanValidationError> {\n        let path = self.path_for(file_id);\n        let mut file = match File::open(&path) {\n            Ok(file) => file,\n            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),\n            Err(error) => return Err(read_failed(&path, error)),\n        };\n        let length = usize::try_from(end - start).expect(\"u32 range fits into usize\");\n        file.seek(SeekFrom::Start(u64::from(start)))\n            .map_err(|error| read_failed(&path, error))?;\n        let mut bytes = vec![0; length];\n        file.read_exact(&mut bytes)\n            .map_err(|error| read_failed(&path, error))?;\n        Ok(Some(bytes))\n    }\n\n    fn read_line_span(\n        &self,\n        file_id: &FileId,\n        line_start: u32,\n        line_end: u32,\n    ) -> Result<Option<Vec<u8>>, SpanValidationError> {\n        let path = self.path_for(file_id);\n        let file = match File::open(&path) {\n            Ok(file) => file,\n            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),\n            Err(error) => return Err(read_failed(&path, error)),\n        };\n        let mut reader = BufReader::new(file);\n        let mut current_line = 1_u32;\n        let mut line = Vec::new();\n        let mut collected = Vec::new();\n        loop {\n            line.clear();\n            let read = reader\n                .read_until(b'\\n', &mut line)\n                .map_err(|error| read_failed(&path, error))?;\n            if read == 0 {\n                break;\n            }\n            if current_line >= line_start && current_line <= line_end {\n                collected.extend_from_slice(&line);\n            }\n            if current_line >= line_end {\n                break;\n            }\n            current_line += 1;\n        }\n        if collected.is_empty() && line_start > current_line {\n            return Ok(None);\n        }\n        Ok(Some(collected))\n    }\n}\n\npub struct SpanValidator;\n\nimpl SpanValidator {\n    pub fn validate(evidence: &MemoryEvidence, current_file_bytes: &[u8]) -> VerificationVerdict {\n        let Some(span) = evidence.span.as_ref() else {\n            return VerificationVerdict::new(\n                VerificationStatus::Verified,\n                \"span validation skipped because evidence has no exact span\",\n            );\n        };\n        let start = usize::try_from(span.byte_start).expect(\"u32 span start fits into usize\");\n        let end = usize::try_from(span.byte_end).expect(\"u32 span end fits into usize\");\n        if start > end {\n            return VerificationVerdict::new(\n                VerificationStatus::Unverified,\n                \"span validation skipped because evidence span is invalid\",\n            );\n        }\n        let span_len = end - start;\n        let candidate = if current_file_bytes.len() == span_len {\n            current_file_bytes\n        } else if end <= current_file_bytes.len() {\n            &current_file_bytes[start..end]\n        } else {\n            return Self::mismatch_verdict(\"unknown\", SpanMismatch::FileShrunkBelowSpan);\n        };\n        let Some(expected_hash) = evidence.evidence_content_hash else {\n            return VerificationVerdict::new(\n                VerificationStatus::Unverified,\n                \"span validation skipped because evidence has no captured content hash\",\n            );\n        };\n        let actual = hash_bytes(candidate);\n        if actual == expected_hash {\n            return VerificationVerdict::new(\n                VerificationStatus::Verified,\n                \"captured span bytes still match the recorded hash\",\n            );\n        }\n        if is_encoding_only_change(evidence, candidate) {\n            return Self::mismatch_verdict(\"unknown\", SpanMismatch::EncodingChanged);\n        }\n        Self::mismatch_verdict(\"unknown\", SpanMismatch::ContentChanged)\n    }\n\n    pub fn validate_with_reader(\n        evidence_id: &str,\n        evidence: &MemoryEvidence,\n        reader: &dyn SpanReader,\n    ) -> Result<VerificationVerdict, SpanValidationError> {\n        let Some(span) = evidence.span.as_ref() else {\n            return Ok(Self::validate(evidence, &[]));\n        };\n        validate_span_bounds(span)?;\n        let Some(file_len) = reader.file_len(&span.file_id)? else {\n            return Ok(Self::mismatch_verdict(\n                evidence_id,\n                SpanMismatch::FileMissing,\n            ));\n        };\n        if u64::from(span.byte_end) > file_len {\n            return Ok(Self::mismatch_verdict(\n                evidence_id,\n                SpanMismatch::FileShrunkBelowSpan,\n            ));\n        }\n        let Some(range_bytes) = reader.read_range(&span.file_id, span.byte_start, span.byte_end)?\n        else {\n            return Ok(Self::mismatch_verdict(\n                evidence_id,\n                SpanMismatch::FileMissing,\n            ));\n        };\n        let basic = Self::validate(evidence, &range_bytes);\n        if basic.status == VerificationStatus::Verified {\n            return Ok(basic);\n        }\n        if reason_subkind(&basic.reason).as_deref() != Some(\"ContentChanged\") {\n            return Ok(Self::with_evidence_id(evidence_id, basic));\n        }\n        let Some(line_bytes) =\n            reader.read_line_span(&span.file_id, span.line_start, span.line_end)?\n        else {\n            return Ok(Self::mismatch_verdict(\n                evidence_id,\n                SpanMismatch::FileMissing,\n            ));\n        };\n        if is_encoding_only_change(evidence, &line_bytes) {\n            return Ok(Self::mismatch_verdict(\n                evidence_id,\n                SpanMismatch::EncodingChanged,\n            ));\n        }\n        Ok(Self::mismatch_verdict(\n            evidence_id,\n            SpanMismatch::ContentChanged,\n        ))\n    }\n\n    fn with_evidence_id(evidence_id: &str, verdict: VerificationVerdict) -> VerificationVerdict {\n        match reason_subkind(&verdict.reason).as_deref() {\n            Some(\"ContentChanged\") => {\n                Self::mismatch_verdict(evidence_id, SpanMismatch::ContentChanged)\n            }\n            Some(\"FileShrunkBelowSpan\") => {\n                Self::mismatch_verdict(evidence_id, SpanMismatch::FileShrunkBelowSpan)\n            }\n            Some(\"EncodingChanged\") => {\n                Self::mismatch_verdict(evidence_id, SpanMismatch::EncodingChanged)\n            }\n            Some(\"FileMissing\") => Self::mismatch_verdict(evidence_id, SpanMismatch::FileMissing),\n            _ => verdict,\n        }\n    }\n\n    pub fn mismatch_verdict(evidence_id: &str, mismatch: SpanMismatch) -> VerificationVerdict {\n        VerificationVerdict::new(\n            mismatch.status(),\n            SpanMismatchReason::new(evidence_id, mismatch).to_json(),\n        )\n    }\n}\n\nfn read_failed(path: &Path, source: std::io::Error) -> SpanValidationError {\n    SpanValidationError::ReadFailed {\n        path: path.display().to_string(),\n        source,\n    }\n}\n\nfn validate_span_bounds(span: &EvidenceSpan) -> Result<(), SpanValidationError> {\n    if span.byte_start <= span.byte_end {\n        return Ok(());\n    }\n    Err(SpanValidationError::InvalidSpan {\n        byte_start: span.byte_start,\n        byte_end: span.byte_end,\n    })\n}\n\nfn hash_bytes(bytes: &[u8]) -> [u8; 32] {\n    let digest = Sha256::digest(bytes);\n    let mut hash = [0; 32];\n    hash.copy_from_slice(&digest);\n    hash\n}\n\nfn is_encoding_only_change(evidence: &MemoryEvidence, current_bytes: &[u8]) -> bool {\n    let Some(detail) = evidence.detail.as_ref() else {\n        return false;\n    };\n    normalize_text(detail.as_bytes()) == normalize_text(current_bytes)\n}\n\nfn normalize_text(bytes: &[u8]) -> Vec<u8> {\n    let without_bom = bytes.strip_prefix(&[0xEF, 0xBB, 0xBF]).unwrap_or(bytes);\n    without_bom\n        .iter()\n        .copied()\n        .filter(|byte| *byte != b'\\r')\n        .collect()\n}\n\nfn reason_subkind(reason: &str) -> Option<String> {\n    serde_json::from_str::<serde_json::Value>(reason)\n        .ok()\n        .and_then(|value| {\n            value\n                .get(\"subkind\")\n                .and_then(|value| value.as_str())\n                .map(str::to_string)\n        })\n}\n","numLines":372,"startLine":1,"totalLines":372}}}
