{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HTpcQGLpEMhrjvtHXoKNJb","type":"tool_result","content":"118\t}\n119\t\n120\t#[test]\n121\tfn session_consolidation_hot_path_stays_under_five_milliseconds_p99() {\n122\t    let mut fixture = BudgetFixture::new();\n123\t    let mut samples = Vec::new();\n124\t\n125\t    for index in 0..16 {\n126\t        let task = format!(\"task-budget-warmup-{index}\");\n127\t        fixture.append_small_task(&task);\n128\t        fixture\n129\t            .consolidator\n130\t            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n131\t            .expect(\"warmup task consolidates\");\n132\t    }\n133\t\n134\t    for index in 0..64 {\n135\t        let task = format!(\"task-budget-{index}\");\n136\t        fixture.append_small_task(&task);\n137\t        let started = Instant::now();\n138\t        fixture\n139\t            .consolidator\n140\t            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n141\t            .expect(\"task consolidates\");\n142\t        samples.push(started.elapsed());\n143\t    }\n144\t\n145\t    samples.sort();\n146\t    let p99 = percentile_99(&samples);\n147\t    debug_assert!(p99 <= Duration::from_millis(5));\n148\t    assert!(p99 <= Duration::from_millis(5), \"p99 was {:?}\", p99);\n149\t}\n150\t\n151\t#[test]\n152\tfn session_module_forbids_llm_references() {\n153\t    let source = std::fs::read_to_string(session_source_path()).expect(\"session source reads\");\n154\t    assert!(!source.contains(\"consolidation::llm\"));\n155\t    assert!(!source.contains(\"llm::\"));\n156\t}\n157\t"}]},"parent_tool_use_id":null,"session_id":"ddcebfce-0e51-406a-94f2-c2cc2387736b","uuid":"47dca74f-a756-4d12-b904-630507225169","timestamp":"2026-05-17T21:11:00.449Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/session_tests.rs","content":"}\n\n#[test]\nfn session_consolidation_hot_path_stays_under_five_milliseconds_p99() {\n    let mut fixture = BudgetFixture::new();\n    let mut samples = Vec::new();\n\n    for index in 0..16 {\n        let task = format!(\"task-budget-warmup-{index}\");\n        fixture.append_small_task(&task);\n        fixture\n            .consolidator\n            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n            .expect(\"warmup task consolidates\");\n    }\n\n    for index in 0..64 {\n        let task = format!(\"task-budget-{index}\");\n        fixture.append_small_task(&task);\n        let started = Instant::now();\n        fixture\n            .consolidator\n            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n            .expect(\"task consolidates\");\n        samples.push(started.elapsed());\n    }\n\n    samples.sort();\n    let p99 = percentile_99(&samples);\n    debug_assert!(p99 <= Duration::from_millis(5));\n    assert!(p99 <= Duration::from_millis(5), \"p99 was {:?}\", p99);\n}\n\n#[test]\nfn session_module_forbids_llm_references() {\n    let source = std::fs::read_to_string(session_source_path()).expect(\"session source reads\");\n    assert!(!source.contains(\"consolidation::llm\"));\n    assert!(!source.contains(\"llm::\"));\n}\n","numLines":40,"startLine":118,"totalLines":459}}}
