{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GBRV4wA9FWYgwAy1nWWhHn","type":"tool_result","content":"6195\tfn select_workflow_wire_format(\n6196\t    response_options: &WorkflowResponseOptions,\n6197\t    pruning_profile: SessionPruningProfile,\n6198\t    budget: WorkflowBudget,\n6199\t    approx_tokens: usize,\n6200\t) -> WorkflowWireFormat {\n6201\t    match response_options.wire_format {\n6202\t        WorkflowWireFormat::Dense => WorkflowWireFormat::Dense,\n6203\t        WorkflowWireFormat::Standard => WorkflowWireFormat::Standard,\n6204\t        WorkflowWireFormat::Auto => {\n6205\t            if matches!(budget, WorkflowBudget::Tiny)\n6206\t                && (pruning_profile.prefer_dense || approx_tokens > 260)\n6207\t            {\n6208\t                WorkflowWireFormat::Dense\n6209\t            } else {\n6210\t                WorkflowWireFormat::Standard\n6211\t            }\n6212\t        }\n6213\t    }\n6214\t}\n6215\t\n6216\tfn default_workflow_token_cap(budget: WorkflowBudget) -> usize {\n6217\t    match budget {\n6218\t        WorkflowBudget::Tiny => TINY_WORKFLOW_TOKEN_CAP,\n6219\t        WorkflowBudget::Auto | WorkflowBudget::Compact => COMPACT_WORKFLOW_TOKEN_CAP,\n6220\t        WorkflowBudget::Full => FULL_WORKFLOW_TOKEN_CAP,\n6221\t    }\n6222\t}\n6223\t\n6224\tfn apply_workflow_budget(\n6225\t    tool_name: &str,\n6226\t    value: &mut Value,\n6227\t    budget: WorkflowBudget,\n6228\t    pruning_profile: SessionPruningProfile,\n6229\t    metadata: &mut WorkflowRunMetadata,\n6230\t) {\n6231\t    match budget {\n6232\t        WorkflowBudget::Full => {}\n6233\t        WorkflowBudget::Compact => {\n6234\t            metadata.delivery_mode = \"compact\".to_string();\n6235\t            apply_compact_workflow_pruning(value, pruning_profile);\n6236\t        }\n6237\t        WorkflowBudget::Tiny => {\n6238\t            metadata.delivery_mode = \"tiny\".to_string();\n6239\t            apply_compact_workflow_pruning(value, pruning_profile);\n6240\t            let used_single_anchor = if workflow_is_high_confidence(tool_name, value) {\n6241\t                apply_single_anchor_mode(tool_name, value, pruning_profile)\n6242\t            } else {\n6243\t                apply_tiny_workflow_pruning(tool_name, value, pruning_profile);\n6244\t                false\n6245\t            };\n6246\t            metadata.single_anchor_used |= used_single_anchor;\n6247\t        }\n6248\t        WorkflowBudget::Auto => {}\n6249\t    }\n6250\t}\n6251\t\n6252\tfn apply_compact_workflow_pruning(value: &mut Value, pruning_profile: SessionPruningProfile) {\n6253\t    let Some(object) = value.as_object_mut() else {\n6254\t        return;\n6255\t    };\n6256\t\n6257\t    object.remove(\"stats\");\n6258\t    object.remove(\"memories\");\n6259\t    object.remove(\"playbook_memory\");\n6260\t    truncate_array_field(object, \"rationale\", 0);\n6261\t    truncate_array_field(object, \"matched_rules\", 1);\n6262\t    truncate_array_field(object, \"test_gaps\", 1);\n6263\t\n6264\t    if pruning_profile.prune_memory_highlights {\n6265\t        truncate_array_field(object, \"memory_highlights\", 0);\n6266\t        truncate_array_field(object, \"durable_patterns\", 0);\n6267\t        truncate_array_field(object, \"memories\", 0);\n6268\t    } else {\n6269\t        truncate_array_field(object, \"memory_highlights\", 1);\n6270\t        truncate_array_field(object, \"durable_patterns\", 1);\n6271\t        shorten_memory_entries(object, \"memory_highlights\", 56);\n6272\t        shorten_memory_entries(object, \"durable_patterns\", 56);\n6273\t    }\n6274\t"}]},"parent_tool_use_id":null,"session_id":"ddcebfce-0e51-406a-94f2-c2cc2387736b","uuid":"df1d34e8-ce30-4e7c-9e18-0fd26a2f1924","timestamp":"2026-05-17T21:17:47.664Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/mcp.rs","content":"fn select_workflow_wire_format(\n    response_options: &WorkflowResponseOptions,\n    pruning_profile: SessionPruningProfile,\n    budget: WorkflowBudget,\n    approx_tokens: usize,\n) -> WorkflowWireFormat {\n    match response_options.wire_format {\n        WorkflowWireFormat::Dense => WorkflowWireFormat::Dense,\n        WorkflowWireFormat::Standard => WorkflowWireFormat::Standard,\n        WorkflowWireFormat::Auto => {\n            if matches!(budget, WorkflowBudget::Tiny)\n                && (pruning_profile.prefer_dense || approx_tokens > 260)\n            {\n                WorkflowWireFormat::Dense\n            } else {\n                WorkflowWireFormat::Standard\n            }\n        }\n    }\n}\n\nfn default_workflow_token_cap(budget: WorkflowBudget) -> usize {\n    match budget {\n        WorkflowBudget::Tiny => TINY_WORKFLOW_TOKEN_CAP,\n        WorkflowBudget::Auto | WorkflowBudget::Compact => COMPACT_WORKFLOW_TOKEN_CAP,\n        WorkflowBudget::Full => FULL_WORKFLOW_TOKEN_CAP,\n    }\n}\n\nfn apply_workflow_budget(\n    tool_name: &str,\n    value: &mut Value,\n    budget: WorkflowBudget,\n    pruning_profile: SessionPruningProfile,\n    metadata: &mut WorkflowRunMetadata,\n) {\n    match budget {\n        WorkflowBudget::Full => {}\n        WorkflowBudget::Compact => {\n            metadata.delivery_mode = \"compact\".to_string();\n            apply_compact_workflow_pruning(value, pruning_profile);\n        }\n        WorkflowBudget::Tiny => {\n            metadata.delivery_mode = \"tiny\".to_string();\n            apply_compact_workflow_pruning(value, pruning_profile);\n            let used_single_anchor = if workflow_is_high_confidence(tool_name, value) {\n                apply_single_anchor_mode(tool_name, value, pruning_profile)\n            } else {\n                apply_tiny_workflow_pruning(tool_name, value, pruning_profile);\n                false\n            };\n            metadata.single_anchor_used |= used_single_anchor;\n        }\n        WorkflowBudget::Auto => {}\n    }\n}\n\nfn apply_compact_workflow_pruning(value: &mut Value, pruning_profile: SessionPruningProfile) {\n    let Some(object) = value.as_object_mut() else {\n        return;\n    };\n\n    object.remove(\"stats\");\n    object.remove(\"memories\");\n    object.remove(\"playbook_memory\");\n    truncate_array_field(object, \"rationale\", 0);\n    truncate_array_field(object, \"matched_rules\", 1);\n    truncate_array_field(object, \"test_gaps\", 1);\n\n    if pruning_profile.prune_memory_highlights {\n        truncate_array_field(object, \"memory_highlights\", 0);\n        truncate_array_field(object, \"durable_patterns\", 0);\n        truncate_array_field(object, \"memories\", 0);\n    } else {\n        truncate_array_field(object, \"memory_highlights\", 1);\n        truncate_array_field(object, \"durable_patterns\", 1);\n        shorten_memory_entries(object, \"memory_highlights\", 56);\n        shorten_memory_entries(object, \"durable_patterns\", 56);\n    }\n","numLines":80,"startLine":6195,"totalLines":10907}}}
