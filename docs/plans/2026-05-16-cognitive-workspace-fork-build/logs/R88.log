{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X4mu2cBYBFd1xKw84Tsv7b","type":"tool_result","content":"40\tpub struct MemoryStore {\n41\t    conn: Connection,\n42\t}\n43\t\n44\timpl MemoryStore {\n45\t    /// Open a file-based SQLite database with WAL mode enabled.\n46\t    pub fn open(path: &Path) -> Result<Self, LatticeError> {\n47\t        let conn = Connection::open(path)\n48\t            .map_err(|e| LatticeError::Storage(format!(\"Failed to open memory database: {}\", e)))?;\n49\t\n50\t        configure_connection(&conn, true)?;\n51\t\n52\t        let store = Self { conn };\n53\t        store.initialize()?;\n54\t        Ok(store)\n55\t    }\n56\t\n57\t    /// Open an in-memory SQLite database (for tests).\n58\t    pub fn open_in_memory() -> Result<Self, LatticeError> {\n59\t        let conn = Connection::open_in_memory().map_err(|e| {\n60\t            LatticeError::Storage(format!(\"Failed to open in-memory memory database: {}\", e))\n61\t        })?;\n62\t\n63\t        configure_connection(&conn, false)?;\n64\t\n65\t        let store = Self { conn };\n66\t        store.initialize()?;\n67\t        Ok(store)\n68\t    }\n69\t\n70\t    pub fn with_connection<T, F>(&self, op: F) -> Result<T, LatticeError>\n71\t    where\n72\t        F: FnOnce(&Connection) -> Result<T, LatticeError>,\n73\t    {\n74\t        op(&self.conn)\n75\t    }\n76\t\n77\t    pub fn enqueue_verification_job(\n78\t        &self,\n79\t        workspace_id: &str,\n80\t        memory_id: &str,\n81\t    ) -> Result<String, LatticeError> {\n82\t        let job_id = format!(\"verify-job-{}-{}\", memory_id, now_unix_micros());\n83\t        self.conn\n84\t            .execute(\n85\t                \"INSERT INTO verification_jobs\n86\t                    (job_id, workspace_id, target_memory_id, check_kind, status, verdict, reason, queued_at)\n87\t                 VALUES (?1, ?2, ?3, ?4, 'queued', NULL, NULL, ?5)\",\n88\t                params![\n89\t                    job_id,\n90\t                    workspace_id,\n91\t                    memory_id,\n92\t                    \"existence\",\n93\t                    now_unix_micros(),\n94\t                ],\n95\t            )\n96\t            .map_err(|error| {\n97\t                LatticeError::Storage(format!(\"Failed to enqueue verification job: {error}\"))\n98\t            })?;\n99\t        Ok(job_id)\n100\t    }\n101\t\n102\t    /// Create the memories table if it doesn't already exist.\n103\t    fn initialize(&self) -> Result<(), LatticeError> {\n104\t        self.conn\n105\t            .execute_batch(\n106\t                \"CREATE TABLE IF NOT EXISTS memories (\n107\t                    id              TEXT PRIMARY KEY,\n108\t                    session_id      TEXT NOT NULL DEFAULT '',\n109\t                    content         TEXT NOT NULL,\n110\t                    memory_type     TEXT NOT NULL,\n111\t                    scope           TEXT NOT NULL DEFAULT 'session',\n112\t                    confidence      REAL NOT NULL DEFAULT 1.0,\n113\t                    linked_symbols  TEXT NOT NULL DEFAULT '[]',\n114\t                    linked_files    TEXT NOT NULL DEFAULT '[]',\n115\t                    workspace_id    TEXT,\n116\t                    branch          TEXT,\n117\t                    scope_organization_id TEXT,\n118\t                    refresh_key     TEXT,\n119\t                    source_query    TEXT,\n120\t                    memory_class    TEXT NOT NULL DEFAULT 'observation',\n121\t                    assertion_type  TEXT NOT NULL DEFAULT 'observation',\n122\t                    verification_status TEXT NOT NULL DEFAULT 'unverified',\n123\t                    confidence_reason TEXT,\n124\t                    supersedes_memory_id TEXT,\n125\t                    superseded_by_memory_id TEXT,\n126\t                    contradicts_memory_ids TEXT NOT NULL DEFAULT '[]',\n127\t                    contradicted_by_memory_ids TEXT NOT NULL DEFAULT '[]',\n128\t         