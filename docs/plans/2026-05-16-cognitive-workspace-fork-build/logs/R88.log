{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CDvxViQ4cLdsLhHXJoXXHP","type":"tool_result","content":"228\t#[tokio::test]\n229\tasync fn propose_apply_and_reject_memory_evolution_are_auditable() {\n230\t    let (handler, memory_store, event_store, workspace_root, context_cache_path, session_id) =\n231\t        build_handler(\"memory-evolution\");\n232\t    let memory_id = {\n233\t        let mut store = memory_store.lock().await;\n234\t        let id = store\n235\t            .store(seed_memory(\"refresh behavior old\", MemoryScope::Repo))\n236\t            .expect(\"store memory\");\n237\t        let mut fields = MemoryStructuredFields::default();\n238\t        fields.memory_class = MemoryClass::Observation;\n239\t        store\n240\t            .update_structured_fields(&id, &fields)\n241\t            .expect(\"update fields\");\n242\t        id\n243\t    };\n244\t\n245\t    let propose = handler\n246\t        .handle(\n247\t            \"tools/call\",\n248\t            json!({\n249\t                \"name\": \"propose_memory_evolution\",\n250\t                \"arguments\": {\n251\t                    \"action\": \"propose\",\n252\t                    \"memory_id\": memory_id,\n253\t                    \"content\": \"refresh behavior new\",\n254\t                    \"linked_docs\": [\"docs/auth.md#Refresh\"],\n255\t                    \"reason\": \"refresh path changed\"\n256\t                }\n257\t            }),\n258\t        )\n259\t        .await\n260\t        .expect(\"propose succeeds\");\n261\t    let propose_payload = parse_tool_payload(&propose);\n262\t    let proposal_id = propose_payload[\"proposal_id\"]\n263\t        .as_str()\n264\t        .expect(\"proposal id\")\n265\t        .to_string();\n266\t    {\n267\t        let store = memory_store.lock().await;\n268\t        let current = store\n269\t            .get_by_id(&memory_id)\n270\t            .expect(\"memory query\")\n271\t            .expect(\"memory exists\");\n272\t        assert_eq!(current.content, \"refresh behavior old\");\n273\t        let record = store\n274\t            .with_connection(|conn| {\n275\t                lattice_core::consolidation::ConsolidationProposal::load_record(conn, &proposal_id)\n276\t                    .map_err(Into::into)\n277\t                    .and_then(|value| {\n278\t                        value.ok_or_else(|| {\n279\t                            lattice_core::LatticeError::Storage(\"missing proposal\".to_string())\n280\t                        })\n281\t                    })\n282\t            })\n283\t            .expect(\"proposal record\");\n284\t        assert_eq!(record.decision.as_str(), \"pending\");\n285\t    }\n286\t\n287\t    let apply = handler\n288\t        .handle(\n289\t            \"tools/call\",\n290\t            json!({\n291\t                \"name\": \"propose_memory_evolution\",\n292\t                \"arguments\": {\n293\t                    \"action\": \"apply\",\n294\t                    \"proposal_id\": proposal_id,\n295\t                    \"reason\": \"ship updated refresh memory\"\n296\t                }\n297\t            }),\n298\t        )\n299\t        .await\n300\t        .expect(\"apply succeeds\");\n301\t    let apply_payload = parse_tool_payload(&apply);\n302\t    assert_eq!(apply_payload[\"decision\"].as_str(), Some(\"applied\"));\n303\t    {\n304\t        let store = memory_store.lock().await;\n305\t        let current = store\n306\t            .get_by_id(&memory_id)\n307\t            .expect(\"memory query\")\n308\t            .expect(\"memory exists\");\n309\t        assert_eq!(current.content, \"refresh behavior new\");\n310\t    }\n311\t\n312\t    let reject_proposal = handler\n313\t        .handle(\n314\t            \"tools/call\",\n315\t            json!({\n316\t                \"name\": \"propose_memory_evolution\",\n317\t                \"arguments\": {\n318\t                    \"action\": \"propose\",\n319\t                    \"memory_id\": memory_id,\n320\t                    \"content\": \"refresh behavior rejected\",\n321\t                    \"reason\": \"candidate rejected\"\n322\t                }\n323\t            }),\n324\t        )\n325\t        .await\n326\t        .expect(\"second propose succeeds\");\n327\t    let reject_payload = parse_tool_payload(&reject_proposal);\n328\t    let reject_id = reject_payload[\"proposal_id\"]\n329\t        .as_str()\n330\t        .expect(\"proposal id\")\n331\t        .to_string();\n332\t    let reject = handler\n333\t        .handle(\n334\t            \"tools/call\",\n335\t            json!({\n336\t                \"name\": \"propose_memory_evolution\",\n337\t                \"arguments\": {\n338\t                    \"action\": \"reject\",\n339\t                    \"proposal_id\": reject_id,\n340\t                    \"reason\": \"do not accept\"\n341\t                }\n342\t            }),\n343\t        )\n344\t        .await\n345\t        .expect(\"reject succeeds\");\n346\t    let reject_payload = parse_tool_payload(&reject);\n347\t    assert_eq!(reject_payload[\"decision\"].as_str(), Some(\"rejected\"));\n348\t\n349\t    let events = read_events(&event_store, &session_id);\n350\t    assert!(events\n351\t        .iter()\n352\t        .any(|event| matches!(event.payload, EventPayload::MemoryConsolidated(_))));\n353\t    cleanup_paths(&workspace_root, &context_cache_path);\n354\t}\n355\t\n356\t#[tokio::test]\n357\tasync fn get_task_memory_respects_scope_boundaries() {"}]},"parent_tool_use_id":null,"session_id":"ddcebfce-0e51-406a-94f2-c2cc2387736b","uuid":"1789b62f-5be1-4f65-bcf0-cff368ad472e","timestamp":"2026-05-17T21:25:56.144Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/memory_v2/memory_tools_tests.rs","content":"#[tokio::test]\nasync fn propose_apply_and_reject_memory_evolution_are_auditable() {\n    let (handler, memory_store, event_store, workspace_root, context_cache_path, session_id) =\n        build_handler(\"memory-evolution\");\n    let memory_id = {\n        let mut store = memory_store.lock().await;\n        let id = store\n            .store(seed_memory(\"refresh behavior old\", MemoryScope::Repo))\n            .expect(\"store memory\");\n        let mut fields = MemoryStructuredFields::default();\n        fields.memory_class = MemoryClass::Observation;\n        store\n            .update_structured_fields(&id, &fields)\n            .expect(\"update fields\");\n        id\n    };\n\n    let propose = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"propose_memory_evolution\",\n                \"arguments\": {\n                    \"action\": \"propose\",\n                    \"memory_id\": memory_id,\n                    \"content\": \"refresh behavior new\",\n                    \"linked_docs\": [\"docs/auth.md#Refresh\"],\n                    \"reason\": \"refresh path changed\"\n                }\n            }),\n        )\n        .await\n        .expect(\"propose succeeds\");\n    let propose_payload = parse_tool_payload(&propose);\n    let proposal_id = propose_payload[\"proposal_id\"]\n        .as_str()\n        .expect(\"proposal id\")\n        .to_string();\n    {\n        let store = memory_store.lock().await;\n        let current = store\n            .get_by_id(&memory_id)\n            .expect(\"memory query\")\n            .expect(\"memory exists\");\n        assert_eq!(current.content, \"refresh behavior old\");\n        let record = store\n            .with_connection(|conn| {\n                lattice_core::consolidation::ConsolidationProposal::load_record(conn, &proposal_id)\n                    .map_err(Into::into)\n                    .and_then(|value| {\n                        value.ok_or_else(|| {\n                            lattice_core::LatticeError::Storage(\"missing proposal\".to_string())\n                        })\n                    })\n            })\n            .expect(\"proposal record\");\n        assert_eq!(record.decision.as_str(), \"pending\");\n    }\n\n    let apply = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"propose_memory_evolution\",\n                \"arguments\": {\n                    \"action\": \"apply\",\n                    \"proposal_id\": proposal_id,\n                    \"reason\": \"ship updated refresh memory\"\n                }\n            }),\n        )\n        .await\n        .expect(\"apply succeeds\");\n    let apply_payload = parse_tool_payload(&apply);\n    assert_eq!(apply_payload[\"decision\"].as_str(), Some(\"applied\"));\n    {\n        let store = memory_store.lock().await;\n        let current = store\n            .get_by_id(&memory_id)\n            .expect(\"memory query\")\n            .expect(\"memory exists\");\n        assert_eq!(current.content, \"refresh behavior new\");\n    }\n\n    let reject_proposal = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"propose_memory_evolution\",\n                \"arguments\": {\n                    \"action\": \"propose\",\n                    \"memory_id\": memory_id,\n                    \"content\": \"refresh behavior rejected\",\n                    \"reason\": \"candidate rejected\"\n                }\n            }),\n        )\n        .await\n        .expect(\"second propose succeeds\");\n    let reject_payload = parse_tool_payload(&reject_proposal);\n    let reject_id = reject_payload[\"proposal_id\"]\n        .as_str()\n        .expect(\"proposal id\")\n        .to_string();\n    let reject = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"propose_memory_evolution\",\n                \"arguments\": {\n                    \"action\": \"reject\",\n                    \"proposal_id\": reject_id,\n                    \"reason\": \"do not accept\"\n                }\n            }),\n        )\n        .await\n        .expect(\"reject succeeds\");\n    let reject_payload = parse_tool_payload(&reject);\n    assert_eq!(reject_payload[\"decision\"].as_str(), Some(\"rejected\"));\n\n    let events = read_events(&event_store, &session_id);\n    assert!(events\n        .iter()\n        .any(|event| matches!(event.payload, EventPayload::MemoryConsolidated(_))));\n    cleanup_paths(&workspace_root, &context_cache_path);\n}\n\n#[tokio::test]\nasync fn get_task_memory_respects_scope_boundaries() {","numLines":130,"startLine":228,"totalLines":549}}}
