itTooLarge { requested: usize, ceiling: usize },\n60\t    #[error(\"event store read failed: {0}\")]\n61\t    Storage(#[from] EventStoreError),\n62\t    #[error(\"event payload deserialization failed: {0}\")]\n63\t    Serde(#[from] serde_json::Error),\n64\t    #[error(\"event payload deserialization failed for `{event_id:?}`: {source}\")]\n65\t    PayloadDecode {\n66\t        event_id: EventId,\n67\t        source: serde_json::Error,\n68\t    },\n69\t    #[error(\n70\t        \"event payload corruption detected for `{event_id:?}`: expected {expected}, actual {actual}\"\n71\t    )]\n72\t    PayloadCorruption {\n73\t        event_id: EventId,\n74\t        expected: PayloadHash,\n75\t        actual: PayloadHash,\n76\t    },\n77\t}\n78\t\n79\t#[derive(Clone, Debug, Default, PartialEq, Eq)]\n80\tpub struct EventQuery {\n81\t    pub(crate) task_id: Option<String>,\n82\t    pub(crate) session_id: Option<String>,\n83\t    pub(crate) workspace_id: Option<String>,\n84\t    pub(crate) branch: Option<String>,\n85\t    pub(crate) kinds: Vec<EventKind>,\n86\t    pub(crate) after: Option<DateTime<Utc>>,\n87\t    pub(crate) before: Option<DateTime<Utc>>,\n88\t    pub(crate) limit: Option<usize>,\n89\t    pub(crate) order: Option<QueryOrder>,\n90\t}"}]},"parent_tool_use_id":null,"session_id":"ddcebfce-0e51-406a-94f2-c2cc2387736b","uuid":"16ef4ffb-a1e3-428d-aed4-8f222d637b71","timestamp":"2026-05-17T21:36:17.738Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/query.rs","content":"//! Typed query builder for bounded event-log reads.\n//!\n//! The reader defaults to a 1000-row limit and rejects requests above 10_000 rows.\n//! That ceiling keeps event-log reads bounded on hot paths: callers can page or use\n//! the streaming reader for larger replays, but no single query may degenerate into\n//! a full-log scan or unbounded in-memory buffer.\n\nuse thiserror::Error;\n\nuse crate::events::reader::EventReader;\nuse crate::events::{\n    BranchRef, EventEnvelope, EventKind, EventStoreError, PayloadHash, SessionId, TaskId,\n};\nuse crate::identity::{EventId, WorkspaceId};\nuse crate::{DateTime, Utc};\n\npub const DEFAULT_EVENT_QUERY_LIMIT: usize = 1_000;\npub const EVENT_QUERY_LIMIT_CEILING: usize = 10_000;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum QueryOrder {\n    OldestFirst,\n    NewestFirst,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct TaskScope {\n    pub task_id: TaskId,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct SessionScope {\n    pub session_id: SessionId,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum TailScope {\n    Task(TaskScope),\n    Session(SessionScope),\n}\n\nimpl From<TaskScope> for TailScope {\n    fn from(value: TaskScope) -> Self {\n        Self::Task(value)\n    }\n}\n\nimpl From<SessionScope> for TailScope {\n    fn from(value: SessionScope) -> Self {\n        Self::Session(value)\n    }\n}\n\n#[derive(Debug, Error)]\npub enum EventQueryError {\n    #[error(\"event queries require task, session, or workspace+branch scope\")]\n    Unscoped,\n    #[error(\"event query limit {requested} exceeds ceiling {ceiling}\")]\n    LimitTooLarge { requested: usize, ceiling: usize },\n    #[error(\"event store read failed: {0}\")]\n    Storage(#[from] EventStoreError),\n    #[error(\"event payload deserialization failed: {0}\")]\n    Serde(#[from] serde_json::Error),\n    #[error(\"event payload deserialization failed for `{event_id:?}`: {source}\")]\n    PayloadDecode {\n        event_id: EventId,\n        source: serde_json::Error,\n    },\n    #[error(\n        \"event payload corruption detected for `{event_id:?}`: expected {expected}, actual {actual}\"\n    )]\n    PayloadCorruption {\n        event_id: EventId,\n        expected: PayloadHash,\n        actual: PayloadHash,\n    },\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\npub struct EventQuery {\n    pub(crate) task_id: Option<String>,\n    pub(crate) session_id: Option<String>,\n    pub(crate) workspace_id: Option<String>,\n    pub(crate) branch: Option<String>,\n    pub(crate) kinds: Vec<EventKind>,\n    pub(crate) after: Option<DateTime<Utc>>,\n    pub(crate) before: Option<DateTime<Utc>>,\n    pub(crate) limit: Option<usize>,\n    pub(crate) order: Option<QueryOrder>,\n}","numLines":90,"startLine":1,"totalLines":219}}}
