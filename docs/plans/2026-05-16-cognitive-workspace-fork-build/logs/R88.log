{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V8mvzmYs6CrSdxfhFDVi7K","type":"tool_result","content":"1\tuse std::path::PathBuf;\n2\t\n3\tuse rusqlite::Connection;\n4\tuse serde_json::Value;\n5\tuse tempfile::tempdir;\n6\t\n7\tuse super::*;\n8\tuse crate::graph::CodeGraph;\n9\tuse crate::indexer::Indexer;\n10\tuse crate::memory::store::{direct_write_count, reset_direct_write_count};\n11\tuse crate::memory::{\n12\t    Memory, MemoryScope, MemoryScoreKind, MemoryScoreRecord, MemoryStore, MemoryType,\n13\t    MemoryVerificationStatus,\n14\t};\n15\t\n16\t#[test]\n17\tfn duplicate_detector_emits_supersession_proposal() {\n18\t    let fixture = Fixture::new();\n19\t    let older_id = fixture.seed_memory(\n20\t        \"Duplicate login memory\",\n21\t        vec![\"src/auth.ts\"],\n22\t        vec![\"loginUser\"],\n23\t        10,\n24\t    );\n25\t    let newer_id = fixture.seed_memory(\n26\t        \"Duplicate login memory\",\n27\t        vec![\"src/auth.ts\"],\n28\t        vec![\"loginUser\"],\n29\t        20,\n30\t    );\n31\t\n32\t    reset_direct_write_count();\n33\t    let mut runtime = fixture.runtime();\n34\t    let mut detector = DuplicateDetector::new(&fixture.memory_store, &mut runtime);\n35\t    let report = detector\n36\t        .scan(\"workspace-main\", Some(ProposalKind::Supersede))\n37\t        .unwrap();\n38\t\n39\t    assert_eq!(report.proposals_enqueued, 1);\n40\t    assert_eq!(direct_write_count(), 0);\n41\t    let proposal = fixture.load_only_proposal();\n42\t    assert_eq!(proposal.proposal_kind, ProposalKind::Supersede);\n43\t    assert_eq!(proposal.target.memory_id(), Some(older_id.as_str()));\n44\t    assert!(proposal.prior_state.get(\"memory\").is_some());\n45\t    assert!(proposal.proposed_state.get(\"memory\").is_some());\n46\t    assert_eq!(\n47\t        proposal\n48\t            .evidence\n49\t            .get(\"source_memory_ids\")\n50\t            .and_then(Value::as_array)\n51\t            .map(|values| values.l