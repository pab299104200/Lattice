{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V5p8KKt6Yj9WeD5cvwHjwU","type":"tool_result","content":"6478\tfn workflow_is_high_confidence(tool_name: &str, value: &Value) -> bool {\n6479\t    match tool_name {\n6480\t        \"prepare_change\" => {\n6481\t            first_confidence_band(value, \"primary_files\") == Some(\"high\")\n6482\t                || first_confidence_band(value, \"symbols\") == Some(\"high\")\n6483\t        }\n6484\t        \"plan_edit\" => {\n6485\t            first_confidence_band(value, \"edit_files\") == Some(\"high\")\n6486\t                || first_confidence_band(value, \"candidate_spans\") == Some(\"high\")\n6487\t                || array_len(value, \"candidate_spans\") == 1\n6488\t        }\n6489\t        \"trace_scenario\" => {\n6490\t            first_confidence_band(value, \"likely_entrypoints\") == Some(\"high\")\n6491\t                || first_confidence_band(value, \"execution_path\") == Some(\"high\")\n6492\t                || array_len(value, \"execution_path\") == 1\n6493\t        }\n6494\t        \"impact_from_diff\" => {\n6495\t            first_confidence_band(value, \"tests\") == Some(\"high\")\n6496\t                || array_len(value, \"changed_symbols\") == 1\n6497\t                || array_len(value, \"changed_files\") == 1\n6498\t        }\n6499\t        \"get_working_set_context\" => {\n6500\t            first_confidence_band(value, \"files\") == Some(\"high\")\n6501\t                || first_confidence_band(value, \"active_symbols\") == Some(\"high\")\n6502\t        }\n6503\t        \"summarize_subsystem\" => {\n6504\t            first_confidence_band(value, \"key_files\") == Some(\"high\")\n6505\t                || first_confidence_band(value, \"key_symbols\") == Some(\"high\")\n6506\t        }\n6507\t        \"get_repo_playbook\" => {\n6508\t            first_confidence_band(value, \"key_files\") == Some(\"high\")\n6509\t                || first_confidence_band(value, \"notable_symbols\") == Some(\"high\")\n6510\t        }\n6511\t        \"diagnose_failure\" => first_confidence_band(value, \"suspects\") == Some(\"high\"),\n6512\t        _ => false,\n6513\t    }\n6514\t}\n6515\t\n6516\tfn ensure_suggested_expand(tool_name: &str, object: &mut serde_json::Map<String, Value>) {\n6517\t    if object.contains_key(\"suggested_expand\") {\n6518\t        return;\n6519\t    }\n6520\t\n6521\t    let suggestion = match tool_name {\n6522\t        \"prepare_change\" => first_symbol_focus(object, \"symbols\", \"top change anchor\")\n6523\t            .or_else(|| first_file_focus(object, \"primary_files\", \"top file\")),\n6524\t        \"plan_edit\" => first_symbol_focus(object, \"candidate_spans\", \"top candidate edit span\")\n6525\t            .or_else(|| first_symbol_focus(object, \"symbols\", \"top edit symbol\"))\n6526\t            .or_else(|| first_file_focus(object, \"candidate_spans\", \"top candidate edit span\"))\n6527\t            .or_else(|| first_file_focus(object, \"edit_files\", \"top edit file\")),"}]},"parent_tool_use_id":null,"session_id":"ddcebfce-0e51-406a-94f2-c2cc2387736b","uuid":"baae3430-d9ae-4b01-8883-5e72c6558a8b","timestamp":"2026-05-17T21:18:45.242Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/mcp.rs","content":"fn workflow_is_high_confidence(tool_name: &str, value: &Value) -> bool {\n    match tool_name {\n        \"prepare_change\" => {\n            first_confidence_band(value, \"primary_files\") == Some(\"high\")\n                || first_confidence_band(value, \"symbols\") == Some(\"high\")\n        }\n        \"plan_edit\" => {\n            first_confidence_band(value, \"edit_files\") == Some(\"high\")\n                || first_confidence_band(value, \"candidate_spans\") == Some(\"high\")\n                || array_len(value, \"candidate_spans\") == 1\n        }\n        \"trace_scenario\" => {\n            first_confidence_band(value, \"likely_entrypoints\") == Some(\"high\")\n                || first_confidence_band(value, \"execution_path\") == Some(\"high\")\n                || array_len(value, \"execution_path\") == 1\n        }\n        \"impact_from_diff\" => {\n            first_confidence_band(value, \"tests\") == Some(\"high\")\n                || array_len(value, \"changed_symbols\") == 1\n                || array_len(value, \"changed_files\") == 1\n        }\n        \"get_working_set_context\" => {\n            first_confidence_band(value, \"files\") == Some(\"high\")\n                || first_confidence_band(value, \"active_symbols\") == Some(\"high\")\n        }\n        \"summarize_subsystem\" => {\n            first_confidence_band(value, \"key_files\") == Some(\"high\")\n                || first_confidence_band(value, \"key_symbols\") == Some(\"high\")\n        }\n        \"get_repo_playbook\" => {\n            first_confidence_band(value, \"key_files\") == Some(\"high\")\n                || first_confidence_band(value, \"notable_symbols\") == Some(\"high\")\n        }\n        \"diagnose_failure\" => first_confidence_band(value, \"suspects\") == Some(\"high\"),\n        _ => false,\n    }\n}\n\nfn ensure_suggested_expand(tool_name: &str, object: &mut serde_json::Map<String, Value>) {\n    if object.contains_key(\"suggested_expand\") {\n        return;\n    }\n\n    let suggestion = match tool_name {\n        \"prepare_change\" => first_symbol_focus(object, \"symbols\", \"top change anchor\")\n            .or_else(|| first_file_focus(object, \"primary_files\", \"top file\")),\n        \"plan_edit\" => first_symbol_focus(object, \"candidate_spans\", \"top candidate edit span\")\n            .or_else(|| first_symbol_focus(object, \"symbols\", \"top edit symbol\"))\n            .or_else(|| first_file_focus(object, \"candidate_spans\", \"top candidate edit span\"))\n            .or_else(|| first_file_focus(object, \"edit_files\", \"top edit file\")),","numLines":50,"startLine":6478,"totalLines":10907}}}
