{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vtp6eY6tMNR2bMM9qykXza","type":"tool_result","content":"1245\t    pub fn update_structured_fields(\n1246\t        &self,\n1247\t        id: &str,\n1248\t        fields: &MemoryStructuredFields,\n1249\t    ) -> Result<(), LatticeError> {\n1250\t        record_direct_write();\n1251\t        self.persist_structured_fields(id, fields)\n1252\t    }\n1253\t\n1254\t    /// Mark a memory as superseded by another memory id and downgrade verification state.\n1255\t    pub fn mark_memory_superseded(\n1256\t        &self,\n1257\t        id: &str,\n1258\t        superseded_by_memory_id: &str,\n1259\t    ) -> Result<(), LatticeError> {\n1260\t        record_direct_write();\n1261\t        let mut fields = self.get_structured_fields(id)?.ok_or_else(|| {\n1262\t            LatticeError::Storage(format!(\"Memory '{}' not found or invalidated\", id))\n1263\t        })?;\n1264\t        fields.superseded_by_memory_id = Some(superseded_by_memory_id.to_string());\n1265\t        fields.verification_status = MemoryVerificationStatus::Superseded;\n1266\t        self.persist_structured_fields(id, &fields)\n1267\t    }\n1268\t\n1269\t    /// Mark a contradiction edge between two memory rows.\n1270\t    pub fn mark_memory_contradicted(\n1271\t        &self,\n1272\t        id: &str,\n1273\t        contradicted_by_memory_id: &str,\n1274\t    ) -> Result<(), LatticeError> {\n1275\t        record_direct_write();\n1276\t        let mut fields = self.get_structured_fields(id)?.ok_or_else(|| {\n1277\t            LatticeError::Storage(format!(\"Memory '{}' not found or invalidated\", id))\n1278\t        })?;\n1279\t        if !fields\n1280\t            .contradicted_by_memory_ids\n1281\t            .iter()\n1282\t            .any(|v| v == contradicted_by_memory_id)\n1283\t        {\n1284\t            fields\n1285\t                .contradicted_by_memory_ids\n1286\t                .push(contradicted_by_memory_id.to_string());\n1287\t        }\n1288\t        fields.verification_status = MemoryVerificationStatus::Contradicted;\n1289\t        self.persist_structured_fields(id, &fields)?;\n1290\t\n1291\t        if let Some(mut contradictor) = self.get_structured_fields(contradicted_by_memory_id)? {\n1292\t            if !contradictor.contradicts_memory_ids.iter().any(|v| v == id) {\n1293\t                contradictor.contradicts_memory_ids.push(id.to_string());\n1294\t            }\n1295\t            self.persist_structured_fields(contradicted_by_memory_id, &contradictor)?;\n1296\t        }\n1297\t\n1298\t        Ok(())\n1299\t    }\n1300\t\n1301\t    /// Search memories by keyword (per-word AND match on content + linked_symbols). Excludes invalidated.\n1302\t    pub fn search_by_keyword(&self, keyword: &str) -> Result<Vec<Memory>, LatticeError> {\n1303\t        let memories = if let Some(fts_query) = build_fts_query(keyword) {\n1304\t            let sql = format!(\n1305\t                \"SELECT memories.id, memories.session_id, memories.content, memories.memory_type,\n1306\t                        memories.scope, memories.confidence, memories.linked_symbols,\n1307\t                        memories.linked_files, memories.workspace_id, memories.branch,\n1308\t                        memories.scope_organization_id, memories.refresh_key, memories.source_query, memories.created_at,\n1309\t                        memories.last_accessed, memories.access_count, memories.is_stale,\n1310\t                        memories.stale_reason, memories.verification_status\n1311\t                 FROM memories\n1312\t                 INNER JOIN {table}\n1313\t                    ON {table}.memory_id = memories.id\n1314\t                 WHERE memories.is_invalidated = 0\n1315\t                   AND {table} MATCH ?1\n1316\t                 ORDER BY memories.created_at DESC\",\n1317\t                table = MEMORIES_FTS_TABLE,\n1318\t            );\n1319\t            self.query_memories(&sql, params![fts_query], \"search memories\")?\n1320\t        } else {\n1321\t            self.query_memories(\n1322\t                \"SELECT id, session_id, content, memory_type, scope, confidence, linked_symbols,\n1323\t                        linked_files, workspace_id, branch, scope_organization_id, refresh_key, source_query,\n1324\t                        created_at, last_accessed, access_count, is_stale, stale_reason, verification_status\n1325\t                 FROM memories\n1326\t                 WHERE is_invalidated = 0\n1327\t                 ORDER BY created_at DESC\",\n1328\t                [],\n1329\t                \"search memories\",\n1330\t            )?\n1331\t        };\n1332\t\n1333\t        // Touch each returned memory to update last_accessed\n1334\t        for mem in &memories {\n1335\t            let _ = self.touch_memory(&mem.id);\n1336\t        }\n1337\t\n1338\t        Ok(memories)\n1339\t    }\n1340\t\n1341\t    /// Mark all memories that reference a given symbol as stale with the provided reason.\n1342\t    /// Uses LIKE match on the linked_symbols JSON column.\n1343\t    pub fn mark_stale_by_symbol(\n1344\t        &self,\n1345\t        symbol_name: &str,\n1346\t        reason: &str,\n1347\t    ) -> Result<u64, LatticeError> {\n1348\t        record_direct_write();\n1349\t        // The linked_symbols column stores JSON arrays like [\"foo\",\"bar\"].\n1350\t        // We match symbol names contained inside the JSON string.\n1351\t        let escaped = symbol_name.replace('%', \"\\\\%\").replace('_', \"\\\\_\");\n1352\t        let pattern = format!(\"%\\\"{}\\\"%\", escaped);\n1353\t\n1354\t        let updated = self\n1355\t            .conn\n1356\t            .execute(\n1357\t                \"UPDATE memories\n1358\t                    SET is_stale = 1,\n1359\t                        stale_reason = ?1,\n1360\t                        verification_status = 'stale'\n1361\t                 WHERE is_invalidated = 0 AND linked_symbols LIKE ?2 ESCAPE '\\\\'\",\n1362\t                params![reason, pattern],\n1363\t            )\n1364\t            .map_err(|e| LatticeError::Storage(format!(\"Failed to mark stale: {}\", e)))?;"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"4354e9d5-2225-496f-9afa-8199715afcf3","timestamp":"2026-05-17T13:14:40.106Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/memory/store.rs","content":"    pub fn update_structured_fields(\n        &self,\n        id: &str,\n        fields: &MemoryStructuredFields,\n    ) -> Result<(), LatticeError> {\n        record_direct_write();\n        self.persist_structured_fields(id, fields)\n    }\n\n    /// Mark a memory as superseded by another memory id and downgrade verification state.\n    pub fn mark_memory_superseded(\n        &self,\n        id: &str,\n        superseded_by_memory_id: &str,\n    ) -> Result<(), LatticeError> {\n        record_direct_write();\n        let mut fields = self.get_structured_fields(id)?.ok_or_else(|| {\n            LatticeError::Storage(format!(\"Memory '{}' not found or invalidated\", id))\n        })?;\n        fields.superseded_by_memory_id = Some(superseded_by_memory_id.to_string());\n        fields.verification_status = MemoryVerificationStatus::Superseded;\n        self.persist_structured_fields(id, &fields)\n    }\n\n    /// Mark a contradiction edge between two memory rows.\n    pub fn mark_memory_contradicted(\n        &self,\n        id: &str,\n        contradicted_by_memory_id: &str,\n    ) -> Result<(), LatticeError> {\n        record_direct_write();\n        let mut fields = self.get_structured_fields(id)?.ok_or_else(|| {\n            LatticeError::Storage(format!(\"Memory '{}' not found or invalidated\", id))\n        })?;\n        if !fields\n            .contradicted_by_memory_ids\n            .iter()\n            .any(|v| v == contradicted_by_memory_id)\n        {\n            fields\n                .contradicted_by_memory_ids\n                .push(contradicted_by_memory_id.to_string());\n        }\n        fields.verification_status = MemoryVerificationStatus::Contradicted;\n        self.persist_structured_fields(id, &fields)?;\n\n        if let Some(mut contradictor) = self.get_structured_fields(contradicted_by_memory_id)? {\n            if !contradictor.contradicts_memory_ids.iter().any(|v| v == id) {\n                contradictor.contradicts_memory_ids.push(id.to_string());\n            }\n            self.persist_structured_fields(contradicted_by_memory_id, &contradictor)?;\n        }\n\n        Ok(())\n    }\n\n    /// Search memories by keyword (per-word AND match on content + linked_symbols). Excludes invalidated.\n    pub fn search_by_keyword(&self, keyword: &str) -> Result<Vec<Memory>, LatticeError> {\n        let memories = if let Some(fts_query) = build_fts_query(keyword) {\n            let sql = format!(\n                \"SELECT memories.id, memories.session_id, memories.content, memories.memory_type,\n                        memories.scope, memories.confidence, memories.linked_symbols,\n                        memories.linked_files, memories.workspace_id, memories.branch,\n                        memories.scope_organization_id, memories.refresh_key, memories.source_query, memories.created_at,\n                        memories.last_accessed, memories.access_count, memories.is_stale,\n                        memories.stale_reason, memories.verification_status\n                 FROM memories\n                 INNER JOIN {table}\n                    ON {table}.memory_id = memories.id\n                 WHERE memories.is_invalidated = 0\n                   AND {table} MATCH ?1\n                 ORDER BY memories.created_at DESC\",\n                table = MEMORIES_FTS_TABLE,\n            );\n            self.query_memories(&sql, params![fts_query], \"search memories\")?\n        } else {\n            self.query_memories(\n                \"SELECT id, session_id, content, memory_type, scope, confidence, linked_symbols,\n                        linked_files, workspace_id, branch, scope_organization_id, refresh_key, source_query,\n                        created_at, last_accessed, access_count, is_stale, stale_reason, verification_status\n                 FROM memories\n                 WHERE is_invalidated = 0\n                 ORDER BY created_at DESC\",\n                [],\n                \"search memories\",\n            )?\n        };\n\n        // Touch each returned memory to update last_accessed\n        for mem in &memories {\n            let _ = self.touch_memory(&mem.id);\n        }\n\n        Ok(memories)\n    }\n\n    /// Mark all memories that reference a given symbol as stale with the provided reason.\n    /// Uses LIKE match on the linked_symbols JSON column.\n    pub fn mark_stale_by_symbol(\n        &self,\n        symbol_name: &str,\n        reason: &str,\n    ) -> Result<u64, LatticeError> {\n        record_direct_write();\n        // The linked_symbols column stores JSON arrays like [\"foo\",\"bar\"].\n        // We match symbol names contained inside the JSON string.\n        let escaped = symbol_name.replace('%', \"\\\\%\").replace('_', \"\\\\_\");\n        let pattern = format!(\"%\\\"{}\\\"%\", escaped);\n\n        let updated = self\n            .conn\n            .execute(\n                \"UPDATE memories\n                    SET is_stale = 1,\n                        stale_reason = ?1,\n                        verification_status = 'stale'\n                 WHERE is_invalidated = 0 AND linked_symbols LIKE ?2 ESCAPE '\\\\'\",\n                params![reason, pattern],\n            )\n            .map_err(|e| LatticeError::Storage(format!(\"Failed to mark stale: {}\", e)))?;","numLines":120,"startLine":1245,"totalLines":2897}}}
