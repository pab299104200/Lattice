{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XngKp5pscALUUsLADzhH8d","type":"tool_result","content":"1\t//! Cross-layer contract tests for identity ↔ event log ↔ memory graph.\n2\t//!\n3\t//! Each test pins one boundary in the three-substrate round trip enumerated\n4\t//! by `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## Design Thesis`:\n6\t//!\n7\t//! 1. Identity references serialize cleanly into event payloads.\n8\t//! 2. Event payloads round-trip back to identity targets through the reader.\n9\t//! 3. Memory links reference stable identities, not transient names.\n10\t//! 4. Memory evidence anchors carry typed identities, not path / heading\n11\t//!    strings.\n12\t//! 5. Migration preserves identity references (no path strings survive).\n13\t//! 6. Event capture records identity-typed references.\n14\t//! 7. Replay preserves identity-resolvable evidence anchors.\n15\t//! 8. Schema-level columns that hold identities are constrained to the typed\n16\t//!    shape.\n17\t//!\n18\t//! Verification of these contracts is what R26 — the Phase-3 ↔ Phase-1\n19\t//! contract gate — certifies before Phase 4 retrieval begins. Fixtures and\n20\t//! the in-process harness live in `identity_event_memory_support.rs`; this\n21\t//! file holds only the per-surface assertions. The eight coherent surface\n22\t//! sections plus the end-to-end test put the file just over the 800-line\n23\t//! Cadres heuristic but inside the \"850-line file with 9 coherent sections\n24\t//! is fine\" carve-out in the standard's `## Hard limits`.\n25\t\n26\tuse std::sync::{Arc, Mutex};\n27\t\n28\tuse rusqlite::Connection;\n29\tuse serde_json::Value;\n30\t\n31\tuse crate::events::{\n32\t    Actor, ContextBundleReturnedPayload, DiagnosticObservedPayload, DiagnosticSeverity, EventKind,\n33\t    EventPayload, FileReadPayload, MemoryRetrievedPayload, PatchAppliedPayload, StableRef,\n34\t};\n35\tuse crate::identity::{\n36\t    decode_identity, encode_identity, EventId, FileId, Identity, SectionId, SymbolId,\n37\t};\n38\tuse crate::memory_graph::{\n39\t    get_evidence_for, get_links_from, initialize_schema, insert_link, replay_events,\n40\t    EvidenceAnchor, MemoryDraft, MemoryLink, MemoryLinkId, MemoryLinkTarget, MemoryLinkType,\n41\t    MemoryMigrator,\n42\t};\n43\t\n44\tuse super::identity_event_memory_support::{\n45\t    append_event, build_empty_resolver, build_filesystem_resolver, context_handle_identity,\n46\t    daemon_envelope, doc_section_evidence, file_identity, file_span_evidence, idem,\n47\t    insert_legacy_row, legacy_source_conn, memory_identity, read_back, section_identity,\n48\t    seed_draft, symbol_identity, ContractHarness, WORKSPACE,\n49\t};\n50\t\n51\t// ---------------------------------------------------------------------------\n52\t// SURFACE 1 — identity references serialize cleanly into event payloads\n53\t// ---------------------------------------------------------------------------\n54\t\n55\t#[test]\n56\tfn stable_ref_file_variant_serializes_to_typed_identity_struct_not_path_string() {\n57\t    let file = file_identity(\"src/auth.rs\");\n58\t    let stable_ref = StableRef::FileRef(file.clone());\n59\t    let json: Value = serde_json::to_value(&stable_ref).expect(\"stable ref serializes\");\n60\t\n61\t    assert!(\n62\t        json.is_object(),\n63\t        \"StableRef::FileRef must serialize as a tagged object, not a string ({json})\"\n64\t    );\n65\t    let object = json.as_object().expect(\"object form\");\n66\t    assert_eq!(\n67\t        object.len(),\n68\t        1,\n69\t        \"StableRef uses externally tagged serde representation\"\n70\t    );\n71\t    let (variant_tag, payload) = object.iter().next().expect(\"one variant tag\");\n72\t    assert!(\n73\t        variant_tag.to_ascii_lowercase().contains(\"file\"),\n74\t        \"tag must identify a file variant, got `{variant_tag}`\"\n75\t    );\n76\t    assert_eq!(\n77\t        payload[\"workspace_id\"],\n78\t        Value::String(WORKSPACE.to_string())\n79\t    );\n80\t    assert_eq!(\n81\t        payload[\"repo_relative_path\"],\n82\t        Value::String(\"src/auth.rs\".to_string())\n83\t    );\n84\t    assert_eq!(payload[\"content_hash\"], Value::String(file.content_hash));\n85\t    assert!(\n86\t        payload.get(\"path\").is_none(),\n87\t        \"raw path string must never appear in the wire form\"\n88\t    );\n89\t}\n90\t\n91\t#[test]\n92\tfn stable_ref_symbol_variant_serializes_to_typed_identity_struct_not_qualified_name_string() {\n93\t    let file = file_identity(\"src/auth.rs\");\n94\t    let symbol = symbol_identity(&file, \"login_user\");\n95\t    let stable_ref = StableRef::SymbolRef(symbol.clone());\n96\t    let json: Value = serde_json::to_value(&stable_ref).expect(\"stable ref serializes\");\n97\t\n98\t    let object = json.as_object().expect(\"StableRef serializes as object\");\n99\t    let (_variant_tag, payload) = object.iter().next().expect(\"one variant tag\");\n100\t\n101\t    assert_eq!(\n102\t        payload[\"qualified_name\"],\n103\t        Value::String(\"login_user\".to_string())\n104\t    );\n105\t    assert_eq!(payload[\"byte_offset\"], Value::Number(12.into()));\n106\t    assert!(\n107\t        payload.get(\"file\").is_some(),\n108\t        \"symbol identity carries its file identity, not a path\"\n109\t    );\n110\t    assert_eq!(\n111\t        payload[\"file\"][\"workspace_id\"],\n112\t        Value::String(WORKSPACE.to_string())\n113\t    );\n114\t    let _: SymbolId = serde_json::from_value(payload.clone()).expect(\"symbol round-trips typed\");\n115\t}\n116\t\n117\t#[test]\n118\tfn file_read_payload_embeds_typed_file_identity_not_path_string() {\n119\t    let file = file_identity(\"src/lib.rs\");\n120\t    let payload = EventPayload::FileRead(FileReadPayload {\n121\t        file_id: file.clone(),\n122\t        source_event_id: None,\n123\t        byte_start: None,\n124\t        byte_end: None,\n125\t        reason: \"contract\".to_string(),\n126\t    });\n127\t    let json: Value = serde_json::to_value(&payload).expect(\"payload serializes\");\n128\t    let inner = &json[\"payload\"];\n129\t\n130\t    assert!(inner[\"file_id\"].is_object(), \"FileRead.file_id is typed\");\n131\t    assert_eq!(\n132\t        inner[\"file_id\"][\"repo_relative_path\"],\n133\t        Value::String(\"src/lib.rs\".to_string())\n134\t    );\n135\t    assert!(\n136\t        inner[\"file_id\"].get(\"path\").is_none(),\n137\t        \"FileRead must not flatten file_id to a raw path string\"\n138\t    );\n139\t}\n140\t\n141\t#[test]\n142\tfn diagnostic_observed_payload_embeds_typed_file_identity() {\n143\t    let file = file_identity(\"src/critical.rs\");\n144\t    let payload = EventPayload::DiagnosticObserved(DiagnosticObservedPayload {\n145\t        diagnostic_id: \"DIAG-1\".to_string(),\n146\t        source_event_id: None,\n147\t        file_id: file.clone(),\n148\t        symbol_id: None,\n149\t        severity: DiagnosticSeverity::Error,\n150\t        message: \"boom\".to_string(),\n151\t    });\n152\t    let json = serde_json::to_value(&payload).expect(\"payload serializes\");\n153\t    let inner = &json[\"payload\"][\"file_id\"];\n154\t    assert!(inner.is_object());\n155\t    assert_eq!(inner[\"workspace_id\"], Value::String(WORKSPACE.to_string()));\n156\t}\n157\t\n158\t// ---------------------------------------------------------------------------\n159\t// SURFACE 2 — event payloads round-trip back to identity targets\n160\t// ---------------------------------------------------------------------------\n161\t\n162\t#[test]\n163\tfn stable_ref_round_trips_through_event_store_byte_equivalent() {\n164\t    let harness = ContractHarness::new();\n165\t    let writer = harness.writer();\n166\t    let file = file_identity(\"src/round_trip.rs\");\n167\t    let symbol = symbol_identity(&file, \"round_trip_fn\");\n168\t    let memory = memory_identity(\"round-trip-mem\");\n169\t    let handle = context_handle_identity(\"round-trip-handle\");\n170\t\n171\t    let envelope = daemon_envelope(\n172\t        EventKind::ContextBundleReturned,\n173\t        vec![\n174\t            StableRef::FileRef(file.clone()),\n175\t            StableRef::SymbolRef(symbol.clone()),\n176\t            StableRef::MemoryRef(memory.clone()),\n177\t            StableRef::ContextHandleRef(handle.clone()),\n178\t        ],\n179\t        \"round-trip references\",\n180\t        EventPayload::ContextBundleReturned(ContextBundleReturnedPayload {\n181\t            context_handle_id: handle.clone(),\n182\t            source_event_id: None,\n183\t            file_ids: vec![file.clone()],\n184\t            symbol_ids: vec![symbol.clone()],\n185\t            doc_section_ids: Vec::new(),\n186\t            memory_ids: vec![memory.clone()],\n187\t            token_estimate: 128,\n188\t        }),\n189\t    );\n190\t\n191\t    let event_id = append_event(&writer, envelope);\n192\t    let read = read_back(&harness.reader(), &event_id);\n193\t\n194\t    assert_eq!(\n195\t        read.references,\n196\t        vec![\n197\t            StableRef::FileRef(file.clone()),\n198\t            StableRef::SymbolRef(symbol.clone()),\n199\t            StableRef::MemoryRef(memory.clone()),\n200\t            StableRef::ContextHandleRef(handle.clone()),\n201\t        ],\n202\t        \"references vector must round-trip byte-equivalent typed identities\"\n203\t    );\n204\t\n205\t    let EventPayload::ContextBundleReturned(payload) = read.payload else {\n206\t        panic!(\"payload variant must survive round-trip\");\n207\t    };\n208\t    assert_eq!(payload.file_ids, vec![file]);\n209\t    assert_eq!(payload.symbol_ids, vec![symbol]);\n210\t    assert_eq!(payload.memory_ids, vec![memory]);\n211\t    assert_eq!(payload.context_handle_id, handle);\n212\t}\n213\t\n214\t#[test]\n215\tfn round_tripped_event_id_resolves_via_identity_resolver_to_same_target() {\n216\t    let harness = ContractHarness::new();\n217\t    let writer = harness.writer();\n218\t    let file = file_identity(\"src/resolved.rs\");\n219\t\n220\t    let envelope = daemon_envelope(\n221\t        EventKind::FileRead,\n222\t        vec![StableRef::FileRef(file.clone())],\n223\t        \"file read\",\n224\t        EventPayload::FileRead(FileReadPayload {\n225\t            file_id: file.clone(),\n226\t            source_event_id: None,\n227\t            byte_start: None,\n228\t            byte_end: None,\n229\t            reason: \"contract\".to_string(),\n230\t        }),\n231\t    );\n232\t    let event_id = append_event(&writer, envelope);\n233\t    let read = read_back(&harness.reader(), &event_id);\n234\t\n235\t    let resolver = build_empty_resolver(WORKSPACE, vec![read.event_id.clone()]);\n236\t    let encoded = encode_identity(&Identity::Event(read.event_id.clone()));\n237\t    let resolved = resolver\n238\t        .resolve_event_ref(&WORKSPACE.to_string(), &encoded)\n239\t        .expect(\"event identity resolves after round-trip\");\n240\t\n241\t    assert_eq!(resolved, read.event_id);\n242\t}\n243\t\n244\t#[test]\n245\tfn memory_retrieved_payload_round_trips_memory_ids_through_event_log() {\n246\t    let harness = ContractHarness::new();\n247\t    let writer = harness.writer();\n248\t    let memory_a = memory_identity(\"retrieved-a\");\n249\t    let memory_b = memory_identity(\"retrieved-b\");\n250\t\n251\t    let envelope = daemon_envelope(\n252\t        EventKind::MemoryRetrieved,\n253\t        vec![\n254\t            StableRef::MemoryRef(memory_a.clone()),\n255\t            StableRef::MemoryRef(memory_b.clone()),\n256\t        ],\n257\t        \"memories retrieved\",\n258\t        EventPayload::MemoryRetrieved(MemoryRetrievedPayload {\n259\t            retrieval_query: \"what\".to_string(),\n260\t            context_handle_id: None,\n261\t            memory_ids: vec![memory_a.clone(), memory_b.clone()],\n262\t            supporting_event_ids: Vec::new(),\n263\t            included_context: Vec::new(),\n264\t            excluded_context: Vec::new(),\n265\t        }),\n266\t    );\n267\t    let event_id = append_event(&writer, envelope);\n268\t    let read = read_back(&harness.reader(), &event_id);\n269\t\n270\t    let EventPayload::MemoryRetrieved(payload) = read.payload else {\n271\t        panic!(\"variant survives\");\n272\t    };\n273\t    assert_eq!(payload.memory_ids, vec![memory_a, memory_b]);\n274\t}\n275\t\n276\t// ---------------------------------------------------------------------------\n277\t// SURFACE 3 — memory links reference stable identities, not transient names\n278\t// ---------------------------------------------------------------------------\n279\t\n280\t#[test]\n281\tfn memory_link_target_symbol_persists_encoded_identity_in_target_id_column() {\n282\t    let harness = ContractHarness::new();\n283\t    let file = file_identity(\"src/auth.rs\");\n284\t    let symbol = symbol_identity(&file, \"login_user\");\n285\t    let mem_file = file_identity(\"src/store.rs\");\n286\t    let mem_symbol = symbol_identity(&mem_file, \"store\");\n287\t    let mem_section = section_identity(\"docs/store.md\", \"Store\");\n288\t    let memory = harness\n289\t        .store\n290\t        .create(\n291\t            seed_draft(&mem_file, &mem_symbol, &mem_section),\n292\t            idem(\"link-source\"),\n293\t        )\n294\t        .expect(\"memory creates\");\n295\t\n296\t    let link = MemoryLink::try_new(\n297\t        MemoryLinkId(\"contract-symbol-link\".to_string()),\n298\t        memory.memory_id.clone(),\n299\t        MemoryLinkTarget::Symbol(symbol.clone()),\n300\t        MemoryLinkType::AppliesTo,\n301\t        1.0,\n302\t        \"applies to login flow\".to_string(),\n303\t        None,\n304\t        Actor::Daemon,\n305\t        crate::Utc::now(),\n306\t        crate::memory_graph::VerificationStatus::Verified,\n307\t    )\n308\t    .expect(\"link validates\");\n309\t    insert_link(&harness.conn(), &link).expect(\"link persists\");\n310\t\n311\t    let raw_target_id: String = harness\n312\t        .conn()\n313\t        .query_row(\n314\t            \"SELECT target_id FROM memory_links WHERE link_id = ?1\",\n315\t            rusqlite::params![\"contract-symbol-link\"],\n316\t            |row| row.get(0),\n317\t        )\n318\t        .expect(\"link row visible\");\n319\t\n320\t    assert!(\n321\t        raw_target_id.starts_with(\"symbol:\"),\n322\t        \"memory_links.target_id must be an encoded symbol identity, got `{raw_target_id}`\"\n323\t    );\n324\t    assert!(\n325\t        !raw_target_id.contains(\"\\\"login_user\\\"\"),\n326\t        \"target_id must not store the raw qualified_name as a JSON string\"\n327\t    );\n328\t\n329\t    let decoded = decode_identity(&raw_target_id).expect(\"encoded id parses\");\n330\t    match decoded {\n331\t        Identity::Symbol(decoded_symbol) => assert_eq!(decoded_symbol, symbol),\n332\t        other => panic!(\"expected symbol identity, got {:?}\", other.kind()),\n333\t    }\n334\t}\n335\t\n336\t#[test]\n337\tfn memory_link_round_trips_through_get_links_from_with_typed_target() {\n338\t    let harness = ContractHarness::new();\n339\t    let mem_file = file_identity(\"src/store.rs\");\n340\t    let mem_symbol = symbol_identity(&mem_file, \"store\");\n341\t    let mem_section = section_identity(\"docs/store.md\", \"Store\");\n342\t    let memory = harness\n343\t        .store\n344\t        .create(\n345\t            seed_draft(&mem_file, &mem_symbol, &mem_section),\n346\t            idem(\"link-rt\"),\n347\t        )\n348\t        .expect(\"memory creates\");\n349\t\n350\t    let section = section_identity(\"docs/usage.md\", \"Caller\");\n351\t    let link = MemoryLink::try_new(\n352\t        MemoryLinkId(\"contract-section-link\".to_string()),\n353\t        memory.memory_id.clone(),\n354\t        MemoryLinkTarget::DocSection(section.clone()),\n355\t        MemoryLinkType::DerivedFrom,\n356\t        0.7,\n357\t        \"derived from doc\".to_string(),\n358\t        None,\n359\t        Actor::Daemon,\n360\t        crate::Utc::now(),\n361\t        crate::memory_graph::VerificationStatus::Verified,\n362\t    )\n363\t    .expect(\"link validates\");\n364\t    insert_link(&harness.conn(), &link).expect(\"link persists\");\n365\t\n366\t    let loaded = get_links_from(&harness.conn(), &memory.memory_id).expect(\"links load\");\n367\t    let resolved = loaded\n368\t        .into_iter()\n369\t        .find(|stored| stored.link_id == link.link_id)\n370\t        .expect(\"link survives round-trip\");\n371\t\n372\t    match resolved.target {\n373\t        MemoryLinkTarget::DocSection(id) => assert_eq!(id, section),\n374\t        other => panic!(\"doc section target survives, got {:?}\", other),\n375\t    }\n376\t}\n377\t\n378\t#[test]\n379\tfn memory_link_file_target_resolves_under_file_rename_compat_without_link_rewrite() {\n380\t    let workspace = WORKSPACE.to_string();\n381\t    let source = \"pub fn login_user() {}\\n\";\n382\t\n383\t    let original_resolver =\n384\t        build_filesystem_resolver(&workspace, &[(WORKSPACE, \"src/original.rs\", source)]);\n385\t    let original_file = original_resolver\n386\t        .resolve_path(&workspace, \"src/original.rs\")\n387\t        .expect(\"original file resolves\");\n388\t    let encoded_original = encode_identity(&Identity::File(original_file.clone()));\n389\t\n390\t    let renamed_resolver =\n391\t        build_filesystem_resolver(&workspace, &[(WORKSPACE, \"src/renamed.rs\", source)]);\n392\t\n393\t    let resolved_after_rename = renamed_resolver\n394\t        .resolve_path(&workspace, &encoded_original)\n395\t        .expect(\"encoded original file identity remaps to the renamed file\");\n396\t\n397\t    assert_eq!(resolved_after_rename.repo_relative_path, \"src/renamed.rs\");\n398\t    assert_eq!(\n399\t        resolved_after_rename.content_hash,\n400\t        original_file.content_hash\n401\t    );\n402\t    assert_eq!(\n403\t        encoded_original,\n404\t        encode_identity(&Identity::File(original_file)),\n405\t        \"the stored link target_id does not need to change to follow the rename\"\n406\t    );\n407\t}\n408\t\n409\t// ---------------------------------------------------------------------------\n410\t// SURFACE 4 — memory evidence anchors carry typed identities\n411\t// ---------------------------------------------------------------------------\n412\t\n413\t#[test]\n414\tfn evidence_anchor_filespan_serializes_with_typed_fileid_struct() {\n415\t    let file = file_identity(\"src/anchor.rs\");\n416\t    let anchor = EvidenceAnchor::FileSpan {\n417\t        file: file.clone(),\n418\t        byte_start: 0,\n419\t        byte_end: 32,\n420\t        sha256: [0_u8; 32],\n421\t    };\n422\t    let json = serde_json::to_value(&anchor).expect(\"anchor serializes\");\n423\t    let payload = json.get(\"file_span\").expect(\"file_span tag present\");\n424\t    assert!(payload[\"file\"].is_object(), \"FileSpan.file is typed\");\n425\t    assert_eq!(\n426\t        payload[\"file\"][\"repo_relative_path\"],\n427\t        Value::String(\"src/anchor.rs\".to_string())\n428\t    );\n429\t    assert!(payload.get(\"path\").is_none(), \"no raw path field exposed\");\n430\t}\n431\t\n432\t#[test]\n433\tfn evidence_anchor_docsection_serializes_with_typed_doc_section_id() {\n434\t    let section = section_identity(\"docs/spec.md\", \"Architecture\");\n435\t    let anchor = EvidenceAnchor::DocSection {\n436\t        id: section.clone(),\n437\t        sha256: [9_u8; 32],\n438\t    };\n439\t    let json = serde_json::to_value(&anchor).expect(\"anchor serializes\");\n440\t    let payload = json.get(\"doc_section\").expect(\"doc_section tag present\");\n441\t    assert!(payload[\"id\"].is_object(), \"DocSection.id is typed\");\n442\t    assert_eq!(\n443\t        payload[\"id\"][\"heading_path\"][0],\n444\t        Value::String(\"Architecture\".to_string())\n445\t    );\n446\t    assert!(\n447\t        payload.get(\"heading\").is_none(),\n448\t        \"no raw heading string exposed\"\n449\t    );\n450\t}\n451\t\n452\t#[test]\n453\tfn evidence_anchor_filespan_round_trips_through_memory_evidence_table() {\n454\t    let harness = ContractHarness::new();\n455\t    let file = file_identity(\"src/anchor_rt.rs\");\n456\t    let symbol = symbol_identity(&file, \"anchor_rt\");\n457\t    let section = section_identity(\"docs/anchor.md\", \"Anchor\");\n458\t    let draft = MemoryDraft {\n459\t        initial_evidence: vec![file_span_evidence(&file), doc_section_evidence(&section)],\n460\t        ..seed_draft(&file, &symbol, &section)\n461\t    };\n462\t    let memory = harness\n463\t        .store\n464\t        .create(draft, idem(\"anchor-rt\"))\n465\t        .expect(\"memory creates\");\n466\t\n467\t    let evidence = get_evidence_for(&harness.conn(), &memory.memory_id).expect(\"evidence loads\");\n468\t    let file_anchor = evidence\n469\t        .iter()\n470\t        .find(|item| matches!(item.anchor, EvidenceAnchor::FileSpan { .. }))\n471\t        .expect(\"file span evidence preserved\");\n472\t    let section_anchor = evidence\n473\t        .iter()\n474\t        .find(|item| matches!(item.anchor, EvidenceAnchor::DocSection { .. }))\n475\t        .expect(\"doc section evidence preserved\");\n476\t\n477\t    match &file_anchor.anchor {\n478\t        EvidenceAnchor::FileSpan {\n479\t            file: stored,\n480\t            byte_end,\n481\t            ..\n482\t        } => {\n483\t            assert_eq!(stored, &file);\n484\t            assert_eq!(*byte_end, 32);\n485\t        }\n486\t        other => panic!(\"expected FileSpan, got {:?}\", other),\n487\t    }\n488\t    match &section_anchor.anchor {\n489\t        EvidenceAnchor::DocSection { id, .. } => assert_eq!(id, &section),\n490\t        other => panic!(\"expected DocSection, got {:?}\", other),\n491\t    }\n492\t}\n493\t\n494\t// ---------------------------------------------------------------------------\n495\t// SURFACE 5 — migration (T22) preserves identity references\n496\t// ---------------------------------------------------------------------------\n497\t\n498\t#[test]\n499\tfn migration_emits_typed_file_ids_in_linked_files_json_not_path_strings() {\n500\t    let source = Arc::new(Mutex::new(legacy_source_conn()));\n501\t    {\n502\t        let conn = source.lock().expect(\"source lock\");\n503\t        insert_legacy_row(&conn, \"legacy-a\", r#\"[\"src/legacy_a.rs\"]\"#);\n504\t    }\n505\t    let dest = Arc::new(Mutex::new(Connection::open_in_memory().expect(\"dest\")));\n506\t    {\n507\t        let conn = dest.lock().expect(\"dest lock\");\n508\t        initialize_schema(&conn).expect(\"dest schema\");\n509\t    }\n510\t    let migrator = MemoryMigrator::new(source.clone(), dest.clone(), 8, false);\n511\t    let plan = migrator.plan().expect(\"plan succeeds\");\n512\t    let report = migrator.run(&plan).expect(\"run succeeds\");\n513\t    assert_eq!(report.migrated_rows, 1);\n514\t\n515\t    let linked_files_json: String = dest\n516\t        .lock()\n517\t        .expect(\"dest lock\")\n518\t        .query_row(\n519\t            \"SELECT linked_files_json FROM memories WHERE memory_id LIKE 'memory:%'\",\n520\t            rusqlite::params![],\n521\t            |row| row.get(0),\n522\t        )\n523\t        .expect(\"migrated row visible\");\n524\t    let parsed: Vec<FileId> =\n525\t        serde_json::from_str(&linked_files_json).expect(\"linked_files_json parses as Vec<FileId>\");\n526\t    assert_eq!(parsed.len(), 1);\n527\t    assert_eq!(parsed[0].repo_relative_path, \"src/legacy_a.rs\");\n528\t    assert_eq!(parsed[0].workspace_id, WORKSPACE);\n529\t    assert!(\n530\t        !linked_files_json.starts_with(\"[\\\"\"),\n531\t        \"migrated linked_files_json must not be a JSON array of bare path strings, got `{linked_files_json}`\"\n532\t    );\n533\t}\n534\t\n535\t#[test]\n536\tfn migration_preserves_memory_id_workspace_scoping_in_destination_memory_id_column() {\n537\t    let canonical_ulid = \"01ARZ3NDEKTSV4RRFFQ69G5FAV\";\n538\t    let source = Arc::new(Mutex::new(legacy_source_conn()));\n539\t    {\n540\t        let conn = source.lock().expect(\"source lock\");\n541\t        insert_legacy_row(&conn, canonical_ulid, r#\"[]\"#);\n542\t    }\n543\t    let dest = Arc::new(Mutex::new(Connection::open_in_memory().expect(\"dest\")));\n544\t    {\n545\t        let conn = dest.lock().expect(\"dest lock\");\n546\t        initialize_schema(&conn).expect(\"dest schema\");\n547\t    }\n548\t    let migrator = MemoryMigrator::new(source, dest.clone(), 8, false);\n549\t    let plan = migrator.plan().expect(\"plan succeeds\");\n550\t    migrator.run(&plan).expect(\"run succeeds\");\n551\t\n552\t    let stored_id: String = dest\n553\t        .lock()\n554\t        .expect(\"dest lock\")\n555\t        .query_row(\n556\t            \"SELECT memory_id FROM memories\",\n557\t            rusqlite::params![],\n558\t            |row| row.get(0),\n559\t        )\n560\t        .expect(\"migrated row visible\");\n561\t    assert!(\n562\t        stored_id.starts_with(\"memory:\"),\n563\t        \"memory_id column must hold an encoded memory identity, got `{stored_id}`\"\n564\t    );\n565\t    let decoded = decode_identity(&stored_id).expect(\"memory id decodes\");\n566\t    match decoded {\n567\t        Identity::Memory(id) => {\n568\t            assert_eq!(id.workspace_id, WORKSPACE);\n569\t            assert_eq!(id.ulid, canonical_ulid);\n570\t        }\n571\t        other => panic!(\"expected memory identity, got {:?}\", other.kind()),\n572\t    }\n573\t}\n574\t\n575\t// ---------------------------------------------------------------------------\n576\t// SURFACE 6 — event capture records identity-typed references\n577\t// ---------------------------------------------------------------------------\n578\t\n579\t#[test]\n580\tfn patch_applied_capture_records_only_typed_file_and_symbol_refs() {\n581\t    let harness = ContractHarness::new();\n582\t    let writer = harness.writer();\n583\t    let file = file_identity(\"src/patched.rs\");\n584\t    let symbol = symbol_identity(&file, \"patched_fn\");\n585\t    let envelope = daemon_envelope(\n586\t        EventKind::PatchApplied,\n587\t        vec![\n588\t            StableRef::FileRef(file.clone()),\n589\t            StableRef::SymbolRef(symbol.clone()),\n590\t        ],\n591\t        \"patch\",\n592\t        EventPayload::PatchApplied(PatchAppliedPayload {\n593\t            patch_id: \"patch-1\".to_string(),\n594\t            source_event_id: None,\n595\t            file_ids: vec![file.clone()],\n596\t            symbol_ids: vec![symbol.clone()],\n597\t            lines_added: 5,\n598\t            lines_removed: 1,\n599\t        }),\n600\t    );\n601\t    let event_id = append_event(&writer, envelope);\n602\t    let read = read_back(&harness.reader(), &event_id);\n603\t\n604\t    assert_eq!(read.references.len(), 2);\n605\t    for stable_ref in &read.references {\n606\t        match stable_ref {\n607\t            StableRef::FileRef(_) | StableRef::SymbolRef(_) => {}\n608\t            other => panic!(\"expected typed file/symbol ref, got {:?}\", other),\n609\t        }\n610\t    }\n611\t    let raw_json: String = harness\n612\t        .event_store\n613\t        .lock_conn()\n614\t        .expect(\"event conn\")\n615\t        .query_row(\n616\t            \"SELECT references_json FROM events WHERE event_uuid = ?1\",\n617\t            rusqlite::params![read.event_id.ulid.clone()],\n618\t            |row| row.get(0),\n619\t        )\n620\t        .expect(\"event row visible\");\n621\t    let parsed: Vec<StableRef> = serde_json::from_str(&raw_json).expect(\"references parse typed\");\n622\t    assert_eq!(parsed, read.references);\n623\t}\n624\t\n625\t// ---------------------------------------------------------------------------\n626\t// SURFACE 7 — replay preserves the contract (identity-resolvable evidence)\n627\t// ---------------------------------------------------------------------------\n628\t\n629\t#[test]\n630\tfn replay_preserves_identity_typed_evidence_anchor_after_full_replay() {\n631\t    let harness = ContractHarness::new();\n632\t    let file = file_identity(\"src/replay_anchor.rs\");\n633\t    let symbol = symbol_identity(&file, \"replay_anchor\");\n634\t    let section = section_identity(\"docs/replay.md\", \"Replay\");\n635\t    let draft = MemoryDraft {\n636\t        initial_evidence: vec![file_span_evidence(&file)],\n637\t        ..seed_draft(&file, &symbol, &section)\n638\t    };\n639\t    let memory = harness\n640\t        .store\n641\t        .create(draft, idem(\"replay-anchor\"))\n642\t        .expect(\"memory creates\");\n643\t    let original_evidence =\n644\t        get_evidence_for(&harness.conn(), &memory.memory_id).expect(\"evidence loads\");\n645\t\n646\t    let replay_conn = Connection::open_in_memory().expect(\"replay DB\");\n647\t    replay_conn\n648\t        .execute_batch(\"PRAGMA foreign_keys = ON;\")\n649\t        .expect(\"FK on\");\n650\t    initialize_schema(&replay_conn).expect(\"replay schema\");\n651\t    replay_events(&replay_conn, &harness.all_memory_events()).expect(\"replay succeeds\");\n652\t\n653\t    let replayed_evidence =\n654\t        get_evidence_for(&replay_conn, &memory.memory_id).expect(\"replayed evidence\");\n655\t    let original_file_anchor: Vec<_> = original_evidence\n656\t        .iter()\n657\t        .filter_map(|item| match &item.anchor {\n658\t            EvidenceAnchor::FileSpan { file, .. } => Some(file.clone()),\n659\t            _ => None,\n660\t        })\n661\t        .collect();\n662\t    let replayed_file_anchor: Vec<_> = replayed_evidence\n663\t        .iter()\n664\t        .filter_map(|item| match &item.anchor {\n665\t            EvidenceAnchor::FileSpan { file, .. } => Some(file.clone()),\n666\t            _ => None,\n667\t        })\n668\t        .collect();\n669\t    assert_eq!(\n670\t        original_file_anchor, replayed_file_anchor,\n671\t        \"FileSpan evidence anchor survives replay with typed FileId\"\n672\t    );\n673\t    assert!(!replayed_file_anchor.is_empty(), \"FileSpan anchor present\");\n674\t    assert_eq!(replayed_file_anchor[0], file);\n675\t}\n676\t\n677\t#[test]\n678\tfn replay_emits_memory_id_column_as_encoded_identity_after_full_replay() {\n679\t    let harness = ContractHarness::new();\n680\t    let file = file_identity(\"src/replay_id.rs\");\n681\t    let symbol = symbol_identity(&file, \"replay_id\");\n682\t    let section = section_identity(\"docs/replay.md\", \"ID\");\n683\t    let memory = harness\n684\t        .store\n685\t        .create(seed_draft(&file, &symbol, &section), idem(\"replay-id\"))\n686\t        .expect(\"memory creates\");\n687\t\n688\t    let replay_conn = Connection::open_in_memory().expect(\"replay DB\");\n689\t    replay_conn\n690\t        .execute_batch(\"PRAGMA foreign_keys = ON;\")\n691\t        .expect(\"FK on\");\n692\t    initialize_schema(&replay_conn).expect(\"replay schema\");\n693\t    replay_events(&replay_conn, &harness.all_memory_events()).expect(\"replay succeeds\");\n694\t\n695\t    let stored_id: String = replay_conn\n696\t        .query_row(\n697\t            \"SELECT memory_id FROM memories\",\n698\t            rusqlite::params![],\n699\t            |row| row.get(0),\n700\t        )\n701\t        .expect(\"replayed memory row\");\n702\t    assert!(stored_id.starts_with(\"memory:\"));\n703\t    let decoded = decode_identity(&stored_id).expect(\"memory id decodes\");\n704\t    match decoded {\n705\t        Identity::Memory(id) => assert_eq!(id, memory.memory_id),\n706\t        other => panic!(\"expected memory identity, got {:?}\", other.kind()),\n707\t    }\n708\t}\n709\t\n710\t// ---------------------------------------------------------------------------\n711\t// SURFACE 8 — schema-level enforcement: typed identity columns\n712\t// ---------------------------------------------------------------------------\n713\t\n714\t#[test]\n715\tfn memory_columns_holding_identity_references_store_typed_shapes_not_raw_strings() {\n716\t    let harness = ContractHarness::new();\n717\t    let file = file_identity(\"src/schema_check.rs\");\n718\t    let symbol = symbol_identity(&file, \"schema_check\");\n719\t    let section = section_identity(\"docs/schema.md\", \"Schema\");\n720\t    let memory = harness\n721\t        .store\n722\t        .create(seed_draft(&file, &symbol, &section), idem(\"schema-check\"))\n723\t        .expect(\"memory creates\");\n724\t\n725\t    let (memory_id_str, linked_files_json, linked_symbols_json, linked_docs_json, provenance_json) =\n726\t        harness\n727\t            .conn()\n728\t            .query_row(\n729\t                \"SELECT memory_id, linked_files_json, linked_symbols_json, linked_docs_json, \\\n730\t                 provenance_event_ids_json FROM memories\",\n731\t                rusqlite::params![],\n732\t                |row| {\n733\t                    Ok((\n734\t                        row.get::<_, String>(0)?,\n735\t                        row.get::<_, String>(1)?,\n736\t                        row.get::<_, String>(2)?,\n737\t                        row.get::<_, String>(3)?,\n738\t                        row.get::<_, String>(4)?,\n739\t                    ))\n740\t                },\n741\t            )\n742\t            .expect(\"memory row visible\");\n743\t\n744\t    assert!(memory_id_str.starts_with(\"memory:\"));\n745\t    assert_eq!(\n746\t        decode_identity(&memory_id_str).expect(\"memory id decodes\"),\n747\t        Identity::Memory(memory.memory_id.clone())\n748\t    );\n749\t\n750\t    let files: Vec<FileId> = serde_json::from_str(&linked_files_json).expect(\"file ids\");\n751\t    assert_eq!(files, vec![file.clone()]);\n752\t    let symbols: Vec<SymbolId> = serde_json::from_str(&linked_symbols_json).expect(\"symbols\");\n753\t    assert_eq!(symbols, vec![symbol]);\n754\t    let sections: Vec<SectionId> = serde_json::from_str(&linked_docs_json).expect(\"sections\");\n755\t    assert_eq!(sections, vec![section]);\n756\t    let provenance: Vec<EventId> =\n757\t        serde_json::from_str(&provenance_json).expect(\"provenance event ids\");\n758\t    assert!(\n759\t        !provenance.is_empty(),\n760\t        \"memory_created always populates provenance with the typed event id\"\n761\t    );\n762\t    for event in &provenance {\n763\t        assert_eq!(event.workspace_id, WORKSPACE);\n764\t    }\n765\t}\n766\t\n767\t#[test]\n768\tfn event_table_references_json_column_only_holds_typed_stable_refs() {\n769\t    let harness = ContractHarness::new();\n770\t    let writer = harness.writer();\n771\t    let file = file_identity(\"src/schema_event.rs\");\n772\t    let envelope = daemon_envelope(\n773\t        EventKind::FileRead,\n774\t        vec![StableRef::FileRef(file.clone())],\n775\t        \"file read\",\n776\t        EventPayload::FileRead(FileReadPayload {\n777\t            file_id: file.clone(),\n778\t            source_event_id: None,\n779\t            byte_start: None,\n780\t            byte_end: None,\n781\t            reason: \"schema\".to_string(),\n782\t        }),\n783\t    );\n784\t    let event_id = append_event(&writer, envelope);\n785\t\n786\t    let references_json: String = harness\n787\t        .event_store\n788\t        .lock_conn()\n789\t        .expect(\"event conn\")\n790\t        .query_row(\n791\t            \"SELECT references_json FROM events WHERE event_uuid = ?1\",\n792\t            rusqlite::params![event_id.ulid.clone()],\n793\t            |row| row.get(0),\n794\t        )\n795\t        .expect(\"event row visible\");\n796\t    let parsed: Vec<StableRef> = serde_json::from_str(&references_json).expect(\"refs parse typed\");\n797\t    assert_eq!(parsed, vec![StableRef::FileRef(file)]);\n798\t    let raw: Value = serde_json::from_str(&references_json).expect(\"refs parse value\");\n799\t    let first = &raw[0];\n800\t    assert!(\n801\t        first.is_object(),\n802\t        \"references_json must be an array of typed identity objects, not strings: {references_json}\"\n803\t    );\n804\t}\n805\t\n806\t// ---------------------------------------------------------------------------\n807\t// END-TO-END — identity → event → store → reader → memory → identity\n808\t// ---------------------------------------------------------------------------\n809\t\n810\t#[test]\n811\tfn end_to_end_identity_event_memory_round_trip_preserves_typed_references_at_every_boundary() {\n812\t    let harness = ContractHarness::new();\n813\t    let file = file_identity(\"src/end_to_end.rs\");\n814\t    let symbol = symbol_identity(&file, \"end_to_end_fn\");\n815\t    let section = section_identity(\"docs/e2e.md\", \"Walkthrough\");\n816\t\n817\t    // Step 1 — write a file_read event that carries the typed file identity.\n818\t    let event_id = append_event(\n819\t        &harness.writer(),\n820\t        daemon_envelope(\n821\t            EventKind::FileRead,\n822\t            vec![StableRef::FileRef(file.clone())],\n823\t            \"end-to-end seed\",\n824\t            EventPayload::FileRead(FileReadPayload {\n825\t                file_id: file.clone(),\n826\t                source_event_id: None,\n827\t                byte_start: None,\n828\t                byte_end: None,\n829\t                reason: \"e2e\".to_string(),\n830\t            }),\n831\t        ),\n832\t    );\n833\t\n834\t    // Step 2 — read it back through EventReader and confirm payload + references.\n835\t    let event_envelope = read_back(&harness.reader(), &event_id);\n836\t    let EventPayload::FileRead(file_read) = event_envelope.payload.clone() else {\n837\t        panic!(\"payload survives\");\n838\t    };\n839\t    assert_eq!(file_read.file_id, file);\n840\t    assert_eq!(\n841\t        event_envelope.references,\n842\t        vec![StableRef::FileRef(file.clone())]\n843\t    );\n844\t\n845\t    // Step 3 — write a memory whose evidence anchor cites the same file identity.\n846\t    let draft = MemoryDraft {\n847\t        initial_evidence: vec![file_span_evidence(&file)],\n848\t        ..seed_draft(&file, &symbol, &section)\n849\t    };\n850\t    let memory = harness\n851\t        .store\n852\t        .create(draft, idem(\"end-to-end\"))\n853\t        .expect(\"memory creates\");\n854\t\n855\t    // Step 4 — read evidence back through MemoryStore-side queries.\n856\t    let stored_evidence =\n857\t        get_evidence_for(&harness.conn(), &memory.memory_id).expect(\"evidence loads\");\n858\t    let stored_file = stored_evidence\n859\t        .iter()\n860\t        .find_map(|item| match &item.anchor {\n861\t            EvidenceAnchor::FileSpan { file, .. } => Some(file.clone()),\n862\t            _ => None,\n863\t        })\n864\t        .expect(\"file span survives\");\n865\t    assert_eq!(stored_file, file);\n866\t\n867\t    // Step 5 — resolve every reference back through the IdentityResolver.\n868\t    let event_ids: Vec<EventId> = memory.provenance_event_ids.clone();\n869\t    assert!(!event_ids.is_empty());\n870\t    let resolver = build_filesystem_resolver(\n871\t        &WORKSPACE.to_string(),\n872\t        &[(\n873\t            WORKSPACE,\n874\t            \"src/end_to_end.rs\",\n875\t            \"pub fn end_to_end_fn() {}\\n\",\n876\t        )],\n877\t    );\n878\t    let by_path = resolver\n879\t        .resolve_path(&WORKSPACE.to_string(), \"src/end_to_end.rs\")\n880\t        .expect(\"path resolves\");\n881\t    assert_eq!(by_path.repo_relative_path, \"src/end_to_end.rs\");\n882\t    let encoded = encode_identity(&Identity::File(by_path.clone()));\n883\t    let by_encoded = resolver\n884\t        .resolve_path(&WORKSPACE.to_string(), &encoded)\n885\t        .expect(\"encoded identity resolves\");\n886\t    assert_eq!(by_encoded, by_path);\n887\t\n888\t    // Step 6 — round-trip the memory's evidence event into a typed identity.\n889\t    let event_resolver = build_empty_resolver(WORKSPACE, event_ids.clone());\n890\t    for provenance in &event_ids {\n891\t        let encoded_event = encode_identity(&Identity::Event(provenance.clone()));\n892\t        let resolved = event_resolver\n893\t            .resolve_event_ref(&WORKSPACE.to_string(), &encoded_event)\n894\t            .expect(\"event identity resolves\");\n895\t        assert_eq!(resolved, *provenance);\n896\t    }\n897\t\n898\t    // Step 7 — the canonical wire encodings are stable across the trip.\n899\t    let event_envelope_encoding = encode_identity(&Identity::Event(event_envelope.event_id));\n900\t    assert!(event_envelope_encoding.starts_with(\"event:\"));\n901\t    let memory_encoding = encode_identity(&Identity::Memory(memory.memory_id));\n902\t    assert!(memory_encoding.starts_with(\"memory:\"));\n903\t}\n904\t"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"acac56c4-09f3-43a8-b7f7-5acfbe35e3ca","timestamp":"2026-05-17T13:09:11.268Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/contract_tests/identity_event_memory.rs","content":"//! Cross-layer contract tests for identity ↔ event log ↔ memory graph.\n//!\n//! Each test pins one boundary in the three-substrate round trip enumerated\n//! by `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Design Thesis`:\n//!\n//! 1. Identity references serialize cleanly into event payloads.\n//! 2. Event payloads round-trip back to identity targets through the reader.\n//! 3. Memory links reference stable identities, not transient names.\n//! 4. Memory evidence anchors carry typed identities, not path / heading\n//!    strings.\n//! 5. Migration preserves identity references (no path strings survive).\n//! 6. Event capture records identity-typed references.\n//! 7. Replay preserves identity-resolvable evidence anchors.\n//! 8. Schema-level columns that hold identities are constrained to the typed\n//!    shape.\n//!\n//! Verification of these contracts is what R26 — the Phase-3 ↔ Phase-1\n//! contract gate — certifies before Phase 4 retrieval begins. Fixtures and\n//! the in-process harness live in `identity_event_memory_support.rs`; this\n//! file holds only the per-surface assertions. The eight coherent surface\n//! sections plus the end-to-end test put the file just over the 800-line\n//! Cadres heuristic but inside the \"850-line file with 9 coherent sections\n//! is fine\" carve-out in the standard's `## Hard limits`.\n\nuse std::sync::{Arc, Mutex};\n\nuse rusqlite::Connection;\nuse serde_json::Value;\n\nuse crate::events::{\n    Actor, ContextBundleReturnedPayload, DiagnosticObservedPayload, DiagnosticSeverity, EventKind,\n    EventPayload, FileReadPayload, MemoryRetrievedPayload, PatchAppliedPayload, StableRef,\n};\nuse crate::identity::{\n    decode_identity, encode_identity, EventId, FileId, Identity, SectionId, SymbolId,\n};\nuse crate::memory_graph::{\n    get_evidence_for, get_links_from, initialize_schema, insert_link, replay_events,\n    EvidenceAnchor, MemoryDraft, MemoryLink, MemoryLinkId, MemoryLinkTarget, MemoryLinkType,\n    MemoryMigrator,\n};\n\nuse super::identity_event_memory_support::{\n    append_event, build_empty_resolver, build_filesystem_resolver, context_handle_identity,\n    daemon_envelope, doc_section_evidence, file_identity, file_span_evidence, idem,\n    insert_legacy_row, legacy_source_conn, memory_identity, read_back, section_identity,\n    seed_draft, symbol_identity, ContractHarness, WORKSPACE,\n};\n\n// ---------------------------------------------------------------------------\n// SURFACE 1 — identity references serialize cleanly into event payloads\n// ---------------------------------------------------------------------------\n\n#[test]\nfn stable_ref_file_variant_serializes_to_typed_identity_struct_not_path_string() {\n    let file = file_identity(\"src/auth.rs\");\n    let stable_ref = StableRef::FileRef(file.clone());\n    let json: Value = serde_json::to_value(&stable_ref).expect(\"stable ref serializes\");\n\n    assert!(\n        json.is_object(),\n        \"StableRef::FileRef must serialize as a tagged object, not a string ({json})\"\n    );\n    let object = json.as_object().expect(\"object form\");\n    assert_eq!(\n        object.len(),\n        1,\n        \"StableRef uses externally tagged serde representation\"\n    );\n    let (variant_tag, payload) = object.iter().next().expect(\"one variant tag\");\n    assert!(\n        variant_tag.to_ascii_lowercase().contains(\"file\"),\n        \"tag must identify a file variant, got `{variant_tag}`\"\n    );\n    assert_eq!(\n        payload[\"workspace_id\"],\n        Value::String(WORKSPACE.to_string())\n    );\n    assert_eq!(\n        payload[\"repo_relative_path\"],\n        Value::String(\"src/auth.rs\".to_string())\n    );\n    assert_eq!(payload[\"content_hash\"], Value::String(file.content_hash));\n    assert!(\n        payload.get(\"path\").is_none(),\n        \"raw path string must never appear in the wire form\"\n    );\n}\n\n#[test]\nfn stable_ref_symbol_variant_serializes_to_typed_identity_struct_not_qualified_name_string() {\n    let file = file_identity(\"src/auth.rs\");\n    let symbol = symbol_identity(&file, \"login_user\");\n    let stable_ref = StableRef::SymbolRef(symbol.clone());\n    let json: Value = serde_json::to_value(&stable_ref).expect(\"stable ref serializes\");\n\n    let object = json.as_object().expect(\"StableRef serializes as object\");\n    let (_variant_tag, payload) = object.iter().next().expect(\"one variant tag\");\n\n    assert_eq!(\n        payload[\"qualified_name\"],\n        Value::String(\"login_user\".to_string())\n    );\n    assert_eq!(payload[\"byte_offset\"], Value::Number(12.into()));\n    assert!(\n        payload.get(\"file\").is_some(),\n        \"symbol identity carries its file identity, not a path\"\n    );\n    assert_eq!(\n        payload[\"file\"][\"workspace_id\"],\n        Value::String(WORKSPACE.to_string())\n    );\n    let _: SymbolId = serde_json::from_value(payload.clone()).expect(\"symbol round-trips typed\");\n}\n\n#[test]\nfn file_read_payload_embeds_typed_file_identity_not_path_string() {\n    let file = file_identity(\"src/lib.rs\");\n    let payload = EventPayload::FileRead(FileReadPayload {\n        file_id: file.clone(),\n        source_event_id: None,\n        byte_start: None,\n        byte_end: None,\n        reason: \"contract\".to_string(),\n    });\n    let json: Value = serde_json::to_value(&payload).expect(\"payload serializes\");\n    let inner = &json[\"payload\"];\n\n    assert!(inner[\"file_id\"].is_object(), \"FileRead.file_id is typed\");\n    assert_eq!(\n        inner[\"file_id\"][\"repo_relative_path\"],\n        Value::String(\"src/lib.rs\".to_string())\n    );\n    assert!(\n        inner[\"file_id\"].get(\"path\").is_none(),\n        \"FileRead must not flatten file_id to a raw path string\"\n    );\n}\n\n#[test]\nfn diagnostic_observed_payload_embeds_typed_file_identity() {\n    let file = file_identity(\"src/critical.rs\");\n    let payload = EventPayload::DiagnosticObserved(DiagnosticObservedPayload {\n        diagnostic_id: \"DIAG-1\".to_string(),\n        source_event_id: None,\n        file_id: file.clone(),\n        symbol_id: None,\n        severity: DiagnosticSeverity::Error,\n        message: \"boom\".to_string(),\n    });\n    let json = serde_json::to_value(&payload).expect(\"payload serializes\");\n    let inner = &json[\"payload\"][\"file_id\"];\n    assert!(inner.is_object());\n    assert_eq!(inner[\"workspace_id\"], Value::String(WORKSPACE.to_string()));\n}\n\n// ---------------------------------------------------------------------------\n// SURFACE 2 — event payloads round-trip back to identity targets\n// ---------------------------------------------------------------------------\n\n#[test]\nfn stable_ref_round_trips_through_event_store_byte_equivalent() {\n    let harness = ContractHarness::new();\n    let writer = harness.writer();\n    let file = file_identity(\"src/round_trip.rs\");\n    let symbol = symbol_identity(&file, \"round_trip_fn\");\n    let memory = memory_identity(\"round-trip-mem\");\n    let handle = context_handle_identity(\"round-trip-handle\");\n\n    let envelope = daemon_envelope(\n        EventKind::ContextBundleReturned,\n        vec![\n            StableRef::FileRef(file.clone()),\n            StableRef::SymbolRef(symbol.clone()),\n            StableRef::MemoryRef(memory.clone()),\n            StableRef::ContextHandleRef(handle.clone()),\n        ],\n        \"round-trip references\",\n        EventPayload::ContextBundleReturned(ContextBundleReturnedPayload {\n            context_handle_id: handle.clone(),\n            source_event_id: None,\n            file_ids: vec![file.clone()],\n            symbol_ids: vec![symbol.clone()],\n            doc_section_ids: Vec::new(),\n            memory_ids: vec![memory.clone()],\n            token_estimate: 128,\n        }),\n    );\n\n    let event_id = append_event(&writer, envelope);\n    let read = read_back(&harness.reader(), &event_id);\n\n    assert_eq!(\n        read.references,\n        vec![\n            StableRef::FileRef(file.clone()),\n            StableRef::SymbolRef(symbol.clone()),\n            StableRef::MemoryRef(memory.clone()),\n            StableRef::ContextHandleRef(handle.clone()),\n        ],\n        \"references vector must round-trip byte-equivalent typed identities\"\n    );\n\n    let EventPayload::ContextBundleReturned(payload) = read.payload else {\n        panic!(\"payload variant must survive round-trip\");\n    };\n    assert_eq!(payload.file_ids, vec![file]);\n    assert_eq!(payload.symbol_ids, vec![symbol]);\n    assert_eq!(payload.memory_ids, vec![memory]);\n    assert_eq!(payload.context_handle_id, handle);\n}\n\n#[test]\nfn round_tripped_event_id_resolves_via_identity_resolver_to_same_target() {\n    let harness = ContractHarness::new();\n    let writer = harness.writer();\n    let file = file_identity(\"src/resolved.rs\");\n\n    let envelope = daemon_envelope(\n        EventKind::FileRead,\n        vec![StableRef::FileRef(file.clone())],\n        \"file read\",\n        EventPayload::FileRead(FileReadPayload {\n            file_id: file.clone(),\n            source_event_id: None,\n            byte_start: None,\n            byte_end: None,\n            reason: \"contract\".to_string(),\n        }),\n    );\n    let event_id = append_event(&writer, envelope);\n    let read = read_back(&harness.reader(), &event_id);\n\n    let resolver = build_empty_resolver(WORKSPACE, vec![read.event_id.clone()]);\n    let encoded = encode_identity(&Identity::Event(read.event_id.clone()));\n    let resolved = resolver\n        .resolve_event_ref(&WORKSPACE.to_string(), &encoded)\n        .expect(\"event identity resolves after round-trip\");\n\n    assert_eq!(resolved, read.event_id);\n}\n\n#[test]\nfn memory_retrieved_payload_round_trips_memory_ids_through_event_log() {\n    let harness = ContractHarness::new();\n    let writer = harness.writer();\n    let memory_a = memory_identity(\"retrieved-a\");\n    let memory_b = memory_identity(\"retrieved-b\");\n\n    let envelope = daemon_envelope(\n        EventKind::MemoryRetrieved,\n        vec![\n            StableRef::MemoryRef(memory_a.clone()),\n            StableRef::MemoryRef(memory_b.clone()),\n        ],\n        \"memories retrieved\",\n        EventPayload::MemoryRetrieved(MemoryRetrievedPayload {\n            retrieval_query: \"what\".to_string(),\n            context_handle_id: None,\n            memory_ids: vec![memory_a.clone(), memory_b.clone()],\n            supporting_event_ids: Vec::new(),\n            included_context: Vec::new(),\n            excluded_context: Vec::new(),\n        }),\n    );\n    let event_id = append_event(&writer, envelope);\n    let read = read_back(&harness.reader(), &event_id);\n\n    let EventPayload::MemoryRetrieved(payload) = read.payload else {\n        panic!(\"variant survives\");\n    };\n    assert_eq!(payload.memory_ids, vec![memory_a, memory_b]);\n}\n\n// ---------------------------------------------------------------------------\n// SURFACE 3 — memory links reference stable identities, not transient names\n// ---------------------------------------------------------------------------\n\n#[test]\nfn memory_link_target_symbol_persists_encoded_identity_in_target_id_column() {\n    let harness = ContractHarness::new();\n    let file = file_identity(\"src/auth.rs\");\n    let symbol = symbol_identity(&file, \"login_user\");\n    let mem_file = file_identity(\"src/store.rs\");\n    let mem_symbol = symbol_identity(&mem_file, \"store\");\n    let mem_section = section_identity(\"docs/store.md\", \"Store\");\n    let memory = harness\n        .store\n        .create(\n            seed_draft(&mem_file, &mem_symbol, &mem_section),\n            idem(\"link-source\"),\n        )\n        .expect(\"memory creates\");\n\n    let link = MemoryLink::try_new(\n        MemoryLinkId(\"contract-symbol-link\".to_string()),\n        memory.memory_id.clone(),\n        MemoryLinkTarget::Symbol(symbol.clone()),\n        MemoryLinkType::AppliesTo,\n        1.0,\n        \"applies to login flow\".to_string(),\n        None,\n        Actor::Daemon,\n        crate::Utc::now(),\n        crate::memory_graph::VerificationStatus::Verified,\n    )\n    .expect(\"link validates\");\n    insert_link(&harness.conn(), &link).expect(\"link persists\");\n\n    let raw_target_id: String = harness\n        .conn()\n        .query_row(\n            \"SELECT target_id FROM memory_links WHERE link_id = ?1\",\n            rusqlite::params![\"contract-symbol-link\"],\n            |row| row.get(0),\n        )\n        .expect(\"link row visible\");\n\n    assert!(\n        raw_target_id.starts_with(\"symbol:\"),\n        \"memory_links.target_id must be an encoded symbol identity, got `{raw_target_id}`\"\n    );\n    assert!(\n        !raw_target_id.contains(\"\\\"login_user\\\"\"),\n        \"target_id must not store the raw qualified_name as a JSON string\"\n    );\n\n    let decoded = decode_identity(&raw_target_id).expect(\"encoded id parses\");\n    match decoded {\n        Identity::Symbol(decoded_symbol) => assert_eq!(decoded_symbol, symbol),\n        other => panic!(\"expected symbol identity, got {:?}\", other.kind()),\n    }\n}\n\n#[test]\nfn memory_link_round_trips_through_get_links_from_with_typed_target() {\n    let harness = ContractHarness::new();\n    let mem_file = file_identity(\"src/store.rs\");\n    let mem_symbol = symbol_identity(&mem_file, \"store\");\n    let mem_section = section_identity(\"docs/store.md\", \"Store\");\n    let memory = harness\n        .store\n        .create(\n            seed_draft(&mem_file, &mem_symbol, &mem_section),\n            idem(\"link-rt\"),\n        )\n        .expect(\"memory creates\");\n\n    let section = section_identity(\"docs/usage.md\", \"Caller\");\n    let link = MemoryLink::try_new(\n        MemoryLinkId(\"contract-section-link\".to_string()),\n        memory.memory_id.clone(),\n        MemoryLinkTarget::DocSection(section.clone()),\n        MemoryLinkType::DerivedFrom,\n        0.7,\n        \"derived from doc\".to_string(),\n        None,\n        Actor::Daemon,\n        crate::Utc::now(),\n        crate::memory_graph::VerificationStatus::Verified,\n    )\n    .expect(\"link validates\");\n    insert_link(&harness.conn(), &link).expect(\"link persists\");\n\n    let loaded = get_links_from(&harness.conn(), &memory.memory_id).expect(\"links load\");\n    let resolved = loaded\n        .into_iter()\n        .find(|stored| stored.link_id == link.link_id)\n        .expect(\"link survives round-trip\");\n\n    match resolved.target {\n        MemoryLinkTarget::DocSection(id) => assert_eq!(id, section),\n        other => panic!(\"doc section target survives, got {:?}\", other),\n    }\n}\n\n#[test]\nfn memory_link_file_target_resolves_under_file_rename_compat_without_link_rewrite() {\n    let workspace = WORKSPACE.to_string();\n    let source = \"pub fn login_user() {}\\n\";\n\n    let original_resolver =\n        build_filesystem_resolver(&workspace, &[(WORKSPACE, \"src/original.rs\", source)]);\n    let original_file = original_resolver\n        .resolve_path(&workspace, \"src/original.rs\")\n        .expect(\"original file resolves\");\n    let encoded_original = encode_identity(&Identity::File(original_file.clone()));\n\n    let renamed_resolver =\n        build_filesystem_resolver(&workspace, &[(WORKSPACE, \"src/renamed.rs\", source)]);\n\n    let resolved_after_rename = renamed_resolver\n        .resolve_path(&workspace, &encoded_original)\n        .expect(\"encoded original file identity remaps to the renamed file\");\n\n    assert_eq!(resolved_after_rename.repo_relative_path, \"src/renamed.rs\");\n    assert_eq!(\n        resolved_after_rename.content_hash,\n        original_file.content_hash\n    );\n    assert_eq!(\n        encoded_original,\n        encode_identity(&Identity::File(original_file)),\n        \"the stored link target_id does not need to change to follow the rename\"\n    );\n}\n\n// ---------------------------------------------------------------------------\n// SURFACE 4 — memory evidence anchors carry typed identities\n// ---------------------------------------------------------------------------\n\n#[test]\nfn evidence_anchor_filespan_serializes_with_typed_fileid_struct() {\n    let file = file_identity(\"src/anchor.rs\");\n    let anchor = EvidenceAnchor::FileSpan {\n        file: file.clone(),\n        byte_start: 0,\n        byte_end: 32,\n        sha256: [0_u8; 32],\n    };\n    let json = serde_json::to_value(&anchor).expect(\"anchor serializes\");\n    let payload = json.get(\"file_span\").expect(\"file_span tag present\");\n    assert!(payload[\"file\"].is_object(), \"FileSpan.file is typed\");\n    assert_eq!(\n        payload[\"file\"][\"repo_relative_path\"],\n        Value::String(\"src/anchor.rs\".to_string())\n    );\n    assert!(payload.get(\"path\").is_none(), \"no raw path field exposed\");\n}\n\n#[test]\nfn evidence_anchor_docsection_serializes_with_typed_doc_section_id() {\n    let section = section_identity(\"docs/spec.md\", \"Architecture\");\n    let anchor = EvidenceAnchor::DocSection {\n        id: section.clone(),\n        sha256: [9_u8; 32],\n    };\n    let json = serde_json::to_value(&anchor).expect(\"anchor serializes\");\n    let payload = json.get(\"doc_section\").expect(\"doc_section tag present\");\n    assert!(payload[\"id\"].is_object(), \"DocSection.id is typed\");\n    assert_eq!(\n        payload[\"id\"][\"heading_path\"][0],\n        Value::String(\"Architecture\".to_string())\n    );\n    assert!(\n        payload.get(\"heading\").is_none(),\n        \"no raw heading string exposed\"\n    );\n}\n\n#[test]\nfn evidence_anchor_filespan_round_trips_through_memory_evidence_table() {\n    let harness = ContractHarness::new();\n    let file = file_identity(\"src/anchor_rt.rs\");\n    let symbol = symbol_identity(&file, \"anchor_rt\");\n    let section = section_identity(\"docs/anchor.md\", \"Anchor\");\n    let draft = MemoryDraft {\n        initial_evidence: vec![file_span_evidence(&file), doc_section_evidence(&section)],\n        ..seed_draft(&file, &symbol, &section)\n    };\n    let memory = harness\n        .store\n        .create(draft, idem(\"anchor-rt\"))\n        .expect(\"memory creates\");\n\n    let evidence = get_evidence_for(&harness.conn(), &memory.memory_id).expect(\"evidence loads\");\n    let file_anchor = evidence\n        .iter()\n        .find(|item| matches!(item.anchor, EvidenceAnchor::FileSpan { .. }))\n        .expect(\"file span evidence preserved\");\n    let section_anchor = evidence\n        .iter()\n        .find(|item| matches!(item.anchor, EvidenceAnchor::DocSection { .. }))\n        .expect(\"doc section evidence preserved\");\n\n    match &file_anchor.anchor {\n        EvidenceAnchor::FileSpan {\n            file: stored,\n            byte_end,\n            ..\n        } => {\n            assert_eq!(stored, &file);\n            assert_eq!(*byte_end, 32);\n        }\n        other => panic!(\"expected FileSpan, got {:?}\", other),\n    }\n    match &section_anchor.anchor {\n        EvidenceAnchor::DocSection { id, .. } => assert_eq!(id, &section),\n        other => panic!(\"expected DocSection, got {:?}\", other),\n    }\n}\n\n// ---------------------------------------------------------------------------\n// SURFACE 5 — migration (T22) preserves identity references\n// ---------------------------------------------------------------------------\n\n#[test]\nfn migration_emits_typed_file_ids_in_linked_files_json_not_path_strings() {\n    let source = Arc::new(Mutex::new(legacy_source_conn()));\n    {\n        let conn = source.lock().expect(\"source lock\");\n        insert_legacy_row(&conn, \"legacy-a\", r#\"[\"src/legacy_a.rs\"]\"#);\n    }\n    let dest = Arc::new(Mutex::new(Connection::open_in_memory().expect(\"dest\")));\n    {\n        let conn = dest.lock().expect(\"dest lock\");\n        initialize_schema(&conn).expect(\"dest schema\");\n    }\n    let migrator = MemoryMigrator::new(source.clone(), dest.clone(), 8, false);\n    let plan = migrator.plan().expect(\"plan succeeds\");\n    let report = migrator.run(&plan).expect(\"run succeeds\");\n    assert_eq!(report.migrated_rows, 1);\n\n    let linked_files_json: String = dest\n        .lock()\n        .expect(\"dest lock\")\n        .query_row(\n            \"SELECT linked_files_json FROM memories WHERE memory_id LIKE 'memory:%'\",\n            rusqlite::params![],\n            |row| row.get(0),\n        )\n        .expect(\"migrated row visible\");\n    let parsed: Vec<FileId> =\n        serde_json::from_str(&linked_files_json).expect(\"linked_files_json parses as Vec<FileId>\");\n    assert_eq!(parsed.len(), 1);\n    assert_eq!(parsed[0].repo_relative_path, \"src/legacy_a.rs\");\n    assert_eq!(parsed[0].workspace_id, WORKSPACE);\n    assert!(\n        !linked_files_json.starts_with(\"[\\\"\"),\n        \"migrated linked_files_json must not be a JSON array of bare path strings, got `{linked_files_json}`\"\n    );\n}\n\n#[test]\nfn migration_preserves_memory_id_workspace_scoping_in_destination_memory_id_column() {\n    let canonical_ulid = \"01ARZ3NDEKTSV4RRFFQ69G5FAV\";\n    let source = Arc::new(Mutex::new(legacy_source_conn()));\n    {\n        let conn = source.lock().expect(\"source lock\");\n        insert_legacy_row(&conn, canonical_ulid, r#\"[]\"#);\n    }\n    let dest = Arc::new(Mutex::new(Connection::open_in_memory().expect(\"dest\")));\n    {\n        let conn = dest.lock().expect(\"dest lock\");\n        initialize_schema(&conn).expect(\"dest schema\");\n    }\n    let migrator = MemoryMigrator::new(source, dest.clone(), 8, false);\n    let plan = migrator.plan().expect(\"plan succeeds\");\n    migrator.run(&plan).expect(\"run succeeds\");\n\n    let stored_id: String = dest\n        .lock()\n        .expect(\"dest lock\")\n        .query_row(\n            \"SELECT memory_id FROM memories\",\n            rusqlite::params![],\n            |row| row.get(0),\n        )\n        .expect(\"migrated row visible\");\n    assert!(\n        stored_id.starts_with(\"memory:\"),\n        \"memory_id column must hold an encoded memory identity, got `{stored_id}`\"\n    );\n    let decoded = decode_identity(&stored_id).expect(\"memory id decodes\");\n    match decoded {\n        Identity::Memory(id) => {\n            assert_eq!(id.workspace_id, WORKSPACE);\n            assert_eq!(id.ulid, canonical_ulid);\n        }\n        other => panic!(\"expected memory identity, got {:?}\", other.kind()),\n    }\n}\n\n// ---------------------------------------------------------------------------\n// SURFACE 6 — event capture records identity-typed references\n// ---------------------------------------------------------------------------\n\n#[test]\nfn patch_applied_capture_records_only_typed_file_and_symbol_refs() {\n    let harness = ContractHarness::new();\n    let writer = harness.writer();\n    let file = file_identity(\"src/patched.rs\");\n    let symbol = symbol_identity(&file, \"patched_fn\");\n    let envelope = daemon_envelope(\n        EventKind::PatchApplied,\n        vec![\n            StableRef::FileRef(file.clone()),\n            StableRef::SymbolRef(symbol.clone()),\n        ],\n        \"patch\",\n        EventPayload::PatchApplied(PatchAppliedPayload {\n            patch_id: \"patch-1\".to_string(),\n            source_event_id: None,\n            file_ids: vec![file.clone()],\n            symbol_ids: vec![symbol.clone()],\n            lines_added: 5,\n            lines_removed: 1,\n        }),\n    );\n    let event_id = append_event(&writer, envelope);\n    let read = read_back(&harness.reader(), &event_id);\n\n    assert_eq!(read.references.len(), 2);\n    for stable_ref in &read.references {\n        match stable_ref {\n            StableRef::FileRef(_) | StableRef::SymbolRef(_) => {}\n            other => panic!(\"expected typed file/symbol ref, got {:?}\", other),\n        }\n    }\n    let raw_json: String = harness\n        .event_store\n        .lock_conn()\n        .expect(\"event conn\")\n        .query_row(\n            \"SELECT references_json FROM events WHERE event_uuid = ?1\",\n            rusqlite::params![read.event_id.ulid.clone()],\n            |row| row.get(0),\n        )\n        .expect(\"event row visible\");\n    let parsed: Vec<StableRef> = serde_json::from_str(&raw_json).expect(\"references parse typed\");\n    assert_eq!(parsed, read.references);\n}\n\n// ---------------------------------------------------------------------------\n// SURFACE 7 — replay preserves the contract (identity-resolvable evidence)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn replay_preserves_identity_typed_evidence_anchor_after_full_replay() {\n    let harness = ContractHarness::new();\n    let file = file_identity(\"src/replay_anchor.rs\");\n    let symbol = symbol_identity(&file, \"replay_anchor\");\n    let section = section_identity(\"docs/replay.md\", \"Replay\");\n    let draft = MemoryDraft {\n        initial_evidence: vec![file_span_evidence(&file)],\n        ..seed_draft(&file, &symbol, &section)\n    };\n    let memory = harness\n        .store\n        .create(draft, idem(\"replay-anchor\"))\n        .expect(\"memory creates\");\n    let original_evidence =\n        get_evidence_for(&harness.conn(), &memory.memory_id).expect(\"evidence loads\");\n\n    let replay_conn = Connection::open_in_memory().expect(\"replay DB\");\n    replay_conn\n        .execute_batch(\"PRAGMA foreign_keys = ON;\")\n        .expect(\"FK on\");\n    initialize_schema(&replay_conn).expect(\"replay schema\");\n    replay_events(&replay_conn, &harness.all_memory_events()).expect(\"replay succeeds\");\n\n    let replayed_evidence =\n        get_evidence_for(&replay_conn, &memory.memory_id).expect(\"replayed evidence\");\n    let original_file_anchor: Vec<_> = original_evidence\n        .iter()\n        .filter_map(|item| match &item.anchor {\n            EvidenceAnchor::FileSpan { file, .. } => Some(file.clone()),\n            _ => None,\n        })\n        .collect();\n    let replayed_file_anchor: Vec<_> = replayed_evidence\n        .iter()\n        .filter_map(|item| match &item.anchor {\n            EvidenceAnchor::FileSpan { file, .. } => Some(file.clone()),\n            _ => None,\n        })\n        .collect();\n    assert_eq!(\n        original_file_anchor, replayed_file_anchor,\n        \"FileSpan evidence anchor survives replay with typed FileId\"\n    );\n    assert!(!replayed_file_anchor.is_empty(), \"FileSpan anchor present\");\n    assert_eq!(replayed_file_anchor[0], file);\n}\n\n#[test]\nfn replay_emits_memory_id_column_as_encoded_identity_after_full_replay() {\n    let harness = ContractHarness::new();\n    let file = file_identity(\"src/replay_id.rs\");\n    let symbol = symbol_identity(&file, \"replay_id\");\n    let section = section_identity(\"docs/replay.md\", \"ID\");\n    let memory = harness\n        .store\n        .create(seed_draft(&file, &symbol, &section), idem(\"replay-id\"))\n        .expect(\"memory creates\");\n\n    let replay_conn = Connection::open_in_memory().expect(\"replay DB\");\n    replay_conn\n        .execute_batch(\"PRAGMA foreign_keys = ON;\")\n        .expect(\"FK on\");\n    initialize_schema(&replay_conn).expect(\"replay schema\");\n    replay_events(&replay_conn, &harness.all_memory_events()).expect(\"replay succeeds\");\n\n    let stored_id: String = replay_conn\n        .query_row(\n            \"SELECT memory_id FROM memories\",\n            rusqlite::params![],\n            |row| row.get(0),\n        )\n        .expect(\"replayed memory row\");\n    assert!(stored_id.starts_with(\"memory:\"));\n    let decoded = decode_identity(&stored_id).expect(\"memory id decodes\");\n    match decoded {\n        Identity::Memory(id) => assert_eq!(id, memory.memory_id),\n        other => panic!(\"expected memory identity, got {:?}\", other.kind()),\n    }\n}\n\n// ---------------------------------------------------------------------------\n// SURFACE 8 — schema-level enforcement: typed identity columns\n// ---------------------------------------------------------------------------\n\n#[test]\nfn memory_columns_holding_identity_references_store_typed_shapes_not_raw_strings() {\n    let harness = ContractHarness::new();\n    let file = file_identity(\"src/schema_check.rs\");\n    let symbol = symbol_identity(&file, \"schema_check\");\n    let section = section_identity(\"docs/schema.md\", \"Schema\");\n    let memory = harness\n        .store\n        .create(seed_draft(&file, &symbol, &section), idem(\"schema-check\"))\n        .expect(\"memory creates\");\n\n    let (memory_id_str, linked_files_json, linked_symbols_json, linked_docs_json, provenance_json) =\n        harness\n            .conn()\n            .query_row(\n                \"SELECT memory_id, linked_files_json, linked_symbols_json, linked_docs_json, \\\n                 provenance_event_ids_json FROM memories\",\n                rusqlite::params![],\n                |row| {\n                    Ok((\n                        row.get::<_, String>(0)?,\n                        row.get::<_, String>(1)?,\n                        row.get::<_, String>(2)?,\n                        row.get::<_, String>(3)?,\n                        row.get::<_, String>(4)?,\n                    ))\n                },\n            )\n            .expect(\"memory row visible\");\n\n    assert!(memory_id_str.starts_with(\"memory:\"));\n    assert_eq!(\n        decode_identity(&memory_id_str).expect(\"memory id decodes\"),\n        Identity::Memory(memory.memory_id.clone())\n    );\n\n    let files: Vec<FileId> = serde_json::from_str(&linked_files_json).expect(\"file ids\");\n    assert_eq!(files, vec![file.clone()]);\n    let symbols: Vec<SymbolId> = serde_json::from_str(&linked_symbols_json).expect(\"symbols\");\n    assert_eq!(symbols, vec![symbol]);\n    let sections: Vec<SectionId> = serde_json::from_str(&linked_docs_json).expect(\"sections\");\n    assert_eq!(sections, vec![section]);\n    let provenance: Vec<EventId> =\n        serde_json::from_str(&provenance_json).expect(\"provenance event ids\");\n    assert!(\n        !provenance.is_empty(),\n        \"memory_created always populates provenance with the typed event id\"\n    );\n    for event in &provenance {\n        assert_eq!(event.workspace_id, WORKSPACE);\n    }\n}\n\n#[test]\nfn event_table_references_json_column_only_holds_typed_stable_refs() {\n    let harness = ContractHarness::new();\n    let writer = harness.writer();\n    let file = file_identity(\"src/schema_event.rs\");\n    let envelope = daemon_envelope(\n        EventKind::FileRead,\n        vec![StableRef::FileRef(file.clone())],\n        \"file read\",\n        EventPayload::FileRead(FileReadPayload {\n            file_id: file.clone(),\n            source_event_id: None,\n            byte_start: None,\n            byte_end: None,\n            reason: \"schema\".to_string(),\n        }),\n    );\n    let event_id = append_event(&writer, envelope);\n\n    let references_json: String = harness\n        .event_store\n        .lock_conn()\n        .expect(\"event conn\")\n        .query_row(\n            \"SELECT references_json FROM events WHERE event_uuid = ?1\",\n            rusqlite::params![event_id.ulid.clone()],\n            |row| row.get(0),\n        )\n        .expect(\"event row visible\");\n    let parsed: Vec<StableRef> = serde_json::from_str(&references_json).expect(\"refs parse typed\");\n    assert_eq!(parsed, vec![StableRef::FileRef(file)]);\n    let raw: Value = serde_json::from_str(&references_json).expect(\"refs parse value\");\n    let first = &raw[0];\n    assert!(\n        first.is_object(),\n        \"references_json must be an array of typed identity objects, not strings: {references_json}\"\n    );\n}\n\n// ---------------------------------------------------------------------------\n// END-TO-END — identity → event → store → reader → memory → identity\n// ---------------------------------------------------------------------------\n\n#[test]\nfn end_to_end_identity_event_memory_round_trip_preserves_typed_references_at_every_boundary() {\n    let harness = ContractHarness::new();\n    let file = file_identity(\"src/end_to_end.rs\");\n    let symbol = symbol_identity(&file, \"end_to_end_fn\");\n    let section = section_identity(\"docs/e2e.md\", \"Walkthrough\");\n\n    // Step 1 — write a file_read event that carries the typed file identity.\n    let event_id = append_event(\n        &harness.writer(),\n        daemon_envelope(\n            EventKind::FileRead,\n            vec![StableRef::FileRef(file.clone())],\n            \"end-to-end seed\",\n            EventPayload::FileRead(FileReadPayload {\n                file_id: file.clone(),\n                source_event_id: None,\n                byte_start: None,\n                byte_end: None,\n                reason: \"e2e\".to_string(),\n            }),\n        ),\n    );\n\n    // Step 2 — read it back through EventReader and confirm payload + references.\n    let event_envelope = read_back(&harness.reader(), &event_id);\n    let EventPayload::FileRead(file_read) = event_envelope.payload.clone() else {\n        panic!(\"payload survives\");\n    };\n    assert_eq!(file_read.file_id, file);\n    assert_eq!(\n        event_envelope.references,\n        vec![StableRef::FileRef(file.clone())]\n    );\n\n    // Step 3 — write a memory whose evidence anchor cites the same file identity.\n    let draft = MemoryDraft {\n        initial_evidence: vec![file_span_evidence(&file)],\n        ..seed_draft(&file, &symbol, &section)\n    };\n    let memory = harness\n        .store\n        .create(draft, idem(\"end-to-end\"))\n        .expect(\"memory creates\");\n\n    // Step 4 — read evidence back through MemoryStore-side queries.\n    let stored_evidence =\n        get_evidence_for(&harness.conn(), &memory.memory_id).expect(\"evidence loads\");\n    let stored_file = stored_evidence\n        .iter()\n        .find_map(|item| match &item.anchor {\n            EvidenceAnchor::FileSpan { file, .. } => Some(file.clone()),\n            _ => None,\n        })\n        .expect(\"file span survives\");\n    assert_eq!(stored_file, file);\n\n    // Step 5 — resolve every reference back through the IdentityResolver.\n    let event_ids: Vec<EventId> = memory.provenance_event_ids.clone();\n    assert!(!event_ids.is_empty());\n    let resolver = build_filesystem_resolver(\n        &WORKSPACE.to_string(),\n        &[(\n            WORKSPACE,\n            \"src/end_to_end.rs\",\n            \"pub fn end_to_end_fn() {}\\n\",\n        )],\n    );\n    let by_path = resolver\n        .resolve_path(&WORKSPACE.to_string(), \"src/end_to_end.rs\")\n        .expect(\"path resolves\");\n    assert_eq!(by_path.repo_relative_path, \"src/end_to_end.rs\");\n    let encoded = encode_identity(&Identity::File(by_path.clone()));\n    let by_encoded = resolver\n        .resolve_path(&WORKSPACE.to_string(), &encoded)\n        .expect(\"encoded identity resolves\");\n    assert_eq!(by_encoded, by_path);\n\n    // Step 6 — round-trip the memory's evidence event into a typed identity.\n    let event_resolver = build_empty_resolver(WORKSPACE, event_ids.clone());\n    for provenance in &event_ids {\n        let encoded_event = encode_identity(&Identity::Event(provenance.clone()));\n        let resolved = event_resolver\n            .resolve_event_ref(&WORKSPACE.to_string(), &encoded_event)\n            .expect(\"event identity resolves\");\n        assert_eq!(resolved, *provenance);\n    }\n\n    // Step 7 — the canonical wire encodings are stable across the trip.\n    let event_envelope_encoding = encode_identity(&Identity::Event(event_envelope.event_id));\n    assert!(event_envelope_encoding.starts_with(\"event:\"));\n    let memory_encoding = encode_identity(&Identity::Memory(memory.memory_id));\n    assert!(memory_encoding.starts_with(\"memory:\"));\n}\n","numLines":904,"startLine":1,"totalLines":904}}}
