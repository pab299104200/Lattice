n146\t            ulid: next_ulid(now),\n147\t        };\n148\t        let tx = conn.transaction()?;\n149\t        let mut record = record_from_draft(memory_id.clone(), draft, now);\n150\t        insert_memory(&tx, &record)?;\n151\t        bind_idempotency(&tx, &idempotency_key, &memory_id)?;\n152\t        let prepared = self.prepare_memory_event_write(&record, \"memory created\")?;\n153\t        let event_id = prepared.event_id.clone();\n154\t        record.provenance_event_ids.push(event_id.clone());\n155\t        record.evidence_references.push(EvidenceReference {\n156\t            target: StableRef::EventRef(event_id.clone()),\n157\t            event_id: Some(event_id.clone()),\n158\t            summary: \"memory created\".to_string(),\n159\t        });\n160\t        replace_memory(&tx, &record)?;\n161\t        for evidence in collect_initial_evidence(\n162\t            &record.memory_id,\n163\t            &event_id,\n164\t            &record,\n165\t            &initial_evidence,\n166\t            now,\n167\t        )? {\n168\t            insert_evidence(&tx, &evidence).map_err(map_evidence_error)?;\n169\t        }\n170\t        let snapshot_json = capture_replay_snapshot(tx.deref(), &record)?;\n171\t        self.append_memory_created(&record, &idempotency_key, Some(snapshot_json), prepared)?;\n172\t        tx.commit()?;\n173\t        load_memory(conn.deref(), &memory_id)\n174\t    }\n175\t\n176\t    pub fn get(\n177\t        &self,\n178\t        memory_id: &MemoryId,\n179\t        scope: &ScopeFilter,\n180\t    ) -> Result<MemoryRecord, MemoryStoreError> {\n181\t        ensure_scope_filter(scope)?;\n182\t        let conn = lock_connection(&self.conn)?;\n183\t        let record = load_memory(conn.deref(), memory_id)?;\n184\t        record_scope_filter(&record).enforce_subset(scope)?;\n185\t        Ok(record)\n186\t    }\n187\t\n188\t    pub fn list_by_class(\n189\t        &self,\n190\t        class: MemoryClass,\n191\t        scope: &ScopeFilter,\n192\t        l