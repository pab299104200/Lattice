(ctx, &step.node.id))\n401\t        .collect::<Vec<_>>();\n402\t    Candidate {\n403\t        identity: symbol_identity(ctx, &path.target.id),\n404\t        source: CandidateSource::CodeGraphTraversal,\n405\t        seed_anchor: Some(seed.clone()),\n406\t        raw_score: 0.75,\n407\t        preliminary_inclusion_reason: \"bounded code graph traversal from resolved anchor\"\n408\t            .to_string(),\n409\t        expansion_handle_hint: Some(\"graph-neighborhood\".to_string()),\n410\t        traversal_path,\n411\t        budget_exhausted: false,\n412\t    }\n413\t}\n414\t\n415\tfn doc_candidate(\n416\t    ctx: &RetrievalContext<'_>,\n417\t    seed: &Identity,\n418\t    node: &crate::graph::GraphNode,\n419\t    edge_code: &str,\n420\t) -> Candidate {\n421\t    Candidate {\n422\t        identity: doc_identity(ctx, node),\n423\t        source: CandidateSource::DocBacklinksOutgoingLinks,\n424\t        seed_anchor: Some(seed.clone()),\n425\t        raw_score: 0.7,\n426\t        preliminary_inclusion_reason: format!(\"doc graph edge `{edge_code}` connected to anchor\"),\n427\t        expansion_handle_hint: Some(format!(\"doc-link:{}\", node.file)),\n428\t        traversal_path: vec![doc_identity(ctx, node)],\n429\t        budget_exhausted: false,\n430\t    }\n431\t}\n432\t\n433\tfn memory_candidate(ctx: &RetrievalContext<'_>, id: String, source: CandidateSource) -> Candidate {\n434\t    Candidate {\n435\t        identity: Identity::Memory(MemoryId {\n436\t            workspace_id: ctx.workspace_id.to_string(),\n437\t            ulid: id.clone(),\n438\t        }),\n439\t        source,\n440\t        seed_anchor: None,\n441\t        raw_score: 0.65,\n442\t        preliminary_inclusion_reason: \"memory graph or FTS retrieval result\".to_string(),\n443\t        expansion_handle_hint: Some(format!(\"memory:{id}\")),\n444\t        traversal_path: Vec::new(),\n445\t        budget_exhausted: false,\n446\t    }\n447\t}\n448\t\n449\tfn event_candidate(event: &EventEnvelope, source: CandidateSource) -> Candidate {\n450\t    Candidate {\n451\t        identity: Identity::Event(event.event_id.clone()),\n452\t        source,\n453\t        seed_anchor: None,\n454\t        raw_score: 0.6,\n455\t        preliminary_inclusion_reason: format!(\"related event `{}`\", event.kind.as_str()),\n456\t        expansion_handle_hint: Some(format!(\"event:{}\", event.event_id.ulid)),\n457\t        traversal_path: event\n458\t            .references\n459\t            .iter()\n460\t            .filter_map(identity_from_ref)\n461\t            .collect(),\n462\t        budget_exhausted: false,\n463\t    }\n464\t}\n465\t\n466\tfn enforce_budget(\n467\t    mut candidates: Vec<Candidate>,\n468\t    cap: usize,\n469\t    source: CandidateSource,\n470\t) -> Vec<Candidate> {\n471\t    debug_assert!(\n472\t        candidates.len() <= cap,\n473\t        \"{source:?} retriever exceeded candidate cap {cap}\"\n474\t    );\n475\t    let exhausted = candidates.len() > cap;\n476\t    candidates.truncate(cap);\n477\t    if exhausted {\n478\t        for candidate in &mut candidates {\n479\t            candidate.budget_exhausted = true;\n480\t        }\n481\t    }\n482\t    debug!(source = ?source, count = candidates.len(), exhausted, \"retriever candidates\");\n483\t    candidates\n484\t}\n485\t\n486\tfn resolved_symbols(anchors: &[ResolvedAnchor]) -> Vec<(Identity, LegacySymbolId)> {\n487\t    anchors\n488\t        .iter()\n489\t        .filter_map(|anchor| match &anchor.resolution {\n490\t            AnchorResolution::Resolved(Identity::Symbol(symbol)) => {\n491\t                Some((Identity::Symbol(symbol.clone()), legacy_symbol_id(symbol)))\n492\t            }\n493\t            _ => None,\n494\t        })\n495\t        .collect()\n496\t}\n497\t\n498\tfn source_enabled(intent: &IntentClassification, source: CandidateSource) -> bool {\n499\t    if intent.primary_label == IntentLabel::UpdateDocs {"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da3236