{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CB7FKhGKSt1L4qVvvQmLFu","type":"tool_result","content":"1\tuse std::ops::Deref;\n2\tuse std::sync::atomic::{AtomicU64, Ordering};\n3\tuse std::sync::{Arc, Mutex};\n4\tuse std::time::{SystemTime, UNIX_EPOCH};\n5\t\n6\tuse rusqlite::types::Value;\n7\tuse rusqlite::{params, params_from_iter, Connection, OptionalExtension, Transaction};\n8\tuse serde_json::json;\n9\tuse thiserror::Error;\n10\t\n11\tuse super::{\n12\t    classify_stream, decode_json_column, insert_evidence, replay::capture_replay_snapshot,\n13\t    row_decode_error, warn_on_fk_violation, AssertionType, EvidenceAnchor, EvidenceReference,\n14\t    FreshnessPolicy, InvalidationTrigger, MemoryAccessRecord, MemoryClass, MemoryEvidence,\n15\t    MemoryEvidenceError, MemoryEvidenceId, MemoryGraphParseError, MemoryLinkReference,\n16\t    MemoryRecord, MemoryReplayError, MemoryScope, ScopeError, ScopeFilter, TestId,\n17\t    ValidityCondition, VerificationStatus,\n18\t};\n19\tuse crate::events::{\n20\t    Actor, BranchRef, CompactSummary, EventKind, EventPayload, EventWriteError, EventWriter,\n21\t    FlushPolicy, MemoryCreatedPayload, MemoryInvalidatedPayload, MemoryUpdatedPayload,\n22\t    PartialEnvelope, SessionId, StableRef,\n23\t};\n24\tuse crate::identity::{\n25\t    decode_identity, encode_identity, EventId, FileId, Identity, MemoryId, SectionId, SymbolId,\n26\t};\n27\tuse crate::{DateTime, Utc};\n28\t\n29\tconst MEMORY_SCHEMA_VERSION: i64 = 1;\n30\tconst ULID_ALPHABET: &[u8; 32] = b\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\n31\tstatic MEMORY_ULID_COUNTER: AtomicU64 = AtomicU64::new(0);\n32\t\n33\t#[derive(Clone, Debug, PartialEq, Eq, Hash)]\n34\tpub struct IdempotencyKey(String);\n35\t\n36\timpl IdempotencyKey {\n37\t    pub fn new(value: impl Into<String>) -> Result<Self, MemoryStoreError> {\n38\t        let value = value.into();\n39\t        if value.trim().is_empty() {\n40\t            return Err(MemoryStoreError::Identity(\n41\t                crate::events::IdentityError::EmptyField {\n42\t                    field: \"idempotency_key\",\n43\t                },\n44\t            ));\n45\t        }\n46\t        Ok(Self(value))\n47\t    }\n48\t\n49\t    pub fn as_str(&self) -> &str {\n50\t        self.0.as_str()\n51\t    }\n52\t}\n53\t\n54\t#[derive(Clone, Debug, PartialEq)]\n55\tpub struct MemoryScopeState {\n56\t    pub scope: MemoryScope,\n57\t    pub scope_session_id: Option<String>,\n58\t    pub scope_branch: Option<String>,\n59\t    pub scope_workspace_id: Option<String>,\n60\t    pub scope_user_id: Option<String>,\n61\t    pub scope_org_id: Option<String>,\n62\t}\n63\t\n64\t#[derive(Clone, Debug, PartialEq)]\n65\tpub struct MemoryDraft {\n66\t    pub content: String,\n67\t    pub class: MemoryClass,\n68\t    pub assertion_type: AssertionType,\n69\t    pub scope: MemoryScopeState,\n70\t    pub confidence: f64,\n71\t    pub confidence_reason: String,\n72\t    pub freshness_policy: FreshnessPolicy,\n73\t    pub validity_conditions: Vec<ValidityCondition>,\n74\t    pub invalidation_triggers: Vec<InvalidationTrigger>,\n75\t    pub provenance_event_ids: Vec<EventId>,\n76\t    pub evidence_references: Vec<EvidenceReference>,\n77\t    pub linked_files: Vec<FileId>,\n78\t    pub linked_symbols: Vec<SymbolId>,\n79\t    pub linked_docs: Vec<SectionId>,\n80\t    pub linked_tests: Vec<TestId>,\n81\t    pub linked_memories: Vec<MemoryLinkReference>,\n82\t    pub contradiction_links: Vec<MemoryLinkReference>,\n83\t    pub supersession_links: Vec<MemoryLinkReference>,\n84\t    pub access_history: Vec<MemoryAccessRecord>,\n85\t    pub created_by: String,\n86\t    pub updated_by: String,\n87\t    pub superseded_by: Option<MemoryId>,\n88\t    pub schema_version: i64,\n89\t    pub initial_evidence: Vec<MemoryEvidence>,\n90\t}\n91\t\n92\t#[derive(Clone, Debug, Default, PartialEq)]\n93\tpub struct MemoryPatch {\n94\t    pub content: Option<String>,\n95\t    pub confidence: Option<f64>,\n96\t    pub freshness_