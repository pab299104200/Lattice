hat\", \"level\", \"data\", \"name\", \"id\", \"ids\", \"key\",\n33\t    \"val\", \"value\", \"result\", \"error\", \"endpoint\", \"params\", \"args\", \"options\", \"config\", \"state\",\n34\t    \"status\", \"count\", \"index\", \"size\", \"total\", \"raw\", \"base\", \"node\", \"entry\", \"record\", \"row\",\n35\t    \"col\", \"field\", // Programming language keywords / primitives\n36\t    \"type\", \"async\", \"await\", \"impl\", \"func\", \"def\", \"class\", \"pub\", \"fn\", \"mut\", \"ref\", \"var\",\n37\t    \"let\", \"const\", \"return\", \"export\", \"default\", \"int\", \"str\", \"bool\", \"num\", \"obj\", \"err\",\n38\t    \"ctx\",\n39\t];\n40\t\n41\t/// Queries with these keywords are asking for docs-first results rather than\n42\t/// source-first implementation context.\n43\tconst DOCUMENT_RESULT_QUERY_KEYWORDS: &[&str] = &[\n44\t    \"docs\",\n45\t    \"documentation\",\n46\t    \"document\",\n47\t    \"markdown\",\n48\t    \"readme\",\n49\t    \"guide\",\n50\t    \"manual\",\n51\t    \"runbook\",\n52\t    \"adr\",\n53\t    \"section\",\n54\t    \"sections\",\n55\t];\n56\t\n57\tconst FILE_SUMMARY_VECTOR_NAME: &str = \"file_summary\";\n58\tconst FILE_SUMMARY_VECTOR_OFFSET: usize = usize::MAX;\n59\t\n60\t/// A candidate node with its computed score for ranking.\n61\tstruct ScoredCandidate<'a> {\n62\t    node: &'a GraphNode,\n63\t    score: f64,\n64\t    _semantic_sim: f64,\n65\t    /// Whether this node was a direct seed hit (keyword/semantic match)\n66\t    /// vs reached only through graph traversal.\n67\t    is_seed_hit: bool,\n68\t    /// How this node was reached (e.g., \"semantic_match: 0.91\" or \"called_by: loginUser\").\n69\t    relationship_detail: String,\n70\t}\n71\t\n72\t/// The query engine orchestrates intent detection, search, graph traversal,\n73\t/// ranking, and budget allocation to produce Context Capsules.\n74\tpub struct QueryEngine {\n75\t    graph: CodeGraph,\n76\t    vector_index: Option<SharedVectorIndex>,\n77\t    memory_store