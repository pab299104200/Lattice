{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XtheUtSECnd3KWcBHBW5XE","type":"tool_result","content":"1\t//! Scope enforcement for durable memory retrieval.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## 8. Verification Engine`:\n5\t//!\n6\t//! Verification checks:\n7\t//!\n8\t//! - linked files still exist\n9\t//! - linked symbols still exist\n10\t//! - cited docs still exist\n11\t//! - linked tests still exist\n12\t//! - evidence text still matches when exact spans were captured\n13\t//! - implementation still matches memory claim where deterministic checks are possible\n14\t//! - contradicted/superseded states remain coherent\n15\t//! - branch-scoped memory is not leaking into unrelated branches\n16\t//! - time-bound memory has expired\n17\t//!\n18\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n19\t//! `## Risks — Scope Leakage`:\n20\t//!\n21\t//! Risk: user/org/branch memories leak into wrong workspaces.\n22\t//!\n23\t//! Control: scope-aware queries, enforced filters in store APIs, and negative tests.\n24\t\n25\tuse crate::events::BranchRef;\n26\tuse crate::identity::WorkspaceId;\n27\tuse crate::memory::{Memory, MemoryScope};\n28\tuse crate::verification::{VerificationStatus, VerificationVerdict};\n29\t\n30\tpub type OrganizationId = String;\n31\t\n32\t#[derive(Clone, Debug, PartialEq, Eq)]\n33\tpub struct ScopeFilter {\n34\t    pub workspace_id: WorkspaceId,\n35\t    pub branch: Option<BranchRef>,\n36\t    pub organization_id: Option<OrganizationId>,\n37\t    pub session_id: Option<String>,\n38\t}\n39\t\n40\t#[derive(Debug, thiserror::Error, PartialEq, Eq)]\n41\tpub enum ScopeFilterError {\n42\t    #[error(\"scope filter requires a workspace id\")]\n43\t    MissingWorkspaceId,\n44\t    #[error(\"scope filter has an empty branch name\")]\n45\t    EmptyBranch,\n46\t    #[error(\"scope filter has an empty organization id\")]\n47\t    EmptyOrganizationId,\n48\t    #[error(\"scope filter has an empty session id\")]\n49\t    EmptySessionId,\n50\t}\n51\t\n52\timpl ScopeFilter {\n53\t    pub fn new(\n54\t        workspace_id: impl Into<WorkspaceId>,\n55\t        branch: Option<BranchRef>,\n56\t        organization_id: Option<OrganizationId>,\n57\t    ) -> Self {\n58\t        Self {\n59\t            workspace_id: workspace_id.into(),\n60\t            branch,\n61\t            organization_id,\n62\t            session_id: None,\n63\t        }\n64\t    }\n65\t\n66\t    pub fn for_session(mut self, session_id: impl Into<String>) -> Self {\n67\t        self.session_id = Some(session_id.into());\n68\t        self\n69\t    }\n70\t\n71\t    pub fn validate(&self) -> Result<(), ScopeFilterError> {\n72\t        if self.workspace_id.is_empty() {\n73\t            return Err(ScopeFilterError::MissingWorkspaceId);\n74\t        }\n75\t        if self\n76\t            .branch\n77\t            .as_ref()\n78\t            .is_some_and(|branch| branch.name.is_empty())\n79\t        {\n80\t            return Err(ScopeFilterError::EmptyBranch);\n81\t        }\n82\t        if self\n83\t            .organization_id\n84\t            .as_ref()\n85\t            .is_some_and(|organization_id| organization_id.is_empty())\n86\t        {\n87\t            return Err(ScopeFilterError::EmptyOrganizationId);\n88\t        }\n89\t        if self\n90\t            .session_id\n91\t            .as_ref()\n92\t            .is_some_and(|session_id| session_id.is_empty())\n93\t        {\n94\t            return Err(ScopeFilterError::EmptySessionId);\n95\t        }\n96\t        Ok(())\n97\t    }\n98\t}\n99\t\n100\tpub fn allows(memory: &Memory, filter: &ScopeFilter) -> bool {\n101\t    if filter.validate().is_err() {\n102\t        return false;\n103\t    }\n104\t\n105\t    match memory.scope {\n106\t        MemoryScope::Session => filter\n107\t            .session_id\n108\t            .as_ref()\n109\t            .is_some_and(|session_id| session_id == &memory.session_id),\n110\t        MemoryScope::Branch => {\n111\t            let Some(branch) = &filter.branch else {\n112\t                return false;\n113\t            };\n114\t            memory.workspace_id.as_ref() == Some(&filter.workspace_id)\n115\t                && memory.branch.as_ref() == Some(&branch.name)\n116\t        }\n117\t        MemoryScope::Repo => memory.workspace_id.as_ref() == Some(&filter.workspace_id),\n118\t        MemoryScope::Organization => {\n119\t            filter\n120\t                .organization_id\n121\t                .as_ref()\n122\t                .is_some_and(|organization_id| {\n123\t                    memory.scope_organization_id.as_ref() == Some(organization_id)\n124\t                })\n125\t        }\n126\t    }\n127\t}\n128\t\n129\tpub struct ScopeEnforcement;\n130\t\n131\timpl ScopeEnforcement {\n132\t    pub fn audit_memory(memory: &Memory, filter: &ScopeFilter) -> VerificationVerdict {\n133\t        if allows(memory, filter) {\n134\t            return VerificationVerdict::new(VerificationStatus::Verified, \"ScopeHolds\");\n135\t        }\n136\t\n137\t        VerificationVerdict::new(VerificationStatus::Invalidated, \"ScopeLeak\")\n138\t    }\n139\t}\n140\t\n141\t#[derive(Clone, Debug, PartialEq, Eq)]\n142\tpub struct MemoryScopeFilteredEvent {\n143\t    pub memory_id: String,\n144\t    pub attempted_workspace_id: WorkspaceId,\n145\t    pub attempted_branch: Option<String>,\n146\t    pub memory_scope: MemoryScope,\n147\t}\n148\t\n149\timpl MemoryScopeFilteredEvent {\n150\t    pub fn from_memory(memory: &Memory, filter: &ScopeFilter) -> Self {\n151\t        Self {\n152\t            memory_id: memory.id.clone(),\n153\t            attempted_workspace_id: filter.workspace_id.clone(),\n154\t            attempted_branch: filter.branch.as_ref().map(|branch| branch.name.clone()),\n155\t            memory_scope: memory.scope.clone(),\n156\t        }\n157\t    }\n158\t}\n159\t"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"79712b11-2e9d-482f-bcda-02dd9771e838","timestamp":"2026-05-17T13:10:22.670Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/scope_enforcement.rs","content":"//! Scope enforcement for durable memory retrieval.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 8. Verification Engine`:\n//!\n//! Verification checks:\n//!\n//! - linked files still exist\n//! - linked symbols still exist\n//! - cited docs still exist\n//! - linked tests still exist\n//! - evidence text still matches when exact spans were captured\n//! - implementation still matches memory claim where deterministic checks are possible\n//! - contradicted/superseded states remain coherent\n//! - branch-scoped memory is not leaking into unrelated branches\n//! - time-bound memory has expired\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Risks — Scope Leakage`:\n//!\n//! Risk: user/org/branch memories leak into wrong workspaces.\n//!\n//! Control: scope-aware queries, enforced filters in store APIs, and negative tests.\n\nuse crate::events::BranchRef;\nuse crate::identity::WorkspaceId;\nuse crate::memory::{Memory, MemoryScope};\nuse crate::verification::{VerificationStatus, VerificationVerdict};\n\npub type OrganizationId = String;\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct ScopeFilter {\n    pub workspace_id: WorkspaceId,\n    pub branch: Option<BranchRef>,\n    pub organization_id: Option<OrganizationId>,\n    pub session_id: Option<String>,\n}\n\n#[derive(Debug, thiserror::Error, PartialEq, Eq)]\npub enum ScopeFilterError {\n    #[error(\"scope filter requires a workspace id\")]\n    MissingWorkspaceId,\n    #[error(\"scope filter has an empty branch name\")]\n    EmptyBranch,\n    #[error(\"scope filter has an empty organization id\")]\n    EmptyOrganizationId,\n    #[error(\"scope filter has an empty session id\")]\n    EmptySessionId,\n}\n\nimpl ScopeFilter {\n    pub fn new(\n        workspace_id: impl Into<WorkspaceId>,\n        branch: Option<BranchRef>,\n        organization_id: Option<OrganizationId>,\n    ) -> Self {\n        Self {\n            workspace_id: workspace_id.into(),\n            branch,\n            organization_id,\n            session_id: None,\n        }\n    }\n\n    pub fn for_session(mut self, session_id: impl Into<String>) -> Self {\n        self.session_id = Some(session_id.into());\n        self\n    }\n\n    pub fn validate(&self) -> Result<(), ScopeFilterError> {\n        if self.workspace_id.is_empty() {\n            return Err(ScopeFilterError::MissingWorkspaceId);\n        }\n        if self\n            .branch\n            .as_ref()\n            .is_some_and(|branch| branch.name.is_empty())\n        {\n            return Err(ScopeFilterError::EmptyBranch);\n        }\n        if self\n            .organization_id\n            .as_ref()\n            .is_some_and(|organization_id| organization_id.is_empty())\n        {\n            return Err(ScopeFilterError::EmptyOrganizationId);\n        }\n        if self\n            .session_id\n            .as_ref()\n            .is_some_and(|session_id| session_id.is_empty())\n        {\n            return Err(ScopeFilterError::EmptySessionId);\n        }\n        Ok(())\n    }\n}\n\npub fn allows(memory: &Memory, filter: &ScopeFilter) -> bool {\n    if filter.validate().is_err() {\n        return false;\n    }\n\n    match memory.scope {\n        MemoryScope::Session => filter\n            .session_id\n            .as_ref()\n            .is_some_and(|session_id| session_id == &memory.session_id),\n        MemoryScope::Branch => {\n            let Some(branch) = &filter.branch else {\n                return false;\n            };\n            memory.workspace_id.as_ref() == Some(&filter.workspace_id)\n                && memory.branch.as_ref() == Some(&branch.name)\n        }\n        MemoryScope::Repo => memory.workspace_id.as_ref() == Some(&filter.workspace_id),\n        MemoryScope::Organization => {\n            filter\n                .organization_id\n                .as_ref()\n                .is_some_and(|organization_id| {\n                    memory.scope_organization_id.as_ref() == Some(organization_id)\n                })\n        }\n    }\n}\n\npub struct ScopeEnforcement;\n\nimpl ScopeEnforcement {\n    pub fn audit_memory(memory: &Memory, filter: &ScopeFilter) -> VerificationVerdict {\n        if allows(memory, filter) {\n            return VerificationVerdict::new(VerificationStatus::Verified, \"ScopeHolds\");\n        }\n\n        VerificationVerdict::new(VerificationStatus::Invalidated, \"ScopeLeak\")\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct MemoryScopeFilteredEvent {\n    pub memory_id: String,\n    pub attempted_workspace_id: WorkspaceId,\n    pub attempted_branch: Option<String>,\n    pub memory_scope: MemoryScope,\n}\n\nimpl MemoryScopeFilteredEvent {\n    pub fn from_memory(memory: &Memory, filter: &ScopeFilter) -> Self {\n        Self {\n            memory_id: memory.id.clone(),\n            attempted_workspace_id: filter.workspace_id.clone(),\n            attempted_branch: filter.branch.as_ref().map(|branch| branch.name.clone()),\n            memory_scope: memory.scope.clone(),\n        }\n    }\n}\n","numLines":159,"startLine":1,"totalLines":159}}}
