{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0148Y8jq92s1MR4SKF6wzVDn","type":"tool_result","content":"120\t    let _guard = tracing::subscriber::set_default(subscriber);\n121\t\n122\t    let ids = harness.seed_scope_leak_fixture();\n123\t    let results = harness.run_scope_leak_queries();\n124\t    let events = harness\n125\t        .memory_store\n126\t        .scope_filter_events()\n127\t        .expect(\"scope events load\");\n128\t    let log_output = String::from_utf8(logs.lock().expect(\"log lock\").clone()).expect(\"utf8\");\n129\t\n130\t    assert!(results.into_iter().all(|memory| memory.is_none()));\n131\t    assert_eq!(events.len(), 4);\n132\t    assert_eq!(\n133\t        events\n134\t            .iter()\n135\t            .map(|event| event.memory_id.as_str())\n136\t            .collect::<Vec<_>>(),\n137\t        ids.iter().map(String::as_str).collect::<Vec<_>>()\n138\t    );\n139\t    assert!(log_output.contains(\"scope_leak_blocked\"));\n140\t}\n141\t\n142\t#[test]\n143\tfn test_ranker_excludes_non_verified_from_top_n() {\n144\t    let harness = VerificationHarness::new();\n145\t    let ids = harness.seed_ranker_fixture();\n146\t    let ranked = ids\n147\t        .iter()\n148\t        .enumerate()\n149\t        .map(|(index, id)| ranked_memory(id, 100.0 - index as f32))\n150\t        .collect::<Vec<_>>();\n151\t    let ctx = harness.scoring_context_for(&ids);\n152\t\n153\t    let trusted = SurfacingPipeline::trusted_ranked_top_n(ranked, &ctx, 5);\n154\t\n155\t    assert_eq!(trusted.len(), 1);\n156\t    assert_eq!(\n157\t        trusted[0].candidate.identity,\n158\t        memory_identity(\"mem-verified\")\n159\t    );\n160\t}\n161\t\n162\t#[test]\n163\tfn test_incremental_verification_narrows_to_changed_files_only() {\n164\t    let harness = VerificationHarness::new();\n165\t    let files = harness.seed_many_file_memories(100);\n166\t    let changed = files[7].clone();\n167\t    let observer = ObservationRecorder::default();\n