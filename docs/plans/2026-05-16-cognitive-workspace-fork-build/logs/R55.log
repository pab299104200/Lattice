config.rs\",\n373\t                qualified_name: \"WORKFLOW_CACHE_TTL\",\n374\t            },\n375\t            [0.0, 0.0, 1.0],\n376\t            110,\n377\t        ),\n378\t        case(\n379\t            \"budget_login_user_anchor_keeps_pinned_symbol_under_truncation\",\n380\t            \"Explain login_user with all supporting context for an oversized bundle\",\n381\t            AnchorKind::Symbol,\n382\t            \"login_user\",\n383\t            ExpectedIdentity::Symbol {\n384\t                file: \"src/auth.rs\",\n385\t                qualified_name: \"login_user\",\n386\t            },\n387\t            ExpectedIdentity::Symbol {\n388\t                file: \"src/auth.rs\",\n389\t                qualified_name: \"login_user\",\n390\t            },\n391\t            [1.0, 0.0, 0.0],\n392\t            65,\n393\t        ),\n394\t    ]\n395\t}\n396\t\n397\tpub(super) fn build_fixture() -> GoldenFixture {\n398\t    let files = [\n399\t        fixture_file(\n400\t            \"src/auth.rs\",\n401\t            \"pub fn login_user() {\\n    create_session();\\n    refresh_session();\\n}\\n\\n\\\n402\t             pub fn refresh_session() {\\n    create_session();\\n}\\n\",\n403\t        ),\n404\t        fixture_file(\n405\t            \"src/session.rs\",\n406\t            \"pub fn create_session() {}\\n\\npub fn session_cache() {}\\n\",\n407\t        ),\n408\t        fixture_file(\n409\t            \"src/cli.rs\",\n410\t            \"pub fn prepare_change() {\\n    search_logic_flow();\\n}\\n\\n\\\n411\t             pub fn diagnose_failure() {\\n    search_logic_flow();\\n}\\n\\n\\\n412\t             pub fn search_logic_flow() {}\\n\",\n413\t        ),\n414\t        fixture_file(\n415\t            \"src/config.rs\",\n416\t            \"pub const LATTICE_INDEX_ROOT: &str = \\\"/tmp/index\\\";\\n\\\n417\t             pub const LATTICE_EVENT_LOG: &str = \\\"/tmp/events\\\";\\n\\\n418\t             pub const WORKFLOW_CACHE_TTL: u64 = 300;\\n\",\n419\t        ),\n420\t        fixture_file(\n421\t            \"docs/guide.md\",\n422\t            \"# Guide\\n\\n## RetrievalEngine\\nUse prepare_change and search_logic_flow to debug login_user.\\n\\n\\\n423\t             ## Metrics Reporting\\nRank exact identifier matches before stale memory.\\n\",\n424\t        ),\n425\t        fixture_file(\n426\t            \"docs/ops.md\",\n427\t            \"# Operations\\n\\n## Recovery Steps\\nUse diagnose_failure and check LATTICE_EVENT_LOG.\\n\",\n428\t        ),\n429\t    ];\n430\t\n431\t    let mut graph = CodeGraph::new();\n432\t    let mut file_index = HashMap::new();\n433\t    let mut parsed_files = HashMap::new();\n434\t    let mut content_hashes = HashMap::new();\n435\t\n436\t    for file in files {\n437\t        let stored_path = file.stored_path();\n438\t        let parsed_file = parse_file(&stored_path, file.source).expect(\"fixture parses\");\n439\t        add_symbols(&mut graph, &parsed_file);\n440\t        content_hashes.insert(file.path.to_string(), content_hash(file.source));\n441\t        parsed_files.insert(stored_path.clone(), parsed_file);\n442\t        file_index.insert(\n443\t            stored_path.clone(),\n444\t            file_index_entry(&stored_path, file.source),\n445\t        );\n446\t    }\n447\t\n448\t    add_edge(\n449\t        &mut graph,\n450\t        \"src/auth.rs\",\n451\t        \"login_user\",\n452\t        \"src/session.rs\",\n453\t        \"create_session\",\n454\t    );\n455\t    add_edge(\n456\t        &mut graph,\n457\t        \"src/auth.rs\",\n458\t        \"refresh_session\",\n459\t        \"src/session.rs\",\n460\t        \"create_session\",\n461\t    );\n462\t    add_edge(\n463\t        &mut graph,\n464\t        \"src/cli.rs\",\n465\t        \"prepare_change\",\n466\t        \"src/cli.rs\",\n467\t        \"search_logic_flow\",\n468\t    );\n469\t    add_edge(\n470\t        &mut graph,\n471\t        \"src/cli.rs\",\n472\t        \"diagnose_failure\",\n473\t        \"src/cli.rs\",\n474\t        \"search_logic_flow\",\n475\t    );\n476\t    add_edge(\n477\t        &mut graph,\n478\t        \"docs/guide.md\",\n479\t        \"RetrievalEngine\",\n480\t        \"src/cli.rs\",\n481\t        \"prepare_change\",\n482\t    );\n483\t    add_edge(\n484\t        &mut graph,\n485\t        \"docs/guide.md\",\n486\t        \"RetrievalEngine\",\n487\t        \"src/cli.rs\",\n488\t        \"search_logic_flow\",\n489\t    );\n490\t    add_edge(\n491\t        &mut graph,\n492\t        \"docs/guide.md\",\n493\t        \"RetrievalEngine\",\n494\t        \"src/auth.rs\",\n495\t        \"login_user\",\n496\t    );\n497\t    add_edge(\n498\t        &mut graph,\n499\t        \"docs/ops.md\",\n500\t        \"Recovery Steps\",\n501\t        \"src/cli.rs\",\n502\t        \"diagnose_failure\",\n503\t    );\n504\t    add_edge(\n505\t        &mut graph,\n506\t        \"docs/ops.md\",\n507\t        \"Recovery Steps\",\n508\t        \"src/config.rs\",\n509\t        \"LATTICE_EVENT_LOG\",\n510\t    );\n511\t\n512\t    let graph = Box::leak(Box::new(graph));\n513\t    let file_index = Box::leak(Box::new(file_index));\n514\t    let parsed_files = Box::leak(Box::new(parsed_files));\n515\t    let resolver = IdentityResolver::new(\n516\t        graph,\n517\t        file_index,\n518\t        parsed_files,\n519\t        WORKSPACE.to_string(),\n520\t        Vec::new(),\n521\t    );\n522\t\n523\t    let memory_store = memory_store();\n524\t    let vector_store = vector_store();\n525\t    let working_memory = vec![\n526\t        zero_file(\"src/auth.rs\"),\n527\t        zero_file(\"src/session.rs\"),\n528\t        zero_file(\"src/cli.rs\"),\n529\t        zero_file(\"docs/guide.md\"),\n530\t    ];\n531\t    let events = vec![\n532\t        workflow_event(\n533\t            \"01ARZ3NDEKTSV4RRFFQ69G5FB0\",\n534\t            \"prepare_change auth workflow\",\n535\t            vec![StableRef::SymbolRef(zero_symbol(\n536\t                \"src/auth.rs\",\n537\t                \"login_user\",\n538\t            ))],\n539\t        ),\n540\t        workflow_event(\n541\t            \"01ARZ3NDEKTSV4RRFFQ69G5FB1\",\n542\t            \"diagnose_failure replay workflow\",\n543\t            vec![StableRef::FileRef(zero_file_id(\"src/cli.rs\"))],\n544\t        ),\n545\t        started_event(\n546\t            \"01ARZ3NDEKTSV4RRFFQ69G5FB2\",\n547\t            \"replay LATTICE_EVENT_LOG after auth failure\",\n548\t            vec![StableRef::SymbolRef(zero_symbol(\n549\t                \"src/config.rs\",\n550\t                \"LATTICE_EVENT_LOG\",\n551\t            ))],\n552\t        ),\n553\t    ];\n554\t\n555\t    let scoring_context = scoring_context(&content_hashes, &resolver);\n556\t\n557\t    GoldenFixture {\n558\t        resolver,\n559\t        graph,\n560\t        memory_store,\n561\t        vector_store,\n562\t        events,\n563\t        working_memory,\n564\t        scoring_context,\n565\t    }\n566\t}\n567\t\n568\tpub(super) async fn execute_case(case: &GoldenCase, fixture: &GoldenFixture) -> GoldenRun {\n569\t    let intent = classify_intent(case.task);\n570\t    let anchors = resolve_anchors(extract_anchors(case.task, &intent), &fixture.resolver);\n571\t    let budget = RetrievalBudget {\n572\t        max_candidates_per_source: 8,\n573\t        max_graph_hops: 2,\n574\t        max_fts_rows: 8,\n575\t        embedding_k: 6,\n576\t        event_window: 6,\n577\t        working_memory_window: 4,\n578\t    };\n579\t    let ctx = RetrievalContext {\n580\t        workspace_id: WORKSPACE,\n581\t        graph: Some(fixture.graph),\n582\t        memory_store: Some(&fixture.memory_store),\n583\t        vector_index: Some(&fixture.vector_store),\n584\t        query_embedding: Some(&case.query_embedding),\n585\t        event_candidates: &fixture.events,\n586\t        recent_working_memory: &fixture.working_memory,\n587\t    };\n588\t\n589\t    let started = Instant::now();\n590\t    let candidates = retrieve_candidates(&intent, &anchors, &budget, &ctx).await;\n591\t    let weights = ScoringWeights::default();\n592\t    let ranked = score_candidates(\n593\t        candidates,\n594\t        &intent,\n595\t        &anchors,\n596\t        &weights,\n597\t        DiagnosticMode::Diagnostic,\n598\t        &fixture.scoring_context,\n599\t    );\n600\t    let diagnostics =\n601\t        RankingDiagnostics::new(intent.clone(), anchors.clone(), ranked.clone(), weights);\n602\t    let pins = HashSet::from([pin_identity_for_case(&case.expected_top_identity, &ranked)]);\n603\t    let shaping_budget = if case.shaper_token_budget < 100 {\n604\t        case.shaper_token_budget\n605\t    } else {\n606\t        1_000\n607\t    };\n608\t    let bundle = shape_retrieval_bundle(\n609\t        case.name,\n610\t        format!(\"{:?}\", intent.primary_label),\n611\t        anchors\n612\t            .iter()\n613\t            .map(|anchor| anchor.anchor_text.as_str())\n614\t            .collect::<Vec<_>>()\n615\t            .join(\", \"),\n616\t        ranked.clone(),\n617\t        DiagnosticMode::Diagnostic,\n618\t        Some(diagnostics.clone()),\n619\t        &ShaperContext {\n620\t            pins,\n621\t            budget: ShaperBudget {\n622\t                max_tokens: shaping_budget,\n623\t            },\n624\t        },\n625\t    );\n626\t\n627\t    GoldenRun {\n628\t        anchors,\n629\t        ranked,\n630\t        diagnostics,\n631\t        bundle,\n632\t        latency_ms: started.elapsed().as_secs_f64() * 1_000.0,\n633\t    }\n634\t}\n635\t\n636\tpub(super) fn stale_memory_rank(run: &GoldenRun) -> Option<usize> {\n637\t    run.ranked\n638\t        .iter()\n639\t        .position(|candidate| matches_memory(&candidate.candidate.identity, MEMORY_AUTH_STALE))\n640\t        .map(|index| index + 1)\n641\t}\n642\t\n643\tpub(super) fn verified_memory_rank(run: &GoldenRun, ulid: &str) -> Option<usize> {\n644\t    run.ranked\n645\t        .iter()\n646\t        .position(|candidate| matches_memory(&candidate.candidate.identity, ulid))\n647\t        .map(|index| index + 1)\n648\t}\n649\t\n650\tpub(super) fn is_stale_memory(identity: &Identity) -> bool {\n651\t    matches_memory(identity, MEMORY_AUTH_STALE)\n652\t}\n653\t\n654\tpub(super) fn top_identity_matches(case: &GoldenCase, run: &GoldenRun) -> bool {\n655\t    run.ranked\n656\t        .first()\n657\t        .map(|candidate| {\n658\t            case.expected_top_identity\n659\t                .matches(&candidate.candidate.identity)\n660\t        })\n661\t        .unwrap_or(false)\n662\t}\n663\t\n664\tfn case(\n665\t    name: &'static str,\n666\t    task: &'static str,\n667\t    anchor_kind: AnchorKind,\n668\t    expected_anchor_text: &'static str,\n669\t    expected_resolved_identity: ExpectedIdentity,\n670\t    expected_top_identity: ExpectedIdentity,\n671\t    query_embedding: [f32; 3],\n672\t    shaper_token_budget: usize,\n673\t) -> GoldenCase {\n674\t    GoldenCase {\n675\t        name,\n676\t        task,\n677\t        anchor_kind,\n678\t        expected_anchor_text,\n679\t        expected_resolved_identity,\n680\t        expected_top_identity,\n681\t        dominant_signal: \"exact id\",\n682\t        shaper_token_budget,\n683\t        query_embedding,\n684\t    }\n685\t}\n686\t\n687\tfn pin_identity_for_case(expected: &ExpectedIdentity, ranked: &[RankedCandidate]) -> Identity {\n688\t    ranked\n689\t        .iter()\n690\t        .find(|candidate| expected.matches(&candidate.candidate.identity))\n691\t        .or_else(|| ranked.first())\n692\t        .map(|candidate| candidate.candidate.identity.clone())\n693\t        .unwrap_or_else(|| panic!(\"missing ranked output for {}\", expected.label()))\n694\t}\n695\t\n696\tfn matches_memory(identity: &Identity, ulid: &str) -> bool {\n697\t    matches!(identity, Identity::Memory(memory) if memory.ulid == ulid)\n698\t}\n699\t\n700\tfn memory_store() -> MemoryStore {\n701\t    let store = MemoryStore::open_in_memory().expect(\"memory store\");\n702\t    for memory in [\n703\t        memory(\n704\t            MEMORY_AUTH_VERIFIED,\n705\t            \"login_user hands off to create_session before issuing a session token\",\n706\t            &[\"login_user\", \"create_session\"],\n707\t            &[\"src/auth.rs\", \"src/session.rs\"],\n708\t            false,\n709\t        ),\n710\t        memory(\n711\t            MEMORY_AUTH_STALE,\n712\t            \"login_user writes the session inline without create_session\",\n713\t            &[\"login_user\"],\n714\t            &[\"src/auth.rs\"],\n715\t            true,\n716\t        ),\n717\t        memory(\n718\t            MEMORY_SESSION_VERIFIED,\n719\t            \"refresh_session eventually relies on create_session and session_cache\",\n720\t            &[\"refresh_session\", \"create_session\"],\n721\t            &[\"src/session.rs\"],\n722\t            false,\n723\t        ),\n724\t        memory(\n725\t            MEMORY_CLI_VERIFIED,\n726\t            \"prepare_change and diagnose_failure both route through search_logic_flow\",\n727\t            &[\"prepare_change\", \"diagnose_failure\", \"search_logic_flow\"],\n728\t            &[\"src/cli.rs\"],\n729\t            false,\n730\t        ),\n731\t        memory(\n732\t            MEMORY_DOCS_VERIFIED,\n733\t            \"docs/guide.md RetrievalEngine explains prepare_change and exact identifier ranking\",\n734\t            &[\"prepare_change\", \"search_logic_flow\"],\n735\t            &[\"docs/guide.md\"],\n736\t            false,\n737\t        ),\n738\t        memory(\n739\t            MEMORY_CONFIG_VERIFIED,\n740\t            \"LATTICE_INDEX_ROOT and LATTICE_EVENT_LOG are the config entry points for retrieval replay\",\n741\t            &[\"LATTICE_INDEX_ROOT\", \"LATTICE_EVENT_LOG\", \"WORKFLOW_CACHE_TTL\"],\n742\t            &[\"src/config.rs\"],\n743\t            false,\n744\t        ),\n745\t    ] {\n746\t        store.store(memory).expect(\"store fixture memory\");\n747\t    }\n748\t    store\n749\t}\n750\t\n751\tfn vector_store() -> VectorStore {\n752\t    let store = VectorStore::open_in_memory().expect(\"vector store\");\n753\t    store.initialize(3).expect(\"vector schema\");\n754\t    for (file, symbol, embedding) in [\n755\t        (\"src/auth.rs\", \"login_user\", [1.0, 0.0, 0.0]),\n756\t        (\"src/auth.rs\", \"refresh_session\", [1.0, 0.0, 0.0]),\n757\t        (\"src/cli.rs\", \"prepare_change\", [0.0, 1.0, 0.0]),\n758\t        (\"src/cli.rs\", \"diagnose_failure\", [0.0, 1.0, 0.0]),\n759\t        (\"src/cli.rs\", \"search_logic_flow\", [0.0, 1.0, 0.0]),\n760\t        (\"src/config.rs\", \"LATTICE_INDEX_ROOT\", [0.0, 0.0, 1.0]),\n761\t        (\"src/config.rs\", \"LATTICE_EVENT_LOG\", [0.0, 0.0, 1.0]),\n762\t        (\"src/config.rs\", \"WORKFLOW_CACHE_TTL\", [0.0, 0.0, 1.0]),\n763\t    ] {\n764\t        store\n765\t            .upsert_vector(file, symbol, 0, &embedding)\n766\t            .expect(\"vector upsert\");\n767\t    }\n768\t    store\n769\t}\n770\t\n771\tfn scoring_context(\n772\t    content_hashes: &HashMap<String, String>,\n773\t    resolver: &IdentityResolver<'_>,\n774\t) -> ScoringContext {\n775\t    let mut ctx = ScoringContext {\n776\t        now_unix_seconds: Some(2_000),\n777\t        ..ScoringContext::default()\n778\t    };\n779\t\n780\t    for (ulid, status, scope, confidence, evidence_count, created_at) in [\n781\t        (\n782\t            MEMORY_AUTH_VERIFIED,\n783\t            MemoryVerificationStatus::Verified,\n784\t            MemoryScope::Branch,\n785\t            0.55,\n786\t            1usize,\n787\t            1_980u64,\n788\t        ),\n789\t        (\n790\t            MEMORY_AUTH_STALE,\n791\t            MemoryVerificationStatus::Stale,\n792\t            MemoryScope::Repo,\n793\t            0.20,\n794\t            1usize,\n795\t            1_400u64,\n796\t        ),\n797\t        (\n798\t            MEMORY_SESSION_VERIFIED,\n799\t            MemoryVerificationStatus::Verified,\n800\t            MemoryScope::Branch,\n801\t            0.50,\n802\t            1usize,\n803\t            1_975u64,\n804\t        ),\n805\t        (\n806\t            MEMORY_CLI_VERIFIED,\n807\t            MemoryVerificationStatus::Verified,\n808\t            MemoryScope::Branch,\n809\t            0.48,\n810\t            1usize,\n811\t            1_990u64,\n812\t        ),\n813\t        (\n814\t            MEMORY_DOCS_VERIFIED,\n815\t            MemoryVerificationStatus::Verified,\n816\t            MemoryScope::Branch,\n817\t            0.46,\n818\t            1usize,\n819\t            1_995u64,\n820\t        ),\n821\t        (\n822\t            MEMORY_CONFIG_VERIFIED,\n823\t            MemoryVerificationStatus::Verified,\n824\t            MemoryScope::Branch,\n825\t            0.47,\n826\t            1usize,\n827\t            1_992u64,\n828\t        ),\n829\t    ] {\n830\t        let is_stale = status == MemoryVerificationStatus::Stale;\n831\t        let identity = Identity::Memory(MemoryId {\n832\t            workspace_id: WORKSPACE.to_string(),\n833\t            ulid: ulid.to_string(),\n834\t        });\n835\t        ctx.memory_metadata.insert(\n836\t            identity.to_string(),\n837\t            crate::retrieval_v1::MemoryScoringMetadata {\n838\t                verification_status: status,\n839\t                scope,\n840\t                confidence,\n841\t                evidence_count,\n842\t                created_at: Some(created_at),\n843\t                last_accessed: Some(1_998),\n844\t                access_count: 5,\n845\t                is_stale,\n846\t                superseded_by_memory_id: None,\n847\t                contradicted_by_memory_ids: Vec::new(),\n848\t            },\n849\t        );\n850\t        ctx.event_history.insert(\n851\t            identity.to_string(),\n852\t            EventScoringMetadata {\n853\t                past_usefulness_count: if ulid == MEMORY_AUTH_STALE { 0 } else { 1 },\n854\t                recent_successful_reuse_count: 0,\n855\t                occurred_at: Some(created_at),\n856\t            },\n857\t      