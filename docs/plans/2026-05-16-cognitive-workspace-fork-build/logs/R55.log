{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011TACXKsnUDtR3o97YJPW3q","type":"tool_result","content":"1\t//! Retrieval V1 compact response shaper.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## 7. Retrieval Engine` and `## Phase 4: Retrieval V1` require the\n5\t//! retrieval pipeline to deduplicate and compress ranked candidates, then emit\n6\t//! a compact bundle where every result carries an inclusion reason and an\n7\t//! expansion handle.\n8\t\n9\tuse std::collections::{BTreeMap, BTreeSet, HashSet};\n10\t\n11\tuse serde::{Deserialize, Serialize};\n12\t\n13\tuse crate::identity::{decode_identity, encode_identity, Identity, IdentityKind};\n14\t\n15\tuse super::inclusion_reasons::compact_inclusion_reason;\n16\tuse super::{\n17\t    CandidateSource, DiagnosticMode, RankedCandidate, RankingDiagnostics, SignalKind, SignalScore,\n18\t};\n19\t\n20\tconst CHARS_PER_TOKEN_ESTIMATE: usize = 4;\n21\tconst MIN_SNIPPET_CHARS: usize = 24;\n22\tconst SNIPPET_TRIM_STEP: usize = 16;\n23\t\n24\t/// `## 5. Working Memory` and `## Phase 5: Working Memory` require the bundle\n25\t/// schema to remain stable so working-memory checkpoints can store selected and\n26\t/// excluded retrieval items without rewriting the Retrieval V1 result shape.\n27\tpub mod schema {\n28\t    use super::*;\n29\t\n30\t    #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n31\t    pub struct BudgetReport {\n32\t        pub token_budget: usize,\n33\t        pub estimated_tokens: usize,\n34\t        pub trimmed_snippets: usize,\n35\t        pub dropped_results: usize,\n36\t        pub truncated: bool,\n37\t    }\n38\t\n39\t    #[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n40\t    pub struct BundleResult {\n41\t        pub identity: Identity,\n42\t        pub kind: IdentityKind,\n43\t        pub headline: String,\n44\t        pub snippet: String,\n45\t        pub inclusion_reason: String,\n46\t        pub expansion_handle: String,\n47\t        pub source: Vec<CandidateSource>,\n48\t        pub score: f32,\n49\t    }\n50\t\n51\t    #[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n52\t    pub struct RetrievalBundle {\n53\t        pub task_id: String,\n54\t        pub intent_summary: String,\n55\t        pub anchors_summary: String,\n56\t        pub results: Vec<BundleResult>,\n57\t        pub diagnostics: Option<RankingDiagnostics>,\n58\t        pub budget_report: BudgetReport,\n59\t    }\n60\t}\n61\t\n62\tpub use schema::{BudgetReport, BundleResult, RetrievalBundle};\n63\t\n64\t#[derive(Debug, Clone, PartialEq, Eq)]\n65\tpub struct ShaperBudget {\n66\t    pub max_tokens: usize,\n67\t}\n68\t\n69\t#[derive(Debug, Clone, PartialEq, Eq)]\n70\tpub struct ShaperContext {\n71\t    pub pins: HashSet<Identity>,\n72\t    pub budget: ShaperBudget,\n73\t}\n74\t\n75\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n76\tpub struct CompressionOutcome {\n77\t    pub results: Vec<BundleResult>,\n78\t    pub dropped_results: Vec<BundleResult>,\n79\t    pub budget_report: BudgetReport,\n80\t}\n81\t\n82\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n83\tpub struct ShapedRetrievalBundle {\n84\t    pub bundle: RetrievalBundle,\n85\t    pub dropped_results: Vec<BundleResult>,\n86\t}\n87\t\n88\t#[derive(Debug, Clone)]\n89\tstruct MergedCandidate {\n90\t    best: RankedCandidate,\n91\t    sources: BTreeSet<CandidateSource>,\n92\t    signal_scores: BTreeMap<SignalKind, SignalScore>,\n93\t}\n94\t\n95\timpl Default for ShaperBudget {\n96\t    fn default() -> Self {\n97\t        Self { max_tokens: 320 }\n98\t    }\n99\t}\n100\t\n101\tpub fn shape_retrieval_bundle(\n102\t    task_id: impl Into<String>,\n103\t    intent_summary: impl Into<String>,\n104\t    anchors_summary: impl Into<String>,\n105\t    ranked: Vec<RankedCandidate>,\n106\t    mode: DiagnosticMode,\n107\t    diagnostics: Option<RankingDiagnostics>,\n108\t    ctx: &ShaperContext,\n109\t) -> RetrievalBundle {\n1