{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DwT8oz4wE4T1XDeGS4GPuh","type":"tool_result","content":"1\t//! Shared fixtures, harness, and identity factories for the R26 cross-layer\n2\t//! contract tests in `identity_event_memory.rs`.\n3\t//!\n4\t//! These helpers exist so the test file can stay focused on the contract\n5\t//! surfaces it pins. Per the Cadres coding standard `## Hard limits`, this\n6\t//! support module keeps the test file under the 800-line ceiling without\n7\t//! losing the per-surface organization that makes the gate readable.\n8\t\n9\tuse std::collections::HashMap;\n10\tuse std::sync::{Arc, Mutex};\n11\t\n12\tuse rusqlite::Connection;\n13\tuse tempfile::TempDir;\n14\t\n15\tuse crate::events::{\n16\t    Actor, EventEnvelope, EventQuery, EventReader, EventStore, EventWriter, FlushPolicy,\n17\t    PartialEnvelope, QueryOrder,\n18\t};\n19\tuse crate::graph::CodeGraph;\n20\tuse crate::identity::{\n21\t    ContextHandleId, DocId, EventId, FileId, IdentityResolver, MemoryId, SectionId, SymbolId,\n22\t};\n23\tuse crate::memory_graph::store::MemoryScopeState;\n24\tuse crate::memory_graph::{\n25\t    initialize_schema, AssertionType, EvidenceAnchor, FreshnessKind, FreshnessPolicy,\n26\t    IdempotencyKey, MemoryClass, MemoryDraft, MemoryEvidence, MemoryEvidenceId, MemoryScope,\n27\t    MemoryStore,\n28\t};\n29\tuse crate::parser::parse_file;\n30\tuse crate::storage::graph_store::{\n31\t    FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n32\t};\n33\tuse crate::DateTime;\n34\t\n35\tpub(super) const WORKSPACE: &str = \"workspace\";\n36\tpub(super) const BRANCH: &str = \"main\";\n37\tpub(super) const SESSION: &str = \"contract-session\";\n38\t\n39\t// ---------------------------------------------------------------------------\n40\t// Identity factories\n41\t// ---------------------------------------------------------------------------\n42\t\n43\tpub(super) fn file_identity(path: &str) -> FileId {\n44\t    FileId {\n45\t        workspace_id: WORKSPACE.to_string(),\n46\t        repo_relative_path: path.to_string(),\n47\t        content_hash: \"feedface00000001\".to_string(),\n48\t    }\n49\t}\n50\t\n51\tpub(super) fn doc_identity(path: &str) -> DocId {\n52\t    DocId {\n53\t        workspace_id: WORKSPACE.to_string(),\n54\t        repo_relative_path: path.to_string(),\n55\t        content_hash: \"deadbeef00000002\".to_string(),\n56\t    }\n57\t}\n58\t\n59\tpub(super) fn section_identity(path: &str, heading: &str) -> SectionId {\n60\t    SectionId {\n61\t        doc: doc_identity(path),\n62\t        heading_path: vec![heading.to_string()],\n63\t        byte_offset: 64,\n64\t    }\n65\t}\n66\t\n67\tpub(super) fn symbol_identity(file: &FileId, qualified: &str) -> SymbolId {\n68\t    SymbolId {\n69\t        file: file.clone(),\n70\t        qualified_name: qualified.to_string(),\n71\t        byte_offset: 12,\n72\t        kind: \"function\".to_string(),\n73\t    }\n74\t}\n75\t\n76\tpub(super) fn context_handle_identity(seed: &str) -> ContextHandleId {\n77\t    ContextHandleId {\n78\t        workspace_id: WORKSPACE.to_string(),\n79\t        session_id: SESSION.to_string(),\n80\t        ulid: stable_ulid(seed),\n81\t    }\n82\t}\n83\t\n84\tpub(super) fn memory_identity(seed: &str) -> MemoryId {\n85\t    MemoryId {\n86\t        workspace_id: WORKSPACE.to_string(),\n87\t        ulid: stable_ulid(seed),\n88\t    }\n89\t}\n90\t\n91\tpub(super) fn stable_ulid(seed: &str) -> String {\n92\t    const ALPHABET: &[u8; 32] = b\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\n93\t    let mut bytes = [b'0'; 26];\n94\t    bytes[..24].copy_from_slice(b\"01ARZ3NDEKTSV4RRFFQ69G5F\");\n95\t    let checksum = seed.bytes().fold(0_u32, |acc, byte| {\n96\t        acc.wrapping_mul(33).wrapping_add(u32::from(byte))\n97\t    });\n98\t    bytes[24] = ALPHABET[((checksum >> 5) & 31) as usize];\n99\t    bytes[25] = ALPHABET[(checksum & 31) as usize];\n100\t    String::from_utf8(bytes.to_vec()).expect(\"stable ULID is valid ASCII\")\n101\t}\n102\t\n103\tpub(super) fn branch_scope_state() -> MemoryScopeState {\n104\t    MemoryScopeState {\n105\t        scope: MemoryScope::Branch,\n106\t        scope_session_id: None,\n107\t        scope_branch: Some(BRANCH.to_string()),\n108\t        scope_workspace_id: Some(WORKSPACE.to_string()),\n109\t        scope_user_id: None,\n110\t        scope_org_id: None,\n111\t    }\n112\t}\n113\t\n114\tpub(super) fn idem(value: &str) -> IdempotencyKey {\n115\t    IdempotencyKey::new(value.to_string()).expect(\"idempotency key\")\n116\t}\n117\t\n118\t// ---------------------------------------------------------------------------\n119\t// In-process collaborator harness\n120\t// ---------------------------------------------------------------------------\n121\t\n122\t/// Wiring that mirrors `memory_graph::tests_common::TestHarness` but lives\n123\t/// inside `contract_tests` so the cross-layer surface is exercised without\n124\t/// re-exporting a private per-substrate helper.\n125\tpub(super) struct ContractHarness {\n126\t    _tempdir: TempDir,\n127\t    pub(super) conn: Arc<Mutex<Connection>>,\n128\t    pub(super) event_store: Arc<EventStore>,\n129\t    pub(super) store: MemoryStore,\n130\t}\n131\t\n132\timpl ContractHarness {\n133\t    pub(super) fn new() -> Self {\n134\t        let tempdir = TempDir::new().expect(\"contract tempdir\");\n135\t        let conn = Connection::open(tempdir.path().join(\"memory-graph.db\"))\n136\t            .expect(\"memory graph DB opens\");\n137\t        conn.execute_batch(\"PRAGMA foreign_keys = ON;\")\n138\t            .expect(\"foreign keys enable\");\n139\t        initialize_schema(&conn).expect(\"memory graph schema initializes\");\n140\t        let conn = Arc::new(Mutex::new(conn));\n141\t        let event_store = Arc::new(\n142\t            EventStore::open(&tempdir.path().join(\"events.db\")).expect(\"event store opens\"),\n143\t        );\n144\t        let writer = Arc::new(\n145\t            EventWriter::new(event_store.clone(), WORKSPACE.to_string(), 4096)\n146\t                .with_flush_policy(FlushPolicy::Sync),\n147\t        );\n148\t        let store = MemoryStore::open(conn.clone(), writer);\n149\t        Self {\n150\t            _tempdir: tempdir,\n151\t            conn,\n152\t            event_store,\n153\t            store,\n154\t        }\n155\t    }\n156\t\n157\t    pub(super) fn conn(&self) -> std::sync::MutexGuard<'_, Connection> {\n158\t        self.conn.lock().expect(\"contract harness DB lock\")\n159\t    }\n160\t\n161\t    pub(super) fn writer(&self) -> EventWriter {\n162\t        EventWriter::new(self.event_store.clone(), WORKSPACE.to_string(), 4096)\n163\t            .with_flush_policy(FlushPolicy::Sync)\n164\t    }\n165\t\n166\t    pub(super) fn reader(&self) -> EventReader {\n167\t        EventReader::new(self.event_store.clone())\n168\t    }\n169\t\n170\t    pub(super) fn all_memory_events(&self) -> Vec<EventEnvelope> {\n171\t        self.reader()\n172\t            .execute(\n173\t                EventQuery::new()\n174\t                    .session(\"memory-graph\")\n175\t                    .workspace(WORKSPACE)\n176\t                    .branch(BRANCH)\n177\t                    .order(QueryOrder::OldestFirst)\n178\t                    .limit(200),\n179\t            )\n180\t            .expect(\"memory graph events load\")\n181\t    }\n182\t}\n183\t\n184\tpub(super) fn append_event(writer: &EventWriter, partial: PartialEnvelope) -> EventId {\n185\t    writer.append(partial).expect(\"event appends\")\n186\t}\n187\t\n188\t/// Convenience constructor for the workspace/branch/session-scoped envelopes\n189\t/// every cross-layer test in this gate uses. Surfaces stay readable when the\n190\t/// test body shows only the kind, references, and typed payload that\n191\t/// distinguish it.\n192\tpub(super) fn daemon_envelope(\n193\t    kind: crate::events::EventKind,\n194\t    references: Vec<crate::events::StableRef>,\n195\t    summary: &str,\n196\t    payload: crate::events::EventPayload,\n197\t) -> PartialEnvelope {\n198\t    PartialEnvelope {\n199\t        workspace_id: Some(WORKSPACE.to_string()),\n200\t        branch: crate::events::BranchRef {\n201\t            name: BRANCH.to_string(),\n202\t        },\n203\t        session_id: crate::events::SessionId {\n204\t            value: SESSION.to_string(),\n205\t        },\n206\t        task_id: None,\n207\t        actor: Actor::Daemon,\n208\t        kind,\n209\t        references,\n210\t        summary: crate::events::CompactSummary::new(summary.to_string())\n211\t            .expect(\"contract summary fits\"),\n212\t        payload,\n213\t    }\n214\t}\n215\t\n216\tpub(super) fn read_back(reader: &EventReader, event_id: &EventId) -> EventEnvelope {\n217\t    let envelopes = reader\n218\t        .execute(\n219\t            EventQuery::new()\n220\t                .workspace(WORKSPACE)\n221\t                .branch(BRANCH)\n222\t                .order(QueryOrder::OldestFirst)\n223\t                .limit(100),\n224\t        )\n225\t        .expect(\"workspace-scoped read succeeds\");\n226\t    envelopes\n227\t        .into_iter()\n228\t        .find(|envelope| envelope.event_id == *event_id)\n229\t        .expect(\"appended event is visible to the reader\")\n230\t}\n231\t\n232\tpub(super) fn seed_draft(file: &FileId, symbol: &SymbolId, section: &SectionId) -> MemoryDraft {\n233\t    MemoryDraft {\n234\t        content: \"round-trip seed\".to_string(),\n235\t        class: MemoryClass::Observation,\n236\t        assertion_type: AssertionType::Observation,\n237\t        scope: branch_scope_state(),\n238\t        confidence: 0.8,\n239\t        confidence_reason: \"contract seed\".to_string(),\n240\t        freshness_policy: FreshnessPolicy {\n241\t            kind: FreshnessKind::BranchScoped,\n242\t            ttl: None,\n243\t            recheck_interval: None,\n244\t        },\n245\t        validity_conditions: Vec::new(),\n246\t        invalidation_triggers: Vec::new(),\n247\t        provenance_event_ids: Vec::new(),\n248\t        evidence_references: Vec::new(),\n249\t        linked_files: vec![file.clone()],\n250\t        linked_symbols: vec![symbol.clone()],\n251\t        linked_docs: vec![section.clone()],\n252\t        linked_tests: Vec::new(),\n253\t        linked_memories: Vec::new(),\n254\t        contradiction_links: Vec::new(),\n255\t        supersession_links: Vec::new(),\n256\t        access_history: Vec::new(),\n257\t        created_by: \"assistant\".to_string(),\n258\t        updated_by: \"assistant\".to_string(),\n259\t        superseded_by: None,\n260\t        schema_version: 1,\n261\t        initial_evidence: vec![file_span_evidence(file)],\n262\t    }\n263\t}\n264\t\n265\tpub(super) fn file_span_evidence(file: &FileId) -> MemoryEvidence {\n266\t    MemoryEvidence {\n267\t        evidence_id: MemoryEvidenceId(String::new()),\n268\t        memory_id: memory_identity(\"placeholder\"),\n269\t        event_id: None,\n270\t        anchor: EvidenceAnchor::FileSpan {\n271\t            file: file.clone(),\n272\t            byte_start: 0,\n273\t            byte_end: 32,\n274\t            sha256: [0_u8; 32],\n275\t        },\n276\t        captured_at: DateTime::from_unix_seconds(1_700_000_000),\n277\t        captured_by: Actor::Daemon,\n278\t    }\n279\t}\n280\t\n281\tpub(super) fn doc_section_evidence(section: &SectionId) -> MemoryEvidence {\n282\t    MemoryEvidence {\n283\t        evidence_id: MemoryEvidenceId(String::new()),\n284\t        memory_id: memory_identity(\"placeholder\"),\n285\t        event_id: None,\n286\t        anchor: EvidenceAnchor::DocSection {\n287\t            id: section.clone(),\n288\t            sha256: [1_u8; 32],\n289\t        },\n290\t        captured_at: DateTime::from_unix_seconds(1_700_000_010),\n291\t        captured_by: Actor::Daemon,\n292\t    }\n293\t}\n294\t\n295\t// ---------------------------------------------------------------------------\n296\t// Legacy memory source used by the migration round-trip tests.\n297\t// ---------------------------------------------------------------------------\n298\t\n299\tpub(super) fn legacy_source_conn() -> Connection {\n300\t    let conn = Connection::open_in_memory().expect(\"legacy source DB\");\n301\t    conn.execute_batch(\n302\t        \"CREATE TABLE memories (\n303\t            id TEXT PRIMARY KEY,\n304\t            session_id TEXT NOT NULL DEFAULT '',\n305\t            content TEXT NOT NULL,\n306\t            memory_type TEXT NOT NULL,\n307\t            scope TEXT NOT NULL DEFAULT 'session',\n308\t            confidence REAL NOT NULL DEFAULT 1.0,\n309\t            linked_symbols TEXT NOT NULL DEFAULT '[]',\n310\t            linked_files TEXT NOT NULL DEFAULT '[]',\n311\t            workspace_id TEXT,\n312\t            branch TEXT,\n313\t            refresh_key TEXT,\n314\t            source_query TEXT,\n315\t            assertion_type TEXT NOT NULL DEFAULT 'observation',\n316\t            verification_status TEXT NOT NULL DEFAULT 'unverified',\n317\t            confidence_reason TEXT,\n318\t            supersedes_memory_id TEXT,\n319\t            superseded_by_memory_id TEXT,\n320\t            contradicts_memory_ids TEXT NOT NULL DEFAULT '[]',\n321\t            contradicted_by_memory_ids TEXT NOT NULL DEFAULT '[]',\n322\t            freshness_policy TEXT NOT NULL DEFAULT 'session_scoped',\n323\t            freshness_policy_detail TEXT,\n324\t            provenance_json TEXT NOT NULL DEFAULT '[]',\n325\t            evidence_json TEXT NOT NULL DEFAULT '[]',\n326\t            created_at INTEGER NOT NULL,\n327\t            last_accessed INTEGER NOT NULL,\n328\t            access_count INTEGER NOT NULL DEFAULT 0,\n329\t            is_stale INTEGER NOT NULL DEFAULT 0,\n330\t            stale_reason TEXT,\n331\t            is_invalidated INTEGER NOT NULL DEFAULT 0\n332\t        );\",\n333\t    )\n334\t    .expect(\"legacy schema\");\n335\t    conn\n336\t}\n337\t\n338\tpub(super) fn insert_legacy_row(conn: &Connection, id: &str, linked_files_json: &str) {\n339\t    conn.execute(\n340\t        \"INSERT INTO memories\n341\t            (id, session_id, content, memory_type, scope, confidence, linked_symbols,\n342\t             linked_files, workspace_id, branch, refresh_key, source_query, assertion_type,\n343\t             verification_status, confidence_reason, supersedes_memory_id,\n344\t             superseded_by_memory_id, contradicts_memory_ids, contradicted_by_memory_ids,\n345\t             freshness_policy, freshness_policy_detail, provenance_json, evidence_json,\n346\t             created_at, last_accessed, access_count, is_stale, stale_reason, is_invalidated)\n347\t         VALUES\n348\t            (?1, 'legacy-session', ?2, 'observation', 'repo', 0.7, '[]', ?3, ?4, 'main',\n349\t             NULL, NULL, 'observation', 'unverified', NULL, NULL, NULL,\n350\t             '[]', '[]', 'repo_scoped', NULL, '[]', '[]', 1700000000, 1700000000, 0, 0, NULL, 0)\",\n351\t        rusqlite::params![id, format!(\"memory {id}\"), linked_files_json, WORKSPACE],\n352\t    )\n353\t    .expect(\"legacy row inserts\");\n354\t}\n355\t\n356\t// ---------------------------------------------------------------------------\n357\t// Resolver fixture builders for the rename and end-to-end round-trip tests.\n358\t// ---------------------------------------------------------------------------\n359\t\n360\tpub(super) fn build_empty_resolver(\n361\t    workspace: &str,\n362\t    events: Vec<EventId>,\n363\t) -> IdentityResolver<'static> {\n364\t    let graph = Box::leak(Box::new(CodeGraph::new()));\n365\t    let file_index: HashMap<String, FileIndexEntry> = HashMap::new();\n366\t    let parsed_files: HashMap<String, crate::symbols::ParsedFile> = HashMap::new();\n367\t    IdentityResolver::new(\n368\t        graph,\n369\t        Box::leak(Box::new(file_index)),\n370\t        Box::leak(Box::new(parsed_files)),\n371\t        workspace.to_string(),\n372\t        events,\n373\t    )\n374\t}\n375\t\n376\tpub(super) fn build_filesystem_resolver(\n377\t    default_workspace: &str,\n378\t    files: &[(&str, &str, &str)],\n379\t) -> IdentityResolver<'static> {\n380\t    let mut graph = CodeGraph::new();\n381\t    let mut file_index: HashMap<String, FileIndexEntry> = HashMap::new();\n382\t    let mut parsed_files: HashMap<String, crate::symbols::ParsedFile> = HashMap::new();\n383\t    for (workspace, path, source) in files.iter() {\n384\t        let stored_path = format!(\"{}/{}\", workspace, path);\n385\t        let parsed = parse_file(&stored_path, source).expect(\"fixture parses\");\n386\t        for symbol in &parsed.symbols {\n387\t            graph.add_node(\n388\t                symbol.id.clone(),\n389\t                symbol.kind,\n390\t                symbol.name.clone(),\n391\t                symbol.signature.clone(),\n392\t                symbol.body.clone(),\n393\t                symbol.file.clone(),\n394\t                symbol.line,\n395\t                symbol.end_line,\n396\t                symbol.is_exported,\n397\t                symbol.language,\n398\t            );\n399\t        }\n400\t        parsed_files.insert(stored_path.clone(), parsed);\n401\t        file_index.insert(\n402\t            stored_path.clone(),\n403\t            FileIndexEntry {\n404\t                file: stored_path.clone(),\n405\t                content_hash: deterministic_hash(source),\n406\t                mtime_ns: 0,\n407\t                size_bytes: source.len() as i64,\n408\t                parser_version: FILE_INDEX_PARSER_VERSION,\n409\t                schema_version: FILE_INDEX_SCHEMA_VERSION,\n410\t                last_indexed_at: 0,\n411\t            },\n412\t        );\n413\t    }\n414\t    IdentityResolver::new(\n415\t        Box::leak(Box::new(graph)),\n416\t        Box::leak(Box::new(file_index)),\n417\t        Box::leak(Box::new(parsed_files)),\n418\t        default_workspace.to_string(),\n419\t        Vec::new(),\n420\t    )\n421\t}\n422\t\n423\tfn deterministic_hash(source: &str) -> String {\n424\t    let mut hash = 0xcbf29ce484222325u64;\n425\t    for byte in source.as_bytes() {\n426\t        hash ^= *byte as u64;\n427\t        hash = hash.wrapping_mul(0x100000001b3);\n428\t    }\n429\t    format!(\"{hash:016x}\")\n430\t}\n431\t"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"0e8882eb-7434-43d0-9ef0-5399862e7068","timestamp":"2026-05-17T13:09:15.387Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/contract_tests/identity_event_memory_support.rs","content":"//! Shared fixtures, harness, and identity factories for the R26 cross-layer\n//! contract tests in `identity_event_memory.rs`.\n//!\n//! These helpers exist so the test file can stay focused on the contract\n//! surfaces it pins. Per the Cadres coding standard `## Hard limits`, this\n//! support module keeps the test file under the 800-line ceiling without\n//! losing the per-surface organization that makes the gate readable.\n\nuse std::collections::HashMap;\nuse std::sync::{Arc, Mutex};\n\nuse rusqlite::Connection;\nuse tempfile::TempDir;\n\nuse crate::events::{\n    Actor, EventEnvelope, EventQuery, EventReader, EventStore, EventWriter, FlushPolicy,\n    PartialEnvelope, QueryOrder,\n};\nuse crate::graph::CodeGraph;\nuse crate::identity::{\n    ContextHandleId, DocId, EventId, FileId, IdentityResolver, MemoryId, SectionId, SymbolId,\n};\nuse crate::memory_graph::store::MemoryScopeState;\nuse crate::memory_graph::{\n    initialize_schema, AssertionType, EvidenceAnchor, FreshnessKind, FreshnessPolicy,\n    IdempotencyKey, MemoryClass, MemoryDraft, MemoryEvidence, MemoryEvidenceId, MemoryScope,\n    MemoryStore,\n};\nuse crate::parser::parse_file;\nuse crate::storage::graph_store::{\n    FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n};\nuse crate::DateTime;\n\npub(super) const WORKSPACE: &str = \"workspace\";\npub(super) const BRANCH: &str = \"main\";\npub(super) const SESSION: &str = \"contract-session\";\n\n// ---------------------------------------------------------------------------\n// Identity factories\n// ---------------------------------------------------------------------------\n\npub(super) fn file_identity(path: &str) -> FileId {\n    FileId {\n        workspace_id: WORKSPACE.to_string(),\n        repo_relative_path: path.to_string(),\n        content_hash: \"feedface00000001\".to_string(),\n    }\n}\n\npub(super) fn doc_identity(path: &str) -> DocId {\n    DocId {\n        workspace_id: WORKSPACE.to_string(),\n        repo_relative_path: path.to_string(),\n        content_hash: \"deadbeef00000002\".to_string(),\n    }\n}\n\npub(super) fn section_identity(path: &str, heading: &str) -> SectionId {\n    SectionId {\n        doc: doc_identity(path),\n        heading_path: vec![heading.to_string()],\n        byte_offset: 64,\n    }\n}\n\npub(super) fn symbol_identity(file: &FileId, qualified: &str) -> SymbolId {\n    SymbolId {\n        file: file.clone(),\n        qualified_name: qualified.to_string(),\n        byte_offset: 12,\n        kind: \"function\".to_string(),\n    }\n}\n\npub(super) fn context_handle_identity(seed: &str) -> ContextHandleId {\n    ContextHandleId {\n        workspace_id: WORKSPACE.to_string(),\n        session_id: SESSION.to_string(),\n        ulid: stable_ulid(seed),\n    }\n}\n\npub(super) fn memory_identity(seed: &str) -> MemoryId {\n    MemoryId {\n        workspace_id: WORKSPACE.to_string(),\n        ulid: stable_ulid(seed),\n    }\n}\n\npub(super) fn stable_ulid(seed: &str) -> String {\n    const ALPHABET: &[u8; 32] = b\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\n    let mut bytes = [b'0'; 26];\n    bytes[..24].copy_from_slice(b\"01ARZ3NDEKTSV4RRFFQ69G5F\");\n    let checksum = seed.bytes().fold(0_u32, |acc, byte| {\n        acc.wrapping_mul(33).wrapping_add(u32::from(byte))\n    });\n    bytes[24] = ALPHABET[((checksum >> 5) & 31) as usize];\n    bytes[25] = ALPHABET[(checksum & 31) as usize];\n    String::from_utf8(bytes.to_vec()).expect(\"stable ULID is valid ASCII\")\n}\n\npub(super) fn branch_scope_state() -> MemoryScopeState {\n    MemoryScopeState {\n        scope: MemoryScope::Branch,\n        scope_session_id: None,\n        scope_branch: Some(BRANCH.to_string()),\n        scope_workspace_id: Some(WORKSPACE.to_string()),\n        scope_user_id: None,\n        scope_org_id: None,\n    }\n}\n\npub(super) fn idem(value: &str) -> IdempotencyKey {\n    IdempotencyKey::new(value.to_string()).expect(\"idempotency key\")\n}\n\n// ---------------------------------------------------------------------------\n// In-process collaborator harness\n// ---------------------------------------------------------------------------\n\n/// Wiring that mirrors `memory_graph::tests_common::TestHarness` but lives\n/// inside `contract_tests` so the cross-layer surface is exercised without\n/// re-exporting a private per-substrate helper.\npub(super) struct ContractHarness {\n    _tempdir: TempDir,\n    pub(super) conn: Arc<Mutex<Connection>>,\n    pub(super) event_store: Arc<EventStore>,\n    pub(super) store: MemoryStore,\n}\n\nimpl ContractHarness {\n    pub(super) fn new() -> Self {\n        let tempdir = TempDir::new().expect(\"contract tempdir\");\n        let conn = Connection::open(tempdir.path().join(\"memory-graph.db\"))\n            .expect(\"memory graph DB opens\");\n        conn.execute_batch(\"PRAGMA foreign_keys = ON;\")\n            .expect(\"foreign keys enable\");\n        initialize_schema(&conn).expect(\"memory graph schema initializes\");\n        let conn = Arc::new(Mutex::new(conn));\n        let event_store = Arc::new(\n            EventStore::open(&tempdir.path().join(\"events.db\")).expect(\"event store opens\"),\n        );\n        let writer = Arc::new(\n            EventWriter::new(event_store.clone(), WORKSPACE.to_string(), 4096)\n                .with_flush_policy(FlushPolicy::Sync),\n        );\n        let store = MemoryStore::open(conn.clone(), writer);\n        Self {\n            _tempdir: tempdir,\n            conn,\n            event_store,\n            store,\n        }\n    }\n\n    pub(super) fn conn(&self) -> std::sync::MutexGuard<'_, Connection> {\n        self.conn.lock().expect(\"contract harness DB lock\")\n    }\n\n    pub(super) fn writer(&self) -> EventWriter {\n        EventWriter::new(self.event_store.clone(), WORKSPACE.to_string(), 4096)\n            .with_flush_policy(FlushPolicy::Sync)\n    }\n\n    pub(super) fn reader(&self) -> EventReader {\n        EventReader::new(self.event_store.clone())\n    }\n\n    pub(super) fn all_memory_events(&self) -> Vec<EventEnvelope> {\n        self.reader()\n            .execute(\n                EventQuery::new()\n                    .session(\"memory-graph\")\n                    .workspace(WORKSPACE)\n                    .branch(BRANCH)\n                    .order(QueryOrder::OldestFirst)\n                    .limit(200),\n            )\n            .expect(\"memory graph events load\")\n    }\n}\n\npub(super) fn append_event(writer: &EventWriter, partial: PartialEnvelope) -> EventId {\n    writer.append(partial).expect(\"event appends\")\n}\n\n/// Convenience constructor for the workspace/branch/session-scoped envelopes\n/// every cross-layer test in this gate uses. Surfaces stay readable when the\n/// test body shows only the kind, references, and typed payload that\n/// distinguish it.\npub(super) fn daemon_envelope(\n    kind: crate::events::EventKind,\n    references: Vec<crate::events::StableRef>,\n    summary: &str,\n    payload: crate::events::EventPayload,\n) -> PartialEnvelope {\n    PartialEnvelope {\n        workspace_id: Some(WORKSPACE.to_string()),\n        branch: crate::events::BranchRef {\n            name: BRANCH.to_string(),\n        },\n        session_id: crate::events::SessionId {\n            value: SESSION.to_string(),\n        },\n        task_id: None,\n        actor: Actor::Daemon,\n        kind,\n        references,\n        summary: crate::events::CompactSummary::new(summary.to_string())\n            .expect(\"contract summary fits\"),\n        payload,\n    }\n}\n\npub(super) fn read_back(reader: &EventReader, event_id: &EventId) -> EventEnvelope {\n    let envelopes = reader\n        .execute(\n            EventQuery::new()\n                .workspace(WORKSPACE)\n                .branch(BRANCH)\n                .order(QueryOrder::OldestFirst)\n                .limit(100),\n        )\n        .expect(\"workspace-scoped read succeeds\");\n    envelopes\n        .into_iter()\n        .find(|envelope| envelope.event_id == *event_id)\n        .expect(\"appended event is visible to the reader\")\n}\n\npub(super) fn seed_draft(file: &FileId, symbol: &SymbolId, section: &SectionId) -> MemoryDraft {\n    MemoryDraft {\n        content: \"round-trip seed\".to_string(),\n        class: MemoryClass::Observation,\n        assertion_type: AssertionType::Observation,\n        scope: branch_scope_state(),\n        confidence: 0.8,\n        confidence_reason: \"contract seed\".to_string(),\n        freshness_policy: FreshnessPolicy {\n            kind: FreshnessKind::BranchScoped,\n            ttl: None,\n            recheck_interval: None,\n        },\n        validity_conditions: Vec::new(),\n        invalidation_triggers: Vec::new(),\n        provenance_event_ids: Vec::new(),\n        evidence_references: Vec::new(),\n        linked_files: vec![file.clone()],\n        linked_symbols: vec![symbol.clone()],\n        linked_docs: vec![section.clone()],\n        linked_tests: Vec::new(),\n        linked_memories: Vec::new(),\n        contradiction_links: Vec::new(),\n        supersession_links: Vec::new(),\n        access_history: Vec::new(),\n        created_by: \"assistant\".to_string(),\n        updated_by: \"assistant\".to_string(),\n        superseded_by: None,\n        schema_version: 1,\n        initial_evidence: vec![file_span_evidence(file)],\n    }\n}\n\npub(super) fn file_span_evidence(file: &FileId) -> MemoryEvidence {\n    MemoryEvidence {\n        evidence_id: MemoryEvidenceId(String::new()),\n        memory_id: memory_identity(\"placeholder\"),\n        event_id: None,\n        anchor: EvidenceAnchor::FileSpan {\n            file: file.clone(),\n            byte_start: 0,\n            byte_end: 32,\n            sha256: [0_u8; 32],\n        },\n        captured_at: DateTime::from_unix_seconds(1_700_000_000),\n        captured_by: Actor::Daemon,\n    }\n}\n\npub(super) fn doc_section_evidence(section: &SectionId) -> MemoryEvidence {\n    MemoryEvidence {\n        evidence_id: MemoryEvidenceId(String::new()),\n        memory_id: memory_identity(\"placeholder\"),\n        event_id: None,\n        anchor: EvidenceAnchor::DocSection {\n            id: section.clone(),\n            sha256: [1_u8; 32],\n        },\n        captured_at: DateTime::from_unix_seconds(1_700_000_010),\n        captured_by: Actor::Daemon,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Legacy memory source used by the migration round-trip tests.\n// ---------------------------------------------------------------------------\n\npub(super) fn legacy_source_conn() -> Connection {\n    let conn = Connection::open_in_memory().expect(\"legacy source DB\");\n    conn.execute_batch(\n        \"CREATE TABLE memories (\n            id TEXT PRIMARY KEY,\n            session_id TEXT NOT NULL DEFAULT '',\n            content TEXT NOT NULL,\n            memory_type TEXT NOT NULL,\n            scope TEXT NOT NULL DEFAULT 'session',\n            confidence REAL NOT NULL DEFAULT 1.0,\n            linked_symbols TEXT NOT NULL DEFAULT '[]',\n            linked_files TEXT NOT NULL DEFAULT '[]',\n            workspace_id TEXT,\n            branch TEXT,\n            refresh_key TEXT,\n            source_query TEXT,\n            assertion_type TEXT NOT NULL DEFAULT 'observation',\n            verification_status TEXT NOT NULL DEFAULT 'unverified',\n            confidence_reason TEXT,\n            supersedes_memory_id TEXT,\n            superseded_by_memory_id TEXT,\n            contradicts_memory_ids TEXT NOT NULL DEFAULT '[]',\n            contradicted_by_memory_ids TEXT NOT NULL DEFAULT '[]',\n            freshness_policy TEXT NOT NULL DEFAULT 'session_scoped',\n            freshness_policy_detail TEXT,\n            provenance_json TEXT NOT NULL DEFAULT '[]',\n            evidence_json TEXT NOT NULL DEFAULT '[]',\n            created_at INTEGER NOT NULL,\n            last_accessed INTEGER NOT NULL,\n            access_count INTEGER NOT NULL DEFAULT 0,\n            is_stale INTEGER NOT NULL DEFAULT 0,\n            stale_reason TEXT,\n            is_invalidated INTEGER NOT NULL DEFAULT 0\n        );\",\n    )\n    .expect(\"legacy schema\");\n    conn\n}\n\npub(super) fn insert_legacy_row(conn: &Connection, id: &str, linked_files_json: &str) {\n    conn.execute(\n        \"INSERT INTO memories\n            (id, session_id, content, memory_type, scope, confidence, linked_symbols,\n             linked_files, workspace_id, branch, refresh_key, source_query, assertion_type,\n             verification_status, confidence_reason, supersedes_memory_id,\n             superseded_by_memory_id, contradicts_memory_ids, contradicted_by_memory_ids,\n             freshness_policy, freshness_policy_detail, provenance_json, evidence_json,\n             created_at, last_accessed, access_count, is_stale, stale_reason, is_invalidated)\n         VALUES\n            (?1, 'legacy-session', ?2, 'observation', 'repo', 0.7, '[]', ?3, ?4, 'main',\n             NULL, NULL, 'observation', 'unverified', NULL, NULL, NULL,\n             '[]', '[]', 'repo_scoped', NULL, '[]', '[]', 1700000000, 1700000000, 0, 0, NULL, 0)\",\n        rusqlite::params![id, format!(\"memory {id}\"), linked_files_json, WORKSPACE],\n    )\n    .expect(\"legacy row inserts\");\n}\n\n// ---------------------------------------------------------------------------\n// Resolver fixture builders for the rename and end-to-end round-trip tests.\n// ---------------------------------------------------------------------------\n\npub(super) fn build_empty_resolver(\n    workspace: &str,\n    events: Vec<EventId>,\n) -> IdentityResolver<'static> {\n    let graph = Box::leak(Box::new(CodeGraph::new()));\n    let file_index: HashMap<String, FileIndexEntry> = HashMap::new();\n    let parsed_files: HashMap<String, crate::symbols::ParsedFile> = HashMap::new();\n    IdentityResolver::new(\n        graph,\n        Box::leak(Box::new(file_index)),\n        Box::leak(Box::new(parsed_files)),\n        workspace.to_string(),\n        events,\n    )\n}\n\npub(super) fn build_filesystem_resolver(\n    default_workspace: &str,\n    files: &[(&str, &str, &str)],\n) -> IdentityResolver<'static> {\n    let mut graph = CodeGraph::new();\n    let mut file_index: HashMap<String, FileIndexEntry> = HashMap::new();\n    let mut parsed_files: HashMap<String, crate::symbols::ParsedFile> = HashMap::new();\n    for (workspace, path, source) in files.iter() {\n        let stored_path = format!(\"{}/{}\", workspace, path);\n        let parsed = parse_file(&stored_path, source).expect(\"fixture parses\");\n        for symbol in &parsed.symbols {\n            graph.add_node(\n                symbol.id.clone(),\n                symbol.kind,\n                symbol.name.clone(),\n                symbol.signature.clone(),\n                symbol.body.clone(),\n                symbol.file.clone(),\n                symbol.line,\n                symbol.end_line,\n                symbol.is_exported,\n                symbol.language,\n            );\n        }\n        parsed_files.insert(stored_path.clone(), parsed);\n        file_index.insert(\n            stored_path.clone(),\n            FileIndexEntry {\n                file: stored_path.clone(),\n                content_hash: deterministic_hash(source),\n                mtime_ns: 0,\n                size_bytes: source.len() as i64,\n                parser_version: FILE_INDEX_PARSER_VERSION,\n                schema_version: FILE_INDEX_SCHEMA_VERSION,\n                last_indexed_at: 0,\n            },\n        );\n    }\n    IdentityResolver::new(\n        Box::leak(Box::new(graph)),\n        Box::leak(Box::new(file_index)),\n        Box::leak(Box::new(parsed_files)),\n        default_workspace.to_string(),\n        Vec::new(),\n    )\n}\n\nfn deterministic_hash(source: &str) -> String {\n    let mut hash = 0xcbf29ce484222325u64;\n    for byte in source.as_bytes() {\n        hash ^= *byte as u64;\n        hash = hash.wrapping_mul(0x100000001b3);\n    }\n    format!(\"{hash:016x}\")\n}\n","numLines":431,"startLine":1,"totalLines":431}}}
