{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W7iwa7V6k8YRcm6kDkBbdS","type":"tool_result","content":"96\t\n97\t    /// Execute a query and produce a Context Capsule.\n98\t    ///\n99\t    /// If `embedding` is provided and a vector store is available, semantic search\n100\t    /// is used. Otherwise, falls back to keyword matching on node names/signatures.\n101\t    pub fn query(\n102\t        &mut self,\n103\t        query_text: &str,\n104\t        embedding: Option<&[f32]>,\n105\t        focused: bool,\n106\t    ) -> ContextCapsule {\n107\t        // Record the query for frequency tracking (adaptive budget)\n108\t        self.record_query(query_text);\n109\t\n110\t        // Step 0: Parse query filters (repo:, file:, lang:)\n111\t        let (filter, clean_query) = parse_query_filters(query_text);\n112\t\n113\t        // Step 1: Detect intent (use clean query without filter tokens)\n114\t        let intent = detect_intent(&clean_query);\n115\t        let params = IntentParams::for_intent(intent);\n116\t        let prefer_markdown_results = query_prefers_markdown_results(&clean_query);\n117\t\n118\t        // Step 2: Semantic search or keyword fallback (use clean query for matching)\n119\t        let mut seed_hits = self.find_seed_hits(&clean_query, embedding, &params, intent);\n120\t\n121\t        // Step 2b: File-path seeding for Explore intent.\n122\t        // For understanding queries, augment seeds with top-centrality functions from\n123\t        // files whose path matches query words. This finds implementation logic like\n124\t        // begin_host_patching in patch_pipeline.py when the query mentions \"patch\" —\n125\t        // even when function names don't match any query word directly.\n126\t        // Seed scores are IDF-weighted: files matching rare query words score higher.\n127\t        if intent == QueryIntent::Explore {\n128\t            let q_word_storage = extract_query_terms(&clean_query);\n129\t            let q_words: Vec<&str> = q_word_storage.iter().map(|word| word.as_str()).collect();\n130\t\n131\t            if !q_words.is_empty() {\n132\t                let seed_ids: std::collections::HashSet<SymbolId> =\n133\t                    seed_hits.iter().map(|(id, _)| id.clone()).collect();\n134\t\n135\t                // Compute IDF for file-path seed scoring\n136\t                let all_fp_nodes = self.graph.all_nodes();\n137\t                let fp_total = all_fp_nodes.len().max(1) as f64;\n138\t                let fp_word_idf: HashMap<&str, f64> = q_words\n139\t                    .iter()\n140\t                    .map(|w| {\n141\t                        let df = all_fp_nodes\n142\t                            .iter()\n143\t                            .filter(|n| {\n144\t                                let nl = n.name.to_lowercase();\n145\t                                nl.contains(*w) || n.signature.to_lowercase().contains(*w)\n146\t                            })\n147\t                            .count()\n148\t                            .max(1);\n149\t                        (*w, (fp_total / df as f64).ln().max(0.1))\n150\t                    })\n151\t                    .collect();\n152\t                let fp_max_idf_raw = fp_word_idf.values().cloned().fold(0.1f64, f64::max);\n153\t                let fp_idf_floor = fp_max_idf_raw * 0.3;\n154\t                let fp_word_idf_floored: HashMap<&str, f64> = fp_word_idf\n155\t                    .iter()\n156\t                    .map(|(w, idf)| (*w, idf.max(fp_idf_floor)))\n157\t                    .collect();\n158\t                let fp_max_idf = fp_word_idf_floored.values().cloned().fold(0.1f64, f64::max);\n159\t\n160\t                // Group functions by matching file, scored by centrality.\n161\t                // Track per-file IDF-weighted match score for prioritization.\n162\t                let mut file_candidates: HashMap<String, Vec<(SymbolId, f64)>> = HashMap::new();\n163\t                let mut file_idf_scores: HashMap<String, f64> = HashMap::new();\n164\t                let mut file_match_counts: HashMap<String, usize> = HashMap::new();\n165\t\n166\t                for node in &all_fp_nodes {\n167\t                    if seed_ids.contains(&node.id) || is_test_file(&node.file) {\n168\t                        continue;\n169\t                    }\n170\t                    if !matches!(node.kind, SymbolKind::Function | SymbolKind::Method) {\n171\t                        continue;\n172\t                    }\n173\t\n174\t                    let file_lower = node.file.to_lowercase();\n175\t                    let file_segments: Vec<&str> = file_lower\n176\t                        .split(|c: char| c == '/' || c == '_' || c == '-' || c == '.')\n177\t                        .filter(|p| p.len() >= 3)\n178\t                        .collect();\n179\t\n180\t                    // Compute IDF-weighted match score for this file.\n181\t                    // Use prefix matching: a file segment like \"auth\" matches query word\n182\t                    // \"authentication\" (the file abbreviates the concept). Require the\n183\t                    // prefix to be >= 4 chars to prevent short matches like \"user\"→\"users\".\n184\t                    // Do NOT match segment.starts_with(word) — that's the v20 bug\n185\t                    // where \"users\" matched query word \"user\".\n186\t                    let mut file_score: f64 = 0.0;\n187\t                    let mut match_count: usize = 0;\n188\t                    for w in &q_words {\n189\t                        let matched = file_segments\n190\t                            .iter()\n191\t                            .any(|seg| seg == w || (seg.len() >= 4 && w.starts_with(seg)));\n192\t                        if matched {\n193\t                            let idf_f =\n194\t                                fp_word_idf_floored.get(*w).copied().unwrap_or(1.0) / fp_max_idf;\n195\t                            file_score += idf_f;\n196\t                            match_count += 1;\n197\t                        }\n198\t                    }\n199\t\n200\t                    if match_count == 0 {\n201\t                        continue;\n202\t                    }\n203\t\n204\t                    // For long queries (5+ content words), require 2+ file segment\n205\t                    // matches. A single \"system\" match on an 11-word auth query seeded\n206\t                    // Go system_collector.go, pulling Logger.Errorf via graph traversal.\n207\t                    // With many query words, a single file-path match is almost certainly\n208\t                    // coincidental. Shorter queries (2-4 words) keep the 1-match threshold\n209\t                    // since each word carries more signal.\n210\t                    if q_words.len() >= 5 && match_count < 2 {\n211\t                        continue;\n212\t                    }\n213\t\n214\t                    let centrality = self.graph.centrality(&node.id);\n215\t                    file_candidates"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"8aa3b3ed-c6d1-4be3-a946-fe548ccc87c9","timestamp":"2026-05-17T13:12:12.858Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/query/engine.rs","content":"\n    /// Execute a query and produce a Context Capsule.\n    ///\n    /// If `embedding` is provided and a vector store is available, semantic search\n    /// is used. Otherwise, falls back to keyword matching on node names/signatures.\n    pub fn query(\n        &mut self,\n        query_text: &str,\n        embedding: Option<&[f32]>,\n        focused: bool,\n    ) -> ContextCapsule {\n        // Record the query for frequency tracking (adaptive budget)\n        self.record_query(query_text);\n\n        // Step 0: Parse query filters (repo:, file:, lang:)\n        let (filter, clean_query) = parse_query_filters(query_text);\n\n        // Step 1: Detect intent (use clean query without filter tokens)\n        let intent = detect_intent(&clean_query);\n        let params = IntentParams::for_intent(intent);\n        let prefer_markdown_results = query_prefers_markdown_results(&clean_query);\n\n        // Step 2: Semantic search or keyword fallback (use clean query for matching)\n        let mut seed_hits = self.find_seed_hits(&clean_query, embedding, &params, intent);\n\n        // Step 2b: File-path seeding for Explore intent.\n        // For understanding queries, augment seeds with top-centrality functions from\n        // files whose path matches query words. This finds implementation logic like\n        // begin_host_patching in patch_pipeline.py when the query mentions \"patch\" —\n        // even when function names don't match any query word directly.\n        // Seed scores are IDF-weighted: files matching rare query words score higher.\n        if intent == QueryIntent::Explore {\n            let q_word_storage = extract_query_terms(&clean_query);\n            let q_words: Vec<&str> = q_word_storage.iter().map(|word| word.as_str()).collect();\n\n            if !q_words.is_empty() {\n                let seed_ids: std::collections::HashSet<SymbolId> =\n                    seed_hits.iter().map(|(id, _)| id.clone()).collect();\n\n                // Compute IDF for file-path seed scoring\n                let all_fp_nodes = self.graph.all_nodes();\n                let fp_total = all_fp_nodes.len().max(1) as f64;\n                let fp_word_idf: HashMap<&str, f64> = q_words\n                    .iter()\n                    .map(|w| {\n                        let df = all_fp_nodes\n                            .iter()\n                            .filter(|n| {\n                                let nl = n.name.to_lowercase();\n                                nl.contains(*w) || n.signature.to_lowercase().contains(*w)\n                            })\n                            .count()\n                            .max(1);\n                        (*w, (fp_total / df as f64).ln().max(0.1))\n                    })\n                    .collect();\n                let fp_max_idf_raw = fp_word_idf.values().cloned().fold(0.1f64, f64::max);\n                let fp_idf_floor = fp_max_idf_raw * 0.3;\n                let fp_word_idf_floored: HashMap<&str, f64> = fp_word_idf\n                    .iter()\n                    .map(|(w, idf)| (*w, idf.max(fp_idf_floor)))\n                    .collect();\n                let fp_max_idf = fp_word_idf_floored.values().cloned().fold(0.1f64, f64::max);\n\n                // Group functions by matching file, scored by centrality.\n                // Track per-file IDF-weighted match score for prioritization.\n                let mut file_candidates: HashMap<String, Vec<(SymbolId, f64)>> = HashMap::new();\n                let mut file_idf_scores: HashMap<String, f64> = HashMap::new();\n                let mut file_match_counts: HashMap<String, usize> = HashMap::new();\n\n                for node in &all_fp_nodes {\n                    if seed_ids.contains(&node.id) || is_test_file(&node.file) {\n                        continue;\n                    }\n                    if !matches!(node.kind, SymbolKind::Function | SymbolKind::Method) {\n                        continue;\n                    }\n\n                    let file_lower = node.file.to_lowercase();\n                    let file_segments: Vec<&str> = file_lower\n                        .split(|c: char| c == '/' || c == '_' || c == '-' || c == '.')\n                        .filter(|p| p.len() >= 3)\n                        .collect();\n\n                    // Compute IDF-weighted match score for this file.\n                    // Use prefix matching: a file segment like \"auth\" matches query word\n                    // \"authentication\" (the file abbreviates the concept). Require the\n                    // prefix to be >= 4 chars to prevent short matches like \"user\"→\"users\".\n                    // Do NOT match segment.starts_with(word) — that's the v20 bug\n                    // where \"users\" matched query word \"user\".\n                    let mut file_score: f64 = 0.0;\n                    let mut match_count: usize = 0;\n                    for w in &q_words {\n                        let matched = file_segments\n                            .iter()\n                            .any(|seg| seg == w || (seg.len() >= 4 && w.starts_with(seg)));\n                        if matched {\n                            let idf_f =\n                                fp_word_idf_floored.get(*w).copied().unwrap_or(1.0) / fp_max_idf;\n                            file_score += idf_f;\n                            match_count += 1;\n                        }\n                    }\n\n                    if match_count == 0 {\n                        continue;\n                    }\n\n                    // For long queries (5+ content words), require 2+ file segment\n                    // matches. A single \"system\" match on an 11-word auth query seeded\n                    // Go system_collector.go, pulling Logger.Errorf via graph traversal.\n                    // With many query words, a single file-path match is almost certainly\n                    // coincidental. Shorter queries (2-4 words) keep the 1-match threshold\n                    // since each word carries more signal.\n                    if q_words.len() >= 5 && match_count < 2 {\n                        continue;\n                    }\n\n                    let centrality = self.graph.centrality(&node.id);\n                    file_candidates","numLines":120,"startLine":96,"totalLines":2480}}}
