flush_policy(FlushPolicy::Sync);\n211\t        Self {\n212\t            workspace_root: dir.path().to_path_buf(),\n213\t            runtime_db: dir.path().join(\"verification.sqlite\"),\n214\t            memory_store: MemoryStore::open(&dir.path().join(\"memory.sqlite\"))\n215\t                .expect(\"memory store\"),\n216\t            _event_store: event_store,\n217\t            event_writer,\n218\t            driver: FakeDriver::new(),\n219\t            _dir: dir,\n220\t        }\n221\t    }\n222\t\n223\t    fn runtime(&self) -> ConsolidationJobRuntime {\n224\t        ConsolidationJobRuntime::new(\n225\t            Connection::open(&self.runtime_db).expect(\"runtime db opens\"),\n226\t            ConsolidationConfig::default(),\n227\t        )\n228\t        .expect(\"runtime opens\")\n229\t    }\n230\t\n231\t    fn file_id(&self, path: &str, content_hash: &str) -> FileId {\n232\t        FileId {\n233\t            workspace_id: \"workspace-main\".to_string(),\n234\t            repo_relative_path: path.to_string(),\n235\t            content_hash: content_hash.to_string(),\n236\t        }\n237\t    }\n238\t\n239\t    fn write_file(&self, path: &str, contents: &str) {\n240\t        let full_path = self.workspace_root.join(path);\n241\t        if let Some(parent) = full_path.parent() {\n242\t            std::fs::create_dir_all(parent).expect(\"parent dir creates\");\n243\t        }\n244\t        std::fs::write(full_path, contents).expect(\"file writes\");\n245\t    }\n246\t\n247\t    fn delete_file(&self, path: &str) {\n248\t        let full_path = self.workspace_root.join(path);\n249\t        if full_path.exists() {\n250\t            std::fs::remove_file(full_path).expect(\"file deletes\");\n251\t        }\n252\t    }\n253\t\n254\t    fn seed_plain_memory(&self, id: &str, content: &str) -> String {\n255\t        self.store_memory(base_memory(id, content, MemoryScope::Branch, vec![]))\n256\t    }\n257\t\n258\t    fn seed_file_memory(&self, id: &str, path: &str) -> St