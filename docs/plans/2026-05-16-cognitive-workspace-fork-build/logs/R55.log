{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AEDTRcWP42ZTujzg83WxYZ","type":"tool_result","content":"1\t//! Hybrid candidate retrieval for Retrieval V1.\n2\t//!\n3\t//! The source list is intentionally limited to the nine candidates named in\n4\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md` `## 7. Retrieval Engine`.\n5\t\n6\tuse std::collections::BTreeSet;\n7\tuse std::time::Instant;\n8\t\n9\tuse serde::{Deserialize, Serialize};\n10\tuse tracing::debug;\n11\t\n12\tuse crate::events::{EventEnvelope, EventKind, StableRef};\n13\tuse crate::graph::{CodeGraph, GraphTraversalPath};\n14\tuse crate::identity::{DocId, FileId, Identity, MemoryId, SectionId, SymbolId};\n15\tuse crate::memory::MemoryStore;\n16\tuse crate::storage::vector_index::{VectorIndex, VectorScope};\n17\tuse crate::symbols::{SymbolId as LegacySymbolId, SymbolKind};\n18\t\n19\tuse super::{AnchorResolution, IntentClassification, IntentLabel, ResolvedAnchor};\n20\t\n21\t#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]\n22\tpub enum CandidateSource {\n23\t    ExactPathSymbolLookup,\n24\t    CodeGraphTraversal,\n25\t    DocBacklinksOutgoingLinks,\n26\t    Fts,\n27\t    Embeddings,\n28\t    EventSimilarity,\n29\t    MemoryLinks,\n30\t    WorkflowSimilarity,\n31\t    RecentActiveWorkingMemory,\n32\t}\n33\t\n34\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n35\tpub struct Candidate {\n36\t    pub identity: Identity,\n37\t    pub source: CandidateSource,\n38\t    pub seed_anchor: Option<Identity>,\n39\t    pub raw_score: f64,\n40\t    pub preliminary_inclusion_reason: String,\n41\t    pub expansion_handle_hint: Option<String>,\n42\t    pub traversal_path: Vec<Identity>,\n43\t    pub budget_exhausted: bool,\n44\t}\n45\t\n46\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n47\tpub struct RetrievalBudget {\n48\t    pub max_candidates_per_source: usize,\n49\t    pub max_graph_hops: usize,\n50\t    pub 