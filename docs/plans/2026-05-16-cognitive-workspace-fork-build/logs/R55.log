{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SSCgUQSQWjVHYRWnasv4UG","type":"tool_result","content":"1\t//! Verification engine core for durable memory evidence.\n2\t//!\n3\t//! This module implements the verifier contract from\n4\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## 8. Verification Engine`,\n6\t//! `## Phase 7: Verification And Freshness`, and\n7\t//! `## Storage Design`.\n8\t//!\n9\t//! Verification checks:\n10\t//!\n11\t//! - linked files still exist\n12\t//! - linked symbols still exist\n13\t//! - cited docs still exist\n14\t//! - linked tests still exist\n15\t//! - evidence text still matches when exact spans were captured\n16\t//! - implementation still matches memory claim where deterministic checks are possible\n17\t//! - contradicted/superseded states remain coherent\n18\t//! - branch-scoped memory is not leaking into unrelated branches\n19\t//! - time-bound memory has expired\n20\t//!\n21\t//! Verification outputs:\n22\t//!\n23\t//! - `verified`\n24\t//! - `unverified`\n25\t//! - `in_review`\n26\t//! - `stale`\n27\t//! - `contradicted`\n28\t//! - `superseded`\n29\t//! - `expired`\n30\t//! - `invalidated`\n31\t\n32\tuse std::fmt;\n33\tuse std::str::FromStr;\n34\t\n35\tuse rusqlite::Connection;\n36\tuse serde::{Deserialize, Serialize};\n37\t\n38\tuse crate::error::LatticeError;\n39\t\n40\tpub mod existence;\n41\tpub mod expiry;\n42\tpub mod incremental;\n43\tpub mod scope_enforcement;\n44\tpub mod spans;\n45\tpub mod surfacing;\n46\t\n47\t#[cfg(test)]\n48\tmod existence_tests;\n49\t#[cfg(test)]\n50\tmod incremental_tests;\n51\t#[cfg(test)]\n52\tmod integration_tests;\n53\t#[cfg(test)]\n54\tmod scope_leak_tests;\n55\t#[cfg(test)]\n56\tmod spans_tests;\n57\t#[cfg(test)]\n58\tmod surfacing_tests;\n59\t\n60\tpub use existence::{\n61\t    VerificationError, VerificationOutcome, VerifierBudget, VerifierCore, VerifierReport,\n62\t};\n63\tpub use expiry::{ExpiryError, ExpiryReport, ExpiryScanner};\n64\tpub use incremental::{\n65\t    IncrementalError, IncrementalReport, IncrementalVerifier, VerificationObserver,\n66\t};\n67\tpub use scope_enforcement::{\n68\t    allows, MemoryScopeFilteredEvent, OrganizationId, ScopeEnforcement, ScopeFilter,\n69\t    ScopeFilterError,\n70\t};\n71\tpub use spans::{\n72\t    SpanMismatch, SpanMismatchReason, SpanReader, SpanValidationError, SpanValidator,\n73\t    WorkspaceFileReader,\n74\t};\n75\tpub use surfacing::{\n76\t    classify_status, BundleProducer, BundleSection, LabeledMemory, SurfacedBundle, SurfacingError,\n77\t    SurfacingPipeline,\n78\t};\n79\t\n80\tconst VERIFICATION_SCHEMA_SQL: &str = include_str!(\"schema.sql\");\n81\t\n82\tpub fn initialize_schema(conn: &Connection) -> Result<(), LatticeError> {\n83\t    conn.execute_batch(VERIFICATION_SCHEMA_SQL)\n84\t        .map_err(|error| {\n85\t            LatticeError::Storage(format!(\"Failed to initialize verification schema: {error}\"))\n86\t        })?;\n87\t    Ok(())\n88\t}\n89\t\n90\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n91\t#[serde(rename_all = \"snake_case\")]\n92\tpub enum VerificationStatus {\n93\t    Verified,\n94\t    Unverified,\n95\t    InReview,\n96\t    Stale,\n97\t    Contradicted,\n98\t    Superseded,\n99\t    Expired,\n100\t    Invalidated,\n101\t}\n102\t\n103\timpl VerificationStatus {\n104\t    pub const VALUES: &'static [&'static str] = &[\n105\t        \"verified\",\n106\t        \"unverified\",\n107\t        \"in_review\",\n108\t        \"stale\",\n109\t        \"contradicted\",\n110\t        \"superseded\",\n111\t        \"expired\",\n112\t        \"invalidated\",\n113\t    ];\n114\t\n115\t    pub fn as_str(self) -> &'static str {\n116\t        match self {\n117\t            Self::Verified => \"verified\",\n118\t            Self::Unverified => \"unverified\",\n119\t            Self::InReview => \"in_review\",\n120\t            Self::Stale => \"stale\",\n121\t            Self::Contradicted => \"contradicted\",\n122\t            Self::Superseded => \"superseded\",\n123\t            Self::Expired => \"expired\",\n124\t            Self::Invalidated => \"invalidated\",\n125\t        }\n126\t    }\n127\t}\n128\t\n129\timpl fmt::Display for VerificationStatus {\n130\t    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n131\t        formatter.write_str(self.as_str())\n132\t    }\n133\t}\n134\t\n135\timpl FromStr for VerificationStatus {\n136\t    type Err = LatticeError;\n137\t\n138\t    fn from_str(value: &str) -> Result<Self, Self::Err> {\n139\t        match value {\n140\t            \"verified\" => Ok(Self::Verified),\n141\t            \"unverified\" => Ok(Self::Unverified),\n142\t            \"in_review\" => Ok(Self::InReview),\n143\t            \"stale\" => Ok(Self::Stale),\n144\t            \"contradicted\" => Ok(Self::Contradicted),\n145\t            \"superseded\" => Ok(Self::Superseded),\n146\t            \"expired\" => Ok(Self::Expired),\n147\t            \"invalidated\" => Ok(Self::Invalidated),\n148\t            other => Err(LatticeError::Storage(format!(\n149\t                \"Unknown verification status '{other}'\"\n150\t            ))),\n151\t        }\n152\t    }\n153\t}\n154\t\n155\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n156\tpub struct VerificationVerdict {\n157\t    pub status: VerificationStatus,\n158\t    pub reason: String,\n159\t}\n160\t\n161\timpl VerificationVerdict {\n162\t    pub fn new(status: VerificationStatus, reason: impl Into<String>) -> Self {\n163\t        Self {\n164\t            status,\n165\t            reason: reason.into(),\n166\t        }\n167\t    }\n168\t}\n169\t"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"aac935ef-dae2-4705-b0f2-6c7cc022727a","timestamp":"2026-05-17T13:09:18.567Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/mod.rs","content":"//! Verification engine core for durable memory evidence.\n//!\n//! This module implements the verifier contract from\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 8. Verification Engine`,\n//! `## Phase 7: Verification And Freshness`, and\n//! `## Storage Design`.\n//!\n//! Verification checks:\n//!\n//! - linked files still exist\n//! - linked symbols still exist\n//! - cited docs still exist\n//! - linked tests still exist\n//! - evidence text still matches when exact spans were captured\n//! - implementation still matches memory claim where deterministic checks are possible\n//! - contradicted/superseded states remain coherent\n//! - branch-scoped memory is not leaking into unrelated branches\n//! - time-bound memory has expired\n//!\n//! Verification outputs:\n//!\n//! - `verified`\n//! - `unverified`\n//! - `in_review`\n//! - `stale`\n//! - `contradicted`\n//! - `superseded`\n//! - `expired`\n//! - `invalidated`\n\nuse std::fmt;\nuse std::str::FromStr;\n\nuse rusqlite::Connection;\nuse serde::{Deserialize, Serialize};\n\nuse crate::error::LatticeError;\n\npub mod existence;\npub mod expiry;\npub mod incremental;\npub mod scope_enforcement;\npub mod spans;\npub mod surfacing;\n\n#[cfg(test)]\nmod existence_tests;\n#[cfg(test)]\nmod incremental_tests;\n#[cfg(test)]\nmod integration_tests;\n#[cfg(test)]\nmod scope_leak_tests;\n#[cfg(test)]\nmod spans_tests;\n#[cfg(test)]\nmod surfacing_tests;\n\npub use existence::{\n    VerificationError, VerificationOutcome, VerifierBudget, VerifierCore, VerifierReport,\n};\npub use expiry::{ExpiryError, ExpiryReport, ExpiryScanner};\npub use incremental::{\n    IncrementalError, IncrementalReport, IncrementalVerifier, VerificationObserver,\n};\npub use scope_enforcement::{\n    allows, MemoryScopeFilteredEvent, OrganizationId, ScopeEnforcement, ScopeFilter,\n    ScopeFilterError,\n};\npub use spans::{\n    SpanMismatch, SpanMismatchReason, SpanReader, SpanValidationError, SpanValidator,\n    WorkspaceFileReader,\n};\npub use surfacing::{\n    classify_status, BundleProducer, BundleSection, LabeledMemory, SurfacedBundle, SurfacingError,\n    SurfacingPipeline,\n};\n\nconst VERIFICATION_SCHEMA_SQL: &str = include_str!(\"schema.sql\");\n\npub fn initialize_schema(conn: &Connection) -> Result<(), LatticeError> {\n    conn.execute_batch(VERIFICATION_SCHEMA_SQL)\n        .map_err(|error| {\n            LatticeError::Storage(format!(\"Failed to initialize verification schema: {error}\"))\n        })?;\n    Ok(())\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum VerificationStatus {\n    Verified,\n    Unverified,\n    InReview,\n    Stale,\n    Contradicted,\n    Superseded,\n    Expired,\n    Invalidated,\n}\n\nimpl VerificationStatus {\n    pub const VALUES: &'static [&'static str] = &[\n        \"verified\",\n        \"unverified\",\n        \"in_review\",\n        \"stale\",\n        \"contradicted\",\n        \"superseded\",\n        \"expired\",\n        \"invalidated\",\n    ];\n\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::Verified => \"verified\",\n            Self::Unverified => \"unverified\",\n            Self::InReview => \"in_review\",\n            Self::Stale => \"stale\",\n            Self::Contradicted => \"contradicted\",\n            Self::Superseded => \"superseded\",\n            Self::Expired => \"expired\",\n            Self::Invalidated => \"invalidated\",\n        }\n    }\n}\n\nimpl fmt::Display for VerificationStatus {\n    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n        formatter.write_str(self.as_str())\n    }\n}\n\nimpl FromStr for VerificationStatus {\n    type Err = LatticeError;\n\n    fn from_str(value: &str) -> Result<Self, Self::Err> {\n        match value {\n            \"verified\" => Ok(Self::Verified),\n            \"unverified\" => Ok(Self::Unverified),\n            \"in_review\" => Ok(Self::InReview),\n            \"stale\" => Ok(Self::Stale),\n            \"contradicted\" => Ok(Self::Contradicted),\n            \"superseded\" => Ok(Self::Superseded),\n            \"expired\" => Ok(Self::Expired),\n            \"invalidated\" => Ok(Self::Invalidated),\n            other => Err(LatticeError::Storage(format!(\n                \"Unknown verification status '{other}'\"\n            ))),\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct VerificationVerdict {\n    pub status: VerificationStatus,\n    pub reason: String,\n}\n\nimpl VerificationVerdict {\n    pub fn new(status: VerificationStatus, reason: impl Into<String>) -> Self {\n        Self {\n            status,\n            reason: reason.into(),\n        }\n    }\n}\n","numLines":169,"startLine":1,"totalLines":169}}}
