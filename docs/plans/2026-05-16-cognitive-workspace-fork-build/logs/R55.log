{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ssxqt5mJzJxQYa6eL8SedR","type":"tool_result","content":"300\t\n301\tasync fn retrieve_memory_links(\n302\t    anchors: &[ResolvedAnchor],\n303\t    budget: &RetrievalBudget,\n304\t    ctx: &RetrievalContext<'_>,\n305\t) -> Vec<Candidate> {\n306\t    let Some(store) = ctx.memory_store else {\n307\t        return Vec::new();\n308\t    };\n309\t    let Ok(memories) = store.query_unscoped_admin(None, budget.max_candidates_per_source) else {\n310\t        return Vec::new();\n311\t    };\n312\t    let anchor_terms = anchor_link_terms(anchors);\n313\t    let candidates = memories\n314\t        .into_iter()\n315\t        .filter(|memory| memory_has_anchor_link(memory, &anchor_terms))\n316\t        .map(|memory| memory_candidate(ctx, memory.id, CandidateSource::MemoryLinks));\n317\t    enforce_budget(\n318\t        candidates.collect(),\n319\t        budget.max_candidates_per_source,\n320\t        CandidateSource::MemoryLinks,\n321\t    )\n322\t}\n323\t\n324\tasync fn retrieve_workflow_similarity(\n325\t    intent: &IntentClassification,\n326\t    budget: &RetrievalBudget,\n327\t    ctx: &RetrievalContext<'_>,\n328\t) -> Vec<Candidate> {\n329\t    if !source_enabled(intent, CandidateSource::WorkflowSimilarity) {\n330\t        return Vec::new();\n331\t    }\n332\t    let mut candidates = Vec::new();\n333\t    for event in ctx.event_candidates.iter().rev().take(budget.event_window) {\n334\t        if matches!(\n335\t            event.kind,\n336\t            EventKind::WorkflowSucceeded | EventKind::WorkflowFailed\n337\t        ) && event_matches_intent(event, intent)\n338\t        {\n339\t            candidates.push(event_candidate(event, CandidateSource::WorkflowSimilarity));\n340\t        }\n341\t    }\n342\t    enforce_budget(\n343\t        candidates,\n344\t        budget.max_candidates_per_source,\n345\t        CandidateSource::WorkflowSimilarity,\n346\t    )\n347\t}\n348\t\n349\tasync fn retrieve_