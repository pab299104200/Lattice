{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HNAk8m9jejuvj2G5XoWREm","type":"tool_result","content":"1\tuse serde::{Deserialize, Serialize};\n2\tuse std::str::FromStr;\n3\t\n4\tuse crate::events::DocSectionId;\n5\tuse crate::identity::{ContextHandleId, EventId, FileId, MemoryId, SymbolId};\n6\t\n7\t/// Event kinds defined by `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n8\t/// `### 3. Event Log`:\n9\t/// `AssistantTaskStarted`, `ToolCalled`, `ToolResult`, `ContextBundleReturned`,\n10\t/// `MemoryRetrieved`, `MemoryExpanded`, `PlanCreated`, `FileRead`, `PatchApplied`,\n11\t/// `TestRunStarted`, `TestRunCompleted`, `DiagnosticObserved`, `UserCorrection`,\n12\t/// `UserPreferenceObserved`, `WorkflowSucceeded`, `WorkflowFailed`, `MemoryCreated`,\n13\t/// `MemoryUpdated`, `MemoryInvalidated`, `MemoryConsolidated`.\n14\t#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n15\t#[serde(rename_all = \"snake_case\")]\n16\tpub enum EventKind {\n17\t    AssistantTaskStarted,\n18\t    ToolCalled,\n19\t    ToolResult,\n20\t    ContextBundleReturned,\n21\t    MemoryRetrieved,\n22\t    MemoryExpanded,\n23\t    PlanCreated,\n24\t    FileRead,\n25\t    PatchApplied,\n26\t    TestRunStarted,\n27\t    TestRunCompleted,\n28\t    DiagnosticObserved,\n29\t    UserCorrection,\n30\t    UserPreferenceObserved,\n31\t    WorkflowSucceeded,\n32\t    WorkflowFailed,\n33\t    MemoryCreated,\n34\t    MemoryUpdated,\n35\t    MemoryInvalidated,\n36\t    MemoryConsolidated,\n37\t}\n38\t\n39\timpl EventKind {\n40\t    /// Return the canonical snake_case wire name used in storage.\n41\t    pub fn as_str(self) -> &'static str {\n42\t        match self {\n43\t            EventKind::AssistantTaskStarted => \"assistant_task_started\",\n44\t            EventKind::ToolCalled => \"tool_called\",\n45\t            EventKind::ToolResult => \"tool_result\",\n46\t            EventKind::ContextBundleReturned => \"context_bundle_returned\",\n47\t            EventKind::MemoryRetrieved => \"memory_retrieved\",\n48\t            EventKind::MemoryExpanded => \"memory_expanded\",\n49\t            EventKind::PlanCreated => \"plan_created\",\n50\t            EventKind::FileRead => \"file_read\",\n51\t            EventKind::PatchApplied => \"patch_applied\",\n52\t            EventKind::TestRunStarted => \"test_run_started\",\n53\t            EventKind::TestRunCompleted => \"test_run_completed\",\n54\t            EventKind::DiagnosticObserved => \"diagnostic_observed\",\n55\t            EventKind::UserCorrection => \"user_correction\",\n56\t            EventKind::UserPreferenceObserved => \"user_preference_observed\",\n57\t            EventKind::WorkflowSucceeded => \"workflow_succeeded\",\n58\t            EventKind::WorkflowFailed => \"workflow_failed\",\n59\t            EventKind::MemoryCreated => \"memory_created\",\n60\t            EventKind::MemoryUpdated => \"memory_updated\",\n61\t            EventKind::MemoryInvalidated => \"memory_invalidated\",\n62\t            EventKind::MemoryConsolidated => \"memory_consolidated\",\n63\t        }\n64\t    }\n65\t}\n66\t\n67\timpl FromStr for EventKind {\n68\t    type Err = String;\n69\t\n70\t    fn from_str(value: &str) -> Result<Self, Self::Err> {\n71\t        match value {\n72\t            \"assistant_task_started\" => Ok(EventKind::AssistantTaskStarted),\n73\t            \"tool_called\" => Ok(EventKind::ToolCalled),\n74\t            \"tool_result\" => Ok(EventKind::ToolResult),\n75\t            \"context_bundle_returned\" => Ok(EventKind::ContextBundleReturned),\n76\t            \"memory_retrieved\" => Ok(EventKind::MemoryRetrieved),\n77\t            \"memory_expanded\" => Ok(EventKind::MemoryExpanded),\n78\t            \"plan_created\" => Ok(EventKind::PlanCreated),\n79\t            \"file_read\" => Ok(EventKind::FileRead),\n80\t            \"patch_applied\" => Ok(EventKind::PatchApplied),\n81\t            \"test_run_started\" => Ok(EventKind::TestRunStarted),\n82\t            \"test_run_completed\" => Ok(EventKind::TestRunCompleted),\n83\t            \"diagnostic_observed\" => Ok(EventKind::DiagnosticObserved),\n84\t            \"user_correction\" => Ok(EventKind::UserCorrection),\n85\t            \"user_preference_observed\" => Ok(EventKind::UserPreferenceObserved),\n86\t            \"workflow_succeeded\" => Ok(EventKind::WorkflowSucceeded),\n87\t            \"workflow_failed\" => Ok(EventKind::WorkflowFailed),\n88\t            \"memory_created\" => Ok(EventKind::MemoryCreated),\n89\t            \"memory_updated\" => Ok(EventKind::MemoryUpdated),\n90\t            \"memory_invalidated\" => Ok(EventKind::MemoryInvalidated),\n91\t            \"memory_consolidated\" => Ok(EventKind::MemoryConsolidated),\n92\t            other => Err(format!(\"unknown event kind `{other}`\")),\n93\t        }\n94\t    }\n95\t}\n96\t\n97\t/// Tool result status recorded in event payloads.\n98\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n99\t#[serde(rename_all = \"snake_case\")]\n100\tpub enum ToolResultStatus {\n101\t    Succeeded,\n102\t    Failed,\n103\t    Partial,\n104\t}\n105\t\n106\t/// Test run terminal status recorded in event payloads.\n107\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n108\t#[serde(rename_all = \"snake_case\")]\n109\tpub enum TestRunStatus {\n110\t    Passed,\n111\t    Failed,\n112\t    Cancelled,\n113\t}\n114\t\n115\t/// Diagnostic severity normalized for the event stream.\n116\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n117\t#[serde(rename_all = \"snake_case\")]\n118\tpub enum DiagnosticSeverity {\n119\t    Info,\n120\t    Warning,\n121\t    Error,\n122\t}\n123\t\n124\t/// Payload for `assistant_task_started`.\n125\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n126\tpub struct AssistantTaskStartedPayload {\n127\t    /// Context handle created for the task, when available.\n128\t    pub context_handle_id: Option<ContextHandleId>,\n129\t    /// Prior events used to seed the task context.\n130\t    pub seed_event_ids: Vec<EventId>,\n131\t    /// Existing memories surfaced before the task started.\n132\t    pub initial_memory_ids: Vec<MemoryId>,\n133\t    /// Compact objective for the task start event.\n134\t    pub objective: String,\n135\t}\n136\t\n137\t/// Payload for `tool_called`.\n138\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n139\tpub struct ToolCalledPayload {\n140\t    /// Unique call id for matching request and result events.\n141\t    pub call_id: String,\n142\t    /// Tool name invoked by the assistant or daemon.\n143\t    pub tool_name: String,\n144\t    /// Context handle supplied to the tool call.\n145\t    pub context_handle_id: Option<ContextHandleId>,\n146\t    /// Event that requested the tool call, when chained.\n147\t    pub source_event_id: Option<EventId>,\n148\t    /// Compact summary of the call input.\n149\t    pub input_summary: String,\n150\t}\n151\t\n152\t/// Payload for `tool_result`.\n153\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n154\tpub struct ToolResultPayload {\n155\t    /// Tool call id that this result satisfies.\n156\t    pub call_id: String,\n157\t    /// Tool name that produced the result.\n158\t    pub tool_name: String,\n159\t    /// Terminal status for the tool call.\n160\t    pub status: ToolResultStatus,\n161\t    /// Event id of the originating tool call.\n162\t    pub tool_call_event_id: Option<EventId>,\n163\t    /// Context handle produced by the tool, when any.\n164\t    pub output_context_handle_id: Option<ContextHandleId>,\n165\t    /// Memories materialized directly by the tool result.\n166\t    pub created_memory_ids: Vec<MemoryId>,\n167\t    /// Compact summary of the tool output.\n168\t    pub output_summary: String,\n169\t}\n170\t\n171\t/// Payload for `context_bundle_returned`.\n172\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n173\tpub struct ContextBundleReturnedPayload {\n174\t    /// Stable handle for the returned bundle.\n175\t    pub context_handle_id: ContextHandleId,\n176\t    /// Event that requested the bundle.\n177\t    pub source_event_id: Option<EventId>,\n178\t    /// Files included in the returned bundle.\n179\t    pub file_ids: Vec<FileId>,\n180\t    /// Symbols included in the returned bundle.\n181\t    pub symbol_ids: Vec<SymbolId>,\n182\t    /// Document sections included in the bundle.\n183\t    pub doc_section_ids: Vec<DocSectionId>,\n184\t    /// Memories included in the bundle.\n185\t    pub memory_ids: Vec<MemoryId>,\n186\t    /// Approximate token budget of the returned bundle.\n187\t    pub token_estimate: u32,\n188\t}\n189\t\n190\t/// Payload for `memory_retrieved`.\n191\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n192\tpub struct MemoryRetrievedPayload {\n193\t    /// Query or task string used to retrieve memories.\n194\t    pub retrieval_query: String,\n195\t    /// Context handle associated with the retrieval.\n196\t    pub context_handle_id: Option<ContextHandleId>,\n197\t    /// Memories returned to the assistant.\n198\t    pub memory_ids: Vec<MemoryId>,\n199\t    /// Evidence events cited by the retrieval layer.\n200\t    pub supporting_event_ids: Vec<EventId>,\n201\t}\n202\t\n203\t/// Payload for `memory_expanded`.\n204\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n205\tpub struct MemoryExpandedPayload {\n206\t    /// Memory whose neighborhood was expanded.\n207\t    pub memory_id: MemoryId,\n208\t    /// Event that requested the expansion.\n209\t    pub source_event_id: Option<EventId>,\n210\t    /// Additional memories surfaced by expansion.\n211\t    pub linked_memory_ids: Vec<MemoryId>,\n212\t    /// Symbols surfaced by expansion.\n213\t    pub linked_symbol_ids: Vec<SymbolId>,\n214\t    /// Document sections surfaced by expansion.\n215\t    pub linked_doc_section_ids: Vec<DocSectionId>,\n216\t}\n217\t\n218\t/// Payload for `plan_created`.\n219\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n220\tpub struct PlanCreatedPayload {\n221\t    /// Context handle attached to the plan output.\n222\t    pub context_handle_id: Option<ContextHandleId>,\n223\t    /// Event that triggered plan creation.\n224\t    pub source_event_id: Option<EventId>,\n225\t    /// Memory ids cited while creating the plan.\n226\t    pub memory_ids: Vec<MemoryId>,\n227\t    /// Number of plan steps produced.\n228\t    pub step_count: u32,\n229\t    /// Compact summary of the plan body.\n230\t    pub plan_summary: String,\n231\t}\n232\t\n233\t/// Payload for `file_read`.\n234\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n235\tpub struct FileReadPayload {\n236\t    /// File read by the assistant, daemon, or tool.\n237\t    pub file_id: FileId,\n238\t    /// Event that triggered the file read.\n239\t    pub source_event_id: Option<EventId>,\n240\t    /// Optional first byte offset included in the read.\n241\t    pub byte_start: Option<u32>,\n242\t    /// Optional exclusive end byte offset included in the read.\n243\t    pub byte_end: Option<u32>,\n244\t    /// Compact purpose statement for the read.\n245\t    pub reason: String,\n246\t}\n247\t\n248\t/// Payload for `patch_applied`.\n249\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n250\tpub struct PatchAppliedPayload {\n251\t    /// Stable patch or edit operation id.\n252\t    pub patch_id: String,\n253\t    /// Event that produced the patch.\n254\t    pub source_event_id: Option<EventId>,\n255\t    /// Files changed by the patch.\n256\t    pub file_ids: Vec<FileId>,\n257\t    /// Symbols changed by the patch.\n258\t    pub symbol_ids: Vec<SymbolId>,\n259\t    /// Number of inserted lines in the patch.\n260\t    pub lines_added: u32,\n261\t    /// Number of removed lines in the patch.\n262\t    pub lines_removed: u32,\n263\t}\n264\t\n265\t/// Payload for `test_run_started`.\n266\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n267\tpub struct TestRunStartedPayload {\n268\t    /// Stable test run id for matching start and completion.\n269\t    pub run_id: String,\n270\t    /// Event that triggered the test run.\n271\t    pub source_event_id: Option<EventId>,\n272\t    /// Files targeted by the test run.\n273\t    pub file_ids: Vec<FileId>,\n274\t    /// Symbols targeted by the test run.\n275\t    pub symbol_ids: Vec<SymbolId>,\n276\t    /// Command executed for the test run.\n277\t    pub command: String,\n278\t}\n279\t\n280\t/// Payload for `test_run_completed`.\n281\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n282\tpub struct TestRunCompletedPayload {\n283\t    /// Stable id of the completed test run.\n284\t    pub run_id: String,\n285\t    /// Event id of the corresponding start event.\n286\t    pub started_event_id: Option<EventId>,\n287\t    /// Terminal status for the run.\n288\t    pub status: TestRunStatus,\n289\t    /// Number of passed tests.\n290\t    pub passed: u32,\n291\t    /// Number of failed tests.\n292\t    pub failed: u32,\n293\t    /// Number of skipped tests.\n294\t    pub skipped: u32,\n295\t    /// Diagnostics emitted during the run.\n296\t    pub diagnostic_event_ids: Vec<EventId>,\n297\t}\n298\t\n299\t/// Payload for `diagnostic_observed`.\n300\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n301\tpub struct DiagnosticObservedPayload {\n302\t    /// Stable diagnostic id emitted by the reporter.\n303\t    pub diagnostic_id: String,\n304\t    /// Event that observed or produced the diagnostic.\n305\t    pub source_event_id: Option<EventId>,\n306\t    /// File associated with the diagnostic.\n307\t    pub file_id: FileId,\n308\t    /// Symbol associated with the diagnostic, when resolved.\n309\t    pub symbol_id: Option<SymbolId>,\n310\t    /// Severity level of the diagnostic.\n311\t    pub severity: DiagnosticSeverity,\n312\t    /// Human-readable diagnostic summary.\n313\t    pub message: String,\n314\t}\n315\t\n316\t/// Payload for `user_correction`.\n317\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n318\tpub struct UserCorrectionPayload {\n319\t    /// Event directly corrected by the user.\n320\t    pub corrected_event_id: EventId,\n321\t    /// Files the user corrected or selected instead.\n322\t    pub file_ids: Vec<FileId>,\n323\t    /// Memories explicitly superseded by the correction.\n324\t    pub superseded_memory_ids: Vec<MemoryId>,\n325\t    /// Compact summary of the correction.\n326\t    pub correction_summary: String,\n327\t}\n328\t\n329\t/// Payload for `user_preference_observed`.\n330\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n331\tpub struct UserPreferenceObservedPayload {\n332\t    /// Canonical preference key observed from user behavior.\n333\t    pub preference_key: String,\n334\t    /// Normalized preference value or setting.\n335\t    pub preference_value: String,\n336\t    /// Event from which the preference was inferred.\n337\t    pub observed_from_event_id: Option<EventId>,\n338\t    /// Memory record capturing the durable preference, when any.\n339\t    pub memory_id: Option<MemoryId>,\n340\t}\n341\t\n342\t/// Payload for `workflow_succeeded`.\n343\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n344\tpub struct WorkflowSucceededPayload {\n345\t    /// Workflow name or bundle that succeeded.\n346\t    pub workflow_name: String,\n347\t    /// Event that closed the workflow successfully.\n348\t    pub terminal_event_id: Option<EventId>,\n349\t    /// Output handle produced by the workflow.\n350\t    pub output_context_handle_id: Option<ContextHandleId>,\n351\t    /// Memory ids created or strengthened by the workflow.\n352\t    pub memory_ids: Vec<MemoryId>,\n353\t    /// Compact success summary.\n354\t    pub result_summary: String,\n355\t}\n356\t\n357\t/// Payload for `workflow_failed`.\n358\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n359\tpub struct WorkflowFailedPayload {\n360\t    /// Workflow name or bundle that failed.\n361\t    pub workflow_name: String,\n362\t    /// Event that terminated the workflow.\n363\t    pub terminal_event_id: Option<EventId>,\n364\t    /// Diagnostics explaining the failure.\n365\t    pub diagnostic_event_ids: Vec<EventId>,\n366\t    /// Whether the failure is safe to retry automatically.\n367\t    pub retryable: bool,\n368\t    /// Compact failure summary.\n369\t    pub failure_summary: String,\n370\t}\n371\t\n372\t/// Payload for `memory_created`.\n373\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n374\tpub struct MemoryCreatedPayload {\n375\t    /// Memory created by the workflow.\n376\t    pub memory_id: MemoryId,\n377\t    /// Memory class written into the memory graph.\n378\t    pub class: String,\n379\t    /// Deterministic stream classification for the created memory.\n380\t    pub stream: String,\n381\t    /// Scope name for the created memory.\n382\t    pub scope: String,\n383\t    /// Caller-supplied idempotency key used for dedupe.\n384\t    pub idempotency_key: String,\n385\t    /// Event that requested the memory creation.\n386\t    pub source_event_id: Option<EventId>,\n387\t    /// Evidence events attached to the new memory.\n388\t    pub evidence_event_ids: Vec<EventId>,\n389\t    /// Symbols linked to the created memory.\n390\t    pub symbol_ids: Vec<SymbolId>,\n391\t    /// Document sections linked to the created memory.\n392\t    pub doc_section_ids: Vec<DocSectionId>,\n393\t    /// Optional exact post-write snapshot for replayable memory-graph rebuilds.\n394\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n395\t    pub replay_snapshot_json: Option<String>,\n396\t}\n397\t\n398\t/// Payload for `memory_updated`.\n399\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n400\tpub struct MemoryUpdatedPayload {\n401\t    /// Memory updated by the workflow.\n402\t    pub memory_id: MemoryId,\n403\t    /// Prior event that recorded the older memory state.\n404\t    pub previous_event_id: Option<EventId>,\n405\t    /// Evidence events attached to the update.\n406\t    pub evidence_event_ids: Vec<EventId>,\n407\t    /// Optional memory id explicitly superseded by the update.\n408\t    pub superseded_memory_id: Option<MemoryId>,\n409\t    /// Compact summary of the update.\n410\t    pub update_summary: String,\n411\t    /// Optional exact post-write snapshot for replayable memory-graph rebuilds.\n412\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n413\t    pub replay_snapshot_json: Option<String>,\n414\t}\n415\t\n416\t/// Payload for `memory_invalidated`.\n417\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n418\tpub struct MemoryInvalidatedPayload {\n419\t    /// Memory invalidated by the workflow.\n420\t    pub memory_id: MemoryId,\n421\t    /// Event that caused the invalidation.\n422\t    pub invalidated_by_event_id: Option<EventId>,\n423\t    /// Contradicting memories that justify invalidation.\n424\t    pub contradicting_memory_ids: Vec<MemoryId>,\n425\t    /// Compact invalidation reason.\n426\t    pub reason: String,\n427\t    /// Optional exact post-write snapshot for replayable memory-graph rebuilds.\n428\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n429\t    pub replay_snapshot_json: Option<String>,\n430\t}\n431\t\n432\t/// Payload for `memory_consolidated`.\n433\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n434\tpub struct MemoryConsolidatedPayload {\n435\t    /// Source memories consumed by consolidation.\n436\t    pub source_memory_ids: Vec<MemoryId>,\n437\t    /// Consolidated memory emitted by the pass.\n438\t    pub consolidated_memory_id: MemoryId,\n439\t    /// Source events used as evidence for consolidation.\n440\t    pub source_event_ids: Vec<EventId>,\n441\t    /// Compact summary of the consolidation result.\n442\t    pub consolidation_summary: String,\n443\t}\n444\t\n445\t/// Typed payload wrapper for every event kind.\n446\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n447\t#[serde(tag = \"kind\", content = \"payload\", rename_all = \"snake_case\")]\n448\tpub enum EventPayload {\n449\t    AssistantTaskStarted(AssistantTaskStartedPayload),\n450\t    ToolCalled(ToolCalledPayload),\n451\t    ToolResult(ToolResultPayload),\n452\t    ContextBundleReturned(ContextBundleReturnedPayload),\n453\t    MemoryRetrieved(MemoryRetrievedPayload),\n454\t    MemoryExpanded(MemoryExpandedPayload),\n455\t    PlanCreated(PlanCreatedPayload),\n456\t    FileRead(FileReadPayload),\n457\t    PatchApplied(PatchAppliedPayload),\n458\t    TestRunStarted(TestRunStartedPayload),\n459\t    TestRunCompleted(TestRunCompletedPayload),\n460\t    DiagnosticObserved(DiagnosticObservedPayload),\n461\t    UserCorrection(UserCorrectionPayload),\n462\t    UserPreferenceObserved(UserPreferenceObservedPayload),\n463\t    WorkflowSucceeded(WorkflowSucceededPayload),\n464\t    WorkflowFailed(WorkflowFailedPayload),\n465\t    MemoryCreated(MemoryCreatedPayload),\n466\t    MemoryUpdated(MemoryUpdatedPayload),\n467\t    MemoryInvalidated(MemoryInvalidatedPayload),\n468\t    MemoryConsolidated(MemoryConsolidatedPayload),\n469\t}\n470\t\n471\timpl EventPayload {\n472\t    /// Return the `EventKind` corresponding to this payload variant.\n473\t    pub fn kind(&self) -> EventKind {\n474\t        match self {\n475\t            EventPayload::AssistantTaskStarted(_) => EventKind::AssistantTaskStarted,\n476\t            EventPayload::ToolCalled(_) => EventKind::ToolCalled,\n477\t            EventPayload::ToolResult(_) => EventKind::ToolResult,\n478\t            EventPayload::ContextBundleReturned(_) => EventKind::ContextBundleReturned,\n479\t            EventPayload::MemoryRetrieved(_) => EventKind::MemoryRetrieved,\n480\t            EventPayload::MemoryExpanded(_) => EventKind::MemoryExpanded,\n481\t            EventPayload::PlanCreated(_) => EventKind::PlanCreated,\n482\t            EventPayload::FileRead(_) => EventKind::FileRead,\n483\t            EventPayload::PatchApplied(_) => EventKind::PatchApplied,\n484\t            EventPayload::TestRunStarted(_) => EventKind::TestRunStarted,\n485\t            EventPayload::TestRunCompleted(_) => EventKind::TestRunCompleted,\n486\t            EventPayload::DiagnosticObserved(_) => EventKind::DiagnosticObserved,\n487\t            EventPayload::UserCorrection(_) => EventKind::UserCorrection,\n488\t            EventPayload::UserPreferenceObserved(_) => EventKind::UserPreferenceObserved,\n489\t            EventPayload::WorkflowSucceeded(_) => EventKind::WorkflowSucceeded,\n490\t            EventPayload::WorkflowFailed(_) => EventKind::WorkflowFailed,\n491\t            EventPayload::MemoryCreated(_) => EventKind::MemoryCreated,\n492\t            EventPayload::MemoryUpdated(_) => EventKind::MemoryUpdated,\n493\t            EventPayload::MemoryInvalidated(_) => EventKind::MemoryInvalidated,\n494\t            EventPayload::MemoryConsolidated(_) => EventKind::MemoryConsolidated,\n495\t        }\n496\t    }\n497\t}\n498\t"}]},"parent_tool_use_id":null,"session_id":"97e40997-f38f-4628-bdcd-a9758dda27fa","uuid":"c7e5882b-ee48-4e12-88ee-3d8ea3e8ffff","timestamp":"2026-05-17T07:28:00.126Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/kinds.rs","content":"use serde::{Deserialize, Serialize};\nuse std::str::FromStr;\n\nuse crate::events::DocSectionId;\nuse crate::identity::{ContextHandleId, EventId, FileId, MemoryId, SymbolId};\n\n/// Event kinds defined by `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n/// `### 3. Event Log`:\n/// `AssistantTaskStarted`, `ToolCalled`, `ToolResult`, `ContextBundleReturned`,\n/// `MemoryRetrieved`, `MemoryExpanded`, `PlanCreated`, `FileRead`, `PatchApplied`,\n/// `TestRunStarted`, `TestRunCompleted`, `DiagnosticObserved`, `UserCorrection`,\n/// `UserPreferenceObserved`, `WorkflowSucceeded`, `WorkflowFailed`, `MemoryCreated`,\n/// `MemoryUpdated`, `MemoryInvalidated`, `MemoryConsolidated`.\n#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[serde(rename_all = \"snake_case\")]\npub enum EventKind {\n    AssistantTaskStarted,\n    ToolCalled,\n    ToolResult,\n    ContextBundleReturned,\n    MemoryRetrieved,\n    MemoryExpanded,\n    PlanCreated,\n    FileRead,\n    PatchApplied,\n    TestRunStarted,\n    TestRunCompleted,\n    DiagnosticObserved,\n    UserCorrection,\n    UserPreferenceObserved,\n    WorkflowSucceeded,\n    WorkflowFailed,\n    MemoryCreated,\n    MemoryUpdated,\n    MemoryInvalidated,\n    MemoryConsolidated,\n}\n\nimpl EventKind {\n    /// Return the canonical snake_case wire name used in storage.\n    pub fn as_str(self) -> &'static str {\n        match self {\n            EventKind::AssistantTaskStarted => \"assistant_task_started\",\n            EventKind::ToolCalled => \"tool_called\",\n            EventKind::ToolResult => \"tool_result\",\n            EventKind::ContextBundleReturned => \"context_bundle_returned\",\n            EventKind::MemoryRetrieved => \"memory_retrieved\",\n            EventKind::MemoryExpanded => \"memory_expanded\",\n            EventKind::PlanCreated => \"plan_created\",\n            EventKind::FileRead => \"file_read\",\n            EventKind::PatchApplied => \"patch_applied\",\n            EventKind::TestRunStarted => \"test_run_started\",\n            EventKind::TestRunCompleted => \"test_run_completed\",\n            EventKind::DiagnosticObserved => \"diagnostic_observed\",\n            EventKind::UserCorrection => \"user_correction\",\n            EventKind::UserPreferenceObserved => \"user_preference_observed\",\n            EventKind::WorkflowSucceeded => \"workflow_succeeded\",\n            EventKind::WorkflowFailed => \"workflow_failed\",\n            EventKind::MemoryCreated => \"memory_created\",\n            EventKind::MemoryUpdated => \"memory_updated\",\n            EventKind::MemoryInvalidated => \"memory_invalidated\",\n            EventKind::MemoryConsolidated => \"memory_consolidated\",\n        }\n    }\n}\n\nimpl FromStr for EventKind {\n    type Err = String;\n\n    fn from_str(value: &str) -> Result<Self, Self::Err> {\n        match value {\n            \"assistant_task_started\" => Ok(EventKind::AssistantTaskStarted),\n            \"tool_called\" => Ok(EventKind::ToolCalled),\n            \"tool_result\" => Ok(EventKind::ToolResult),\n            \"context_bundle_returned\" => Ok(EventKind::ContextBundleReturned),\n            \"memory_retrieved\" => Ok(EventKind::MemoryRetrieved),\n            \"memory_expanded\" => Ok(EventKind::MemoryExpanded),\n            \"plan_created\" => Ok(EventKind::PlanCreated),\n            \"file_read\" => Ok(EventKind::FileRead),\n            \"patch_applied\" => Ok(EventKind::PatchApplied),\n            \"test_run_started\" => Ok(EventKind::TestRunStarted),\n            \"test_run_completed\" => Ok(EventKind::TestRunCompleted),\n            \"diagnostic_observed\" => Ok(EventKind::DiagnosticObserved),\n            \"user_correction\" => Ok(EventKind::UserCorrection),\n            \"user_preference_observed\" => Ok(EventKind::UserPreferenceObserved),\n            \"workflow_succeeded\" => Ok(EventKind::WorkflowSucceeded),\n            \"workflow_failed\" => Ok(EventKind::WorkflowFailed),\n            \"memory_created\" => Ok(EventKind::MemoryCreated),\n            \"memory_updated\" => Ok(EventKind::MemoryUpdated),\n            \"memory_invalidated\" => Ok(EventKind::MemoryInvalidated),\n            \"memory_consolidated\" => Ok(EventKind::MemoryConsolidated),\n            other => Err(format!(\"unknown event kind `{other}`\")),\n        }\n    }\n}\n\n/// Tool result status recorded in event payloads.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum ToolResultStatus {\n    Succeeded,\n    Failed,\n    Partial,\n}\n\n/// Test run terminal status recorded in event payloads.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum TestRunStatus {\n    Passed,\n    Failed,\n    Cancelled,\n}\n\n/// Diagnostic severity normalized for the event stream.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum DiagnosticSeverity {\n    Info,\n    Warning,\n    Error,\n}\n\n/// Payload for `assistant_task_started`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct AssistantTaskStartedPayload {\n    /// Context handle created for the task, when available.\n    pub context_handle_id: Option<ContextHandleId>,\n    /// Prior events used to seed the task context.\n    pub seed_event_ids: Vec<EventId>,\n    /// Existing memories surfaced before the task started.\n    pub initial_memory_ids: Vec<MemoryId>,\n    /// Compact objective for the task start event.\n    pub objective: String,\n}\n\n/// Payload for `tool_called`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct ToolCalledPayload {\n    /// Unique call id for matching request and result events.\n    pub call_id: String,\n    /// Tool name invoked by the assistant or daemon.\n    pub tool_name: String,\n    /// Context handle supplied to the tool call.\n    pub context_handle_id: Option<ContextHandleId>,\n    /// Event that requested the tool call, when chained.\n    pub source_event_id: Option<EventId>,\n    /// Compact summary of the call input.\n    pub input_summary: String,\n}\n\n/// Payload for `tool_result`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct ToolResultPayload {\n    /// Tool call id that this result satisfies.\n    pub call_id: String,\n    /// Tool name that produced the result.\n    pub tool_name: String,\n    /// Terminal status for the tool call.\n    pub status: ToolResultStatus,\n    /// Event id of the originating tool call.\n    pub tool_call_event_id: Option<EventId>,\n    /// Context handle produced by the tool, when any.\n    pub output_context_handle_id: Option<ContextHandleId>,\n    /// Memories materialized directly by the tool result.\n    pub created_memory_ids: Vec<MemoryId>,\n    /// Compact summary of the tool output.\n    pub output_summary: String,\n}\n\n/// Payload for `context_bundle_returned`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct ContextBundleReturnedPayload {\n    /// Stable handle for the returned bundle.\n    pub context_handle_id: ContextHandleId,\n    /// Event that requested the bundle.\n    pub source_event_id: Option<EventId>,\n    /// Files included in the returned bundle.\n    pub file_ids: Vec<FileId>,\n    /// Symbols included in the returned bundle.\n    pub symbol_ids: Vec<SymbolId>,\n    /// Document sections included in the bundle.\n    pub doc_section_ids: Vec<DocSectionId>,\n    /// Memories included in the bundle.\n    pub memory_ids: Vec<MemoryId>,\n    /// Approximate token budget of the returned bundle.\n    pub token_estimate: u32,\n}\n\n/// Payload for `memory_retrieved`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct MemoryRetrievedPayload {\n    /// Query or task string used to retrieve memories.\n    pub retrieval_query: String,\n    /// Context handle associated with the retrieval.\n    pub context_handle_id: Option<ContextHandleId>,\n    /// Memories returned to the assistant.\n    pub memory_ids: Vec<MemoryId>,\n    /// Evidence events cited by the retrieval layer.\n    pub supporting_event_ids: Vec<EventId>,\n}\n\n/// Payload for `memory_expanded`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct MemoryExpandedPayload {\n    /// Memory whose neighborhood was expanded.\n    pub memory_id: MemoryId,\n    /// Event that requested the expansion.\n    pub source_event_id: Option<EventId>,\n    /// Additional memories surfaced by expansion.\n    pub linked_memory_ids: Vec<MemoryId>,\n    /// Symbols surfaced by expansion.\n    pub linked_symbol_ids: Vec<SymbolId>,\n    /// Document sections surfaced by expansion.\n    pub linked_doc_section_ids: Vec<DocSectionId>,\n}\n\n/// Payload for `plan_created`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct PlanCreatedPayload {\n    /// Context handle attached to the plan output.\n    pub context_handle_id: Option<ContextHandleId>,\n    /// Event that triggered plan creation.\n    pub source_event_id: Option<EventId>,\n    /// Memory ids cited while creating the plan.\n    pub memory_ids: Vec<MemoryId>,\n    /// Number of plan steps produced.\n    pub step_count: u32,\n    /// Compact summary of the plan body.\n    pub plan_summary: String,\n}\n\n/// Payload for `file_read`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct FileReadPayload {\n    /// File read by the assistant, daemon, or tool.\n    pub file_id: FileId,\n    /// Event that triggered the file read.\n    pub source_event_id: Option<EventId>,\n    /// Optional first byte offset included in the read.\n    pub byte_start: Option<u32>,\n    /// Optional exclusive end byte offset included in the read.\n    pub byte_end: Option<u32>,\n    /// Compact purpose statement for the read.\n    pub reason: String,\n}\n\n/// Payload for `patch_applied`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct PatchAppliedPayload {\n    /// Stable patch or edit operation id.\n    pub patch_id: String,\n    /// Event that produced the patch.\n    pub source_event_id: Option<EventId>,\n    /// Files changed by the patch.\n    pub file_ids: Vec<FileId>,\n    /// Symbols changed by the patch.\n    pub symbol_ids: Vec<SymbolId>,\n    /// Number of inserted lines in the patch.\n    pub lines_added: u32,\n    /// Number of removed lines in the patch.\n    pub lines_removed: u32,\n}\n\n/// Payload for `test_run_started`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct TestRunStartedPayload {\n    /// Stable test run id for matching start and completion.\n    pub run_id: String,\n    /// Event that triggered the test run.\n    pub source_event_id: Option<EventId>,\n    /// Files targeted by the test run.\n    pub file_ids: Vec<FileId>,\n    /// Symbols targeted by the test run.\n    pub symbol_ids: Vec<SymbolId>,\n    /// Command executed for the test run.\n    pub command: String,\n}\n\n/// Payload for `test_run_completed`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct TestRunCompletedPayload {\n    /// Stable id of the completed test run.\n    pub run_id: String,\n    /// Event id of the corresponding start event.\n    pub started_event_id: Option<EventId>,\n    /// Terminal status for the run.\n    pub status: TestRunStatus,\n    /// Number of passed tests.\n    pub passed: u32,\n    /// Number of failed tests.\n    pub failed: u32,\n    /// Number of skipped tests.\n    pub skipped: u32,\n    /// Diagnostics emitted during the run.\n    pub diagnostic_event_ids: Vec<EventId>,\n}\n\n/// Payload for `diagnostic_observed`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct DiagnosticObservedPayload {\n    /// Stable diagnostic id emitted by the reporter.\n    pub diagnostic_id: String,\n    /// Event that observed or produced the diagnostic.\n    pub source_event_id: Option<EventId>,\n    /// File associated with the diagnostic.\n    pub file_id: FileId,\n    /// Symbol associated with the diagnostic, when resolved.\n    pub symbol_id: Option<SymbolId>,\n    /// Severity level of the diagnostic.\n    pub severity: DiagnosticSeverity,\n    /// Human-readable diagnostic summary.\n    pub message: String,\n}\n\n/// Payload for `user_correction`.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct UserCorrectionPayload {\n    /// Event directly corrected by the user.\n    pub corrected_event_id: EventId,\n    /// Files the user corrected or selected instead