95\t            link.link_type.as_str(),\n296\t            link.strength,\n297\t            link.reason,\n298\t            evidence_event_id,\n299\t            created_by_kind,\n300\t            created_by_detail,\n301\t            encode_timestamp(link.created_at),\n302\t            link.verification_status.as_str(),\n303\t        ],\n304\t    );\n305\t    if let Err(error) = result {\n306\t        warn_on_fk_violation(\"insert_link\", &error);\n307\t        return Err(MemoryLinkError::Sqlite(error));\n308\t    }\n309\t    Ok(())\n310\t}\n311\t\n312\tpub fn get_links_from(\n313\t    conn: &Connection,\n314\t    source: &MemoryId,\n315\t) -> Result<Vec<MemoryLink>, MemoryLinkError> {\n316\t    let source_memory_id = encode_identity_text(&Identity::Memory(source.clone()));\n317\t    query_links(\n318\t        conn,\n319\t        \"SELECT link_id, source_memory_id, target_kind, target_id, link_type, strength, reason,\n320\t                evidence_event_id, created_by_kind, created_by_detail, created_at, verification_status\n321\t         FROM memory_links\n322\t         WHERE source_memory_id = ?1\n323\t         ORDER BY created_at ASC, link_id ASC\",\n324\t        params![source_memory_id],\n325\t    )\n326\t}\n327\t\n328\tpub fn get_links_to(\n329\t    conn: &Connection,\n330\t    target: &MemoryLinkTarget,\n331\t) -> Result<Vec<MemoryLink>, MemoryLinkError> {\n332\t    query_links(\n333\t        conn,\n334\t        \"SELECT link_id, source_memory_id, target_kind, target_id, link_type, strength, reason,\n335\t                evidence_event_id, created_by_kind, created_by_detail, created_at, verification_status\n336\t         FROM memory_links\n337\t         WHERE target_kind = ?1 AND target_id = ?2\n338\t         ORDER BY created_at ASC, link_id ASC\",\n339\t        params![target.kind().as_str(), target.encode_id()?],\n340\t    )\n341\t}\n342\t\n343\tpub fn get_links_by_type(\n344\t    conn: &Connection,\n345\t    link_type: MemoryLinkType,\n346\t) -> Result<Vec<MemoryLink>, MemoryLinkError> {\n347\t    query_links(\n348\t        conn,\n349\t        \"SELECT link_id, source_memory_id, target_kind, target_id, link_type, strength, reason,\n350\t                evidence_event_id, created_by_kind, created_by_detail, created_at, verification_status\n351\t         FROM memory_links\n352\t         WHERE link_type = ?1\n353\t         ORDER BY created_at ASC, link_id ASC\",\n354\t        params![link_type.as_str()],\n355\t    )\n356\t}\n357\t\n358\tfn query_links<P>(\n359\t    conn: &Connection,\n360\t    sql: &str,\n361\t    params: P,\n362\t) -> Result<Vec<MemoryLink>, MemoryLinkError>\n363\twhere\n364\t    P: rusqlite::Params,\n365\t{\n366\t    let mut statement = conn.prepare(sql)?;\n367\t    let rows = statement.query_map(params, |row| {\n368\t        let source = match decode_identity_text(&row.get::<_, String>(1)?, \"source_memory_id\")\n369\t            .map_err(|error| {\n370\t                row_decode_error(\n371\t                    1,\n372\t                    rusqlite::types::Type::Text,\n373\t                    MemoryLinkError::Parse(error),\n374\t                )\n375\t            })? {\n376\t            Identity::Memory(value) => value,\n377\t            other => {\n378\t                return Err(row_decode_error(\n379\t                    1,\n380\t                    rusqlite::types::Type::Text,\n381\t                    MemoryLinkError::TargetKindMismatch {\n382\t                        expected: \"memory\",\n383\t                        actual: format!(\"{:?}\", other.kind()),\n384\t                    },\n385\t                ));\n386\t            }\n387\t        };\n388\t        let evidence_event_id = row\n389\t            .get::<_, Option<String>>(7)?\n390\t            .map(|value| decode_event_id(&value, \"evidence_event_id\"))\n391\t            .transpose()\n392\t            .map_err(|error| {\n393\t                row_decode_error(\n394\t                    7,\n395\t                    rusqlite::types::Type::Text,\n396\t                    MemoryLinkError::Parse(error),\n397\t                )\n398\t            })?;\n399\t        let verification_status = VerificationStatus::from_str(row.get::<_, String>(11)?.as_str())\n400\t            .map_err(|error| {\n401\t                row_decode_error(\n402\t                    11,\n403\t                    rusqlite::types::Type::Text,\n404\t                    MemoryLinkError::Parse(error),\n405\t                )\n406\t            })?;\n407\t        Ok(MemoryLink {\n408\t            link_id: MemoryLinkId(row.get(0)?),\n409\t            source,\n410\t            target: MemoryLinkTarget::decode(\n411\t                row.get::<_, String>(2)?.as_str(),\n412\t                row.get::<_, String>(3)?.as_str(),\n413\t            )\n414\t            .map_err(|error| row_decode_error(3, rusqlite::types::Type::Text, error))?,\n415\t            link_type: MemoryLinkType::from_str(row.get::<_, String>(4)?.as_str()).map_err(\n416\t                |error| {\n417\t                    row_decode_error(\n418\t                        4,\n419\t                        rusqlite::types::Type::Text,\n420\t                        MemoryLinkError::Parse(error),\n421\t                    )\n422\t                },\n423\t            )?,\n424\t            strength: row.get(5)?,\n425\t            reason: row.get(6)?,\n426\t            evidence_event_id,\n427\t            created_by: decode_actor(row.get::<_, String>(8)?.as_str(), row.get(9)?, \"created_by\")\n428\t                .map_err(|error| {\n429\t                    row_decode_error(\n430\t                        8,\n431\t                        rusqlite::types::Type::Text,\n432\t                        MemoryLinkError::Parse(error),\n433\t                    )\n434\t                })?,\n435\t            created_at: decode_timestamp(row.get(10)?, \"created_at\").map_err(|error| {\n436\t                row_decode_error(\n437\t                    10,\n438\t                    rusqlite::types::Type::Integer,\n439\t                    MemoryLinkError::Parse(error),\n440\t                )\n441\t            })?,\n442\t            verification_status,\n443\t        })\n444\t    })?;\n445\t\n446\t    rows.collect::<Result<Vec<_>, _>>()\n447\t        .map_err(|error| match error {\n448\t            rusqlite::Error::FromSqlConversionFailure(_, _, inner) => {\n449\t                match inner.downcast::<MemoryLinkError>() {\n450\t                    Ok(memory_error) => *memory_error,\n451\t                    Err(other) => {\n452\t                        MemoryLinkError::Sqlite(rusqlite::Error::FromSqlConversionFailure(\n453\t                            0,\n454\t                            rusqlite::types::Type::Text,\n455\t                            other,\n456\t                        ))\n457\t                    }\n458\t                }\n459\t            }\n460\t            other => MemoryLinkError::Sqlite(other),\n461\t        })\n462\t}\n463\t\n464\tfn validate_strength(strength: f32) -> Result<(), MemoryLinkError> {\n465\t    if (0.0..=1.0).contains(&strength) {\n466\t        Ok(())\n467\t    } else {\n468\t        Err(MemoryLinkError::InvalidStrength { strength })\n469\t    }\n470\t}\n471\t\n472\timpl fmt::Display for MemoryLinkId {\n473\t    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n474\t        formatter.write_str(self.as_str())\n475\t    }\n476\t}\n477\t"}]},"parent_tool_use_id":null,"session_id":"97e40997-f38f-4628-bdcd-a9758dda27fa","uuid":"5625afaf-916a-4568-baa9-ebedd13a3967","timestamp":"2026-05-17T07:28:07.340Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/memory_graph/links.rs","content":"use std::fmt;\nuse std::str::FromStr;\n\nuse chrono::{DateTime, Utc};\nuse rusqlite::{params, Connection};\nuse serde::{Deserialize, Serialize};\nuse thiserror::Error;\nuse tracing::trace_span;\n\nuse super::{\n    decode_actor, decode_event_id, decode_identity_text,