{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J5ojhEV7r5v5LqeBvCw2pC","type":"tool_result","content":"1\t//! Public append-only writer for event envelopes.\n2\t//!\n3\t//! The writer defaults to a 4096-byte inline ceiling so hot-path workflow events\n4\t//! stay in the main `events` table while larger payloads spill into\n5\t//! `event_payloads` without bloating primary-row reads.\n6\t\n7\tuse std::collections::HashMap;\n8\tuse std::sync::atomic::{AtomicU64, Ordering};\n9\tuse std::sync::{Arc, Mutex};\n10\tuse std::time::{SystemTime, UNIX_EPOCH};\n11\t\n12\tuse serde_json::to_string;\n13\tuse thiserror::Error;\n14\tuse tracing::{debug, trace_span, warn};\n15\t\n16\tuse crate::events::kinds::EventKind;\n17\tuse crate::events::store::MAX_EVENT_PAYLOAD_BYTES;\n18\tuse crate::events::{\n19\t    Actor, BranchRef, CompactSummary, EventPayload, EventStore, EventStoreError, InsertEnvelopeRow,\n20\t    PayloadLocation, SessionId, StableRef, TaskId,\n21\t};\n22\tuse crate::identity::{EventId, WorkspaceId};\n23\tuse crate::{DateTime, Utc};\n24\t\n25\tconst DEFAULT_INLINE_CEILING_BYTES: usize = 4096;\n26\tconst EVENT_SCHEMA_VERSION: i64 = 1;\n27\tconst ULID_ALPHABET: &[u8; 32] = b\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\n28\tstatic ULID_COUNTER: AtomicU64 = AtomicU64::new(0);\n29\t\n30\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n31\tpub enum FlushPolicy {\n32\t    Sync,\n33\t    Batched { interval_ms: u64 },\n34\t}\n35\t\n36\t#[derive(Clone, Debug)]\n37\tpub struct PartialEnvelope {\n38\t    pub workspace_id: Option<WorkspaceId>,\n39\t    pub branch: BranchRef,\n40\t    pub session_id: SessionId,\n41\t    pub task_id: Option<TaskId>,\n42\t    pub actor: Actor,\n43\t    pub kind: EventKind,\n44\t    pub references: Vec<StableRef>,\n45\t    pub summary: CompactSummary,\n46\t    pub payload: EventPayload,\n47\t}\n48\t\n49\t#[derive(Debug, Error, PartialEq, Eq)]\n50\tpub enum IdentityError {\n51\t    #[error(\"{field} must not be empty\")]\n52\t    EmptyField { field: &'static str },\n53\t}\n54\t\n55\t#[derive(Debug, Error)]\n56\tpub enum EventWriteError {\n57\t    #[error(\"event workspace `{actual}` does not match writer workspace `{expected}`\")]\n58\t    WorkspaceMismatch {\n59\t        expected: WorkspaceId,\n60\t        actual: WorkspaceId,\n61\t    },\n62\t    #[error(\"event payload is too large: {actual} bytes exceeds {ceiling} bytes\")]\n63\t    PayloadTooLarge { ceiling: usize, actual: usize },\n64\t    #[error(\"event store write failed: {0}\")]\n65\t    Storage(#[from] EventStoreError),\n66\t    #[error(\"event payload serialization failed: {0}\")]\n67\t    Serde(#[from] serde_json::Error),\n68\t    #[error(\"event identity is invalid: {0}\")]\n69\t    Identity(#[from] IdentityError),\n70\t}\n71\t\n72\tpub struct EventWriter {\n73\t    store: Arc<EventStore>,\n74\t    workspace_id: WorkspaceId,\n75\t    inline_ceiling_bytes: usize,\n76\t    flush_policy: FlushPolicy,\n77\t    monotonic_state: Mutex<MonotonicState>,\n78\t    payload_spill_cache: Mutex<HashMap<crate::events::PayloadHash, i64>>,\n79\t}\n80\t\n81\t#[derive(Clone, Debug)]\n82\tpub(crate) struct PreparedEventWrite {\n83\t    pub(crate) event_id: EventId,\n84\t    workspace_id: WorkspaceId,\n85\t    ts_unix_micros: i64,\n86\t}\n87\t\n88\t#[derive(Default)]\n89\tstruct MonotonicState {\n90\t    last_session_micros: HashMap<String, i64>,\n91\t}\n92\t\n93\timpl EventWriter {\n94\t    pub fn new(\n95\t        store: Arc<EventStore>,\n96\t        workspace_id: WorkspaceId,\n97\t        inline_ceiling_bytes: usize,\n98\t    ) -> Self {\n99\t        Self {\n100\t            store,\n101\t            workspace_id,\n102\t            inline_ceiling_bytes: if inline_ceiling_bytes == 0 {\n103\t                DEFAULT_INLINE_CEILING_BYTES\n104\t            } else {\n105\t                inline_ceiling_bytes\n106\t            },\n107\t            flush_policy: default_flush_policy(),\n108\t            monotonic_state: Mutex::new(MonotonicState::default()),\n109\t            payload_spill_cache: Mutex::new(HashMap::new()),\n110\t        }\n111\t    }\n112\t\n113\t    pub fn with_flush_policy(mut self, flush_policy: FlushPolicy) -> Self {\n114\t        self.flush_policy = flush_policy;\n115\t        self\n116\t    }\n117\t\n118\t    pub fn inline_ceiling_bytes(&self) -> usize {\n119\t        self.inline_ceiling_bytes\n120\t    }\n121\t\n122\t    pub fn workspace_id(&self) -> &WorkspaceId {\n123\t        &self.workspace_id\n124\t    }\n125\t\n126\t    pub fn append(&self, envelope: PartialEnvelope) -> Result<EventId, EventWriteError> {\n127\t        self.append_with_flush_policy(envelope, self.flush_policy)\n128\t    }\n129\t\n130\t    pub fn append_with_flush_policy(\n131\t        &self,\n132\t        envelope: PartialEnvelope,\n133\t        flush_policy: FlushPolicy,\n134\t    ) -> Result<EventId, EventWriteError> {\n135\t        let _span = trace_span!(\"event_writer.append\", kind = envelope.kind.as_str()).entered();\n136\t        let prepared = self.prepare_write(&envelope)?;\n137\t        self.append_prepared_with_flush_policy(prepared, envelope, flush_policy)\n138\t    }\n139\t\n140\t    pub(crate) fn prepare_write(\n141\t        &self,\n142\t        envelope: &PartialEnvelope,\n143\t    ) -> Result<PreparedEventWrite, EventWriteError> {\n144\t        let workspace_id = self.resolve_workspace(&envelope.workspace_id)?;\n145\t        let (_timestamp, ts_unix_micros) = self.next_timestamp(&envelope.session_id)?;\n146\t        Ok(PreparedEventWrite {\n147\t            event_id: EventId {\n148\t                workspace_id: workspace_id.clone(),\n149\t                ulid: next_ulid(ts_unix_micros),\n150\t            },\n151\t            workspace_id,\n152\t            ts_unix_micros,\n153\t        })\n154\t    }\n155\t\n156\t    pub(crate) fn append_prepared_with_flush_policy(\n157\t        &self,\n158\t        prepared: PreparedEventWrite,\n159\t        envelope: PartialEnvelope,\n160\t        flush_policy: FlushPolicy,\n161\t    ) -> Result<EventId, EventWriteError> {\n162\t        let payload_bytes = serde_json::to_vec(&envelope.payload)?;\n163\t        if payload_bytes.len() > MAX_EVENT_PAYLOAD_BYTES {\n164\t            return Err(EventWriteError::PayloadTooLarge {\n165\t                ceiling: MAX_EVENT_PAYLOAD_BYTES,\n166\t                actual: payload_bytes.len(),\n167\t            });\n168\t        }\n169\t        let payload_hash = crate::events::hash_canonical_payload_bytes(&payload_bytes);\n170\t        let payload_location =\n171\t            self.persist_payload(&payload_hash, &payload_bytes, prepared.ts_unix_micros)?;\n172\t        let row = build_insert_row(\n173\t            &prepared.event_id,\n174\t            &prepared.workspace_id,\n175\t            &envelope,\n176\t            payload_hash.as_bytes().to_vec(),\n177\t            payload_location,\n178\t            payload_bytes,\n179\t            prepared.ts_unix_micros,\n180\t        )?;\n181\t\n182\t        self.store.insert_envelope_row_cached(&row)?;\n183\t        self.flush_if_needed(flush_policy)?;\n184\t        Ok(prepared.event_id)\n185\t    }\n186\t\n187\t    fn resolve_workspace(\n188\t        &self,\n189\t        workspace_id: &Option<WorkspaceId>,\n190\t    ) -> Result<WorkspaceId, EventWriteError> {\n191\t        match workspace_id {\n192\t            Some(value) if value != &self.workspace_id => {\n193\t                warn!(\n194\t                    writer_workspace_id = self.workspace_id.as_str(),\n195\t                    event_workspace_id = value.as_str(),\n196\t                    \"event writer rejected workspace mismatch\"\n197\t                );\n198\t                Err(EventWriteError::WorkspaceMismatch {\n199\t                    expected: self.workspace_id.clone(),\n200\t                    actual: value.clone(),\n201\t                })\n202\t            }\n203\t            Some(value) => Ok(value.clone()),\n204\t            None => Ok(self.workspace_id.clone()),\n205\t        }\n206\t    }\n207\t\n208\t    fn next_timestamp(\n209\t        &self,\n210\t        session_id: &SessionId,\n211\t    ) -> Result<(DateTime<Utc>, i64), EventWriteError> {\n212\t        if session_id.value.is_empty() {\n213\t            return Err(IdentityError::EmptyField {\n214\t                field: \"session_id\",\n215\t            }\n216\t            .into());\n217\t        }\n218\t\n219\t        let mut state =\n220\t            self.monotonic_state\n221\t                .lock()\n222\t                .map_err(|_| EventStoreError::EnvelopeInvalid {\n223\t                    reason: \"event writer monotonic state lock was poisoned\".to_string(),\n224\t                })?;\n225\t        let now_micros = current_unix_micros()?;\n226\t        let entry = state\n227\t            .last_session_micros\n228\t            .entry(session_id.value.clone())\n229\t            .or_insert(now_micros);\n230\t        let next_micros = if now_micros > *entry {\n231\t            now_micros\n232\t        } else {\n233\t            *entry + 1\n234\t        };\n235\t        *entry = next_micros;\n236\t        Ok((\n237\t            DateTime::from_unix_seconds(next_micros / 1_000_000),\n238\t            next_micros,\n239\t        ))\n240\t    }\n241\t\n242\t    fn persist_payload(\n243\t        &self,\n244\t        payload_hash: &crate::events::PayloadHash,\n245\t        payload_bytes: &[u8],\n246\t        ts_unix_micros: i64,\n247\t    ) -> Result<PayloadLocation, EventWriteError> {\n248\t        if payload_bytes.len() <= self.inline_ceiling_bytes {\n249\t            let bytes_len = u32::try_from(payload_bytes.len()).map_err(|_| {\n250\t                EventWriteError::PayloadTooLarge {\n251\t                    ceiling: u32::MAX as usize,\n252\t                    actual: payload_bytes.len(),\n253\t                }\n254\t            })?;\n255\t            return Ok(PayloadLocation::Inline { bytes_len });\n256\t        }\n257\t\n258\t        if let Some(row_id) = self.cached_payload_row_id(payload_hash)? {\n259\t            return Ok(PayloadLocation::Spilled { row_id });\n260\t        }\n261\t\n262\t        let row_id = self.store.insert_or_get_payload(\n263\t            payload_hash.as_bytes(),\n264\t            payload_bytes,\n265\t            ts_unix_micros,\n266\t        )?;\n267\t        self.payload_spill_cache\n268\t            .lock()\n269\t            .map_err(|_| EventStoreError::EnvelopeInvalid {\n270\t                reason: \"event writer payload cache lock was poisoned\".to_string(),\n271\t            })?\n272\t            .insert(*payload_hash, row_id);\n273\t        debug!(\n274\t            bytes_len = payload_bytes.len(),\n275\t            inline_ceiling_bytes = self.inline_ceiling_bytes,\n276\t            payload_row_id = row_id,\n277\t            \"event payload spilled to side table\"\n278\t        );\n279\t        Ok(PayloadLocation::Spilled { row_id })\n280\t    }\n281\t\n282\t    fn cached_payload_row_id(\n283\t        &self,\n284\t        payload_hash: &crate::events::PayloadHash,\n285\t    ) -> Result<Option<i64>, EventWriteError> {\n286\t        Ok(self\n287\t            .payload_spill_cache\n288\t            .lock()\n289\t            .map_err(|_| EventStoreError::EnvelopeInvalid {\n290\t                reason: \"event writer payload cache lock was poisoned\".to_string(),\n291\t            })?\n292\t            .get(payload_hash)\n293\t            .copied())\n294\t    }\n295\t\n296\t    fn flush_if_needed(&self, flush_policy: FlushPolicy) -> Result<(), EventWriteError> {\n297\t        match flush_policy {\n298\t            FlushPolicy::Sync => self.store.checkpoint_wal().map_err(EventWriteError::from),\n299\t            FlushPolicy::Batched { interval_ms: _ } => Ok(()),\n300\t        }\n301\t    }\n302\t}\n303\t\n304\tfn build_insert_row(\n305\t    event_id: &EventId,\n306\t    workspace_id: &str,\n307\t    envelope: &PartialEnvelope,\n308\t    payload_hash: Vec<u8>,\n309\t    payload_location: PayloadLocation,\n310\t    payload_bytes: Vec<u8>,\n311\t    ts_unix_micros: i64,\n312\t) -> Result<InsertEnvelopeRow, EventWriteError> {\n313\t    let (actor_kind, actor_detail) = actor_parts(&envelope.actor);\n314\t    validate_identity_fields(\n315\t        workspace_id,\n316\t        &envelope.branch,\n317\t        &envelope.session_id,\n318\t        &envelope.task_id,\n319\t    )?;\n320\t    let references_json = to_string(&envelope.references)?;\n321\t    let (payload_inline, payload_spill_id) = match payload_location {\n322\t        PayloadLocation::Inline { .. } => (Some(payload_bytes), None),\n323\t        PayloadLocation::Spilled { row_id } => (None, Some(row_id)),\n324\t    };\n325\t\n326\t    Ok(InsertEnvelopeRow {\n327\t        event_uuid: event_id.ulid.clone(),\n328\t        workspace_id: workspace_id.to_string(),\n329\t        branch: envelope.branch.name.clone(),\n330\t        session_id: envelope.session_id.value.clone(),\n331\t        task_id: envelope\n332\t            .task_id\n333\t            .as_ref()\n334\t            .map(|task_id| task_id.value.clone()),\n335\t        actor_kind,\n336\t        actor_detail,\n337\t        kind: envelope.kind.as_str().to_string(),\n338\t        ts_unix_micros,\n339\t        payload_hash,\n340\t        summary: envelope.summary.as_str().to_string(),\n341\t        payload_inline,\n342\t        payload_spill_id,\n343\t        references_json,\n344\t        schema_version: EVENT_SCHEMA_VERSION,\n345\t    })\n346\t}\n347\t\n348\tfn actor_parts(actor: &Actor) -> (String, Option<String>) {\n349\t    match actor {\n350\t        Actor::Assistant { model } => (\"assistant\".to_string(), Some(model.clone())),\n351\t        Actor::User => (\"user\".to_string(), None),\n352\t        Actor::Tool { name } => (\"tool\".to_string(), Some(name.clone())),\n353\t        Actor::Daemon => (\"daemon\".to_string(), None),\n354\t    }\n355\t}\n356\t\n357\tfn validate_identity_fields(\n358\t    workspace_id: &str,\n359\t    branch: &BranchRef,\n360\t    session_id: &SessionId,\n361\t    task_id: &Option<TaskId>,\n362\t) -> Result<(), IdentityError> {\n363\t    if workspace_id.is_empty() {\n364\t        return Err(IdentityError::EmptyField {\n365\t            field: \"workspace_id\",\n366\t        });\n367\t    }\n368\t    if branch.name.is_empty() {\n369\t        return Err(IdentityError::EmptyField { field: \"branch\" });\n370\t    }\n371\t    if session_id.value.is_empty() {\n372\t        return Err(IdentityError::EmptyField {\n373\t            field: \"session_id\",\n374\t        });\n375\t    }\n376\t    if let Some(task_id) = task_id {\n377\t        if task_id.value.is_empty() {\n378\t            return Err(IdentityError::EmptyField { field: \"task_id\" });\n379\t        }\n380\t    }\n381\t    Ok(())\n382\t}\n383\t\n384\tfn current_unix_micros() -> Result<i64, EventStoreError> {\n385\t    let duration = SystemTime::now()\n386\t        .duration_since(UNIX_EPOCH)\n387\t        .map_err(|error| EventStoreError::EnvelopeInvalid {\n388\t            reason: format!(\"system clock precedes Unix epoch: {error}\"),\n389\t        })?;\n390\t    i64::try_from(duration.as_micros()).map_err(|_| EventStoreError::EnvelopeInvalid {\n391\t        reason: \"current Unix timestamp exceeds i64 microsecond range\".to_string(),\n392\t    })\n393\t}\n394\t\n395\tfn default_flush_policy() -> FlushPolicy {\n396\t    if cfg!(test) {\n397\t        FlushPolicy::Sync\n398\t    } else {\n399\t        FlushPolicy::Batched { interval_ms: 50 }\n400\t    }\n401\t}\n402\t\n403\tfn next_ulid(ts_unix_micros: i64) -> String {\n404\t    let millis = ts_unix_micros.div_euclid(1_000) as u128;\n405\t    let sequence = u128::from(ULID_COUNTER.fetch_add(1, Ordering::SeqCst));\n406\t    encode_ulid((millis << 80) | sequence)\n407\t}\n408\t\n409\tfn encode_ulid(mut value: u128) -> String {\n410\t    let mut output = [b'0'; 26];\n411\t    for slot in (0..26).rev() {\n412\t        let index = (value & 0x1f) as usize;\n413\t        output[slot] = ULID_ALPHABET[index];\n414\t        value >>= 5;\n415\t    }\n416\t    String::from_utf8(output.to_vec()).expect(\"ULID alphabet is valid UTF-8\")\n417\t}\n418\t"}]},"parent_tool_use_id":null,"session_id":"97e40997-f38f-4628-bdcd-a9758dda27fa","uuid":"bc09700c-ed54-4648-a2ef-065d53380caa","timestamp":"2026-05-17T07:28:39.854Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/writer.rs","content":"//! Public append-only writer for event envelopes.\n//!\n//! The writer defaults to a 4096-byte inline ceiling so hot-path workflow events\n//! stay in the main `events` table while larger payloads spill into\n//! `event_payloads` without bloating primary-row reads.\n\nuse std::collections::HashMap;\nuse std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::{Arc, Mutex};\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse serde_json::to_string;\nuse thiserror::Error;\nuse tracing::{debug, trace_span, warn};\n\nuse crate::events::kinds::EventKind;\nuse crate::events::store::MAX_EVENT_PAYLOAD_BYTES;\nuse crate::events::{\n    Actor, BranchRef, CompactSummary, EventPayload, EventStore, EventStoreError, InsertEnvelopeRow,\n    PayloadLocation, SessionId, StableRef, TaskId,\n};\nuse crate::identity::{EventId, WorkspaceId};\nuse crate::{DateTime, Utc};\n\nconst DEFAULT_INLINE_CEILING_BYTES: usize = 4096;\nconst EVENT_SCHEMA_VERSION: i64 = 1;\nconst ULID_ALPHABET: &[u8; 32] = b\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\nstatic ULID_COUNTER: AtomicU64 = AtomicU64::new(0);\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum FlushPolicy {\n    Sync,\n    Batched { interval_ms: u64 },\n}\n\n#[derive(Clone, Debug)]\npub struct PartialEnvelope {\n    pub workspace_id: Option<WorkspaceId>,\n    pub branch: BranchRef,\n    pub session_id: SessionId,\n    pub task_id: Option<TaskId>,\n    pub actor: Actor,\n    pub kind: EventKind,\n    pub references: Vec<StableRef>,\n    pub summary: CompactSummary,\n    pub payload: EventPayload,\n}\n\n#[derive(Debug, Error, PartialEq, Eq)]\npub enum IdentityError {\n    #[error(\"{field} must not be empty\")]\n    EmptyField { field: &'static str },\n}\n\n#[derive(Debug, Error)]\npub enum EventWriteError {\n    #[error(\"event workspace `{actual}` does not match writer workspace `{expected}`\")]\n    WorkspaceMismatch {\n        expected: WorkspaceId,\n        actual: WorkspaceId,\n    },\n    #[error(\"event payload is too large: {actual} bytes exceeds {ceiling} bytes\")]\n    PayloadTooLarge { ceiling: usize, actual: usize },\n    #[error(\"event store write failed: {0}\")]\n    Storage(#[from] EventStoreError),\n    #[error(\"event payload serialization failed: {0}\")]\n    Serde(#[from] serde_json::Error),\n    #[error(\"event identity is invalid: {0}\")]\n    Identity(#[from] IdentityError),\n}\n\npub struct EventWriter {\n    store: Arc<EventStore>,\n    workspace_id: WorkspaceId,\n    inline_ceiling_bytes: usize,\n    flush_policy: FlushPolicy,\n    monotonic_state: Mutex<MonotonicState>,\n    payload_spill_cache: Mutex<HashMap<crate::events::PayloadHash, i64>>,\n}\n\n#[derive(Clone, Debug)]\npub(crate) struct PreparedEventWrite {\n    pub(crate) event_id: EventId,\n    workspace_id: WorkspaceId,\n    ts_unix_micros: i64,\n}\n\n#[derive(Default)]\nstruct MonotonicState {\n    last_session_micros: HashMap<String, i64>,\n}\n\nimpl EventWriter {\n    pub fn new(\n        store: Arc<EventStore>,\n        workspace_id: WorkspaceId,\n        inline_ceiling_bytes: usize,\n    ) -> Self {\n        Self {\n            store,\n            workspace_id,\n            inline_ceiling_bytes: if inline_ceiling_bytes == 0 {\n                DEFAULT_INLINE_CEILING_BYTES\n            } else {\n                inline_ceiling_bytes\n            },\n            flush_policy: default_flush_policy(),\n            monotonic_state: Mutex::new(MonotonicState::default()),\n            payload_spill_cache: Mutex::new(HashMap::new()),\n        }\n    }\n\n    pub fn with_flush_policy(mut self, flush_policy: FlushPolicy) -> Self {\n        self.flush_policy = flush_policy;\n        self\n    }\n\n    pub fn inline_ceiling_bytes(&self) -> usize {\n        self.inline_ceiling_bytes\n    }\n\n    pub fn workspace_id(&self) -> &WorkspaceId {\n        &self.workspace_id\n    }\n\n    pub fn append(&self, envelope: PartialEnvelope) -> Result<EventId, EventWriteError> {\n        self.append_with_flush_policy(envelope, self.flush_policy)\n    }\n\n    pub fn append_with_flush_policy(\n        &self,\n        envelope: PartialEnvelope,\n        flush_policy: FlushPolicy,\n    ) -> Result<EventId, EventWriteError> {\n        let _span = trace_span!(\"event_writer.append\", kind = envelope.kind.as_str()).entered();\n        let prepared = self.prepare_write(&envelope)?;\n        self.append_prepared_with_flush_policy(prepared, envelope, flush_policy)\n    }\n\n    pub(crate) fn prepare_write(\n        &self,\n        envelope: &PartialEnvelope,\n    ) -> Result<PreparedEventWrite, EventWriteError> {\n        let workspace_id = self.resolve_workspace(&envelope.workspace_id)?;\n        let (_timestamp, ts_unix_micros) = self.next_timestamp(&envelope.session_id)?;\n        Ok(PreparedEventWrite {\n            event_id: EventId {\n                workspace_id: workspace_id.clone(),\n                ulid: next_ulid(ts_unix_micros),\n            },\n            workspace_id,\n            ts_unix_micros,\n        })\n    }\n\n    pub(crate) fn append_prepared_with_flush_policy(\n        &self,\n        prepared: PreparedEventWrite,\n        envelope: PartialEnvelope,\n        flush_policy: FlushPolicy,\n    ) -> Result<EventId, EventWriteError> {\n        let payload_bytes = serde_json::to_vec(&envelope.payload)?;\n        if payload_bytes.len() > MAX_EVENT_PAYLOAD_BYTES {\n            return Err(EventWriteError::PayloadTooLarge {\n                ceiling: MAX_EVENT_PAYLOAD_BYTES,\n                actual: payload_bytes.len(),\n            });\n        }\n        let payload_hash = crate::events::hash_canonical_payload_bytes(&payload_bytes);\n        let payload_location =\n            self.persist_payload(&payload_hash, &payload_bytes, prepared.ts_unix_micros)?;\n        let row = build_insert_row(\n            &prepared.event_id,\n            &prepared.workspace_id,\n            &envelope,\n            payload_hash.as_bytes().to_vec(),\n            payload_location,\n            payload_bytes,\n            prepared.ts_unix_micros,\n        )?;\n\n        self.store.insert_envelope_row_cached(&row)?;\n        self.flush_if_needed(flush_policy)?;\n        Ok(prepared.event_id)\n    }\n\n    fn resolve_workspace(\n        &self,\n        workspace_id: &Option<WorkspaceId>,\n    ) -> Result<WorkspaceId, EventWriteError> {\n        match workspace_id {\n            Some(value) if value != &self.workspace_id => {\n                warn!(\n                    writer_workspace_id = self.workspace_id.as_str(),\n                    event_workspace_id = value.as_str(),\n                    \"event writer rejected workspace mismatch\"\n                );\n                Err(EventWriteError::WorkspaceMismatch {\n                    expected: self.workspace_id.clone(),\n                    actual: value.clone(),\n                })\n            }\n            Some(value) => Ok(value.clone()),\n            None => Ok(self.workspace_id.clone()),\n        }\n    }\n\n    fn next_timestamp(\n        &self,\n        session_id: &SessionId,\n    ) -> Result<(DateTime<Utc>, i64), EventWriteError> {\n        if session_id.value.is_empty() {\n            return Err(IdentityError::EmptyField {\n                field: \"session_id\",\n            }\n            .into());\n        }\n\n        let mut state =\n            self.monotonic_state\n                .lock()\n                .map_err(|_| EventStoreError::EnvelopeInvalid {\n                    reason: \"event writer monotonic state lock was poisoned\".to_string(),\n                })?;\n        let now_micros = current_unix_micros()?;\n        let entry = state\n            .last_session_micros\n            .entry(session_id.value.clone())\n            .or_insert(now_micros);\n        let next_micros = if now_micros > *entry {\n            now_micros\n        } else {\n            *entry + 1\n        };\n        *entry = next_micros;\n        Ok((\n            DateTime::from_unix_seconds(next_micros / 1_000_000),\n            next_micros,\n        ))\n    }\n\n    fn persist_payload(\n        &self,\n        payload_hash: &crate::events::PayloadHash,\n        payload_bytes: &[u8],\n        ts_unix_micros: i64,\n    ) -> Result<PayloadLocation, EventWriteError> {\n        if payload_bytes.len() <= self.inline_ceiling_bytes {\n            let bytes_len = u32::try_from(payload_bytes.len()).map_err(|_| {\n                EventWriteError::PayloadTooLarge {\n                    ceiling: u32::MAX as usize,\n                    actual: payload_bytes.len(),\n                }\n            })?;\n            return Ok(PayloadLocation::Inline { bytes_len });\n        }\n\n        if let Some(row_id) = self.cached_payload_row_id(payload_hash)? {\n            return Ok(PayloadLocation::Spilled { row_id });\n        }\n\n        let row_id = self.store.insert_or_get_payload(\n            payload_hash.as_bytes(),\n            payload_bytes,\n            ts_unix_micros,\n        )?;\n        self.payload_spill_cache\n            .lock()\n            .map_err(|_| EventStoreError::EnvelopeInvalid {\n                reason: \"event writer payload cache lock was poisoned\".to_string(),\n            })?\n            .insert(*payload_hash, row_id);\n        debug!(\n            bytes_len = payload_bytes.len(),\n            inline_ceiling_bytes = self.inline_ceiling_bytes,\n            payload_row_id = row_id,\n            \"event payload spilled to side table\"\n        );\n        Ok(PayloadLocation::Spilled { row_id })\n    }\n\n    fn cached_payload_row_id(\n        &self,\n        payload_hash: &crate::events::PayloadHash,\n    ) -> Result<Option<i64>, EventWriteError> {\n        Ok(self\n            .payload_spill_cache\n            .lock()\n            .map_err(|_| EventStoreError::EnvelopeInvalid {\n                reason: \"event writer payload cache lock was poisoned\".to_string(),\n            })?\n            .get(payload_hash)\n            .copied())\n    }\n\n    fn flush_if_needed(&self, flush_policy: FlushPolicy) -> Result<(), EventWriteError> {\n        match flush_policy {\n            FlushPolicy::Sync => self.store.checkpoint_wal().map_err(EventWriteError::from),\n            FlushPolicy::Batched { interval_ms: _ } => Ok(()),\n        }\n    }\n}\n\nfn build_insert_row(\n    event_id: &EventId,\n    workspace_id: &str,\n    envelope: &PartialEnvelope,\n    payload_hash: Vec<u8>,\n    payload_location: PayloadLocation,\n    payload_bytes: Vec<u8>,\n    ts_unix_micros: i64,\n) -> Result<InsertEnvelopeRow, EventWriteError> {\n    let (actor_kind, actor_detail) = actor_parts(&envelope.actor);\n    validate_identity_fields(\n        workspace_id,\n        &envelope.branch,\n        &envelope.session_id,\n        &envelope.task_id,\n    )?;\n    let references_json = to_string(&envelope.references)?;\n    let (payload_inline, payload_spill_id) = match payload_location {\n        PayloadLocation::Inline { .. } => (Some(payload_bytes), None),\n        PayloadLocation::Spilled { row_id } => (None, Some(row_id)),\n    };\n\n    Ok(InsertEnvelopeRow {\n        event_uuid: event_id.ulid.clone(),\n        workspace_id: workspace_id.to_string(),\n        branch: envelope.branch.name.clone(),\n        session_id: envelope.session_id.value.clone(),\n        task_id: envelope\n            .task_id\n            .as_ref()\n            .map(|task_id| task_id.value.clone()),\n        actor_kind,\n        actor_detail,\n        kind: envelope.kind.as_str().to_string(),\n        ts_unix_micros,\n        payload_hash,\n        summary: envelope.summary.as_str().to_string(),\n        payload_inline,\n        payload_spill_id,\n        references_json,\n        schema_version: EVENT_SCHEMA_VERSION,\n    })\n}\n\nfn actor_parts(actor: &Actor) -> (String, Option<String>) {\n    match actor {\n        Actor::Assistant { model } => (\"assistant\".to_string(), Some(model.clone())),\n        Actor::User => (\"user\".to_string(), None),\n        Actor::Tool { name } => (\"tool\".to_string(), Some(name.clone())),\n        Actor::Daemon => (\"daemon\".to_string(), None),\n    }\n}\n\nfn validate_identity_fields(\n    workspace_id: &str,\n    branch: &BranchRef,\n    session_id: &SessionId,\n    task_id: &Option<TaskId>,\n) -> Result<(), IdentityError> {\n    if workspace_id.is_empty() {\n        return Err(IdentityError::EmptyField {\n            field: \"workspace_id\",\n        });\n    }\n    if branch.name.is_empty() {\n        return Err(IdentityError::EmptyField { field: \"branch\" });\n    }\n    if session_id.value.is_empty() {\n        return Err(IdentityError::EmptyField {\n            field: \"session_id\",\n        });\n    }\n    if let Some(task_id) = task_id {\n        if task_id.value.is_empty() {\n            return Err(IdentityError::EmptyField { field: \"task_id\" });\n        }\n    }\n    Ok(())\n}\n\nfn current_unix_micros() -> Result<i64, EventStoreError> {\n    let duration = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .map_err(|error| EventStoreError::EnvelopeInvalid {\n            reason: format!(\"system clock precedes Unix epoch: {error}\"),\n        })?;\n    i64::try_from(duration.as_micros()).map_err(|_| EventStoreError::EnvelopeInvalid {\n        reason: \"current Unix timestamp exceeds i64 microsecond range\".to_string(),\n    })\n}\n\nfn default_flush_policy() -> FlushPolicy {\n    if cfg!(test) {\n        FlushPolicy::Sync\n    } else {\n        FlushPolicy::Batched { interval_ms: 50 }\n    }\n}\n\nfn next_ulid(ts_unix_micros: i64) -> String {\n    let millis = ts_unix_micros.div_euclid(1_000) as u128;\n    let sequence = u128::from(ULID_COUNTER.fetch_add(1, Ordering::SeqCst));\n    encode_ulid((millis << 80) | sequence)\n}\n\nfn encode_ulid(mut value: u128) -> String {\n    let mut output = [b'0'; 26];\n    for slot in (0..26).rev() {\n        let index = (value & 0x1f) as usize;\n        output[slot] = ULID_ALPHABET[index];\n        value >>= 5;\n    }\n    String::from_utf8(output.to_vec()).expect(\"ULID alphabet is valid UTF-8\")\n}\n","numLines":418,"startLine":1,"totalLines":418}}}
