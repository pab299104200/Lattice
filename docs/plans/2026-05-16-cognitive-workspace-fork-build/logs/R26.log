{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014n2Uncz136sRymjgRP2Qum","type":"tool_result","content":"1\tuse std::collections::VecDeque;\n2\tuse std::sync::Arc;\n3\t\n4\tuse rusqlite::types::Value;\n5\tuse rusqlite::{params_from_iter, Connection};\n6\tuse sha2::{Digest, Sha256};\n7\tuse tracing::{debug_span, warn};\n8\t\n9\tuse crate::events::hashing::PayloadHash;\n10\tuse crate::events::kinds::{EventKind, EventPayload};\n11\tuse crate::events::query::{\n12\t    branch_ref, event_id, session_id, task_id, workspace_id, EventQuery, EventQueryError,\n13\t    QueryOrder, TailScope,\n14\t};\n15\tuse crate::events::{Actor, CompactSummary, EventEnvelope, EventModelError, EventStore, StableRef};\n16\tuse crate::{DateTime, Utc};\n17\t\n18\tpub struct EventReader {\n19\t    store: Arc<EventStore>,\n20\t}\n21\t\n22\t#[derive(Clone, Debug)]\n23\tstruct QueryPlan {\n24\t    query: EventQuery,\n25\t    limit: usize,\n26\t}\n27\t\n28\t#[derive(Clone, Copy, Debug)]\n29\tstruct Cursor {\n30\t    row_id: i64,\n31\t}\n32\t\n33\tstruct EventRowData {\n34\t    row_id: i64,\n35\t    event_uuid: String,\n36\t    workspace_id: String,\n37\t    branch: String,\n38\t    session_id: String,\n39\t    task_id: Option<String>,\n40\t    actor_kind: String,\n41\t    actor_detail: Option<String>,\n42\t    kind: String,\n43\t    ts_unix_micros: i64,\n44\t    payload_hash: Vec<u8>,\n45\t    summary: String,\n46\t    payload_inline: Option<Vec<u8>>,\n47\t    payload_spill_id: Option<i64>,\n48\t    references_json: String,\n49\t    schema_version: i64,\n50\t    spilled_payload_hash: Option<Vec<u8>>,\n51\t    spilled_payload_bytes: Option<Vec<u8>>,\n52\t}\n53\t\n54\tpub struct EventStream {\n55\t    store: Arc<EventStore>,\n56\t    plan: QueryPlan,\n57\t    cursor: Option<Cursor>,\n58\t    buffer: VecDeque<Result<EventEnvelope, EventQueryError>>,\n59\t    exhausted: bool,\n60\t}\n61\t\n62\timpl EventReader {\n63\t    pub fn new(store: Arc<EventStore>) -> Self {\n64\t        Self { store }\n65\t    }\n66\t\n67\t    pub fn execute(&self, query: EventQuery) -> Result<Vec<EventEnvelope>, EventQueryError> {\n68\t        let plan = QueryPlan::new(query)?;\n69\t        let _span =\n70\t            debug_span!(\"event_reader.execute\", scope = %plan.query.trace_scope()).entered();\n71\t        self.fetch_page(&plan, None)\n72\t    }\n73\t\n74\t    pub fn stream(&self, query: EventQuery) -> EventStream {\n75\t        let stream_plan = QueryPlan::new(query);\n76\t        match stream_plan {\n77\t            Ok(plan) => EventStream {\n78\t                store: self.store.clone(),\n79\t                plan,\n80\t                cursor: None,\n81\t                buffer: VecDeque::new(),\n82\t                exhausted: false,\n83\t            },\n84\t            Err(error) => EventStream {\n85\t                store: self.store.clone(),\n86\t                plan: QueryPlan::fallback(),\n87\t                cursor: None,\n88\t                buffer: VecDeque::from([Err(error)]),\n89\t                exhausted: true,\n90\t            },\n91\t        }\n92\t    }\n93\t\n94\t    pub fn tail<S>(&self, scope: S, n: usize) -> Result<Vec<EventEnvelope>, EventQueryError>\n95\t    where\n96\t        S: Into<TailScope>,\n97\t    {\n98\t        let limit = n.max(1);\n99\t        let query = match scope.into() {\n100\t            TailScope::Task(scope) => EventQuery::new().task(scope.task_id.value),\n101\t            TailScope::Session(scope) => EventQuery::new().session(scope.session_id.value),\n102\t        }\n103\t        .limit(limit)\n104\t        .order(QueryOrder::NewestFirst);\n105\t        self.execute(query)\n106\t    }\n107\t\n108\t    fn fetch_page(\n109\t        &self,\n110\t        plan: &QueryPlan,\n111\t        cursor: Option<Cursor>,\n112\t    ) -> Result<Vec<EventEnvelope>, EventQueryError> {\n113\t        let conn = self.store.lock_conn()?;\n114\t        query_rows(&conn, plan, cursor)?\n115\t            .into_iter()\n116\t            .map(to_envelope)\n117\t            .collect()\n118\t    }\n119\t}\n120\t\n121\timpl Iterator for EventStream {\n122\t    type Item = Result<EventEnvelope, EventQueryError>;\n123\t\n124\t    fn next(&mut self) -> Option<Self::Item> {\n125\t        if let Some(item) = self.buffer.pop_front() {\n126\t            return Some(item);\n127\t        }\n128\t        if self.exhausted {\n129\t            return None;\n130\t        }\n131\t\n132\t        let conn = match self.store.lock_conn() {\n133\t            Ok(conn) => conn,\n134\t            Err(error) => {\n135\t                self.exhausted = true;\n136\t                return Some(Err(EventQueryError::Storage(error)));\n137\t            }\n138\t        };\n139\t        let rows = match query_rows(&conn, &self.plan, self.cursor) {\n140\t            Ok(rows) => rows,\n141\t            Err(error) => {\n142\t                self.exhausted = true;\n143\t                return Some(Err(error));\n144\t            }\n145\t        };\n146\t        if rows.is_empty() {\n147\t            self.exhausted = true;\n148\t            return None;\n149\t        }\n150\t\n151\t        self.cursor = rows.last().map(cursor_from_row);\n152\t        self.exhausted = rows.len() < self.plan.limit;\n153\t        self.buffer = rows.into_iter().map(to_envelope).collect();\n154\t        self.buffer.pop_front()\n155\t    }\n156\t}\n157\t\n158\timpl QueryPlan {\n159\t    fn new(query: EventQuery) -> Result<Self, EventQueryError> {\n160\t        query.validate()?;\n161\t        Ok(Self {\n162\t            limit: query.limit_or_default(),\n163\t            query,\n164\t        })\n165\t    }\n166\t\n167\t    fn fallback() -> Self {\n168\t        Self {\n169\t            query: EventQuery::new().task(\"__invalid__\"),\n170\t            limit: 1,\n171\t        }\n172\t    }\n173\t}\n174\t\n175\tfn query_rows(\n176\t    conn: &Connection,\n177\t    plan: &QueryPlan,\n178\t    cursor: Option<Cursor>,\n179\t) -> Result<Vec<EventRowData>, EventQueryError> {\n180\t    let (sql, params) = build_sql(plan, cursor);\n181\t    let mut statement = conn.prepare(&sql).map_err(sqlite_error)?;\n182\t    let rows = statement\n183\t        .query_map(params_from_iter(params), read_row)\n184\t        .map_err(sqlite_error)?;\n185\t    let mut events = Vec::new();\n186\t    for row in rows {\n187\t        events.push(row.map_err(sqlite_error)?);\n188\t    }\n189\t    Ok(events)\n190\t}\n191\t\n192\tfn build_sql(plan: &QueryPlan, cursor: Option<Cursor>) -> (String, Vec<Value>) {\n193\t    let mut sql = String::from(\n194\t        \"SELECT e.event_id, e.event_uuid, e.workspace_id, e.branch, e.session_id, e.task_id, \\\n195\t         e.actor_kind, e.actor_detail, e.kind, e.ts_unix_micros, e.payload_hash, e.summary, \\\n196\t         e.payload_inline, e.payload_spill_id, e.references_json, e.schema_version, \\\n197\t         p.payload_hash, p.bytes \\\n198\t         FROM events e \\\n199\t         LEFT JOIN event_payloads p ON p.row_id = e.payload_spill_id \\\n200\t         WHERE \","}]},"parent_tool_use_id":null,"session_id":"97e40997-f38f-4628-bdcd-a9758dda27fa","uuid":"a76dfd5c-3198-42e8-afa7-d85c46298dc0","timestamp":"2026-05-17T07:28:45.486Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/reader.rs","content":"use std::collections::VecDeque;\nuse std::sync::Arc;\n\nuse rusqlite::types::Value;\nuse rusqlite::{params_from_iter, Connection};\nuse sha2::{Digest, Sha256};\nuse tracing::{debug_span, warn};\n\nuse crate::events::hashing::PayloadHash;\nuse crate::events::kinds::{EventKind, EventPayload};\nuse crate::events::query::{\n    branch_ref, event_id, session_id, task_id, workspace_id, EventQuery, EventQueryError,\n    QueryOrder, TailScope,\n};\nuse crate::events::{Actor, CompactSummary, EventEnvelope, EventModelError, EventStore, StableRef};\nuse crate::{DateTime, Utc};\n\npub struct EventReader {\n    store: Arc<EventStore>,\n}\n\n#[derive(Clone, Debug)]\nstruct QueryPlan {\n    query: EventQuery,\n    limit: usize,\n}\n\n#[derive(Clone, Copy, Debug)]\nstruct Cursor {\n    row_id: i64,\n}\n\nstruct EventRowData {\n    row_id: i64,\n    event_uuid: String,\n    workspace_id: String,\n    branch: String,\n    session_id: String,\n    task_id: Option<String>,\n    actor_kind: String,\n    actor_detail: Option<String>,\n    kind: String,\n    ts_unix_micros: i64,\n    payload_hash: Vec<u8>,\n    summary: String,\n    payload_inline: Option<Vec<u8>>,\n    payload_spill_id: Option<i64>,\n    references_json: String,\n    schema_version: i64,\n    spilled_payload_hash: Option<Vec<u8>>,\n    spilled_payload_bytes: Option<Vec<u8>>,\n}\n\npub struct EventStream {\n    store: Arc<EventStore>,\n    plan: QueryPlan,\n    cursor: Option<Cursor>,\n    buffer: VecDeque<Result<EventEnvelope, EventQueryError>>,\n    exhausted: bool,\n}\n\nimpl EventReader {\n    pub fn new(store: Arc<EventStore>) -> Self {\n        Self { store }\n    }\n\n    pub fn execute(&self, query: EventQuery) -> Result<Vec<EventEnvelope>, EventQueryError> {\n        let plan = QueryPlan::new(query)?;\n        let _span =\n            debug_span!(\"event_reader.execute\", scope = %plan.query.trace_scope()).entered();\n        self.fetch_page(&plan, None)\n    }\n\n    pub fn stream(&self, query: EventQuery) -> EventStream {\n        let stream_plan = QueryPlan::new(query);\n        match stream_plan {\n            Ok(plan) => EventStream {\n                store: self.store.clone(),\n                plan,\n                cursor: None,\n                buffer: VecDeque::new(),\n                exhausted: false,\n            },\n            Err(error) => EventStream {\n                store: self.store.clone(),\n                plan: QueryPlan::fallback(),\n                cursor: None,\n                buffer: VecDeque::from([Err(error)]),\n                exhausted: true,\n            },\n        }\n    }\n\n    pub fn tail<S>(&self, scope: S, n: usize) -> Result<Vec<EventEnvelope>, EventQueryError>\n    where\n        S: Into<TailScope>,\n    {\n        let limit = n.max(1);\n        let query = match scope.into() {\n            TailScope::Task(scope) => EventQuery::new().task(scope.task_id.value),\n            TailScope::Session(scope) => EventQuery::new().session(scope.session_id.value),\n        }\n        .limit(limit)\n        .order(QueryOrder::NewestFirst);\n        self.execute(query)\n    }\n\n    fn fetch_page(\n        &self,\n        plan: &QueryPlan,\n        cursor: Option<Cursor>,\n    ) -> Result<Vec<EventEnvelope>, EventQueryError> {\n        let conn = self.store.lock_conn()?;\n        query_rows(&conn, plan, cursor)?\n            .into_iter()\n            .map(to_envelope)\n            .collect()\n    }\n}\n\nimpl Iterator for EventStream {\n    type Item = Result<EventEnvelope, EventQueryError>;\n\n    fn next(&mut self) -> Option<Self::Item> {\n        if let Some(item) = self.buffer.pop_front() {\n            return Some(item);\n        }\n        if self.exhausted {\n            return None;\n        }\n\n        let conn = match self.store.lock_conn() {\n            Ok(conn) => conn,\n            Err(error) => {\n                self.exhausted = true;\n                return Some(Err(EventQueryError::Storage(error)));\n            }\n        };\n        let rows = match query_rows(&conn, &self.plan, self.cursor) {\n            Ok(rows) => rows,\n            Err(error) => {\n                self.exhausted = true;\n                return Some(Err(error));\n            }\n        };\n        if rows.is_empty() {\n            self.exhausted = true;\n            return None;\n        }\n\n        self.cursor = rows.last().map(cursor_from_row);\n        self.exhausted = rows.len() < self.plan.limit;\n        self.buffer = rows.into_iter().map(to_envelope).collect();\n        self.buffer.pop_front()\n    }\n}\n\nimpl QueryPlan {\n    fn new(query: EventQuery) -> Result<Self, EventQueryError> {\n        query.validate()?;\n        Ok(Self {\n            limit: query.limit_or_default(),\n            query,\n        })\n    }\n\n    fn fallback() -> Self {\n        Self {\n            query: EventQuery::new().task(\"__invalid__\"),\n            limit: 1,\n        }\n    }\n}\n\nfn query_rows(\n    conn: &Connection,\n    plan: &QueryPlan,\n    cursor: Option<Cursor>,\n) -> Result<Vec<EventRowData>, EventQueryError> {\n    let (sql, params) = build_sql(plan, cursor);\n    let mut statement = conn.prepare(&sql).map_err(sqlite_error)?;\n    let rows = statement\n        .query_map(params_from_iter(params), read_row)\n        .map_err(sqlite_error)?;\n    let mut events = Vec::new();\n    for row in rows {\n        events.push(row.map_err(sqlite_error)?);\n    }\n    Ok(events)\n}\n\nfn build_sql(plan: &QueryPlan, cursor: Option<Cursor>) -> (String, Vec<Value>) {\n    let mut sql = String::from(\n        \"SELECT e.event_id, e.event_uuid, e.workspace_id, e.branch, e.session_id, e.task_id, \\\n         e.actor_kind, e.actor_detail, e.kind, e.ts_unix_micros, e.payload_hash, e.summary, \\\n         e.payload_inline, e.payload_spill_id, e.references_json, e.schema_version, \\\n         p.payload_hash, p.bytes \\\n         FROM events e \\\n         LEFT JOIN event_payloads p ON p.row_id = e.payload_spill_id \\\n         WHERE \",","numLines":200,"startLine":1,"totalLines":477}}}
