{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D1JmRK16qgQrA3VrS9cUGM","type":"tool_result","content":"1\t//! Phase 1 identity-resolution correctness tests for\n2\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n3\t//! `## Phase 1: Unified Identity Model`.\n4\t//!\n5\t//! This matrix covers the spec-mandated rename, move, duplicate-name, and\n6\t//! branch-change behaviors, plus the compatibility paths that keep legacy\n7\t//! references working while Phase 1 introduces stable identities.\n8\t\n9\tuse super::{EventId, FileId, Identity, ResolveOutcome};\n10\t\n11\tconst MAIN_WORKSPACE: &str = \"main\";\n12\tconst FEATURE_WORKSPACE: &str = \"feature\";\n13\t\n14\t#[test]\n15\tfn test_resolve_path_unique_returns_fileid() {\n16\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n17\t        .rust(MAIN_WORKSPACE, \"src/lib.rs\", \"pub fn login_user() {}\\n\")\n18\t        .build();\n19\t\n20\t    let resolved = fixture\n21\t        .resolver\n22\t        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), \"src/lib.rs\")\n23\t        .expect(\"path should resolve\");\n24\t\n25\t    assert_eq!(resolved.workspace_id, MAIN_WORKSPACE);\n26\t    assert_eq!(resolved.repo_relative_path, \"src/lib.rs\");\n27\t}\n28\t\n29\t#[test]\n30\tfn test_resolve_path_after_file_rename_returns_new_id() {\n31\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n32\t        .rust(MAIN_WORKSPACE, \"src/renamed.rs\", \"pub fn login_user() {}\\n\")\n33\t        .build();\n34\t\n35\t    let resolved = fixture\n36\t        .resolver\n37\t        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), \"src/renamed.rs\")\n38\t        .expect(\"renamed path should resolve\");\n39\t\n40\t    assert_eq!(resolved.repo_relative_path, \"src/renamed.rs\");\n41\t}\n42\t\n43\t#[test]\n44\tfn test_resolve_path_after_file_rename_legacy_name_returns_via_compat_shim() {\n45\t    let source = \"pub fn login_user() {}\\n\";\n46\t    let old_identity = Identity::File(FileId {\n47\t        workspace_id: MAIN_WORKSPACE.to_string(),\n48\t        repo_relative_path: \"src/original.rs\".to_string(),\n49\t        content_hash: helpers::content_hash(source),\n50\t    })\n51\t    .to_string();\n52\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n53\t        .rust(MAIN_WORKSPACE, \"src/renamed.rs\", source)\n54\t        .build();\n55\t\n56\t    let resolved = fixture\n57\t        .resolver\n58\t        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), &old_identity)\n59\t        .expect(\"legacy file identity should remap to current path\");\n60\t\n61\t    assert_eq!(resolved.repo_relative_path, \"src/renamed.rs\");\n62\t    assert_eq!(resolved.content_hash, helpers::content_hash(source));\n63\t}\n64\t\n65\t#[test]\n66\tfn test_resolve_symbol_unique_returns_symbolid() {\n67\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n68\t        .rust(\n69\t            MAIN_WORKSPACE,\n70\t            \"src/auth.rs\",\n71\t            \"pub fn login_user() {}\\npub fn logout_user() {}\\n\",\n72\t        )\n73\t        .build();\n74\t\n75\t    let resolved = fixture\n76\t        .resolver\n77\t        .resolve_symbol(&fixture.workspace(MAIN_WORKSPACE), \"login_user\");\n78\t\n79\t    let symbol_id = helpers::expect_unique_symbol(resolved);\n80\t    assert_eq!(symbol_id.file.repo_relative_path, \"src/auth.rs\");\n81\t    assert_eq!(symbol_id.qualified_name, \"login_user\");\n82\t}\n83\t\n84\t#[test]\n85\tfn test_resolve_symbol_duplicate_name_returns_ambiguous_with_disambiguation_hint() {\n86\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n87\t        .rust(MAIN_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n88\t        .rust(MAIN_WORKSPACE, \"src/admin.rs\", \"pub fn shared() {}\\n\")\n89\t        .build();\n90\t\n91\t    let resolved = fixture\n92\t        .resolver\n93\t        .resolve_symbol(&fixture.workspace(MAIN_WORKSPACE), \"shared\");\n94\t\n95\t    let report = helpers::expect_ambiguous_symbol(resolved);\n96\t    assert_eq!(report.candidates.len(), 2);\n97\t    assert!(report.disambiguation_hint.contains(\"file path\"));\n98\t}\n99\t\n100\t#[test]\n101\tfn test_resolve_section_after_heading_rename_returns_new_id() {\n102\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n103\t        .markdown(\n104\t            MAIN_WORKSPACE,\n105\t            \"docs/guide.md\",\n106\t            \"# Overview\\n\\n## Current Heading\\nBody\\n\",\n107\t        )\n108\t        .build();\n109\t    let doc = fixture.doc_id(MAIN_WORKSPACE, \"docs/guide.md\");\n110\t\n111\t    let resolved = fixture.resolver.resolve_section(\n112\t        &fixture.workspace(MAIN_WORKSPACE),\n113\t        &doc,\n114\t        \"Current Heading\",\n115\t    );\n116\t\n117\t    let section_id = helpers::expect_unique_section(resolved);\n118\t    assert_eq!(section_id.doc.repo_relative_path, \"docs/guide.md\");\n119\t    assert_eq!(section_id.heading_path, vec![\"Current Heading\".to_string()]);\n120\t}\n121\t\n122\t#[test]\n123\tfn test_resolve_section_after_section_move_returns_new_id() {\n124\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n125\t        .markdown(\n126\t            MAIN_WORKSPACE,\n127\t            \"docs/runbook.md\",\n128\t            \"# Runbook\\n\\n## Intro\\nText\\n\\n## Deploy\\nMove target\\n\",\n129\t        )\n130\t        .build();\n131\t    let doc = fixture.doc_id(MAIN_WORKSPACE, \"docs/runbook.md\");\n132\t\n133\t    let resolved =\n134\t        fixture\n135\t            .resolver\n136\t            .resolve_section(&fixture.workspace(MAIN_WORKSPACE), &doc, \"Deploy\");\n137\t\n138\t    let section_id = helpers::expect_unique_section(resolved);\n139\t    assert_eq!(section_id.doc.repo_relative_path, \"docs/runbook.md\");\n140\t    assert!(section_id.byte_offset > 20);\n141\t}\n142\t\n143\t#[test]\n144\tfn test_resolve_symbol_on_different_branch_returns_branch_scoped_id() {\n145\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n146\t        .rust(MAIN_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n147\t        .rust(FEATURE_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n148\t        .build();\n149\t\n150\t    let resolved = fixture\n151\t        .resolver\n152\t        .resolve_symbol(&fixture.workspace(FEATURE_WORKSPACE), \"shared\");\n153\t\n154\t    let symbol_id = helpers::expect_unique_symbol(resolved);\n155\t    assert_eq!(symbol_id.file.workspace_id, FEATURE_WORKSPACE);\n156\t    assert_eq!(symbol_id.file.repo_relative_path, \"src/auth.rs\");\n157\t}\n158\t\n159\t#[test]\n160\tfn test_resolve_event_ref_round_trips_through_encoding() {\n161\t    let event_id = EventId {\n162\t        workspace_id: MAIN_WORKSPACE.to_string(),\n163\t        ulid: \"01J0000000000000000000000A\".to_string(),\n164\t    };\n165\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n166\t        .event(event_id.clone())\n167\t        .build();\n168\t\n169\t    let resolved = fixture\n170\t        .resolver\n171\t        .resolve_event_ref(\n172\t            &fixture.workspace(MAIN_WORKSPACE),\n173\t            &Identity::Event(event_id).to_string(),\n174\t        )\n175\t        .expect(\"event identity should resolve\");\n176\t\n177\t    assert_eq!(resolved.workspace_id, MAIN_WORKSPACE);\n178\t    assert_eq!(resolved.ulid, \"01J0000000000000000000000A\");\n179\t}\n180\t\n181\t#[test]\n182\tfn test_resolve_legacy_symbol_name_routes_via_default_workspace() {\n183\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n184\t        .rust(MAIN_WORKSPACE, \"src/legacy.rs\", \"pub fn only_main() {}\\n\")\n185\t        .rust(\n186\t            FEATURE_WORKSPACE,\n187\t            \"src/feature.rs\",\n188\t            \"pub fn feature_only() {}\\n\",\n189\t        )\n190\t        .build();\n191\t\n192\t    let resolved = fixture.resolver.resolve_legacy_symbol_name(\"only_main\");\n193\t\n194\t    let symbol_id = helpers::expect_unique_symbol(resolved);\n195\t    assert_eq!(symbol_id.file.workspace_id, MAIN_WORKSPACE);\n196\t    assert_eq!(symbol_id.file.repo_relative_path, \"src/legacy.rs\");\n197\t}\n198\t\n199\tpub(crate) mod helpers {\n200\t    use std::collections::HashMap;\n201\t\n202\t    use crate::graph::CodeGraph;\n203\t    use crate::identity::{AmbiguityReport, DocId, EventId, IdentityResolver, SectionId, SymbolId};\n204\t    use crate::parser::parse_file;\n205\t    use crate::storage::graph_store::{\n206\t        FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n207\t    };\n208\t    use crate::symbols::ParsedFile;\n209\t\n210\t    use super::ResolveOutcome;\n211\t\n212\t    pub(crate) struct ResolverFixture {\n213\t        pub(crate) resolver: IdentityResolver<'static>,\n214\t        docs: HashMap<(String, String), DocId>,\n215\t    }\n216\t\n217\t    impl ResolverFixture {\n218\t        pub(crate) fn workspace(&self, workspace: &str) -> String {\n219\t            workspace.to_string()\n220\t        }\n221\t\n222\t        pub(crate) fn doc_id(&self, workspace: &str, path: &str) -> DocId {\n223\t            self.docs\n224\t                .get(&(workspace.to_string(), path.to_string()))\n225\t                .cloned()\n226\t                .expect(\"document fixture should exist\")\n227\t        }\n228\t    }\n229\t\n230\t    pub(crate) struct FixtureBuilder {\n231\t        default_workspace: String,\n232\t        files: Vec<FixtureFile>,\n233\t        events: Vec<EventId>,\n234\t    }\n235\t\n236\t    struct FixtureFile {\n237\t        workspace: String,\n238\t        repo_relative_path: String,\n239\t        source: String,\n240\t    }\n241\t\n242\t    impl FixtureBuilder {\n243\t        pub(crate) fn new(default_workspace: &str) -> Self {\n244\t            Self {\n245\t                default_workspace: default_workspace.to_string(),\n246\t                files: Vec::new(),\n247\t                events: Vec::new(),\n248\t            }\n249\t        }\n250\t\n251\t        pub(crate) fn rust(mut self, workspace: &str, path: &str, source: &str) -> Self {\n252\t            self.files.push(FixtureFile::new(workspace, path, source));\n253\t            self\n254\t        }\n255\t\n256\t        pub(crate) fn markdown(mut self, workspace: &str, path: &str, source: &str) -> Self {\n257\t            self.files.push(FixtureFile::new(workspace, path, source));\n258\t            self\n259\t        }\n260\t\n261\t        pub(crate) fn event(mut self, event_id: EventId) -> Self {\n262\t            self.events.push(event_id);\n263\t            self\n264\t        }\n265\t\n266\t        pub(crate) fn build(self) -> ResolverFixture {\n267\t            let mut graph = CodeGraph::new();\n268\t            let mut file_index = HashMap::new();\n269\t            let mut parsed_files = HashMap::new();\n270\t            let mut docs = HashMap::new();\n271\t\n272\t            for file in self.files {\n273\t                let stored_path = file.stored_path();\n274\t                let parsed_file =\n275\t                    parse_file(&stored_path, &file.source).expect(\"fixture should parse\");\n276\t                add_symbols(&mut graph, &parsed_file);\n277\t                if file.repo_relative_path.ends_with(\".md\") {\n278\t                    docs.insert(\n279\t                        (file.workspace.clone(), file.repo_relative_path.clone()),\n280\t                        doc_id(&file.workspace, &file.repo_relative_path, &file.source),\n281\t                    );\n282\t                }\n283\t                parsed_files.insert(stored_path.clone(), parsed_file);\n284\t                file_index.insert(\n285\t                    stored_path.clone(),\n286\t                    file_index_entry(&stored_path, &file.source),\n287\t                );\n288\t            }\n289\t\n290\t            let resolver = IdentityResolver::new(\n291\t                Box::leak(Box::new(graph)),\n292\t                Box::leak(Box::new(file_index)),\n293\t                Box::leak(Box::new(parsed_files)),\n294\t                self.default_workspace,\n295\t                self.events,\n296\t            );\n297\t            ResolverFixture { resolver, docs }\n298\t        }\n299\t    }\n300\t\n301\t    impl FixtureFile {\n302\t        fn new(workspace: &str, path: &str, source: &str) -> Self {\n303\t            Self {\n304\t                workspace: workspace.to_string(),\n305\t                repo_relative_path: path.to_string(),\n306\t                source: source.to_string(),\n307\t            }\n308\t        }\n309\t\n310\t        fn stored_path(&self) -> String {\n311\t            format!(\"{}/{}\", self.workspace, self.repo_relative_path)\n312\t        }\n313\t    }\n314\t\n315\t    pub(crate) fn content_hash(source: &str) -> String {\n316\t        let mut hash = 0xcbf29ce484222325u64;\n317\t        for byte in source.as_bytes() {\n318\t            hash ^= *byte as u64;\n319\t            hash = hash.wrapping_mul(0x100000001b3);\n320\t        }\n321\t        format!(\"{hash:016x}\")\n322\t    }\n323\t\n324\t    pub(crate) fn expect_unique_symbol(outcome: ResolveOutcome<SymbolId>) -> SymbolId {\n325\t        match outcome {\n326\t            ResolveOutcome::Unique(symbol_id) => symbol_id,\n327\t            other => panic!(\"expected unique symbol, got {other:?}\"),\n328\t        }\n329\t    }\n330\t\n331\t    pub(crate) fn expect_ambiguous_symbol(\n332\t        outcome: ResolveOutcome<SymbolId>,\n333\t    ) -> AmbiguityReport<SymbolId> {\n334\t        match outcome {\n335\t            ResolveOutcome::Ambiguous(report) => report,\n336\t            other => panic!(\"expected ambiguous symbol, got {other:?}\"),\n337\t        }\n338\t    }\n339\t\n340\t    pub(crate) fn expect_unique_section(outcome: ResolveOutcome<SectionId>) -> SectionId {\n341\t        match outcome {\n342\t            ResolveOutcome::Unique(section_id) => section_id,\n343\t            other => panic!(\"expected unique section, got {other:?}\"),\n344\t        }\n345\t    }\n346\t\n347\t    fn add_symbols(graph: &mut CodeGraph, parsed_file: &ParsedFile) {\n348\t        for symbol in &parsed_file.symbols {\n349\t            graph.add_node(\n350\t                symbol.id.clone(),\n351\t                symbol.kind,\n352\t                symbol.name.clone(),\n353\t                symbol.signature.clone(),\n354\t                symbol.body.clone(),\n355\t                symbol.file.clone(),\n356\t                symbol.line,\n357\t                symbol.end_line,\n358\t                symbol.is_exported,\n359\t                symbol.language,\n360\t            );\n361\t        }\n362\t    }\n363\t\n364\t    fn doc_id(workspace: &str, path: &str, source: &str) -> DocId {\n365\t        DocId {\n366\t            workspace_id: workspace.to_string(),\n367\t            repo_relative_path: path.to_string(),\n368\t            content_hash: content_hash(source),\n369\t        }\n370\t    }\n371\t\n372\t    fn file_index_entry(stored_path: &str, source: &str) -> FileIndexEntry {\n373\t        FileIndexEntry {\n374\t            file: stored_path.to_string(),\n375\t            content_hash: content_hash(source),\n376\t            mtime_ns: 0,\n377\t            size_bytes: source.len() as i64,\n378\t            parser_version: FILE_INDEX_PARSER_VERSION,\n379\t            schema_version: FILE_INDEX_SCHEMA_VERSION,\n380\t            last_indexed_at: 0,\n381\t        }\n382\t    }\n383\t}\n384\t"}]},"parent_tool_use_id":null,"session_id":"97e40997-f38f-4628-bdcd-a9758dda27fa","uuid":"c4fb3b47-a91a-4099-b380-fdd7daf8e1ed","timestamp":"2026-05-17T07:28:27.858Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/identity/resolver_tests.rs","content":"//! Phase 1 identity-resolution correctness tests for\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 1: Unified Identity Model`.\n//!\n//! This matrix covers the spec-mandated rename, move, duplicate-name, and\n//! branch-change behaviors, plus the compatibility paths that keep legacy\n//! references working while Phase 1 introduces stable identities.\n\nuse super::{EventId, FileId, Identity, ResolveOutcome};\n\nconst MAIN_WORKSPACE: &str = \"main\";\nconst FEATURE_WORKSPACE: &str = \"feature\";\n\n#[test]\nfn test_resolve_path_unique_returns_fileid() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/lib.rs\", \"pub fn login_user() {}\\n\")\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), \"src/lib.rs\")\n        .expect(\"path should resolve\");\n\n    assert_eq!(resolved.workspace_id, MAIN_WORKSPACE);\n    assert_eq!(resolved.repo_relative_path, \"src/lib.rs\");\n}\n\n#[test]\nfn test_resolve_path_after_file_rename_returns_new_id() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/renamed.rs\", \"pub fn login_user() {}\\n\")\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), \"src/renamed.rs\")\n        .expect(\"renamed path should resolve\");\n\n    assert_eq!(resolved.repo_relative_path, \"src/renamed.rs\");\n}\n\n#[test]\nfn test_resolve_path_after_file_rename_legacy_name_returns_via_compat_shim() {\n    let source = \"pub fn login_user() {}\\n\";\n    let old_identity = Identity::File(FileId {\n        workspace_id: MAIN_WORKSPACE.to_string(),\n        repo_relative_path: \"src/original.rs\".to_string(),\n        content_hash: helpers::content_hash(source),\n    })\n    .to_string();\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/renamed.rs\", source)\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), &old_identity)\n        .expect(\"legacy file identity should remap to current path\");\n\n    assert_eq!(resolved.repo_relative_path, \"src/renamed.rs\");\n    assert_eq!(resolved.content_hash, helpers::content_hash(source));\n}\n\n#[test]\nfn test_resolve_symbol_unique_returns_symbolid() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(\n            MAIN_WORKSPACE,\n            \"src/auth.rs\",\n            \"pub fn login_user() {}\\npub fn logout_user() {}\\n\",\n        )\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_symbol(&fixture.workspace(MAIN_WORKSPACE), \"login_user\");\n\n    let symbol_id = helpers::expect_unique_symbol(resolved);\n    assert_eq!(symbol_id.file.repo_relative_path, \"src/auth.rs\");\n    assert_eq!(symbol_id.qualified_name, \"login_user\");\n}\n\n#[test]\nfn test_resolve_symbol_duplicate_name_returns_ambiguous_with_disambiguation_hint() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n        .rust(MAIN_WORKSPACE, \"src/admin.rs\", \"pub fn shared() {}\\n\")\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_symbol(&fixture.workspace(MAIN_WORKSPACE), \"shared\");\n\n    let report = helpers::expect_ambiguous_symbol(resolved);\n    assert_eq!(report.candidates.len(), 2);\n    assert!(report.disambiguation_hint.contains(\"file path\"));\n}\n\n#[test]\nfn test_resolve_section_after_heading_rename_returns_new_id() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .markdown(\n            MAIN_WORKSPACE,\n            \"docs/guide.md\",\n            \"# Overview\\n\\n## Current Heading\\nBody\\n\",\n        )\n        .build();\n    let doc = fixture.doc_id(MAIN_WORKSPACE, \"docs/guide.md\");\n\n    let resolved = fixture.resolver.resolve_section(\n        &fixture.workspace(MAIN_WORKSPACE),\n        &doc,\n        \"Current Heading\",\n    );\n\n    let section_id = helpers::expect_unique_section(resolved);\n    assert_eq!(section_id.doc.repo_relative_path, \"docs/guide.md\");\n    assert_eq!(section_id.heading_path, vec![\"Current Heading\".to_string()]);\n}\n\n#[test]\nfn test_resolve_section_after_section_move_returns_new_id() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .markdown(\n            MAIN_WORKSPACE,\n            \"docs/runbook.md\",\n            \"# Runbook\\n\\n## Intro\\nText\\n\\n## Deploy\\nMove target\\n\",\n        )\n        .build();\n    let doc = fixture.doc_id(MAIN_WORKSPACE, \"docs/runbook.md\");\n\n    let resolved =\n        fixture\n            .resolver\n            .resolve_section(&fixture.workspace(MAIN_WORKSPACE), &doc, \"Deploy\");\n\n    let section_id = helpers::expect_unique_section(resolved);\n    assert_eq!(section_id.doc.repo_relative_path, \"docs/runbook.md\");\n    assert!(section_id.byte_offset > 20);\n}\n\n#[test]\nfn test_resolve_symbol_on_different_branch_returns_branch_scoped_id() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n        .rust(FEATURE_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_symbol(&fixture.workspace(FEATURE_WORKSPACE), \"shared\");\n\n    let symbol_id = helpers::expect_unique_symbol(resolved);\n    assert_eq!(symbol_id.file.workspace_id, FEATURE_WORKSPACE);\n    assert_eq!(symbol_id.file.repo_relative_path, \"src/auth.rs\");\n}\n\n#[test]\nfn test_resolve_event_ref_round_trips_through_encoding() {\n    let event_id = EventId {\n        workspace_id: MAIN_WORKSPACE.to_string(),\n        ulid: \"01J0000000000000000000000A\".to_string(),\n    };\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .event(event_id.clone())\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_event_ref(\n            &fixture.workspace(MAIN_WORKSPACE),\n            &Identity::Event(event_id).to_string(),\n        )\n        .expect(\"event identity should resolve\");\n\n    assert_eq!(resolved.workspace_id, MAIN_WORKSPACE);\n    assert_eq!(resolved.ulid, \"01J0000000000000000000000A\");\n}\n\n#[test]\nfn test_resolve_legacy_symbol_name_routes_via_default_workspace() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/legacy.rs\", \"pub fn only_main() {}\\n\")\n        .rust(\n            FEATURE_WORKSPACE,\n            \"src/feature.rs\",\n            \"pub fn feature_only() {}\\n\",\n        )\n        .build();\n\n    let resolved = fixture.resolver.resolve_legacy_symbol_name(\"only_main\");\n\n    let symbol_id = helpers::expect_unique_symbol(resolved);\n    assert_eq!(symbol_id.file.workspace_id, MAIN_WORKSPACE);\n    assert_eq!(symbol_id.file.repo_relative_path, \"src/legacy.rs\");\n}\n\npub(crate) mod helpers {\n    use std::collections::HashMap;\n\n    use crate::graph::CodeGraph;\n    use crate::identity::{AmbiguityReport, DocId, EventId, IdentityResolver, SectionId, SymbolId};\n    use crate::parser::parse_file;\n    use crate::storage::graph_store::{\n        FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n    };\n    use crate::symbols::ParsedFile;\n\n    use super::ResolveOutcome;\n\n    pub(crate) struct ResolverFixture {\n        pub(crate) resolver: IdentityResolver<'static>,\n        docs: HashMap<(String, String), DocId>,\n    }\n\n    impl ResolverFixture {\n        pub(crate) fn workspace(&self, workspace: &str) -> String {\n            workspace.to_string()\n        }\n\n        pub(crate) fn doc_id(&self, workspace: &str, path: &str) -> DocId {\n            self.docs\n                .get(&(workspace.to_string(), path.to_string()))\n                .cloned()\n                .expect(\"document fixture should exist\")\n        }\n    }\n\n    pub(crate) struct FixtureBuilder {\n        default_workspace: String,\n        files: Vec<FixtureFile>,\n        events: Vec<EventId>,\n    }\n\n    struct FixtureFile {\n        workspace: String,\n        repo_relative_path: String,\n        source: String,\n    }\n\n    impl FixtureBuilder {\n        pub(crate) fn new(default_workspace: &str) -> Self {\n            Self {\n                default_workspace: default_workspace.to_string(),\n                files: Vec::new(),\n                events: Vec::new(),\n            }\n        }\n\n        pub(crate) fn rust(mut self, workspace: &str, path: &str, source: &str) -> Self {\n            self.files.push(FixtureFile::new(workspace, path, source));\n            self\n        }\n\n        pub(crate) fn markdown(mut self, workspace: &str, path: &str, source: &str) -> Self {\n            self.files.push(FixtureFile::new(workspace, path, source));\n            self\n        }\n\n        pub(crate) fn event(mut self, event_id: EventId) -> Self {\n            self.events.push(event_id);\n            self\n        }\n\n        pub(crate) fn build(self) -> ResolverFixture {\n            let mut graph = CodeGraph::new();\n            let mut file_index = HashMap::new();\n            let mut parsed_files = HashMap::new();\n            let mut docs = HashMap::new();\n\n            for file in self.files {\n                let stored_path = file.stored_path();\n                let parsed_file =\n                    parse_file(&stored_path, &file.source).expect(\"fixture should parse\");\n                add_symbols(&mut graph, &parsed_file);\n                if file.repo_relative_path.ends_with(\".md\") {\n                    docs.insert(\n                        (file.workspace.clone(), file.repo_relative_path.clone()),\n                        doc_id(&file.workspace, &file.repo_relative_path, &file.source),\n                    );\n                }\n                parsed_files.insert(stored_path.clone(), parsed_file);\n                file_index.insert(\n                    stored_path.clone(),\n                    file_index_entry(&stored_path, &file.source),\n                );\n            }\n\n            let resolver = IdentityResolver::new(\n                Box::leak(Box::new(graph)),\n                Box::leak(Box::new(file_index)),\n                Box::leak(Box::new(parsed_files)),\n                self.default_workspace,\n                self.events,\n            );\n            ResolverFixture { resolver, docs }\n        }\n    }\n\n    impl FixtureFile {\n        fn new(workspace: &str, path: &str, source: &str) -> Self {\n            Self {\n                workspace: workspace.to_string(),\n                repo_relative_path: path.to_string(),\n                source: source.to_string(),\n            }\n        }\n\n        fn stored_path(&self) -> String {\n            format!(\"{}/{}\", self.workspace, self.repo_relative_path)\n        }\n    }\n\n    pub(crate) fn content_hash(source: &str) -> String {\n        let mut hash = 0xcbf29ce484222325u64;\n        for byte in source.as_bytes() {\n            hash ^= *byte as u64;\n            hash = hash.wrapping_mul(0x100000001b3);\n        }\n        format!(\"{hash:016x}\")\n    }\n\n    pub(crate) fn expect_unique_symbol(outcome: ResolveOutcome<SymbolId>) -> SymbolId {\n        match outcome {\n            ResolveOutcome::Unique(symbol_id) => symbol_id,\n            other => panic!(\"expected unique symbol, got {other:?}\"),\n        }\n    }\n\n    pub(crate) fn expect_ambiguous_symbol(\n        outcome: ResolveOutcome<SymbolId>,\n    ) -> AmbiguityReport<SymbolId> {\n        match outcome {\n            ResolveOutcome::Ambiguous(report) => report,\n            other => panic!(\"expected ambiguous symbol, got {other:?}\"),\n        }\n    }\n\n    pub(crate) fn expect_unique_section(outcome: ResolveOutcome<SectionId>) -> SectionId {\n        match outcome {\n            ResolveOutcome::Unique(section_id) => section_id,\n            other => panic!(\"expected unique section, got {other:?}\"),\n        }\n    }\n\n    fn add_symbols(graph: &mut CodeGraph, parsed_file: &ParsedFile) {\n        for symbol in &parsed_file.symbols {\n            graph.add_node(\n                symbol.id.clone(),\n                symbol.kind,\n                symbol.name.clone(),\n                symbol.signature.clone(),\n                symbol.body.clone(),\n                symbol.file.clone(),\n                symbol.line,\n                symbol.end_line,\n                symbol.is_exported,\n                symbol.language,\n            );\n        }\n    }\n\n    fn doc_id(workspace: &str, path: &str, source: &str) -> DocId {\n        DocId {\n            workspace_id: workspace.to_string(),\n            repo_relative_path: path.to_string(),\n            content_hash: content_hash(source),\n        }\n    }\n\n    fn file_index_entry(stored_path: &str, source: &str) -> FileIndexEntry {\n        FileIndexEntry {\n            file: stored_path.to_string(),\n            content_hash: content_hash(source),\n            mtime_ns: 0,\n            size_bytes: source.len() as i64,\n            parser_version: FILE_INDEX_PARSER_VERSION,\n            schema_version: FILE_INDEX_SCHEMA_VERSION,\n            last_indexed_at: 0,\n        }\n    }\n}\n","numLines":384,"startLine":1,"totalLines":384}}}
