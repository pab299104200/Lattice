{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ENgx2yabAGMEdTyfBdsWxB","type":"tool_result","content":"1\tuse std::collections::BTreeMap;\n2\t\n3\tuse rusqlite::Connection;\n4\tuse sha2::{Digest, Sha256};\n5\t\n6\tuse crate::events::{EventPayload, EventQuery, EventReader, QueryOrder, StableRef};\n7\tuse crate::memory_graph::tests_common::{file_id, idem, memory_evidence, TestHarness};\n8\tuse crate::memory_graph::{\n9\t    get_links_from, initialize_schema, replay_events, transition_status, AssertionType,\n10\t    FreshnessKind, FreshnessPolicy, InvalidationTrigger, MemoryClass, MemoryLink, MemoryLinkId,\n11\t    MemoryLinkTarget, MemoryLinkType, TriggerKind, VerificationStatus,\n12\t};\n13\t\n14\t#[test]\n15\tfn event_log_replay_matches_original_memory_tables_byte_for_byte() {\n16\t    init_tracing();\n17\t    let harness = TestHarness::new();\n18\t    let before_midpoint = seed_replay_scenario(&harness);\n19\t    assert!(!before_midpoint.is_empty());\n20\t\n21\t    let original = table_fingerprint(&harness.conn());\n22\t    let replay_conn = open_replay_db();\n23\t    replay_events(&replay_conn, &all_memory_events(&harness)).expect(\"full replay succeeds\");\n24\t\n25\t    assert_eq!(original, table_fingerprint(&replay_conn));\n26\t}\n27\t\n28\t#[test]\n29\tfn snapshot_plus_tail_replay_matches_full_replay_state() {\n30\t    init_tracing();\n31\t    let harness = TestHarness::new();\n32\t    let midpoint = seed_replay_scenario(&harness);\n33\t    let all_events = all_memory_events(&harness);\n34\t\n35\t    let full_replay = open_replay_db();\n36\t    replay_events(&full_replay, &all_events).expect(\"full replay succeeds\");\n37\t\n38\t    let snapshot_replay = open_replay_db();\n39\t    replay_events(&snapshot_replay, &midpoint).expect(\"midpoint snapshot applies\");\n40\t    replay_events(&snapshot_replay, &all_events[midpoint.len()..]).expect(\"tail replay succeeds\");\n41\t\n42\t    assert_eq!(\n43\t        table_fingerprint(&full_replay),\n44\t        table_fingerprint(&snapshot_replay)\n45\t    );\n46\t}\n47\t\n48\t#[test]\n49\tfn corrupted_replay_snapshot_returns_typed_error_and_preserves_partial_state() {\n50\t    init_tracing();\n51\t    let harness = TestHarness::new();\n52\t    seed_replay_scenario(&harness);\n53\t    let clean_events = all_memory_events(&harness);\n54\t    let mut corrupted = clean_events.clone();\n55\t    corrupt_second_memory_update(&mut corrupted);\n56\t\n57\t    let replay_conn = open_replay_db();\n58\t    let error = replay_events(&replay_conn, &corrupted).expect_err(\"corrupted replay fails\");\n59\t    assert!(matches!(\n60\t        error,\n61\t        crate::memory_graph::MemoryReplayError::SnapshotDecode { .. }\n62\t    ));\n63\t\n64\t    let partial = table_fingerprint(&replay_conn);\n65\t    let prefix_conn = open_replay_db();\n66\t    replay_events(&prefix_conn, &clean_events[..3]).expect(\"clean prefix replays\");\n67\t    assert_eq!(partial, table_fingerprint(&prefix_conn));\n68\t}\n69\t\n70\t#[test]\n71\tfn workflow_outcome_stream_classification_survives_replay() {\n72\t    init_tracing();\n73\t    let harness = TestHarness::new();\n74\t    let workflow = harness\n75\t        .store\n76\t        .create(\n77\t            harness\n78\t                .draft(\"workflow-outcome\")\n79\t                .with_class(MemoryClass::WorkflowOutcome, AssertionType::Outcome)\n80\t                .into(),\n81\t            idem(\"create-workflow-outcome\"),\n82\t        )\n83\t        .expect(\"workflow outcome creates\");\n84\t\n85\t    let replay_conn = open_replay_db();\n86\t    replay_events(&replay_conn, &all_memory_events(&harness)).expect(\"replay succeeds\");\n87\t    let rows = replay_conn\n88\t        .query_row(\n89\t            \"SELECT class, assertion_type FROM memories WHERE memory_id = ?1\",\n90\t            rusqlite::params![crate::identity::encode_identity(\n91\t                &crate::identity::Identity::Memory(workflow.memory_id)\n92\t            )],\n93\t            |row| Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?)),\n94\t        )\n95\t        .expect(\"workflow memory loads\");\n96\t\n97\t    let class = rows.0.parse().expect(\"class parses\");\n98\t    let assertion = rows.1.parse().expect(\"assertion parses\");\n99\t    assert_eq!(\n100\t        crate::memory_graph::classify_stream(class, assertion),\n101\t        crate::memory_graph::MemoryStream::WorkflowEpisodes\n102\t    );\n103\t}\n104\t\n105\t#[test]\n106\tfn stale_transition_is_persisted_and_visible_through_scope_filtered_reads() {\n107\t    init_tracing();\n108\t    let harness = TestHarness::new();\n109\t    let draft = harness\n110\t        .draft(\"stale-file\")\n111\t        .with_linked_file(file_id(\"src/stale.rs\"))\n112\t        .build();\n113\t    let memory = harness\n114\t        .store\n115\t        .create(draft, idem(\"create-stale\"))\n116\t        .expect(\"stale candidate creates\");\n117\t    let verified = transition_status(\n118\t        &harness.store,\n119\t        memory.memory_id.clone(),\n120\t        VerificationStatus::Verified,\n121\t        \"initial verification passed\",\n122\t        Some(memory_evidence(\"stale-verified\")),\n123\t    )\n124\t    .expect(\"verification succeeds\");\n125\t\n126\t    let mut stale = verified.clone();\n127\t    stale.freshness_policy = FreshnessPolicy {\n128\t        kind: FreshnessKind::EventTriggered,\n129\t        ttl: None,\n130\t        recheck_interval: None,\n131\t    };\n132\t    stale.invalidation_triggers = vec![InvalidationTrigger {\n133\t        kind: TriggerKind::FileChanged,\n134\t        target: StableRef::FileRef(file_id(\"src/stale.rs\")),\n135\t    }];\n136\t    harness\n137\t        .store\n138\t        .write_transition(\n139\t            &verified,\n140\t            stale,\n141\t            \"file changed invalidation trigger fired\",\n142\t            Some(memory_evidence(\"stale-trigger\")),\n143\t        )\n144\t        .expect(\"stale event writes\");\n145\t    let updated = transition_status(\n146\t        &harness.store,\n147\t        memory.memory_id.clone(),\n148\t        VerificationStatus::Stale,\n149\t        \"file changed invalidation trigger fired\",\n150\t        Some(memory_evidence(\"stale-status\")),\n151\t    )\n152\t    .expect(\"stale transition succeeds\");\n153\t\n154\t    assert_eq!(updated.verification_status, VerificationStatus::Stale);\n155\t    assert_eq!(\n156\t        harness\n157\t            .store\n158\t            .get(&memory.memory_id, &harness.branch_scope())\n159\t            .expect(\"scope-filtered read\")\n160\t            .verification_status,\n161\t        VerificationStatus::Stale\n162\t    );\n163\t}\n164\t\n165\tfn seed_replay_scenario(harness: &TestHarness) -> Vec<crate::events::EventEnvelope> {\n166\t    let a = harness\n167\t        .store\n168\t        .create(harness.draft(\"alpha\").into(), idem(\"create-alpha\"))\n169\t        .expect(\"alpha creates\");\n170\t    let _verified = transition_status(\n171\t        &harness.store,\n172\t        a.memory_id.clone(),\n173\t        VerificationStatus::Verified,\n174\t        \"alpha verified\",\n175\t        Some(memory_evidence(\"alpha-verified\")),\n176\t    )\n177\t    .expect(\"alpha verifies\");\n178\t    let midpoint = all_memory_events(harness);\n179\t\n180\t    let b = harness\n181\t        .store\n182\t        .create(\n183\t            harness\n184\t                .draft(\"beta\")\n185\t                .with_class(MemoryClass::CounterMemory, AssertionType::Counter)\n186\t                .into(),\n187\t            idem(\"create-beta\"),\n188\t        )\n189\t        .expect(\"beta creates\");\n190\t    insert_supporting_link(\n191\t        harness,\n192\t        &b.memory_id,\n193\t        &a.memory_id,\n194\t        \"beta-contradicts-alpha\",\n195\t    );\n196\t    let beta_loaded = harness\n197\t        .store\n198\t        .get(&b.memory_id, &harness.branch_scope())\n199\t        .expect(\"beta loads\");\n200\t    harness\n201\t        .store\n202\t        .write_transition(\n203\t            &beta_loaded,\n204\t            beta_loaded.clone(),\n205\t            \"contradiction link inserted\",\n206\t            Some(memory_evidence(\"beta-link\")),\n207\t        )\n208\t        .expect(\"beta event writes\");\n209\t    let _contradicted = transition_status(\n210\t        &harness.store,\n211\t        a.memory_id.clone(),\n212\t        VerificationStatus::Contradicted,\n213\t        \"counter memory contradicts alpha\",\n214\t        Some(memory_evidence(\"alpha-contradicted\")),\n215\t    )\n216\t    .expect(\"alpha contradicts\");\n217\t    harness\n218\t        .store\n219\t        .delete(&b.memory_id, \"counter memory withdrawn\")\n220\t        .expect(\"beta invalidates\");\n221\t\n222\t    midpoint\n223\t}\n224\t\n225\tfn insert_supporting_link(\n226\t    harness: &TestHarness,\n227\t    source: &crate::identity::MemoryId,\n228\t    target: &crate::identity::MemoryId,\n229\t    seed: &str,\n230\t) {\n231\t    let link = MemoryLink::try_new(\n232\t        MemoryLinkId(format!(\"replay-link-{seed}\")),\n233\t        source.clone(),\n234\t        MemoryLinkTarget::Memory(target.clone()),\n235\t        MemoryLinkType::Contradicts,\n236\t        0.8,\n237\t        \"replay contradiction\".to_string(),\n238\t        None,\n239\t        crate::events::Actor::Assistant {\n240\t            model: \"gpt-test\".to_string(),\n241\t        },\n242\t        chrono::Utc::now(),\n243\t        VerificationStatus::Verified,\n244\t    )\n245\t    .expect(\"link validates\");\n246\t    crate::memory_graph::insert_link(&harness.conn(), &link).expect(\"link inserts\");\n247\t    assert_eq!(\n248\t        get_links_from(&harness.conn(), source).expect(\"links load\"),\n249\t        vec![link]\n250\t    );\n251\t}\n252\t\n253\tfn all_memory_events(harness: &TestHarness) -> Vec<crate::events::EventEnvelope> {\n254\t    EventReader::new(harness.event_store.clone())\n255\t        .execute(\n256\t            EventQuery::new()\n257\t                .session(\"memory-graph\")\n258\t                .workspace(\"workspace\")\n259\t                .branch(\"main\")\n260\t                .order(QueryOrder::OldestFirst)\n261\t                .limit(200),\n262\t        )\n263\t        .expect(\"memory graph events load\")\n264\t}\n265\t\n266\tfn corrupt_second_memory_update(events: &mut [crate::events::EventEnvelope]) {\n267\t    let mut seen_updates = 0_usize;\n268\t    for event in events {\n269\t        if let EventPayload::MemoryUpdated(payload) = &mut event.payload {\n270\t            seen_updates += 1;\n271\t            if seen_updates == 2 {\n272\t                payload.replay_snapshot_json = Some(\"{not-json\".to_string());\n273\t                return;\n274\t            }\n275\t        }\n276\t    }\n277\t    panic!(\"expected two memory_updated events to corrupt\");\n278\t}\n279\t\n280\tfn open_replay_db() -> Connection {\n281\t    let conn = Connection::open_in_memory().expect(\"replay DB opens\");\n282\t    conn.execute_batch(\"PRAGMA foreign_keys = ON;\")\n283\t        .expect(\"foreign keys enable\");\n284\t    initialize_schema(&conn).expect(\"schema initializes\");\n285\t    conn\n286\t}\n287\t\n288\tfn table_fingerprint(conn: &Connection) -> BTreeMap<&'static str, (usize, String)> {\n289\t    BTreeMap::from([\n290\t        (\"memories\", table_digest(conn, \"memories\")),\n291\t        (\"memory_links\", table_digest(conn, \"memory_links\")),\n292\t        (\"memory_evidence\", table_digest(conn, \"memory_evidence\")),\n293\t    ])\n294\t}\n295\t\n296\tfn table_digest(conn: &Connection, table: &'static str) -> (usize, String) {\n297\t    let mut statement = conn\n298\t        .prepare(&format!(\"SELECT * FROM {table} ORDER BY 1, 2, 3\"))\n299\t        .expect(\"statement prepares\");\n300\t    let column_count = statement.column_count();\n301\t    let rows = statement\n302\t        .query_map([], |row| {\n303\t            let mut values = Vec::new();\n304\t            for index in 0..column_count {\n305\t                values.push(format!(\"{:?}\", row.get_ref(index)?));\n306\t            }\n307\t            Ok(values.join(\"|\"))\n308\t        })\n309\t        .expect(\"rows query\");\n310\t    let values = rows.collect::<Result<Vec<_>, _>>().expect(\"rows collect\");\n311\t    let mut hasher = Sha256::new();\n312\t    for value in &values {\n313\t        hasher.update(value.as_bytes());\n314\t        hasher.update(b\"\\n\");\n315\t    }\n316\t    (values.len(), format!(\"{:x}\", hasher.finalize()))\n317\t}\n318\t\n319\tfn init_tracing() {\n320\t    let _ = tracing_subscriber::fmt::try_init();\n321\t}\n322\t"}]},"parent_tool_use_id":null,"session_id":"97e40997-f38f-4628-bdcd-a9758dda27fa","uuid":"2103b032-3282-494e-87ce-54827f6ad9a5","timestamp":"2026-05-17T07:29:28.905Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/memory_graph/replay_tests.rs","content":"use std::collections::BTreeMap;\n\nuse rusqlite::Connection;\nuse sha2::{Digest, Sha256};\n\nuse crate::events::{EventPayload, EventQuery, EventReader, QueryOrder, StableRef};\nuse crate::memory_graph::tests_common::{file_id, idem, memory_evidence, TestHarness};\nuse crate::memory_graph::{\n    get_links_from, initialize_schema, replay_events, transition_status, AssertionType,\n    FreshnessKind, FreshnessPolicy, InvalidationTrigger, MemoryClass, MemoryLink, MemoryLinkId,\n    MemoryLinkTarget, MemoryLinkType, TriggerKind, VerificationStatus,\n};\n\n#[test]\nfn event_log_replay_matches_original_memory_tables_byte_for_byte() {\n    init_tracing();\n    let harness = TestHarness::new();\n    let before_midpoint = seed_replay_scenario(&harness);\n    assert!(!before_midpoint.is_empty());\n\n    let original = table_fingerprint(&harness.conn());\n    let replay_conn = open_replay_db();\n    replay_events(&replay_conn, &all_memory_events(&harness)).expect(\"full replay succeeds\");\n\n    assert_eq!(original, table_fingerprint(&replay_conn));\n}\n\n#[test]\nfn snapshot_plus_tail_replay_matches_full_replay_state() {\n    init_tracing();\n    let harness = TestHarness::new();\n    let midpoint = seed_replay_scenario(&harness);\n    let all_events = all_memory_events(&harness);\n\n    let full_replay = open_replay_db();\n    replay_events(&full_replay, &all_events).expect(\"full replay succeeds\");\n\n    let snapshot_replay = open_replay_db();\n    replay_events(&snapshot_replay, &midpoint).expect(\"midpoint snapshot applies\");\n    replay_events(&snapshot_replay, &all_events[midpoint.len()..]).expect(\"tail replay succeeds\");\n\n    assert_eq!(\n        table_fingerprint(&full_replay),\n        table_fingerprint(&snapshot_replay)\n    );\n}\n\n#[test]\nfn corrupted_replay_snapshot_returns_typed_error_and_preserves_partial_state() {\n    init_tracing();\n    let harness = TestHarness::new();\n    seed_replay_scenario(&harness);\n    let clean_events = all_memory_events(&harness);\n    let mut corrupted = clean_events.clone();\n    corrupt_second_memory_update(&mut corrupted);\n\n    let replay_conn = open_replay_db();\n    let error = replay_events(&replay_conn, &corrupted).expect_err(\"corrupted replay fails\");\n    assert!(matches!(\n        error,\n        crate::memory_graph::MemoryReplayError::SnapshotDecode { .. }\n    ));\n\n    let partial = table_fingerprint(&replay_conn);\n    let prefix_conn = open_replay_db();\n    replay_events(&prefix_conn, &clean_events[..3]).expect(\"clean prefix replays\");\n    assert_eq!(partial, table_fingerprint(&prefix_conn));\n}\n\n#[test]\nfn workflow_outcome_stream_classification_survives_replay() {\n    init_tracing();\n    let harness = TestHarness::new();\n    let workflow = harness\n        .store\n        .create(\n            harness\n                .draft(\"workflow-outcome\")\n                .with_class(MemoryClass::WorkflowOutcome, AssertionType::Outcome)\n                .into(),\n            idem(\"create-workflow-outcome\"),\n        )\n        .expect(\"workflow outcome creates\");\n\n    let replay_conn = open_replay_db();\n    replay_events(&replay_conn, &all_memory_events(&harness)).expect(\"replay succeeds\");\n    let rows = replay_conn\n        .query_row(\n            \"SELECT class, assertion_type FROM memories WHERE memory_id = ?1\",\n            rusqlite::params![crate::identity::encode_identity(\n                &crate::identity::Identity::Memory(workflow.memory_id)\n            )],\n            |row| Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?)),\n        )\n        .expect(\"workflow memory loads\");\n\n    let class = rows.0.parse().expect(\"class parses\");\n    let assertion = rows.1.parse().expect(\"assertion parses\");\n    assert_eq!(\n        crate::memory_graph::classify_stream(class, assertion),\n        crate::memory_graph::MemoryStream::WorkflowEpisodes\n    );\n}\n\n#[test]\nfn stale_transition_is_persisted_and_visible_through_scope_filtered_reads() {\n    init_tracing();\n    let harness = TestHarness::new();\n    let draft = harness\n        .draft(\"stale-file\")\n        .with_linked_file(file_id(\"src/stale.rs\"))\n        .build();\n    let memory = harness\n        .store\n        .create(draft, idem(\"create-stale\"))\n        .expect(\"stale candidate creates\");\n    let verified = transition_status(\n        &harness.store,\n        memory.memory_id.clone(),\n        VerificationStatus::Verified,\n        \"initial verification passed\",\n        Some(memory_evidence(\"stale-verified\")),\n    )\n    .expect(\"verification succeeds\");\n\n    let mut stale = verified.clone();\n    stale.freshness_policy = FreshnessPolicy {\n        kind: FreshnessKind::EventTriggered,\n        ttl: None,\n        recheck_interval: None,\n    };\n    stale.invalidation_triggers = vec![InvalidationTrigger {\n        kind: TriggerKind::FileChanged,\n        target: StableRef::FileRef(file_id(\"src/stale.rs\")),\n    }];\n    harness\n        .store\n        .write_transition(\n            &verified,\n            stale,\n            \"file changed invalidation trigger fired\",\n            Some(memory_evidence(\"stale-trigger\")),\n        )\n        .expect(\"stale event writes\");\n    let updated = transition_status(\n        &harness.store,\n        memory.memory_id.clone(),\n        VerificationStatus::Stale,\n        \"file changed invalidation trigger fired\",\n        Some(memory_evidence(\"stale-status\")),\n    )\n    .expect(\"stale transition succeeds\");\n\n    assert_eq!(updated.verification_status, VerificationStatus::Stale);\n    assert_eq!(\n        harness\n            .store\n            .get(&memory.memory_id, &harness.branch_scope())\n            .expect(\"scope-filtered read\")\n            .verification_status,\n        VerificationStatus::Stale\n    );\n}\n\nfn seed_replay_scenario(harness: &TestHarness) -> Vec<crate::events::EventEnvelope> {\n    let a = harness\n        .store\n        .create(harness.draft(\"alpha\").into(), idem(\"create-alpha\"))\n        .expect(\"alpha creates\");\n    let _verified = transition_status(\n        &harness.store,\n        a.memory_id.clone(),\n        VerificationStatus::Verified,\n        \"alpha verified\",\n        Some(memory_evidence(\"alpha-verified\")),\n    )\n    .expect(\"alpha verifies\");\n    let midpoint = all_memory_events(harness);\n\n    let b = harness\n        .store\n        .create(\n            harness\n                .draft(\"beta\")\n                .with_class(MemoryClass::CounterMemory, AssertionType::Counter)\n                .into(),\n            idem(\"create-beta\"),\n        )\n        .expect(\"beta creates\");\n    insert_supporting_link(\n        harness,\n        &b.memory_id,\n        &a.memory_id,\n        \"beta-contradicts-alpha\",\n    );\n    let beta_loaded = harness\n        .store\n        .get(&b.memory_id, &harness.branch_scope())\n        .expect(\"beta loads\");\n    harness\n        .store\n        .write_transition(\n            &beta_loaded,\n            beta_loaded.clone(),\n            \"contradiction link inserted\",\n            Some(memory_evidence(\"beta-link\")),\n        )\n        .expect(\"beta event writes\");\n    let _contradicted = transition_status(\n        &harness.store,\n        a.memory_id.clone(),\n        VerificationStatus::Contradicted,\n        \"counter memory contradicts alpha\",\n        Some(memory_evidence(\"alpha-contradicted\")),\n    )\n    .expect(\"alpha contradicts\");\n    harness\n        .store\n        .delete(&b.memory_id, \"counter memory withdrawn\")\n        .expect(\"beta invalidates\");\n\n    midpoint\n}\n\nfn insert_supporting_link(\n    harness: &TestHarness,\n    source: &crate::identity::MemoryId,\n    target: &crate::identity::MemoryId,\n    seed: &str,\n) {\n    let link = MemoryLink::try_new(\n        MemoryLinkId(format!(\"replay-link-{seed}\")),\n        source.clone(),\n        MemoryLinkTarget::Memory(target.clone()),\n        MemoryLinkType::Contradicts,\n        0.8,\n        \"replay contradiction\".to_string(),\n        None,\n        crate::events::Actor::Assistant {\n            model: \"gpt-test\".to_string(),\n        },\n        chrono::Utc::now(),\n        VerificationStatus::Verified,\n    )\n    .expect(\"link validates\");\n    crate::memory_graph::insert_link(&harness.conn(), &link).expect(\"link inserts\");\n    assert_eq!(\n        get_links_from(&harness.conn(), source).expect(\"links load\"),\n        vec![link]\n    );\n}\n\nfn all_memory_events(harness: &TestHarness) -> Vec<crate::events::EventEnvelope> {\n    EventReader::new(harness.event_store.clone())\n        .execute(\n            EventQuery::new()\n                .session(\"memory-graph\")\n                .workspace(\"workspace\")\n                .branch(\"main\")\n                .order(QueryOrder::OldestFirst)\n                .limit(200),\n        )\n        .expect(\"memory graph events load\")\n}\n\nfn corrupt_second_memory_update(events: &mut [crate::events::EventEnvelope]) {\n    let mut seen_updates = 0_usize;\n    for event in events {\n        if let EventPayload::MemoryUpdated(payload) = &mut event.payload {\n            seen_updates += 1;\n            if seen_updates == 2 {\n                payload.replay_snapshot_json = Some(\"{not-json\".to_string());\n                return;\n            }\n        }\n    }\n    panic!(\"expected two memory_updated events to corrupt\");\n}\n\nfn open_replay_db() -> Connection {\n    let conn = Connection::open_in_memory().expect(\"replay DB opens\");\n    conn.execute_batch(\"PRAGMA foreign_keys = ON;\")\n        .expect(\"foreign keys enable\");\n    initialize_schema(&conn).expect(\"schema initializes\");\n    conn\n}\n\nfn table_fingerprint(conn: &Connection) -> BTreeMap<&'static str, (usize, String)> {\n    BTreeMap::from([\n        (\"memories\", table_digest(conn, \"memories\")),\n        (\"memory_links\", table_digest(conn, \"memory_links\")),\n        (\"memory_evidence\", table_digest(conn, \"memory_evidence\")),\n    ])\n}\n\nfn table_digest(conn: &Connection, table: &'static str) -> (usize, String) {\n    let mut statement = conn\n        .prepare(&format!(\"SELECT * FROM {table} ORDER BY 1, 2, 3\"))\n        .expect(\"statement prepares\");\n    let column_count = statement.column_count();\n    let rows = statement\n        .query_map([], |row| {\n            let mut values = Vec::new();\n            for index in 0..column_count {\n                values.push(format!(\"{:?}\", row.get_ref(index)?));\n            }\n            Ok(values.join(\"|\"))\n        })\n        .expect(\"rows query\");\n    let values = rows.collect::<Result<Vec<_>, _>>().expect(\"rows collect\");\n    let mut hasher = Sha256::new();\n    for value in &values {\n        hasher.update(value.as_bytes());\n        hasher.update(b\"\\n\");\n    }\n    (values.len(), format!(\"{:x}\", hasher.finalize()))\n}\n\nfn init_tracing() {\n    let _ = tracing_subscriber::fmt::try_init();\n}\n","numLines":322,"startLine":1,"totalLines":322}}}
