{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WC4pVZPR9EznSVRe9TSG6V","type":"tool_result","content":"1\t//! Identity resolver for Phase 1 stable ids.\n2\t//! This module implements the resolver deliverable required by\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## Phase 1: Unified Identity Model`. It also preserves the stable\n5\t//! follow-up contract from\n6\t//! `docs/architecture/2026-04-11-stable-follow-up-handles.md` `## Contract`\n7\t//! while using a small LRU justified by that note's\n8\t//! `## Assistant-Facing Surfaces`.\n9\tuse std::cell::RefCell;\n10\tuse std::collections::{HashMap, VecDeque};\n11\tuse thiserror::Error;\n12\t\n13\tuse crate::graph::{CodeGraph, GraphNode};\n14\tuse crate::identity::ambiguity::{\n15\t    section_disambiguation_hint, symbol_disambiguation_hint, test_disambiguation_hint,\n16\t    AmbiguityReport, ResolveOutcome,\n17\t};\n18\tuse crate::storage::graph_store::FileIndexEntry;\n19\tuse crate::symbols::{ParsedFile, SymbolKind};\n20\t\n21\tuse super::encoding::decode_identity;\n22\tuse super::kinds::{DocId, EventId, FileId, Identity, SectionId, SymbolId};\n23\t\n24\tpub type WorkspaceId = String;\n25\t\n26\tconst DEFAULT_CONTENT_HASH: &str = \"00000000\";\n27\tconst DEFAULT_CACHE_CAPACITY: usize = 64;\n28\t\n29\t/// Resolves user-facing or assistant-facing references into stable identities.\n30\tpub struct IdentityResolver<'a> {\n31\t    graph: &'a CodeGraph,\n32\t    file_index: &'a HashMap<String, FileIndexEntry>,\n33\t    parsed_files: &'a HashMap<String, ParsedFile>,\n34\t    default_workspace: WorkspaceId,\n35\t    latest_event_id: Option<EventId>,\n36\t    event_index: HashMap<String, EventId>,\n37\t    cache: RefCell<ResolverCache>,\n38\t}\n39\t\n40\t#[derive(Clone, Debug, Error, PartialEq, Eq)]\n41\tpub enum ResolveError {\n42\t    #[error(\"workspace `{workspace_id}` is not indexed\")]\n43\t    WorkspaceNotIndexed { workspace_id: WorkspaceId },\n44\t    #[error(\"malformed {kind} reference `{query}`: {reason}\")]\n45\t    Malformed {\n46\t        kind: &'static str,\n47\t        query: String,\n48\t        reason: &'static str,\n49\t    },\n50\t    #[error(\"no {kind} identity found for `{query}`\")]\n51\t    NotFound { kind: &'static str, query: String },\n52\t    #[error(\n53\t        \"event index is behind the requested reference; latest indexed event is {latest_event_id}\"\n54\t    )]\n55\t    IndexLagBehind { latest_event_id: EventId },\n56\t}\n57\t\n58\t#[derive(Clone, Debug, PartialEq, Eq, Hash)]\n59\tenum CacheKey {\n60\t    Path(WorkspaceId, String),\n61\t    Symbol(WorkspaceId, String),\n62\t    Section(WorkspaceId, String, String),\n63\t    Test(WorkspaceId, String),\n64\t    Event(WorkspaceId, String),\n65\t    LegacySymbol(String),\n66\t}\n67\t\n68\t#[derive(Clone, Debug, PartialEq, Eq)]\n69\tenum CacheValue {\n70\t    File(Result<FileId, ResolveError>),\n71\t    Symbol(ResolveOutcome<SymbolId>),\n72\t    Section(ResolveOutcome<SectionId>),\n73\t    Test(ResolveOutcome<SymbolId>),\n74\t    Event(Result<EventId, ResolveError>),\n75\t}\n76\t\n77\t#[derive(Default)]\n78\tstruct ResolverCache {\n79\t    capacity: usize,\n80\t    order: VecDeque<CacheKey>,\n81\t    values: HashMap<CacheKey, CacheValue>,\n82\t}\n83\t\n84\timpl ResolverCache {\n85\t    fn new(capacity: usize) -> Self {\n86\t        Self {\n87\t            capacity: capacity.max(1),\n88\t            order: VecDeque::new(),\n89\t            values: HashMap::new(),\n90\t        }\n91\t    }\n92\t\n93\t    fn get(&mut self, key: &CacheKey) -> Option<CacheValue> {\n94\t        let value = self.values.get(key)?.clone();\n95\t        self.touch(key.clone());\n96\t        Some(value)\n97\t    }\n98\t\n99\t    fn insert(&mut self, key: CacheKey, value: CacheValue) {\n100\t        self.values.insert(key.clone(), value);\n101\t        self.touch(key);\n102\t        while self.order.len() > self.capacity {\n103\t            if let Some(oldest) = self.order.pop_front() {\n104\t                self.values.remove(&oldest);\n105\t            }\n106\t        }\n107\t    }\n108\t\n109\t    fn touch(&mut self, key: CacheKey) {\n110\t        self.order.retain(|existing| existing != &key);\n111\t        self.order.push_back(key);\n112\t    }\n113\t}\n114\t\n115\timpl<'a> IdentityResolver<'a> {\n116\t    pub fn new(\n117\t        graph: &'a CodeGraph,\n118\t        file_index: &'a HashMap<String, FileIndexEntry>,\n119\t        parsed_files: &'a HashMap<String, ParsedFile>,\n120\t        default_workspace: WorkspaceId,\n121\t        event_ids: Vec<EventId>,\n122\t    ) -> Self {\n123\t        let latest_event_id = event_ids.iter().max_by_key(|event| &event.ulid).cloned();\n124\t        let event_index = event_ids\n125\t            .into_iter()\n126\t            .map(|event| (event.ulid.clone(), event))\n127\t            .collect();\n128\t\n129\t        Self {\n130\t            graph,\n131\t            file_index,\n132\t            parsed_files,\n133\t            default_workspace,\n134\t            latest_event_id,\n135\t            event_index,\n136\t            cache: RefCell::new(ResolverCache::new(DEFAULT_CACHE_CAPACITY)),\n137\t        }\n138\t    }\n139\t\n140\t    pub fn resolve_path(\n141\t        &self,\n142\t        workspace: &WorkspaceId,\n143\t        path: &str,\n144\t    ) -> Result<FileId, ResolveError> {\n145\t        let key = CacheKey::Path(workspace.clone(), path.to_string());\n146\t        if let Some(CacheValue::File(result)) = self.cache.borrow_mut().get(&key) {\n147\t            return result;\n148\t        }\n149\t\n150\t        let result = self.resolve_path_uncached(workspace, path);\n151\t        self.cache\n152\t            .borrow_mut()\n153\t            .insert(key, CacheValue::File(result.clone()));\n154\t        result\n155\t    }\n156\t\n157\t    pub fn resolve_symbol(\n158\t        &self,\n159\t        workspace: &WorkspaceId,\n160\t        qualified_name: &str,\n161\t    ) -> ResolveOutcome<SymbolId> {\n162\t        let key = CacheKey::Symbol(workspace.clone(), qualified_name.to_string());\n163\t        if let Some(CacheValue::Symbol(result)) = self.cache.borrow_mut().get(&key) {\n164\t            return result;\n165\t        }\n166\t\n167\t        let result = self.resolve_symbol_uncached(workspace, qualified_name);\n168\t        self.cache\n169\t            .borrow_mut()\n170\t            .insert(key, CacheValue::Symbol(result.clone()));\n171\t        result\n172\t    }\n173\t\n174\t    pub fn resolve_section(\n175\t        &self,\n176\t        workspace: &WorkspaceId,\n177\t        doc: &DocId,\n178\t        heading: &str,\n179\t    ) -> ResolveOutcome<SectionId> {\n180\t        let key = CacheKey::Section(\n181\t            workspace.clone(),\n182\t            doc.repo_relative_path.clone(),\n183\t            heading.to_string(),\n184\t        );\n185\t        if let Some(CacheValue::Section(result)) = self.cache.borrow_mut().get(&key) {\n186\t            return result;\n187\t        }\n188\t\n189\t        let result = self.resolve_section_uncached(workspace, doc, heading);\n190\t        self.cache\n191\t            .borrow_mut()\n192\t            .insert(key, CacheValue::Section(result.clone()));\n193\t        result\n194\t    }\n195\t\n196\t    pub fn resolve_test(\n197\t        &self,\n198\t        workspace: &WorkspaceId,\n199\t        test_name: &str,\n200\t    ) -> ResolveOutcome<SymbolId> {\n201\t        let key = CacheKey::Test(workspace.clone(), test_name.to_string());\n202\t        if let Some(CacheValue::Test(result)) = self.cache.borrow_mut().get(&key) {\n203\t            return result;\n204\t        }\n205\t\n206\t        let result = self.resolve_test_uncached(workspace, test_name);\n207\t        self.cache\n208\t            .borrow_mut()\n209\t            .insert(key, CacheValue::Test(result.clone()));\n210\t        result\n211\t    }\n212\t\n213\t    pub fn resolve_event_ref(\n214\t        &self,\n215\t        workspace: &WorkspaceId,\n216\t        ref_str: &str,\n217\t    ) -> Result<EventId, ResolveError> {\n218\t        let key = CacheKey::Event(workspace.clone(), ref_str.to_string());\n219\t        if let Some(CacheValue::Event(result)) = self.cache.borrow_mut().get(&key) {\n220\t            return result;"}]},"parent_tool_use_id":null,"session_id":"97e40997-f38f-4628-bdcd-a9758dda27fa","uuid":"62a0edd9-215c-4ae2-b20d-c3e37665499c","timestamp":"2026-05-17T07:28:15.178Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/identity/resolver.rs","content":"//! Identity resolver for Phase 1 stable ids.\n//! This module implements the resolver deliverable required by\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 1: Unified Identity Model`. It also preserves the stable\n//! follow-up contract from\n//! `docs/architecture/2026-04-11-stable-follow-up-handles.md` `## Contract`\n//! while using a small LRU justified by that note's\n//! `## Assistant-Facing Surfaces`.\nuse std::cell::RefCell;\nuse std::collections::{HashMap, VecDeque};\nuse thiserror::Error;\n\nuse crate::graph::{CodeGraph, GraphNode};\nuse crate::identity::ambiguity::{\n    section_disambiguation_hint, symbol_disambiguation_hint, test_disambiguation_hint,\n    AmbiguityReport, ResolveOutcome,\n};\nuse crate::storage::graph_store::FileIndexEntry;\nuse crate::symbols::{ParsedFile, SymbolKind};\n\nuse super::encoding::decode_identity;\nuse super::kinds::{DocId, EventId, FileId, Identity, SectionId, SymbolId};\n\npub type WorkspaceId = String;\n\nconst DEFAULT_CONTENT_HASH: &str = \"00000000\";\nconst DEFAULT_CACHE_CAPACITY: usize = 64;\n\n/// Resolves user-facing or assistant-facing references into stable identities.\npub struct IdentityResolver<'a> {\n    graph: &'a CodeGraph,\n    file_index: &'a HashMap<String, FileIndexEntry>,\n    parsed_files: &'a HashMap<String, ParsedFile>,\n    default_workspace: WorkspaceId,\n    latest_event_id: Option<EventId>,\n    event_index: HashMap<String, EventId>,\n    cache: RefCell<ResolverCache>,\n}\n\n#[derive(Clone, Debug, Error, PartialEq, Eq)]\npub enum ResolveError {\n    #[error(\"workspace `{workspace_id}` is not indexed\")]\n    WorkspaceNotIndexed { workspace_id: WorkspaceId },\n    #[error(\"malformed {kind} reference `{query}`: {reason}\")]\n    Malformed {\n        kind: &'static str,\n        query: String,\n        reason: &'static str,\n    },\n    #[error(\"no {kind} identity found for `{query}`\")]\n    NotFound { kind: &'static str, query: String },\n    #[error(\n        \"event index is behind the requested reference; latest indexed event is {latest_event_id}\"\n    )]\n    IndexLagBehind { latest_event_id: EventId },\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Hash)]\nenum CacheKey {\n    Path(WorkspaceId, String),\n    Symbol(WorkspaceId, String),\n    Section(WorkspaceId, String, String),\n    Test(WorkspaceId, String),\n    Event(WorkspaceId, String),\n    LegacySymbol(String),\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\nenum CacheValue {\n    File(Result<FileId, ResolveError>),\n    Symbol(ResolveOutcome<SymbolId>),\n    Section(ResolveOutcome<SectionId>),\n    Test(ResolveOutcome<SymbolId>),\n    Event(Result<EventId, ResolveError>),\n}\n\n#[derive(Default)]\nstruct ResolverCache {\n    capacity: usize,\n    order: VecDeque<CacheKey>,\n    values: HashMap<CacheKey, CacheValue>,\n}\n\nimpl ResolverCache {\n    fn new(capacity: usize) -> Self {\n        Self {\n            capacity: capacity.max(1),\n            order: VecDeque::new(),\n            values: HashMap::new(),\n        }\n    }\n\n    fn get(&mut self, key: &CacheKey) -> Option<CacheValue> {\n        let value = self.values.get(key)?.clone();\n        self.touch(key.clone());\n        Some(value)\n    }\n\n    fn insert(&mut self, key: CacheKey, value: CacheValue) {\n        self.values.insert(key.clone(), value);\n        self.touch(key);\n        while self.order.len() > self.capacity {\n            if let Some(oldest) = self.order.pop_front() {\n                self.values.remove(&oldest);\n            }\n        }\n    }\n\n    fn touch(&mut self, key: CacheKey) {\n        self.order.retain(|existing| existing != &key);\n        self.order.push_back(key);\n    }\n}\n\nimpl<'a> IdentityResolver<'a> {\n    pub fn new(\n        graph: &'a CodeGraph,\n        file_index: &'a HashMap<String, FileIndexEntry>,\n        parsed_files: &'a HashMap<String, ParsedFile>,\n        default_workspace: WorkspaceId,\n        event_ids: Vec<EventId>,\n    ) -> Self {\n        let latest_event_id = event_ids.iter().max_by_key(|event| &event.ulid).cloned();\n        let event_index = event_ids\n            .into_iter()\n            .map(|event| (event.ulid.clone(), event))\n            .collect();\n\n        Self {\n            graph,\n            file_index,\n            parsed_files,\n            default_workspace,\n            latest_event_id,\n            event_index,\n            cache: RefCell::new(ResolverCache::new(DEFAULT_CACHE_CAPACITY)),\n        }\n    }\n\n    pub fn resolve_path(\n        &self,\n        workspace: &WorkspaceId,\n        path: &str,\n    ) -> Result<FileId, ResolveError> {\n        let key = CacheKey::Path(workspace.clone(), path.to_string());\n        if let Some(CacheValue::File(result)) = self.cache.borrow_mut().get(&key) {\n            return result;\n        }\n\n        let result = self.resolve_path_uncached(workspace, path);\n        self.cache\n            .borrow_mut()\n            .insert(key, CacheValue::File(result.clone()));\n        result\n    }\n\n    pub fn resolve_symbol(\n        &self,\n        workspace: &WorkspaceId,\n        qualified_name: &str,\n    ) -> ResolveOutcome<SymbolId> {\n        let key = CacheKey::Symbol(workspace.clone(), qualified_name.to_string());\n        if let Some(CacheValue::Symbol(result)) = self.cache.borrow_mut().get(&key) {\n            return result;\n        }\n\n        let result = self.resolve_symbol_uncached(workspace, qualified_name);\n        self.cache\n            .borrow_mut()\n            .insert(key, CacheValue::Symbol(result.clone()));\n        result\n    }\n\n    pub fn resolve_section(\n        &self,\n        workspace: &WorkspaceId,\n        doc: &DocId,\n        heading: &str,\n    ) -> ResolveOutcome<SectionId> {\n        let key = CacheKey::Section(\n            workspace.clone(),\n            doc.repo_relative_path.clone(),\n            heading.to_string(),\n        );\n        if let Some(CacheValue::Section(result)) = self.cache.borrow_mut().get(&key) {\n            return result;\n        }\n\n        let result = self.resolve_section_uncached(workspace, doc, heading);\n        self.cache\n            .borrow_mut()\n            .insert(key, CacheValue::Section(result.clone()));\n        result\n    }\n\n    pub fn resolve_test(\n        &self,\n        workspace: &WorkspaceId,\n        test_name: &str,\n    ) -> ResolveOutcome<SymbolId> {\n        let key = CacheKey::Test(workspace.clone(), test_name.to_string());\n        if let Some(CacheValue::Test(result)) = self.cache.borrow_mut().get(&key) {\n            return result;\n        }\n\n        let result = self.resolve_test_uncached(workspace, test_name);\n        self.cache\n            .borrow_mut()\n            .insert(key, CacheValue::Test(result.clone()));\n        result\n    }\n\n    pub fn resolve_event_ref(\n        &self,\n        workspace: &WorkspaceId,\n        ref_str: &str,\n    ) -> Result<EventId, ResolveError> {\n        let key = CacheKey::Event(workspace.clone(), ref_str.to_string());\n        if let Some(CacheValue::Event(result)) = self.cache.borrow_mut().get(&key) {\n            return result;","numLines":220,"startLine":1,"totalLines":741}}}
