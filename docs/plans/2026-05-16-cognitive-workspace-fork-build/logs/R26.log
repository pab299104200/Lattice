{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MQDtMpDKbMfaMTf9TP6N4T","type":"tool_result","content":"120\t             verification_status, confidence, confidence_reason, freshness_policy_json,\n121\t             validity_conditions_json, invalidation_triggers_json, provenance_event_ids_json,\n122\t             evidence_references_json, linked_files_json, linked_symbols_json, linked_docs_json,\n123\t             linked_tests_json, linked_memories_json, contradiction_links_json,\n124\t             supersession_links_json, access_history_json, usefulness_score,\n125\t             usefulness_score_updated_at, created_at, created_by, updated_at, updated_by,\n126\t             schema_version)\n127\t         VALUES\n128\t            ('memory:ws/conflict', 'preexisting', 'decision', 'decision', 'repo', 'ws',\n129\t             'unverified', 1.0, 'preexisting', '{}', '[]', '[]', '[]', '[]', '[]', '[]',\n130\t             '[]', '[]', '[]', '[]', '[]', '[]', 0.0, 1, 1, 'test', 1, 'test', 1)\",\n131\t        params![],\n132\t    )\n133\t    .expect(\"conflict row\");\n134\t    let migrator = migrator(source, dest, false);\n135\t    let plan = migrator.plan().expect(\"plan\");\n136\t\n137\t    let error = migrator.run(&plan).expect_err(\"conflict\");\n138\t    assert!(matches!(error, MigrationError::IdempotenceConflict { .. }));\n139\t    assert_table_count(&migrator, \"memories\", 1);\n140\t\n141\t    delete_conflict(&migrator);\n142\t    let retry_plan = migrator.plan().expect(\"retry plan\");\n143\t    let retry_report = migrator.run(&retry_plan).expect(\"retry run\");\n144\t    assert_eq!(retry_report.migrated_rows, 2);\n145\t    assert_table_count(&migrator, \"memories\", 2);\n146\t}\n147\t\n148\t#[test]\n149\tfn dry_run_matches_real_report_but_writes_nothing() {\n150\t    let dry_source = legacy_conn();\n151\t    insert_rich_row(&dry_source);\n152\t    let real_source = legacy_conn();\n153\t    insert_rich_row(&real_source);\n154\t    let dry = migrator(dry_source, dest_conn(), true);\n155\t    let real = migrator(real_source, dest_conn(), false);\n156\t\n157\t    let dry_plan = dry.plan().expect(\"dry plan\");\n158\t    let dry_report = dry.run(&dry_plan).expect(\"dry run\");\n159\t    let real_plan = real.plan().expect(\"real plan\");\n160\t    let real_report = real.run(&real_plan).expect(\"real run\");\n161\t\n162\t    assert_eq!(dry_report.migrated_rows, real_report.migrated_rows);\n163\t    assert_eq!(\n164\t        dry_report.destination_inserts,\n165\t        real_report.destination_inserts\n166\t    );\n167\t    assert_table_count(&dry, \"memories\", 0);\n168\t    assert_table_count(&real, \"memories\", 1);\n169\t}\n170\t\n171\t#[test]\n172\tfn unmappable_rows_are_reported_and_do_not_halt_migration() {\n173\t    let source = legacy_conn();\n174\t    insert_bad_row(&source);\n175\t    insert_row(&source, \"obs\", \"observation\", \"observation\", \"session\");\n176\t    let migrator = migrator(source, dest_conn(), false);\n177\t    let plan = migrator.plan().expect(\"plan\");\n178\t    let report = migrator.run(&plan).expect(\"run\");\n179\t\n180\t    assert_eq!(plan.skipped_rows.len(), 1);\n181\t    assert_eq!(report.skipped_rows.len(), 1);\n182\t    assert_eq!(report.migrated_rows, 1);\n183\t    assert_table_count(&migrator, \"memories\", 1);\n184\t}\n185\t\n186\tfn insert_row(conn: &Connection, id: &str, memory_type: &str, assertion: &str, scope: &str) {\n187\t    insert_memory(conn, id, memory_type, assertion, scope, \"[]\", \"[]\", 0);\n188\t}\n189\t\n190\tfn insert_rich_row(conn: &Connection) {\n191\t    insert_memory(\n192\t        conn,\n193\t        \"rich\",\n194\t        \"anti_pattern\",\n195\t        \"anti_pattern\",\n196\t        \"branch\",\n197\t        r#\"[\"src/lib.rs\"]\"#,\n198\t        r#\"[\"important_symbol\"]\"#,\n199\t        2,\n200\t    );\n201\t    conn.execute(\n202\t        \"UPDATE memories\n203\t         SET evidence_json = ?2, contradicts_memory_ids = ?3, supersedes_memory_id = ?4\n204\t         WHERE id = ?1\",\n205\t        params![\n206\t            \"rich\",\n207\t            r#\"[{\"kind\":\"note\",\"reference\":\"test\",\"captured_at\":12}]\"#,\n208\t            r#\"[\"obs\"]\"#,\n209\t            \"decision\"\n210\t        ],\n211\t    )\n212\t    .expect(\"rich metadata\");\n213\t}\n214\t\n215\tfn insert_bad_row(conn: &Connection) {\n216\t    insert_memory(\n217\t        conn,\n218\t        \"bad\",\n219\t        \"unknown_type\",\n220\t        \"unknown\",\n221\t        \"session\",\n222\t        \"[]\",\n223\t        \"[]\",\n224\t        0,\n225\t    );\n226\t}\n227\t\n228\tfn insert_memory(\n229\t    conn: &Connection,\n230\t    id: &str,\n231\t    memory_type: &str,\n232\t    assertion: &str,\n233\t    scope: &str,\n234\t    linked_files: &str,\n235\t    linked_symbols: &str,\n236\t    access_count: i64,\n237\t) {\n238\t    conn.execute(\n239\t        \"INSERT INTO memories\n240\t            (id, session_id, content, memory_type, scope, confidence, linked_symbols,\n241\t             linked_files, workspace_id, branch, refresh_key, source_query, assertion_type,\n242\t             verification_status, confidence_reason, supersedes_memory_id,\n243\t             superseded_by_memory_id, contradicts_memory_ids, contradicted_by_memory_ids,\n244\t             freshness_policy, freshness_policy_detail, provenance_json, evidence_json,\n245\t             created_at, last_accessed, access_count, is_stale, stale_reason, is_invalidated)\n246\t         VALUES\n247\t            (?1, 'session-a', ?2, ?3, ?4, 0.8, ?5, ?6, 'ws', 'main', NULL,\n248\t             'source query', ?7, 'unverified', NULL, NULL, NULL, '[]', '[]',\n249\t             'session_scoped', NULL, '[]', '[]', 10, 20, ?8, 0, NULL, 0)\",\n250\t        params![\n251\t            id,\n252\t            format!(\"content for {id}\"),\n253\t            memory_type,\n254\t            scope,\n255\t            linked_symbols,\n256\t            linked_files,\n257\t            assertion,\n258\t            access_count,\n259\t        ],\n260\t    )\n261\t    .expect(\"insert legacy row\");\n262\t}\n263\t\n264\tfn assert_table_count(migrator: &MemoryMigrator, table: &str, expected: i64) {\n265\t    let dest = migrator.dest_conn.lock().expect(\"dest lock\");\n266\t    let sql = format!(\"SELECT COUNT(*) FROM {table}\");\n267\t    let count: i64 = dest\n268\t        .query_row(&sql, params![], |row| row.get(0))\n269\t        .expect(\"count\");\n270\t    assert_eq!(count, expected, \"{table}\");\n271\t}\n272\t\n273\tfn delete_conflict(migrator: &MemoryMigrator) {\n274\t    let dest = migrator.dest_conn.lock().expect(\"dest lock\");\n275\t    dest.execute(\n276\t        \"DELETE FROM memories WHERE memory_id = 'memory:ws/conflict'\",\n277\t        params![],\n278\t    )\n279\t    .expect(\"delete conflict\");\n280\t}\n281\t"}]},"parent_tool_use_id":null,"session_id":"97e40997-f38f-4628-bdcd-a9758dda27fa","uuid":"091a7789-e480-48ea-b858-71fba93cfa2e","timestamp":"2026-05-17T07:29:18.874Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/memory_graph/migration_tests.rs","content":"             verification_status, confidence, confidence_reason, freshness_policy_json,\n             validity_conditions_json, invalidation_triggers_json, provenance_event_ids_json,\n             evidence_references_json, linked_files_json, linked_symbols_json, linked_docs_json,\n             linked_tests_json, linked_memories_json, contradiction_links_json,\n             supersession_links_json, access_history_json, usefulness_score,\n             usefulness_score_updated_at, created_at, created_by, updated_at, updated_by,\n             schema_version)\n         VALUES\n            ('memory:ws/conflict', 'preexisting', 'decision', 'decision', 'repo', 'ws',\n             'unverified', 1.0, 'preexisting', '{}', '[]', '[]', '[]', '[]', '[]', '[]',\n             '[]', '[]', '[]', '[]', '[]', '[]', 0.0, 1, 1, 'test', 1, 'test', 1)\",\n        params![],\n    )\n    .expect(\"conflict row\");\n    let migrator = migrator(source, dest, false);\n    let plan = migrator.plan().expect(\"plan\");\n\n    let error = migrator.run(&plan).expect_err(\"conflict\");\n    assert!(matches!(error, MigrationError::IdempotenceConflict { .. }));\n    assert_table_count(&migrator, \"memories\", 1);\n\n    delete_conflict(&migrator);\n    let retry_plan = migrator.plan().expect(\"retry plan\");\n    let retry_report = migrator.run(&retry_plan).expect(\"retry run\");\n    assert_eq!(retry_report.migrated_rows, 2);\n    assert_table_count(&migrator, \"memories\", 2);\n}\n\n#[test]\nfn dry_run_matches_real_report_but_writes_nothing() {\n    let dry_source = legacy_conn();\n    insert_rich_row(&dry_source);\n    let real_source = legacy_conn();\n    insert_rich_row(&real_source);\n    let dry = migrator(dry_source, dest_conn(), true);\n    let real = migrator(real_source, dest_conn(), false);\n\n    let dry_plan = dry.plan().expect(\"dry plan\");\n    let dry_report = dry.run(&dry_plan).expect(\"dry run\");\n    let real_plan = real.plan().expect(\"real plan\");\n    let real_report = real.run(&real_plan).expect(\"real run\");\n\n    assert_eq!(dry_report.migrated_rows, real_report.migrated_rows);\n    assert_eq!(\n        dry_report.destination_inserts,\n        real_report.destination_inserts\n    );\n    assert_table_count(&dry, \"memories\", 0);\n    assert_table_count(&real, \"memories\", 1);\n}\n\n#[test]\nfn unmappable_rows_are_reported_and_do_not_halt_migration() {\n    let source = legacy_conn();\n    insert_bad_row(&source);\n    insert_row(&source, \"obs\", \"observation\", \"observation\", \"session\");\n    let migrator = migrator(source, dest_conn(), false);\n    let plan = migrator.plan().expect(\"plan\");\n    let report = migrator.run(&plan).expect(\"run\");\n\n    assert_eq!(plan.skipped_rows.len(), 1);\n    assert_eq!(report.skipped_rows.len(), 1);\n    assert_eq!(report.migrated_rows, 1);\n    assert_table_count(&migrator, \"memories\", 1);\n}\n\nfn insert_row(conn: &Connection, id: &str, memory_type: &str, assertion: &str, scope: &str) {\n    insert_memory(conn, id, memory_type, assertion, scope, \"[]\", \"[]\", 0);\n}\n\nfn insert_rich_row(conn: &Connection) {\n    insert_memory(\n        conn,\n        \"rich\",\n        \"anti_pattern\",\n        \"anti_pattern\",\n        \"branch\",\n        r#\"[\"src/lib.rs\"]\"#,\n        r#\"[\"important_symbol\"]\"#,\n        2,\n    );\n    conn.execute(\n        \"UPDATE memories\n         SET evidence_json = ?2, contradicts_memory_ids = ?3, supersedes_memory_id = ?4\n         WHERE id = ?1\",\n        params![\n            \"rich\",\n            r#\"[{\"kind\":\"note\",\"reference\":\"test\",\"captured_at\":12}]\"#,\n            r#\"[\"obs\"]\"#,\n            \"decision\"\n        ],\n    )\n    .expect(\"rich metadata\");\n}\n\nfn insert_bad_row(conn: &Connection) {\n    insert_memory(\n        conn,\n        \"bad\",\n        \"unknown_type\",\n        \"unknown\",\n        \"session\",\n        \"[]\",\n        \"[]\",\n        0,\n    );\n}\n\nfn insert_memory(\n    conn: &Connection,\n    id: &str,\n    memory_type: &str,\n    assertion: &str,\n    scope: &str,\n    linked_files: &str,\n    linked_symbols: &str,\n    access_count: i64,\n) {\n    conn.execute(\n        \"INSERT INTO memories\n            (id, session_id, content, memory_type, scope, confidence, linked_symbols,\n             linked_files, workspace_id, branch, refresh_key, source_query, assertion_type,\n             verification_status, confidence_reason, supersedes_memory_id,\n             superseded_by_memory_id, contradicts_memory_ids, contradicted_by_memory_ids,\n             freshness_policy, freshness_policy_detail, provenance_json, evidence_json,\n             created_at, last_accessed, access_count, is_stale, stale_reason, is_invalidated)\n         VALUES\n            (?1, 'session-a', ?2, ?3, ?4, 0.8, ?5, ?6, 'ws', 'main', NULL,\n             'source query', ?7, 'unverified', NULL, NULL, NULL, '[]', '[]',\n             'session_scoped', NULL, '[]', '[]', 10, 20, ?8, 0, NULL, 0)\",\n        params![\n            id,\n            format!(\"content for {id}\"),\n            memory_type,\n            scope,\n            linked_symbols,\n            linked_files,\n            assertion,\n            access_count,\n        ],\n    )\n    .expect(\"insert legacy row\");\n}\n\nfn assert_table_count(migrator: &MemoryMigrator, table: &str, expected: i64) {\n    let dest = migrator.dest_conn.lock().expect(\"dest lock\");\n    let sql = format!(\"SELECT COUNT(*) FROM {table}\");\n    let count: i64 = dest\n        .query_row(&sql, params![], |row| row.get(0))\n        .expect(\"count\");\n    assert_eq!(count, expected, \"{table}\");\n}\n\nfn delete_conflict(migrator: &MemoryMigrator) {\n    let dest = migrator.dest_conn.lock().expect(\"dest lock\");\n    dest.execute(\n        \"DELETE FROM memories WHERE memory_id = 'memory:ws/conflict'\",\n        params![],\n    )\n    .expect(\"delete conflict\");\n}\n","numLines":162,"startLine":120,"totalLines":281}}}
