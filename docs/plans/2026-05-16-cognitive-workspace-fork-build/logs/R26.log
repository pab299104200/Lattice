kTargetKind {\n111\t    pub fn as_str(self) -> &'static str {\n112\t        match self {\n113\t            Self::Memory => \"memory\",\n114\t            Self::File => \"file\",\n115\t            Self::Symbol => \"symbol\",\n116\t            Self::DocSection => \"doc_section\",\n117\t            Self::Test => \"test\",\n118\t        }\n119\t    }\n120\t}\n121\t\n122\timpl FromStr for MemoryLinkTargetKind {\n123\t    type Err = MemoryGraphParseError;\n124\t\n125\t    fn from_str(value: &str) -> Result<Self, Self::Err> {\n126\t        match value {\n127\t            \"memory\" => Ok(Self::Memory),\n128\t            \"file\" => Ok(Self::File),\n129\t            \"symbol\" => Ok(Self::Symbol),\n130\t            \"doc_section\" => Ok(Self::DocSection),\n131\t            \"test\" => Ok(Self::Test),\n132\t            other => Err(MemoryGraphParseError::InvalidJsonColumn {\n133\t                column: \"target_kind\",\n134\t                reason: format!(\"unknown memory link target kind `{other}`\"),\n135\t            }),\n136\t        }\n137\t    }\n138\t}\n139\t\n140\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n141\t#[serde(rename_all = \"snake_case\")]\n142\tpub enum MemoryLinkTarget {\n143\t    Memory(MemoryId),\n144\t    File(FileId),\n145\t    Symbol(SymbolId),\n146\t    DocSection(DocSectionId),\n147\t    Test(TestId),\n148\t}\n149\t\n150\timpl MemoryLinkTarget {\n151\t    fn kind(&self) -> MemoryLinkTargetKind {\n152\t        match self {\n153\t            Self::Memory(_) => MemoryLinkTargetKind::Memory,\n154\t            Self::File(_) => MemoryLinkTargetKind::File,\n155\t            Self::Symbol(_) => MemoryLinkTargetKind::Symbol,\n156\t            Self::DocSection(_) => MemoryLinkTargetKind::DocSection,\n157\t            Self::Test(_) => MemoryLinkTargetKind::Test,\n158\t        }\n159\t    }\n160\t\n161\t    fn encode_id(&self) -> Result<String, MemoryLinkError> {\n162\t        match self {\n163\t            Self::Memory(value) => Ok(encode_identity_text(&Identity::Memory(value.clone()))),\n164\t            Self::File(value) => Ok(encode_identity_text(&Identity::File(value.clone()))),\n165\t            Self::Symbol(value) => Ok(encode_identity_text(&Identity::Symbol(value.clone()))),\n166\t            Self::DocSection(value) => Ok(encode_identity_text(&Identity::Section(value.clone()))),\n167\t            Self::Test(value) => {\n168\t                serde_json::to_string(value).map_err(MemoryLinkError::TargetEncode)\n169\t            }\n170\t        }\n171\t    }\n172\t\n173\t    fn decode(kind: &str, encoded: &str) -> Result<Self, MemoryLinkError> {\n174\t        match MemoryLinkTargetKind::from_str(kind)? {\n175\t            MemoryLinkTargetKind::Memory => match decode_identity_text(encoded, \"target_id\")? {\n176\t                Identity::Memory(value) => Ok(Self::Memory(value)),\n177\t                other => Err(MemoryLinkError::TargetKindMismatch {\n178\t                    expected: \"memory\",\n179\t                    actual: format!(\"{:?}\", other.kind()),\n180\t                }),\n181\t            },\n182\t            MemoryLinkTargetKind::File => match decode_identity_text(encoded, \"target_id\")? {\n183\t                Identity::File(value) => Ok(Self::File(value)),\n184\t                other => Err(MemoryLinkError::TargetKindMismatch {\n185\t                    expected: \"file\",\n186\t                    actual: format!(\"{:?}\", other.kind()),\n187\t                }),\n188\t            },\n189\t            MemoryLinkTargetKind::Symbol => match decode_identity_text(encoded, \"target_id\")? {\n190\t                Identity::Symbol(value) => Ok(Self::Symbol(value)),\n191\t                other => Err(MemoryLinkError::TargetKindMismatch {\n192\t                    expected: \"symbol\",\n193\t                    actual: format!(\"{:?}\", other.kind()),\n194\t                }),\n195\t            },\n196\t            MemoryLinkTargetKind::DocSection => match decode_identity_text(encoded, \"target_id\")? {\n197\t                Identity::Section(value) => Ok(Self::DocSection(value)),\n198\t                other => Err(MemoryLinkError::TargetKindMismatch {\n199\t                    expected: \"doc_section\",\n200\t                    actual: format!(\"{:?}\", other.kind()),\n201\t                }),\n202\t            },\n203\t            MemoryLinkTargetKind::Test => serde_json::from_str(encoded)\n204\t                .map(Self::Test)\n205\t                .map_err(MemoryLinkError::TargetDecode),\n206\t        }\n207\t    }\n208\t}\n209\t\n210\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n211\tpub struct MemoryLink {\n212\t    pub link_id: MemoryLinkId,\n213\t    pub source: MemoryId,\n214\t    pub target: MemoryLinkTarget,\n215\t    pub link_type: MemoryLinkType,\n216\t    pub strength: f32,\n217\t    pub reason: String,\n218\t    pub evidence_event_id: Option<crate::identity::EventId>,\n219\t    pub created_by: Actor,\n220\t    pub created_at: DateTime<Utc>,\n221\t    pub verification_status: VerificationStatus,\n222\t}\n223\t\n224\timpl MemoryLink {\n225\t    pub fn try_new(\n226\t        link_id: MemoryLinkId,\n227\t        source: MemoryId,\n228\t        target: MemoryLinkTarget,\n229\t        link_type: MemoryLinkType,\n230\t        strength: f32,\n231\t        reason: String,\n232\t        evidence_event_id: Option<crate::identity::EventId>,\n233\t        created_by: Actor,\n234\t        created_at: DateTime<Utc>,\n235\t        verification_status: VerificationStatus,\n236\t    ) -> Result<Self, MemoryLinkError> {\n237\t        validate_strength(strength)?;\n238\t        Ok(Self {\n239\t            link_id,\n240\t            source,\n241\t            target,\n242\t            link_type,\n243\t            strength,\n244\t            reason,\n245\t            evidence_event_id,\n246\t            created_by,\n247\t            created_at,\n248\t            verification_status,\n249\t        })\n250\t    }\n251\t}\n252\t\n253\t#[derive