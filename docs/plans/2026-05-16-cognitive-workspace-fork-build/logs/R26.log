{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015pjXnSN6kogqVAtKmKzVyP","type":"tool_result","content":"1\t//! Cross-layer contract tests for identity ↔ event log ↔ memory graph.\n2\t//!\n3\t//! Each test in this module pins one boundary in the three-substrate round\n4\t//! trip enumerated by `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## Design Thesis`:\n6\t//!\n7\t//! 1. Identity references serialize cleanly into event payloads.\n8\t//! 2. Event payloads round-trip back to identity targets through the reader.\n9\t//! 3. Memory links reference stable identities, not transient names.\n10\t//! 4. Memory evidence anchors carry typed identities, not path/heading\n11\t//!    strings.\n12\t//! 5. Migration preserves identity references (no path strings survive).\n13\t//! 6. Event capture records identity-typed references.\n14\t//! 7. Replay preserves identity-resolvable evidence anchors.\n15\t//! 8. Schema-level columns that hold identities are constrained to the typed\n16\t//!    shape.\n17\t//!\n18\t//! Verification of these contracts is what R26 — the Phase-3 ↔ Phase-1\n19\t//! contract gate — certifies before Phase 4 retrieval begins.\n20\t\n21\tuse std::collections::HashMap;\n22\tuse std::sync::{Arc, Mutex};\n23\t\n24\tuse rusqlite::Connection;\n25\tuse serde_json::Value;\n26\tuse tempfile::TempDir;\n27\t\n28\tuse crate::events::{\n29\t    Actor, BranchRef, CompactSummary, ContextBundleReturnedPayload, DiagnosticObservedPayload,\n30\t    DiagnosticSeverity, EventEnvelope, EventKind, EventPayload, EventQuery, EventReader,\n31\t    EventStore, EventWriter, FileReadPayload, FlushPolicy, MemoryRetrievedPayload,\n32\t    PartialEnvelope, PatchAppliedPayload, QueryOrder, SessionId, StableRef,\n33\t};\n34\tuse crate::graph::CodeGraph;\n35\tuse crate::identity::{\n36\t    decode_identity, encode_identity, ContextHandleId, DocId, EventId, FileId, Identity,\n37\t    IdentityResolver, MemoryId, SectionId, SymbolId,\n38\t};\n39\tuse crate::memory_graph::store::MemoryScopeState;\n40\tuse crate::memory_graph::{\n41\t    get_evidence_for, get_links_from, initialize_schema, insert_link, replay_events,\n42\t    AssertionType, EvidenceAnchor, FreshnessKind, FreshnessPolicy, IdempotencyKey, MemoryClass,\n43\t    MemoryDraft, MemoryEvidence, MemoryEvidenceId, MemoryLink, MemoryLinkId, MemoryLinkTarget,\n44\t    MemoryLinkType, MemoryMigrator, MemoryScope, MemoryStore,\n45\t};\n46\tuse crate::parser::parse_file;\n47\tuse crate::storage::graph_store::{\n48\t    FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n49\t};\n50\tuse crate::DateTime;\n51\t\n52\tconst WORKSPACE: &str = \"workspace\";\n53\tconst BRANCH: &str = \"main\";\n54\tconst SESSION: &str = \"contract-session\";\n55\t\n56\t// ---------------------------------------------------------------------------\n57\t// Helpers\n58\t// ---------------------------------------------------------------------------\n59\t\n60\tfn file_identity(path: &str) -> FileId {\n61\t    FileId {\n62\t        workspace_id: WORKSPACE.to_string(),\n63\t        repo_relative_path: path.to_string(),\n64\t        content_hash: \"feedface00000001\".to_string(),\n65\t    }\n66\t}\n67\t\n68\tfn doc_identity(path: &str) -> DocId {\n69\t    DocId {\n70\t        workspace_id: WORKSPACE.to_string(),\n71\t        repo_relative_path: path.to_string(),\n72\t        content_hash: \"deadbeef00000002\".to_string(),\n73\t    }\n74\t}\n75\t\n76\tfn section_identity(path: &str, heading: &str) -> SectionId {\n77\t    SectionId {\n78\t        doc: doc_identity(path),\n79\t        heading_path: vec![heading.to_string()],\n80\t        byte_offset: 64,\n81\t    }\n82\t}\n83\t\n84\tfn symbol_identity(file: &FileId, qualified: &str) -> SymbolId {\n85\t    SymbolId {\n86\t        file: file.clone(),\n87\t        qualified_name: qualified.to_string(),\n88\t        byte_offset: 12,\n89\t        kind: \"function\".to_string(),\n90\t    }\n91\t}\n92\t\n93\tfn context_handle_identity(seed: &str) -> ContextHandleId {\n94\t    ContextHandleId {\n95\t        workspace_id: WORKSPACE.to_string(),\n96\t        session_id: SESSION.to_string(),\n97\t        ulid: stable_ulid(seed),\n98\t    }\n99\t}\n100\t\n101\tfn memory_identity(seed: &str) -> MemoryId {\n102\t    MemoryId {\n103\t        workspace_id: WORKSPACE.to_string(),\n104\t        ulid: stable_ulid(seed),\n105\t    }\n106\t}\n107\t\n108\tfn stable_ulid(seed: &str) -> String {\n109\t    const ALPHABET: &[u8; 32] = b\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\n110\t    let mut bytes = [b'0'; 26];\n111\t    bytes[..24].copy_from_slice(b\"01ARZ3NDEKTSV4RRFFQ69G5F\");\n112\t    let checksum = seed.bytes().fold(0_u32, |acc, byte| {\n113\t        acc.wrapping_mul(33).wrapping_add(u32::from(byte))\n114\t    });\n115\t    bytes[24] = ALPHABET[((checksum >> 5) & 31) as usize];\n116\t    bytes[25] = ALPHABET[(checksum & 31) as usize];\n117\t    String::from_utf8(bytes.to_vec()).expect(\"stable ULID is valid ASCII\")\n118\t}\n119\t\n120\tfn branch_scope_state() -> MemoryScopeState {\n121\t    MemoryScopeState {\n122\t        scope: MemoryScope::Branch,\n123\t        scope_session_id: None,\n124\t        scope_branch: Some(BRANCH.to_string()),\n125\t        scope_workspace_id: Some(WORKSPACE.to_string()),\n126\t        scope_user_id: None,\n127\t        scope_org_id: None,\n128\t    }\n129\t}\n130\t\n131\tfn idem(value: &str) -> IdempotencyKey {\n132\t    IdempotencyKey::new(value.to_string()).expect(\"idempotency key\")\n133\t}\n134\t\n135\t/// In-process collaborator wiring that mirrors `memory_graph::tests_common`\n136\t/// but lives inside `contract_tests` so the cross-layer surface is exercised\n137\t/// without re-exporting a private test helper.\n138\tstruct ContractHarness {\n139\t    _tempdir: TempDir,\n140\t    conn: Arc<Mutex<Connection>>,\n141\t    event_store: Arc<EventStore>,\n142\t    store: MemoryStore,\n143\t}\n144\t\n145\timpl ContractHarness {\n146\t    fn new() -> Self {\n147\t        let tempdir = TempDir::new().expect(\"contract tempdir\");\n148\t        let conn = Connection::open(tempdir.path().join(\"memory-graph.db\"))\n149\t            .expect(\"memory graph DB opens\");\n150\t        conn.execute_batch(\"PRAGMA foreign_keys = ON;\")\n151\t            .expect(\"foreign keys enable\");\n152\t        initialize_schema(&conn).expect(\"memory graph schema initializes\");\n153\t        let conn = Arc::new(Mutex::new(conn));\n154\t        let event_store = Arc::new(\n155\t            EventStore::open(&tempdir.path().join(\"events.db\")).expect(\"event store opens\"),\n156\t        );\n157\t        let writer = Arc::new(\n158\t            EventWriter::new(event_store.clone(), WORKSPACE.to_string(), 4096)\n159\t                .with_flush_policy(FlushPolicy::Sync),\n160\t        );\n161\t        let store = MemoryStore::open(conn.clone(), writer);\n162\t        Self {\n163\t            _tempdir: tempdir,\n164\t            conn,\n165\t            event_store,\n166\t            store,\n167\t        }\n168\t    }\n169\t\n170\t    fn conn(&self) -> std::sync::MutexGuard<'_, Connection> {\n171\t        self.conn.lock().expect(\"contract harness DB lock\")\n172\t    }\n173\t\n174\t    fn writer(&self) -> EventWriter {\n175\t        EventWriter::new(self.event_store.clone(), WORKSPACE.to_string(), 4096)\n176\t            .with_flush_policy(FlushPolicy::Sync)\n177\t    }\n178\t\n179\t    fn reader(&self) -> EventReader {\n180\t        EventReader::new(self.event_store.clone())\n181\t    }\n182\t\n183\t    fn all_memory_events(&self) -> Vec<EventEnvelope> {\n184\t        self.reader()\n185\t            .execute(\n186\t                EventQuery::new()\n187\t                    .session(\"memory-graph\")\n188\t                    .workspace(WORKSPACE)\n189\t                    .branch(BRANCH)\n190\t                    .order(QueryOrder::OldestFirst)\n191\t                    .limit(200),\n192\t            )\n193\t            .expect(\"memory graph events load\")\n194\t    }\n195\t}\n196\t\n197\tfn append_event(writer: &EventWriter, partial: PartialEnvelope) -> EventId {\n198\t    writer.append(partial).expect(\"event appends\")\n199\t}\n200\t\n201\tfn read_back(reader: &EventReader, event_id: &EventId) -> EventEnvelope {\n202\t    let envelopes = reader\n203\t        .execute(\n204\t            EventQuery::new()\n205\t                .workspace(WORKSPACE)\n206\t                .branch(BRANCH)\n207\t                .order(QueryOrder::OldestFirst)\n208\t                .limit(100),\n209\t        )\n210\t        .expect(\"workspace-scoped read succeeds\");\n211\t    envelopes\n212\t        .into_iter()\n213\t        .find(|envelope| envelope.event_id == *event_id)\n214\t        .expect(\"appended event is visible to the reader\")\n215\t}\n216\t\n217\tfn seed_draft(file: &FileId, symbol: &SymbolId, section: &SectionId) -> MemoryDraft {\n218\t    MemoryDraft {\n219\t        content: \"round-trip seed\".to_string(),\n220\t        class: MemoryClass::Observation,\n221\t        assertion_type: AssertionType::Observation,\n222\t        scope: branch_scope_state(),\n223\t        confidence: 0.8,\n224\t        confidence_reason: \"contract seed\".to_string(),\n225\t        freshness_policy: FreshnessPolicy {\n226\t            kind: FreshnessKind::BranchScoped,\n227\t            ttl: None,\n228\t            recheck_interval: None,\n229\t        },\n230\t        validity_conditions: Vec::new(),\n231\t        invalidation_triggers: Vec::new(),\n232\t        provenance_event_ids: Vec::new(),\n233\t        evidence_references: Vec::new(),\n234\t        linked_files: vec![file.clone()],\n235\t        linked_symbols: vec![symbol.clone()],\n236\t        linked_docs: vec![section.clone()],\n237\t        linked_tests: Vec::new(),\n238\t        linked_memories: Vec::new(),\n239\t        contradiction_links: Vec::new(),\n240\t        supersession_links: Vec::new(),\n241\t        access_history: Vec::new(),\n242\t        created_by: \"assistant\".to_string(),\n243\t        updated_by: \"assistant\".to_string(),\n244\t        superseded_by: None,\n245\t        schema_version: 1,\n246\t        initial_evidence: vec![file_span_evidence(file)],\n247\t    }\n248\t}\n249\t\n250\tfn file_span_evidence(file: &FileId) -> MemoryEvidence {\n251\t    MemoryEvidence {\n252\t        evidence_id: MemoryEvidenceId(String::new()),\n253\t        memory_id: memory_identity(\"placeholder\"),\n254\t        event_id: None,\n255\t        anchor: EvidenceAnchor::FileSpan {\n256\t            file: file.clone(),\n257\t            byte_start: 0,\n258\t            byte_end: 32,\n259\t            sha256: [0_u8; 32],\n260\t        },\n261\t        captured_at: DateTime::from_unix_seconds(1_700_000_000),\n262\t        captured_by: Actor::Daemon,\n263\t    }\n264\t}\n265\t\n266\tfn doc_section_evidence(section: &SectionId) -> MemoryEvidence {\n267\t    MemoryEvidence {\n268\t        evidence_id: MemoryEvidenceId(String::new()),\n269\t        memory_id: memory_identity(\"placeholder\"),\n270\t        event_id: None,\n271\t        anchor: EvidenceAnchor::DocSection {\n272\t            id: section.clone(),\n273\t            sha256: [1_u8; 32],\n274\t        },\n275\t        captured_at: DateTime::from_unix_seconds(1_700_000_010),\n276\t        captured_by: Actor::Daemon,\n277\t    }\n278\t}\n279\t\n280\tfn legacy_source_conn() -> Connection {\n281\t    let conn = Connection::open_in_memory().expect(\"legacy source DB\");\n282\t    conn.execute_batch(\n283\t        \"CREATE TABLE memories (\n284\t            id TEXT PRIMARY KEY,\n285\t            session_id TEXT NOT NULL DEFAULT '',\n286\t            content TEXT NOT NULL,\n287\t            memory_type TEXT NOT NULL,\n288\t            scope TEXT NOT NULL DEFAULT 'session',\n289\t            confidence REAL NOT NULL DEFAULT 1.0,\n290\t            linked_symbols TEXT NOT NULL DEFAULT '[]',\n291\t            linked_files TEXT NOT NULL DEFAULT '[]',\n292\t            workspace_id TEXT,\n293\t            branch TEXT,\n294\t            refresh_key TEXT,\n295\t            source_query TEXT,\n296\t            assertion_type TEXT NOT NULL DEFAULT 'observation',\n297\t            verification_status TEXT NOT NULL DEFAULT 'unverified',\n298\t            confidence_reason TEXT,\n299\t            supersedes_memory_id TEXT,\n300\t            superseded_by_memory_id TEXT,\n301\t            contradicts_memory_ids TEXT NOT NULL DEFAULT '[]',\n302\t            contradicted_by_memory_ids TEXT NOT NULL DEFAULT '[]',\n303\t            freshness_policy TEXT NOT NULL DEFAULT 'session_scoped',\n304\t            freshness_policy_detail TEXT,\n305\t            provenance_json TEXT NOT NULL DEFAULT '[]',\n306\t            evidence_json TEXT NOT NULL DEFAULT '[]',\n307\t            created_at INTEGER NOT NULL,\n308\t            last_accessed INTEGER NOT NULL,\n309\t            access_count INTEGER NOT NULL DEFAULT 0,\n310\t            is_stale INTEGER NOT NULL DEFAULT 0,\n311\t            stale_reason TEXT,\n312\t            is_invalidated INTEGER NOT NULL DEFAULT 0\n313\t        );\",\n314\t    )\n315\t    .expect(\"legacy schema\");\n316\t    conn\n317\t}\n318\t\n319\tfn insert_legacy_row(conn: &Connection, id: &str, linked_files_json: &str) {\n320\t    conn.execute(\n321\t        \"INSERT INTO memories\n322\t            (id, session_id, content, memory_type, scope, confidence, linked_symbols,\n323\t             linked_files, workspace_id, branch, refresh_key, source_query, assertion_type,\n324\t             verification_status, confidence_reason, supersedes_memory_id,\n325\t             superseded_by_memory_id, contradicts_memory_ids, contradicted_by_memory_ids,\n326\t             freshness_policy, freshness_policy_detail, provenance_json, evidence_json,\n327\t             created_at, last_accessed, access_count, is_stale, stale_reason, is_invalidated)\n328\t         VALUES\n329\t            (?1, 'legacy-session', ?2, 'observation', 'repo', 0.7, '[]', ?3, ?4, 'main',\n330\t             NULL, NULL, 'observation', 'unverified', NULL, NULL, NULL,\n331\t             '[]', '[]', 'repo_scoped', NULL, '[]', '[]', 1700000000, 1700000000, 0, 0, NULL, 0)\",\n332\t        rusqlite::params![id, format!(\"memory {id}\"), linked_files_json, WORKSPACE],\n333\t    )\n334\t    .expect(\"legacy row inserts\");\n335\t}\n336\t\n337\t// ---------------------------------------------------------------------------\n338\t// SURFACE 1 — identity references serialize cleanly into event payloads\n339\t// ---------------------------------------------------------------------------\n340\t"}]},"parent_tool_use_id":null,"session_id":"97e40997-f38f-4628-bdcd-a9758dda27fa","uuid":"d95bd1e9-25e4-4025-9c10-2284a4a56fd1","timestamp":"2026-05-17T07:38:56.141Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/contract_tests/identity_event_memory.rs","content":"//! Cross-layer contract tests for identity ↔ event log ↔ memory graph.\n//!\n//! Each test in this module pins one boundary in the three-substrate round\n//! trip enumerated by `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Design Thesis`:\n//!\n//! 1. Identity references serialize cleanly into event payloads.\n//! 2. Event payloads round-trip back to identity targets through the reader.\n//! 3. Memory links reference stable identities, not transient names.\n//! 4. Memory evidence anchors carry typed identities, not path/heading\n//!    strings.\n//! 5. Migration preserves identity references (no path strings survive).\n//! 6. Event capture records identity-typed references.\n//! 7. Replay preserves identity-resolvable evidence anchors.\n//! 8. Schema-level columns that hold identities are constrained to the typed\n//!    shape.\n//!\n//! Verification of these contracts is what R26 — the Phase-3 ↔ Phase-1\n//! contract gate — certifies before Phase 4 retrieval begins.\n\nuse std::collections::HashMap;\nuse std::sync::{Arc, Mutex};\n\nuse rusqlite::Connection;\nuse serde_json::Value;\nuse tempfile::TempDir;\n\nuse crate::events::{\n    Actor, BranchRef, CompactSummary, ContextBundleReturnedPayload, DiagnosticObservedPayload,\n    DiagnosticSeverity, EventEnvelope, EventKind, EventPayload, EventQuery, EventReader,\n    EventStore, EventWriter, FileReadPayload, FlushPolicy, MemoryRetrievedPayload,\n    PartialEnvelope, PatchAppliedPayload, QueryOrder, SessionId, StableRef,\n};\nuse crate::graph::CodeGraph;\nuse crate::identity::{\n    decode_identity, encode_identity, ContextHandleId, DocId, EventId, FileId, Identity,\n    IdentityResolver, MemoryId, SectionId, SymbolId,\n};\nuse crate::memory_graph::store::MemoryScopeState;\nuse crate::memory_graph::{\n    get_evidence_for, get_links_from, initialize_schema, insert_link, replay_events,\n    AssertionType, EvidenceAnchor, FreshnessKind, FreshnessPolicy, IdempotencyKey, MemoryClass,\n    MemoryDraft, MemoryEvidence, MemoryEvidenceId, MemoryLink, MemoryLinkId, MemoryLinkTarget,\n    MemoryLinkType, MemoryMigrator, MemoryScope, MemoryStore,\n};\nuse crate::parser::parse_file;\nuse crate::storage::graph_store::{\n    FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n};\nuse crate::DateTime;\n\nconst WORKSPACE: &str = \"workspace\";\nconst BRANCH: &str = \"main\";\nconst SESSION: &str = \"contract-session\";\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\nfn file_identity(path: &str) -> FileId {\n    FileId {\n        workspace_id: WORKSPACE.to_string(),\n        repo_relative_path: path.to_string(),\n        content_hash: \"feedface00000001\".to_string(),\n    }\n}\n\nfn doc_identity(path: &str) -> DocId {\n    DocId {\n        workspace_id: WORKSPACE.to_string(),\n        repo_relative_path: path.to_string(),\n        content_hash: \"deadbeef00000002\".to_string(),\n    }\n}\n\nfn section_identity(path: &str, heading: &str) -> SectionId {\n    SectionId {\n        doc: doc_identity(path),\n        heading_path: vec![heading.to_string()],\n        byte_offset: 64,\n    }\n}\n\nfn symbol_identity(file: &FileId, qualified: &str) -> SymbolId {\n    SymbolId {\n        file: file.clone(),\n        qualified_name: qualified.to_string(),\n        byte_offset: 12,\n        kind: \"function\".to_string(),\n    }\n}\n\nfn context_handle_identity(seed: &str) -> ContextHandleId {\n    ContextHandleId {\n        workspace_id: WORKSPACE.to_string(),\n        session_id: SESSION.to_string(),\n        ulid: stable_ulid(seed),\n    }\n}\n\nfn memory_identity(seed: &str) -> MemoryId {\n    MemoryId {\n        workspace_id: WORKSPACE.to_string(),\n        ulid: stable_ulid(seed),\n    }\n}\n\nfn stable_ulid(seed: &str) -> String {\n    const ALPHABET: &[u8; 32] = b\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\n    let mut bytes = [b'0'; 26];\n    bytes[..24].copy_from_slice(b\"01ARZ3NDEKTSV4RRFFQ69G5F\");\n    let checksum = seed.bytes().fold(0_u32, |acc, byte| {\n        acc.wrapping_mul(33).wrapping_add(u32::from(byte))\n    });\n    bytes[24] = ALPHABET[((checksum >> 5) & 31) as usize];\n    bytes[25] = ALPHABET[(checksum & 31) as usize];\n    String::from_utf8(bytes.to_vec()).expect(\"stable ULID is valid ASCII\")\n}\n\nfn branch_scope_state() -> MemoryScopeState {\n    MemoryScopeState {\n        scope: MemoryScope::Branch,\n        scope_session_id: None,\n        scope_branch: Some(BRANCH.to_string()),\n        scope_workspace_id: Some(WORKSPACE.to_string()),\n        scope_user_id: None,\n        scope_org_id: None,\n    }\n}\n\nfn idem(value: &str) -> IdempotencyKey {\n    IdempotencyKey::new(value.to_string()).expect(\"idempotency key\")\n}\n\n/// In-process collaborator wiring that mirrors `memory_graph::tests_common`\n/// but lives inside `contract_tests` so the cross-layer surface is exercised\n/// without re-exporting a private test helper.\nstruct ContractHarness {\n    _tempdir: TempDir,\n    conn: Arc<Mutex<Connection>>,\n    event_store: Arc<EventStore>,\n    store: MemoryStore,\n}\n\nimpl ContractHarness {\n    fn new() -> Self {\n        let tempdir = TempDir::new().expect(\"contract tempdir\");\n        let conn = Connection::open(tempdir.path().join(\"memory-graph.db\"))\n            .expect(\"memory graph DB opens\");\n        conn.execute_batch(\"PRAGMA foreign_keys = ON;\")\n            .expect(\"foreign keys enable\");\n        initialize_schema(&conn).expect(\"memory graph schema initializes\");\n        let conn = Arc::new(Mutex::new(conn));\n        let event_store = Arc::new(\n            EventStore::open(&tempdir.path().join(\"events.db\")).expect(\"event store opens\"),\n        );\n        let writer = Arc::new(\n            EventWriter::new(event_store.clone(), WORKSPACE.to_string(), 4096)\n                .with_flush_policy(FlushPolicy::Sync),\n        );\n        let store = MemoryStore::open(conn.clone(), writer);\n        Self {\n            _tempdir: tempdir,\n            conn,\n            event_store,\n            store,\n        }\n    }\n\n    fn conn(&self) -> std::sync::MutexGuard<'_, Connection> {\n        self.conn.lock().expect(\"contract harness DB lock\")\n    }\n\n    fn writer(&self) -> EventWriter {\n        EventWriter::new(self.event_store.clone(), WORKSPACE.to_string(), 4096)\n            .with_flush_policy(FlushPolicy::Sync)\n    }\n\n    fn reader(&self) -> EventReader {\n        EventReader::new(self.event_store.clone())\n    }\n\n    fn all_memory_events(&self) -> Vec<EventEnvelope> {\n        self.reader()\n            .execute(\n                EventQuery::new()\n                    .session(\"memory-graph\")\n                    .workspace(WORKSPACE)\n                    .branch(BRANCH)\n                    .order(QueryOrder::OldestFirst)\n                    .limit(200),\n            )\n            .expect(\"memory graph events load\")\n    }\n}\n\nfn append_event(writer: &EventWriter, partial: PartialEnvelope) -> EventId {\n    writer.append(partial).expect(\"event appends\")\n}\n\nfn read_back(reader: &EventReader, event_id: &EventId) -> EventEnvelope {\n    let envelopes = reader\n        .execute(\n            EventQuery::new()\n                .workspace(WORKSPACE)\n                .branch(BRANCH)\n                .order(QueryOrder::OldestFirst)\n                .limit(100),\n        )\n        .expect(\"workspace-scoped read succeeds\");\n    envelopes\n        .into_iter()\n        .find(|envelope| envelope.event_id == *event_id)\n        .expect(\"appended event is visible to the reader\")\n}\n\nfn seed_draft(file: &FileId, symbol: &SymbolId, section: &SectionId) -> MemoryDraft {\n    MemoryDraft {\n        content: \"round-trip seed\".to_string(),\n        class: MemoryClass::Observation,\n        assertion_type: AssertionType::Observation,\n        scope: branch_scope_state(),\n        confidence: 0.8,\n        confidence_reason: \"contract seed\".to_string(),\n        freshness_policy: FreshnessPolicy {\n            kind: FreshnessKind::BranchScoped,\n            ttl: None,\n            recheck_interval: None,\n        },\n        validity_conditions: Vec::new(),\n        invalidation_triggers: Vec::new(),\n        provenance_event_ids: Vec::new(),\n        evidence_references: Vec::new(),\n        linked_files: vec![file.clone()],\n        linked_symbols: vec![symbol.clone()],\n        linked_docs: vec![section.clone()],\n        linked_tests: Vec::new(),\n        linked_memories: Vec::new(),\n        contradiction_links: Vec::new(),\n        supersession_links: Vec::new(),\n        access_history: Vec::new(),\n        created_by: \"assistant\".to_string(),\n        updated_by: \"assistant\".to_string(),\n        superseded_by: None,\n        schema_version: 1,\n        initial_evidence: vec![file_span_evidence(file)],\n    }\n}\n\nfn file_span_evidence(file: &FileId) -> MemoryEvidence {\n    MemoryEvidence {\n        evidence_id: MemoryEvidenceId(String::new()),\n        memory_id: memory_identity(\"placeholder\"),\n        event_id: None,\n        anchor: EvidenceAnchor::FileSpan {\n            file: file.clone(),\n            byte_start: 0,\n            byte_end: 32,\n            sha256: [0_u8; 32],\n        },\n        captured_at: DateTime::from_unix_seconds(1_700_000_000),\n        captured_by: Actor::Daemon,\n    }\n}\n\nfn doc_section_evidence(section: &SectionId) -> MemoryEvidence {\n    MemoryEvidence {\n        evidence_id: MemoryEvidenceId(String::new()),\n        memory_id: memory_identity(\"placeholder\"),\n        event_id: None,\n        anchor: EvidenceAnchor::DocSection {\n            id: section.clone(),\n            sha256: [1_u8; 32],\n        },\n        captured_at: DateTime::from_unix_seconds(1_700_000_010),\n        captured_by: Actor::Daemon,\n    }\n}\n\nfn legacy_source_conn() -> Connection {\n    let conn = Connection::open_in_memory().expect(\"legacy source DB\");\n    conn.execute_batch(\n        \"CREATE TABLE memories (\n            id TEXT PRIMARY KEY,\n            session_id TEXT NOT NULL DEFAULT '',\n            content TEXT NOT NULL,\n            memory_type TEXT NOT NULL,\n            scope TEXT NOT NULL DEFAULT 'session',\n            confidence REAL NOT NULL DEFAULT 1.0,\n            linked_symbols TEXT NOT NULL DEFAULT '[]',\n            linked_files TEXT NOT NULL DEFAULT '[]',\n            workspace_id TEXT,\n            branch TEXT,\n            refresh_key TEXT,\n            source_query TEXT,\n            assertion_type TEXT NOT NULL DEFAULT 'observation',\n            verification_status TEXT NOT NULL DEFAULT 'unverified',\n            confidence_reason TEXT,\n            supersedes_memory_id TEXT,\n            superseded_by_memory_id TEXT,\n            contradicts_memory_ids TEXT NOT NULL DEFAULT '[]',\n            contradicted_by_memory_ids TEXT NOT NULL DEFAULT '[]',\n            freshness_policy TEXT NOT NULL DEFAULT 'session_scoped',\n            freshness_policy_detail TEXT,\n            provenance_json TEXT NOT NULL DEFAULT '[]',\n            evidence_json TEXT NOT NULL DEFAULT '[]',\n            created_at INTEGER NOT NULL,\n            last_accessed INTEGER NOT NULL,\n            access_count INTEGER NOT NULL DEFAULT 0,\n            is_stale INTEGER NOT NULL DEFAULT 0,\n            stale_reason TEXT,\n            is_invalidated INTEGER NOT NULL DEFAULT 0\n        );\",\n    )\n    .expect(\"legacy schema\");\n    conn\n}\n\nfn insert_legacy_row(conn: &Connection, id: &str, linked_files_json: &str) {\n    conn.execute(\n        \"INSERT INTO memories\n            (id, session_id, content, memory_type, scope, confidence, linked_symbols,\n             linked_files, workspace_id, branch, refresh_key, source_query, assertion_type,\n             verification_status, confidence_reason, supersedes_memory_id,\n             superseded_by_memory_id, contradicts_memory_ids, contradicted_by_memory_ids,\n             freshness_policy, freshness_policy_detail, provenance_json, evidence_json,\n             created_at, last_accessed, access_count, is_stale, stale_reason, is_invalidated)\n         VALUES\n            (?1, 'legacy-session', ?2, 'observation', 'repo', 0.7, '[]', ?3, ?4, 'main',\n             NULL, NULL, 'observation', 'unverified', NULL, NULL, NULL,\n             '[]', '[]', 'repo_scoped', NULL, '[]', '[]', 1700000000, 1700000000, 0, 0, NULL, 0)\",\n        rusqlite::params![id, format!(\"memory {id}\"), linked_files_json, WORKSPACE],\n    )\n    .expect(\"legacy row inserts\");\n}\n\n// ---------------------------------------------------------------------------\n// SURFACE 1 — identity references serialize cleanly into event payloads\n// ---------------------------------------------------------------------------\n","numLines":340,"startLine":1,"totalLines":1305}}}
