at!(\"{:?}\", node.kind).to_lowercase()),\n569\t        })\n570\t    }\n571\t\n572\t    fn stored_path_for_doc(&self, workspace: &WorkspaceId, doc: &DocId) -> Option<String> {\n573\t        self.file_index.keys().find_map(|stored_path| {\n574\t            let relative_path = self.relative_path_in_workspace(workspace, stored_path)?;\n575\t            if relative_path == doc.repo_relative_path {\n576\t                Some(stored_path.clone())\n577\t            } else {\n578\t                None\n579\t            }\n580\t        })\n581\t    }\n582\t\n583\t    fn relative_path_in_workspace(\n584\t        &self,\n585\t        workspace: &WorkspaceId,\n586\t        stored_path: &str,\n587\t    ) -> Option<String> {\n588\t        let normalized = normalize_path(stored_path);\n589\t        let prefix = format!(\"{workspace}/\");\n590\t        if normalized == *workspace {\n591\t            return Some(String::new());\n592\t        }\n593\t        if let Some(stripped) = normalized.strip_prefix(&prefix) {\n594\t            return Some(stripped.to_string());\n595\t        }\n596\t        if workspace == &self.default_workspace && !self.is_namespaced_path(&normalized) {\n597\t            return Some(normalized);\n598\t        }\n599\t        None\n600\t    }\n601\t\n602\t    fn is_namespaced_path(&self, path: &str) -> bool {\n603\t        let first_segment = path.split('/').next().unwrap_or(path);\n604\t        first_segment == self.default_workspace\n605\t            || self\n606\t                .file_index\n607\t                .keys()\n608\t                .filter_map(|item| normalize_path(item).split('/').next().map(str::to_string))\n609\t                .any(|segment| segment == first_segment)\n610\t    }\n611\t\n612\t    fn resolve_file_identity_compat(\n613\t        &self,\n614\t        workspace: &WorkspaceId,\n615\t        query: &str,\n616\t    ) -> Result<Option<FileId>, ResolveError> {\n617\t        let Ok(identity) = decode_identity(query) else {\n618\t            return Ok(None);\n619\t        };\n620\t        let Identity::File(file_id) = identity else {\n621\t            return Ok(None);\n622\t        };\n623\t        if file_id.workspace_id != *workspace {\n624\t            return Err(ResolveError::NotFound {\n625\t                kind: \"file\",\n626\t                query: file_id.to_string(),\n627\t            });\n628\t        }\n629\t        if let Some(current) = self.find_current_file_by_hash(workspace, &file_id) {\n630\t            return Ok(Some(current));\n631\t        }\n632\t        Err(ResolveError::NotFound {\n633\t            kind: \"file\",\n634\t            query: query.to_string(),\n635\t        })\n636\t    }\n637\t\n638\t    fn find_current_file_by_hash(\n639\t        &self,\n640\t        workspace: &WorkspaceId,\n641\t        legacy: &FileId,\n642\t    ) -> Option<FileId> {\n643\t        let mut matches = self\n644\t            .file_index\n645\t            .iter()\n646\t            .filter(|(stored_path, entry)| {\n647\t                entry.content_hash == legacy.content_hash\n648\t                    && self\n649\t                        .relative_path_in_workspace(workspace, stored_path)\n650\t                        .is_some()\n651\t            })\n652\t            .filter_map(|(stored_path, _)| {\n653\t                self.file_id_for_stored_path(workspace, stored_path).ok()\n654\t            })\n655\t            .collect::<Vec<_>>();\n656\t        if matches.len() == 1 {\n657\t            return matches.pop();\n658\t        }\n659\t        matches\n660\t            .into_iter()\n661\t            .find(|candidate| candidate.repo_relative_path == legacy.repo_relative_path)\n662\t    }\n663\t}\n664\t\n665\tfn unique_or_ambiguous_symbol(query: &str, candidates: Vec<SymbolId>) -> ResolveOutcome<SymbolId> {\n666\t    match candidates.len() {\n667\t        0 => ResolveOutcome::NotFound(ResolveError::NotFound {\n668\t            kind: \"symbol\",\n669\t            query: query.to_string(),\n670\t        }),\n671\t        1 => ResolveOutcome::Unique(candidates[0].clone()),\n672\t        _ => {\n673\t            let files = candidates\n674\t                .iter()\n675\t                .map(|candidate| candidate.file.repo_relative_path.clone())\n676\t                .collect::<Vec<_>>();\n677\t            let distinct_files = files.iter().collect::<std::collections::HashSet<_>>().len();\n678\t            ResolveOutcome::Ambiguous(AmbiguityReport::new(\n679\t                query,\n680\t                candidates,\n681\t                symbol_disambiguation_hint(distinct_files > 1),\n682\t            ))\n683\t        }\n684\t    }\n685\t}\n686\t\n687\tfn split_symbol_target(target: &str) -> (Option<&str>, &str) {\n688\t    let trimmed = target.trim();\n689\t    if let Some((file, symbol)) = trimmed.rsplit_once(\"::\") {\n690\t        if looks_like_path(file) {\n691\t            return (Some(file), symbol);\n692\t        }\n693\t    }\n694\t    if let Some((file, symbol)) = trimmed.rsplit_once(':') {\n695\t        if looks_like_path(file) {\n696\t            return (Some(file), symbol);\n697\t        }\n698\t    }\n699\t    (None, trimmed)\n700\t}\n701\t\n702\tfn looks_like_path(value: &str) -> bool {\n703\t    value.contains('/') || value.contains('\\\\') || value.contains('.')\n704\t}\n705\t\n706\tfn normalize_path(path: &str) -> String {\n707\t    path.replace('\\\\', \"/\")\n708\t        .trim()\n709\t        .trim_start_matches(\"./\")\n710\t        .trim_start_matches('/')\n711\t        .to_string()\n712\t}\n713\t\n714\tfn normalize_symbol_name(value: &str) -> String {\n715\t    value.trim().trim_matches(':').to_string()\n716\t}\n717\t\n718\tfn normalize_heading(value: &str) -> String {\n719\t    value.trim().to_lowercase()\n720\t}\n721\t\n722\tfn is_test_node(node: &GraphNode) -> bool {\n723\t    let lower_name = node.name.to_lowercase();\n724\t    let lower_file = node.file.to_lowercase();\n725\t    lower_name.starts_with(\"test\")\n726\t        || lower_name.ends_with(\"test\")\n727\t        || lower_file.contains(\"/tests/\")\n728\t        || lower_file.contains(\"_test.\")\n729\t        || lower_file.contains(\".test.\")\n730\t}\n731\t\n732\tfn is_canonical_ulid(value: &str) -> bool {\n733\t    value.len() == 26\n734\t        && value.chars().all(|ch| {\n735\t            matches!(ch, '0'..='9' | 'A'..='Z') && ch != 'I' && ch != 'L' && ch != 'O' && ch != 'U'\n736\t        })\n737\t}\n738\t\n739\t#[cfg(test)]"}]},"parent_tool_use_id":null,"session_id":"97e40997-f38f-4628-bdcd-a9758dda27fa","uuid":"5863f131-f395-42fd-97e4-9c5e1f037b0f","timestamp":"2026-05-17T07:28:23.881Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/identity/resolver.rs","content":"                .is_some()\n        })\n    }\n\n    fn event_ref_appears_ahead_of_index(&self, workspace: &WorkspaceId, ulid: &str) -> bool {\n        self.latest_event_id\n            .as_ref()\n            .filter(|latest| latest.workspace_id == *workspace)\n            .map(|latest| ulid > latest.ulid.as_str())\n            .unwrap_or(false)\n    }\n\n    fn file_id_for_stored_path(\n        &self,\n        workspace: &WorkspaceId,\n        stored_path: &str,\n    ) -> Result<FileId, ResolveError> {\n        let Some(repo_relative_path) = self.relative_path_in_workspace(workspace, stored_path)\n        else {\n            return Err(ResolveError::NotFound {\n                kind: \"file\",\n                query: stored_path.to_string(),\n            });\n        };\n        Ok(FileId {\n            workspace_id: workspace.clone(),\n            repo_relative_path,\n            content_hash: self\n                .file_index\n                .get(stored_path)\n                .map(|entry| entry.content_hash.clone())\n                .unwrap_or_else(|| DEFAULT_CONTENT_HASH.to_string()),\n        })\n    }\n\n    fn symbol_id_for_node(\n        &self,\n        workspace: &WorkspaceId,\n        node: &GraphNode,\n        forced_kind: Option<&str>,\n    ) -> Option<SymbolId> {\n        let file = self.file_id_for_stored_path(workspace, &node.file).ok()?;\n        Some(SymbolId {\n            file,\n            qualified_name: node.name.clone(),\n            byte_offset: node.id.byte_offset,\n            kind: forced_kind\n                .map(str::to_string)\n                .unwrap_or_else(|| format!(\"{:?}\", node.kind).to_lowercase()),\n        })\n    }\n\n    fn stored_path_for_doc(&self, workspace: &WorkspaceId, doc: &DocId) -> Option<String> {\n        self.file_index.keys().find_map(|stored_path| {\n            let relative_path = self.relative_path_in_workspace(workspace, stored_path)?;\n            if relative_path == doc.repo_relative_path {\n                Some(stored_path.clone())\n            } else {\n                None\n            }\n        })\n    }\n\n    fn relative_path_in_workspace(\n        &self,\n        workspace: &WorkspaceId,\n        stored_path: &str,\n    ) -> Option<String> {\n        let normalized = normalize_path(stored_path);\n        let prefix = format!(\"{workspace}/\");\n        if normalized == *workspace {\n            return Some(String::new());\n        }\n        if let Some(stripped) = normalized.strip_prefix(&prefix) {\n            return Some(stripped.to_string());\n        }\n        if workspace == &self.default_workspace && !self.is_namespaced_path(&normalized) {\n            return Some(normalized);\n        }\n        None\n    }\n\n    fn is_namespaced_path(&self, path: &str) -> bool {\n        let first_segment = path.split('/').next().unwrap_or(path);\n        first_segment == self.default_workspace\n            || self\n                .file_index\n                .keys()\n                .filter_map(|item| normalize_path(item).split('/').next().map(str::to_string))\n                .any(|segment| segment == first_segment)\n    }\n\n    fn resolve_file_identity_compat(\n        &self,\n        workspace: &WorkspaceId,\n        query: &str,\n    ) -> Result<Option<FileId>, ResolveError> {\n        let Ok(identity) = decode_identity(query) else {\n            return Ok(None);\n        };\n        let Identity::File(file_id) = identity else {\n            return Ok(None);\n        };\n        if file_id.workspace_id != *workspace {\n            return Err(ResolveError::NotFound {\n                kind: \"file\",\n                query: file_id.to_string(),\n            });\n        }\n        if let Some(current) = self.find_current_file_by_hash(workspace, &file_id) {\n            return Ok(Some(current));\n        }\n        Err(ResolveError::NotFound {\n            kind: \"file\",\n            query: query.to_string(),\n        })\n    }\n\n    fn find_current_file_by_hash(\n        &self,\n        workspace: &WorkspaceId,\n        legacy: &FileId,\n    ) -> Option<FileId> {\n        let mut matches = self\n            .file_index\n            .iter()\n            .filter(|(stored_path, entry)| {\n                entry.content_hash == legacy.content_hash\n                    && self\n                        .relative_path_in_workspace(workspace, stored_path)\n                        .is_some()\n            })\n            .filter_map(|(stored_path, _)| {\n                self.file_id_for_stored_path(workspace, stored_path).ok()\n            })\n            .collect::<Vec<_>>();\n        if matches.len() == 1 {\n            return matches.pop();\n        }\n        matches\n            .into_iter()\n            .find(|candidate| candidate.repo_relative_path == legacy.repo_relative_path)\n    }\n}\n\nfn unique_or_ambiguous_symbol(query: &str, candidates: Vec<SymbolId>) -> ResolveOutcome<SymbolId> {\n    match candidates.len() {\n        0 => ResolveOutcome::NotFound(ResolveError::NotFound {\n            kind: \"symbol\",\n            query: query.to_string(),\n        }),\n        1 => ResolveOutcome::Unique(candidates[0].clone()),\n        _ => {\n            let files = candidates\n                .iter()\n                .map(|candidate| candidate.file.repo_relative_path.clone())\n                .collect::<Vec<_>>();\n            let distinct_files = files.iter().collect::<std::collections::HashSet<_>>().len();\n            ResolveOutcome::Ambiguous(AmbiguityReport::new(\n                query,\n                candidates,\n                symbol_disambiguation_hint(distinct_files > 1),\n            ))\n        }\n    }\n}\n\nfn split_symbol_target(target: &str) -> (Option<&str>, &str) {\n    let trimmed = target.trim();\n    if let Some((file, symbol)) = trimmed.rsplit_once(\"::\") {\n        if looks_like_path(file) {\n            return (Some(file), symbol);\n        }\n    }\n    if let Some((file, symbol)) = trimmed.rsplit_once(':') {\n        if looks_like_path(file) {\n            return (Some(file), symbol);\n        }\n    }\n    (None, trimmed)\n}\n\nfn looks_like_path(value: &str) -> bool {\n    value.contains('/') || value.contains('\\\\') || value.contains('.')\n}\n\nfn normalize_path(path: &str) -> String {\n    path.replace('\\\\', \"/\")\n        .trim()\n        .trim_start_matches(\"./\")\n        .trim_start_matches('/')\n        .to_string()\n}\n\nfn normalize_symbol_name(value: &str) -> String {\n    value.trim().trim_matches(':').to_string()\n}\n\nfn normalize_heading(value: &str) -> String {\n    value.trim().to_lowercase()\n}\n\nfn is_test_node(node: &GraphNode) -> bool {\n    let lower_name = node.name.to_lowercase();\n    let lower_file = node.file.to_lowercase();\n    lower_name.starts_with(\"test\")\n        || lower_name.ends_with(\"test\")\n        || lower_file.contains(\"/tests/\")\n        || lower_file.contains(\"_test.\")\n        || lower_file.contains(\".test.\")\n}\n\nfn is_canonical_ulid(value: &str) -> bool {\n    value.len() == 26\n        && value.chars().all(|ch| {\n            matches!(ch, '0'..='9' | 'A'..='Z') && ch != 'I' && ch != 'L' && ch != 'O' && ch != 'U'\n        })\n}\n\n#[cfg(test)]","numLines":220,"startLine":520,"totalLines":741}}}
