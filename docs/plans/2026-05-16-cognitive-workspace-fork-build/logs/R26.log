on => (\"daemon\", None),\n102\t    }\n103\t}\n104\t\n105\tpub(crate) fn decode_actor(\n106\t    kind: &str,\n107\t    detail: Option<String>,\n108\t    column_prefix: &'static str,\n109\t) -> Result<Actor, MemoryGraphParseError> {\n110\t    let detail_for_error = detail.clone();\n111\t    match (kind, detail) {\n112\t        (\"assistant\", Some(model)) => Ok(Actor::Assistant { model }),\n113\t        (\"user\", None) => Ok(Actor::User),\n114\t        (\"tool\", Some(name)) => Ok(Actor::Tool { name }),\n115\t        (\"daemon\", None) => Ok(Actor::Daemon),\n116\t        _ => Err(MemoryGraphParseError::InvalidJsonColumn {\n117\t            column: column_prefix,\n118\t            reason: format!(\n119\t                \"invalid actor columns: kind `{kind}` detail {:?}\",\n120\t                detail_for_error.as_deref()\n121\t            ),\n122\t        }),\n123\t    }\n124\t}\n125\t\n126\tpub(crate) fn encode_identity_text(identity: &Identity) -> String {\n127\t    encode_identity(identity)\n128\t}\n129\t\n130\tpub(crate) fn decode_identity_text(\n131\t    encoded: &str,\n132\t    column: &'static str,\n133\t) -> Result<Identity, MemoryGraphParseError> {\n134\t    decode_identity(encoded).map_err(|error| MemoryGraphParseError::InvalidJsonColumn {\n135\t        column,\n136\t        reason: error.to_string(),\n137\t    })\n138\t}\n139\t\n140\tpub(crate) fn encode_event_id(event_id: &EventId) -> String {\n141\t    encode_identity_text(&Identity::Event(event_id.clone()))\n142\t}\n143\t\n144\tpub(crate) fn decode_event_id(\n145\t    encoded: &str,\n146\t    column: &'static str,\n147\t) -> Result<EventId, MemoryGraphParseError> {\n148\t    match decode_identity_text(encoded, column)? {\n149\t        Identity::Event(event_id) => Ok(event_id),\n150\t        other => Err(MemoryGraphParseError::InvalidJsonColumn {\n151\t            column,\n152\t            reason: format!(\"expected event identity, got {:?}\", other.kind()),\n153\t        }),\n154\t    }\n155\t}\n156\t\n