diff --git a/daemon/crates/lattice-core/src/retrieval_v1/intent.rs b/daemon/crates/lattice-core/src/retrieval_v1/intent.rs
new file mode 100644
index 0000000000000000000000000000000000000000..01cd538d640278308c48f38762da9b67e2a553b4
