use serde::{Deserialize, Serialize};

/// The detected intent behind a query.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
pub enum QueryIntent {
    Explore,
    FixBug,
    Refactor,
    AddFeature,
    Unknown,
}

/// A high-scoring node included with full source code.
