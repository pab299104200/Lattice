   114	impl PreparedTask {
   115	    fn new(task_text: &str) -> Self {
   116	        let trimmed = task_text.trim();
   117	        let total_chars = trimmed.chars().count();
   118	        let inspected_text: String = trimmed.chars().take(MAX_INTENT_TASK_CHARS).collect();
   119	        let input_was_truncated = total_chars > MAX_INTENT_TASK_CHARS;
   120	        let raw_tokens = split_raw_tokens(&inspected_text);
