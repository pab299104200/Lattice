   132	#[derive(Default)]
   133	struct ScoreCard {
   134	    scores: BTreeMap<IntentLabel, f64>,
   135	    features: BTreeMap<IntentLabel, Vec<IntentFeature>>,
   136	}
   137	
   138	impl ScoreCard {
   139	    fn new() -> Self {
   140	        let mut scores = BTreeMap::new();
   141	        let mut features = BTreeMap::new();
   142	        for label in ordered_labels() {
   143	            scores.insert(label, 0.0);
   144	            features.insert(label, Vec::new());
   145	        }
   146	        Self { scores, features }
   147	    }
   148	
   149	    fn add(&mut self, label: IntentLabel, feature: IntentFeature, score: f64) {
   150	        let current = self.scores.entry(label).or_insert(0.0);
   151	        *current += score;
   152	
   153	        let label_features = self.features.entry(label).or_default();
   154	        if !label_features.contains(&feature) {
   155	            label_features.push(feature);
   156	            label_features.sort();
   157	        }
   158	    }
   159	}
