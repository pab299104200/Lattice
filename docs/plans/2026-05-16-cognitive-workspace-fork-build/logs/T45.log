+#[test]
+fn replay_succeeds_with_cached_llm_responses_and_fails_cleanly_without_them() {
+    let fixture = Fixture::new();
+    let (proposal, cache) = llm_backed_create("proposal-cache", "job-cache", "mem-cache");
+    fixture.insert_job("job-cache");
