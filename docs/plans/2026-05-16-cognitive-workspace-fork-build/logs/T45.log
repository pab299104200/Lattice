diff --git a/daemon/crates/lattice-core/src/events/store.rs b/daemon/crates/lattice-core/src/events/store.rs
index b689f727703174b5ba4ac1263ee0f9c4d87b0e4f..74d92b9687652ec65f095a70e0fbe9bad7b94441
--- a/daemon/crates/lattice-core/src/events/store.rs
+++ b/daemon/crates/lattice-core/src/events/store.rs
@@ -3,7 +3,7 @@
 use std::sync::{Mutex, MutexGuard};
 use std::time::Duration;
 
-use rusqlite::{params, CachedStatement, Connection};
+use rusqlite::{params, CachedStatement, Connection, OptionalExtension};
