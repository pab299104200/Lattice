+                let _ = proposal.apply(
+                    &conn,
+                    memory_store,
+                    event_writer,
+                    decided_by.value.as_str(),
+                    None,
+                )?;
+                span.record("outcome", "applied");
+                return Ok(Some(proposal));
+            }
+        }
         span.record("outcome", "proposed");
         Ok(Some(proposal))
     }
