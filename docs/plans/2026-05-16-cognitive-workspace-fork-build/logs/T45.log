+impl ProposalRecordRow {
+    fn into_record(self) -> Result<ConsolidationProposalRecord, LatticeError> {
+        Ok(ConsolidationProposalRecord {
+            proposal_id: self.proposal_id,
+            job_id: self.job_id,
