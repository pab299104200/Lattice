+    pub fn row_id_for_event_uuid(
+        &self,
+        event_uuid: &str,
+    ) -> Result<Option<i64>, EventStoreError> {
+        let conn = self.lock_conn()?;
+        conn.query_row(
+            "SELECT event_id FROM events WHERE event_uuid = ?1",
+            params![event_uuid],
+            |row| row.get(0),
+        )
+        .optional()
