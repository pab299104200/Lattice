+        .optional()
+        .map_err(|e| {
+            LatticeError::Storage(format!(
+                "Failed to inspect consolidation_proposals table SQL: {e}"
+            ))
+        })?;
+    Ok(table_sql
+        .as_deref()
+        .is_some_and(|sql| sql.contains("'reverted'")))
