+    pub fn clear_last_verified_at(&self, id: &str) -> Result<(), LatticeError> {
+        record_direct_write();
+        let updated = self
+            .conn
+            .execute(
+                "UPDATE memories
+                 SET last_verified_at = NULL
+                 WHERE id = ?1 AND is_invalidated = 0",
