pub fn diagnose_failure(
    graph: &CodeGraph,
    input: &str,
    kind: Option<&str>,
    rules: &[ProjectRule],
    mode: BundleMode,
) -> FailureDiagnosis {
    let all_nodes = graph.all_nodes();
    let failure_kind = kind
        .map(|value| value.to_string())
