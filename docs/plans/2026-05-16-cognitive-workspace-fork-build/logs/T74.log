+export function renderStatusBadge(status: string, i18n: ReviewI18n): string {
+    const tone = badgeTone(status);
+    const label = i18n.has(`reviewStatus.${status}`)
+        ? i18n.t(`reviewStatus.${status}`)
+        : humanize(status);
+    return `<span class="status-badge status-badge--${escapeHtml(tone)}">${escapeHtml(label)}</span>`;
 }
 
-function badgeDefinition(status: string): StatusBadgeDefinition {
+function badgeTone(status: string): string {
     switch (status) {
         case 'verified':
-            return { className: 'badge-success', labelKey: 'reviewStatus.verified' };
-        case 'in_review':
-            return { className: 'badge-warning', labelKey: 'reviewStatus.in_review' };
