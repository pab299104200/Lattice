+    .shell { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }
+    .nav {
+      border-right: 1px solid var(--border);
+      padding: 16px 12px;
+      background: color-mix(in srgb, var(--surface-alt) 84%, transparent);
+    }
+    .nav h1 { font-size: 18px; margin: 0; }
+    .nav p {
+      color: var(--muted);
+      font-size: 12px;
