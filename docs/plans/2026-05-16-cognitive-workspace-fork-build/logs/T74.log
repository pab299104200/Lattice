+                        ? 'desc'
+                        : 'asc';
+                    this.staleViewState.sortBy = message.sortBy;
+                }
+                await this.refreshState();
+                return;
+            case 'openEvidenceInspector':
+                if (message.memoryId) {
+                    this.evidenceInspectorState.memoryId = message.memoryId;
