+    .review-table tbody tr, .row-link { cursor: pointer; }
+    .review-table tbody tr:hover, .row-link:hover {
+      background: color-mix(in srgb, var(--accent) 8%, transparent);
+    }
+    .sort-button, .link-button, .table-sort {
+      border: 0;
