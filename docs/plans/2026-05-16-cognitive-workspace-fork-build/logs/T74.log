+    .empty-state p { margin: 0; color: var(--muted); }
+    .pagination-bar { justify-content: space-between; color: var(--muted); font-size: 12px; }
+    .page-size-group button.active {
+      background: var(--accent);
+      color: var(--accent-foreground);
