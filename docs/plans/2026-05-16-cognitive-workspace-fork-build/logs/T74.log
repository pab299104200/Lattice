+        state.error = message.message || copy.error;
+        render();
+      }
+    });
+    render();
+    vscode.postMessage({ command: 'ready' });
+  </script>
+</body>
+</html>`;
+}
+
+function escapeHtml(value: string): string {
+    return value
+        .replaceAll('&', '&amp;')
+        .replaceAll('<', '&lt;')
+        .replaceAll('>', '&gt;')
+        .replaceAll('"', '&quot;')
+        .replaceAll("'", '&#39;');
+}
