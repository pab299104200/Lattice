+    .placeholder h3 { margin: 0 0 8px; font-size: 16px; }
+    .placeholder p { margin: 0 0 12px; color: var(--muted); line-height: 1.5; }
+    .support {
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
