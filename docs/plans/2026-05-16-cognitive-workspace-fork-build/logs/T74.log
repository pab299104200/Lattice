@@ -1,5 +1,6 @@
 import { ReviewI18n } from './i18n';
-import { ReviewMemory, ReviewRpcBridgeContract } from './rpcBridge';
+import { ReviewRpcBridgeContract } from './rpcBridge';
+import { ReviewMemory } from './rpcPayloads';
 import { renderMemoryRow } from './components/MemoryRow';
 import { escapeAttr, escapeHtml } from './components/html';
 
diff --git a/extension/src/review/reviewPanel.ts b/extension/src/review/reviewPanel.ts
index 86b09f36827b41bd94b6427a23c271104b4f1d1c..f3387a13bbb0a6abb9a036b242e8daaf4ce6626f
--- a/extension/src/review/reviewPanel.ts
+++ b/extension/src/review/reviewPanel.ts
@@ -2,6 +2,7 @@
 import * as vscode from 'vscode';
 import { DaemonManager } from '../daemon';
 import { createReviewI18n, ReviewI18n } from './i18n';
