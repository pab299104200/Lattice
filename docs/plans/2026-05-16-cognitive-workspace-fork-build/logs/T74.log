+                return;
+            case 'pickEventTraceTask':
+                await this.pickEventTraceScope('task');
+                return;
+            case 'pickEventTraceWorkspace':
+                await this.pickEventTraceScope('workspace');
+                return;
+            case 'pickEventTraceBranch':
+                await this.pickEventTraceBranch();
