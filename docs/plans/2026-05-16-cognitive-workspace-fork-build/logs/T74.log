+      --accent: var(--vscode-button-background);
+      --accent-foreground: var(--vscode-button-foreground);
+      --warning: var(--vscode-editorWarning-foreground);
+      --error: var(--vscode-errorForeground);
+      --success: var(--vscode-testing-iconPassed);
+    }
