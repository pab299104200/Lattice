+    }
+    if (typeof event.payload === 'object' && event.payload !== null && !Array.isArray(event.payload)) {
+        const payload = event.payload as Record<string, unknown>;
+        for (const key of ['request_id', 'requestId', 'call_id', 'callId']) {
