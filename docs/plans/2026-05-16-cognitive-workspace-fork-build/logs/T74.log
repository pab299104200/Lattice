     return new Intl.DateTimeFormat(undefined, {
         dateStyle: 'medium',
         timeStyle: 'short',
-    }).format(new Date(lastVerifiedAt));
+    }).format(new Date(lastVerifiedAt * 1000));
 }
 
 function formatConfidence(confidence: number): string {
diff --git a/extension/src/review/components/StatusBadge.ts b/extension/src/review/components/StatusBadge.ts
