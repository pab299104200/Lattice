index 35a1619a12c02224dfc696f8e7073be24745d9d8..8a8108d6a4b0415d0e6e08a064dd8eac9873fffa
--- a/extension/src/review/i18n/en.json
+++ b/extension/src/review/i18n/en.json
@@ -145,6 +145,110 @@
       "counter_memory": "CounterMemory"
     }
   },
+  "staleView": {
