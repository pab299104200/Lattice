+    "filterStatusPlaceholder": "Choose one or more stale-family statuses",
+    "filterScopePlaceholder": "Choose one or more scopes",
+    "activeStatus": "Status: {value}",
+    "activeScope": "Scope: {value}",
+    "scopeCount": "{count} scopes available",
+    "allStatuses": "All stale-family statuses",
+    "allScopes": "All scopes",
+    "inspectEvidence": "Inspect Evidence",
+    "reverify": "Re-verify",
+    "reverifyLoading": "Re-verifying...",
+    "verifySuccess": "Verification complete: {status}.",
+    "empty": "No stale memories. Verification is up to date.",
+    "emptyFiltered": "No stale memories match the current filters.",
+    "notAvailable": "Not available",
+    "column": {
+      "status": "Status",
+      "class": "Class",
