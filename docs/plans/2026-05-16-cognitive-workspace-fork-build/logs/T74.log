+                    return;
                 }
+                if (this.activeRoute === 'evidenceInspector') {
+                    await this.handleEvidenceInspectorMessage(message);
+                    return;
+                }
+                if (this.activeRoute === 'eventTrace') {
+                    await this.handleEventTraceMessage(message);
