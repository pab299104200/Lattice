+    }
+    return new Date(value * 1000).toLocaleString();
+}
+
+function asObjectArray(values: unknown[]): Record<string, unknown>[] {
+    return values.filter((value): value is Record<string, unknown> => typeof value === 'object' && value !== null);
+}
+
