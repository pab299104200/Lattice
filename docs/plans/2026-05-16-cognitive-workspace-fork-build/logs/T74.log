             case 'navigate':
                 if (message.route) {
                     this.activeRoute = message.route;
+                    if (message.memoryId) {
+                        this.evidenceInspectorState.memoryId = message.memoryId;
+                        this.eventTraceState.memoryId = message.memoryId;
+                    }
