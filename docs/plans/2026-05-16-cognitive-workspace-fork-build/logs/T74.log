+    private async explainMemory(
+        memoryId: string
+    ): Promise<ReviewResult<ReviewVerifyExplainResponse>> {
+        return this.run(async () => {
+            const payload = await this.callTool('verify_explain_memory', {
+                memory_id: memoryId,
+                mode: 'explain',
+                render_mode: 'full',
+            });
+            return normalizeVerifyExplainResponse(payload);
+        });
+    }
