+    }
+    .sort-button, .link-button, .table-sort {
+      border: 0;
+      background: transparent;
+      padding: 0;
+      color: inherit;
+      border-radius: 0;
+    }
+    .sort-button:hover, .link-button:hover, .table-sort:hover {
+      color: var(--accent);
