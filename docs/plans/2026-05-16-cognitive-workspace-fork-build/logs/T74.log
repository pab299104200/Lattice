+        return;
+      }
+      if (!state.payload) {
+        host.innerHTML = '<div class="content"><div class="placeholder"><h3>' + escape(copy.empty) + '</h3></div></div>';
+        return;
+      }
+      host.innerHTML = renderShell(state.payload);
+    }
+    function renderShell(payload) {
+      const routeCards = payload.routes.map((route) => {
