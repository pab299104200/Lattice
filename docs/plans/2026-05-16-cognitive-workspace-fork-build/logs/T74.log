+    .skeleton {
+      height: 76px;
+      border-radius: 14px;
+      border: 1px solid var(--border);
+      background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 14%, transparent), transparent);
+      background-size: 240px 100%;
+      animation: shimmer 1.2s infinite linear;
