+        if (!event?.payload) {
+            return;
+        }
+        const document = await vscode.workspace.openTextDocument({
+            content: JSON.stringify(event.payload, null, 2),
+            language: 'json',
+        });
+        await vscode.window.showTextDocument(document, { preview: true });
