+        const selection = await vscode.window.showQuickPick(scopes, {
+            title: this.i18n.t('staleView.filterScope'),
+            placeHolder: this.i18n.t('staleView.filterScopePlaceholder'),
+            canPickMany: true,
+            ignoreFocusOut: true,
