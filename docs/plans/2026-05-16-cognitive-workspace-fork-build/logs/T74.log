-
-const DEFAULT_STATUS: StatusBadgeDefinition = {
-    className: 'badge-ghost',
-    labelKey: 'reviewStatus.unverified',
-};
 
-export function renderStatusBadge(status: VerificationStatus | string, i18n: ReviewI18n): string {
