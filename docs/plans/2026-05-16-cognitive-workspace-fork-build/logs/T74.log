+                await this.refreshState();
+                return;
+            case 'setRetrievalExplanationPageSize':
+                if (typeof message.pageSize === 'number') {
+                    this.retrievalExplanationState.pageSize = message.pageSize;
+                    this.retrievalExplanationState.page = 1;
