+    private async reverifyEvidenceMemory(memoryId: string): Promise<void> {
+        if (!this.bridge) {
+            return;
+        }
+        this.evidenceInspectorState.reverifyInFlight = true;
+        this.evidenceInspectorState.inlineError = undefined;
