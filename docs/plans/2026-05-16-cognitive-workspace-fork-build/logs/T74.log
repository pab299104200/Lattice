        render();
        return;
      }
      if (message.type === 'error') {
        state.loading = false;
        state.error = message.message || copy.error;
        render();
      }
    });

    render();
    vscode.postMessage({ command: 'ready' });
  </script>
</body>
</html>`;
    }
}

function routeIds(): ReviewRouteId[] {
    return [
        'memoryInbox',
        'promotionQueue',
        'contradictionQueue',
        'staleView',
        'evidenceInspector',
        'eventTrace',
        'retrievalExplanation',
        'usefulnessMetrics',
        'workspaceGraphHealth',
        'indexingHealth',
        'consolidationQueue',

