+                    this.staleViewState.sortDirection = this.staleViewState.sortBy === message.sortBy
+                        && this.staleViewState.sortDirection === 'asc'
+                        ? 'desc'
+                        : 'asc';
+                    this.staleViewState.sortBy = message.sortBy;
