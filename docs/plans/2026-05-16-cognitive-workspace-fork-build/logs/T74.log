+    }
+    if (raw.startsWith('http://') || raw.startsWith('https://')) {
+        return vscode.Uri.parse(raw);
+    }
+    const fileLike = raw.split('#')[0].split('::')[0];
+    if (!fileLike) {
+        return undefined;
+    }
+    if (fileLike.startsWith('/')) {
+        return vscode.Uri.file(fileLike);
+    }
