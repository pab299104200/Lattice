+    .table-card { display: flex; flex-direction: column; gap: 14px; }
+    .table-wrap { overflow-x: auto; }
+    .review-table, .data-table { width: 100%; border-collapse: collapse; }
+    .review-table th, .review-table td, .data-table th, .data-table td {
