+    if (typeof value === 'string') {
+        return value.includes(memoryId);
+    }
+    if (Array.isArray(value)) {
+        return value.some((entry) => containsMemoryId(entry, memoryId));
+    }
+    if (typeof value === 'object' && value !== null) {
