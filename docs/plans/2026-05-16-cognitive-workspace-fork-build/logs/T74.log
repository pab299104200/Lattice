+                await this.pickStaleStatusFilters();
+                return;
+            case 'pickStaleScopeFilters':
+                await this.pickStaleScopeFilters();
+                return;
+            case 'sortStaleView':
+                if (message.sortBy) {
+                    this.staleViewState.sortDirection = this.staleViewState.sortBy === message.sortBy
