+            vec![StableRef::SymbolRef(zero_symbol(
+                "src/config.rs",
+                "LATTICE_EVENT_LOG",
+            ))],
+        ),
+    ];
+
+    GoldenFixture {
+        resolver,
+        graph,
+        memory_store,
+        vector_store,
+        events,
+        working_memory,
+        scoring_context: scoring_context(&content_hashes),
+    }
+}
