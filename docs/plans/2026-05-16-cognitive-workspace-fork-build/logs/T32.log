+pub(super) struct GoldenRun {
+    pub anchors: Vec<ResolvedAnchor>,
+    pub ranked: Vec<RankedCandidate>,
+    pub diagnostics: RankingDiagnostics,
+    pub bundle: crate::retrieval_v1::schema::RetrievalBundle,
+    pub latency_ms: f64,
+}
