+        ("src/session.rs", "create_session", 0.86, 120u32),
+        ("src/cli.rs", "prepare_change", 0.97, 130u32),
+        ("src/cli.rs", "diagnose_failure", 0.96, 135u32),
+        ("src/cli.rs", "search_logic_flow", 0.94, 145u32),
