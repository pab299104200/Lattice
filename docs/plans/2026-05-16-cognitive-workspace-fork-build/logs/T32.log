+        ),
+        case(
+            "budget_login_user_anchor_keeps_pinned_symbol_under_truncation",
+            "Explain login_user with all supporting context for an oversized bundle",
+            AnchorKind::Symbol,
+            "login_user",
+            ExpectedIdentity::Symbol {
+                file: "src/auth.rs",
+                qualified_name: "login_user",
+            },
+            ExpectedIdentity::Symbol {
+                file: "src/auth.rs",
+                qualified_name: "login_user",
+            },
+            [1.0, 0.0, 0.0],
+            65,
+        ),
+    ]
+}
