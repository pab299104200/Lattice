+pub(super) const MEMORY_SESSION_VERIFIED: &str = "01ARZ3NDEKTSV4RRFFQ69G5FAC";
+pub(super) const MEMORY_CLI_VERIFIED: &str = "01ARZ3NDEKTSV4RRFFQ69G5FAD";
