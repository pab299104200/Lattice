+impl ExpectedIdentity {
+    pub(super) fn matches(&self, identity: &Identity) -> bool {
+        match (self, identity) {
+            (Self::File(path), Identity::File(file)) => file.repo_relative_path == *path,
+            (
+                Self::Symbol {
