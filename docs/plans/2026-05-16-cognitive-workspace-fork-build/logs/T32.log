+        "src/cli.rs",
+        "prepare_change",
+    );
+    add_edge(
+        &mut graph,
+        "docs/guide.md",
+        "Retrieval Engine",
+        "src/cli.rs",
+        "search_logic_flow",
+    );
+    add_edge(
+        &mut graph,
