+fn add_symbols(graph: &mut CodeGraph, parsed_file: &ParsedFile) {
+    for symbol in &parsed_file.symbols {
+        graph.add_node(
+            symbol.id.clone(),
+            symbol.kind,
+            symbol.name.clone(),
+            symbol.signature.clone(),
+            symbol.body.clone(),
+            symbol.file.clone(),
+            symbol.line,
+            symbol.end_line,
+            symbol.is_exported,
+            symbol.language,
+        );
+    }
+}
