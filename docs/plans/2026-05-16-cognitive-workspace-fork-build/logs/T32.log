+pub(super) fn top_identity_matches(case: &GoldenCase, run: &GoldenRun) -> bool {
+    run.ranked
+        .first()
+        .map(|candidate| case.expected_top_identity.matches(&candidate.candidate.identity))
+        .unwrap_or(false)
+}
