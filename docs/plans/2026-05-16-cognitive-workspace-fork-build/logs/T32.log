+    pub graph: &'static CodeGraph,
+    pub memory_store: MemoryStore,
+    pub vector_store: VectorStore,
+    pub events: Vec<EventEnvelope>,
+    pub working_memory: Vec<Identity>,
+    pub scoring_context: ScoringContext,
+}
