+    pub expected_resolved_identity: ExpectedIdentity,
+    pub expected_top_identity: ExpectedIdentity,
+    pub dominant_signal: &'static str,
+    pub shaper_token_budget: usize,
+    pub query_embedding: [f32; 3],
+}
