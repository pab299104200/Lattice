+            (Self::Section { path, heading }, Identity::Section(section)) => {
+                section.doc.repo_relative_path == *path
+                    && section.heading_path == vec![heading.to_string()]
+            }
+            (Self::Memory(ulid), Identity::Memory(memory)) => memory.ulid == *ulid,
+            _ => false,
+        }
+    }
