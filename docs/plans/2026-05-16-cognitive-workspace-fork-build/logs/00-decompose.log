{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0137xY1wckt7ctVYH4mrnrw7","type":"tool_result","content":"100\t    let graph_store = Arc::new(Mutex::new(graph_store));\n101\t\n102\t    // Multi-repo workspace manager (only used when multiple workspaces)\n103\t    let workspace_manager: Option<Arc<Mutex<WorkspaceManager>>> = if is_multi_repo {\n104\t        Some(Arc::new(Mutex::new(WorkspaceManager::new())))\n105\t    } else {\n106\t        None\n107\t    };\n108\t\n109\t    // OnceLock for EmbeddingEngine — populated in background once model loads\n110\t    let embedding_engine: Arc<OnceLock<Arc<EmbeddingEngine>>> = Arc::new(OnceLock::new());\n111\t\n112\t    // Shared indexing state flag\n113\t    let indexing = Arc::new(std::sync::atomic::AtomicBool::new(true));\n114\t\n115\t    // ── Spawn background indexing task ────────────────────────────────\n116\t    {\n117\t        let engine_bg = Arc::clone(&engine);\n118\t        let indexer_bg = Arc::clone(&indexer);\n119\t        let graph_store_bg = Arc::clone(&graph_store);\n120\t        let embedding_engine_bg = Arc::clone(&embedding_engine);\n121\t        let indexing_bg = Arc::clone(&indexing);\n122\t        let ws_manager_bg = workspace_manager.clone();\n123\t        let ws_roots_bg = workspace_roots.clone();\n124\t        let ws_root = workspace_root.clone();\n125\t        let lattice_dir_bg = ws_root.join(\".lattice\");\n126\t        let vector_index_bg = vector_index.clone();\n127\t\n128\t        tokio::spawn(async move {\n129\t            tracing::info!(\"Background indexing starting...\");\n130\t            let _ = std::fs::create_dir_all(&lattice_dir_bg);\n131\t\n132\t            let files_indexed = if let Some(wm) = &ws_manager_bg {\n133\t                let (manifest, parsed_cache) = load_incremental_cache(&graph_store_bg).await;\n134\t                let roots = ws_roots_bg.clone();\n135\t                let incremental = tokio::task::spawn_blocking(move || {\n136\t                    build_incremental_index_for_roots(&roots, Some(&manifest), parsed_cache)\n137\t                })\n138\t                .await\n139\t                .unwrap_or_else(|err| {\n140\t                    tracing::warn!(\"Incremental multi-repo indexing task failed: {}\", err);\n141\t                    IncrementalIndexResult::empty()\n142\t                });\n143\t\n144\t                {\n145\t                    let mut wm = wm.lock().await;\n146\t                    for root in &ws_roots_bg {\n147\t                        let repo_name = repo_name_for_root(root);\n148\t                        if let Err(e) = wm.add_repo(repo_name.clone(), root.clone()) {\n149\t                            tracing::warn!(\"Failed to add repo {}: {}\", repo_name, e);\n150\t                            continue;\n151\t                        }\n152\t                        let repo_prefix = format!(\"{}/\", repo_name);\n153\t                        let repo_files: HashMap<String, ParsedFile> = incremental\n154\t                            .parsed_files\n155\t                            .iter()\n156\t                            .filter(|(file, _)| file.starts_with(&repo_prefix))\n157\t                            .map(|(file, parsed)| (file.clone(), parsed.clone()))\n158\t                            .collect();\n159\t                        wm.replace_repo_parsed_files(&repo_name, repo_files);\n160\t                    }\n161\t                    wm.detect_cross_repo_edges();\n162\t                    tracing::info!(\"Detected {} cross-repo edges\", wm.cross_repo_edges().len());\n163\t                }\n164\t\n165\t                persist_incremental_cache(\n166\t                    &graph_store_bg,\n167\t                    &incremental.graph,\n168\t                    &incremental.file_index,\n169\t                    &incremental.parsed_files,\n170\t                )\n171\t                .await;\n172\t                tracing::info!(\n173\t                    \"Incremental multi-repo indexing: {} current files, {} parsed/updated, {} removed\",\n174\t                    incremental.file_index.len(),\n175\t                    incremental.changed_count,\n176\t                    incremental.removed_count\n177\t                );\n178\t                incremental.changed_count\n179\t            } else {\n180\t                let ws = ws_root.clone();\n181\t                let (manifest, parsed_cache) = load_incremental_cache(&graph_store_bg).await;\n182\t                let incremental = tokio::task::spawn_blocking(move || {\n183\t                    build_incremental_index_for_roots(&[ws], Some(&manifest), parsed_cache)\n184\t                })\n185\t                .await\n186\t                .unwrap_or_else(|err| {\n187\t                    tracing::warn!(\"Incremental indexing task failed: {}\", err);\n188\t                    IncrementalIndexResult::empty()\n189\t                });\n190\t\n191\t                {\n192\t                    let mut idx = indexer_bg.lock().await;\n193\t                    idx.replace_parsed_files(incremental.parsed_files.clone());\n194\t                }\n195\t\n196\t                persist_incremental_cache(\n197\t                    &graph_store_bg,\n198\t                    &incremental.graph,\n199\t                    &incremental.file_index,\n200\t                    &incremental.parsed_files,\n201\t                )\n202\t                .await;\n203\t                tracing::info!(\n204\t                    \"Incremental indexing: {} current files, {} parsed/updated, {} removed\",\n205\t                    incremental.file_index.len(),\n206\t                    incremental.changed_count,\n207\t                    incremental.removed_count\n208\t                );\n209\t                incremental.changed_count\n210\t            };\n211\t            tracing::info!(\"Indexed {} files total\", files_indexed);\n212\t\n213\t            // Final save to graph store\n214\t            {\n215\t                let new_graph = if let Some(wm) = &ws_manager_bg {\n216\t                    let wm = wm.lock().await;\n217\t                    wm.unified_graph()\n218\t                } else {\n219\t                    let idx = indexer_bg.lock().await;\n220\t                    idx.graph().clone()\n221\t                };\n222\t\n223\t                let stats = new_graph.stats();\n224\t                tracing::info!(\n225\t                    \"Graph ready: {} nodes, {} edges, {} files\",\n226\t                    stats.node_count,\n227\t                    stats.edge_count,\n228\t                    stats.file_count\n229\t                );\n230\t\n231\t                {\n232\t                    let gs = graph_store_bg.lock().await;\n233\t                    if let Err(e) = gs.save_graph(&new_graph) {\n234\t                        tracing::warn!(\"Failed to save graph: {}\", e);\n235\t                    }\n236\t                }\n237\t\n238\t                let mut eng = engine_bg.lock().await;\n239\t                eng.update_graph(new_graph);\n240\t            }\n241\t\n242\t            // Try to load ONNX embedding model\n243\t            let model_path = lattice_dir_bg.join(\"models\").join(\"model.onnx\");\n244\t            if model_path.exists() {\n245\t                match EmbeddingEngine::new(model_path.to_string_lossy().as_ref()) {\n246\t                    Ok(emb_engine) => {\n247\t                        tracing::info!(\"ONNX embedding model loaded\");\n248\t                        let emb = Arc::new(emb_engine);\n249\t                        let _ = embedding_engine_bg.set(Arc::clone(&emb));"}]},"parent_tool_use_id":"toolu_01RDjDdnJFRiz86tbrxskniG","session_id":"88204e0b-a61b-4ed7-ba98-4fcc53be0768","uuid":"48dd3b84-5f31-4063-a942-e88519fed8ec","timestamp":"2026-05-17T02:18:21.648Z","subagent_type":"Explore","task_description":"Explore daemon architecture"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q1o8EpLjrUYmMgYGNDMSoi","type":"tool_result","content":"1\timport * as vscode from 'vscode';\n2\timport * as cp from 'child_process';\n3\timport { DaemonManager } from './daemon';\n4\timport { StatusBarProvider } from './statusbar';\n5\timport { LatticeCodeLensProvider } from './codelens';\n6\timport { LatticeHoverProvider } from './hover';\n7\timport { LatticeSidebarProvider } from './sidebar';\n8\timport {\n9\t    DocsTargetSelection,\n10\t    LatticeDocsWorkbench,\n11\t    normalizeDocsTargetSelection,\n12\t} from './docsWorkbench';\n13\t\n14\tlet daemon: DaemonManager | undefined;\n15\tlet lastContextHandle: string | undefined;\n16\tlet lastContextOrigin: string | undefined;\n17\t\n18\tinterface McpToolContentItem {\n19\t    type?: string;\n20\t    text?: string;\n21\t}\n22\t\n23\tinterface McpToolResponse {\n24\t    content?: McpToolContentItem[];\n25\t}\n26\t\n27\tinterface DaemonStatusSnapshot {\n28\t    status?: string;\n29\t    nodes?: number;\n30\t    node_count?: number;\n31\t    files?: number;\n32\t    file_count?: number;\n33\t    edges?: number;\n34\t    edge_count?: number;\n35\t}\n36\t\n37\tinterface GitChangedFiles {\n38\t    files: string[];\n39\t    source: string;\n40\t}\n41\t\n42\texport async function activate(context: vscode.ExtensionContext) {\n43\t    console.log('Lattice extension activating...');\n44\t\n45\t    // Create daemon manager\n46\t    daemon = new DaemonManager(context.extensionPath);\n47\t    context.subscriptions.push(daemon);\n48\t\n49\t    // Create UI providers (before daemon starts so they can receive status updates)\n50\t    const statusBar = new StatusBarProvider(daemon);\n51\t    context.subscriptions.push(statusBar);\n52\t\n53\t    const sidebarProvider = new LatticeSidebarProvider(daemon);\n54\t    const sidebarRegistration = vscode.window.registerWebviewViewProvider(\n55\t        LatticeSidebarProvider.viewType,\n56\t        sidebarProvider\n57\t    );\n58\t    context.subscriptions.push(sidebarProvider, sidebarRegistration);\n59\t\n60\t    const docsWorkbench = new LatticeDocsWorkbench(daemon);\n61\t    context.subscriptions.push(docsWorkbench);\n62\t\n63\t    let statsPollTimer: ReturnType<typeof setInterval> | undefined;\n64\t    const applyStatsSnapshot = (result: DaemonStatusSnapshot): void => {\n65\t        const nodes = result.nodes ?? result.node_count ?? 0;\n66\t        const files = result.files ?? result.file_count ?? 0;\n67\t        const edges = result.edges ?? result.edge_count ?? 0;\n68\t        sidebarProvider.updateStats({ nodes, files, edges });\n69\t        statusBar.updateNodeCount(nodes);\n70\t    };\n71\t    const syncStatsFromDaemon = async (shouldLog = false): Promise<void> => {\n72\t        if (!daemon || daemon.getStatus() !== 'running') {\n73\t            return;\n74\t        }\n75\t\n76\t        try {\n77\t            const result = await daemon.sendRequest('lattice/status') as DaemonStatusSnapshot;\n78\t            applyStatsSnapshot(result);\n79\t            if (shouldLog) {\n80\t                const nodes = result.nodes ?? result.node_count ?? 0;\n81\t                const files = result.files ?? result.file_count ?? 0;\n82\t                const edges = result.edges ?? result.edge_count ?? 0;\n83\t                console.log(`[lattice] indexed: ${nodes} nodes, ${files} files, ${edges} edges`);\n84\t            }\n85\t        } catch (err) {\n86\t            console.error('[lattice] failed to fetch stats:', err);\n87\t        }\n88\t    };\n89\t    const startStatsPolling = (): void => {\n90\t        if (statsPollTimer) {\n91\t            return;\n92\t        }\n93\t        statsPollTimer = setInterval(() => {\n94\t            void syncStatsFromDaemon();\n95\t        }, 3000);\n96\t    };\n97\t    const stopStatsPolling = (): void => {\n98\t        if (statsPollTimer) {\n99\t            clearInterval(statsPollTimer);\n100\t            statsPollTimer = undefined;\n101\t        }\n102\t    };\n103\t    context.subscriptions.push(new vscode.Disposable(() => stopStatsPolling()));\n104\t\n105\t    // When daemon becomes running, fetch stats and update UI\n106\t    daemon.onStatusChange(async (status) => {\n107\t        console.log(`[lattice] daemon status: ${status}`);\n108\t        if (status === 'running') {\n109\t            await syncStatsFromDaemon(true);\n110\t            startStatsPolling();\n111\t        } else {\n112\t            stopStatsPolling();\n113\t        }\n114\t    });\n115\t\n116\t    // Start daemon (non-blocking)\n117\t    daemon.start().catch((err) => {\n118\t        console.error(`[lattice] failed to start daemon: ${err.message}`);\n119\t        vscode.window.showErrorMessage(`Lattice: Failed to start daemon — ${err.message}`);\n120\t    });\n121\t\n122\t    // Register commands\n123\t    const reindexCmd = vscode.commands.registerCommand('lattice.reindex', async () => {\n124\t        if (!daemon || daemon.getStatus() !== 'running') {\n125\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n126\t            return;\n127\t        }\n128\t        try {\n129\t            vscode.window.showInformationMessage('Lattice: Re-indexing workspace...');\n130\t            await daemon.sendRequest('lattice/reindex', undefined, 300_000);\n131\t            // Poll status until indexing stabilizes\n132\t            let lastNodes = -1;\n133\t            let stableCount = 0;\n134\t            for (let i = 0; i < 60; i++) {\n135\t                await new Promise(r => setTimeout(r, 2000));\n136\t                const result = await daemon.sendRequest('lattice/status') as DaemonStatusSnapshot;\n137\t                if (result && typeof result === 'object') {\n138\t                    applyStatsSnapshot(result);\n139\t                    const nodes = result.nodes ?? result.node_count ?? 0;\n140\t                    if (nodes === lastNodes && nodes > 0) {\n141\t                        stableCount++;\n142\t                        if (stableCount >= 2) { break; }\n143\t                    } else {\n144\t                        stableCount = 0;\n145\t                    }\n146\t                    lastNodes = nodes;\n147\t                }\n148\t            }\n149\t            vscode.window.showInformationMessage('Lattice: Re-index complete');\n150\t        } catch (err) {\n151\t            const msg = err instanceof Error ? err.message : String(err);\n152\t            vscode.window.showErrorMessage(`Lattice: Re-index failed — ${msg}`);\n153\t        }\n154\t    });\n155\t\n156\t    const statusCmd = vscode.commands.registerCommand('lattice.showStatus', async () => {\n157\t        if (!daemon || daemon.getStatus() !== 'running') {\n158\t            vscode.window.showInformationMessage(`Lattice: Daemon status — ${daemon?.getStatus() ?? 'unknown'}`);\n159\t            return;\n160\t        }\n161\t        try {\n162\t            const result = await daemon.sendRequest('lattice/status');\n163\t            const info = typeof result === 'object' && result !== null ? JSON.stringify(result, null, 2) : String(result);\n164\t            vscode.window.showInformationMessage(`Lattice Status:\\n${info}`);\n165\t        } catch (err) {\n166\t            const msg = err instanceof Error ? err.message : String(err);\n167\t            vscode.window.showErrorMessage(`Lattice: Status request failed — ${msg}`);\n168\t        }\n169\t    });\n170\t\n171\t    // CodeLens provider\n172\t    const codeLensProvider = new LatticeCodeLensProvider(daemon);\n173\t    const codeLensRegistration = vscode.languages.registerCodeLensProvider(\n174\t        { scheme: 'file' },\n175\t        codeLensProvider\n176\t    );\n177\t    context.subscriptions.push(codeLensProvider, codeLensRegistration);\n178\t\n179\t    // Output channel for dependent results\n180\t    const outputChannel = vscode.window.createOutputChannel('Lattice');\n181\t    context.subscriptions.push(outputChannel);\n182\t\n183\t    const showDependentsCmd = vscode.commands.registerCommand(\n184\t        'lattice.showDependents',\n185\t        async (filePath: string, symbolName: string) => {\n186\t            if (!daemon || daemon.getStatus() !== 'running') {\n187\t                vscode.window.showWarningMessage('Lattice: Daemon is not running');\n188\t                return;\n189\t            }\n190\t            try {\n191\t                const result = await daemon.sendRequest('lattice/dependents', {\n192\t                    file: filePath,\n193\t                    name: symbolName,\n194\t                });\n195\t                const dependents = result as { dependents?: Array<{ file: string; line: number; name: string }> };\n196\t                outputChannel.clear();\n197\t                outputChannel.appendLine(`Dependents of \"${symbolName}\" (${filePath}):`);\n198\t                outputChannel.appendLine('---');\n199\t                if (dependents?.dependents && dependents.dependents.length > 0) {\n200\t                    for (const dep of dependents.dependents) {\n201\t                        outputChannel.appendLine(`  ${dep.file}:${dep.line} — ${dep.name}`);\n202\t                    }\n203\t                } else {\n204\t                    outputChannel.appendLine('  No dependents found.');\n205\t                }\n206\t                outputChannel.show(true);\n207\t            } catch (err) {\n208\t                const msg = err instanceof Error ? err.message : String(err);\n209\t                vscode.window.showErrorMessage(`Lattice: Failed to get dependents — ${msg}`);\n210\t            }\n211\t        }\n212\t    );\n213\t\n214\t    const prepareChangeCmd = vscode.commands.registerCommand('lattice.prepareChange', async () => {\n215\t        if (!daemon || daemon.getStatus() !== 'running') {\n216\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n217\t            return;\n218\t        }\n219\t\n220\t        const query = await vscode.window.showInputBox({\n221\t            prompt: 'Describe the change you want Lattice to prepare',\n222\t            placeHolder: 'e.g. fix memory recall timeout on new session',\n223\t            ignoreFocusOut: true,\n224\t        });\n225\t        if (!query || !query.trim()) {\n226\t            return;\n227\t        }\n228\t\n229\t        const activeFile = getActiveEditorFile();\n230\t        const focusedSymbol = getFocusedEditorSymbol(vscode.window.activeTextEditor);\n231\t        const args: Record<string, unknown> = {\n232\t            query: query.trim(),\n233\t            mode: 'compact',\n234\t        };\n235\t        if (activeFile) {\n236\t            args.entry_files = [activeFile];\n237\t        }\n238\t        if (focusedSymbol) {\n239\t            args.entry_symbols = [focusedSymbol];\n240\t        }\n241\t\n242\t        try {\n243\t            const result = await callTool(daemon, 'prepare_change', args);\n244\t            showToolResult(outputChannel, `Lattice prepare_change: ${query.trim()}`, result);\n245\t        } catch (err) {\n246\t            const msg = err instanceof Error ? err.message : String(err);\n247\t            vscode.window.showErrorMessage(`Lattice: Prepare change failed — ${msg}`);\n248\t        }\n249\t    });\n250\t\n251\t    const impactFromDiffCmd = vscode.commands.registerCommand('lattice.impactFromDiff', async () => {\n252\t        if (!daemon || daemon.getStatus() !== 'running') {\n253\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n254\t            return;\n255\t        }\n256\t\n257\t        const workspaceRoot = getWorkspaceRoot(vscode.window.activeTextEditor);\n258\t        if (!workspaceRoot) {\n259\t            vscode.window.showWarningMessage('Lattice: Open a workspace folder to analyze git diff impact');\n260\t            return;\n261\t        }\n262\t\n263\t        try {\n264\t            const diffInfo = await getPreferredGitDiff(workspaceRoot);\n265\t            const result = await callTool(daemon, 'impact_from_diff', {\n266\t                diff: diffInfo.diff,\n267\t                mode: 'compact',\n268\t                hops: 2,\n269\t            });\n270\t            showToolResult(outputChannel, `Lattice impact_from_diff: ${diffInfo.source}`, result);\n271\t        } catch (err) {\n272\t            const msg = err instanceof Error ? err.message : String(err);\n273\t            vscode.window.showErrorMessage(`Lattice: Diff impact failed — ${msg}`);\n274\t        }\n275\t    });\n276\t\n277\t    const workingSetCmd = vscode.commands.registerCommand('lattice.getWorkingSetContext', async () => {\n278\t        if (!daemon || daemon.getStatus() !== 'running') {\n279\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n280\t            return;\n281\t        }\n282\t\n283\t        const query = await vscode.window.showInputBox({\n284\t            prompt: 'Optional task hint for the current working set',\n285\t            placeHolder: 'Leave empty to just use the visible editors',\n286\t            ignoreFocusOut: true,\n287\t        });\n288\t        if (query === undefined) {\n289\t            return;\n290\t        }\n291\t\n292\t        const args: Record<string, unknown> = {\n293\t            mode: 'compact',\n294\t        };\n295\t        const files = collectVisibleEditorFiles();\n296\t        const focusedSymbol = getFocusedEditorSymbol(vscode.window.activeTextEditor);\n297\t        if (query.trim()) {\n298\t            args.query = query.trim();\n299\t        }\n300\t        if (files.length > 0) {\n301\t            args.files = files;\n302\t        }\n303\t        if (focusedSymbol) {\n304\t            args.symbols = [focusedSymbol];\n305\t        }\n306\t\n307\t        try {\n308\t            const result = await callTool(daemon, 'get_working_set_context', args);\n309\t            const title = query.trim()\n310\t                ? `Lattice working set: ${query.trim()}`\n311\t                : 'Lattice working set context';\n312\t            showToolResult(outputChannel, title, result);\n313\t        } catch (err) {\n314\t            const msg = err instanceof Error ? err.message : String(err);\n315\t            vscode.window.showErrorMessage(`Lattice: Working set request failed — ${msg}`);\n316\t        }\n317\t    });\n318\t\n319\t    const diagnoseFailureCmd = vscode.commands.registerCommand('lattice.diagnoseFailure', async () => {\n320\t        if (!daemon || daemon.getStatus() !== 'running') {\n321\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n322\t            return;\n323\t        }\n324\t\n325\t        let input = getSelectedEditorText(vscode.window.activeTextEditor);\n326\t        if (!input) {\n327\t            input = await vscode.window.showInputBox({\n328\t                prompt: 'Paste an error line, failing test output, or stack trace excerpt',\n329\t                placeHolder: \"e.g. thread 'main' panicked at src/rpc/mcp.rs:101\",\n330\t                ignoreFocusOut: true,\n331\t            });\n332\t        }\n333\t        if (!input || !input.trim()) {\n334\t            return;\n335\t        }\n336\t\n337\t        try {\n338\t            const result = await callTool(daemon, 'diagnose_failure', {\n339\t                input: input.trim(),\n340\t                mode: 'compact',\n341\t            });\n342\t            showToolResult(outputChannel, 'Lattice diagnose_failure', result);\n343\t        } catch (err) {\n344\t            const msg = err instanceof Error ? err.message : String(err);\n345\t            vscode.window.showErrorMessage(`Lattice: Failure diagnosis failed — ${msg}`);\n346\t        }\n347\t    });\n348\t\n349\t    const expandContextCmd = vscode.commands.registerCommand('lattice.expandContext', async () => {\n350\t        if (!daemon || daemon.getStatus() !== 'running') {\n351\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n352\t            return;\n353\t        }\n354\t        if (!lastContextHandle) {\n355\t            vscode.window.showInformationMessage(\n356\t                'Lattice: Run prepare change, diff impact, working set, or diagnose failure first to capture a context handle'\n357\t            );\n358\t            return;\n359\t        }\n360\t\n361\t        const focus = await vscode.window.showInputBox({\n362\t            prompt: `Expand context from ${lastContextOrigin ?? 'the last workflow result'}`,\n363\t            placeHolder: 'symbol:search_across_sessions or file:daemon/crates/lattice-core/src/memory/store.rs',\n364\t            ignoreFocusOut: true,\n365\t        });\n366\t        if (!focus || !focus.trim()) {\n367\t            return;\n368\t        }\n369\t\n370\t        try {\n371\t            const result = await callTool(daemon, 'expand_context', {\n372\t                handle: lastContextHandle,\n373\t                focus: focus.trim(),\n374\t                max_tokens: 1200,\n375\t            });\n376\t            showToolResult(outputChannel, `Lattice expand_context: ${focus.trim()}`, result);\n377\t        } catch (err) {\n378\t            const msg = err instanceof Error ? err.message : String(err);\n379\t            vscode.window.showErrorMessage(`Lattice: Context expansion failed — ${msg}`);\n380\t        }\n381\t    });\n382\t\n383\t    const docsCapsuleCmd = vscode.commands.registerCommand('lattice.getDocsCapsule', async () => {\n384\t        if (!daemon || daemon.getStatus() !== 'running') {\n385\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n386\t            return;\n387\t        }\n388\t\n389\t        const query = await vscode.window.showInputBox({\n390\t            prompt: 'Ask for engineering docs, runbooks, or decisions',\n391\t            placeHolder: 'e.g. auth login flow and operational checklist',\n392\t            ignoreFocusOut: true,\n393\t        });\n394\t        if (!query || !query.trim()) {\n395\t            return;\n396\t        }\n397\t\n398\t        const files = collectVisibleEditorFiles();\n399\t        const focusedSymbol = getFocusedEditorSymbol(vscode.window.activeTextEditor);\n400\t        const args: Record<string, unknown> = {\n401\t            query: query.trim(),\n402\t            limit: 6,\n403\t        };\n404\t        if (files.length > 0) {\n405\t            args.files = files;\n406\t        }\n407\t        if (focusedSymbol) {\n408\t            args.symbols = [focusedSymbol];\n409\t        }\n410\t\n411\t        try {\n412\t            const result = await callTool(daemon, 'get_docs_capsule', args);\n413\t            showToolResult(outputChannel, `Lattice docs capsule: ${query.trim()}`, result);\n414\t        } catch (err) {\n415\t            const msg = err instanceof Error ? err.message : String(err);\n416\t            vscode.window.showErrorMessage(`Lattice: Docs capsule failed — ${msg}`);\n417\t        }\n418\t    });\n419\t\n420\t    const backlinksCmd = vscode.commands.registerCommand('lattice.showBacklinks', async (input?: unknown) => {\n421\t        if (!daemon || daemon.getStatus() !== 'running') {\n422\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n423\t            return;\n424\t        }\n425\t\n426\t        const selection = normalizeDocsTargetSelection(input)\n427\t            ?? inferDocsTargetFromEditor(vscode.window.activeTextEditor)\n428\t            ?? await promptForDocsTarget('Show backlinks for a symbol, file, or docs section');\n429\t        if (!selection) {\n430\t            return;\n431\t        }\n432\t\n433\t        try {\n434\t            const result = await callTool(daemon, 'get_backlinks', {\n435\t                target: selection.target,\n436\t                kind: selection.kind,\n437\t                limit: 20,\n438\t            });\n439\t            showToolResult(outputChannel, `Lattice backlinks: ${selection.label}`, result);\n440\t        } catch (err) {\n441\t            const msg = err instanceof Error ? err.message : String(err);\n442\t            vscode.window.showErrorMessage(`Lattice: Backlinks lookup failed — ${msg}`);\n443\t        }\n444\t    });\n445\t\n446\t    const outgoingLinksCmd = vscode.commands.registerCommand('lattice.showOutgoingLinks', async (input?: unknown) => {\n447\t        if (!daemon || daemon.getStatus() !== 'running') {\n448\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n449\t            return;\n450\t        }\n451\t\n452\t        const selection = normalizeDocsTargetSelection(input)\n453\t            ?? inferDocsFileOrSectionTarget(vscode.window.activeTextEditor)\n454\t            ?? await promptForDocsTarget('Show outgoing links for a docs file or section');\n455\t        if (!selection) {\n456\t            return;\n457\t        }\n458\t\n459\t        try {\n460\t            const result = await callTool(daemon, 'get_outgoing_links', {\n461\t                target: selection.target,\n462\t                kind: selection.kind,\n463\t                limit: 20,\n464\t            });\n465\t            showToolResult(outputChannel, `Lattice outgoing links: ${selection.label}`, result);\n466\t        } catch (err) {\n467\t            const msg = err instanceof Error ? err.message : String(err);\n468\t            vscode.window.showErrorMessage(`Lattice: Outgoing links lookup failed — ${msg}`);\n469\t        }\n470\t    });\n471\t\n472\t    const findStaleDocsCmd = vscode.commands.registerCommand('lattice.findStaleDocs', async () => {\n473\t        if (!daemon || daemon.getStatus() !== 'running') {\n474\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n475\t            return;\n476\t        }\n477\t\n478\t        const staleInputs = await collectStaleDocInputs(vscode.window.activeTextEditor);\n479\t        if (staleInputs.files.length === 0 && staleInputs.symbols.length === 0) {\n480\t            vscode.window.showInformationMessage(\n481\t                'Lattice: No git diff or