csCapsuleCmd,\n531\t        backlinksCmd,\n532\t        outgoingLinksCmd,\n533\t        findStaleDocsCmd,\n534\t        openDocsWorkbenchCmd\n535\t    );\n536\t}\n537\t\n538\texport function deactivate() {\n539\t    console.log('Lattice extension deactivating...');\n540\t    if (daemon) {\n541\t        daemon.dispose();\n542\t        daemon = undefined;\n543\t    }\n544\t}\n545\t\n546\tasync function callTool(\n547\t    daemonManager: DaemonManager,\n548\t    name: string,\n549\t    args: Record<string, unknown>,\n550\t    timeoutMs = 120_000\n551\t): Promise<unknown> {\n552\t    const response = await daemonManager.sendRequest('tools/call', {\n553\t        name,\n554\t        arguments: args,\n555\t    }, timeoutMs) as McpToolResponse;\n556\t\n557\t    const text = response.content?.find((item) => item.type === 'text')?.text;\n558\t    if (typeof text !== 'string') {\n559\t        throw new Error(`Unexpected response payload from ${name}`);\n560\t    }\n561\t\n562\t    try {\n563\t        return JSON.parse(text) as unknown;\n564\t    } catch {\n565\t        return text;\n566\t    }\n567\t}\n568\t\n569\tfunction showToolResult(\n570\t    outputChannel: vscode.OutputChannel,\n571\t    title: string,\n572\t    result: unknown\n573\t): void {\n574\t    rememberContextHandle(result);\n575\t\n576\t    outputChannel.clear();\n577\t    outputChannel.appendLine(title);\n578\t    outputChannel.appendLine('='.repeat(title.length));\n579\t    outputChannel.appendLine('');\n580\t    if (lastContextHandle && hasContextHandle(result)) {\n581\t        outputChannel.appendLine(`Context handle: ${lastContextHandle}`);\n582\t        if (lastContextOrigin) {\n583\t            outputChannel.appendLine(`Context origin: ${lastContextOrigin}`);\n584\t        }\n585\t        outputChannel.appendLine('');\n586\t    }\n587\t    outputChannel.appendLine(\n588\t        typeof result === 'string' ? result : JSON.stringify(result, null, 2)\n589\t    );\n590\t    outputChannel.show(true);\n591\t}\n592\t\n593\tfunction getActiveEditorFile(): string | undefined {\n594\t    const editor = vscode.window.activeTextEditor;\n595\t    if (!editor || editor.document.uri.scheme !== 'file') {\n596\t        return undefined;\n597\t    }\n598\t\n599\t    return toRelativeWorkspacePath(editor.document.uri);\n600\t}\n601\t\n602\tfunction collectVisibleEditorFiles(): string[] {\n603\t    const files = new Set<string>();\n604\t    for (const editor of vscode.window.visibleTextEditors) {\n605\t        if (editor.document.uri.scheme !== 'file') {\n606\t            continue;\n607\t        }\n608\t        files.add(toRelativeWorkspacePath(editor.document.uri));\n609\t    }\n610\t    return Array.from(files);\n611\t}\n612\t\n613\tfunction getFocusedEditorSymbol(editor: vscode.TextEditor | undefined): string | undefined {\n614\t    if (!editor) {\n615\t        return undefined;\n616\t    }\n617\t\n618\t    const selectionText = editor.document.getText(editor.selection).trim();\n619\t    if (selectionText && isCompactSymbol(selectionText)) {\n620\t        return selectionText;\n621\t    }\n622\t\n623\t    const wordRange = editor.document.getWordRangeAtPosition(editor.selection.active);\n624\t    if (!wordRange) {\n625\t        return undefined;\n626\t    }\n627\t\n628\t    const word = editor.document.getText(wordRange).trim();\n629\t    return isCompactSymbol(word) ? word : undefined;\n630\t}\n631\t\n632\tfunction getSelectedEditorText(editor: vscode.TextEditor | undefined): string | undefined {\n633\t    if (!editor || editor.selection.isEmpty) {\n634\t        return undefined;\n635\t    }\n636\t\n637\t    const text = editor.document.getText(editor.selection).trim();\n638\t    return text || undefined;\n639\t}\n640\t\n641\tfunction isCompactSymbol(value: string): boolean {\n642\t    return value.length >= 2 && value.length <= 120 && /^[A-Za-z_][\\w.$:-]*$/.test(value);\n643\t}\n644\t\n645\tfunction hasContextHandle(result: unknown): result is { context_handle: string } {\n646\t    if (!result || typeof result !== 'object') {\n647\t        return false;\n648\t    }\n649\t\n650\t    return typeof (result as { context_handle?: unknown }).context_handle === 'string';\n651\t}\n652\t\n653\tfunction rememberContextHandle(result: unknown): void {\n654\t    if (!result || typeof result !== 'object') {\n655\t        return;\n656\t    }\n657\t\n658\t    const contextHandle = (result as { context_handle?: unknown }).context_handle;\n659\t    if (typeof contextHandle !== 'string') {\n660\t        return;\n661\t    }\n662\t\n663\t    lastContextHandle = contextHandle;\n664\t    const contextOrigin = (result as { context_origin?: unknown }).context_origin;\n665\t    lastContextOrigin = typeof contextOrigin === 'string' ? contextOrigin : undefined;\n666\t}\n667\t\n668\tfunction getWorkspaceRoot(editor: vscode.TextEditor | undefined): string | undefined {\n669\t    const folder = editor ? vscode.workspace.getWorkspaceFolder(editor.document.uri) : undefined;\n670\t    return folder?.uri.fsPath ?? vscode.workspace.workspaceFolders?.[0]?.uri.fsPath;\n671\t}\n672\t\n673\tfunction toRelativeWorkspacePath(uri: vscode.Uri): string {\n674\t    return vscode.workspace.asRelativePath(uri, false).replace(/\\\\/g, '/');\n675\t}\n676\t\n677\tfunction inferDocsTargetFromEditor(editor: vscode.TextEditor | undefined): DocsTargetSelection | undefined {\n678\t    const focusedSymbol = getFocusedEditorSymbol(editor);\n679\t    if (focusedSymbol) {\n680\t        return {\n681\t            target: focusedSymbol,\n682\t            kind: 'symbol',\n683\t            label: focusedSymbol,\n684\t        };\n685\t    }\n686\t\n687\t    const docsTarget = inferDocsFileOrSectionTarget(editor);\n688\t    if (docsTarget) {\n689\t        return docsTarget;\n690\t    }\n691\t\n692\t    const activeFile = getActiveEditorFile();\n693\t    if (!activeFile) {\n694\t        return undefined;\n695\t    }\n696\t\n697\t    return {\n698\t        target: activeFile,\n699\t        kind: 'file',\n700\t        label: activeFile,\n701\t    };\n702\t}\n703\t\n704\tfunction inferDocsFileOrSectionTarget(editor: vscode.TextEditor | undefined): DocsTargetSelection | undefined {\n705\t    if (!editor || editor.document.uri.scheme !== 'file') {\n706\t        return undefined;\n707\t    }\n708\t\n709\t    const file = toRelativeWorkspacePath(editor.document.uri);\n710\t    const isMarkdown = editor.document.languageId === 'markdown' || file.endsWith('.md');\n711\t    if (!isMarkdown) {\n712\t        return {\n713\t            target: file,\n714\t            kind: 'file',\n715\t            label: file,\n716\t        };\n717\t    }\n718\t\n719\t    const sectionTitle = getCurrentMarkdownHeading(editor);\n720\t    if (sectionTitle) {\n721\t        return {\n722\t            target: `${file}#${sectionTitle}`,\n723\t            kind: 'section',\n724\t            label: `${file}#${sectionTitle}`,\n725\t        };\n726\t    }\n727\t\n728\t    return {\n729\t        target: file,\n730\t        kind: 'file',\n731\t        label: file,\n732\t    };\n733\t}\n734\t\n735\tfunction getCurrentMarkdownHeading(editor: vscode.TextEditor): string | undefined {\n736\t    for (let line = editor.selection.active.line; line >= 0; line--) {\n737\t        const text = editor.document.lineAt(line).text.trim();\n738\t        const match = text.match(/^#{1,6}\\s+(.+?)\\s*#*$/);\n739\t        if (match?.[1]) {\n740\t            return match[1].trim();\n741\t        }\n742\t    }\n743\t\n744\t    return undefined;\n745\t}\n746\t\n747\tasync function promptForDocsTarget(prompt: string): Promise<DocsTargetSelection | undefined> {\n748\t    const target = await vscode.window.showInputBox({\n749\t        prompt,\n750\t        placeHolder: 'e.g. loginUser or docs/auth-guide.md#Login Flow',\n751\t        ignoreFocusOut: true,\n752\t    });\n753\t    if (!target || !target.trim()) {\n754\t        return undefined;\n755\t    }\n756\t\n757\t    return {\n758\t        target: target.trim(),\n759\t        kind: 'auto',\n760\t        label: target.trim(),\n761\t    };\n762\t}\n763\t\n764\tasync function collectStaleDocInputs(\n765\t    editor: vscode.TextEditor | undefined\n766\t): Promise<{ files: string[]; symbols: string[]; source: string }> {\n767\t    const workspaceRoot = getWorkspaceRoot(editor);\n768\t    const focusedSymbol = getFocusedEditorSymbol(editor);\n769\t    const activeFile = editor && editor.document.uri.scheme === 'file'\n770\t        ? toRelativeWorkspacePath(editor.document.uri)\n771\t        : undefined;\n772\t\n773\t    if (workspaceRoot) {\n774\t        const gitChanged = await getPreferredGitChangedFiles(workspaceRoot).catch(() => undefined);\n775\t        if (gitChanged && gitChanged.files.length > 0) {\n776\t            return {\n777\t                files: gitChanged.files,\n778\t                symbols: focusedSymbol ? [focusedSymbol] : [],\n779\t                source: gitChanged.source,\n780\t            };\n781\t        }\n782\t    }\n783\t\n784\t    return {\n785\t        files: activeFile ? [activeFile] : [],\n786\t        symbols: focusedSymbol ? [focusedSymbol] : [],\n787\t        source: activeFile ? `active file ${activeFile}` : 'current editor context',\n788\t    };\n789\t}\n790\t\n791\tasync function getPreferredGitDiff(cwd: string): Promise<{ diff: string; source: string }> {\n792\t    const stagedDiff = await runExecFile('git', ['diff', '--cached', '--no-ext-diff', '--unified=3'], cwd)\n793\t        .catch(() => '');\n794\t    if (stagedDiff.trim()) {\n795\t        return { diff: stagedDiff, source: 'staged diff' };\n796\t    }\n797\t\n798\t    const workingDiff = await runExecFile('git', ['diff', '--no-ext-diff', '--unified=3'], cwd)\n799\t        .catch(() => '');\n800\t    if (workingDiff.trim()) {\n801\t        return { diff: workingDiff, source: 'working tree diff' };\n802\t    }\n803\t\n804\t    throw new Error('No staged or working tree diff found');\n805\t}\n806\t\n807\tasync function getPreferredGitChangedFiles(cwd: string): Promise<GitChangedFiles> {\n808\t    const stagedFiles = await runExecFile('git', ['diff', '--cached', '--name-only'], cwd)\n809\t        .catch(() => '');\n810\t    const parsedStaged = parseGitChangedFiles(stagedFiles);\n811\t    if (parsedStaged.length > 0) {\n812\t        return { files: parsedStaged, source: 'staged diff' };\n813\t    }\n814\t\n815\t    const workingFiles = await runExecFile('git', ['diff', '--name-only'], cwd)\n816\t        .catch(() => '');\n817\t    const parsedWorking = parseGitChangedFiles(workingFiles);\n818\t    if (parsedWorking.length > 0) {\n819\t        return { files: parsedWorking, source: 'working tree diff' };\n820\t    }\n821\t\n822\t    throw new Error('No staged or working tree diff found');\n823\t}\n824\t\n825\tfunction parseGitChangedFiles(stdout: string): string[] {\n826\t    const seen = new Set<string>();\n827\t    const files: string[] = [];\n828\t\n829\t    for (const line of stdout.split(/\\r?\\n/)) {\n830\t        const trimmed = line.trim().replace(/\\\\/g, '/');\n831\t        if (!trimmed || seen.has(trimmed)) {\n832\t            continue;\n833\t        }\n834\t        seen.add(trimmed);\n835\t        files.push(trimmed);\n836\t    }\n837\t\n838\t    return files;\n839\t}\n840\t\n841\tfunction runExecFile(command: string, args: string[], cwd: string): Promise<string> {\n842\t    return new Promise((resolve, reject) => {\n843\t        cp.execFile(\n844\t            command,\n845\t            args,\n846\t            {\n847\t                cwd,\n848\t                encoding: 'utf8',\n849\t                maxBuffer: 5 * 1024 * 1024,\n850\t            },\n851\t            (error, stdout, stderr) => {\n852\t                if (error) {\n853\t                    reject(new Error(stderr.trim() || error.message));\n854\t                    return;\n855\t                }\n856\t                resolve(stdout);\n857\t            }\n858\t        );\n859\t    });\n860\t}\n861\t"}]},"parent_tool_use_id":"toolu_01BbdQyD8