{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WaLNsjWtSExBVQdTNXa5kQ","type":"tool_result","content":"1\tuse serde_json::{json, Value};\n2\tuse std::collections::HashSet;\n3\tuse std::path::PathBuf;\n4\tuse std::sync::atomic::{AtomicBool, Ordering};\n5\tuse std::sync::{Arc, OnceLock};\n6\tuse tokio::sync::Mutex;\n7\tuse tokio::sync::MutexGuard;\n8\t\n9\tuse lattice_core::embeddings::EmbeddingEngine;\n10\tuse lattice_core::graph::model::{CodeGraph, GraphNode};\n11\tuse lattice_core::indexer::Indexer;\n12\tuse lattice_core::intelligence::{\n13\t    diagnose_failure, expand_context, find_relevant_tests, find_stale_docs, get_backlinks,\n14\t    get_docs_capsule, get_outgoing_links, get_repo_playbook, get_working_set_context,\n15\t    impact_from_diff, plan_edit, prepare_change, summarize_subsystem, trace_scenario, BundleMode,\n16\t    DiffImpactReport, DocsTargetKind, ExpandContextSeed, FailureDiagnosis, MemoryHighlight,\n17\t    PlanEditBundle, RepoPlaybook, RulesDetector, ScenarioTraceBundle, SubsystemSummary, TaskBundle,\n18\t    WorkingSetContext,\n19\t};\n20\tuse lattice_core::memory::model::MemoryStructuredFields;\n21\tuse lattice_core::memory::{Memory, MemoryScope, MemoryStore, MemoryType};\n22\tuse lattice_core::query::{ContextCapsule, QueryEngine};\n23\tuse lattice_core::security::SecurityFilter;\n24\tuse lattice_core::storage::{GraphStore, SharedVectorIndex};\n25\tuse lattice_core::symbols::stable_file_handle;\n26\tuse lattice_core::watcher::should_index_file;\n27\tuse lattice_core::workspace::WorkspaceManager;\n28\t\n29\tuse super::context_cache::ContextHandleCache;\n30\tuse super::server::RequestHandler;\n31\tuse super::session_metrics::{SessionMetrics, SessionMetricsReport, ToolCallMetadata};\n32\t\n33\t/// MCP (Model Context Protocol) handler that routes JSON-RPC methods\n34\t/// to the appropriate tool implementations.\n35\tpub struct McpHandler {\n36\t    engine: Arc<Mutex<QueryEngine>>,\n37\t    indexer: Arc<Mutex<Indexer>>,\n38\t    memory_store: Arc<Mutex<MemoryStore>>,\n39\t    graph_store: Arc<Mutex<GraphStore>>,\n40\t    embedding_engine: Arc<OnceLock<Arc<EmbeddingEngine>>>,\n41\t    vector_index: Option<SharedVectorIndex>,\n42\t    workspace_root: PathBuf,\n43\t    session_id: String,\n44\t    #[allow(dead_code)]\n45\t    workspace_manager: Option<Arc<Mutex<WorkspaceManager>>>,\n46\t    workspace_roots: Vec<PathBuf>,\n47\t    indexing: Arc<AtomicBool>,\n48\t    context_cache: Arc<Mutex<ContextHandleCache>>,\n49\t    session_metrics: Arc<Mutex<SessionMetrics>>,\n50\t}\n51\t\n52\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n53\tenum RequestedBundleMode {\n54\t    Auto,\n55\t    Compact,\n56\t    Full,\n57\t}\n58\t\n59\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n60\tenum WorkflowBudget {\n61\t    Auto,\n62\t    Tiny,\n63\t    Compact,\n64\t    Full,\n65\t}\n66\t\n67\timpl WorkflowBudget {\n68\t    fn as_str(self) -> &'static str {\n69\t        match self {\n70\t            WorkflowBudget::Auto => \"auto\",\n71\t            WorkflowBudget::Tiny => \"tiny\",\n72\t            WorkflowBudget::Compact => \"compact\",\n73\t            WorkflowBudget::Full => \"full\",\n74\t        }\n75\t    }\n76\t}\n77\t\n78\tconst TINY_WORKFLOW_TOKEN_CAP: usize = 260;\n79\tconst COMPACT_WORKFLOW_TOKEN_CAP: usize = 850;\n80\tconst FULL_WORKFLOW_TOKEN_CAP: usize = 2600;\n81\t\n82\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n83\tenum WorkflowWireFormat {\n84\t    Auto,\n85\t    Standard,\n86\t    Dense,\n87\t}\n88\t\n89\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n90\tenum WorkflowRenderMode {\n91\t    Json,\n92\t    Markdown,\n93\t    Hybrid,\n94\t}\n95\t\n96\t#[derive(Debug, Clone)]\n97\tstruct WorkflowResponseOptions {\n98\t    budget: WorkflowBudget,\n99\t    max_tokens: Option<usize>,\n100\t    wire_format: WorkflowWireFormat,\n101\t    render: WorkflowRenderMode,\n102\t}\n103\t\n104\t#[derive(Debug, Clone)]\n105\tstruct WorkflowRunMetadata {\n106\t    delivery_mode: String,\n107\t    wire_format: String,\n108\t    single_anchor_used: bool,\n109\t    _mode_reason: String,\n110\t    semantic_fallback_used: bool,\n111\t    outcome_memory_reuse_count: usize,\n112\t}\n113\t\n114\t#[derive(Debug, Clone, Copy, Default)]\n115\tstruct SessionPruningProfile {\n116\t    prefer_tiny: bool,\n117\t    prune_memory_highlights: bool,\n118\t    prefer_dense: bool,\n119\t}\n120\t\n121\tstruct StatusSnapshot {\n122\t    stats: lattice_core::graph::GraphStats,\n123\t    languages: Option<std::collections::HashMap<String, usize>>,\n124\t}\n125\t\n126\timpl McpHandler {\n127\t    /// Create a new McpHandler with all shared state.\n128\t    pub fn new(\n129\t        engine: Arc<Mutex<QueryEngine>>,\n130\t        indexer: Arc<Mutex<Indexer>>,\n131\t        memory_store: Arc<Mutex<MemoryStore>>,\n132\t        graph_store: Arc<Mutex<GraphStore>>,\n133\t        embedding_engine: Arc<OnceLock<Arc<EmbeddingEngine>>>,\n134\t        vector_index: Option<SharedVectorIndex>,\n135\t        workspace_root: PathBuf,\n136\t        context_cache_path: PathBuf,\n137\t        session_id: String,\n138\t        workspace_manager: Option<Arc<Mutex<WorkspaceManager>>>,\n139\t        workspace_roots: Vec<PathBuf>,\n140\t        indexing: Arc<AtomicBool>,\n141\t    ) -> Self {\n142\t        Self {\n143\t            engine,\n144\t            indexer,\n145\t            memory_store,\n146\t            graph_store,\n147\t            embedding_engine,\n148\t            vector_index,\n149\t            workspace_root,\n150\t            session_id,"}]},"parent_tool_use_id":"toolu_01RDjDdnJFRiz86tbrxskniG","session_id":"88204e0b-a61b-4ed7-ba98-4fcc53be0768","uuid":"2d1a9a2c-aca6-4932-9275-47344452d6d4","timestamp":"2026-05-17T02:18:23.220Z","subagent_type":"Explore","task_description":"Explore daemon architecture"}
