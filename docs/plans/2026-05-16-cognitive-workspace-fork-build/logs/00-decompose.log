{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CXHfZ65QubynLBuMxihNQL","type":"tool_result","content":"1\tuse anyhow::{Context, Result};\n2\tuse ndarray::Array2;\n3\tuse ort::session::Session;\n4\tuse ort::value::Tensor;\n5\tuse std::sync::Mutex;\n6\tuse tokenizers::Tokenizer;\n7\t\n8\tpub struct EmbeddingEngine {\n9\t    session: Mutex<Session>,\n10\t    tokenizer: Tokenizer,\n11\t}\n12\t\n13\timpl EmbeddingEngine {\n14\t    /// Create a new EmbeddingEngine by loading an ONNX model and its associated tokenizer.\n15\t    ///\n16\t    /// The `model_path` should point to an ONNX model file (e.g., all-MiniLM-L6-v2.onnx).\n17\t    /// The tokenizer.json file is expected to be in the same directory as the model.\n18\t    pub fn new(model_path: &str) -> Result<Self> {\n19\t        let session = Session::builder()\n20\t            .map_err(|e| anyhow::anyhow!(\"Failed to create session builder: {}\", e))?\n21\t            .with_intra_threads(4)\n22\t            .map_err(|e| anyhow::anyhow!(\"Failed to set intra threads: {}\", e))?\n23\t            .commit_from_file(model_path)\n24\t            .map_err(|e| anyhow::anyhow!(\"Failed to load ONNX model: {}\", e))?;\n25\t\n26\t        let model_dir = std::path::Path::new(model_path)\n27\t            .parent()\n28\t            .unwrap_or(std::path::Path::new(\".\"));\n29\t        let tokenizer_path = model_dir.join(\"tokenizer.json\");\n30\t        let tokenizer = Tokenizer::from_file(&tokenizer_path)\n31\t            .map_err(|e| anyhow::anyhow!(\"Failed to load tokenizer: {}\", e))?;\n32\t\n33\t        Ok(Self {\n34\t            session: Mutex::new(session),\n35\t            tokenizer,\n36\t        })\n37\t    }\n38\t\n39\t    /// Embed a single text string, returning a 384-dimensional L2-normalized vector.\n40\t    pub fn embed(&self, text: &str) -> Result<Vec<f32>> {\n41\t        let batch = self.embed_batch(&[text])?;\n42\t        Ok(batch.into_iter().next().unwrap())\n43\t    }\n44\t\n45\t    /// Embed a batch of text strings, returning a vector of 384-dimensional L2-normalized vectors.\n46\t    ///\n47\t    /// Uses mean pooling with attention mask and L2 normalization.\n48\t    pub fn embed_batch(&self, texts: &[&str]) -> Result<Vec<Vec<f32>>> {\n49\t        let batch_size = texts.len();\n50\t        if batch_size == 0 {\n51\t            return Ok(Vec::new());\n52\t        }\n53\t\n54\t        // 1. Tokenize batch\n55\t        let encodings = self\n56\t            .tokenizer\n57\t            .encode_batch(texts.to_vec(), true)\n58\t            .map_err(|e| anyhow::anyhow!(\"Tokenization failed: {}\", e))?;\n59\t\n60\t        // 2. Find max sequence length and build padded input arrays\n61\t        let max_len = encodings\n62\t            .iter()\n63\t            .map(|e| e.get_ids().len())\n64\t            .max()\n65\t            .unwrap_or(0);\n66\t\n67\t        let mut input_ids_data = vec![0i64; batch_size * max_len];\n68\t        let mut attention_mask_data = vec![0i64; batch_size * max_len];\n69\t        let mut token_type_ids_data = vec![0i64; batch_size * max_len];\n70\t\n71\t        for (i, encoding) in encodings.iter().enumerate() {\n72\t            let ids = encoding.get_ids();\n73\t            let mask = encoding.get_attention_mask();\n74\t            let type_ids = encoding.get_type_ids();\n75\t            let seq_len = ids.len();\n76\t\n77\t            for j in 0..seq_len {\n78\t                input_ids_data[i * max_len + j] = ids[j] as i64;\n79\t                attention_mask_data[i * max_len + j] = mask[j] as i64;\n80\t                token_type_ids_data[i * max_len + j] = type_ids[j] as i64;"}]},"parent_tool_use_id":"toolu_01RDjDdnJFRiz86tbrxskniG","session_id":"88204e0b-a61b-4ed7-ba98-4fcc53be0768","uuid":"7fafd913-51a2-4761-b553-ad5f4c93509b","timestamp":"2026-05-17T02:19:09.959Z","subagent_type":"Explore","task_description":"Explore daemon architecture"}
