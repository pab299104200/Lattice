{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FLHG2SfB7Zg8KJw6EN2dAQ","type":"tool_result","content":"1\tuse std::collections::{HashMap, HashSet};\n2\tuse std::sync::{Arc, Mutex};\n3\t\n4\tuse crate::graph::model::{CodeGraph, EdgeKind, GraphNode};\n5\tuse crate::memory::MemoryStore;\n6\tuse crate::storage::{SharedVectorIndex, VectorScope, VectorSearchResult};\n7\tuse crate::symbols::{SymbolId, SymbolKind};\n8\t\n9\tuse super::capsule::{CapsuleStats, ContextCapsule, ContextNode, PivotNode, QueryIntent};\n10\tuse super::intent::{detect_intent, IntentParams};\n11\t\n12\t/// Token estimation: ~4 characters per token.\n13\tconst CHARS_PER_TOKEN: usize = 4;\n14\t\n15\t/// Engine version for diagnosing binary freshness.\n16\tconst ENGINE_VERSION: &str = \"v31\";\n17\t\n18\t/// Stop words excluded from the negative keyword signal.\n19\t/// These are too generic to carry semantic meaning in symbol names\n20\t/// (e.g., \"get_user\" — \"get\" shouldn't penalize a match on \"user\").\n21\t/// Includes common verbs, prepositions, programming primitives, and\n22\t/// generic qualifiers that don't indicate domain subsystems.\n23\tconst NAME_STOP_WORDS: &[&str] = &[\n24\t    // Common verbs / actions\n25\t    \"get\", \"set\", \"new\", \"run\", \"do\", \"is\", \"has\", \"can\", \"to\", \"from\", \"add\", \"del\", \"put\", \"all\",\n26\t    \"try\", \"with\", \"into\", \"init\", \"make\", \"create\", \"update\", \"delete\", \"remove\", \"handle\",\n27\t    \"process\", \"check\", \"test\", \"build\", \"parse\", \"load\", \"save\", \"read\", \"write\", \"find\", \"list\",\n28\t    \"show\", \"send\", \"call\", \"start\", \"stop\", \"open\", \"close\", \"done\", \"apply\", \"emit\", \"register\",\n29\t    \"ensure\", // Prepositions / articles / conjunctions\n30\t    \"by\", \"in\", \"on\", \"of\", \"for\", \"the\", \"and\", \"or\", \"at\", \"as\",\n31\t    // Generic qualifiers / modifiers\n32\t    \"current\", \"info\", \"item\", \"self\", \"this\", \"that\", \"level\", \"data\", \"name\", \"id\", \"ids\", \"key\",\n33\t    \"val\", \"value\", \"result\", \"error\", \"endpoint\", \"params\", \"args\", \"options\", \"config\", \"state\",\n34\t    \"status\", \"count\", \"index\", \"size\", \"total\", \"raw\", \"base\", \"node\", \"entry\", \"record\", \"row\",\n35\t    \"col\", \"field\", // Programming language keywords / primitives\n36\t    \"type\", \"async\", \"await\", \"impl\", \"func\", \"def\", \"class\", \"pub\", \"fn\", \"mut\", \"ref\", \"var\",\n37\t    \"let\", \"const\", \"return\", \"export\", \"default\", \"int\", \"str\", \"bool\", \"num\", \"obj\", \"err\",\n38\t    \"ctx\",\n39\t];\n40\t\n41\t/// Queries with these keywords are asking for docs-first results rather than\n42\t/// source-first implementation context.\n43\tconst DOCUMENT_RESULT_QUERY_KEYWORDS: &[&str] = &[\n44\t    \"docs\",\n45\t    \"documentation\",\n46\t    \"document\",\n47\t    \"markdown\",\n48\t    \"readme\",\n49\t    \"guide\",\n50\t    \"manual\",\n51\t    \"runbook\",\n52\t    \"adr\",\n53\t    \"section\",\n54\t    \"sections\",\n55\t];\n56\t\n57\tconst FILE_SUMMARY_VECTOR_NAME: &str = \"file_summary\";\n58\tconst FILE_SUMMARY_VECTOR_OFFSET: usize = usize::MAX;\n59\t\n60\t/// A candidate node with its computed score for ranking.\n61\tstruct ScoredCandidate<'a> {\n62\t    node: &'a GraphNode,\n63\t    score: f64,\n64\t    _semantic_sim: f64,\n65\t    /// Whether this node was a direct seed hit (keyword/semantic match)\n66\t    /// vs reached only through graph traversal.\n67\t    is_seed_hit: bool,\n68\t    /// How this node was reached (e.g., \"semantic_match: 0.91\" or \"called_by: loginUser\").\n69\t    relationship_detail: String,\n70\t}\n71\t\n72\t/// The query engine orchestrates intent detection, search, graph traversal,\n73\t/// ranking, and budget allocation to produce Context Capsules.\n74\tpub struct QueryEngine {\n75\t    graph: CodeGraph,\n76\t    vector_index: Option<SharedVectorIndex>,\n77\t    memory_store: Option<Arc<Mutex<MemoryStore>>>,\n78\t    query_history: HashMap<String, usize>,\n79\t}\n80\t\n81\timpl QueryEngine {\n82\t    /// Create a new QueryEngine with a code graph, optional vector store,\n83\t    /// and optional memory store.\n84\t    pub fn new(\n85\t        graph: CodeGraph,\n86\t        vector_index: Option<SharedVectorIndex>,\n87\t        memory_store: Option<Arc<Mutex<MemoryStore>>>,\n88\t    ) -> Self {\n89\t        Self {\n90\t            graph,\n91\t            vector_index,\n92\t            memory_store,\n93\t            query_history: HashMap::new(),\n94\t        }\n95\t    }\n96\t\n97\t    /// Execute a query and produce a Context Capsule.\n98\t    ///\n99\t    /// If `embedding` is provided and a vector store is available, semantic search\n100\t    /// is used. Otherwise, falls back to keyword matching on node names/signatures.\n101\t    pub fn query(\n102\t        &mut self,\n103\t        query_text: &str,\n104\t        embedding: Option<&[f32]>,\n105\t        focused: bool,\n106\t    ) -> ContextCapsule {\n107\t        // Record the query for frequency tracking (adaptive budget)\n108\t        self.record_query(query_text);\n109\t\n110\t        // Step 0: Parse query filters (repo:, file:, lang:)\n111\t        let (filter, clean_query) = parse_query_filters(query_text);\n112\t\n113\t        // Step 1: Detect intent (use clean query without filter tokens)\n114\t        let intent = detect_intent(&clean_query);\n115\t        let params = IntentParams::for_intent(intent);\n116\t        let prefer_markdown_results = query_prefers_markdown_results(&clean_query);\n117\t\n118\t        // Step 2: Semantic search or keyword fallback (use clean query for matching)\n119\t        let mut seed_hits = self.find_seed_hits(&clean_query, embedding, &params, intent);\n120\t"}]},"parent_tool_use_id":"toolu_01RDjDdnJFRiz86tbrxskniG","session_id":"88204e0b-a61b-4ed7-ba98-4fcc53be0768","uuid":"86435567-9462-43da-890d-9daceee437e5","timestamp":"2026-05-17T02:18: