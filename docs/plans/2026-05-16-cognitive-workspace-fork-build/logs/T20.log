        "failure_pattern",
        "procedure",
        "preference",
        "architecture_invariant",
        "docs_contract",
        "open_question",
        "counter_memory",
    ];

    /// Return the canonical snake_case wire name used in storage and MCP payloads.
    pub fn as_str(self) -> &'static str {
        match self {
