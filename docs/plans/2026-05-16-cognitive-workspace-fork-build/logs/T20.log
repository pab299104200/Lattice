    72	}
    73	
    74	pub(crate) fn encode_actor(actor: &Actor) -> (&str, Option<&str>) {
    75	    match actor {
    76	        Actor::Assistant { model } => ("assistant", Some(model.as_str())),
    77	        Actor::User => ("user", None),
    78	        Actor::Tool { name } => ("tool", Some(name.as_str())),
    79	        Actor::Daemon => ("daemon", None),
    80	    }
    81	}
    82	
    83	pub(crate) fn decode_actor(
    84	    kind: &str,
    85	    detail: Option<String>,
    86	    column_prefix: &'static str,
    87	) -> Result<Actor, MemoryGraphParseError> {
    88	    let detail_for_error = detail.clone();
    89	    match (kind, detail) {
    90	        ("assistant", Some(model)) => Ok(Actor::Assistant { model }),
    91	        ("user", None) => Ok(Actor::User),
    92	        ("tool", Some(name)) => Ok(Actor::Tool { name }),
    93	        ("daemon", None) => Ok(Actor::Daemon),
    94	        _ => Err(MemoryGraphParseError::InvalidJsonColumn {
    95	            column: column_prefix,
    96	            reason: format!(
    97	                "invalid actor columns: kind `{kind}` detail {:?}",
    98	                detail_for_error.as_deref()
    99	            ),
   100	        }),
   101	    }
   102	}
   103	
   104	pub(crate) fn encode_identity_text(identity: &Identity) -> String {
