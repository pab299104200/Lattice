             EventPayload::MemoryUpdated(_) => EventKind::MemoryUpdated,
             EventPayload::MemoryInvalidated(_) => EventKind::MemoryInvalidated,
             EventPayload::MemoryConsolidated(_) => EventKind::MemoryConsolidated,
