 pub mod proposal;
 pub mod queue;
 pub mod refresh;
diff --git a/daemon/crates/lattice-core/src/events/kinds.rs b/daemon/crates/lattice-core/src/events/kinds.rs
index 304679a762aea0aa36ce6148e7a68deb5cab85de..7298bb21c5cf17143964380b2ee411f7df795ef7
--- a/daemon/crates/lattice-core/src/events/kinds.rs
+++ b/daemon/crates/lattice-core/src/events/kinds.rs
@@ -11,6 +11,12 @@
 /// `TestRunStarted`, `TestRunCompleted`, `DiagnosticObserved`, `UserCorrection`,
 /// `UserPreferenceObserved`, `WorkflowSucceeded`, `WorkflowFailed`, `MemoryCreated`,
 /// `MemoryUpdated`, `MemoryInvalidated`, `MemoryConsolidated`.
