+}
+
+fn diagnostic(id: &str, message: &str) -> EventPayload {
+    EventPayload::DiagnosticObserved(DiagnosticObservedPayload {
+        diagnostic_id: id.to_string(),
+        source_event_id: None,
+        file_id: FileId {
