+/// Payload for `consolidation_failed`.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct ConsolidationFailedPayload {
+    pub job_id: String,
+    pub job_kind: String,
+    pub mode: String,
+    pub model_name: String,
+    pub error_kind: String,
+    pub error_message: String,
+}
+
