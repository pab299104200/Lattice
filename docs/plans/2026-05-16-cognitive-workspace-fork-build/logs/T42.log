 #[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
 #[serde(tag = "kind", content = "payload", rename_all = "snake_case")]
@@ -505,6 +525,7 @@
     MemoryUpdated(MemoryUpdatedPayload),
