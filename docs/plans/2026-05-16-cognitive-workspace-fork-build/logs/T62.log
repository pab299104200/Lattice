            outcome_memory_reuse_count: metadata.outcome_memory_reuse_count,
            timestamp,
        });

        self.update_task_trace(
            tool,
            payload_bytes,
            approx_tokens,
            context_handle,
            context_origin,
            metadata,
            timestamp,
        );
    }

