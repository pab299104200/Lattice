@@ -1,4 +1,5 @@
 use std::collections::HashMap;
+use std::collections::HashSet;
 use std::sync::atomic::{AtomicU64, Ordering};
 use std::sync::{Arc, Mutex};
 
@@ -442,29 +443,65 @@
         summary: &str,
         evidence: &[EventId],
     ) -> Result<EventId, EventWriteError> {
