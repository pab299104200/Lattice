+    Actor, BranchRef, CompactSummary, EventEnvelope, EventKind, EventPayload, EventQuery,
+    EventReader, EventStore, EventWriter, FlushPolicy, PartialEnvelope, QueryOrder, SessionId,
+    TaskId, ToolCalledPayload,
