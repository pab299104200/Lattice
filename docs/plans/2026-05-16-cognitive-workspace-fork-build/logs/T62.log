        context_cache_path.clone(),
        format!("session-test-{suffix}"),
        None,
        vec![workspace_root.clone()],
        Arc::new(AtomicBool::new(false)),
        Some(event_writer),
    );
    (handler, memory_store, event_store, workspace_root, context_cache_path)
}

