    fn all_bundles(&self) -> Vec<WorkflowBundle> {
        vec![
            self.prepare_bundle(),
            self.plan_bundle(),
            self.trace_bundle(),
            self.diagnose_bundle(),
        ]
    }

    fn prepare_bundle(&self) -> WorkflowBundle {
        let mut sink = VecEventSink::default();
        prepare_change::run(WORKSPACE, &self.request, &self.task, &self.capsule, &mut sink)
    }

    fn plan_bundle(&self) -> WorkflowBundle {
        let mut sink = VecEventSink::default();
        plan_edit::run(WORKSPACE, &self.request, &self.plan, &self.capsule, &mut sink)
    }

    fn trace_bundle(&self) -> WorkflowBundle {
        let mut sink = VecEventSink::default();
        trace_scenario::run(
            WORKSPACE,
            &self.request,
            &self.trace,
            &self.capsule.memories,
            &mut sink,
        )
    }

    fn diagnose_bundle(&self) -> WorkflowBundle {
        let mut sink = VecEventSink::default();
        diagnose_failure::run(
            WORKSPACE,
            &self.request,
            &self.diagnosis,
            &self.capsule.memories,
            &mut sink,
        )
    }
