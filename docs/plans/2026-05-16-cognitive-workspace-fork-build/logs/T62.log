+        if let Err(error) = self.workflow_outcome_recorder.record(
+            capture,
+            &mut metrics,
+            tool_name,
+            arguments,
+            result,
+            &tool_result,
+        ) {
             tracing::warn!(tool = tool_name, %error, "failed to capture workflow outcome events");
         }
     }
