+#[tokio::test]
+async fn save_memory_and_verify_explain_emit_linked_outcomes_and_verified_status() {
+    let (handler, _memory_store, event_store, indexer, graph_store, workspace_root, context_cache_path) =
+        build_handler("save-verify");
+    seed_indexed_file(
+        &workspace_root,
+        &indexer,
+        &graph_store,
+        "src/auth.rs",
+        "fn refresh_token() {}\n",
+    )
+    .await;
+    let save = handler
+        .handle(
+            "tools/call",
+            json!({
+                "name": "save_memory",
+                "arguments": {
+                    "content": "refresh token exists",
+                    "memory_class": "Constraint",
+                    "assertion_type": "Constraint",
+                    "scope": "repo",
+                    "confidence": 0.9,
+                    "confidence_reason": "verified from code",
+                    "freshness_policy": "manual_review",
+                    "linked_files": ["src/auth.rs"],
+                    "evidence": [{
+                        "kind": "file",
+                        "reference": "src/auth.rs",
+                        "captured_at": 1
+                    }]
+                }
+            }),
+        )
+        .await
+        .expect("save succeeds");
