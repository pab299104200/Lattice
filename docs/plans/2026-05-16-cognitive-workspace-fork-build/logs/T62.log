+            references: Vec::new(),
+            summary: CompactSummary::new("Patch applied".to_string()).expect("summary"),
+            payload: EventPayload::PatchApplied(lattice_core::events::PatchAppliedPayload {
+                patch_id: "patch-simulated".to_string(),
