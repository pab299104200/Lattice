+                    "memory_class": "constraint",
+                    "scope": "repo",
+                    "confidence": 0.9,
+                    "confidence_reason": "verified from code",
+                    "freshness_policy": "manual_review",
+                    "linked_files": ["src/auth.rs"],
+                    "evidence": [{
+                        "kind": "file",
+                        "reference": "src/auth.rs",
