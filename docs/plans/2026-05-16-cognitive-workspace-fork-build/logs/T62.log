    plan: intelligence::PlanEditBundle,
    trace: intelligence::ScenarioTraceBundle,
    diagnosis: intelligence::FailureDiagnosis,
}

impl Fixture {
    fn new() -> Self {
        let graph = build_graph();
        let capsule = build_capsule();
