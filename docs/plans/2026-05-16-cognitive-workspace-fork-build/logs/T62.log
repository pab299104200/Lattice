+                self.workflow_success_after_first_plan_count as f64
+                    / self.workflow_tasks_with_plan as f64
+            },
             tool_counts: self.tool_counts.clone(),
             recent_tools: self.recent_tools.iter().cloned().collect(),
             recent_tasks: self
