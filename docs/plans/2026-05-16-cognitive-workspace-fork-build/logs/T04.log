+        &fixture.rules,
+        BundleMode::Compact,
+    )
+}
+
+fn expand_context_report(fixture: &BenchmarkFixture) -> ExpandedContext {
+    let focus = fixture
+        .expand_seed
+        .symbols
+        .first()
+        .expect("expand seed symbol")
+        .clone();
+    expand_context(&fixture.graph, &fixture.expand_seed, &focus, 1200)
+}
