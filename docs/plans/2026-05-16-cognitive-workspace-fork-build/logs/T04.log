enum ExpansionTarget {
    SymbolId(SymbolId),
    Symbol(String),
    File(String),
    Test(String),
    Memory(usize),
}

impl ExpansionTarget {
    fn kind(&self) -> &'static str {
        match self {
            Self::SymbolId(_) => "symbol",
            Self::Symbol(_) => "symbol",
            Self::File(_) => "file",
            Self::Test(_) => "test",
            Self::Memory(_) => "memory",
        }
    }
}

