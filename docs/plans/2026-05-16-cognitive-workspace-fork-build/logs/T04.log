+}\n",
+        ),
+        (
+            "src/routes/auth.ts",
+            "import { loginUser } from '../auth';\n\
+\n\
+export async function loginRoute(request: { email: string; password: string }) {\n\
+  return loginUser(request.email, request.password);\n\
+}\n",
+        ),
+        (
+            "src/security/password.ts",
