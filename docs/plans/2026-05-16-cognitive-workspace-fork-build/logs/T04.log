                json!({
                    "symbol": n.name,
                    "kind": n.kind.short_code(),
                    "line": n.line,
                    "exported": n.is_exported,
                    "dependents": dep_count
                })
            })
            .collect();

        Ok(wrap_tool_result(json!({
            "file": file,
            "symbols": symbols,
            "count": symbols.len()
        })))
    }

