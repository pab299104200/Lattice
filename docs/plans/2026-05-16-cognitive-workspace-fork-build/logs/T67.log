diff --git a/daemon/crates/lattice-daemon/src/rpc/metrics_surface.rs b/daemon/crates/lattice-daemon/src/rpc/metrics_surface.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7e0d6e8ada43517f072c865b29d5f2cd38869397
