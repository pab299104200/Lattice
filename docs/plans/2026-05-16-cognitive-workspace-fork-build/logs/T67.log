+                    "memory",
+                    &detail.inclusion_reason,
+                    &detail.breakdown,
+                )],
+            };
+            let handle = self.store_context_handle("relevance_detail", seed).await;
+            memory.relevance_detail_handle = Some(handle.legacy_handle);
+            memory.relevance_detail_focus = Some(focus);
