+            inclusion_reason: "selected for auth change".to_string(),
+            breakdown: workflow_bundle_fixture().ranked_pivots[0]
+                .relevance_breakdown
+                .clone()
+                .unwrap_or_else(|| super::metrics_surface::MetricsSurface::new(
+                    "workspace-main",
+                    fixture_collector(),
+                    None,
+                )
+                .build_call_relevance_report(
+                    "ctx-main",
+                    "prepare_change",
+                    Some("session".to_string()),
+                    &workflow_bundle_fixture(),
+                )
+                .pivots[0]
+                .breakdown
+                .clone()),
+        }],
+        memories: vec![MemoryRelevance {
+            memory_key: "mem-1".to_string(),
+            scope: "repo".to_string(),
+            inclusion_reason: "captured prior auth fix".to_string(),
+            breakdown: super::metrics_surface::MetricsSurface::new(
+                "workspace-main",
+                fixture_collector(),
+                None,
+            )
+            .build_call_relevance_report(
+                "ctx-main",
+                "prepare_change",
+                Some("session".to_string()),
