+#[test]
+fn diagnostic_expansion_handle_seed_dereferences_to_full_breakdown() {
+    let mut cache = ContextHandleCache::new_with_limits(8, Duration::from_secs(60));
+    let detail = detail_payload(
+        "src/lib.rs::login",
+        "pivot:0",
+        "pivot",
+        "selected for auth change",
+        &build_call_report("workspace-main").pivots[0].breakdown,
+    );
+    let record = cache.insert(
+        "relevance_detail",
+        lattice_core::intelligence::ExpandContextSeed {
+            query: Some("login".to_string()),
+            files: vec!["src/lib.rs".to_string()],
+            symbols: vec!["login".to_string()],
+            tests: Vec::new(),
+            memories: vec![detail],
+        },
+        "workspace-main",
+        "session-main",
+    );
+    let cached = cache.get(&record.legacy_handle).expect("cached handle");
+    let graph = lattice_core::graph::model::CodeGraph::default();
+    let expanded = lattice_core::intelligence::expand_context(
+        &graph,
+        &cached.seed,
+        "memory:pivot:0",
+        800,
+    );
+    let relevance = expanded
+        .memories
+        .first()
+        .and_then(|item| item.get("relevance"))
+        .expect("relevance payload");
+    assert!(relevance.get("ranking_signals").is_some());
+}
