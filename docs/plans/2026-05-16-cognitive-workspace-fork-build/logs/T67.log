fn emit_consolidation_proposal_events(
    capture: &EventCapture,
    workspace_id: &str,
    proposals: &[memory_v2::consolidate_session::ConsolidationProposalItem],
) -> Result<(), (i32, String)> {
    for item in proposals {
        let memory_id = MemoryId {
            workspace_id: workspace_id.to_string(),
            ulid: format!("proposed-{}", item.task_id),
        };
        capture
            .record_memory_consolidation_proposed(
                &[],
                memory_id,
                &[],
                &item.summary,
                &item.proposal_id,
                None,
                None,
            )
            .map_err(|error| {
                (
                    -32603,
                    format!("Failed to capture consolidation event: {error}"),
                )
            })?;
    }
    Ok(())
}

fn build_consolidation_report(
    args: memory_v2::consolidate_session::ConsolidateSessionArgs,
    mode: memory_v2::consolidate_session::ConsolidationMode,
    render_mode: memory_v2::consolidate_session::ConsolidationRenderMode,
    proposals: Vec<memory_v2::consolidate_session::ConsolidationProposalItem>,
) -> memory_v2::consolidate_session::ConsolidationReport {
    let episode_ids: Vec<String> = proposals
        .iter()
        .map(|item| item.proposal_id.clone())
        .collect();
    let mut notes = Vec::new();
    if !matches!(
        render_mode,
        memory_v2::consolidate_session::ConsolidationRenderMode::Diagnostic
    ) {
        notes.push(
            "LLM-driven procedure, failure-pattern, supersession, and duplicate proposals were not generated by this bounded manual trigger."
                .to_string(),
        );
    }
    memory_v2::consolidate_session::ConsolidationReport {
        session_id: args.session_id,
        mode,
        render_mode,
        budget_ms: args.budget_ms,
        proposals,
        categories: vec![
            memory_v2::consolidate_session::ConsolidationCategoryReport {
                category: "episode_summary".to_string(),
                proposal_ids: episode_ids,
                note: None,
            },
            memory_v2::consolidate_session::ConsolidationCategoryReport {
                category: "procedure".to_string(),
                proposal_ids: Vec::new(),
                note: Some("No reusable multi-trace procedure candidate was produced by this bounded trigger.".to_string()),
            },
            memory_v2::consolidate_session::ConsolidationCategoryReport {
                category: "failure_pattern".to_string(),
                proposal_ids: Vec::new(),
                note: Some("No failure-pattern cluster was produced by this bounded trigger.".to_string()),
            },
            memory_v2::consolidate_session::ConsolidationCategoryReport {
                category: "supersession_candidate".to_string(),
                proposal_ids: Vec::new(),
                note: Some("No supersession candidate was produced by this bounded trigger.".to_string()),
            },
            memory_v2::consolidate_session::ConsolidationCategoryReport {
                category: "duplicate_detection".to_string(),
                proposal_ids: Vec::new(),
                note: Some("No duplicate-detection proposal was produced by this bounded trigger.".to_string()),
            },
        ],
        incomplete: true,
        notes,
    }
}

fn build_metric_values(
    events: &[lattice_core::events::EventEnvelope],
    requested: Vec<memory_v2::get_memory_metrics::MetricSignal>,
    now: lattice_core::DateTime<lattice_core::Utc>,
) -> Vec<memory_v2::get_memory_metrics::MetricValue> {
    requested
        .into_iter()
        .map(|signal| match signal {
            memory_v2::get_memory_metrics::MetricSignal::ToolCallsPerSuccessfulTask => {
                tool_calls_per_successful_task_metric(events, now)
            }
            memory_v2::get_memory_metrics::MetricSignal::WorkflowSuccessAfterFirstPlan => {
                workflow_success_after_first_plan_metric(events, now)
            }
            other => null_metric(
                other,
                now,
                "Canonical Phase 9 collector is not present for this signal yet.",
            ),
        })
        .collect()
}

fn tool_calls_per_successful_task_metric(
    events: &[lattice_core::events::EventEnvelope],
    now: lattice_core::DateTime<lattice_core::Utc>,
) -> memory_v2::get_memory_metrics::MetricValue {
    let mut per_task: HashMap<String, (u64, bool)> = HashMap::new();
    for event in events {
        let Some(task_id) = event.task_id.as_ref().map(|value| value.value.clone()) else {
            continue;
        };
        let entry = per_task.entry(task_id).or_insert((0, false));
        if event.kind == EventKind::ToolCalled {
            entry.0 += 1;
        }
        if event.kind == EventKind::WorkflowSucceeded {
            entry.1 = true;
        }
    }
    let successful: Vec<u64> = per_task
        .into_values()
        .filter_map(|(tool_calls, succeeded)| succeeded.then_some(tool_calls))
        .collect();
    if successful.is_empty() {
        return null_metric(
            memory_v2::get_memory_metrics::MetricSignal::ToolCallsPerSuccessfulTask,
            now,
            "No successful tasks were found in the bounded fallback event slice.",
        );
    }
    let total: u64 = successful.iter().sum();
    metric_value(
        memory_v2::get_memory_metrics::MetricSignal::ToolCallsPerSuccessfulTask,
        total as f64 / successful.len() as f64,
        Some(successful.len() as u64),
        successful.len() as u64,
        memory_v2::get_memory_metrics::MetricSource::EventLog,
        now,
    )
}

fn workflow_success_after_first_plan_metric(
    events: &[lattice_core::events::EventEnvelope],
    now: lattice_core::DateTime<lattice_core::Utc>,
) -> memory_v2::get_memory_metrics::MetricValue {
    let mut totals = 0_u64;
    let mut successes = 0_u64;
    let grouped = group_events_by_task(events);
    for task_events in grouped.values() {
        let first_plan = task_events
            .iter()
            .position(|event| event.kind == EventKind::PlanCreated);
        let Some(plan_index) = first_plan else {
            continue;
        };
        totals += 1;
        let mut failed_before_success = false;
        let mut succeeded = false;
        for event in task_events.iter().skip(plan_index) {
            match event.kind {
                EventKind::WorkflowFailed => failed_before_success = true,
                EventKind::WorkflowSucceeded => {
                    succeeded = true;
                    break;
                }
                _ => {}
            }
        }
        if succeeded && !failed_before_success {
            successes += 1;
        }
    }
    if totals == 0 {
        return null_metric(
            memory_v2::get_memory_metrics::MetricSignal::WorkflowSuccessAfterFirstPlan,
            now,
            "No planned tasks were found in the bounded fallback event slice.",
        );
    }
    metric_value(
        memory_v2::get_memory_metrics::MetricSignal::WorkflowSuccessAfterFirstPlan,
        successes as f64 / totals as f64,
        Some(totals),
        totals,
        memory_v2::get_memory_metrics::MetricSource::EventLog,
        now,
    )
}

fn group_events_by_task(
    events: &[lattice_core::events::EventEnvelope],
) -> HashMap<String, Vec<lattice_core::events::EventEnvelope>> {
    let mut grouped = HashMap::new();
    for event in events {
        let Some(task_id) = event.task_id.as_ref().map(|value| value.value.clone()) else {
            continue;
        };
        grouped
            .entry(task_id)
            .or_insert_with(Vec::new)
            .push(event.clone());
    }
    grouped
}

fn metric_value(
    signal: memory_v2::get_memory_metrics::MetricSignal,
    value: f64,
    denominator: Option<u64>,
    sample_count: u64,
    source: memory_v2::get_memory_metrics::MetricSource,
    now: lattice_core::DateTime<lattice_core::Utc>,
) -> memory_v2::get_memory_metrics::MetricValue {
    memory_v2::get_memory_metrics::MetricValue {
        signal,
        value: Some(value),
        denominator,
        sample_count,
        source,
        computed_at: now,
        reason_if_null: None,
    }
}

fn null_metric(
    signal: memory_v2::get_memory_metrics::MetricSignal,
    now: lattice_core::DateTime<lattice_core::Utc>,
    reason: &str,
) -> memory_v2::get_memory_metrics::MetricValue {
    memory_v2::get_memory_metrics::MetricValue {
        signal,
        value: None,
        denominator: None,
        sample_count: 0,
        source: memory_v2::get_memory_metrics::MetricSource::Unavailable,
        computed_at: now,
        reason_if_null: Some(reason.to_string()),
    }
}

fn build_event_trace_query(
    args: &memory_v2::get_event_trace::GetEventTraceArgs,
    workspace_id: &str,
    branch: Option<&str>,
    limit: usize,
) -> EventQuery {
    let mut query = match (
        args.task_id.as_ref(),
        args.session_id.as_ref(),
        args.workspace_id.as_ref(),
    ) {
        (Some(task_id), None, None) => EventQuery::new()
            .task(task_id.clone())
            .workspace(workspace_id.to_string()),
        (None, Some(session_id), None) => EventQuery::new()
            .session(session_id.clone())
            .workspace(workspace_id.to_string()),
        (None, None, Some(_)) => EventQuery::new()
            .workspace(workspace_id.to_string())
            .branch(branch.unwrap_or("main").to_string()),
        _ => EventQuery::new()
            .workspace(workspace_id.to_string())
            .branch(branch.unwrap_or("main").to_string()),
    }
    .order(QueryOrder::OldestFirst)
    .limit(limit);
    if !args.kinds.is_empty() {
        query = query.kinds(&args.kinds);
    }
    if let Some(since) = args.since {
        query = query.after(since);
    }
    if let Some(until) = args.until {
        query = query.before(until);
    }
    query
}

fn build_event_trace_page(
    args: memory_v2::get_event_trace::GetEventTraceArgs,
    render_mode: memory_v2::get_event_trace::EventTraceRenderMode,
    events: Vec<lattice_core::events::EventEnvelope>,
    next_cursor_row_id: Option<i64>,
    limit: usize,
) -> memory_v2::get_event_trace::EventTracePage {
    let next_cursor = if events.len() == limit {
        next_cursor_row_id.map(memory_v2::get_event_trace::encode_cursor)
    } else {
        None
    };
    memory_v2::get_event_trace::EventTracePage {
        scope: memory_v2::get_event_trace::EventTraceScope {
            kind: event_trace_scope_kind(&args).to_string(),
            value: args
                .task_id
                .or(args.session_id)
                .or(args.workspace_id)
                .unwrap_or_default(),
        },
        render_mode,
        cursor: args.cursor,
        next_cursor,
        events: events
            .iter()
            .map(|event| memory_v2::get_event_trace::build_entry(event, render_mode))
            .collect(),
    }
}

fn event_trace_scope_kind(args: &memory_v2::get_event_trace::GetEventTraceArgs) -> &'static str {
    if args.task_id.is_some() {
        "task"
    } else if args.session_id.is_some() {
        "session"
    } else {
        "workspace"
    }
}


