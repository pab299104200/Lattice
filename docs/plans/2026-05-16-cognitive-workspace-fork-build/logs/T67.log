fn build_metric_values(
    events: &[lattice_core::events::EventEnvelope],
    requested: Vec<memory_v2::get_memory_metrics::MetricSignal>,
    now: lattice_core::DateTime<lattice_core::Utc>,
) -> Vec<memory_v2::get_memory_metrics::MetricValue> {
    requested
        .into_iter()
        .map(|signal| match signal {
            memory_v2::get_memory_metrics::MetricSignal::ToolCallsPerSuccessfulTask => {
                tool_calls_per_successful_task_metric(events, now)
            }
            memory_v2::get_memory_metrics::MetricSignal::WorkflowSuccessAfterFirstPlan => {
                workflow_success_after_first_plan_metric(events, now)
            }
            other => null_metric(
                other,
                now,
                "Canonical Phase 9 collector is not present for this signal yet.",
            ),
        })
        .collect()
}

fn tool_calls_per_successful_task_metric(
    events: &[lattice_core::events::EventEnvelope],
    now: lattice_core::DateTime<lattice_core::Utc>,
) -> memory_v2::get_memory_metrics::MetricValue {
    let mut per_task: HashMap<String, (u64, bool)> = HashMap::new();
    for event in events {
        let Some(task_id) = event.task_id.as_ref().map(|value| value.value.clone()) else {
            continue;
        };
        let entry = per_task.entry(task_id).or_insert((0, false));
        if event.kind == EventKind::ToolCalled {
            entry.0 += 1;
        }
        if event.kind == EventKind::WorkflowSucceeded {
            entry.1 = true;
        }
    }
    let successful: Vec<u64> = per_task
        .into_values()
        .filter_map(|(tool_calls, succeeded)| succeeded.then_some(tool_calls))
        .collect();
    if successful.is_empty() {
        return null_metric(
            memory_v2::get_memory_metrics::MetricSignal::ToolCallsPerSuccessfulTask,
            now,
            "No successful tasks were found in the bounded fallback event slice.",
        );
    }
    let total: u64 = successful.iter().sum();
    metric_value(
        memory_v2::get_memory_metrics::MetricSignal::ToolCallsPerSuccessfulTask,
        total as f64 / successful.len() as f64,
        Some(successful.len() as u64),
        successful.len() as u64,
        memory_v2::get_memory_metrics::MetricSource::EventLog,
        now,
    )
}

fn workflow_success_after_first_plan_metric(
    events: &[lattice_core::events::EventEnvelope],
    now: lattice_core::DateTime<lattice_core::Utc>,
) -> memory_v2::get_memory_metrics::MetricValue {
    let mut totals = 0_u64;
    let mut successes = 0_u64;
    let grouped = group_events_by_task(events);
    for task_events in grouped.values() {
        let first_plan = task_events
            .iter()
            .position(|event| event.kind == EventKind::PlanCreated);
        let Some(plan_index) = first_plan else {
            continue;
        };
        totals += 1;
        let mut failed_before_success = false;
        let mut succeeded = false;
        for event in task_events.iter().skip(plan_index) {
            match event.kind {
                EventKind::WorkflowFailed => failed_before_success = true,
                EventKind::WorkflowSucceeded => {
                    succeeded = true;
                    break;
                }
                _ => {}
            }
        }
        if succeeded && !failed_before_success {
            successes += 1;
        }
    }
    if totals == 0 {
        return null_metric(
            memory_v2::get_memory_metrics::MetricSignal::WorkflowSuccessAfterFirstPlan,
            now,
            "No planned tasks were found in the bounded fallback event slice.",
        );
    }
    metric_value(
        memory_v2::get_memory_metrics::MetricSignal::WorkflowSuccessAfterFirstPlan,
        successes as f64 / totals as f64,
        Some(totals),
        totals,
        memory_v2::get_memory_metrics::MetricSource::EventLog,
        now,
    )
}

fn group_events_by_task(
    events: &[lattice_core::events::EventEnvelope],
) -> HashMap<String, Vec<lattice_core::events::EventEnvelope>> {
    let mut grouped = HashMap::new();
    for event in events {
        let Some(task_id) = event.task_id.as_ref().map(|value| value.value.clone()) else {
            continue;
        };
        grouped
            .entry(task_id)
            .or_insert_with(Vec::new)
            .push(event.clone());
    }
    grouped
}

fn metric_value(
    signal: memory_v2::get_memory_metrics::MetricSignal,
    value: f64,
    denominator: Option<u64>,
    sample_count: u64,
    source: memory_v2::get_memory_metrics::MetricSource,
    now: lattice_core::DateTime<lattice_core::Utc>,
) -> memory_v2::get_memory_metrics::MetricValue {
    memory_v2::get_memory_metrics::MetricValue {
        signal,
        value: Some(value),
        denominator,
        sample_count,
        source,
        computed_at: now,
        reason_if_null: None,
    }
}

fn null_metric(
    signal: memory_v2::get_memory_metrics::MetricSignal,
    now: lattice_core::DateTime<lattice_core::Utc>,
    reason: &str,
) -> memory_v2::get_memory_metrics::MetricValue {
    memory_v2::get_memory_metrics::MetricValue {
        signal,
        value: None,
        denominator: None,
        sample_count: 0,
        source: memory_v2::get_memory_metrics::MetricSource::Unavailable,
        computed_at: now,
        reason_if_null: Some(reason.to_string()),
    }
}

