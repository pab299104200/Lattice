+            .clone(),
+        }],
+        excluded_high_scoring_candidates: vec![ExcludedCandidate {
+            candidate_key: "context:0".to_string(),
+            kind: "context".to_string(),
+            label: "src/auth.rs".to_string(),
+            rejection_reason: "bounded to supporting context".to_string(),
+            breakdown: super::metrics_surface::MetricsSurface::new(
+                "workspace-main",
