+++ b/daemon/crates/lattice-daemon/src/rpc/metrics_surface_tests.rs
@@ -0,0 +1,369 @@
+use std::time::Duration;
+
+use lattice_core::metrics::{
+    MemorySurfaceRecord, MetricSampleScope, MetricScope, MetricSignal, MetricsCollector,
+};
+use lattice_core::verification::VerificationStatus;
+use serde_json::json;
+
+use super::context_cache::ContextHandleCache;
+use super::memory_v2::get_memory_metrics::{GetMemoryMetricsArgs, MetricRenderMode, MetricSnapshot};
+use super::metrics_surface::{
+    detail_payload, CallRelevanceReport, ExcludedCandidate, MemoryRelevance, MetricsSurface,
+    MetricsSurfaceError, PivotRelevance,
+};
+use super::workflow_v2::{
+    MemoryHighlight, Pivot, RenderChoice, StableIdentity, WorkflowBundle, WorkflowRecord,
+};
+
+#[test]
+fn serde_round_trip_preserves_surface_request_and_response() {
+    let args = GetMemoryMetricsArgs {
+        scope: Some(lattice_core::metrics::MetricScopeKind::Session),
+        time_range: None,
+        signals: MetricSignal::ALL.to_vec(),
+        render_mode: Some(MetricRenderMode::Diagnostic),
+    };
+    let encoded = serde_json::to_string(&args).expect("serialize args");
+    let decoded: GetMemoryMetricsArgs =
+        serde_json::from_str(&encoded).expect("deserialize args");
+    assert_eq!(decoded.signals, MetricSignal::ALL.to_vec());
+
+    let report = build_call_report("workspace-main");
+    let encoded = serde_json::to_string(&report).expect("serialize report");
+    let decoded: CallRelevanceReport =
+        serde_json::from_str(&encoded).expect("deserialize report");
+    assert_eq!(decoded.tool_name, "prepare_change");
+    assert_eq!(decoded.pivots.len(), 1);
+}
+
+#[test]
+fn collect_returns_every_required_metric_signal_variant() {
+    let surface = MetricsSurface::new(
+        "workspace-main",
+        MetricsCollector::new(),
+        None,
+    );
+    let values = surface.collect(MetricScope::session("session-main"), &MetricSignal::ALL);
+    assert_eq!(values.len(), MetricSignal::ALL.len());
+    let returned: Vec<MetricSignal> = values.iter().map(|value| value.signal).collect();
+    assert_eq!(returned, MetricSignal::ALL.to_vec());
+}
+
+#[test]
+fn collect_reports_honest_null_with_reason_when_evidence_is_missing() {
+    let surface = MetricsSurface::new(
+        "workspace-main",
+        MetricsCollector::new(),
+        None,
+    );
+    let values = surface.collect(
+        MetricScope::session("session-main"),
+        &[MetricSignal::MemoryInclusionPrecision],
+    );
+    assert_eq!(values.len(), 1);
+    assert_eq!(values[0].value, None);
+    assert_eq!(values[0].sample_count, 0);
+    assert!(values[0]
+        .reason_if_null
+        .as_deref()
+        .is_some_and(|reason| reason.contains("no retrieved memories matched")));
+}
+
+#[test]
+fn call_relevance_exposes_every_ranking_signal_column() {
+    let bundle = workflow_bundle_fixture();
+    let surface = MetricsSurface::new(
+        "workspace-main",
+        fixture_collector(),
+        None,
+    );
+    let mut writable = surface.clone();
+    let report = writable.build_call_relevance_report(
+        "ctx-main",
+        "prepare_change",
+        Some("session".to_string()),
+        &bundle,
+    );
+    writable.record_call(report);
+    let restored = writable
+        .collect_for_call("ctx-main", "prepare_change")
+        .expect("call report");
+    let payload = serde_json::to_value(&restored.pivots[0].breakdown).expect("serialize");
+    for key in [
+        "task_type_compatibility",
+        "graph_proximity_to_anchors",
+        "exact_identifier_match",
+        "semantic_similarity",
+        "verification_status",
+        "freshness",
+        "scope",
+        "evidence_strength",
+        "contradiction_supersession_state",
+        "past_usefulness",
+        "recent_successful_reuse",
+        "user_preference_compatibility",
+        "token_cost",
+    ] {
+        assert!(
+            payload["ranking_signals"].get(key).is_some(),
+            "missing ranking signal column {key} in {payload:?}"
+        );
+    }
+}
+
+#[test]
+fn compact_mode_digest_is_bounded() {
+    let bundle = workflow_bundle_fixture();
+    let surface = MetricsSurface::new(
+        "workspace-main",
+        fixture_collector(),
+        None,
+    );
+    let report = surface.build_call_relevance_report(
+        "ctx-main",
+        "prepare_change",
+        Some("session".to_string()),
+        &bundle,
+    );
+    let digest = surface.summarize_for_compact_mode(&report.pivots[0].breakdown);
+    assert!(digest.len() <= 160, "digest exceeded bound: {}", digest.len());
+}
+
+#[test]
+fn diagnostic_expansion_handle_seed_dereferences_to_full_breakdown() {
+    let mut cache = ContextHandleCache::new_with_limits(8, Duration::from_secs(60));
+    let detail = detail_payload(
+        "src/lib.rs::login",
+        "pivot:0",
+        "pivot",
+        "selected for auth change",
+        &build_call_report("workspace-main").pivots[0].breakdown,
+    );
+    let record = cache.insert(
+        "relevance_detail",
+        lattice_core::intelligence::ExpandContextSeed {
+            query: Some("login".to_string()),
+            files: vec!["src/lib.rs".to_string()],
+            symbols: vec!["login".to_string()],
+            tests: Vec::new(),
+            memories: vec![detail],
+        },
+        "workspace-main",
+        "session-main",
+    );
+    let cached = cache.get(&record.legacy_handle).expect("cached handle");
+    let graph = lattice_core::graph::model::CodeGraph::default();
+    let expanded = lattice_core::intelligence::expand_context(
+        &graph,
+        &cached.seed,
+        "memory:pivot:0",
+        800,
+    );
+    let relevance = expanded
+        .memories
+        .first()
+        .and_then(|item| item.get("relevance"))
+        .expect("relevance payload");
+    assert!(relevance.get("ranking_signals").is_some());
+}
+
+#[test]
+fn collect_for_call_rejects_cross_workspace_and_scope_reports() {
+    let surface = MetricsSurface::new("workspace-main", fixture_collector(), None);
+
+    let mut wrong_workspace = build_call_report("workspace-other");
+    wrong_workspace.task_id = "ctx-other".to_string();
+    let mut surface_with_workspace_error = surface.clone();
+    surface_with_workspace_error.record_call(wrong_workspace);
+    let error = surface_with_workspace_error
+        .collect_for_call("ctx-other", "prepare_change")
+        .expect_err("cross-workspace must fail");
+    assert!(matches!(
+        error,
+        MetricsSurfaceError::CrossWorkspaceQuery { .. }
+    ));
+
+    let mut wrong_scope = build_call_report("workspace-main");
+    wrong_scope.task_id = "ctx-scope".to_string();
+    wrong_scope.allowed_memory_scopes = vec!["session".to_string()];
+    wrong_scope.memories[0].scope = "repo".to_string();
+    let mut surface_with_scope_error = surface;
+    surface_with_scope_error.record_call(wrong_scope);
+    let error = surface_with_scope_error
+        .collect_for_call("ctx-scope", "prepare_change")
+        .expect_err("cross-scope must fail");
+    assert!(matches!(
+        error,
+        MetricsSurfaceError::CrossScopeQuery { .. }
+    ));
+}
+
+fn fixture_collector() -> MetricsCollector {
+    MetricsCollector::new().with_memory_surface_records(vec![MemorySurfaceRecord {
+        scope: MetricSampleScope {
+            workspace_id: "workspace-main".to_string(),
+            branch: Some("main".to_string()),
+            session_id: Some("session-main".to_string()),
+            user_id: None,
+            organization_id: None,
+            task_id: Some("ctx-main".to_string()),
+            observed_at: lattice_core::Utc::now(),
+        },
+        retrieval_event_id: lattice_core::identity::EventId {
+            workspace_id: "workspace-main".to_string(),
+            ulid: "evt-1".to_string(),
+        },
+        memory_id: lattice_core::identity::MemoryId {
+            workspace_id: "workspace-main".to_string(),
+            ulid: "mem-1".to_string(),
+        },
+        verification_status: VerificationStatus::Verified,
+        stale_label_surfaced: false,
+        contradiction_link_present: false,
+        contradiction_surfaced: false,
+        used_downstream: true,
+        reused_later: true,
+    }])
+}
+
+fn build_call_report(workspace_id: &str) -> CallRelevanceReport {
+    CallRelevanceReport {
+        task_id: "ctx-main".to_string(),
+        tool_name: "prepare_change".to_string(),
+        workspace_id: workspace_id.to_string(),
+        request_scope: Some("session".to_string()),
