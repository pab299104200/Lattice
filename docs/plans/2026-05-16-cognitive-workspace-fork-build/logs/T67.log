use lattice_core::metrics::{MetricScope, MetricSignal, MetricsCollector};

use super::metrics_surface::MetricsSurface;

#[test]
fn metrics_surface_collects_canonical_signals() {
    let surface = MetricsSurface::new("workspace-a", MetricsCollector::new(), None);

    let values = surface.collect(
        MetricScope::session("session-a"),
        &[MetricSignal::RelevantAnchorRecall],
    );

    assert_eq!(values.len(), 1);
    assert_eq!(values[0].signal, MetricSignal::RelevantAnchorRecall);
}

