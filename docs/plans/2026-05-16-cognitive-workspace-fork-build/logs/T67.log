+                memory.relevance_summary =
+                    Some(surface.summarize_for_compact_mode(&detail.breakdown));
+                memory.relevance_breakdown = None;
+            } else {
+                memory.relevance_summary = None;
+                memory.relevance_breakdown = Some(detail.breakdown.clone());
+            }
+        }
