diff --git a/daemon/crates/lattice-core/src/working_memory/operations.rs b/daemon/crates/lattice-core/src/working_memory/operations.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cba28a68b99f984de30ea6ccf2590be6cd105410
