        token_budget: ctx.budget.max_tokens,
        estimated_tokens,
        trimmed_snippets,
        dropped_results,
        truncated: trimmed_snippets > 0
            || dropped_results > 0
            || estimated_tokens > ctx.budget.max_tokens,
    }
}

