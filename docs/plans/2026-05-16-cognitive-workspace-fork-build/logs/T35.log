+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct CompressionOutcome {
+    pub results: Vec<BundleResult>,
+    pub dropped_results: Vec<BundleResult>,
+    pub budget_report: BudgetReport,
