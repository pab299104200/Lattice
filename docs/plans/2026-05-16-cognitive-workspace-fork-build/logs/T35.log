    pub struct BundleResult {
        pub identity: Identity,
        pub kind: IdentityKind,
        pub headline: String,
        pub snippet: String,
        pub inclusion_reason: String,
        pub expansion_handle: String,
        pub source: Vec<CandidateSource>,
        pub score: f32,
    }

