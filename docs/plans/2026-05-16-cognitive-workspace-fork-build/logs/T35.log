 pub use state::{
     initialize_schema, load_checkpoint, save_checkpoint, save_checkpoint_for_scope,
     BudgetDecisions, CheckpointId, CheckpointScope, ExcludedMemory, FailureRecord, FileIdentity,
diff --git a/daemon/crates/lattice-core/src/working_memory/operations.rs b/daemon/crates/lattice-core/src/working_memory/operations.rs
