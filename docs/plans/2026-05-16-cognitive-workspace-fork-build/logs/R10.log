{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NA1e7yPeLoZRMW2vukUDzt","type":"tool_result","content":"1\t//! Identity resolver for Phase 1 stable ids.\n2\t//! This module implements the resolver deliverable required by\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## Phase 1: Unified Identity Model`. It also preserves the stable\n5\t//! follow-up contract from\n6\t//! `docs/architecture/2026-04-11-stable-follow-up-handles.md` `## Contract`\n7\t//! while using a small LRU justified by that note's\n8\t//! `## Assistant-Facing Surfaces`.\n9\tuse std::cell::RefCell;\n10\tuse std::collections::{HashMap, VecDeque};\n11\tuse thiserror::Error;\n12\t\n13\tuse crate::graph::{CodeGraph, GraphNode};\n14\tuse crate::identity::ambiguity::{\n15\t    section_disambiguation_hint, symbol_disambiguation_hint, test_disambiguation_hint,\n16\t    AmbiguityReport, ResolveOutcome,\n17\t};\n18\tuse crate::storage::graph_store::FileIndexEntry;\n19\tuse crate::symbols::{ParsedFile, SymbolKind};\n20\t\n21\tuse super::encoding::decode_identity;\n22\tuse super::kinds::{DocId, EventId, FileId, Identity, SectionId, SymbolId};\n23\t\n24\tpub type WorkspaceId = String;\n25\t\n26\tconst DEFAULT_CONTENT_HASH: &str = \"00000000\";\n27\tconst DEFAULT_CACHE_CAPACITY: usize = 64;\n28\t\n29\t/// Resolves user-facing or assistant-facing references into stable identities.\n30\tpub struct IdentityResolver<'a> {\n31\t    graph: &'a CodeGraph,\n32\t    file_index: &'a HashMap<String, FileIndexEntry>,\n33\t    parsed_files: &'a HashMap<String, ParsedFile>,\n34\t    default_workspace: WorkspaceId,\n35\t    latest_event_id: Option<EventId>,\n36\t    event_index: HashMap<String, EventId>,\n37\t    cache: RefCell<ResolverCache>,\n38\t}\n39\t\n40\t#[derive(Clone, Debug, Error, PartialEq, Eq)]\n41\tpub enum ResolveError {\n42\t    #[error(\"workspace `{workspace_id}` is not indexed\")]\n43\t    WorkspaceNotIndexed { workspace_id: WorkspaceId },\n44\t    #[error(\"malformed {kind} reference `{query}`: {reason}\")]\n45\t    Malformed {\n46\t        kind: &'static str,\n47\t        query: String,\n48\t        reason: &'static str,\n49\t    },\n50\t    #[error(\"no {kind} identity found for `{query}`\")]\n51\t    NotFound { kind: &'static str, query: String },\n52\t    #[error(\n53\t        \"event index is behind the requested reference; latest indexed event is {latest_event_id}\"\n54\t    )]\n55\t    IndexLagBehind { latest_event_id: EventId },\n56\t}\n57\t\n58\t#[derive(Clone, Debug, PartialEq, Eq, Hash)]\n59\tenum CacheKey {\n60\t    Path(WorkspaceId, String),\n61\t    Symbol(WorkspaceId, String),\n62\t    Section(WorkspaceId, String, String),\n63\t    Test(WorkspaceId, String),\n64\t    Event(WorkspaceId, String),\n65\t    LegacySymbol(String),\n66\t}\n67\t\n68\t#[derive(Clone, Debug, PartialEq, Eq)]\n69\tenum CacheValue {\n70\t    File(Result<FileId, ResolveError>),\n71\t    Symbol(ResolveOutcome<SymbolId>),\n72\t    Section(ResolveOutcome<SectionId>),\n73\t    Test(ResolveOutcome<SymbolId>),\n74\t    Event(Result<EventId, ResolveError>),\n75\t}\n76\t\n77\t#[derive(Default)]\n78\tstruct ResolverCache {\n79\t    capacity: usize,\n80\t    order: VecDeque<CacheKey>,\n81\t    values: HashMap<CacheKey, CacheValue>,\n82\t}\n83\t\n84\timpl ResolverCache {\n85\t    fn new(capacity: usize) -> Self {\n86\t        Self {\n87\t            capacity: capacity.max(1),\n88\t            order: VecDeque::new(),\n89\t            values: HashMap::new(),\n90\t        }\n91\t    }\n92\t\n93\t    fn get(&mut self, key: &CacheKey) -> Option<CacheValue> {\n94\t        let value = self.values.get(key)?.clone();\n95\t        self.touch(key.clone());\n96\t        Some(value)\n97\t    }\n98\t\n99\t    fn insert(&mut self, key: CacheKey, value: CacheValue) {\n100\t        self.values.insert(key.clone(), value);\n101\t        self.touch(key);\n102\t        while self.order.len() > self.capacity {\n103\t            if let Some(oldest) = self.order.pop_front() {\n104\t                self.values.remove(&oldest);\n105\t            }\n106\t        }\n107\t    }\n108\t\n109\t    fn touch(&mut self, key: CacheKey) {\n110\t        self.order.retain(|existing| existing != &key);\n111\t        self.order.push_back(key);\n112\t    }\n113\t}\n114\t\n115\timpl<'a> IdentityResolver<'a> {\n116\t    pub fn new(\n117\t        graph: &'a CodeGraph,\n118\t        file_index: &'a HashMap<String, FileIndexEntry>,\n119\t        parsed_files: &'a HashMap<String, ParsedFile>,\n120\t        default_workspace: WorkspaceId,\n121\t        event_ids: Vec<EventId>,\n122\t    ) -> Self {\n123\t        let latest_event_id = event_ids.iter().max_by_key(|event| &event.ulid).cloned();\n124\t        let event_index = event_ids\n125\t            .into_iter()\n126\t            .map(|event| (event.ulid.clone(), event))\n127\t            .collect();\n128\t\n129\t        Self {\n130\t            graph,\n131\t            file_index,\n132\t            parsed_files,\n133\t            default_workspace,\n134\t            latest_event_id,\n135\t            event_index,\n136\t            cache: RefCell::new(ResolverCache::new(DEFAULT_CACHE_CAPACITY)),\n137\t        }\n138\t    }\n139\t\n140\t    pub fn resolve_path(\n141\t        &self,\n142\t        workspace: &WorkspaceId,\n143\t        path: &str,\n144\t    ) -> Result<FileId, ResolveError> {\n145\t        let key = CacheKey::Path(workspace.clone(), path.to_string());\n146\t        if let Some(CacheValue::File(result)) = self.cache.borrow_mut().get(&key) {\n147\t            return result;\n148\t        }\n149\t\n150\t        let result = self.resolve_path_uncached(workspace, path);\n151\t        self.cache\n152\t            .borrow_mut()\n153\t            .insert(key, CacheValue::File(result.clone()));\n154\t        result\n155\t    }\n156\t\n157\t    pub fn resolve_symbol(\n158\t        &self,\n159\t        workspace: &WorkspaceId,\n160\t        qualified_name: &str,\n161\t    ) -> ResolveOutcome<SymbolId> {\n162\t        let key = CacheKey::Symbol(workspace.clone(), qualified_name.to_string());\n163\t        if let Some(CacheValue::Symbol(result)) = self.cache.borrow_mut().get(&key) {\n164\t            return result;\n165\t        }\n166\t\n167\t        let result = self.resolve_symbol_uncached(workspace, qualified_name);\n168\t        self.cache\n169\t            .borrow_mut()\n170\t            .insert(key, CacheValue::Symbol(result.clone()));\n171\t        result\n172\t    }\n173\t\n174\t    pub fn resolve_section(\n175\t        &self,\n176\t        workspace: &WorkspaceId,\n177\t        doc: &DocId,\n178\t        heading: &str,\n179\t    ) -> ResolveOutcome<SectionId> {\n180\t        let key = CacheKey::Section(\n181\t            workspace.clone(),\n182\t            doc.repo_relative_path.clone(),\n183\t            heading.to_string(),\n184\t        );\n185\t        if let Some(CacheValue::Section(result)) = self.cache.borrow_mut().get(&key) {\n186\t            return result;\n187\t        }\n188\t\n189\t        let result = self.resolve_section_uncached(workspace, doc, heading);\n190\t        self.cache\n191\t            .borrow_mut()\n192\t            .insert(key, CacheValue::Section(result.clone()));\n193\t        result\n194\t    }\n195\t\n196\t    pub fn resolve_test(\n197\t        &self,\n198\t        workspace: &WorkspaceId,\n199\t        test_name: &str,\n200\t    ) -> ResolveOutcome<SymbolId> {\n201\t        let key = CacheKey::Test(workspace.clone(), test_name.to_string());\n202\t        if let Some(CacheValue::Test(result)) = self.cache.borrow_mut().get(&key) {\n203\t            return result;\n204\t        }\n205\t\n206\t        let result = self.resolve_test_uncached(workspace, test_name);\n207\t        self.cache\n208\t            .borrow_mut()\n209\t            .insert(key, CacheValue::Test(result.clone()));\n210\t        result\n211\t    }\n212\t\n213\t    pub fn resolve_event_ref(\n214\t        &self,\n215\t        workspace: &WorkspaceId,\n216\t        ref_str: &str,\n217\t    ) -> Result<EventId, ResolveError> {\n218\t        let key = CacheKey::Event(workspace.clone(), ref_str.to_string());\n219\t        if let Some(CacheValue::Event(result)) = self.cache.borrow_mut().get(&key) {\n220\t            return result;\n221\t        }\n222\t\n223\t        let result = self.resolve_event_ref_uncached(workspace, ref_str);\n224\t        self.cache\n225\t            .borrow_mut()\n226\t            .insert(key, CacheValue::Event(result.clone()));\n227\t        result\n228\t    }\n229\t\n230\t    pub fn resolve_legacy_symbol_name(&self, name: &str) -> ResolveOutcome<SymbolId> {\n231\t        let key = CacheKey::LegacySymbol(name.to_string());\n232\t        if let Some(CacheValue::Symbol(result)) = self.cache.borrow_mut().get(&key) {\n233\t            return result;\n234\t        }\n235\t\n236\t        let result = self.resolve_symbol(&self.default_workspace, name);\n237\t        self.cache\n238\t            .borrow_mut()\n239\t            .insert(key, CacheValue::Symbol(result.clone()));\n240\t        result\n241\t    }\n242\t\n243\t    fn resolve_path_uncached(\n244\t        &self,\n245\t        workspace: &WorkspaceId,\n246\t        path: &str,\n247\t    ) -> Result<FileId, ResolveError> {\n248\t        if let Some(file_id) = self.resolve_file_identity_compat(workspace, path)? {\n249\t            return Ok(file_id);\n250\t        }\n251\t        self.ensure_workspace_indexed(workspace)?;\n252\t        let wanted = normalize_path(path);\n253\t        if wanted.is_empty() {\n254\t            return Err(ResolveError::Malformed {\n255\t                kind: \"path\",\n256\t                query: path.to_string(),\n257\t                reason: \"expected a non-empty repo-relative path\",\n258\t            });\n259\t        }\n260\t\n261\t        self.file_index\n262\t            .keys()\n263\t            .find(|stored_path| {\n264\t                self.relative_path_in_workspace(workspace, stored_path) == Some(wanted.clone())\n265\t            })\n266\t            .map(|stored_path| self.file_id_for_stored_path(workspace, stored_path))\n267\t            .transpose()?\n268\t            .ok_or_else(|| ResolveError::NotFound {\n269\t                kind: \"file\",\n270\t                query: path.to_string(),\n271\t            })\n272\t    }\n273\t\n274\t    fn resolve_symbol_uncached(\n275\t        &self,\n276\t        workspace: &WorkspaceId,\n277\t        qualified_name: &str,\n278\t    ) -> ResolveOutcome<SymbolId> {\n279\t        if let Some(identity) = decode_identity(qualified_name).ok() {\n280\t            match identity {\n281\t                Identity::Symbol(symbol_id) if symbol_id.file.workspace_id == *workspace => {\n282\t                    return ResolveOutcome::Unique(symbol_id);\n283\t                }\n284\t                Identity::Symbol(symbol_id) => {\n285\t                    return ResolveOutcome::NotFound(ResolveError::NotFound {\n286\t                        kind: \"symbol\",\n287\t                        query: symbol_id.to_string(),\n288\t                    });\n289\t                }\n290\t                _ => {}\n291\t            }\n292\t        }\n293\t        if let Err(error) = self.ensure_workspace_indexed(workspace) {\n294\t            return ResolveOutcome::NotFound(error);\n295\t        }\n296\t\n297\t        let (file_hint, symbol_hint) = split_symbol_target(qualified_name);\n298\t        let wanted = normalize_symbol_name(symbol_hint);\n299\t        if wanted.is_empty() {\n300\t            return ResolveOutcome::NotFound(ResolveError::Malformed {\n301\t                kind: \"symbol\",\n302\t                query: qualified_name.to_string(),\n303\t                reason: \"expected a symbol name or stable symbol identity\",\n304\t            });\n305\t        }\n306\t\n307\t        let candidates = self.collect_symbol_candidates(workspace, file_hint, &wanted);\n308\t        unique_or_ambiguous_symbol(qualified_name, candidates)\n309\t    }\n310\t\n311\t    fn resolve_section_uncached(\n312\t        &self,\n313\t        workspace: &WorkspaceId,\n314\t        doc: &DocId,\n315\t        heading: &str,\n316\t    ) -> ResolveOutcome<SectionId> {\n317\t        if let Err(error) = self.ensure_workspace_indexed(workspace) {\n318\t            return ResolveOutcome::NotFound(error);\n319\t        }\n320\t        if doc.workspace_id != *workspace {\n321\t            return ResolveOutcome::NotFound(ResolveError::NotFound {\n322\t                kind: \"document\",\n323\t                query: doc.to_string(),\n324\t            });\n325\t        }\n326\t\n327\t        let Some(stored_path) = self.stored_path_for_doc(workspace, doc) else {\n328\t            return ResolveOutcome::NotFound(ResolveError::NotFound {\n329\t                kind: \"document\",\n330\t                query: doc.to_string(),\n331\t            });\n332\t        };\n333\t\n334\t        let Some(parsed_file) = self.parsed_files.get(&stored_path) else {\n335\t            return ResolveOutcome::NotFound(ResolveError::NotFound {\n336\t                kind: \"section\",\n337\t                query: heading.to_string(),\n338\t            });\n339\t        };\n340\t\n341\t        let wanted = normalize_heading(heading);\n342\t        let candidates = parsed_file\n343\t            .symbols\n344\t            .iter()\n345\t            .filter(|symbol| symbol.kind == SymbolKind::Section)\n346\t            .filter(|symbol| normalize_heading(&symbol.name) == wanted)\n347\t            .map(|symbol| SectionId {\n348\t                doc: doc.clone(),\n349\t                heading_path: vec![symbol.name.clone()],\n350\t                byte_offset: symbol.id.byte_offset,\n351\t            })\n352\t            .collect::<Vec<_>>();\n353\t\n354\t        match candidates.len() {\n355\t            0 => ResolveOutcome::NotFound(ResolveError::NotFound {\n356\t                kind: \"section\",\n357\t                query: heading.to_string(),\n358\t            }),\n359\t            1 => ResolveOutcome::Unique(candidates[0].clone()),\n360\t            _ => ResolveOutcome::Ambiguous(AmbiguityReport::new(\n361\t                heading,\n362\t                candidates,\n363\t                section_disambiguation_hint(),\n364\t            )),\n365\t        }\n366\t    }\n367\t\n368\t    fn resolve_test_uncached(\n369\t        &self,\n370\t        workspace: &WorkspaceId,\n371\t        test_name: &str,\n372\t    ) -> ResolveOutcome<SymbolId> {\n373\t        if let Err(error) = self.ensure_workspace_indexed(workspace) {\n374\t            return ResolveOutcome::NotFound(error);\n375\t        }\n376\t        let wanted = normalize_symbol_name(test_name);\n377\t        if wanted.is_empty() {\n378\t            return ResolveOutcome::NotFound(ResolveError::Malformed {\n379\t                kind: \"test\",\n380\t                query: test_name.to_string(),\n381\t                reason: \"expected a non-empty test name\",\n382\t            });\n383\t        }\n384\t\n385\t        let candidates = self\n386\t            .graph\n387\t            .all_nodes()\n388\t            .into_iter()\n389\t            .filter(|node| {\n390\t                self.relative_path_in_workspace(workspace, &node.file)\n391\t                    .is_some()\n392\t            })\n393\t            .filter(|node| is_test_node(node))\n394\t            .filter(|node| normalize_symbol_name(&node.name) == wanted)\n395\t            .filter_map(|node| self.symbol_id_for_node(workspace, node, Some(\"test\")))\n396\t            .collect::<Vec<_>>();\n397\t\n398\t        match candidates.len() {\n399\t            0 => ResolveOutcome::NotFound(ResolveError::NotFound {\n400\t                kind: \"test\",\n401\t                query: test_name.to_string(),\n402\t            }),\n403\t            1 => ResolveOutcome::Unique(candidates[0].clone()),\n404\t            _ => ResolveOutcome::Ambiguous(AmbiguityReport::new(\n405\t                test_name,\n406\t                candidates,\n407\t                test_disambiguation_hint(),\n408\t            )),\n409\t        }\n410\t    }\n411\t\n412\t    fn resolve_event_ref_uncached(\n413\t        &self,\n414\t        workspace: &WorkspaceId,\n415\t        ref_str: &str,\n416\t    ) -> Result<EventId, ResolveError> {\n417\t        if let Some(identity) = decode_identity(ref_str).ok() {\n418\t            match identity {\n419\t                Identity::Event(event_id) if event_id.workspace_id == *workspace => {\n420\t                    return Ok(event_id);\n421\t                }\n422\t                Identity::Event(event_id) => {\n423\t                    return Err(ResolveError::NotFound {\n424\t                        kind: \"event\",\n425\t                        query: event_id.to_string(),\n426\t                    });\n427\t                }\n428\t                _ => {}\n429\t            }\n430\t        }\n431\t        if !self\n432\t            .event_index\n433\t            .values()\n434\t            .any(|event_id| event_id.workspace_id == *workspace)\n435\t        {\n436\t            return Err(ResolveError::WorkspaceNotIndexed {\n437\t                workspace_id: workspace.clone(),\n438\t            });\n439\t        }\n440\t        let trimmed = ref_str.trim();\n441\t        if !is_canonical_ulid(trimmed) {\n442\t            return Err(ResolveError::Malformed {\n443\t                kind: \"event\",\n444\t                query: ref_str.to_string(),\n445\t                reason: \"expected a canonical ULID or stable event identity\",\n446\t            });\n447\t        }\n448\t        if let Some(event_id) = self.event_index.get(trimmed) {\n449\t            return Ok(event_id.clone());\n450\t        }\n451\t        if self.event_ref_appears_ahead_of_index(workspace, trimmed) {\n452\t            return Err(ResolveError::IndexLagBehind {\n453\t                latest_event_id: self.latest_event_id.clone().expect(\"checked above\"),\n454\t            });\n455\t        }\n456\t        Err(ResolveError::NotFound {\n457\t            kind: \"event\",\n458\t            query: ref_str.to_string(),\n459\t        })\n460\t    }\n461\t\n462\t    fn collect_symbol_candidates(\n463\t        &self,\n464\t        workspace: &WorkspaceId,\n465\t        file_hint: Option<&str>,\n466\t        wanted: &str,\n467\t    ) -> Vec<SymbolId> {\n468\t        let wanted_lower = wanted.to_lowercase();\n469\t        self.graph\n470\t            .all_nodes()\n471\t            .into_iter()\n472\t            .filter(|node| {\n473\t                self.relative_path_in_workspace(workspace, &node.file)\n474\t                    .is_some()\n475\t            })\n476\t            .filter(|node| node.kind != SymbolKind::Document && node.kind != SymbolKind::Section)\n477\t            .filter(|node| {\n478\t                file_hint\n479\t                    .map(|hint| self.node_matches_file_hint(workspace, node, hint))\n480\t                    .unwrap_or(true)\n481\t            })\n482\t            .filter(|node| normalize_symbol_name(&node.name).to_lowercase() == wanted_lower)\n483\t            .filter_map(|node| self.symbol_id_for_node(workspace, node, None))\n484\t            .collect()\n485\t    }\n486\t\n487\t    fn node_matches_file_hint(\n488\t        &self,\n489\t        workspace: &WorkspaceId,\n490\t        node: &GraphNode,\n491\t        file_hint: &str,\n492\t    ) -> bool {\n493\t        let wanted = normalize_path(file_hint);\n494\t        let Some(relative_path) = self.relative_path_in_workspace(workspace, &node.file) else {\n495\t            return false;\n496\t        };\n497\t        relative_path == wanted\n498\t            || relative_path.ends_with(&format!(\"/{wanted}\"))\n499\t            || relative_path.rsplit('/').next() == Some(wanted.as_str())\n500\t    }\n501\t\n502\t    fn ensure_workspace_indexed(&self, workspace: &WorkspaceId) -> Result<(), ResolveError> {\n503\t        if self\n504\t            .file_index\n505\t            .keys()\n506\t            .any(|path| self.relative_path_in_workspace(workspace, path).is_some())\n507\t            || self.workspace_has_nodes(workspace)\n508\t        {\n509\t            Ok(())\n510\t        } else {\n511\t            Err(ResolveError::WorkspaceNotIndexed {\n512\t                workspace_id: workspace.clone(),\n513\t            })\n514\t        }\n515\t    }\n516\t\n517\t    fn workspace_has_nodes(&self, workspace: &WorkspaceId) -> bool {\n518\t        self.graph.all_nodes().into_iter().any(|node| {\n519\t            self.relative_path_in_workspace(workspace, &node.file)\n520\t                .is_some()\n521\t        })\n522\t    }\n523\t\n524\t    fn event_ref_appears_ahead_of_index(&self, workspace: &WorkspaceId, ulid: &str) -> bool {\n525\t        self.latest_event_id\n526\t            .as_ref()\n527\t            .filter(|latest| latest.workspace_id == *workspace)\n528\t            .map(|latest| ulid > latest.ulid.as_str())\n529\t            .unwrap_or(false)\n530\t    }\n531\t\n532\t    fn file_id_for_stored_path(\n533\t        &self,\n534\t        workspace: &WorkspaceId,\n535\t        stored_path: &str,\n536\t    ) -> Result<FileId, ResolveError> {\n537\t        let Some(repo_relative_path) = self.relative_path_in_workspace(workspace, stored_path)\n538\t        else {\n539\t            return Err(ResolveError::NotFound {\n540\t                kind: \"file\",\n541\t                query: stored_path.to_string(),\n542\t            });\n543\t        };\n544\t        Ok(FileId {\n545\t            workspace_id: workspace.clone(),\n546\t            repo_relative_path,\n547\t            content_hash: self\n548\t                .file_index\n549\t                .get(stored_path)\n550\t                .map(|entry| entry.content_hash.clone())\n551\t                .unwrap_or_else(|| DEFAULT_CONTENT_HASH.to_string()),\n552\t        })\n553\t    }\n554\t\n555\t    fn symbol_id_for_node(\n556\t        &self,\n557\t        workspace: &WorkspaceId,\n558\t        node: &GraphNode,\n559\t        forced_kind: Option<&str>,\n560\t    ) -> Option<SymbolId> {\n561\t        let file = self.file_id_for_stored_path(workspace, &node.file).ok()?;\n562\t        Some(SymbolId {\n563\t            file,\n564\t            qualified_name: node.name.clone(),\n565\t            byte_offset: node.id.byte_offset,\n566\t            kind: forced_kind\n567\t                .map(str::to_string)\n568\t                .unwrap_or_else(|| format!(\"{:?}\", node.kind).to_lowercase()),\n569\t        })\n570\t    }\n571\t\n572\t    fn stored_path_for_doc(&self, workspace: &WorkspaceId, doc: &DocId) -> Option<String> {\n573\t        self.file_index.keys().find_map(|stored_path| {\n574\t            let relative_path = self.relative_path_in_workspace(workspace, stored_path)?;\n575\t            if relative_path == doc.repo_relative_path {\n576\t                Some(stored_path.clone())\n577\t            } else {\n578\t                None\n579\t            }\n580\t        })\n581\t    }\n582\t\n583\t    fn relative_path_in_workspace(\n584\t        &self,\n585\t        workspace: &WorkspaceId,\n586\t        stored_path: &str,\n587\t    ) -> Option<String> {\n588\t        let normalized = normalize_path(stored_path);\n589\t        let prefix = format!(\"{workspace}/\");\n590\t        if normalized == *workspace {\n591\t            return Some(String::new());\n592\t        }\n593\t        if let Some(stripped) = normalized.strip_prefix(&prefix) {\n594\t            return Some(stripped.to_string());\n595\t        }\n596\t        if workspace == &self.default_workspace && !self.is_namespaced_path(&normalized) {\n597\t            return Some(normalized);\n598\t        }\n599\t        None\n600\t    }\n601\t\n602\t    fn is_namespaced_path(&self, path: &str) -> bool {\n603\t        let first_segment = path.split('/').next().unwrap_or(path);\n604\t        first_segment == self.default_workspace\n605\t            || self\n606\t                .file_index\n607\t                .keys()\n608\t                .filter_map(|item| normalize_path(item).split('/').next().map(str::to_string))\n609\t                .any(|segment| segment == first_segment)\n610\t    }\n611\t\n612\t    fn resolve_file_identity_compat(\n613\t        &self,\n614\t        workspace: &WorkspaceId,\n615\t        query: &str,\n616\t    ) -> Result<Option<FileId>, ResolveError> {\n617\t        let Ok(identity) = decode_identity(query) else {\n618\t            return Ok(None);\n619\t        };\n620\t        let Identity::File(file_id) = identity else {\n621\t            return Ok(None);\n622\t        };\n623\t        if file_id.workspace_id != *workspace {\n624\t            return Err(ResolveError::NotFound {\n625\t                kind: \"file\",\n626\t                query: file_id.to_string(),\n627\t            });\n628\t        }\n629\t        if let Some(current) = self.find_current_file_by_hash(workspace, &file_id) {\n630\t            return Ok(Some(current));\n631\t        }\n632\t        Err(ResolveError::NotFound {\n633\t            kind: \"file\",\n634\t            query: query.to_string(),\n635\t        })\n636\t    }\n637\t\n638\t    fn find_current_file_by_hash(&self, workspace: &WorkspaceId, legacy: &FileId) -> Option<FileId> {\n639\t        let mut matches = self\n640\t            .file_index\n641\t            .iter()\n642\t            .filter(|(stored_path, entry)| {\n643\t                entry.content_hash == legacy.content_hash\n644\t                    && self.relative_path_in_workspace(workspace, stored_path).is_some()\n645\t            })\n646\t            .filter_map(|(stored_path, _)| self.file_id_for_stored_path(workspace, stored_path).ok())\n647\t            .collect::<Vec<_>>();\n648\t        if matches.len() == 1 {\n649\t            return matches.pop();\n650\t        }\n651\t        matches\n652\t            .into_iter()\n653\t            .find(|candidate| candidate.repo_relative_path == legacy.repo_relative_path)\n654\t    }\n655\t}\n656\t\n657\tfn unique_or_ambiguous_symbol(query: &str, candidates: Vec<SymbolId>) -> ResolveOutcome<SymbolId> {\n658\t    match candidates.len() {\n659\t        0 => ResolveOutcome::NotFound(ResolveError::NotFound {\n660\t            kind: \"symbol\",\n661\t            query: query.to_string(),\n662\t        }),\n663\t        1 => ResolveOutcome::Unique(candidates[0].clone()),\n664\t        _ => {\n665\t            let files = candidates\n666\t                .iter()\n667\t                .map(|candidate| candidate.file.repo_relative_path.clone())\n668\t                .collect::<Vec<_>>();\n669\t            let distinct_files = files.iter().collect::<std::collections::HashSet<_>>().len();\n670\t            ResolveOutcome::Ambiguous(AmbiguityReport::new(\n671\t                query,\n672\t                candidates,\n673\t                symbol_disambiguation_hint(distinct_files > 1),\n674\t            ))\n675\t        }\n676\t    }\n677\t}\n678\t\n679\tfn split_symbol_target(target: &str) -> (Option<&str>, &str) {\n680\t    let trimmed = target.trim();\n681\t    if let Some((file, symbol)) = trimmed.rsplit_once(\"::\") {\n682\t        if looks_like_path(file) {\n683\t            return (Some(file), symbol);\n684\t        }\n685\t    }\n686\t    if let Some((file, symbol)) = trimmed.rsplit_once(':') {\n687\t        if looks_like_path(file) {\n688\t            return (Some(file), symbol);\n689\t        }\n690\t    }\n691\t    (None, trimmed)\n692\t}\n693\t\n694\tfn looks_like_path(value: &str) -> bool {\n695\t    value.contains('/') || value.contains('\\\\') || value.contains('.')\n696\t}\n697\t\n698\tfn normalize_path(path: &str) -> String {\n699\t    path.replace('\\\\', \"/\")\n700\t        .trim()\n701\t        .trim_start_matches(\"./\")\n702\t        .trim_start_matches('/')\n703\t        .to_string()\n704\t}\n705\t\n706\tfn normalize_symbol_name(value: &str) -> String {\n707\t    value.trim().trim_matches(':').to_string()\n708\t}\n709\t\n710\tfn normalize_heading(value: &str) -> String {\n711\t    value.trim().to_lowercase()\n712\t}\n713\t\n714\tfn is_test_node(node: &GraphNode) -> bool {\n715\t    let lower_name = node.name.to_lowercase();\n716\t    let lower_file = node.file.to_lowercase();\n717\t    lower_name.starts_with(\"test\")\n718\t        || lower_name.ends_with(\"test\")\n719\t        || lower_file.contains(\"/tests/\")\n720\t        || lower_file.contains(\"_test.\")\n721\t        || lower_file.contains(\".test.\")\n722\t}\n723\t\n724\tfn is_canonical_ulid(value: &str) -> bool {\n725\t    value.len() == 26\n726\t        && value.chars().all(|ch| {\n727\t            matches!(ch, '0'..='9' | 'A'..='Z') && ch != 'I' && ch != 'L' && ch != 'O' && ch != 'U'\n728\t        })\n729\t}\n730\t\n731\t#[cfg(test)]\n732\tmod tests;\n733\t"}]},"parent_tool_use_id":null,"session_id":"beca6473-0a8b-4b3f-8c29-18a74c665d8f","uuid":"5599554a-5589-4dbf-9022-080dcfb0ec56","timestamp":"2026-05-17T04:19:13.639Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/identity/resolver.rs","content":"//! Identity resolver for Phase 1 stable ids.\n//! This module implements the resolver deliverable required by\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 1: Unified Identity Model`. It also preserves the stable\n//! follow-up contract from\n//! `docs/architecture/2026-04-11-stable-follow-up-handles.md` `## Contract`\n//! while using a small LRU justified by that note's\n//! `## Assistant-Facing Surfaces`.\nuse std::cell::RefCell;\nuse std::collections::{HashMap, VecDeque};\nuse thiserror::Error;\n\nuse crate::graph::{CodeGraph, GraphNode};\nuse crate::identity::ambiguity::{\n    section_disambiguation_hint, symbol_disambiguation_hint, test_disambiguation_hint,\n    AmbiguityReport, ResolveOutcome,\n};\nuse crate::storage::graph_store::FileIndexEntry;\nuse crate::symbols::{ParsedFile, SymbolKind};\n\nuse super::encoding::decode_identity;\nuse super::kinds::{DocId, EventId, FileId, Identity, SectionId, SymbolId};\n\npub type WorkspaceId = String;\n\nconst DEFAULT_CONTENT_HASH: &str = \"00000000\";\nconst DEFAULT_CACHE_CAPACITY: usize = 64;\n\n/// Resolves user-facing or assistant-facing references into stable identities.\npub struct IdentityResolver<'a> {\n    graph: &'a CodeGraph,\n    file_index: &'a HashMap<String, FileIndexEntry>,\n    parsed_files: &'a HashMap<String, ParsedFile>,\n    default_workspace: WorkspaceId,\n    latest_event_id: Option<EventId>,\n    event_index: HashMap<String, EventId>,\n    cache: RefCell<ResolverCache>,\n}\n\n#[derive(Clone, Debug, Error, PartialEq, Eq)]\npub enum ResolveError {\n    #[error(\"workspace `{workspace_id}` is not indexed\")]\n    WorkspaceNotIndexed { workspace_id: WorkspaceId },\n    #[error(\"malformed {kind} reference `{query}`: {reason}\")]\n    Malformed {\n        kind: &'static str,\n        query: String,\n        reason: &'static str,\n    },\n    #[error(\"no {kind} identity found for `{query}`\")]\n    NotFound { kind: &'static str, query: String },\n    #[error(\n        \"event index is behind the requested reference; latest indexed event is {latest_event_id}\"\n    )]\n    IndexLagBehind { latest_event_id: EventId },\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Hash)]\nenum CacheKey {\n    Path(WorkspaceId, String),\n    Symbol(WorkspaceId, String),\n    Section(WorkspaceId, String, String),\n    Test(WorkspaceId, String),\n    Event(WorkspaceId, String),\n    LegacySymbol(String),\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\nenum CacheValue {\n    File(Result<FileId, ResolveError>),\n    Symbol(ResolveOutcome<SymbolId>),\n    Section(ResolveOutcome<SectionId>),\n    Test(ResolveOutcome<SymbolId>),\n    Event(Result<EventId, ResolveError>),\n}\n\n#[derive(Default)]\nstruct ResolverCache {\n    capacity: usize,\n    order: VecDeque<CacheKey>,\n    values: HashMap<CacheKey, CacheValue>,\n}\n\nimpl ResolverCache {\n    fn new(capacity: usize) -> Self {\n        Self {\n            capacity: capacity.max(1),\n            order: VecDeque::new(),\n            values: HashMap::new(),\n        }\n    }\n\n    fn get(&mut self, key: &CacheKey) -> Option<CacheValue> {\n        let value = self.values.get(key)?.clone();\n        self.touch(key.clone());\n        Some(value)\n    }\n\n    fn insert(&mut self, key: CacheKey, value: CacheValue) {\n        self.values.insert(key.clone(), value);\n        self.touch(key);\n        while self.order.len() > self.capacity {\n            if let Some(oldest) = self.order.pop_front() {\n                self.values.remove(&oldest);\n            }\n        }\n    }\n\n    fn touch(&mut self, key: CacheKey) {\n        self.order.retain(|existing| existing != &key);\n        self.order.push_back(key);\n    }\n}\n\nimpl<'a> IdentityResolver<'a> {\n    pub fn new(\n        graph: &'a CodeGraph,\n        file_index: &'a HashMap<String, FileIndexEntry>,\n        parsed_files: &'a HashMap<String, ParsedFile>,\n        default_workspace: WorkspaceId,\n        event_ids: Vec<EventId>,\n    ) -> Self {\n        let latest_event_id = event_ids.iter().max_by_key(|event| &event.ulid).cloned();\n        let event_index = event_ids\n            .into_iter()\n            .map(|event| (event.ulid.clone(), event))\n            .collect();\n\n        Self {\n            graph,\n            file_index,\n            parsed_files,\n            default_workspace,\n            latest_event_id,\n            event_index,\n            cache: RefCell::new(ResolverCache::new(DEFAULT_CACHE_CAPACITY)),\n        }\n    }\n\n    pub fn resolve_path(\n        &self,\n        workspace: &WorkspaceId,\n        path: &str,\n    ) -> Result<FileId, ResolveError> {\n        let key = CacheKey::Path(workspace.clone(), path.to_string());\n        if let Some(CacheValue::File(result)) = self.cache.borrow_mut().get(&key) {\n            return result;\n        }\n\n        let result = self.resolve_path_uncached(workspace, path);\n        self.cache\n            .borrow_mut()\n            .insert(key, CacheValue::File(result.clone()));\n        result\n    }\n\n    pub fn resolve_symbol(\n        &self,\n        workspace: &WorkspaceId,\n        qualified_name: &str,\n    ) -> ResolveOutcome<SymbolId> {\n        let key = CacheKey::Symbol(workspace.clone(), qualified_name.to_string());\n        if let Some(CacheValue::Symbol(result)) = self.cache.borrow_mut().get(&key) {\n            return result;\n        }\n\n        let result = self.resolve_symbol_uncached(workspace, qualified_name);\n        self.cache\n            .borrow_mut()\n            .insert(key, CacheValue::Symbol(result.clone()));\n        result\n    }\n\n    pub fn resolve_section(\n        &self,\n        workspace: &WorkspaceId,\n        doc: &DocId,\n        heading: &str,\n    ) -> ResolveOutcome<SectionId> {\n        let key = CacheKey::Section(\n            workspace.clone(),\n            doc.repo_relative_path.clone(),\n            heading.to_string(),\n        );\n        if let Some(CacheValue::Section(result)) = self.cache.borrow_mut().get(&key) {\n            return result;\n        }\n\n        let result = self.resolve_section_uncached(workspace, doc, heading);\n        self.cache\n            .borrow_mut()\n            .insert(key, CacheValue::Section(result.clone()));\n        result\n    }\n\n    pub fn resolve_test(\n        &self,\n        workspace: &WorkspaceId,\n        test_name: &str,\n    ) -> ResolveOutcome<SymbolId> {\n        let key = CacheKey::Test(workspace.clone(), test_name.to_string());\n        if let Some(CacheValue::Test(result)) = self.cache.borrow_mut().get(&key) {\n            return result;\n        }\n\n        let result = self.resolve_test_uncached(workspace, test_name);\n        self.cache\n            .borrow_mut()\n            .insert(key, CacheValue::Test(result.clone()));\n        result\n    }\n\n    pub fn resolve_event_ref(\n        &self,\n        workspace: &WorkspaceId,\n        ref_str: &str,\n    ) -> Result<EventId, ResolveError> {\n        let key = CacheKey::Event(workspace.clone(), ref_str.to_string());\n        if let Some(CacheValue::Event(result)) = self.cache.borrow_mut().get(&key) {\n            return result;\n        }\n\n        let result = self.resolve_event_ref_uncached(workspace, ref_str);\n        self.cache\n            .borrow_mut()\n            .insert(key, CacheValue::Event(result.clone()));\n        result\n    }\n\n    pub fn resolve_legacy_symbol_name(&self, name: &str) -> ResolveOutcome<SymbolId> {\n        let key = CacheKey::LegacySymbol(name.to_string());\n        if let Some(CacheValue::Symbol(result)) = self.cache.borrow_mut().get(&key) {\n            return result;\n        }\n\n        let result = self.resolve_symbol(&self.default_workspace, name);\n        self.cache\n            .borrow_mut()\n            .insert(key, CacheValue::Symbol(result.clone()));\n        result\n    }\n\n    fn resolve_path_uncached(\n        &self,\n        workspace: &WorkspaceId,\n        path: &str,\n    ) -> Result<FileId, ResolveError> {\n        if let Some(file_id) = self.resolve_file_identity_compat(workspace, path)? {\n            return Ok(file_id);\n        }\n        self.ensure_workspace_indexed(workspace)?;\n        let wanted = normalize_path(path);\n        if wanted.is_empty() {\n            return Err(ResolveError::Malformed {\n                kind: \"path\",\n                query: path.to_string(),\n                reason: \"expected a non-empty repo-relative path\",\n            });\n        }\n\n        self.file_index\n            .keys()\n            .find(|stored_path| {\n                self.relative_path_in_workspace(workspace, stored_path) == Some(wanted.clone())\n            })\n            .map(|stored_path| self.file_id_for_stored_path(workspace, stored_path))\n            .transpose()?\n            .ok_or_else(|| ResolveError::NotFound {\n                kind: \"file\",\n                query: path.to_string(),\n            })\n    }\n\n    fn resolve_symbol_uncached(\n        &self,\n        workspace: &WorkspaceId,\n        qualified_name: &str,\n    ) -> ResolveOutcome<SymbolId> {\n        if let Some(identity) = decode_identity(qualified_name).ok() {\n            match identity {\n                Identity::Symbol(symbol_id) if symbol_id.file.workspace_id == *workspace => {\n                    return ResolveOutcome::Unique(symbol_id);\n                }\n                Identity::Symbol(symbol_id) => {\n                    return ResolveOutcome::NotFound(ResolveError::NotFound {\n                        kind: \"symbol\",\n                        query: symbol_id.to_string(),\n                    });\n                }\n                _ => {}\n            }\n        }\n        if let Err(error) = self.ensure_workspace_indexed(workspace) {\n            return ResolveOutcome::NotFound(error);\n        }\n\n        let (file_hint, symbol_hint) = split_symbol_target(qualified_name);\n        let wanted = normalize_symbol_name(symbol_hint);\n        if wanted.is_empty() {\n            return ResolveOutcome::NotFound(ResolveError::Malformed {\n                kind: \"symbol\",\n                query: qualified_name.to_string(),\n                reason: \"expected a symbol name or stable symbol identity\",\n            });\n        }\n\n        let candidates = self.collect_symbol_candidates(workspace, file_hint, &wanted);\n        unique_or_ambiguous_symbol(qualified_name, candidates)\n    }\n\n    fn resolve_section_uncached(\n        &self,\n        workspace: &WorkspaceId,\n        doc: &DocId,\n        heading: &str,\n    ) -> ResolveOutcome<SectionId> {\n        if let Err(error) = self.ensure_workspace_indexed(workspace) {\n            return ResolveOutcome::NotFound(error);\n        }\n        if doc.workspace_id != *workspace {\n            return ResolveOutcome::NotFound(ResolveError::NotFound {\n                kind: \"document\",\n                query: doc.to_string(),\n            });\n        }\n\n        let Some(stored_path) = self.stored_path_for_doc(workspace, doc) else {\n            return ResolveOutcome::NotFound(ResolveError::NotFound {\n                kind: \"document\",\n                query: doc.to_string(),\n            });\n        };\n\n        let Some(parsed_file) = self.parsed_files.get(&stored_path) else {\n            return ResolveOutcome::NotFound(ResolveError::NotFound {\n                kind: \"section\",\n                query: heading.to_string(),\n            });\n        };\n\n        let wanted = normalize_heading(heading);\n        let candidates = parsed_file\n            .symbols\n            .iter()\n            .filter(|symbol| symbol.kind == SymbolKind::Section)\n            .filter(|symbol| normalize_heading(&symbol.name) == wanted)\n            .map(|symbol| SectionId {\n                doc: doc.clone(),\n                heading_path: vec![symbol.name.clone()],\n                byte_offset: symbol.id.byte_offset,\n            })\n            .collect::<Vec<_>>();\n\n        match candidates.len() {\n            0 => ResolveOutcome::NotFound(ResolveError::NotFound {\n                kind: \"section\",\n                query: heading.to_string(),\n            }),\n            1 => ResolveOutcome::Unique(candidates[0].clone()),\n            _ => ResolveOutcome::Ambiguous(AmbiguityReport::new(\n                heading,\n                candidates,\n                section_disambiguation_hint(),\n            )),\n        }\n    }\n\n    fn resolve_test_uncached(\n        &self,\n        workspace: &WorkspaceId,\n        test_name: &str,\n    ) -> ResolveOutcome<SymbolId> {\n        if let Err(error) = self.ensure_workspace_indexed(workspace) {\n            return ResolveOutcome::NotFound(error);\n        }\n        let wanted = normalize_symbol_name(test_name);\n        if wanted.is_empty() {\n            return ResolveOutcome::NotFound(ResolveError::Malformed {\n                kind: \"test\",\n                query: test_name.to_string(),\n                reason: \"expected a non-empty test name\",\n            });\n        }\n\n        let candidates = self\n            .graph\n            .all_nodes()\n            .into_iter()\n            .filter(|node| {\n                self.relative_path_in_workspace(workspace, &node.file)\n                    .is_some()\n            })\n            .filter(|node| is_test_node(node))\n            .filter(|node| normalize_symbol_name(&node.name) == wanted)\n            .filter_map(|node| self.symbol_id_for_node(workspace, node, Some(\"test\")))\n            .collect::<Vec<_>>();\n\n        match candidates.len() {\n            0 => ResolveOutcome::NotFound(ResolveError::NotFound {\n                kind: \"test\",\n                query: test_name.to_string(),\n            }),\n            1 => ResolveOutcome::Unique(candidates[0].clone()),\n            _ => ResolveOutcome::Ambiguous(AmbiguityReport::new(\n                test_name,\n                candidates,\n                test_disambiguation_hint(),\n            )),\n        }\n    }\n\n    fn resolve_event_ref_uncached(\n        &self,\n        workspace: &WorkspaceId,\n        ref_str: &str,\n    ) -> Result<EventId, ResolveError> {\n        if let Some(identity) = decode_identity(ref_str).ok() {\n            match identity {\n                Identity::Event(event_id) if event_id.workspace_id == *workspace => {\n                    return Ok(event_id);\n                }\n                Identity::Event(event_id) => {\n                    return Err(ResolveError::NotFound {\n                        kind: \"event\",\n                        query: event_id.to_string(),\n                    });\n                }\n                _ => {}\n            }\n        }\n        if !self\n            .event_index\n            .values()\n            .any(|event_id| event_id.workspace_id == *workspace)\n        {\n            return Err(ResolveError::WorkspaceNotIndexed {\n                workspace_id: workspace.clone(),\n            });\n        }\n        let trimmed = ref_str.trim();\n        if !is_canonical_ulid(trimmed) {\n            return Err(ResolveError::Malformed {\n                kind: \"event\",\n                query: ref_str.to_string(),\n                reason: \"expected a canonical ULID or stable event identity\",\n            });\n        }\n        if let Some(event_id) = self.event_index.get(trimmed) {\n            return Ok(event_id.clone());\n        }\n        if self.event_ref_appears_ahead_of_index(workspace, trimmed) {\n            return Err(ResolveError::IndexLagBehind {\n                latest_event_id: self.latest_event_id.clone().expect(\"checked above\"),\n            });\n        }\n        Err(ResolveError::NotFound {\n            kind: \"event\",\n            query: ref_str.to_string(),\n        })\n    }\n\n    fn collect_symbol_candidates(\n        &self,\n        workspace: &WorkspaceId,\n        file_hint: Option<&str>,\n        wanted: &str,\n    ) -> Vec<SymbolId> {\n        let wanted_lower = wanted.to_lowercase();\n        self.graph\n            .all_nodes()\n            .into_iter()\n            .filter(|node| {\n                self.relative_path_in_workspace(workspace, &node.file)\n                    .is_some()\n            })\n            .filter(|node| node.kind != SymbolKind::Document && node.kind != SymbolKind::Section)\n            .filter(|node| {\n                file_hint\n                    .map(|hint| self.node_matches_file_hint(workspace, node, hint))\n                    .unwrap_or(true)\n            })\n            .filter(|node| normalize_symbol_name(&node.name).to_lowercase() == wanted_lower)\n            .filter_map(|node| self.symbol_id_for_node(workspace, node, None))\n            .collect()\n    }\n\n    fn node_matches_file_hint(\n        &self,\n        workspace: &WorkspaceId,\n        node: &GraphNode,\n        file_hint: &str,\n    ) -> bool {\n        let wanted = normalize_path(file_hint);\n        let Some(relative_path) = self.relative_path_in_workspace(workspace, &node.file) else {\n            return false;\n        };\n        relative_path == wanted\n            || relative_path.ends_with(&format!(\"/{wanted}\"))\n            || relative_path.rsplit('/').next() == Some(wanted.as_str())\n    }\n\n    fn ensure_workspace_indexed(&self, workspace: &WorkspaceId) -> Result<(), ResolveError> {\n        if self\n            .file_index\n            .keys()\n            .any(|path| self.relative_path_in_workspace(workspace, path).is_some())\n            || self.workspace_has_nodes(workspace)\n        {\n            Ok(())\n        } else {\n            Err(ResolveError::WorkspaceNotIndexed {\n                workspace_id: workspace.clone(),\n            })\n        }\n    }\n\n    fn workspace_has_nodes(&self, workspace: &WorkspaceId) -> bool {\n        self.graph.all_nodes().into_iter().any(|node| {\n            self.relative_path_in_workspace(workspace, &node.file)\n                .is_some()\n        })\n    }\n\n    fn event_ref_appears_ahead_of_index(&self, workspace: &WorkspaceId, ulid: &str) -> bool {\n        self.latest_event_id\n            .as_ref()\n            .filter(|latest| latest.workspace_id == *workspace)\n            .map(|latest| ulid > latest.ulid.as_str())\n            .unwrap_or(false)\n    }\n\n    fn file_id_for_stored_path(\n        &self,\n        workspace: &WorkspaceId,\n        stored_path: &str,\n    ) -> Result<FileId, ResolveError> {\n        let Some(repo_relative_path) = self.relative_path_in_workspace(workspace, stored_path)\n        else {\n            return Err(ResolveError::NotFound {\n                kind: \"file\",\n                query: stored_path.to_string(),\n            });\n        };\n        Ok(FileId {\n            workspace_id: workspace.clone(),\n            repo_relative_path,\n            content_hash: self\n                .file_index\n                .get(stored_path)\n                .map(|entry| entry.content_hash.clone())\n                .unwrap_or_else(|| DEFAULT_CONTENT_HASH.to_string()),\n        })\n    }\n\n    fn symbol_id_for_node(\n        &self,\n        workspace: &WorkspaceId,\n        node: &GraphNode,\n        forced_kind: Option<&str>,\n    ) -> Option<SymbolId> {\n        let file = self.file_id_for_stored_path(workspace, &node.file).ok()?;\n        Some(SymbolId {\n            file,\n            qualified_name: node.name.clone(),\n            byte_offset: node.id.byte_offset,\n            kind: forced_kind\n                .map(str::to_string)\n                .unwrap_or_else(|| format!(\"{:?}\", node.kind).to_lowercase()),\n        })\n    }\n\n    fn stored_path_for_doc(&self, workspace: &WorkspaceId, doc: &DocId) -> Option<String> {\n        self.file_index.keys().find_map(|stored_path| {\n            let relative_path = self.relative_path_in_workspace(workspace, stored_path)?;\n            if relative_path == doc.repo_relative_path {\n                Some(stored_path.clone())\n            } else {\n                None\n            }\n        })\n    }\n\n    fn relative_path_in_workspace(\n        &self,\n        workspace: &WorkspaceId,\n        stored_path: &str,\n    ) -> Option<String> {\n        let normalized = normalize_path(stored_path);\n        let prefix = format!(\"{workspace}/\");\n        if normalized == *workspace {\n            return Some(String::new());\n        }\n        if let Some(stripped) = normalized.strip_prefix(&prefix) {\n            return Some(stripped.to_string());\n        }\n        if workspace == &self.default_workspace && !self.is_namespaced_path(&normalized) {\n            return Some(normalized);\n        }\n        None\n    }\n\n    fn is_namespaced_path(&self, path: &str) -> bool {\n        let first_segment = path.split('/').next().unwrap_or(path);\n        first_segment == self.default_workspace\n            || self\n                .file_index\n                .keys()\n                .filter_map(|item| normalize_path(item).split('/').next().map(str::to_string))\n                .any(|segment| segment == first_segment)\n    }\n\n    fn resolve_file_identity_compat(\n        &self,\n        workspace: &WorkspaceId,\n        query: &str,\n    ) -> Result<Option<FileId>, ResolveError> {\n        let Ok(identity) = decode_identity(query) else {\n            return Ok(None);\n        };\n        let Identity::File(file_id) = identity else {\n            return Ok(None);\n        };\n        if file_id.workspace_id != *workspace {\n            return Err(ResolveError::NotFound {\n                kind: \"file\",\n                query: file_id.to_string(),\n            });\n        }\n        if let Some(current) = self.find_current_file_by_hash(workspace, &file_id) {\n            return Ok(Some(current));\n        }\n        Err(ResolveError::NotFound {\n            kind: \"file\",\n            query: query.to_string(),\n        })\n    }\n\n    fn find_current_file_by_hash(&self, workspace: &WorkspaceId, legacy: &FileId) -> Option<FileId> {\n        let mut matches = self\n            .file_index\n            .iter()\n            .filter(|(stored_path, entry)| {\n                entry.content_hash == legacy.content_hash\n                    && self.relative_path_in_workspace(workspace, stored_path).is_some()\n            })\n            .filter_map(|(stored_path, _)| self.file_id_for_stored_path(workspace, stored_path).ok())\n            .collect::<Vec<_>>();\n        if matches.len() == 1 {\n            return matches.pop();\n        }\n        matches\n            .into_iter()\n            .find(|candidate| candidate.repo_relative_path == legacy.repo_relative_path)\n    }\n}\n\nfn unique_or_ambiguous_symbol(query: &str, candidates: Vec<SymbolId>) -> ResolveOutcome<SymbolId> {\n    match candidates.len() {\n        0 => ResolveOutcome::NotFound(ResolveError::NotFound {\n            kind: \"symbol\",\n            query: query.to_string(),\n        }),\n        1 => ResolveOutcome::Unique(candidates[0].clone()),\n        _ => {\n            let files = candidates\n                .iter()\n                .map(|candidate| candidate.file.repo_relative_path.clone())\n                .collect::<Vec<_>>();\n            let distinct_files = files.iter().collect::<std::collections::HashSet<_>>().len();\n            ResolveOutcome::Ambiguous(AmbiguityReport::new(\n                query,\n                candidates,\n                symbol_disambiguation_hint(distinct_files > 1),\n            ))\n        }\n    }\n}\n\nfn split_symbol_target(target: &str) -> (Option<&str>, &str) {\n    let trimmed = target.trim();\n    if let Some((file, symbol)) = trimmed.rsplit_once(\"::\") {\n        if looks_like_path(file) {\n            return (Some(file), symbol);\n        }\n    }\n    if let Some((file, symbol)) = trimmed.rsplit_once(':') {\n        if looks_like_path(file) {\n            return (Some(file), symbol);\n        }\n    }\n    (None, trimmed)\n}\n\nfn looks_like_path(value: &str) -> bool {\n    value.contains('/') || value.contains('\\\\') || value.contains('.')\n}\n\nfn normalize_path(path: &str) -> String {\n    path.replace('\\\\', \"/\")\n        .trim()\n        .trim_start_matches(\"./\")\n        .trim_start_matches('/')\n        .to_string()\n}\n\nfn normalize_symbol_name(value: &str) -> String {\n    value.trim().trim_matches(':').to_string()\n}\n\nfn normalize_heading(value: &str) -> String {\n    value.trim().to_lowercase()\n}\n\nfn is_test_node(node: &GraphNode) -> bool {\n    let lower_name = node.name.to_lowercase();\n    let lower_file = node.file.to_lowercase();\n    lower_name.starts_with(\"test\")\n        || lower_name.ends_with(\"test\")\n        || lower_file.contains(\"/tests/\")\n        || lower_file.contains(\"_test.\")\n        || lower_file.contains(\".test.\")\n}\n\nfn is_canonical_ulid(value: &str) -> bool {\n    value.len() == 26\n        && value.chars().all(|ch| {\n            matches!(ch, '0'..='9' | 'A'..='Z') && ch != 'I' && ch != 'L' && ch != 'O' && ch != 'U'\n        })\n}\n\n#[cfg(test)]\nmod tests;\n","numLines":733,"startLine":1,"totalLines":733}}}
