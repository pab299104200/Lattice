{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NWd2Fc6Ps511Sf9GwqgHAx","type":"tool_result","content":"1\tuse serde::de::{self, DeserializeOwned};\n2\tuse serde::ser::SerializeStruct;\n3\tuse serde::{Deserialize, Deserializer, Serialize, Serializer};\n4\tuse serde_json::Value;\n5\t\n6\tuse super::ambiguity::ResolveOutcome;\n7\tuse super::encoding::{decode_identity, encode_identity};\n8\tuse super::kinds::{ContextHandleId, DocId, EventId, FileId, Identity, MemoryId, SectionId, SymbolId};\n9\tuse super::resolver::ResolveError;\n10\t\n11\t#[derive(Clone, Debug, PartialEq, Eq)]\n12\tpub struct IdentityPayload {\n13\t    pub id: String,\n14\t    pub fields: Identity,\n15\t    pub legacy_name: Option<String>,\n16\t}\n17\t\n18\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n19\tpub struct IdentityAmbiguityPayload {\n20\t    pub status: String,\n21\t    pub query: String,\n22\t    pub disambiguation_hint: String,\n23\t    pub candidates: Vec<IdentityPayload>,\n24\t}\n25\t\n26\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n27\t#[serde(tag = \"status\", rename_all = \"snake_case\")]\n28\tpub enum IdentityPayloadOrAmbiguity {\n29\t    Resolved {\n30\t        payload: IdentityPayload,\n31\t    },\n32\t    Ambiguous {\n33\t        query: String,\n34\t        disambiguation_hint: String,\n35\t        candidates: Vec<IdentityPayload>,\n36\t    },\n37\t    NotFound {\n38\t        kind: String,\n39\t        query: String,\n40\t        reason: String,\n41\t    },\n42\t}\n43\t\n44\timpl IdentityPayload {\n45\t    pub fn new(identity: Identity, legacy_name: Option<String>) -> Self {\n46\t        Self {\n47\t            id: encode_identity(&identity),\n48\t            fields: identity,\n49\t            legacy_name,\n50\t        }\n51\t    }\n52\t}\n53\t\n54\timpl Serialize for IdentityPayload {\n55\t    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>\n56\t    where\n57\t        S: Serializer,\n58\t    {\n59\t        let mut state = serializer.serialize_struct(\"IdentityPayload\", 3)?;\n60\t        state.serialize_field(\"id\", &self.id)?;\n61\t        state.serialize_field(\"fields\", &identity_fields_value(&self.fields))?;\n62\t        if let Some(legacy_name) = &self.legacy_name {\n63\t            state.serialize_field(\"legacy_name\", legacy_name)?;\n64\t        }\n65\t        state.end()\n66\t    }\n67\t}\n68\t\n69\timpl<'de> Deserialize<'de> for IdentityPayload {\n70\t    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n71\t    where\n72\t        D: Deserializer<'de>,\n73\t    {\n74\t        #[derive(Deserialize)]\n75\t        struct RawIdentityPayload {\n76\t            id: String,\n77\t            fields: Option<Value>,\n78\t            legacy_name: Option<String>,\n79\t        }\n80\t\n81\t        let raw = RawIdentityPayload::deserialize(deserializer)?;\n82\t        let decoded = decode_identity(&raw.id).map_err(de::Error::custom)?;\n83\t        let fields = if let Some(value) = raw.fields {\n84\t            decode_identity_fields(&decoded, value).map_err(de::Error::custom)?\n85\t        } else {\n86\t            decoded\n87\t        };\n88\t\n89\t        Ok(Self {\n90\t            id: raw.id,\n91\t            fields,\n92\t            legacy_name: raw.legacy_name,\n93\t        })\n94\t    }\n95\t}\n96\t\n97\tpub fn serialize_outcome<T>(outcome: ResolveOutcome<T>, legacy_name: Option<&str>) -> IdentityPayloadOrAmbiguity\n98\twhere\n99\t    T: Into<Identity>,\n100\t{\n101\t    match outcome {\n102\t        ResolveOutcome::Unique(identity) => IdentityPayloadOrAmbiguity::Resolved {\n103\t            payload: IdentityPayload::new(identity.into(), legacy_name.map(str::to_string)),\n104\t        },\n105\t        ResolveOutcome::Ambiguous(report) => IdentityPayloadOrAmbiguity::Ambiguous {\n106\t            query: report.query,\n107\t            disambiguation_hint: report.disambiguation_hint,\n108\t            candidates: report\n109\t                .candidates\n110\t                .into_iter()\n111\t                .map(|candidate| {\n112\t                    IdentityPayload::new(candidate.into(), legacy_name.map(str::to_string))\n113\t                })\n114\t                .collect(),\n115\t        },\n116\t        ResolveOutcome::NotFound(error) => IdentityPayloadOrAmbiguity::NotFound {\n117\t            kind: not_found_kind(&error).to_string(),\n118\t            query: not_found_query(&error),\n119\t            reason: error.to_string(),\n120\t        },\n121\t    }\n122\t}\n123\t\n124\tfn identity_fields_value(identity: &Identity) -> Value {\n125\t    match identity {\n126\t        Identity::File(value) => serde_json::to_value(value).expect(\"file identity fields serialize\"),\n127\t        Identity::Symbol(value) => {\n128\t            serde_json::to_value(value).expect(\"symbol identity fields serialize\")\n129\t        }\n130\t        Identity::Doc(value) => serde_json::to_value(value).expect(\"doc identity fields serialize\"),\n131\t        Identity::Section(value) => {\n132\t            serde_json::to_value(value).expect(\"section identity fields serialize\")\n133\t        }\n134\t        Identity::Event(value) => {\n135\t            serde_json::to_value(value).expect(\"event identity fields serialize\")\n136\t        }\n137\t        Identity::Memory(value) => {\n138\t            serde_json::to_value(value).expect(\"memory identity fields serialize\")\n139\t        }\n140\t        Identity::ContextHandle(value) => {\n141\t            serde_json::to_value(value).expect(\"context handle identity fields serialize\")\n142\t        }\n143\t    }\n144\t}\n145\t\n146\tfn decode_identity_fields(expected: &Identity, value: Value) -> Result<Identity, String> {\n147\t    if let Value::String(compact) = &value {\n148\t        return decode_identity(compact).map_err(|error| error.to_string());\n149\t    }\n150\t\n151\t    match expected {\n152\t        Identity::File(_) => decode_struct::<FileId>(value).map(Identity::File),\n153\t        Identity::Symbol(_) => decode_struct::<SymbolId>(value).map(Identity::Symbol),\n154\t        Identity::Doc(_) => decode_struct::<DocId>(value).map(Identity::Doc),\n155\t        Identity::Section(_) => decode_struct::<SectionId>(value).map(Identity::Section),\n156\t        Identity::Event(_) => decode_struct::<EventId>(value).map(Identity::Event),\n157\t        Identity::Memory(_) => decode_struct::<MemoryId>(value).map(Identity::Memory),\n158\t        Identity::ContextHandle(_) => {\n159\t            decode_struct::<ContextHandleId>(value).map(Identity::ContextHandle)\n160\t        }\n161\t    }\n162\t}\n163\t\n164\tfn decode_struct<T>(value: Value) -> Result<T, String>\n165\twhere\n166\t    T: DeserializeOwned,\n167\t{\n168\t    serde_json::from_value(value).map_err(|error| error.to_string())\n169\t}\n170\t\n171\tfn not_found_kind(error: &ResolveError) -> &'static str {\n172\t    match error {\n173\t        ResolveError::WorkspaceNotIndexed { .. } => \"workspace\",\n174\t        ResolveError::Malformed { kind, .. } => kind,\n175\t        ResolveError::NotFound { kind, .. } => kind,\n176\t        ResolveError::IndexLagBehind { .. } => \"event\",\n177\t    }\n178\t}\n179\t\n180\tfn not_found_query(error: &ResolveError) -> String {\n181\t    match error {\n182\t        ResolveError::WorkspaceNotIndexed { workspace_id } => workspace_id.clone(),\n183\t        ResolveError::Malformed { query, .. } => query.clone(),\n184\t        ResolveError::NotFound { query, .. } => query.clone(),\n185\t        ResolveError::IndexLagBehind { latest_event_id } => latest_event_id.to_string(),\n186\t    }\n187\t}\n188\t\n189\t#[cfg(test)]\n190\tmod tests {\n191\t    use serde_json::json;\n192\t\n193\t    use super::{serialize_outcome, IdentityPayload, IdentityPayloadOrAmbiguity};\n194\t    use crate::identity::ambiguity::{AmbiguityReport, ResolveOutcome};\n195\t    use crate::identity::kinds::{FileId, Identity, SymbolId};\n196\t    use crate::identity::resolver::ResolveError;\n197\t\n198\t    fn symbol_identity() -> Identity {\n199\t        Identity::Symbol(SymbolId {\n200\t            file: FileId {\n201\t                workspace_id: \"workspace-main\".to_string(),\n202\t                repo_relative_path: \"src/auth.ts\".to_string(),\n203\t                content_hash: \"abcdef12\".to_string(),\n204\t            },\n205\t            qualified_name: \"loginUser\".to_string(),\n206\t            byte_offset: 128,\n207\t            kind: \"function\".to_string(),\n208\t        })\n209\t    }\n210\t\n211\t    #[test]\n212\t    fn compact_form_round_trips() {\n213\t        let payload = IdentityPayload::new(symbol_identity(), Some(\"loginUser\".to_string()));\n214\t\n215\t        let serialized = serde_json::to_value(&payload).expect(\"serialize payload\");\n216\t        let deserialized: IdentityPayload =\n217\t            serde_json::from_value(serialized.clone()).expect(\"deserialize payload\");\n218\t\n219\t        assert_eq!(deserialized, payload);\n220\t        assert_eq!(serialized[\"legacy_name\"].as_str(), Some(\"loginUser\"));\n221\t        assert_eq!(serialized[\"id\"].as_str(), Some(payload.id.as_str()));\n222\t    }\n223\t\n224\t    #[test]\n225\t    fn structured_form_is_accepted() {\n226\t        let payload = IdentityPayload::new(symbol_identity(), Some(\"loginUser\".to_string()));\n227\t        let parsed: IdentityPayload = serde_json::from_value(json!({\n228\t            \"id\": payload.id,\n229\t            \"fields\": {\n230\t                \"file\": {\n231\t                    \"workspace_id\": \"workspace-main\",\n232\t                    \"repo_relative_path\": \"src/auth.ts\",\n233\t                    \"content_hash\": \"abcdef12\"\n234\t                },\n235\t                \"qualified_name\": \"loginUser\",\n236\t                \"byte_offset\": 128,\n237\t                \"kind\": \"function\"\n238\t            },\n239\t            \"legacy_name\": \"loginUser\"\n240\t        }))\n241\t        .expect(\"structured payload should deserialize\");\n242\t\n243\t        assert_eq!(parsed.fields, symbol_identity());\n244\t        assert_eq!(parsed.legacy_name.as_deref(), Some(\"loginUser\"));\n245\t    }\n246\t\n247\t    #[test]\n248\t    fn legacy_name_is_preserved() {\n249\t        let outcome = ResolveOutcome::Unique(SymbolId {\n250\t            file: FileId {\n251\t                workspace_id: \"workspace-main\".to_string(),\n252\t                repo_relative_path: \"src/auth.ts\".to_string(),\n253\t                content_hash: \"abcdef12\".to_string(),\n254\t            },\n255\t            qualified_name: \"loginUser\".to_string(),\n256\t            byte_offset: 128,\n257\t            kind: \"function\".to_string(),\n258\t        });\n259\t\n260\t        let serialized = serialize_outcome(outcome, Some(\"loginUser\"));\n261\t\n262\t        match serialized {\n263\t            IdentityPayloadOrAmbiguity::Resolved { payload } => {\n264\t                assert_eq!(payload.legacy_name.as_deref(), Some(\"loginUser\"));\n265\t            }\n266\t            other => panic!(\"expected resolved payload, got {other:?}\"),\n267\t        }\n268\t    }\n269\t\n270\t    #[test]\n271\t    fn ambiguity_payload_shape_is_structured() {\n272\t        let candidate = SymbolId {\n273\t            file: FileId {\n274\t                workspace_id: \"workspace-main\".to_string(),\n275\t                repo_relative_path: \"src/auth.ts\".to_string(),\n276\t                content_hash: \"abcdef12\".to_string(),\n277\t            },\n278\t            qualified_name: \"loginUser\".to_string(),\n279\t            byte_offset: 128,\n280\t            kind: \"function\".to_string(),\n281\t        };\n282\t        let ambiguous = ResolveOutcome::Ambiguous(AmbiguityReport::new(\n283\t            \"loginUser\",\n284\t            vec![candidate.clone(), candidate],\n285\t            \"Add the parent module or file path, or use the stable symbol identity.\",\n286\t        ));\n287\t\n288\t        let serialized = serde_json::to_value(serialize_outcome(ambiguous, Some(\"loginUser\")))\n289\t            .expect(\"serialize ambiguity\");\n290\t\n291\t        assert_eq!(serialized[\"status\"].as_str(), Some(\"ambiguous\"));\n292\t        assert_eq!(serialized[\"query\"].as_str(), Some(\"loginUser\"));\n293\t        assert_eq!(serialized[\"candidates\"].as_array().map(Vec::len), Some(2));\n294\t        assert_eq!(\n295\t            serialized[\"candidates\"][0][\"legacy_name\"].as_str(),\n296\t            Some(\"loginUser\")\n297\t        );\n298\t    }\n299\t\n300\t    #[test]\n301\t    fn not_found_outcome_is_truthful() {\n302\t        let serialized = serde_json::to_value(serialize_outcome(\n303\t            ResolveOutcome::<SymbolId>::NotFound(ResolveError::NotFound {\n304\t                kind: \"symbol\",\n305\t                query: \"missing\".to_string(),\n306\t            }),\n307\t            Some(\"missing\"),\n308\t        ))\n309\t        .expect(\"serialize not found\");\n310\t\n311\t        assert_eq!(serialized[\"status\"].as_str(), Some(\"not_found\"));\n312\t        assert_eq!(serialized[\"kind\"].as_str(), Some(\"symbol\"));\n313\t        assert!(\n314\t            serialized[\"reason\"]\n315\t                .as_str()\n316\t                .is_some_and(|reason| reason.contains(\"no symbol identity found\"))\n317\t        );\n318\t    }\n319\t}\n320\t"}]},"parent_tool_use_id":null,"session_id":"beca6473-0a8b-4b3f-8c29-18a74c665d8f","uuid":"01bad159-ff20-443b-aa11-effbff536a04","timestamp":"2026-05-17T04:19:19.579Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/identity/serialization.rs","content":"use serde::de::{self, DeserializeOwned};\nuse serde::ser::SerializeStruct;\nuse serde::{Deserialize, Deserializer, Serialize, Serializer};\nuse serde_json::Value;\n\nuse super::ambiguity::ResolveOutcome;\nuse super::encoding::{decode_identity, encode_identity};\nuse super::kinds::{ContextHandleId, DocId, EventId, FileId, Identity, MemoryId, SectionId, SymbolId};\nuse super::resolver::ResolveError;\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct IdentityPayload {\n    pub id: String,\n    pub fields: Identity,\n    pub legacy_name: Option<String>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct IdentityAmbiguityPayload {\n    pub status: String,\n    pub query: String,\n    pub disambiguation_hint: String,\n    pub candidates: Vec<IdentityPayload>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(tag = \"status\", rename_all = \"snake_case\")]\npub enum IdentityPayloadOrAmbiguity {\n    Resolved {\n        payload: IdentityPayload,\n    },\n    Ambiguous {\n        query: String,\n        disambiguation_hint: String,\n        candidates: Vec<IdentityPayload>,\n    },\n    NotFound {\n        kind: String,\n        query: String,\n        reason: String,\n    },\n}\n\nimpl IdentityPayload {\n    pub fn new(identity: Identity, legacy_name: Option<String>) -> Self {\n        Self {\n            id: encode_identity(&identity),\n            fields: identity,\n            legacy_name,\n        }\n    }\n}\n\nimpl Serialize for IdentityPayload {\n    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>\n    where\n        S: Serializer,\n    {\n        let mut state = serializer.serialize_struct(\"IdentityPayload\", 3)?;\n        state.serialize_field(\"id\", &self.id)?;\n        state.serialize_field(\"fields\", &identity_fields_value(&self.fields))?;\n        if let Some(legacy_name) = &self.legacy_name {\n            state.serialize_field(\"legacy_name\", legacy_name)?;\n        }\n        state.end()\n    }\n}\n\nimpl<'de> Deserialize<'de> for IdentityPayload {\n    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n    where\n        D: Deserializer<'de>,\n    {\n        #[derive(Deserialize)]\n        struct RawIdentityPayload {\n            id: String,\n            fields: Option<Value>,\n            legacy_name: Option<String>,\n        }\n\n        let raw = RawIdentityPayload::deserialize(deserializer)?;\n        let decoded = decode_identity(&raw.id).map_err(de::Error::custom)?;\n        let fields = if let Some(value) = raw.fields {\n            decode_identity_fields(&decoded, value).map_err(de::Error::custom)?\n        } else {\n            decoded\n        };\n\n        Ok(Self {\n            id: raw.id,\n            fields,\n            legacy_name: raw.legacy_name,\n        })\n    }\n}\n\npub fn serialize_outcome<T>(outcome: ResolveOutcome<T>, legacy_name: Option<&str>) -> IdentityPayloadOrAmbiguity\nwhere\n    T: Into<Identity>,\n{\n    match outcome {\n        ResolveOutcome::Unique(identity) => IdentityPayloadOrAmbiguity::Resolved {\n            payload: IdentityPayload::new(identity.into(), legacy_name.map(str::to_string)),\n        },\n        ResolveOutcome::Ambiguous(report) => IdentityPayloadOrAmbiguity::Ambiguous {\n            query: report.query,\n            disambiguation_hint: report.disambiguation_hint,\n            candidates: report\n                .candidates\n                .into_iter()\n                .map(|candidate| {\n                    IdentityPayload::new(candidate.into(), legacy_name.map(str::to_string))\n                })\n                .collect(),\n        },\n        ResolveOutcome::NotFound(error) => IdentityPayloadOrAmbiguity::NotFound {\n            kind: not_found_kind(&error).to_string(),\n            query: not_found_query(&error),\n            reason: error.to_string(),\n        },\n    }\n}\n\nfn identity_fields_value(identity: &Identity) -> Value {\n    match identity {\n        Identity::File(value) => serde_json::to_value(value).expect(\"file identity fields serialize\"),\n        Identity::Symbol(value) => {\n            serde_json::to_value(value).expect(\"symbol identity fields serialize\")\n        }\n        Identity::Doc(value) => serde_json::to_value(value).expect(\"doc identity fields serialize\"),\n        Identity::Section(value) => {\n            serde_json::to_value(value).expect(\"section identity fields serialize\")\n        }\n        Identity::Event(value) => {\n            serde_json::to_value(value).expect(\"event identity fields serialize\")\n        }\n        Identity::Memory(value) => {\n            serde_json::to_value(value).expect(\"memory identity fields serialize\")\n        }\n        Identity::ContextHandle(value) => {\n            serde_json::to_value(value).expect(\"context handle identity fields serialize\")\n        }\n    }\n}\n\nfn decode_identity_fields(expected: &Identity, value: Value) -> Result<Identity, String> {\n    if let Value::String(compact) = &value {\n        return decode_identity(compact).map_err(|error| error.to_string());\n    }\n\n    match expected {\n        Identity::File(_) => decode_struct::<FileId>(value).map(Identity::File),\n        Identity::Symbol(_) => decode_struct::<SymbolId>(value).map(Identity::Symbol),\n        Identity::Doc(_) => decode_struct::<DocId>(value).map(Identity::Doc),\n        Identity::Section(_) => decode_struct::<SectionId>(value).map(Identity::Section),\n        Identity::Event(_) => decode_struct::<EventId>(value).map(Identity::Event),\n        Identity::Memory(_) => decode_struct::<MemoryId>(value).map(Identity::Memory),\n        Identity::ContextHandle(_) => {\n            decode_struct::<ContextHandleId>(value).map(Identity::ContextHandle)\n        }\n    }\n}\n\nfn decode_struct<T>(value: Value) -> Result<T, String>\nwhere\n    T: DeserializeOwned,\n{\n    serde_json::from_value(value).map_err(|error| error.to_string())\n}\n\nfn not_found_kind(error: &ResolveError) -> &'static str {\n    match error {\n        ResolveError::WorkspaceNotIndexed { .. } => \"workspace\",\n        ResolveError::Malformed { kind, .. } => kind,\n        ResolveError::NotFound { kind, .. } => kind,\n        ResolveError::IndexLagBehind { .. } => \"event\",\n    }\n}\n\nfn not_found_query(error: &ResolveError) -> String {\n    match error {\n        ResolveError::WorkspaceNotIndexed { workspace_id } => workspace_id.clone(),\n        ResolveError::Malformed { query, .. } => query.clone(),\n        ResolveError::NotFound { query, .. } => query.clone(),\n        ResolveError::IndexLagBehind { latest_event_id } => latest_event_id.to_string(),\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use serde_json::json;\n\n    use super::{serialize_outcome, IdentityPayload, IdentityPayloadOrAmbiguity};\n    use crate::identity::ambiguity::{AmbiguityReport, ResolveOutcome};\n    use crate::identity::kinds::{FileId, Identity, SymbolId};\n    use crate::identity::resolver::ResolveError;\n\n    fn symbol_identity() -> Identity {\n        Identity::Symbol(SymbolId {\n            file: FileId {\n                workspace_id: \"workspace-main\".to_string(),\n                repo_relative_path: \"src/auth.ts\".to_string(),\n                content_hash: \"abcdef12\".to_string(),\n            },\n            qualified_name: \"loginUser\".to_string(),\n            byte_offset: 128,\n            kind: \"function\".to_string(),\n        })\n    }\n\n    #[test]\n    fn compact_form_round_trips() {\n        let payload = IdentityPayload::new(symbol_identity(), Some(\"loginUser\".to_string()));\n\n        let serialized = serde_json::to_value(&payload).expect(\"serialize payload\");\n        let deserialized: IdentityPayload =\n            serde_json::from_value(serialized.clone()).expect(\"deserialize payload\");\n\n        assert_eq!(deserialized, payload);\n        assert_eq!(serialized[\"legacy_name\"].as_str(), Some(\"loginUser\"));\n        assert_eq!(serialized[\"id\"].as_str(), Some(payload.id.as_str()));\n    }\n\n    #[test]\n    fn structured_form_is_accepted() {\n        let payload = IdentityPayload::new(symbol_identity(), Some(\"loginUser\".to_string()));\n        let parsed: IdentityPayload = serde_json::from_value(json!({\n            \"id\": payload.id,\n            \"fields\": {\n                \"file\": {\n                    \"workspace_id\": \"workspace-main\",\n                    \"repo_relative_path\": \"src/auth.ts\",\n                    \"content_hash\": \"abcdef12\"\n                },\n                \"qualified_name\": \"loginUser\",\n                \"byte_offset\": 128,\n                \"kind\": \"function\"\n            },\n            \"legacy_name\": \"loginUser\"\n        }))\n        .expect(\"structured payload should deserialize\");\n\n        assert_eq!(parsed.fields, symbol_identity());\n        assert_eq!(parsed.legacy_name.as_deref(), Some(\"loginUser\"));\n    }\n\n    #[test]\n    fn legacy_name_is_preserved() {\n        let outcome = ResolveOutcome::Unique(SymbolId {\n            file: FileId {\n                workspace_id: \"workspace-main\".to_string(),\n                repo_relative_path: \"src/auth.ts\".to_string(),\n                content_hash: \"abcdef12\".to_string(),\n            },\n            qualified_name: \"loginUser\".to_string(),\n            byte_offset: 128,\n            kind: \"function\".to_string(),\n        });\n\n        let serialized = serialize_outcome(outcome, Some(\"loginUser\"));\n\n        match serialized {\n            IdentityPayloadOrAmbiguity::Resolved { payload } => {\n                assert_eq!(payload.legacy_name.as_deref(), Some(\"loginUser\"));\n            }\n            other => panic!(\"expected resolved payload, got {other:?}\"),\n        }\n    }\n\n    #[test]\n    fn ambiguity_payload_shape_is_structured() {\n        let candidate = SymbolId {\n            file: FileId {\n                workspace_id: \"workspace-main\".to_string(),\n                repo_relative_path: \"src/auth.ts\".to_string(),\n                content_hash: \"abcdef12\".to_string(),\n            },\n            qualified_name: \"loginUser\".to_string(),\n            byte_offset: 128,\n            kind: \"function\".to_string(),\n        };\n        let ambiguous = ResolveOutcome::Ambiguous(AmbiguityReport::new(\n            \"loginUser\",\n            vec![candidate.clone(), candidate],\n            \"Add the parent module or file path, or use the stable symbol identity.\",\n        ));\n\n        let serialized = serde_json::to_value(serialize_outcome(ambiguous, Some(\"loginUser\")))\n            .expect(\"serialize ambiguity\");\n\n        assert_eq!(serialized[\"status\"].as_str(), Some(\"ambiguous\"));\n        assert_eq!(serialized[\"query\"].as_str(), Some(\"loginUser\"));\n        assert_eq!(serialized[\"candidates\"].as_array().map(Vec::len), Some(2));\n        assert_eq!(\n            serialized[\"candidates\"][0][\"legacy_name\"].as_str(),\n            Some(\"loginUser\")\n        );\n    }\n\n    #[test]\n    fn not_found_outcome_is_truthful() {\n        let serialized = serde_json::to_value(serialize_outcome(\n            ResolveOutcome::<SymbolId>::NotFound(ResolveError::NotFound {\n                kind: \"symbol\",\n                query: \"missing\".to_string(),\n            }),\n            Some(\"missing\"),\n        ))\n        .expect(\"serialize not found\");\n\n        assert_eq!(serialized[\"status\"].as_str(), Some(\"not_found\"));\n        assert_eq!(serialized[\"kind\"].as_str(), Some(\"symbol\"));\n        assert!(\n            serialized[\"reason\"]\n                .as_str()\n                .is_some_and(|reason| reason.contains(\"no symbol identity found\"))\n        );\n    }\n}\n","numLines":320,"startLine":1,"totalLines":320}}}
