{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HAS65FbUjoCkqe87K7arnR","type":"tool_result","content":"1\t//! Phase 1 identity-resolution correctness tests for\n2\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n3\t//! `## Phase 1: Unified Identity Model`.\n4\t//!\n5\t//! This matrix covers the spec-mandated rename, move, duplicate-name, and\n6\t//! branch-change behaviors, plus the compatibility paths that keep legacy\n7\t//! references working while Phase 1 introduces stable identities.\n8\t\n9\tuse super::{EventId, FileId, Identity, ResolveOutcome};\n10\t\n11\tconst MAIN_WORKSPACE: &str = \"main\";\n12\tconst FEATURE_WORKSPACE: &str = \"feature\";\n13\t\n14\t#[test]\n15\tfn test_resolve_path_unique_returns_fileid() {\n16\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n17\t        .rust(MAIN_WORKSPACE, \"src/lib.rs\", \"pub fn login_user() {}\\n\")\n18\t        .build();\n19\t\n20\t    let resolved = fixture\n21\t        .resolver\n22\t        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), \"src/lib.rs\")\n23\t        .expect(\"path should resolve\");\n24\t\n25\t    assert_eq!(resolved.workspace_id, MAIN_WORKSPACE);\n26\t    assert_eq!(resolved.repo_relative_path, \"src/lib.rs\");\n27\t}\n28\t\n29\t#[test]\n30\tfn test_resolve_path_after_file_rename_returns_new_id() {\n31\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n32\t        .rust(MAIN_WORKSPACE, \"src/renamed.rs\", \"pub fn login_user() {}\\n\")\n33\t        .build();\n34\t\n35\t    let resolved = fixture\n36\t        .resolver\n37\t        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), \"src/renamed.rs\")\n38\t        .expect(\"renamed path should resolve\");\n39\t\n40\t    assert_eq!(resolved.repo_relative_path, \"src/renamed.rs\");\n41\t}\n42\t\n43\t#[test]\n44\tfn test_resolve_path_after_file_rename_legacy_name_returns_via_compat_shim() {\n45\t    let source = \"pub fn login_user() {}\\n\";\n46\t    let old_identity = Identity::File(FileId {\n47\t        workspace_id: MAIN_WORKSPACE.to_string(),\n48\t        repo_relative_path: \"src/original.rs\".to_string(),\n49\t        content_hash: helpers::content_hash(source),\n50\t    })\n51\t    .to_string();\n52\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n53\t        .rust(MAIN_WORKSPACE, \"src/renamed.rs\", source)\n54\t        .build();\n55\t\n56\t    let resolved = fixture\n57\t        .resolver\n58\t        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), &old_identity)\n59\t        .expect(\"legacy file identity should remap to current path\");\n60\t\n61\t    assert_eq!(resolved.repo_relative_path, \"src/renamed.rs\");\n62\t    assert_eq!(resolved.content_hash, helpers::content_hash(source));\n63\t}\n64\t\n65\t#[test]\n66\tfn test_resolve_symbol_unique_returns_symbolid() {\n67\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n68\t        .rust(\n69\t            MAIN_WORKSPACE,\n70\t            \"src/auth.rs\",\n71\t            \"pub fn login_user() {}\\npub fn logout_user() {}\\n\",\n72\t        )\n73\t        .build();\n74\t\n75\t    let resolved = fixture\n76\t        .resolver\n77\t        .resolve_symbol(&fixture.workspace(MAIN_WORKSPACE), \"login_user\");\n78\t\n79\t    let symbol_id = helpers::expect_unique_symbol(resolved);\n80\t    assert_eq!(symbol_id.file.repo_relative_path, \"src/auth.rs\");\n81\t    assert_eq!(symbol_id.qualified_name, \"login_user\");\n82\t}\n83\t\n84\t#[test]\n85\tfn test_resolve_symbol_duplicate_name_returns_ambiguous_with_disambiguation_hint() {\n86\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n87\t        .rust(MAIN_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n88\t        .rust(MAIN_WORKSPACE, \"src/admin.rs\", \"pub fn shared() {}\\n\")\n89\t        .build();\n90\t\n91\t    let resolved = fixture\n92\t        .resolver\n93\t        .resolve_symbol(&fixture.workspace(MAIN_WORKSPACE), \"shared\");\n94\t\n95\t    let report = helpers::expect_ambiguous_symbol(resolved);\n96\t    assert_eq!(report.candidates.len(), 2);\n97\t    assert!(report.disambiguation_hint.contains(\"file path\"));\n98\t}\n99\t\n100\t#[test]\n101\tfn test_resolve_section_after_heading_rename_returns_new_id() {\n102\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n103\t        .markdown(\n104\t            MAIN_WORKSPACE,\n105\t            \"docs/guide.md\",\n106\t            \"# Overview\\n\\n## Current Heading\\nBody\\n\",\n107\t        )\n108\t        .build();\n109\t    let doc = fixture.doc_id(MAIN_WORKSPACE, \"docs/guide.md\");\n110\t\n111\t    let resolved = fixture\n112\t        .resolver\n113\t        .resolve_section(&fixture.workspace(MAIN_WORKSPACE), &doc, \"Current Heading\");\n114\t\n115\t    let section_id = helpers::expect_unique_section(resolved);\n116\t    assert_eq!(section_id.doc.repo_relative_path, \"docs/guide.md\");\n117\t    assert_eq!(section_id.heading_path, vec![\"Current Heading\".to_string()]);\n118\t}\n119\t\n120\t#[test]\n121\tfn test_resolve_section_after_section_move_returns_new_id() {\n122\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n123\t        .markdown(\n124\t            MAIN_WORKSPACE,\n125\t            \"docs/runbook.md\",\n126\t            \"# Runbook\\n\\n## Intro\\nText\\n\\n## Deploy\\nMove target\\n\",\n127\t        )\n128\t        .build();\n129\t    let doc = fixture.doc_id(MAIN_WORKSPACE, \"docs/runbook.md\");\n130\t\n131\t    let resolved = fixture\n132\t        .resolver\n133\t        .resolve_section(&fixture.workspace(MAIN_WORKSPACE), &doc, \"Deploy\");\n134\t\n135\t    let section_id = helpers::expect_unique_section(resolved);\n136\t    assert_eq!(section_id.doc.repo_relative_path, \"docs/runbook.md\");\n137\t    assert!(section_id.byte_offset > 20);\n138\t}\n139\t\n140\t#[test]\n141\tfn test_resolve_symbol_on_different_branch_returns_branch_scoped_id() {\n142\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n143\t        .rust(MAIN_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n144\t        .rust(FEATURE_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n145\t        .build();\n146\t\n147\t    let resolved = fixture\n148\t        .resolver\n149\t        .resolve_symbol(&fixture.workspace(FEATURE_WORKSPACE), \"shared\");\n150\t\n151\t    let symbol_id = helpers::expect_unique_symbol(resolved);\n152\t    assert_eq!(symbol_id.file.workspace_id, FEATURE_WORKSPACE);\n153\t    assert_eq!(symbol_id.file.repo_relative_path, \"src/auth.rs\");\n154\t}\n155\t\n156\t#[test]\n157\tfn test_resolve_event_ref_round_trips_through_encoding() {\n158\t    let event_id = EventId {\n159\t        workspace_id: MAIN_WORKSPACE.to_string(),\n160\t        ulid: \"01J0000000000000000000000A\".to_string(),\n161\t    };\n162\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n163\t        .event(event_id.clone())\n164\t        .build();\n165\t\n166\t    let resolved = fixture\n167\t        .resolver\n168\t        .resolve_event_ref(&fixture.workspace(MAIN_WORKSPACE), &Identity::Event(event_id).to_string())\n169\t        .expect(\"event identity should resolve\");\n170\t\n171\t    assert_eq!(resolved.workspace_id, MAIN_WORKSPACE);\n172\t    assert_eq!(resolved.ulid, \"01J0000000000000000000000A\");\n173\t}\n174\t\n175\t#[test]\n176\tfn test_resolve_legacy_symbol_name_routes_via_default_workspace() {\n177\t    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n178\t        .rust(MAIN_WORKSPACE, \"src/legacy.rs\", \"pub fn only_main() {}\\n\")\n179\t        .rust(FEATURE_WORKSPACE, \"src/feature.rs\", \"pub fn feature_only() {}\\n\")\n180\t        .build();\n181\t\n182\t    let resolved = fixture.resolver.resolve_legacy_symbol_name(\"only_main\");\n183\t\n184\t    let symbol_id = helpers::expect_unique_symbol(resolved);\n185\t    assert_eq!(symbol_id.file.workspace_id, MAIN_WORKSPACE);\n186\t    assert_eq!(symbol_id.file.repo_relative_path, \"src/legacy.rs\");\n187\t}\n188\t\n189\tpub(crate) mod helpers {\n190\t    use std::collections::HashMap;\n191\t\n192\t    use crate::graph::CodeGraph;\n193\t    use crate::identity::{AmbiguityReport, DocId, EventId, IdentityResolver, SectionId, SymbolId};\n194\t    use crate::parser::parse_file;\n195\t    use crate::storage::graph_store::{FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION};\n196\t    use crate::symbols::ParsedFile;\n197\t\n198\t    use super::ResolveOutcome;\n199\t\n200\t    pub(crate) struct ResolverFixture {\n201\t        pub(crate) resolver: IdentityResolver<'static>,\n202\t        docs: HashMap<(String, String), DocId>,\n203\t    }\n204\t\n205\t    impl ResolverFixture {\n206\t        pub(crate) fn workspace(&self, workspace: &str) -> String {\n207\t            workspace.to_string()\n208\t        }\n209\t\n210\t        pub(crate) fn doc_id(&self, workspace: &str, path: &str) -> DocId {\n211\t            self.docs\n212\t                .get(&(workspace.to_string(), path.to_string()))\n213\t                .cloned()\n214\t                .expect(\"document fixture should exist\")\n215\t        }\n216\t    }\n217\t\n218\t    pub(crate) struct FixtureBuilder {\n219\t        default_workspace: String,\n220\t        files: Vec<FixtureFile>,\n221\t        events: Vec<EventId>,\n222\t    }\n223\t\n224\t    struct FixtureFile {\n225\t        workspace: String,\n226\t        repo_relative_path: String,\n227\t        source: String,\n228\t    }\n229\t\n230\t    impl FixtureBuilder {\n231\t        pub(crate) fn new(default_workspace: &str) -> Self {\n232\t            Self {\n233\t                default_workspace: default_workspace.to_string(),\n234\t                files: Vec::new(),\n235\t                events: Vec::new(),\n236\t            }\n237\t        }\n238\t\n239\t        pub(crate) fn rust(mut self, workspace: &str, path: &str, source: &str) -> Self {\n240\t            self.files.push(FixtureFile::new(workspace, path, source));\n241\t            self\n242\t        }\n243\t\n244\t        pub(crate) fn markdown(mut self, workspace: &str, path: &str, source: &str) -> Self {\n245\t            self.files.push(FixtureFile::new(workspace, path, source));\n246\t            self\n247\t        }\n248\t\n249\t        pub(crate) fn event(mut self, event_id: EventId) -> Self {\n250\t            self.events.push(event_id);\n251\t            self\n252\t        }\n253\t\n254\t        pub(crate) fn build(self) -> ResolverFixture {\n255\t            let mut graph = CodeGraph::new();\n256\t            let mut file_index = HashMap::new();\n257\t            let mut parsed_files = HashMap::new();\n258\t            let mut docs = HashMap::new();\n259\t\n260\t            for file in self.files {\n261\t                let stored_path = file.stored_path();\n262\t                let parsed_file = parse_file(&stored_path, &file.source).expect(\"fixture should parse\");\n263\t                add_symbols(&mut graph, &parsed_file);\n264\t                if file.repo_relative_path.ends_with(\".md\") {\n265\t                    docs.insert(\n266\t                        (file.workspace.clone(), file.repo_relative_path.clone()),\n267\t                        doc_id(&file.workspace, &file.repo_relative_path, &file.source),\n268\t                    );\n269\t                }\n270\t                parsed_files.insert(stored_path.clone(), parsed_file);\n271\t                file_index.insert(stored_path.clone(), file_index_entry(&stored_path, &file.source));\n272\t            }\n273\t\n274\t            let resolver = IdentityResolver::new(\n275\t                Box::leak(Box::new(graph)),\n276\t                Box::leak(Box::new(file_index)),\n277\t                Box::leak(Box::new(parsed_files)),\n278\t                self.default_workspace,\n279\t                self.events,\n280\t            );\n281\t            ResolverFixture { resolver, docs }\n282\t        }\n283\t    }\n284\t\n285\t    impl FixtureFile {\n286\t        fn new(workspace: &str, path: &str, source: &str) -> Self {\n287\t            Self {\n288\t                workspace: workspace.to_string(),\n289\t                repo_relative_path: path.to_string(),\n290\t                source: source.to_string(),\n291\t            }\n292\t        }\n293\t\n294\t        fn stored_path(&self) -> String {\n295\t            format!(\"{}/{}\", self.workspace, self.repo_relative_path)\n296\t        }\n297\t    }\n298\t\n299\t    pub(crate) fn content_hash(source: &str) -> String {\n300\t        let mut hash = 0xcbf29ce484222325u64;\n301\t        for byte in source.as_bytes() {\n302\t            hash ^= *byte as u64;\n303\t            hash = hash.wrapping_mul(0x100000001b3);\n304\t        }\n305\t        format!(\"{hash:016x}\")\n306\t    }\n307\t\n308\t    pub(crate) fn expect_unique_symbol(outcome: ResolveOutcome<SymbolId>) -> SymbolId {\n309\t        match outcome {\n310\t            ResolveOutcome::Unique(symbol_id) => symbol_id,\n311\t            other => panic!(\"expected unique symbol, got {other:?}\"),\n312\t        }\n313\t    }\n314\t\n315\t    pub(crate) fn expect_ambiguous_symbol(outcome: ResolveOutcome<SymbolId>) -> AmbiguityReport<SymbolId> {\n316\t        match outcome {\n317\t            ResolveOutcome::Ambiguous(report) => report,\n318\t            other => panic!(\"expected ambiguous symbol, got {other:?}\"),\n319\t        }\n320\t    }\n321\t\n322\t    pub(crate) fn expect_unique_section(outcome: ResolveOutcome<SectionId>) -> SectionId {\n323\t        match outcome {\n324\t            ResolveOutcome::Unique(section_id) => section_id,\n325\t            other => panic!(\"expected unique section, got {other:?}\"),\n326\t        }\n327\t    }\n328\t\n329\t    fn add_symbols(graph: &mut CodeGraph, parsed_file: &ParsedFile) {\n330\t        for symbol in &parsed_file.symbols {\n331\t            graph.add_node(\n332\t                symbol.id.clone(),\n333\t                symbol.kind,\n334\t                symbol.name.clone(),\n335\t                symbol.signature.clone(),\n336\t                symbol.body.clone(),\n337\t                symbol.file.clone(),\n338\t                symbol.line,\n339\t                symbol.end_line,\n340\t                symbol.is_exported,\n341\t                symbol.language,\n342\t            );\n343\t        }\n344\t    }\n345\t\n346\t    fn doc_id(workspace: &str, path: &str, source: &str) -> DocId {\n347\t        DocId {\n348\t            workspace_id: workspace.to_string(),\n349\t            repo_relative_path: path.to_string(),\n350\t            content_hash: content_hash(source),\n351\t        }\n352\t    }\n353\t\n354\t    fn file_index_entry(stored_path: &str, source: &str) -> FileIndexEntry {\n355\t        FileIndexEntry {\n356\t            file: stored_path.to_string(),\n357\t            content_hash: content_hash(source),\n358\t            mtime_ns: 0,\n359\t            size_bytes: source.len() as i64,\n360\t            parser_version: FILE_INDEX_PARSER_VERSION,\n361\t            schema_version: FILE_INDEX_SCHEMA_VERSION,\n362\t            last_indexed_at: 0,\n363\t        }\n364\t    }\n365\t\n366\t}\n367\t"}]},"parent_tool_use_id":null,"session_id":"beca6473-0a8b-4b3f-8c29-18a74c665d8f","uuid":"827e175f-038e-410a-8d18-244c7883d42d","timestamp":"2026-05-17T04:19:26.235Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/identity/resolver_tests.rs","content":"//! Phase 1 identity-resolution correctness tests for\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 1: Unified Identity Model`.\n//!\n//! This matrix covers the spec-mandated rename, move, duplicate-name, and\n//! branch-change behaviors, plus the compatibility paths that keep legacy\n//! references working while Phase 1 introduces stable identities.\n\nuse super::{EventId, FileId, Identity, ResolveOutcome};\n\nconst MAIN_WORKSPACE: &str = \"main\";\nconst FEATURE_WORKSPACE: &str = \"feature\";\n\n#[test]\nfn test_resolve_path_unique_returns_fileid() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/lib.rs\", \"pub fn login_user() {}\\n\")\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), \"src/lib.rs\")\n        .expect(\"path should resolve\");\n\n    assert_eq!(resolved.workspace_id, MAIN_WORKSPACE);\n    assert_eq!(resolved.repo_relative_path, \"src/lib.rs\");\n}\n\n#[test]\nfn test_resolve_path_after_file_rename_returns_new_id() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/renamed.rs\", \"pub fn login_user() {}\\n\")\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), \"src/renamed.rs\")\n        .expect(\"renamed path should resolve\");\n\n    assert_eq!(resolved.repo_relative_path, \"src/renamed.rs\");\n}\n\n#[test]\nfn test_resolve_path_after_file_rename_legacy_name_returns_via_compat_shim() {\n    let source = \"pub fn login_user() {}\\n\";\n    let old_identity = Identity::File(FileId {\n        workspace_id: MAIN_WORKSPACE.to_string(),\n        repo_relative_path: \"src/original.rs\".to_string(),\n        content_hash: helpers::content_hash(source),\n    })\n    .to_string();\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/renamed.rs\", source)\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_path(&fixture.workspace(MAIN_WORKSPACE), &old_identity)\n        .expect(\"legacy file identity should remap to current path\");\n\n    assert_eq!(resolved.repo_relative_path, \"src/renamed.rs\");\n    assert_eq!(resolved.content_hash, helpers::content_hash(source));\n}\n\n#[test]\nfn test_resolve_symbol_unique_returns_symbolid() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(\n            MAIN_WORKSPACE,\n            \"src/auth.rs\",\n            \"pub fn login_user() {}\\npub fn logout_user() {}\\n\",\n        )\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_symbol(&fixture.workspace(MAIN_WORKSPACE), \"login_user\");\n\n    let symbol_id = helpers::expect_unique_symbol(resolved);\n    assert_eq!(symbol_id.file.repo_relative_path, \"src/auth.rs\");\n    assert_eq!(symbol_id.qualified_name, \"login_user\");\n}\n\n#[test]\nfn test_resolve_symbol_duplicate_name_returns_ambiguous_with_disambiguation_hint() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n        .rust(MAIN_WORKSPACE, \"src/admin.rs\", \"pub fn shared() {}\\n\")\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_symbol(&fixture.workspace(MAIN_WORKSPACE), \"shared\");\n\n    let report = helpers::expect_ambiguous_symbol(resolved);\n    assert_eq!(report.candidates.len(), 2);\n    assert!(report.disambiguation_hint.contains(\"file path\"));\n}\n\n#[test]\nfn test_resolve_section_after_heading_rename_returns_new_id() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .markdown(\n            MAIN_WORKSPACE,\n            \"docs/guide.md\",\n            \"# Overview\\n\\n## Current Heading\\nBody\\n\",\n        )\n        .build();\n    let doc = fixture.doc_id(MAIN_WORKSPACE, \"docs/guide.md\");\n\n    let resolved = fixture\n        .resolver\n        .resolve_section(&fixture.workspace(MAIN_WORKSPACE), &doc, \"Current Heading\");\n\n    let section_id = helpers::expect_unique_section(resolved);\n    assert_eq!(section_id.doc.repo_relative_path, \"docs/guide.md\");\n    assert_eq!(section_id.heading_path, vec![\"Current Heading\".to_string()]);\n}\n\n#[test]\nfn test_resolve_section_after_section_move_returns_new_id() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .markdown(\n            MAIN_WORKSPACE,\n            \"docs/runbook.md\",\n            \"# Runbook\\n\\n## Intro\\nText\\n\\n## Deploy\\nMove target\\n\",\n        )\n        .build();\n    let doc = fixture.doc_id(MAIN_WORKSPACE, \"docs/runbook.md\");\n\n    let resolved = fixture\n        .resolver\n        .resolve_section(&fixture.workspace(MAIN_WORKSPACE), &doc, \"Deploy\");\n\n    let section_id = helpers::expect_unique_section(resolved);\n    assert_eq!(section_id.doc.repo_relative_path, \"docs/runbook.md\");\n    assert!(section_id.byte_offset > 20);\n}\n\n#[test]\nfn test_resolve_symbol_on_different_branch_returns_branch_scoped_id() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n        .rust(FEATURE_WORKSPACE, \"src/auth.rs\", \"pub fn shared() {}\\n\")\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_symbol(&fixture.workspace(FEATURE_WORKSPACE), \"shared\");\n\n    let symbol_id = helpers::expect_unique_symbol(resolved);\n    assert_eq!(symbol_id.file.workspace_id, FEATURE_WORKSPACE);\n    assert_eq!(symbol_id.file.repo_relative_path, \"src/auth.rs\");\n}\n\n#[test]\nfn test_resolve_event_ref_round_trips_through_encoding() {\n    let event_id = EventId {\n        workspace_id: MAIN_WORKSPACE.to_string(),\n        ulid: \"01J0000000000000000000000A\".to_string(),\n    };\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .event(event_id.clone())\n        .build();\n\n    let resolved = fixture\n        .resolver\n        .resolve_event_ref(&fixture.workspace(MAIN_WORKSPACE), &Identity::Event(event_id).to_string())\n        .expect(\"event identity should resolve\");\n\n    assert_eq!(resolved.workspace_id, MAIN_WORKSPACE);\n    assert_eq!(resolved.ulid, \"01J0000000000000000000000A\");\n}\n\n#[test]\nfn test_resolve_legacy_symbol_name_routes_via_default_workspace() {\n    let fixture = helpers::FixtureBuilder::new(MAIN_WORKSPACE)\n        .rust(MAIN_WORKSPACE, \"src/legacy.rs\", \"pub fn only_main() {}\\n\")\n        .rust(FEATURE_WORKSPACE, \"src/feature.rs\", \"pub fn feature_only() {}\\n\")\n        .build();\n\n    let resolved = fixture.resolver.resolve_legacy_symbol_name(\"only_main\");\n\n    let symbol_id = helpers::expect_unique_symbol(resolved);\n    assert_eq!(symbol_id.file.workspace_id, MAIN_WORKSPACE);\n    assert_eq!(symbol_id.file.repo_relative_path, \"src/legacy.rs\");\n}\n\npub(crate) mod helpers {\n    use std::collections::HashMap;\n\n    use crate::graph::CodeGraph;\n    use crate::identity::{AmbiguityReport, DocId, EventId, IdentityResolver, SectionId, SymbolId};\n    use crate::parser::parse_file;\n    use crate::storage::graph_store::{FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION};\n    use crate::symbols::ParsedFile;\n\n    use super::ResolveOutcome;\n\n    pub(crate) struct ResolverFixture {\n        pub(crate) resolver: IdentityResolver<'static>,\n        docs: HashMap<(String, String), DocId>,\n    }\n\n    impl ResolverFixture {\n        pub(crate) fn workspace(&self, workspace: &str) -> String {\n            workspace.to_string()\n        }\n\n        pub(crate) fn doc_id(&self, workspace: &str, path: &str) -> DocId {\n            self.docs\n                .get(&(workspace.to_string(), path.to_string()))\n                .cloned()\n                .expect(\"document fixture should exist\")\n        }\n    }\n\n    pub(crate) struct FixtureBuilder {\n        default_workspace: String,\n        files: Vec<FixtureFile>,\n        events: Vec<EventId>,\n    }\n\n    struct FixtureFile {\n        workspace: String,\n        repo_relative_path: String,\n        source: String,\n    }\n\n    impl FixtureBuilder {\n        pub(crate) fn new(default_workspace: &str) -> Self {\n            Self {\n                default_workspace: default_workspace.to_string(),\n                files: Vec::new(),\n                events: Vec::new(),\n            }\n        }\n\n        pub(crate) fn rust(mut self, workspace: &str, path: &str, source: &str) -> Self {\n            self.files.push(FixtureFile::new(workspace, path, source));\n            self\n        }\n\n        pub(crate) fn markdown(mut self, workspace: &str, path: &str, source: &str) -> Self {\n            self.files.push(FixtureFile::new(workspace, path, source));\n            self\n        }\n\n        pub(crate) fn event(mut self, event_id: EventId) -> Self {\n            self.events.push(event_id);\n            self\n        }\n\n        pub(crate) fn build(self) -> ResolverFixture {\n            let mut graph = CodeGraph::new();\n            let mut file_index = HashMap::new();\n            let mut parsed_files = HashMap::new();\n            let mut docs = HashMap::new();\n\n            for file in self.files {\n                let stored_path = file.stored_path();\n                let parsed_file = parse_file(&stored_path, &file.source).expect(\"fixture should parse\");\n                add_symbols(&mut graph, &parsed_file);\n                if file.repo_relative_path.ends_with(\".md\") {\n                    docs.insert(\n                        (file.workspace.clone(), file.repo_relative_path.clone()),\n                        doc_id(&file.workspace, &file.repo_relative_path, &file.source),\n                    );\n                }\n                parsed_files.insert(stored_path.clone(), parsed_file);\n                file_index.insert(stored_path.clone(), file_index_entry(&stored_path, &file.source));\n            }\n\n            let resolver = IdentityResolver::new(\n                Box::leak(Box::new(graph)),\n                Box::leak(Box::new(file_index)),\n                Box::leak(Box::new(parsed_files)),\n                self.default_workspace,\n                self.events,\n            );\n            ResolverFixture { resolver, docs }\n        }\n    }\n\n    impl FixtureFile {\n        fn new(workspace: &str, path: &str, source: &str) -> Self {\n            Self {\n                workspace: workspace.to_string(),\n                repo_relative_path: path.to_string(),\n                source: source.to_string(),\n            }\n        }\n\n        fn stored_path(&self) -> String {\n            format!(\"{}/{}\", self.workspace, self.repo_relative_path)\n        }\n    }\n\n    pub(crate) fn content_hash(source: &str) -> String {\n        let mut hash = 0xcbf29ce484222325u64;\n        for byte in source.as_bytes() {\n            hash ^= *byte as u64;\n            hash = hash.wrapping_mul(0x100000001b3);\n        }\n        format!(\"{hash:016x}\")\n    }\n\n    pub(crate) fn expect_unique_symbol(outcome: ResolveOutcome<SymbolId>) -> SymbolId {\n        match outcome {\n            ResolveOutcome::Unique(symbol_id) => symbol_id,\n            other => panic!(\"expected unique symbol, got {other:?}\"),\n        }\n    }\n\n    pub(crate) fn expect_ambiguous_symbol(outcome: ResolveOutcome<SymbolId>) -> AmbiguityReport<SymbolId> {\n        match outcome {\n            ResolveOutcome::Ambiguous(report) => report,\n            other => panic!(\"expected ambiguous symbol, got {other:?}\"),\n        }\n    }\n\n    pub(crate) fn expect_unique_section(outcome: ResolveOutcome<SectionId>) -> SectionId {\n        match outcome {\n            ResolveOutcome::Unique(section_id) => section_id,\n            other => panic!(\"expected unique section, got {other:?}\"),\n        }\n    }\n\n    fn add_symbols(graph: &mut CodeGraph, parsed_file: &ParsedFile) {\n        for symbol in &parsed_file.symbols {\n            graph.add_node(\n                symbol.id.clone(),\n                symbol.kind,\n                symbol.name.clone(),\n                symbol.signature.clone(),\n                symbol.body.clone(),\n                symbol.file.clone(),\n                symbol.line,\n                symbol.end_line,\n                symbol.is_exported,\n                symbol.language,\n            );\n        }\n    }\n\n    fn doc_id(workspace: &str, path: &str, source: &str) -> DocId {\n        DocId {\n            workspace_id: workspace.to_string(),\n            repo_relative_path: path.to_string(),\n            content_hash: content_hash(source),\n        }\n    }\n\n    fn file_index_entry(stored_path: &str, source: &str) -> FileIndexEntry {\n        FileIndexEntry {\n            file: stored_path.to_string(),\n            content_hash: content_hash(source),\n            mtime_ns: 0,\n            size_bytes: source.len() as i64,\n            parser_version: FILE_INDEX_PARSER_VERSION,\n            schema_version: FILE_INDEX_SCHEMA_VERSION,\n            last_indexed_at: 0,\n        }\n    }\n\n}\n","numLines":367,"startLine":1,"totalLines":367}}}
