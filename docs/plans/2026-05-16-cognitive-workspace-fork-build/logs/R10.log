sert_eq!(value[\"pivots\"][0][\"symbol\"].as_str(), Some(\"loginUser\"));\n310\t        assert_eq!(value[\"pivots\"][0][\"file\"].as_str(), Some(\"src/auth.ts\"));\n311\t        assert_eq!(\n312\t            value[\"pivots\"][0][\"symbol_identity\"][\"status\"].as_str(),\n313\t            Some(\"resolved\")\n314\t        );\n315\t        assert_eq!(\n316\t            value[\"pivots\"][0][\"symbol_identity\"][\"payload\"][\"legacy_name\"].as_str(),\n317\t            Some(\"loginUser\")\n318\t        );\n319\t        assert_eq!(\n320\t            value[\"pivots\"][0][\"file_identity\"][\"legacy_name\"].as_str(),\n321\t            Some(\"src/auth.ts\")\n322\t        );\n323\t        assert_eq!(\n324\t            value[\"context_handle_identity\"][\"fields\"][\"session_id\"].as_str(),\n325\t            Some(\"session-main\")\n326\t        );\n327\t        assert_eq!(\n328\t            value[\"stats\"][\"seed_symbol_identities\"][0][\"status\"].as_str(),\n329\t            Some(\"resolved\")\n330\t        );\n331\t    }\n332\t\n333\t    #[test]\n334\t    fn ambiguous_resolver_outcome_surfaces_diagnostic() {\n335\t        let (graph, parsed_files) = fixture(true);\n336\t        let mut value = json!({\n337\t            \"query\": \"login auth\",\n338\t            \"intent\": \"Explore\",\n339\t            \"pivots\": [],\n340\t            \"context\": [],\n341\t            \"memories\": [],\n342\t            \"stats\": {\n343\t                \"tokens_used\": 10,\n344\t                \"tokens_saved\": 5,\n345\t                \"nodes_evaluated\": 2,\n346\t                \"nodes_included\": 0,\n347\t                \"engine_version\": \"test\",\n348\t                \"seed_count\": 1,\n349\t                \"seed_symbols\": [\"loginUser\"]\n350\t            },\n351\t            \"context_handle\": \"ctx-123\"\n352\t        });\n353\t\n354\t        decorate_get_context_capsule_payload(\n355\t            &mut value,\n356\t            &graph,\n357\t            &parsed_files,