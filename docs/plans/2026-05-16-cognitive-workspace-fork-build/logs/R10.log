{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J8HRNgreDCWnhdekEmd8TL","type":"tool_result","content":"1\tuse std::collections::HashMap;\n2\t\n3\tuse lattice_core::graph::model::{CodeGraph, GraphNode};\n4\tuse lattice_core::identity::{\n5\t    serialize_outcome, AmbiguityReport, ContextHandleId, FileId, Identity, IdentityPayload,\n6\t    IdentityPayloadOrAmbiguity, ResolveError, ResolveOutcome, SymbolId,\n7\t};\n8\tuse lattice_core::storage::FileIndexEntry;\n9\tuse lattice_core::symbols::ParsedFile;\n10\tuse serde_json::{json, Value};\n11\t\n12\tconst DEFAULT_PARSER_VERSION: i64 = 1;\n13\tconst DEFAULT_SCHEMA_VERSION: i64 = 1;\n14\t\n15\tpub fn decorate_get_context_capsule_payload(\n16\t    value: &mut Value,\n17\t    graph: &CodeGraph,\n18\t    parsed_files: &HashMap<String, ParsedFile>,\n19\t    workspace_id: &str,\n20\t    context_handle_id: &ContextHandleId,\n21\t) {\n22\t    let file_index = synthetic_file_index(parsed_files, graph);\n23\t    let nodes = graph.all_nodes();\n24\t\n25\t    if let Some(object) = value.as_object_mut() {\n26\t        object.insert(\n27\t            \"context_handle_identity\".to_string(),\n28\t            json!(IdentityPayload::new(\n29\t                Identity::ContextHandle(context_handle_id.clone()),\n30\t                object\n31\t                    .get(\"context_handle\")\n32\t                    .and_then(Value::as_str)\n33\t                    .map(str::to_string),\n34\t            )),\n35\t        );\n36\t        decorate_capsule_entries(\n37\t            object.get_mut(\"pivots\"),\n38\t            &nodes,\n39\t            &file_index,\n40\t            workspace_id,\n41\t        );\n42\t        decorate_capsule_entries(\n43\t            object.get_mut(\"context\"),\n44\t            &nodes,\n45\t            &file_index,\n46\t            workspace_id,\n47\t        );\n48\t        decorate_seed_symbol_identities(object.get_mut(\"stats\"), &nodes, &file_index, workspace_id);\n49\t    }\n50\t}\n51\t\n52\tfn decorate_capsule_entries(\n53\t    entries: Option<&mut Value>,\n54\t    nodes: &[&GraphNode],\n55\t    file_index: &HashMap<String, FileIndexEntry>,\n56\t    workspace_id: &str,\n57\t) {\n58\t    let Some(entries) = entries.and_then(Value::as_array_mut) else {\n59\t        return;\n60\t    };\n61\t\n62\t    for entry in entries {\n63\t        let Some(object) = entry.as_object_mut() else {\n64\t            continue;\n65\t        };\n66\t        let file = object\n67\t            .get(\"file\")\n68\t            .and_then(Value::as_str)\n69\t            .map(str::to_string);\n70\t        let symbol = object\n71\t            .get(\"symbol\")\n72\t            .and_then(Value::as_str)\n73\t            .map(str::to_string);\n74\t        let line = object\n75\t            .get(\"line\")\n76\t            .and_then(Value::as_u64)\n77\t            .map(|value| value as usize)\n78\t            .unwrap_or_default();\n79\t\n80\t        if let Some(file) = file.as_deref() {\n81\t            object.insert(\n82\t                \"file_identity\".to_string(),\n83\t                json!(IdentityPayload::new(\n84\t                    Identity::File(file_identity(workspace_id, file, file_index)),\n85\t                    Some(file.to_string()),\n86\t                )),\n87\t            );\n88\t        }\n89\t        if let Some(symbol) = symbol.as_deref() {\n90\t            let payload = exact_symbol_payload(\n91\t                nodes,\n92\t                file_index,\n93\t                workspace_id,\n94\t                file.as_deref(),\n95\t                symbol,\n96\t                line,\n97\t            )\n98\t            .map(|payload| IdentityPayloadOrAmbiguity::Resolved { payload })\n99\t            .unwrap_or_else(|| {\n100\t                serialize_outcome(\n101\t                    resolve_symbol_outcome(nodes, file_index, workspace_id, symbol),\n102\t                    Some(symbol),\n103\t                )\n104\t            });\n105\t            object.insert(\"symbol_identity\".to_string(), json!(payload));\n106\t        }\n107\t    }\n108\t}\n109\t\n110\tfn decorate_seed_symbol_identities(\n111\t    stats: Option<&mut Value>,\n112\t    nodes: &[&GraphNode],\n113\t    file_index: &HashMap<String, FileIndexEntry>,\n114\t    workspace_id: &str,\n115\t) {\n116\t    let Some(stats) = stats.and_then(Value::as_object_mut) else {\n117\t        return;\n118\t    };\n119\t    let Some(seed_symbols) = stats.get(\"seed_symbols\").and_then(Value::as_array) else {\n120\t        return;\n121\t    };\n122\t\n123\t    let payloads = seed_symbols\n124\t        .iter()\n125\t        .filter_map(Value::as_str)\n126\t        .map(|symbol| {\n127\t            serialize_outcome(\n128\t                resolve_symbol_outcome(nodes, file_index, workspace_id, symbol),\n129\t                Some(symbol),\n130\t            )\n131\t        })\n132\t        .collect::<Vec<_>>();\n133\t    stats.insert(\"seed_symbol_identities\".to_string(), json!(payloads));\n134\t}\n135\t\n136\tfn exact_symbol_payload(\n137\t    nodes: &[&GraphNode],\n138\t    file_index: &HashMap<String, FileIndexEntry>,\n139\t    workspace_id: &str,\n140\t    file: Option<&str>,\n141\t    symbol: &str,\n142\t    line: usize,\n143\t) -> Option<IdentityPayload> {\n144\t    let node = nodes.iter().copied().find(|node| {\n145\t        file.is_some_and(|candidate| candidate == node.file)\n146\t            && node.name == symbol\n147\t            && node.line == line\n148\t    })?;\n149\t    let identity = Identity::Symbol(SymbolId {\n150\t        file: file_identity(workspace_id, &node.file, file_index),\n151\t        qualified_name: node.name.clone(),\n152\t        byte_offset: node.id.byte_offset,\n153\t        kind: format!(\"{:?}\", node.kind).to_lowercase(),\n154\t    });\n155\t    Some(IdentityPayload::new(identity, Some(symbol.to_string())))\n156\t}\n157\t\n158\tfn file_identity(\n159\t    workspace_id: &str,\n160\t    file: &str,\n161\t    file_index: &HashMap<String, FileIndexEntry>,\n162\t) -> FileId {\n163\t    FileId {\n164\t        workspace_id: workspace_id.to_string(),\n165\t        repo_relative_path: file.to_string(),\n166\t        content_hash: file_index\n167\t            .get(file)\n168\t            .map(|entry| entry.content_hash.clone())\n169\t            .unwrap_or_else(|| stable_content_hash(file.as_bytes())),\n170\t    }\n171\t}\n172\t\n173\tfn resolve_symbol_outcome(\n174\t    nodes: &[&GraphNode],\n175\t    file_index: &HashMap<String, FileIndexEntry>,\n176\t    workspace_id: &str,\n177\t    symbol: &str,\n178\t) -> ResolveOutcome<SymbolId> {\n179\t    let candidates = nodes\n180\t        .iter()\n181\t        .copied()\n182\t        .filter(|node| node.name == symbol)\n183\t        .map(|node| SymbolId {\n184\t            file: file_identity(workspace_id, &node.file, file_index),\n185\t            qualified_name: node.name.clone(),\n186\t            byte_offset: node.id.byte_offset,\n187\t            kind: format!(\"{:?}\", node.kind).to_lowercase(),\n188\t        })\n189\t        .collect::<Vec<_>>();\n190\t    match candidates.len() {\n191\t        0 => ResolveOutcome::NotFound(ResolveError::NotFound {\n192\t            kind: \"symbol\",\n193\t            query: symbol.to_string(),\n194\t        }),\n195\t        1 => ResolveOutcome::Unique(candidates[0].clone()),\n196\t        _ => ResolveOutcome::Ambiguous(AmbiguityReport::new(\n197\t            symbol,\n198\t            candidates,\n199\t            \"Add the parent module or file path, or use the stable symbol identity.\",\n200\t        )),\n201\t    }\n202\t}\n203\t\n204\tfn synthetic_file_index(\n205\t    parsed_files: &HashMap<String, ParsedFile>,\n206\t    graph: &CodeGraph,\n207\t) -> HashMap<String, FileIndexEntry> {\n208\t    let mut entries = HashMap::new();\n209\t    for (file, parsed_file) in parsed_files {\n210\t        entries.insert(file.clone(), synthetic_file_index_entry(file, Some(parsed_file)));\n211\t    }\n212\t    for node in graph.all_nodes() {\n213\t        entries\n214\t            .entry(node.file.clone())\n215\t            .or_insert_with(|| synthetic_file_index_entry(&node.file, None));\n216\t    }\n217\t    entries\n218\t}\n219\t\n220\tfn synthetic_file_index_entry(file: &str, parsed_file: Option<&ParsedFile>) -> FileIndexEntry {\n221\t    let content_hash = parsed_file\n222\t        .and_then(|parsed| serde_json::to_vec(parsed).ok())\n223\t        .map(|bytes| stable_content_hash(&bytes))\n224\t        .unwrap_or_else(|| stable_content_hash(file.as_bytes()));\n225\t    FileIndexEntry {\n226\t        file: file.to_string(),\n227\t        content_hash,\n228\t        mtime_ns: 0,\n229\t        size_bytes: 0,\n230\t        parser_version: DEFAULT_PARSER_VERSION,\n231\t        schema_version: DEFAULT_SCHEMA_VERSION,\n232\t        last_indexed_at: 0,\n233\t    }\n234\t}\n235\t\n236\tfn stable_content_hash(bytes: &[u8]) -> String {\n237\t    let mut hash = 0xcbf29ce484222325u64;\n238\t    for byte in bytes {\n239\t        hash ^= *byte as u64;\n240\t        hash = hash.wrapping_mul(0x100000001b3);\n241\t    }\n242\t    format!(\"{hash:016x}\")\n243\t}\n244\t\n245\t#[cfg(test)]\n246\tmod tests {\n247\t    use std::collections::HashMap;\n248\t\n249\t    use lattice_core::graph::model::CodeGraph;\n250\t    use lattice_core::query::{CapsuleStats, ContextCapsule, ContextNode, PivotNode, QueryIntent};\n251\t    use lattice_core::symbols::{Language, ParsedFile, Symbol, SymbolId as LegacySymbolId, SymbolKind};\n252\t    use serde_json::json;\n253\t\n254\t    use super::decorate_get_context_capsule_payload;\n255\t    use lattice_core::identity::ContextHandleId;\n256\t\n257\t    #[test]\n258\t    fn full_tool_response_includes_identity_payloads_and_legacy_fields() {\n259\t        let (graph, parsed_files) = fixture(false);\n260\t        let mut value = serde_json::to_value(ContextCapsule {\n261\t            query: \"login auth\".to_string(),\n262\t            intent: QueryIntent::Explore,\n263\t            p