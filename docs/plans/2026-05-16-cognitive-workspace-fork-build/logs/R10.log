{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U6aUQ2825mSwrQTBZMkJdw","type":"tool_result","content":"1\t//! Ambiguity reporting for Phase 1 identity resolution.\n2\t//!\n3\t//! This module implements the ambiguity contract required by\n4\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## Phase 1: Unified Identity Model`: ambiguous references must return\n6\t//! diagnostics instead of an arbitrary match.\n7\t\n8\tuse std::fmt;\n9\t\n10\t/// Identity resolution result that preserves ambiguity and not-found states.\n11\t#[derive(Clone, Debug, PartialEq, Eq)]\n12\tpub enum ResolveOutcome<T> {\n13\t    Unique(T),\n14\t    Ambiguous(AmbiguityReport<T>),\n15\t    NotFound(super::resolver::ResolveError),\n16\t}\n17\t\n18\t/// A structured ambiguity response for callers that need to disambiguate.\n19\t#[derive(Clone, Debug, PartialEq, Eq)]\n20\tpub struct AmbiguityReport<T> {\n21\t    pub query: String,\n22\t    pub candidates: Vec<T>,\n23\t    pub disambiguation_hint: String,\n24\t}\n25\t\n26\timpl<T> AmbiguityReport<T> {\n27\t    pub fn new(\n28\t        query: impl Into<String>,\n29\t        candidates: Vec<T>,\n30\t        disambiguation_hint: impl Into<String>,\n31\t    ) -> Self {\n32\t        Self {\n33\t            query: query.into(),\n34\t            candidates,\n35\t            disambiguation_hint: disambiguation_hint.into(),\n36\t        }\n37\t    }\n38\t}\n39\t\n40\timpl<T> fmt::Display for AmbiguityReport<T> {\n41\t    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n42\t        write!(\n43\t            formatter,\n44\t            \"{} matches found for `{}`; {}\",\n45\t            self.candidates.len(),\n46\t            self.query,\n47\t            self.disambiguation_hint\n48\t        )\n49\t    }\n50\t}\n51\t\n52\tpub fn symbol_disambiguation_hint(has_multiple_files: bool) -> String {\n53\t    if has_multiple_files {\n54\t        \"Add the parent module or file path, or use the stable symbol identity.\".to_string()\n55\t    } else {\n56\t        \"Add the byte offset or use the stable symbol identity.\".to_string()\n57\t    }\n58\t}\n59\t\n60\tpub fn section_disambiguation_hint() -> String {\n61\t    \"Add the full heading path, byte offset, or stable section identity.\".to_string()\n62\t}\n63\t\n64\tpub fn test_disambiguation_hint() -> String {\n65\t    \"Add the test file path or use the stable symbol identity.\".to_string()\n66\t}\n67\t\n68\t#[cfg(test)]\n69\tmod tests {\n70\t    use super::{\n71\t        section_disambiguation_hint, symbol_disambiguation_hint, test_disambiguation_hint,\n72\t        AmbiguityReport,\n73\t    };\n74\t\n75\t    #[test]\n76\t    fn display_reports_candidate_count_and_hint() {\n77\t        let report = AmbiguityReport::new(\n78\t            \"render\",\n79\t            vec![\"src/a.rs::render\", \"src/b.rs::render\"],\n80\t            symbol_disambiguation_hint(true),\n81\t        );\n82\t\n83\t        let rendered = report.to_string();\n84\t\n85\t        assert!(rendered.contains(\"2 matches found\"));\n86\t        assert!(rendered.contains(\"render\"));\n87\t        assert!(rendered.contains(\"file path\"));\n88\t    }\n89\t\n90\t    #[test]\n91\t    fn hint_helpers_match_expected_resolution_guidance() {\n92\t        assert!(symbol_disambiguation_hint(true).contains(\"file path\"));\n93\t        assert!(symbol_disambiguation_hint(false).contains(\"byte offset\"));\n94\t        assert!(section_disambiguation_hint().contains(\"heading path\"));\n95\t        assert!(test_disambiguation_hint().contains(\"test file path\"));\n96\t    }\n97\t}\n98\t"}]},"parent_tool_use_id":null,"session_id":"beca6473-0a8b-4b3f-8c29-18a74c665d8f","uuid":"98c28dbc-9cfa-4147-9a78-5710c9268c47","timestamp":"2026-05-17T04:19:12.948Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/identity/ambiguity.rs","content":"//! Ambiguity reporting for Phase 1 identity resolution.\n//!\n//! This module implements the ambiguity contract required by\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 1: Unified Identity Model`: ambiguous references must return\n//! diagnostics instead of an arbitrary match.\n\nuse std::fmt;\n\n/// Identity resolution result that preserves ambiguity and not-found states.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum ResolveOutcome<T> {\n    Unique(T),\n    Ambiguous(AmbiguityReport<T>),\n    NotFound(super::resolver::ResolveError),\n}\n\n/// A structured ambiguity response for callers that need to disambiguate.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct AmbiguityReport<T> {\n    pub query: String,\n    pub candidates: Vec<T>,\n    pub disambiguation_hint: String,\n}\n\nimpl<T> AmbiguityReport<T> {\n    pub fn new(\n        query: impl Into<String>,\n        candidates: Vec<T>,\n        disambiguation_hint: impl Into<String>,\n    ) -> Self {\n        Self {\n            query: query.into(),\n            candidates,\n            disambiguation_hint: disambiguation_hint.into(),\n        }\n    }\n}\n\nimpl<T> fmt::Display for AmbiguityReport<T> {\n    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n        write!(\n            formatter,\n            \"{} matches found for `{}`; {}\",\n            self.candidates.len(),\n            self.query,\n            self.disambiguation_hint\n        )\n    }\n}\n\npub fn symbol_disambiguation_hint(has_multiple_files: bool) -> String {\n    if has_multiple_files {\n        \"Add the parent module or file path, or use the stable symbol identity.\".to_string()\n    } else {\n        \"Add the byte offset or use the stable symbol identity.\".to_string()\n    }\n}\n\npub fn section_disambiguation_hint() -> String {\n    \"Add the full heading path, byte offset, or stable section identity.\".to_string()\n}\n\npub fn test_disambiguation_hint() -> String {\n    \"Add the test file path or use the stable symbol identity.\".to_string()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{\n        section_disambiguation_hint, symbol_disambiguation_hint, test_disambiguation_hint,\n        AmbiguityReport,\n    };\n\n    #[test]\n    fn display_reports_candidate_count_and_hint() {\n        let report = AmbiguityReport::new(\n            \"render\",\n            vec![\"src/a.rs::render\", \"src/b.rs::render\"],\n            symbol_disambiguation_hint(true),\n        );\n\n        let rendered = report.to_string();\n\n        assert!(rendered.contains(\"2 matches found\"));\n        assert!(rendered.contains(\"render\"));\n        assert!(rendered.contains(\"file path\"));\n    }\n\n    #[test]\n    fn hint_helpers_match_expected_resolution_guidance() {\n        assert!(symbol_disambiguation_hint(true).contains(\"file path\"));\n        assert!(symbol_disambiguation_hint(false).contains(\"byte offset\"));\n        assert!(section_disambiguation_hint().contains(\"heading path\"));\n        assert!(test_disambiguation_hint().contains(\"test file path\"));\n    }\n}\n","numLines":98,"startLine":1,"totalLines":98}}}
