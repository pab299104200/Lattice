{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JqosLAqVrBeYmgYDcwug5x","type":"tool_result","content":"1\t//! Phase 11 hardening tests for corrupted event handling.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## Storage Design`: derived state can be rebuilt from source files and events.\n5\t//!\n6\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n7\t//! `### 3. Event Log`: event payloads carry stable references and payload hashes.\n8\t//!\n9\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n10\t//! `## Phase 2: Event Log Substrate`: corruption handling is observable.\n11\t//!\n12\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n13\t//! `## Phase 11: Hardening`: corrupted-event handling is regression-tested.\n14\t\n15\tuse std::fs;\n16\t\n17\tuse crate::events::{Bootstrap, BootstrapError, EventPayload, EventQueryError, Snapshot};\n18\t\n19\tuse super::support::{\n20\t    capture_logs, event_envelope, event_envelope_with_refs, missing_memory_ref, missing_symbol_ref,\n21\t    overwrite_snapshot_version, sample_graph, sample_memory_store, HardeningFixture,\n22\t};\n23\t\n24\t#[test]\n25\tfn test_corrupted_payload_quarantines_row_without_panic() {\n26\t    let fixture = HardeningFixture::new();\n27\t    let writer = fixture.writer(1);\n28\t    writer\n29\t        .append(event_envelope(\"task-corrupt-payload\", \"session-a\", \"bad\"))\n30\t        .expect(\"spilled event appends\");\n31\t    writer\n32\t        .append(event_envelope(\"task-corrupt-payload\", \"session-b\", \"good\"))\n33\t        .expect(\"surviving event appends\");\n34\t    let bytes = b\"not-json\";\n35\t    fixture.overwrite_spill_bytes_preserving_hash(\n36\t        fixture.spill_row_id_for(\"task-corrupt-payload\"),\n37\t        bytes,\n38\t    );\n39\t\n40\t    let (streamed, logs) = capture_logs(|| {\n41\t        fixture\n42\t            .reopen_reader()\n43\t            .stream(fixture.query_task(\"task-corrupt-payload\"))\n44\t            .collect::<Vec<_>>()\n45\t    });\n46\t\n47\t    assert!(matches!(\n48\t        streamed.first(),\n49\t        Some(Err(EventQueryError::PayloadCorruption { .. }))\n50\t    ));\n51\t    assert_eq!(surviving_objectives(streamed), vec![\"good\"]);\n52\t    assert!(logs.contains(\"event payload corruption: hash mismatch\"));\n53\t}\n54\t\n55\t#[test]\n56\tfn test_mismatched_payload_hash_logs_corruption_and_continues() {\n57\t    let fixture = HardeningFixture::new();\n58\t    let writer = fixture.writer(1);\n59\t    writer\n60\t        .append(event_envelope(\"task-hash-mismatch\", \"session-a\", \"bad\"))\n61\t        .expect(\"spilled event appends\");\n62\t    writer\n63\t        .append(event_envelope(\"task-hash-mismatch\", \"session-b\", \"good\"))\n64\t        .expect(\"surviving event appends\");\n65\t    let row_id = fixture.spill_row_id_for(\"task-hash-mismatch\");\n66\t    fixture.overwrite_spill_hash(row_id, &[7_u8; 32]);\n67\t\n68\t    let (streamed, logs) = capture_logs(|| {\n69\t        fixture\n70\t            .reopen_reader()\n71\t            .stream(fixture.query_task(\"task-hash-mismatch\"))\n72\t            .collect::<Vec<_>>()\n73\t    });\n74\t\n75\t    assert!(matches!(\n76\t        streamed.first(),\n77\t        Some(Err(EventQueryError::Storage(_)))\n78\t    ));\n79\t    assert_eq!(surviving_objectives(streamed), vec![\"good\"]);\n80\t    assert!(logs.contains(\"spill row hash does not match envelope hash\"));\n81\t}\n82\t\n83\t#[test]\n84\tfn test_invalid_event_kind_returns_clear_error_without_panic() {\n85\t    let fixture = HardeningFixture::new();\n86\t    fixture\n87\t        .writer(4096)\n88\t        .append(event_envelope(\"task-invalid-kind\", \"session-a\", \"bad kind\"))\n89\t        .expect(\"event appends\");\n90\t    fixture.set_event_kind(\"task-invalid-kind\", \"invalid_event_kind\");\n91\t\n92\t    let (error, logs) = capture_logs(|| {\n93\t        fixture\n94\t            .reopen_reader()\n95\t            .execute(fixture.query_task(\"task-invalid-kind\"))\n96\t            .expect_err(\"invalid event kind rejects row\")\n97\t    });\n98\t\n99\t    assert!(error.to_string().contains(\"unknown event kind\"));\n100\t    assert!(logs.contains(\"event payload corruption: invalid event kind\"));\n101\t}\n102\t\n103\t#[test]\n104\tfn test_invalid_stable_reference_emits_dangling_reference_signal() {\n105\t    let fixture = HardeningFixture::new();\n106\t    fixture\n107\t        .writer(4096)\n108\t        .append(event_envelope(\"task-dangling-ref\", \"session-a\", \"seed\"))\n109\t        .expect(\"seed event appends\");\n110\t    let snapshot_path = fixture.snapshot_path(\"snapshot-1-1.bin\");\n111\t    Snapshot::write(&snapshot_path, &sample_graph(), &sample_memory_store(), 1)\n112\t        .expect(\"snapshot writes\");\n113\t    fixture\n114\t        .writer(4096)\n115\t        .append(event_envelope_with_refs(\n116\t            \"task-dangling-ref\",\n117\t            \"session-b\",\n118\t            \"dangling\",\n119\t            vec![\n120\t                missing_memory_ref(\"missing-memory\"),\n121\t                missing_symbol_ref(\"src/missing.rs\", \"missing\"),\n122\t            ],\n123\t        ))\n124\t        .expect(\"dangling ref event appends\");\n125\t\n126\t    let (result, logs) = capture_logs(|| Bootstrap::load(&snapshot_path, &fixture.reopen_store()));\n127\t    let error = result.expect_err(\"dangling reference rejects bootstrap\");\n128\t\n129\t    assert!(matches!(error, BootstrapError::ReferenceUnresolved { .. }));\n130\t    assert!(logs.contains(\"event_type=\\\"dangling-reference\\\"\"));\n131\t}\n132\t\n133\t#[test]\n134\tfn test_truncated_event_log_file_reports_recovery_or_sqlite_error_without_panic() {\n135\t    let fixture = HardeningFixture::new();\n136\t    fixture\n137\t        .writer(4096)\n138\t        .append(event_envelope(\"task-truncated-db\", \"session-a\", \"before\"))\n139\t        .expect(\"event appends\");\n140\t    truncate_database_file(&fixture.db_path);\n141\t\n142\t    let (opened, logs) = capture_logs(|| fixture.reopen_store());\n143\t    let result = opened.query_events_after_row_id(0, 100);\n144\t\n145\t    match result {\n146\t        Ok(rows) => assert!(\n147\t            rows.len() <= 1,\n148\t            \"truncated database recovery must not invent event rows\"\n149\t        ),\n150\t        Err(error) => assert!(\n151\t            error.to_string().contains(\"SQLite\"),\n152\t            \"truncated database should surface SQLite recovery error, got {error}\"\n153\t        ),\n154\t    }\n155\t    assert!(\n156\t        logs.contains(\"configured event store SQLite connection\") || logs.contains(\"recovery\"),\n157\t        \"opening truncated event store should emit a recovery-relevant log, got {logs}\"\n158\t    );\n159\t}\n160\t\n161\t#[test]\n162\tfn test_snapshot_version_mismatch_refuses_bootstrap_with_clear_error() {\n163\t    let fixture = HardeningFixture::new();\n164\t    fixture\n165\t        .writer(4096)\n166\t        .append(event_envelope(\"task-version\", \"session-a\", \"seed\"))\n167\t        .expect(\"event appends\");\n168\t    let snapshot_path = fixture.snapshot_path(\"snapshot-1-1.bin\");\n169\t    Snapshot::write(&snapshot_path, &sample_graph(), &sample_memory_store(), 1)\n170\t        .expect(\"snapshot writes\");\n171\t    overwrite_snapshot_version(&snapshot_path, 2);\n172\t\n173\t    let (result, logs) = capture_logs(|| Bootstrap::load(&snapshot_path, &fixture.reopen_store()));\n174\t    let error = result.expect_err(\"snapshot version mismatch rejects bootstrap\");\n175\t\n176\t    assert!(matches!(\n177\t        error,\n178\t        BootstrapError::FormatVersionUnsupported { found: 2, max: 1 }\n179\t    ));\n180\t    assert!(logs.contains(\"snapshot format too new\"));\n181\t}\n182\t\n183\tfn surviving_objectives(\n184\t    streamed: Vec<Result<crate::events::EventEnvelope, EventQueryError>>,\n185\t) -> Vec<String> {\n186\t    streamed\n187\t        .into_iter()\n188\t        .filter_map(Result::ok)\n189\t        .map(|event| match event.payload {\n190\t            EventPayload::AssistantTaskStarted(payload) => payload.objective,\n191\t            other => panic!(\"expected assistant task payload, got {other:?}\"),\n192\t        })\n193\t        .collect()\n194\t}\n195\t\n196\tfn truncate_database_file(path: &std::path::Path) {\n197\t    let bytes = fs::read(path).expect(\"event database reads\");\n198\t    let truncated_len = bytes.len().saturating_sub(64).max(bytes.len() / 2);\n199\t    fs::write(path, &bytes[..truncated_len]).expect(\"event database truncates\");\n200\t}"}]},"parent_tool_use_id":null,"session_id":"9386ce4e-bd54-46a3-84f6-f4abe7cd962a","uuid":"3a03b8a3-dccc-4091-8549-44621f4e8100","timestamp":"2026-05-17T20:38:47.197Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/hardening/corruption_tests.rs","content":"//! Phase 11 hardening tests for corrupted event handling.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Storage Design`: derived state can be rebuilt from source files and events.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `### 3. Event Log`: event payloads carry stable references and payload hashes.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 2: Event Log Substrate`: corruption handling is observable.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 11: Hardening`: corrupted-event handling is regression-tested.\n\nuse std::fs;\n\nuse crate::events::{Bootstrap, BootstrapError, EventPayload, EventQueryError, Snapshot};\n\nuse super::support::{\n    capture_logs, event_envelope, event_envelope_with_refs, missing_memory_ref, missing_symbol_ref,\n    overwrite_snapshot_version, sample_graph, sample_memory_store, HardeningFixture,\n};\n\n#[test]\nfn test_corrupted_payload_quarantines_row_without_panic() {\n    let fixture = HardeningFixture::new();\n    let writer = fixture.writer(1);\n    writer\n        .append(event_envelope(\"task-corrupt-payload\", \"session-a\", \"bad\"))\n        .expect(\"spilled event appends\");\n    writer\n        .append(event_envelope(\"task-corrupt-payload\", \"session-b\", \"good\"))\n        .expect(\"surviving event appends\");\n    let bytes = b\"not-json\";\n    fixture.overwrite_spill_bytes_preserving_hash(\n        fixture.spill_row_id_for(\"task-corrupt-payload\"),\n        bytes,\n    );\n\n    let (streamed, logs) = capture_logs(|| {\n        fixture\n            .reopen_reader()\n            .stream(fixture.query_task(\"task-corrupt-payload\"))\n            .collect::<Vec<_>>()\n    });\n\n    assert!(matches!(\n        streamed.first(),\n        Some(Err(EventQueryError::PayloadCorruption { .. }))\n    ));\n    assert_eq!(surviving_objectives(streamed), vec![\"good\"]);\n    assert!(logs.contains(\"event payload corruption: hash mismatch\"));\n}\n\n#[test]\nfn test_mismatched_payload_hash_logs_corruption_and_continues() {\n    let fixture = HardeningFixture::new();\n    let writer = fixture.writer(1);\n    writer\n        .append(event_envelope(\"task-hash-mismatch\", \"session-a\", \"bad\"))\n        .expect(\"spilled event appends\");\n    writer\n        .append(event_envelope(\"task-hash-mismatch\", \"session-b\", \"good\"))\n        .expect(\"surviving event appends\");\n    let row_id = fixture.spill_row_id_for(\"task-hash-mismatch\");\n    fixture.overwrite_spill_hash(row_id, &[7_u8; 32]);\n\n    let (streamed, logs) = capture_logs(|| {\n        fixture\n            .reopen_reader()\n            .stream(fixture.query_task(\"task-hash-mismatch\"))\n            .collect::<Vec<_>>()\n    });\n\n    assert!(matches!(\n        streamed.first(),\n        Some(Err(EventQueryError::Storage(_)))\n    ));\n    assert_eq!(surviving_objectives(streamed), vec![\"good\"]);\n    assert!(logs.contains(\"spill row hash does not match envelope hash\"));\n}\n\n#[test]\nfn test_invalid_event_kind_returns_clear_error_without_panic() {\n    let fixture = HardeningFixture::new();\n    fixture\n        .writer(4096)\n        .append(event_envelope(\"task-invalid-kind\", \"session-a\", \"bad kind\"))\n        .expect(\"event appends\");\n    fixture.set_event_kind(\"task-invalid-kind\", \"invalid_event_kind\");\n\n    let (error, logs) = capture_logs(|| {\n        fixture\n            .reopen_reader()\n            .execute(fixture.query_task(\"task-invalid-kind\"))\n            .expect_err(\"invalid event kind rejects row\")\n    });\n\n    assert!(error.to_string().contains(\"unknown event kind\"));\n    assert!(logs.contains(\"event payload corruption: invalid event kind\"));\n}\n\n#[test]\nfn test_invalid_stable_reference_emits_dangling_reference_signal() {\n    let fixture = HardeningFixture::new();\n    fixture\n        .writer(4096)\n        .append(event_envelope(\"task-dangling-ref\", \"session-a\", \"seed\"))\n        .expect(\"seed event appends\");\n    let snapshot_path = fixture.snapshot_path(\"snapshot-1-1.bin\");\n    Snapshot::write(&snapshot_path, &sample_graph(), &sample_memory_store(), 1)\n        .expect(\"snapshot writes\");\n    fixture\n        .writer(4096)\n        .append(event_envelope_with_refs(\n            \"task-dangling-ref\",\n            \"session-b\",\n            \"dangling\",\n            vec![\n                missing_memory_ref(\"missing-memory\"),\n                missing_symbol_ref(\"src/missing.rs\", \"missing\"),\n            ],\n        ))\n        .expect(\"dangling ref event appends\");\n\n    let (result, logs) = capture_logs(|| Bootstrap::load(&snapshot_path, &fixture.reopen_store()));\n    let error = result.expect_err(\"dangling reference rejects bootstrap\");\n\n    assert!(matches!(error, BootstrapError::ReferenceUnresolved { .. }));\n    assert!(logs.contains(\"event_type=\\\"dangling-reference\\\"\"));\n}\n\n#[test]\nfn test_truncated_event_log_file_reports_recovery_or_sqlite_error_without_panic() {\n    let fixture = HardeningFixture::new();\n    fixture\n        .writer(4096)\n        .append(event_envelope(\"task-truncated-db\", \"session-a\", \"before\"))\n        .expect(\"event appends\");\n    truncate_database_file(&fixture.db_path);\n\n    let (opened, logs) = capture_logs(|| fixture.reopen_store());\n    let result = opened.query_events_after_row_id(0, 100);\n\n    match result {\n        Ok(rows) => assert!(\n            rows.len() <= 1,\n            \"truncated database recovery must not invent event rows\"\n        ),\n        Err(error) => assert!(\n            error.to_string().contains(\"SQLite\"),\n            \"truncated database should surface SQLite recovery error, got {error}\"\n        ),\n    }\n    assert!(\n        logs.contains(\"configured event store SQLite connection\") || logs.contains(\"recovery\"),\n        \"opening truncated event store should emit a recovery-relevant log, got {logs}\"\n    );\n}\n\n#[test]\nfn test_snapshot_version_mismatch_refuses_bootstrap_with_clear_error() {\n    let fixture = HardeningFixture::new();\n    fixture\n        .writer(4096)\n        .append(event_envelope(\"task-version\", \"session-a\", \"seed\"))\n        .expect(\"event appends\");\n    let snapshot_path = fixture.snapshot_path(\"snapshot-1-1.bin\");\n    Snapshot::write(&snapshot_path, &sample_graph(), &sample_memory_store(), 1)\n        .expect(\"snapshot writes\");\n    overwrite_snapshot_version(&snapshot_path, 2);\n\n    let (result, logs) = capture_logs(|| Bootstrap::load(&snapshot_path, &fixture.reopen_store()));\n    let error = result.expect_err(\"snapshot version mismatch rejects bootstrap\");\n\n    assert!(matches!(\n        error,\n        BootstrapError::FormatVersionUnsupported { found: 2, max: 1 }\n    ));\n    assert!(logs.contains(\"snapshot format too new\"));\n}\n\nfn surviving_objectives(\n    streamed: Vec<Result<crate::events::EventEnvelope, EventQueryError>>,\n) -> Vec<String> {\n    streamed\n        .into_iter()\n        .filter_map(Result::ok)\n        .map(|event| match event.payload {\n            EventPayload::AssistantTaskStarted(payload) => payload.objective,\n            other => panic!(\"expected assistant task payload, got {other:?}\"),\n        })\n        .collect()\n}\n\nfn truncate_database_file(path: &std::path::Path) {\n    let bytes = fs::read(path).expect(\"event database reads\");\n    let truncated_len = bytes.len().saturating_sub(64).max(bytes.len() / 2);\n    fs::write(path, &bytes[..truncated_len]).expect(\"event database truncates\");\n}","numLines":200,"startLine":1,"totalLines":201}}}
