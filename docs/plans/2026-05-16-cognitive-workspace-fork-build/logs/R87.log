{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SekdzF49FssMRUBbifVK7r","type":"tool_result","content":"1\tuse std::fs;\n2\tuse std::io::{Seek, SeekFrom, Write};\n3\tuse std::path::{Path, PathBuf};\n4\tuse std::sync::{Arc, Mutex};\n5\t\n6\tuse rusqlite::params;\n7\tuse tempfile::TempDir;\n8\tuse tracing_subscriber::fmt::MakeWriter;\n9\t\n10\tuse crate::events::{\n11\t    Actor, AssistantTaskStartedPayload, BranchRef, CompactSummary, EventPayload, EventQuery,\n12\t    EventReader, EventStore, EventWriter, FlushPolicy, PartialEnvelope, QueryOrder, SessionId,\n13\t    StableRef, TaskId,\n14\t};\n15\tuse crate::graph::{CodeGraph, EdgeKind};\n16\tuse crate::identity::{FileId, MemoryId, SymbolId as StableSymbolId};\n17\tuse crate::memory::{Memory, MemoryScope, MemoryStore, MemoryType, MemoryVerificationStatus};\n18\tuse crate::symbols::{Language, SymbolId, SymbolKind};\n19\t\n20\tpub(crate) struct HardeningFixture {\n21\t    pub(crate) tempdir: TempDir,\n22\t    pub(crate) db_path: PathBuf,\n23\t}\n24\t\n25\timpl HardeningFixture {\n26\t    pub(crate) fn new() -> Self {\n27\t        let tempdir = TempDir::new().expect(\"hardening tempdir creates\");\n28\t        let db_path = tempdir.path().join(\"events.db\");\n29\t        Self { tempdir, db_path }\n30\t    }\n31\t\n32\t    pub(crate) fn store(&self) -> Arc<EventStore> {\n33\t        Arc::new(EventStore::open(&self.db_path).expect(\"event store opens\"))\n34\t    }\n35\t\n36\t    pub(crate) fn reopen_store(&self) -> Arc<EventStore> {\n37\t        Arc::new(EventStore::open(&self.db_path).expect(\"event store reopens\"))\n38\t    }\n39\t\n40\t    pub(crate) fn reopen_reader(&self) -> EventReader {\n41\t        EventReader::new(self.reopen_store())\n42\t    }\n43\t\n44\t    pub(crate) fn writer(&self, inline_ceiling: usize) -> EventWriter {\n45\t        EventWriter::new(self.store(), \"workspace-main\".to_string(), inline_ceiling)\n46\t            .with_flush_policy(FlushPolicy::Sync)\n47\t    }\n48\t\n49\t    pub(crate) fn snapshot_path(&self, name: &str) -> PathBuf {\n50\t        self.tempdir.path().join(name)\n51\t    }\n52\t\n53\t    pub(crate) fn query_task(&self, task_id: &str) -> EventQuery {\n54\t        EventQuery::new()\n55\t            .task(task_id)\n56\t            .workspace(\"workspace-main\")\n57\t            .branch(\"main\")\n58\t            .order(QueryOrder::OldestFirst)\n59\t            .limit(100)\n60\t    }\n61\t\n62\t    pub(crate) fn spill_row_id_for(&self, task_id: &str) -> i64 {\n63\t        self.store()\n64\t            .query_events_by_task(task_id, 10)\n65\t            .expect(\"task rows load\")\n66\t            .into_iter()\n67\t            .find_map(|row| row.payload_spill_id)\n68\t            .expect(\"spilled payload exists\")\n69\t    }\n70\t\n71\t    pub(crate) fn delete_spill_row(&self, row_id: i64) {\n72\t        self.store().with_connection(|conn| {\n73\t            conn.pragma_update(None, \"foreign_keys\", \"OFF\")\n74\t                .expect(\"foreign keys can be disabled for crash fixture\");\n75\t            conn.execute(\n76\t                \"DELETE FROM event_payloads WHERE row_id = ?1\",\n77\t                params![row_id],\n78\t            )\n79\t            .expect(\"spill row deletes\");\n80\t            conn.pragma_update(None, \"foreign_keys\", \"ON\")\n81\t                .expect(\"foreign keys re-enabled\");\n82\t        });\n83\t    }\n84\t\n85\t    pub(crate) fn overwrite_spill_bytes_preserving_hash(&self, row_id: i64, bytes: &[u8]) {\n86\t        self.store().with_connection(|conn| {\n87\t            conn.execute(\n88\t                \"UPDATE event_payloads SET bytes = ?1, bytes_len = ?2 WHERE row_id = ?3\",\n89\t                params![bytes, bytes.len() as i64, row_id],\n90\t            )\n91\t            .expect(\"spill bytes mutate\");\n92\t        });\n93\t    }\n94\t\n95\t    pub(crate) fn overwrite_spill_hash(&self, row_id: i64, hash: &[u8]) {\n96\t        self.store().with_connection(|conn| {\n97\t            conn.execute(\n98\t                \"UPDATE event_payloads SET payload_hash = ?1 WHERE row_id = ?2\",\n99\t                params![hash, row_id],\n100\t            )\n101\t            .expect(\"spill hash mutates\");\n102\t        });\n103\t    }\n104\t\n105\t    pub(crate) fn set_event_kind(&self, task_id: &str, kind: &str) {\n106\t        self.store().with_connection(|conn| {\n107\t            conn.execute(\"DROP TRIGGER IF EXISTS events_no_update\", [])\n108\t                .expect(\"append-only update trigger drops for corruption fixture\");\n109\t            conn.execute(\n110\t                \"UPDATE events SET kind = ?1 WHERE task_id = ?2\",\n111\t                params![kind, task_id],\n112\t            )\n113\t            .expect(\"event kind mutates\");\n114\t        });\n115\t    }\n116\t}\n117\t\n118\tpub(crate) fn event_envelope(task_id: &str, session_id: &str, objective: &str) -> PartialEnvelope {\n119\t    event_envelope_with_refs(task_id, session_id, objective, Vec::new())\n120\t}\n121\t\n122\tpub(crate) fn event_envelope_with_refs(\n123\t    task_id: &str,\n124\t    session_id: &str,\n125\t    objective: &str,\n126\t    references: Vec<StableRef>,\n127\t) -> PartialEnvelope {\n128\t    let payload = EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n129\t        context_handle_id: None,\n130\t        seed_event_ids: Vec::new(),\n131\t        initial_memory_ids: Vec::new(),\n132\t        objective: objective.to_string(),\n133\t    });\n134\t    PartialEnvelope {\n135\t        workspace_id: Some(\"workspace-main\".to_string()),\n136\t        branch: BranchRef {\n137\t            name: \"main\".to_string(),\n138\t        },\n139\t        session_id: SessionId {\n140\t            value: session_id.to_string(),\n141\t        },\n142\t        task_id: Some(TaskId {\n143\t            value: task_id.to_string(),\n144\t        }),\n145\t        actor: Actor::Assistant {\n146\t            model: \"gpt-5.5\".to_string(),\n