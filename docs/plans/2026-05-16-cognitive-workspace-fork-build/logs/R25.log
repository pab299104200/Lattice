?4, ?5, ?6, ?7, ?8)\",\n108\t        params![\n109\t            evidence.evidence_id.as_str(),\n110\t            memory_id,\n111\t            event_id,\n112\t            evidence.anchor.kind(),\n113\t            anchor_json,\n114\t            encode_timestamp(evidence.captured_at),\n115\t            captured_by_kind,\n116\t            captured_by_detail,\n117\t        ],\n118\t    );\n119\t    if let Err(error) = result {\n120\t        warn_on_fk_violation(\"insert_evidence\", &error);\n121\t        return Err(MemoryEvidenceError::Sqlite(error));\n122\t    }\n123\t    Ok(())\n124\t}\n125\t\n126\tpub fn get_evidence_for(\n127\t    conn: &Connection,\n128\t    memory_id: &MemoryId,\n129\t) -> Result<Vec<MemoryEvidence>, MemoryEvidenceError> {\n130\t    let encoded_memory_id = encode_identity_text(&Identity::Memory(memory_id.clone()));\n131\t    let mut statement = conn.prepare(\n132\t        \"SELECT evidence_id, memory_id, event_id, anchor_kind, anchor_json, captured_at,\n133\t                captured_by_kind, captured_by_detail\n134\t         FROM memory_evidence\n135\t         WHERE memory_id = ?1\n136\t         ORDER BY captured_at ASC, evidence_id ASC\",\n137\t    )?;\n138\t    let rows = statement.query_map(params![encoded_memory_id], |row| {\n139\t        let stored_memory_id = match crate::memory_graph::decode_identity_text(\n140\t            row.get::<_, String>(1)?.as_str(),\n141\t            \"memory_id\",\n142\t        )\n143\t        .map_err(|error| {\n144\t            row_decode_error(\n145\t                1,\n146\t                rusqlite::types::Type::Text,\n147\t                MemoryEvidenceError::Parse(error),\n148\t            )\n149\t        })? {\n150\t            Identity::Memory(value) => value,\n151\t            other => {\n152\t                return Err(row_decode_error(\n153\t                    1,\n154\t                    rusqlite::types::Type::Text,\n155\t                    MemoryEvidenceError::Parse(MemoryGraphParseError::InvalidJson