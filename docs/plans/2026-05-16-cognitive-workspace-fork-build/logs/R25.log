{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NPKMYRpNW9BYLjLZgf6wkP","type":"tool_result","content":"1\tuse std::time::Duration;\n2\t\n3\tuse chrono::{DateTime, Utc};\n4\tuse rusqlite::{params, Connection};\n5\t\n6\tuse super::accesses::{list_accesses_for, mark_used, record_access, MemoryAccess, MemoryAccessId};\n7\tuse super::classes::{AssertionType, FreshnessKind, FreshnessPolicy, MemoryClass, MemoryScope};\n8\tuse super::evidence::{\n9\t    get_evidence_for, insert_evidence, EvidenceAnchor, MemoryEvidence, MemoryEvidenceId,\n10\t};\n11\tuse super::links::{\n12\t    get_links_by_type, get_links_from, get_links_to, insert_link, MemoryLink, MemoryLinkError,\n13\t    MemoryLinkId, MemoryLinkTarget, MemoryLinkType,\n14\t};\n15\tuse super::scores::{latest_score, score_history, write_score, MemoryScore, ScoreKind};\n16\tuse super::{initialize_schema, TestId, VerificationStatus};\n17\tuse crate::events::{Actor, DocSectionId};\n18\tuse crate::identity::{DocId, EventId, FileId, MemoryId, SectionId, SymbolId};\n19\t\n20\t#[test]\n21\tfn every_link_type_round_trips() {\n22\t    let conn = open_schema();\n23\t    let source = memory_id(\"source\");\n24\t    insert_memory_row(&conn, &source);\n25\t\n26\t    for link_type in [\n27\t        MemoryLinkType::Supports,\n28\t        MemoryLinkType::Contradicts,\n29\t        MemoryLinkType::Supersedes,\n30\t        MemoryLinkType::Refines,\n31\t        MemoryLinkType::Generalizes,\n32\t        MemoryLinkType::Specializes,\n33\t        MemoryLinkType::CoOccursWith,\n34\t        MemoryLinkType::DerivedFrom,\n35\t        MemoryLinkType::AppliesTo,\n36\t        MemoryLinkType::ValidatedBy,\n37\t        MemoryLinkType::InvalidatedBy,\n38\t    ] {\n39\t        let target = memory_id(link_type.as_str());\n40\t        insert_memory_row(&conn, &target);\n41\t        let link = MemoryLink::try_new(\n42\t            MemoryLinkId(format!(\"link-{}\", link_type.as_str())),\n43\t            source.clone(),\n44\t            MemoryLinkTarget::Memory(target),\n45\t            link_type,\n46\t            0.6,\n47\t            format!(\"{} reason\", link_type.as_str()),\n48\t            Some(event_id(link_type.as_str())),\n49\t            Actor::Assistant {\n50\t                model: \"gpt-test\".to_string(),\n51\t            },\n52\t            timestamp(100),\n53\t            VerificationStatus::Verified,\n54\t        )\n55\t        .unwrap();\n56\t        insert_link(&conn, &link).unwrap();\n57\t    }\n58\t\n59\t    for link_type in [\n60\t        MemoryLinkType::Supports,\n61\t        MemoryLinkType::Contradicts,\n62\t        MemoryLinkType::Supersedes,\n63\t        MemoryLinkType::Refines,\n64\t        MemoryLinkType::Generalizes,\n65\t        MemoryLinkType::Specializes,\n66\t        MemoryLinkType::CoOccursWith,\n67\t        MemoryLinkType::DerivedFrom,\n68\t        MemoryLinkType::AppliesTo,\n69\t        MemoryLinkType::ValidatedBy,\n70\t        MemoryLinkType::InvalidatedBy,\n71\t    ] {\n72\t        let links = get_links_by_type(&conn, link_type).unwrap();\n73\t        assert_eq!(links.len(), 1);\n74\t        assert_eq!(links[0].link_type, link_type);\n75\t    }\n76\t}\n77\t\n78\t#[test]\n79\tfn strength_outside_unit_interval_is_rejected() {\n80\t    let error = MemoryLink::try_new(\n81\t        MemoryLinkId(\"invalid\".to_string()),\n82\t        memory_id(\"source\"),\n83\t        MemoryLinkTarget::Memory(memory_id(\"target\")),\n84\t        MemoryLinkType::Supports,\n85\t        1.1,\n86\t        \"bad\".to_string(),\n87\t        None,\n88\t        Actor::User,\n89\t        timestamp(10),\n90\t        VerificationStatus::Unverified,\n91\t    )\n92\t    .unwrap_err();\n93\t\n94\t    assert!(matches!(error, MemoryLinkError::InvalidStrength { .. }));\n95\t}\n96\t\n97\t#[test]\n98\tfn target_dispatch_round_trips_memory_and_graph_nodes() {\n99\t    let conn = open_schema();\n100\t    let source = memory_id(\"source\");\n101\t    let target_memory = memory_id(\"target\");\n102\t    insert_memory_row(&conn, &source);\n103\t    insert_memory_row(&conn, &target_memory);\n104\t\n105\t    let memory_link = MemoryLink::try_new(\n106\t        MemoryLinkId(\"link-memory\".to_string()),\n107\t        source.clone(),\n108\t        MemoryLinkTarget::Memory(target_memory.clone()),\n109\t        MemoryLinkType::Supports,\n110\t        0.7,\n111\t        \"memory target\".to_string(),\n112\t        None,\n113\t        Actor::User,\n114\t        timestamp(20),\n115\t        VerificationStatus::Verified,\n116\t    )\n117\t    .unwrap();\n118\t    insert_link(&conn, &memory_link).unwrap();\n119\t\n120\t    let symbol = symbol_id(\"target_fn\");\n121\t    let symbol_link = MemoryLink::try_new(\n122\t        MemoryLinkId(\"link-symbol\".to_string()),\n123\t        source.clone(),\n124\t        MemoryLinkTarget::Symbol(symbol.clone()),\n125\t        MemoryLinkType::AppliesTo,\n126\t        0.4,\n127\t        \"symbol target\".to_string(),\n128\t        None,\n129\t        Actor::Tool {\n130\t            name: \"search\".to_string(),\n131\t        },\n132\t        timestamp(21),\n133\t        VerificationStatus::InReview,\n134\t    )\n135\t    .unwrap();\n136\t    insert_link(&conn, &symbol_link).unwrap();\n137\t\n138\t    let links_from = get_links_from(&conn, &source).unwrap();\n139\t    assert_eq!(links_from.len(), 2);\n140\t    assert_eq!(links_from[0], memory_link);\n141\t    assert_eq!(links_from[1], symbol_link);\n142\t\n143\t    let links_to_memory = get_links_to(&conn, &MemoryLinkTarget::Memory(target_memory)).unwrap();\n144\t    assert_eq!(links_to_memory, vec![memory_link]);\n145\t\n146\t    let links_to_symbol = get_links_to(&conn, &MemoryLinkTarget::Symbol(symbol)).unwrap();\n147\t    assert_eq!(links_to_symbol, vec![symbol_link]);\n148\t}\n149\t\n150\t#[test]\n151\tfn evidence_anchors_round_trip_including_file_span_sha256() {\n152\t    let conn = open_schema();\n153\t    let memory = memory_id(\"memory\");\n154\t    insert_memory_row(&conn, &memory);\n155\t\n156\t    let anchors = vec![\n157\t        EvidenceAnchor::FileSpan {\n158\t            file: file_id(\"src/lib.rs\"),\n159\t            byte_start: 4,\n160\t            byte_end: 12,\n161\t            sha256: [7_u8; 32],\n162\t        },\n163\t        EvidenceAnchor::SymbolRef(symbol_id(\"parse\")),\n164\t        EvidenceAnchor::DocSection {\n165\t            id: doc_section_id(\"docs/guide.md\"),\n166\t            sha256: [9_u8; 32],\n167\t        },\n168\t        EvidenceAnchor::TestResult {\n169\t            test: test_id(\"tests/memory.rs\", \"test_anchor\"),\n170\t            passed: true,\n171\t            run_event: event_id(\"test-run\"),\n172\t        },\n173\t        EvidenceAnchor::EventReference(event_id(\"event-ref\")),\n174\t    ];\n175\t\n176\t    for (index, anchor) in anchors.iter().cloned().enumerate() {\n177\t        let evidence = MemoryEvidence {\n178\t            evidence_id: MemoryEvidenceId(format!(\"evidence-{index}\")),\n179\t            memory_id: memory.clone(),\n180\t            event_id: Some(event_id(&format!(\"capture-{index}\"))),\n181\t            anchor,\n182\t            captured_at: timestamp(30 + index as i64),\n183\t            captured_by: Actor::Daemon,\n184\t        };\n185\t        insert_evidence(&conn, &evidence).unwrap();\n186\t    }\n187\t\n188\t    let stored = get_evidence_for(&conn, &memory).unwrap();\n189\t    assert_eq!(stored.len(), anchors.len());\n190\t    assert_eq!(stored[0].anchor, anchors[0]);\n191\t    assert_eq!(stored[1].anchor, anchors[1]);\n192\t    assert_eq!(stored[2].anchor, anchors[2]);\n193\t    assert_eq!(stored[3].anchor, anchors[3]);\n194\t    assert_eq!(stored[4].anchor, anchors[4]);\n195\t}\n196\t\n197\t#[test]\n198\tfn accesses_can_be_marked_used_after_the_fact() {\n199\t    let conn = open_schema();\n200\t    let memory = memory_id(\"memory\");\n201\t    insert_memory_row(&conn, &memory);\n202\t\n203\t    let access = MemoryAccess {\n204\t        access_id: MemoryAccessId(\"access-1\".to_string()),\n205\t        memory_id: memory.clone(),\n206\t        accessed_at: timestamp(40),\n207\t        accessed_in_event: event_id(\"retrieval\"),\n208\t        accessor: Actor::Assistant {\n209\t            model: \"gpt-test\".to_string(),\n210\t        },\n211\t        inclusion_reason: \"top retrieval result\".to_string(),\n212\t        was_used: None,\n213\t        downstream_outcome_event: None,\n214\t    };\n215\t    record_access(&conn, &access).unwrap();\n216\t    mark_used(&conn, &access.access_id, true, Some(&event_id(\"outcome\"))).unwrap();\n217\t\n218\t    let accesses = list_accesses_for(&conn, &memory).unwrap();\n219\t    assert_eq!(accesses.len(), 1);\n220\t    assert_eq!(accesses[0].was_used, Some(true));\n221\t    assert_eq!(\n222\t        accesses[0].downstream_outcome_event,\n223\t        Some(event_id(\"outcome\"))\n224\t    );\n225\t}\n226\t\n227\t#[test]\n228\tfn score_history_orders_newest_first() {\n229\t    let conn = open_schema();\n230\t    let memory = memory_id(\"memory\");\n231\t    insert_memory_row(&conn, &memory);\n232\t\n233\t    let older = MemoryScore {\n234\t        memory_id: memory.clone(),\n235\t        score_kind: ScoreKind::RecentUsefulness,\n236\t        value: 0.25,\n237\t        computed_at: timestamp(50),\n238\t        computed_from_window: Duration::from_secs(3600),\n239\t        sample_size: 3,\n240\t    };\n241\t    let newer = MemoryScore {\n242\t        memory_id: memory.clone(),\n243\t        score_kind: ScoreKind::RecentUsefulness,\n244\t        value: 0.75,\n245\t        computed_at: timestamp(60),\n246\t        computed_from_window: Duration::from_secs(7200),\n247\t        sample_size: 6,\n248\t    };\n249\t    write_score(&conn, &older).unwrap();\n250\t    write_score(&conn, &newer).unwrap();\n251\t\n252\t    let history = score_history(&conn, &memory, ScoreKind::RecentUsefulness).unwrap();\n253\t    assert_eq!(history, vec![newer.clone(), older]);\n254\t    assert_eq!(\n255\t        latest_score(&conn, &memory, ScoreKind::RecentUsefulness).unwrap(),\n256\t        Some(newer)\n257\t    );\n258\t}\n259\t\n260\tfn open_schema() -> Connection {\n261\t    let conn = Connection::open_in_memory().unwrap();\n262\t    conn.execute_batch(\"PRAGMA foreign_keys = ON;\").unwrap();\n263\t    initialize_schema(&conn).unwrap();\n264\t    conn\n265\t}\n266\t\n267\tfn insert_memory_row(conn: &Connection, memory_id: &MemoryId) {\n268\t    let freshness_policy = serde_json::to_string(&FreshnessPolicy {\n269\t        kind: FreshnessKind::SessionScoped,\n270\t        ttl: None,\n271\t        recheck_interval: None,\n272\t    })\n273\t    .unwrap();\n274\t    let encoded_memory_id =\n275\t        crate::identity::encode_identity(&crate::identity::Identity::Memory(memory_id.clone()));\n276\t    conn.execute(\n277\t        \"INSERT INTO memories\n278\t            (memory_id, content, class, assertion_type, scope, scope_session_id, scope_branch,\n279\t             scope_workspace_id, scope_user_id, scope_org_id, verification_status, confidence,\n280\t             confidence_reason, freshness_policy_json, validity_conditions_json,\n281\t             invalidation_triggers_json, provenance_event_ids_json, evidence_references_json,\n282\t             linked_files_json, linked_symbols_json, linked_docs_json, linked_tests_json,\n283\t             linked_memories_json, contradiction_links_json, supersession_links_json,\n284\t             access_history_json, last_verified_event_id, last_verified_state, usefulness_score,\n285\t             usefulness_score_updated_at, created_at, created_by, updated_at, updated_by,\n286\t             superseded_by, schema_version)\n287\t         VALUES\n288\t            (?1, ?2, ?3, ?4, ?5, ?6, NULL, NULL, NULL, NULL, ?7, ?8, ?9, ?10, '[]', '[]', '[]',\n289\t             '[]', '[]', '[]', '[]', '[]', '[]', '[]', '[]', '[]', NULL, NULL, 0.0, 0, 0, ?11,\n290\t             0, ?12, NULL, 1)\",\n291\t        params![\n292\t            encoded_memory_id,\n293\t            format!(\"memory {}\", memory_id.ulid),\n294\t            MemoryClass::Observation.as_str(),\n295\t            AssertionType::Observation.as_str(),\n296\t            MemoryScope::Session.as_str(),\n297\t            \"session-1\",\n298\t            VerificationStatus::Unverified.as_str(),\n299\t            0.5_f64,\n300\t            \"seed\",\n301\t            freshness_policy,\n302\t            \"user\",\n303\t            \"assistant\",\n304\t        ],\n305\t    )\n306\t    .unwrap();\n307\t}\n308\t\n309\tfn file_id(path: &str) -> FileId {\n310\t    FileId {\n311\t        workspace_id: \"workspace\".to_string(),\n312\t        repo_relative_path: path.to_string(),\n313\t        content_hash: \"deadbeef\".to_string(),\n314\t    }\n315\t}\n316\t\n317\tfn symbol_id(name: &str) -> SymbolId {\n318\t    SymbolId {\n319\t        file: file_id(\"src/lib.rs\"),\n320\t        qualified_name: name.to_string(),\n321\t        byte_offset: 12,\n322\t        kind: \"function\".to_string(),\n323\t    }\n324\t}\n325\t\n326\tfn doc_section_id(path: &str) -> DocSectionId {\n327\t    SectionId {\n328\t        doc: DocId {\n329\t            workspace_id: \"workspace\".to_string(),\n330\t            repo_relative_path: path.to_string(),\n331\t            content_hash: \"feedface\".to_string(),\n332\t        },\n333\t        heading_path: vec![\"Guide\".to_string(), \"Section\".to_string()],\n334\t        byte_offset: 44,\n335\t    }\n336\t}\n337\t\n338\tfn memory_id(suffix: &str) -> MemoryId {\n339\t    MemoryId {\n340\t        workspace_id: \"workspace\".to_string(),\n341\t        ulid: stable_ulid(suffix),\n342\t    }\n343\t}\n344\t\n345\tfn event_id(suffix: &str) -> EventId {\n346\t    EventId {\n347\t        workspace_id: \"workspace\".to_string(),\n348\t        ulid: stable_ulid(&format!(\"event-{suffix}\")),\n349\t    }\n350\t}\n351\t\n352\tfn test_id(test_path: &str, test_name: &str) -> TestId {\n353\t    TestId {\n354\t        workspace_id: \"workspace\".to_string(),\n355\t        test_path: test_path.to_string(),\n356\t        test_name: test_name.to_string(),\n357\t    }\n358\t}\n359\t\n360\tfn timestamp(seconds: i64) -> DateTime<Utc> {\n361\t    DateTime::from_unix_seconds(seconds)\n362\t}\n363\t\n364\tfn stable_ulid(seed: &str) -> String {\n365\t    const ALPHABET: &[u8; 32] = b\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\n366\t    let mut bytes = [b'0'; 26];\n367\t    bytes[..24].copy_from_slice(b\"01ARZ3NDEKTSV4RRFFQ69G5F\");\n368\t    let checksum = seed.bytes().fold(0_u32, |acc, byte| {\n369\t        acc.wrapping_mul(33).wrapping_add(u32::from(byte))\n370\t    });\n371\t    bytes[24] = ALPHABET[((checksum >> 5) & 31) as usize];\n372\t    bytes[25] = ALPHABET[(checksum & 31) as usize];\n373\t    String::from_utf8(bytes.to_vec()).unwrap()\n374\t}\n375\t"}]},"parent_tool_use_id":null,"session_id":"6c80d671-1437-429b-9e3a-231a1f740b4b","uuid":"4f9e9849-20ff-4d7c-aae5-9700da6f40ec","timestamp":"2026-05-17T07:20:32.978Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/memory_graph/links_tests.rs","content":"use std::time::Duration;\n\nuse chrono::{DateTime, Utc};\nuse rusqlite::{params, Connection};\n\nuse super::accesses::{list_accesses_for, mark_used, record_access, MemoryAccess, MemoryAccessId};\nuse super::classes::{AssertionType, FreshnessKind, FreshnessPolicy, MemoryClass, MemoryScope};\nuse super::evidence::{\n    get_evidence_for, insert_evidence, EvidenceAnchor, MemoryEvidence, MemoryEvidenceId,\n};\nuse super::links::{\n    get_links_by_type, get_links_from, get_links_to, insert_link, MemoryLink, MemoryLinkError,\n    MemoryLinkId, MemoryLinkTarget, MemoryLinkType,\n};\nuse super::scores::{latest_score, score_history, write_score, MemoryScore, ScoreKind};\nuse super::{initialize_schema, TestId, VerificationStatus};\nuse crate::events::{Actor, DocSectionId};\nuse crate::identity::{DocId, EventId, FileId, MemoryId, SectionId, SymbolId};\n\n#[test]\nfn every_link_type_round_trips() {\n    let conn = open_schema();\n    let source = memory_id(\"source\");\n    insert_memory_row(&conn, &source);\n\n    for link_type in [\n        MemoryLinkType::Supports,\n        MemoryLinkType::Contradicts,\n        MemoryLinkType::Supersedes,\n        MemoryLinkType::Refines,\n        MemoryLinkType::Generalizes,\n        MemoryLinkType::Specializes,\n        MemoryLinkType::CoOccursWith,\n        MemoryLinkType::DerivedFrom,\n        MemoryLinkType::AppliesTo,\n        MemoryLinkType::ValidatedBy,\n        MemoryLinkType::InvalidatedBy,\n    ] {\n        let target = memory_id(link_type.as_str());\n        insert_memory_row(&conn, &target);\n        let link = MemoryLink::try_new(\n            MemoryLinkId(format!(\"link-{}\", link_type.as_str())),\n            source.clone(),\n            MemoryLinkTarget::Memory(target),\n            link_type,\n            0.6,\n            format!(\"{} reason\", link_type.as_str()),\n            Some(event_id(link_type.as_str())),\n            Actor::Assistant {\n                model: \"gpt-test\".to_string(),\n            },\n            timestamp(100),\n            VerificationStatus::Verified,\n        )\n        .unwrap();\n        insert_link(&conn, &link).unwrap();\n    }\n\n    for link_type in [\n        MemoryLinkType::Supports,\n        MemoryLinkType::Contradicts,\n        MemoryLinkType::Supersedes,\n        MemoryLinkType::Refines,\n        MemoryLinkType::Generalizes,\n        MemoryLinkType::Specializes,\n        MemoryLinkType::CoOccursWith,\n        MemoryLinkType::DerivedFrom,\n        MemoryLinkType::AppliesTo,\n        MemoryLinkType::ValidatedBy,\n        MemoryLinkType::InvalidatedBy,\n    ] {\n        let links = get_links_by_type(&conn, link_type).unwrap();\n        assert_eq!(links.len(), 1);\n        assert_eq!(links[0].link_type, link_type);\n    }\n}\n\n#[test]\nfn strength_outside_unit_interval_is_rejected() {\n    let error = MemoryLink::try_new(\n        MemoryLinkId(\"invalid\".to_string()),\n        memory_id(\"source\"),\n        MemoryLinkTarget::Memory(memory_id(\"target\")),\n        MemoryLinkType::Supports,\n        1.1,\n        \"bad\".to_string(),\n        None,\n        Actor::User,\n        timestamp(10),\n        VerificationStatus::Unverified,\n    )\n    .unwrap_err();\n\n    assert!(matches!(error, MemoryLinkError::InvalidStrength { .. }));\n}\n\n#[test]\nfn target_dispatch_round_trips_memory_and_graph_nodes() {\n    let conn = open_schema();\n    let source = memory_id(\"source\");\n    let target_memory = memory_id(\"target\");\n    insert_memory_row(&conn, &source);\n    insert_memory_row(&conn, &target_memory);\n\n    let memory_link = MemoryLink::try_new(\n        MemoryLinkId(\"link-memory\".to_string()),\n        source.clone(),\n        MemoryLinkTarget::Memory(target_memory.clone()),\n        MemoryLinkType::Supports,\n        0.7,\n        \"memory target\".to_string(),\n        None,\n        Actor::User,\n        timestamp(20),\n        VerificationStatus::Verified,\n    )\n    .unwrap();\n    insert_link(&conn, &memory_link).unwrap();\n\n    let symbol = symbol_id(\"target_fn\");\n    let symbol_link = MemoryLink::try_new(\n        MemoryLinkId(\"link-symbol\".to_string()),\n        source.clone(),\n        MemoryLinkTarget::Symbol(symbol.clone()),\n        MemoryLinkType::AppliesTo,\n        0.4,\n        \"symbol target\".to_string(),\n        None,\n        Actor::Tool {\n            name: \"search\".to_string(),\n        },\n        timestamp(21),\n        VerificationStatus::InReview,\n    )\n    .unwrap();\n    insert_link(&conn, &symbol_link).unwrap();\n\n    let links_from = get_links_from(&conn, &source).unwrap();\n    assert_eq!(links_from.len(), 2);\n    assert_eq!(links_from[0], memory_link);\n    assert_eq!(links_from[1], symbol_link);\n\n    let links_to_memory = get_links_to(&conn, &MemoryLinkTarget::Memory(target_memory)).unwrap();\n    assert_eq!(links_to_memory, vec![memory_link]);\n\n    let links_to_symbol = get_links_to(&conn, &MemoryLinkTarget::Symbol(symbol)).unwrap();\n    assert_eq!(links_to_symbol, vec![symbol_link]);\n}\n\n#[test]\nfn evidence_anchors_round_trip_including_file_span_sha256() {\n    let conn = open_schema();\n    let memory = memory_id(\"memory\");\n    insert_memory_row(&conn, &memory);\n\n    let anchors = vec![\n        EvidenceAnchor::FileSpan {\n            file: file_id(\"src/lib.rs\"),\n            byte_start: 4,\n            byte_end: 12,\n            sha256: [7_u8; 32],\n        },\n        EvidenceAnchor::SymbolRef(symbol_id(\"parse\")),\n        EvidenceAnchor::DocSection {\n            id: doc_section_id(\"docs/guide.md\"),\n            sha256: [9_u8; 32],\n        },\n        EvidenceAnchor::TestResult {\n            test: test_id(\"tests/memory.rs\", \"test_anchor\"),\n            passed: true,\n            run_event: event_id(\"test-run\"),\n        },\n        EvidenceAnchor::EventReference(event_id(\"event-ref\")),\n    ];\n\n    for (index, anchor) in anchors.iter().cloned().enumerate() {\n        let evidence = MemoryEvidence {\n            evidence_id: MemoryEvidenceId(format!(\"evidence-{index}\")),\n            memory_id: memory.clone(),\n            event_id: Some(event_id(&format!(\"capture-{index}\"))),\n            anchor,\n            captured_at: timestamp(30 + index as i64),\n            captured_by: Actor::Daemon,\n        };\n        insert_evidence(&conn, &evidence).unwrap();\n    }\n\n    let stored = get_evidence_for(&conn, &memory).unwrap();\n    assert_eq!(stored.len(), anchors.len());\n    assert_eq!(stored[0].anchor, anchors[0]);\n    assert_eq!(stored[1].anchor, anchors[1]);\n    assert_eq!(stored[2].anchor, anchors[2]);\n    assert_eq!(stored[3].anchor, anchors[3]);\n    assert_eq!(stored[4].anchor, anchors[4]);\n}\n\n#[test]\nfn accesses_can_be_marked_used_after_the_fact() {\n    let conn = open_schema();\n    let memory = memory_id(\"memory\");\n    insert_memory_row(&conn, &memory);\n\n    let access = MemoryAccess {\n        access_id: MemoryAccessId(\"access-1\".to_string()),\n        memory_id: memory.clone(),\n        accessed_at: timestamp(40),\n        accessed_in_event: event_id(\"retrieval\"),\n        accessor: Actor::Assistant {\n            model: \"gpt-test\".to_string(),\n        },\n        inclusion_reason: \"top retrieval result\".to_string(),\n        was_used: None,\n        downstream_outcome_event: None,\n    };\n    record_access(&conn, &access).unwrap();\n    mark_used(&conn, &access.access_id, true, Some(&event_id(\"outcome\"))).unwrap();\n\n    let accesses = list_accesses_for(&conn, &memory).unwrap();\n    assert_eq!(accesses.len(), 1);\n    assert_eq!(accesses[0].was_used, Some(true));\n    assert_eq!(\n        accesses[0].downstream_outcome_event,\n        Some(event_id(\"outcome\"))\n    );\n}\n\n#[test]\nfn score_history_orders_newest_first() {\n    let conn = open_schema();\n    let memory = memory_id(\"memory\");\n    insert_memory_row(&conn, &memory);\n\n    let older = MemoryScore {\n        memory_id: memory.clone(),\n        score_kind: ScoreKind::RecentUsefulness,\n        value: 0.25,\n        computed_at: timestamp(50),\n        computed_from_window: Duration::from_secs(3600),\n        sample_size: 3,\n    };\n    let newer = MemoryScore {\n        memory_id: memory.clone(),\n        score_kind: ScoreKind::RecentUsefulness,\n        value: 0.75,\n        computed_at: timestamp(60),\n        computed_from_window: Duration::from_secs(7200),\n        sample_size: 6,\n    };\n    write_score(&conn, &older).unwrap();\n    write_score(&conn, &newer).unwrap();\n\n    let history = score_history(&conn, &memory, ScoreKind::RecentUsefulness).unwrap();\n    assert_eq!(history, vec![newer.clone(), older]);\n    assert_eq!(\n        latest_score(&conn, &memory, ScoreKind::RecentUsefulness).unwrap(),\n        Some(newer)\n    );\n}\n\nfn open_schema() -> Connection {\n    let conn = Connection::open_in_memory().unwrap();\n    conn.execute_batch(\"PRAGMA foreign_keys = ON;\").unwrap();\n    initialize_schema(&conn).unwrap();\n    conn\n}\n\nfn insert_memory_row(conn: &Connection, memory_id: &MemoryId) {\n    let freshness_policy = serde_json::to_string(&FreshnessPolicy {\n        kind: FreshnessKind::SessionScoped,\n        ttl: None,\n        recheck_interval: None,\n    })\n    .unwrap();\n    let encoded_memory_id =\n        crate::identity::encode_identity(&crate::identity::Identity::Memory(memory_id.clone()));\n    conn.execute(\n        \"INSERT INTO memories\n            (memory_id, content, class, assertion_type, scope, scope_session_id, scope_branch,\n             scope_workspace_id, scope_user_id, scope_org_id, verification_status, confidence,\n             confidence_reason, freshness_policy_json, validity_conditions_json,\n             invalidation_triggers_json, provenance_event_ids_json, evidence_references_json,\n             linked_files_json, linked_symbols_json, linked_docs_json, linked_tests_json,\n             linked_memories_json, contradiction_links_json, supersession_links_json,\n             access_history_json, last_verified_event_id, last_verified_state, usefulness_score,\n             usefulness_score_updated_at, created_at, created_by, updated_at, updated_by,\n             superseded_by, schema_version)\n         VALUES\n            (?1, ?2, ?3, ?4, ?5, ?6, NULL, NULL, NULL, NULL, ?7, ?8, ?9, ?10, '[]', '[]', '[]',\n             '[]', '[]', '[]', '[]', '[]', '[]', '[]', '[]', '[]', NULL, NULL, 0.0, 0, 0, ?11,\n             0, ?12, NULL, 1)\",\n        params![\n            encoded_memory_id,\n            format!(\"memory {}\", memory_id.ulid),\n            MemoryClass::Observation.as_str(),\n            AssertionType::Observation.as_str(),\n            MemoryScope::Session.as_str(),\n            \"session-1\",\n            VerificationStatus::Unverified.as_str(),\n            0.5_f64,\n            \"seed\",\n            freshness_policy,\n            \"user\",\n            \"assistant\",\n        ],\n    )\n    .unwrap();\n}\n\nfn file_id(path: &str) -> FileId {\n    FileId {\n        workspace_id: \"workspace\".to_string(),\n        repo_relative_path: path.to_string(),\n        content_hash: \"deadbeef\".to_string(),\n    }\n}\n\nfn symbol_id(name: &str) -> SymbolId {\n    SymbolId {\n        file: file_id(\"src/lib.rs\"),\n        qualified_name: name.to_string(),\n        byte_offset: 12,\n        kind: \"function\".to_string(),\n    }\n}\n\nfn doc_section_id(path: &str) -> DocSectionId {\n    SectionId {\n        doc: DocId {\n            workspace_id: \"workspace\".to_string(),\n            repo_relative_path: path.to_string(),\n            content_hash: \"feedface\".to_string(),\n        },\n        heading_path: vec![\"Guide\".to_string(), \"Section\".to_string()],\n        byte_offset: 44,\n    }\n}\n\nfn memory_id(suffix: &str) -> MemoryId {\n    MemoryId {\n        workspace_id: \"workspace\".to_string(),\n        ulid: stable_ulid(suffix),\n    }\n}\n\nfn event_id(suffix: &str) -> EventId {\n    EventId {\n        workspace_id: \"workspace\".to_string(),\n        ulid: stable_ulid(&format!(\"event-{suffix}\")),\n    }\n}\n\nfn test_id(test_path: &str, test_name: &str) -> TestId {\n    TestId {\n        workspace_id: \"workspace\".to_string(),\n        test_path: test_path.to_string(),\n        test_name: test_name.to_string(),\n    }\n}\n\nfn timestamp(seconds: i64) -> DateTime<Utc> {\n    DateTime::from_unix_seconds(seconds)\n}\n\nfn stable_ulid(seed: &str) -> String {\n    const ALPHABET: &[u8; 32] = b\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\n    let mut bytes = [b'0'; 26];\n    bytes[..24].copy_from_slice(b\"01ARZ3NDEKTSV4RRFFQ69G5F\");\n    let checksum = seed.bytes().fold(0_u32, |acc, byte| {\n        acc.wrapping_mul(33).wrapping_add(u32::from(byte))\n    });\n    bytes[24] = ALPHABET[((checksum >> 5) & 31) as usize];\n    bytes[25] = ALPHABET[(checksum & 31) as usize];\n    String::from_utf8(bytes.to_vec()).unwrap()\n}\n","numLines":375,"startLine":1,"totalLines":375}}}
