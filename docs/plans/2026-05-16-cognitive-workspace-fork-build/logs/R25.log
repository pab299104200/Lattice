{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VVHP6Qjz3Wgj493bdBFSFC","type":"tool_result","content":"1\tuse std::fmt;\n2\tuse std::str::FromStr;\n3\tuse std::time::Duration;\n4\t\n5\tuse serde::de::DeserializeOwned;\n6\tuse serde::{Deserialize, Serialize};\n7\t\n8\tuse crate::events::StableRef;\n9\tuse crate::identity::{EventId, FileId, MemoryId, SectionId, SymbolId};\n10\t\n11\t/// Primary memory classes from the cognitive workspace Memory Graph spec:\n12\t/// `Observation`, `Decision`, `Constraint`, `Pattern`, `AntiPattern`,\n13\t/// `WorkflowOutcome`, `FailurePattern`, `Procedure`, `Preference`,\n14\t/// `ArchitectureInvariant`, `DocsContract`, `OpenQuestion`, `CounterMemory`.\n15\t///\n16\t/// `CounterMemory` -- a memory record that explicitly asserts a prior memory is\n17\t/// wrong or no longer applicable. Distinct from a `contradicts` link: a link\n18\t/// connects two existing memories; a CounterMemory is a first-class record\n19\t/// authored by an agent or user that carries its own evidence, scope, and\n20\t/// verification status and can itself be superseded or invalidated.\n21\t///\n22\t/// Each memory record requires: stable id, content, memory class, assertion\n23\t/// type, scope: session, branch, repo, user, organization, verification status,\n24\t/// confidence and confidence reason, freshness policy, validity conditions,\n25\t/// invalidation triggers, provenance events, evidence references, linked files,\n26\t/// linked symbols, linked docs, linked tests, linked memories, contradiction\n27\t/// links, supersession links, access history, usefulness scores, last verified\n28\t/// state.\n29\t#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n30\t#[serde(rename_all = \"snake_case\")]\n31\tpub enum MemoryClass {\n32\t    Observation,\n33\t    Decision,\n34\t    Constraint,\n35\t    Pattern,\n36\t    AntiPattern,\n37\t    WorkflowOutcome,\n38\t    FailurePattern,\n39\t    Procedure,\n40\t    Preference,\n41\t    ArchitectureInvariant,\n42\t    DocsContract,\n43\t    OpenQuestion,\n44\t    CounterMemory,\n45\t}\n46\t\n47\timpl MemoryClass {\n48\t    pub const VALUES: &'static [&'static str] = &[\n49\t        \"observation\",\n50\t        \"decision\",\n51\t        \"constraint\",\n52\t        \"pattern\",\n53\t        \"anti_pattern\",\n54\t        \"workflow_outcome\",\n55\t        \"failure_pattern\",\n56\t        \"procedure\",\n57\t        \"preference\",\n58\t        \"architecture_invariant\",\n59\t        \"docs_contract\",\n60\t        \"open_question\",\n61\t        \"counter_memory\",\n62\t    ];\n63\t\n64\t    /// Return the canonical snake_case wire name used in storage and MCP payloads.\n65\t    pub fn as_str(self) -> &'static str {\n66\t        match self {\n67\t            MemoryClass::Observation => \"observation\",\n68\t            MemoryClass::Decision => \"decision\",\n69\t            MemoryClass::Constraint => \"constraint\",\n70\t            MemoryClass::Pattern => \"pattern\",\n71\t            MemoryClass::AntiPattern => \"anti_pattern\",\n72\t            MemoryClass::WorkflowOutcome => \"workflow_outcome\",\n73\t            MemoryClass::FailurePattern => \"failure_pattern\",\n74\t            MemoryClass::Procedure => \"procedure\",\n75\t            MemoryClass::Preference => \"preference\",\n76\t            MemoryClass::ArchitectureInvariant => \"architecture_invariant\",\n77\t            MemoryClass::DocsContract => \"docs_contract\",\n78\t            MemoryClass::OpenQuestion => \"open_question\",\n79\t            MemoryClass::CounterMemory => \"counter_memory\",\n80\t        }\n81\t    }\n82\t}\n83\t\n84\timpl FromStr for MemoryClass {\n85\t    type Err = MemoryGraphParseError;\n86\t\n87\t    fn from_str(value: &str) -> Result<Self, Self::Err> {\n88\t        match value {\n89\t            \"observation\" => Ok(MemoryClass::Observation),\n90\t            \"decision\" => Ok(MemoryClass::Decision),\n91\t            \"constraint\" => Ok(MemoryClass::Constraint),\n92\t            \"pattern\" => Ok(MemoryClass::Pattern),\n93\t            \"anti_pattern\" => Ok(MemoryClass::AntiPattern),\n94\t            \"workflow_outcome\" => Ok(MemoryClass::WorkflowOutcome),\n95\t            \"failure_pattern\" => Ok(MemoryClass::FailurePattern),\n96\t            \"procedure\" => Ok(MemoryClass::Procedure),\n97\t            \"preference\" => Ok(MemoryClass::Preference),\n98\t            \"architecture_invariant\" => Ok(MemoryClass::ArchitectureInvariant),\n99\t            \"docs_contract\" => Ok(MemoryClass::DocsContract),\n100\t            \"open_question\" => Ok(MemoryClass::OpenQuestion),\n101\t            \"counter_memory\" => Ok(MemoryClass::CounterMemory),\n102\t            other => Err(MemoryGraphParseError::UnknownMemoryClass(other.to_string())),\n103\t        }\n104\t    }\n105\t}\n106\t\n107\t/// Truth-status asserted by a memory record, separate from the structural class.\n108\t#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n109\t#[serde(rename_all = \"snake_case\")]\n110\tpub enum AssertionType {\n111\t    Observation,\n112\t    Decision,\n113\t    Constraint,\n114\t    Hypothesis,\n115\t    Procedure,\n116\t    Outcome,\n117\t    Preference,\n118\t    Question,\n119\t    Counter,\n120\t}\n121\t\n122\timpl AssertionType {\n123\t    pub const VALUES: &'static [&'static str] = &[\n124\t        \"observation\",\n125\t        \"decision\",\n126\t        \"constraint\",\n127\t        \"hypothesis\",\n128\t        \"procedure\",\n129\t        \"outcome\",\n130\t        \"preference\",\n131\t        \"question\",\n132\t        \"counter\",\n133\t    ];\n134\t\n135\t    /// Return the canonical snake_case wire name used in storage and MCP payloads.\n136\t    pub fn as_str(self) -> &'static str {\n137\t        match self {\n138\t            AssertionType::Observation => \"observation\",\n139\t            AssertionType::Decision => \"decision\",\n140\t            AssertionType::Constraint => \"constraint\",\n141\t            AssertionType::Hypothesis => \"hypothesis\",\n142\t            AssertionType::Procedure => \"procedure\",\n143\t            AssertionType::Outcome => \"outcome\",\n144\t            AssertionType::Preference => \"preference\",\n145\t            AssertionType::Question => \"question\",\n146\t            AssertionType::Counter => \"counter\",\n147\t        }\n148\t    }\n149\t}\n150\t\n151\timpl FromStr for AssertionType {\n152\t    type Err = MemoryGraphParseError;\n153\t\n154\t    fn from_str(value: &str) -> Result<Self, Self::Err> {\n155\t        match value {\n156\t            \"observation\" => Ok(AssertionType::Observation),\n157\t            \"decision\" => Ok(AssertionType::Decision),\n158\t            \"constraint\" => Ok(AssertionType::Constraint),\n159\t            \"hypothesis\" => Ok(AssertionType::Hypothesis),\n160\t            \"procedure\" => Ok(AssertionType::Procedure),\n161\t            \"outcome\" => Ok(AssertionType::Outcome),\n162\t            \"preference\" => Ok(AssertionType::Preference),\n163\t            \"question\" => Ok(AssertionType::Question),\n164\t            \"counter\" => Ok(AssertionType::Counter),\n165\t            other => Err(MemoryGraphParseError::UnknownAssertionType(\n166\t                other.to_string(),\n167\t            )),\n168\t        }\n169\t    }\n170\t}\n171\t\n172\t/// Scope boundary for memory visibility and retrieval.\n173\t#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n174\t#[serde(rename_all = \"snake_case\")]\n175\tpub enum MemoryScope {\n176\t    Session,\n177\t    Branch,\n178\t    Repo,\n179\t    User,\n180\t    Organization,\n181\t}\n182\t\n183\timpl MemoryScope {\n184\t    pub const VALUES: &'static [&'static str] =\n185\t        &[\"session\", \"branch\", \"repo\", \"user\", \"organization\"];\n186\t\n187\t    /// Return the canonical snake_case wire name used in storage and MCP payloads.\n188\t    pub fn as_str(self) -> &'static str {\n189\t        match self {\n190\t            MemoryScope::Session => \"session\",\n191\t            MemoryScope::Branch => \"branch\",\n192\t            MemoryScope::Repo => \"repo\",\n193\t            MemoryScope::User => \"user\",\n194\t            MemoryScope::Organization => \"organization\",\n195\t        }\n196\t    }\n197\t}\n198\t\n199\timpl FromStr for MemoryScope {\n200\t    type Err = MemoryGraphParseError;\n201\t\n202\t    fn from_str(value: &str) -> Result<Self, Self::Err> {\n203\t        match value {\n204\t            \"session\" => Ok(MemoryScope::Session),\n205\t            \"branch\" => Ok(MemoryScope::Branch),\n206\t            \"repo\" => Ok(MemoryScope::Repo),\n207\t            \"user\" => Ok(MemoryScope::User),\n208\t            \"organization\" => Ok(MemoryScope::Organization),\n209\t            other => Err(MemoryGraphParseError::UnknownMemoryScope(other.to_string())),\n210\t        }\n211\t    }\n212\t}\n213\t\n214\t/// Verification state produced by the memory verification engine.\n215\t#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n216\t#[serde(rename_all = \"snake_case\")]\n217\tpub enum VerificationStatus {\n218\t    Unverified,\n219\t    InReview,\n220\t    Verified,\n221\t    Stale,\n222\t    Contradicted,\n223\t    Superseded,\n224\t    Expired,\n225\t    Invalidated,\n226\t}\n227\t\n228\timpl VerificationStatus {\n229\t    pub const VALUES: &'static [&'static str] = &[\n230\t        \"unverified\",\n231\t        \"in_review\",\n232\t        \"verified\",\n233\t        \"stale\",\n234\t        \"contradicted\",\n235\t        \"superseded\",\n236\t        \"expired\",\n237\t        \"invalidated\",\n238\t    ];\n239\t\n240\t    /// Return the canonical snake_case wire name used in storage and MCP payloads.\n241\t    pub fn as_str(self) -> &'static str {\n242\t        match self {\n243\t            VerificationStatus::Unverified => \"unverified\",\n244\t            VerificationStatus::InReview => \"in_review