{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F2vT9E8nwUA4yJYuF559EP","type":"tool_result","content":"1\tuse std::sync::{Arc, Mutex};\n2\t\n3\tuse rusqlite::{params, Connection, OptionalExtension};\n4\tuse thiserror::Error;\n5\tuse tracing::{error, info_span, warn};\n6\t\n7\tuse crate::events::EventWriteError;\n8\tuse crate::identity::{Identity, MemoryId};\n9\tuse crate::memory_graph::{\n10\t    encode_identity_text, AssertionType, MemoryClass, MemoryScope, VerificationStatus,\n11\t};\n12\t\n13\tuse super::migration_mapping::{map_row, migration_actor};\n14\t\n15\tpub(super) const MIGRATION_GUIDE: &str =\n16\t    \"docs/architecture/2026-05-16-memory-migration-guide.md#column-mapping\";\n17\tconst MIGRATION_SCHEMA_VERSION: i64 = 1;\n18\t\n19\t#[derive(Debug, Clone, PartialEq, Eq)]\n20\tpub struct MigrationTableCounts {\n21\t    pub memories: usize,\n22\t    pub memory_links: usize,\n23\t    pub memory_evidence: usize,\n24\t    pub memory_accesses: usize,\n25\t    pub memory_scores: usize,\n26\t}\n27\t\n28\timpl MigrationTableCounts {\n29\t    fn empty() -> Self {\n30\t        Self {\n31\t            memories: 0,\n32\t            memory_links: 0,\n33\t            memory_evidence: 0,\n34\t            memory_accesses: 0,\n35\t            memory_scores: 0,\n36\t        }\n37\t    }\n38\t}\n39\t\n40\t#[derive(Debug, Clone, PartialEq, Eq)]\n41\tpub struct SkippedRow {\n42\t    pub source_row_id: i64,\n43\t    pub reason: String,\n44\t}\n45\t\n46\t#[derive(Debug, Clone, PartialEq, Eq)]\n47\tpub struct MigrationPlan {\n48\t    pub source_rows: usize,\n49\t    pub already_migrated_rows: usize,\n50\t    pub destination_inserts: MigrationTableCounts,\n51\t    pub skipped_rows: Vec<SkippedRow>,\n52\t}\n53\t\n54\t#[derive(Debug, Clone, PartialEq, Eq)]\n55\tpub struct MigrationReport {\n56\t    pub dry_run: bool,\n57\t    pub source_rows: usize,\n58\t    pub migrated_rows: usize,\n59\t    pub already_migrated_rows: usize,\n60\t    pub destination_inserts: MigrationTableCounts,\n61\t    pub skipped_rows: Vec<SkippedRow>,\n62\t}\n63\t\n64\t#[derive(Debug, Error)]\n65\tpub enum MigrationError {\n66\t    #[error(\"legacy memory source is unreadable: {0}\")]\n67\t    SourceUnreadable(String),\n68\t    #[error(\"memory graph destination is not ready: {0}\")]\n69\t    DestinationUnready(String),\n70\t    #[error(\"legacy memory row {source_row_id} could not be mapped: {reason}\")]\n71\t    RowMappingFailed { source_row_id: i64, reason: String },\n72\t    #[error(\"constraint violation in {table}: {detail}\")]\n73\t    ConstraintViolation { table: &'static str, detail: String },\n74\t    #[error(\"migration idempotence conflict for source row {source_row_id}\")]\n75\t    IdempotenceConflict { source_row_id: i64 },\n76\t    #[error(\"failed to emit migration event: {0}\")]\n77\t    EventEmitFailed(#[from] EventWriteError),\n78\t}\n79\t\n80\tpub struct MemoryMigrator {\n81\t    pub source_conn: Arc<Mutex<Connection>>,\n82\t    pub dest_conn: Arc<Mutex<Connection>>,\n83\t    pub batch_size: usize,\n84\t    pub dry_run: bool,\n85\t}\n86\t\n87\timpl MemoryMigrator {\n88\t    pub fn new(\n89\t        source_conn: Arc<Mutex<Connection>>,\n90\t        dest_conn: Arc<Mutex<Connection>>,\n91\t        batch_size: usize,\n92\t        dry_run: bool,\n93\t    ) -> Self {\n94\t        Self {\n95\t            source_conn,\n96\t            dest_conn,\n97\t            batch_size: batch_size.max(1),\n98\t            dry_run,\n99\t        }\n100\t    }\n101\t\n102\t    pub fn plan(&self) -> Result<MigrationPlan, MigrationError> {\n103\t        self.prepare_destination()?;\n104\t        let already_migrated_rows = self.last_migrated_source_row_id()?.max(0) as usize;\n105\t        let mut counts = MigrationTableCounts::empty();\n106\t        let mut skipped_rows = Vec::new();\n107\t        let mut after_row_id = 0;\n108\t        loop {\n109\t            let rows = self.read_source_rows(after_row_id)?;\n110\t            if rows.is_empty() {\n111\t                break;\n112\t            }\n113\t            after_row_id = rows\n114\t                .last()\n115\t                .map(|row| row.source_row_id)\n116\t                .unwrap_or(after_row_id);\n117\t            for row in rows {\n118\t                if self.is_already_migrated(row.source_row_id)? {\n119\t                    continue;\n120\t                }\n121\t                match map_row(&row) {\n122\t                    Ok(mapped) => counts.add(&mapped),\n123\t                    Err(reason) => skipped_rows.push(SkippedRow {\n124\t                        source_row_id: row.source_row_id,\n125\t                        reason,\n126\t                    }),\n127\t                }\n128\t            }\n129\t        }\n130\t\n131\t        Ok(MigrationPlan {\n132\t            source_rows: self.count_source_rows()?,\n133\t            already_migrated_rows: already_migrated_rows.min(self.count_source_rows()?),\n134\t            destination_inserts: counts,\n135\t            skipped_rows,\n136\t        })\n137\t    }\n138\t\n139\t    pub fn run(&self, plan: &MigrationPlan) -> Result<MigrationReport, MigrationError> {\n140\t        self.prepare_destination()?;\n141\t        let mut report = MigrationReport {\n142\t            dry_run: self.dry_run,\n143\t            source_rows: plan.source_rows,\n144\t            migrated_rows: 0,\n145\t            already_migrated_rows: plan.already_migrated_rows,\n146\t            destination_inserts: MigrationTableCounts::empty(),\n147\t            skipped_rows: Vec::new(),\n148\t        };\n149\t        let mut after_row_id = self.last_migrated_source_row_id()?;\n150\t\n151\t        loop {\n152\t            let batch = self.read_source_rows(after_row_id)?;\n153\t            if batch.is_empty() {\n154\t                return Ok(report);\n155\t            }\n156\t            let _span = info_span!(\"memory_migration\", batch = batch.len()).entered();\n157\t            after_row_id = batch\n158\t                .last()\n159\t                .map(|row| row.source_row_id)\n160\t                .unwrap_or(after_row_id);\n161\t            self.run_batch(&batch, &mut report)?;\n162\t        }\n163\t    }\n164\t\n165\t    fn run_batch(\n166\t        &self,\n167\t        rows: &[LegacyMemoryRow],\n168\t        report: &mut MigrationReport,\n169\t    ) -> Result<(), MigrationError> {\n170\t        if self.dry_run {\n171\t            return self.validate_batch(rows, report);\n172\t        }\n173\t        let mut dest = self.lock_dest()?;\n174\t        let tx = dest\n175\t            .transaction()\n176\t            .map_err(|error| MigrationError::DestinationUnready(error.to_string()))?;\n177\t        tx.execute_batch(\"PRAGMA foreign_keys = ON\")\n178\t            .map_err(|error| MigrationError::DestinationUnready(error.to_string()))?;\n179\t        for row in rows {\n180\t            self.migrate_row(&tx, row, report)?;\n181\t        }\n182\t        tx.commit()\n183\t            .map_err(|error| MigrationError::DestinationUnready(error.to_string()))?;\n184\t        Ok(())\n185\t    }\n186\t\n187\t    fn migrate_row(\n188\t        &self,\n189\t        conn: &Connection,\n190\t        row: &LegacyMemoryRow,\n191\t        report: &mut MigrationReport,\n192\t    ) -> Result<(), MigrationError> {\n193\t        if self.is_migrated_in(conn, row.source_row_id)? {\n194\t            report.already_migrated_rows += 1;\n195\t            return Ok(());\n196\t        }\n197\t        match map_row(row) {\n198\t            Ok(mapped) => {\n199\t                ensure_no_conflict(conn, row.source_row_id, &mapped.memory_id)?;\n200\t                insert_mapped_row(conn, &mapped)?;\n201\t                mark_progress(conn, row.source_row_id, &mapped.memory_id)?;\n202\t                report.destination_inserts.add(&mapped);\n203\t                report.migrated_rows += 1;\n204\t            }\n205\t            Err(reason) => {\n206\t                warn!(\n207\t                    source_row_id = row.source_row_id,\n208\t                    mapping_guide = MIGRATION_GUIDE,\n209\t                    %reason,\n210\t                    \"legacy memory row skipped during migration\"\n211\t                );\n212\t                report.skipped_rows.push(SkippedRow {\n213\t                    source_row_id: row.source_row_id,\n214\t                    reason,\n215\t                });\n216\t                mark_skipped(conn, row.source_row_id)?;\n217\t            }\n218\t        }\n219\t        Ok(())\n220\t    }\n221\t\n222\t    fn validate_batch(\n223\t        &self,\n224\t        rows: &[LegacyMemoryRow],\n225\t        report: &mut MigrationReport,\n226\t    ) -> Result<(), MigrationError> {\n227\t        let mut validation = Connection::open_in_memory()\n228\t            .map_err(|error| MigrationError::DestinationUnready(error.to_string()))?;\n229\t        initialize_destination(&validation)?;\n230\t        let tx = validation\n231\t            .transaction()\n232\t            .map_err(|error| MigrationError::DestinationUnready(error.to_string()))?;\n233\t        for row in rows {\n234\t            match map_row(row) {\n235\t                Ok(mapped) => {\n236\t                    insert_mapped_row(&tx, &mapped)?;\n237\t                    report.destination_inserts.add(&mapped);\n238\t                    report.migrated_rows += 1;\n239\t                }\n240\t                Err(reason) => report.skipped_rows.push(SkippedRow {\n241\t                    source_row_id: row.source_row_id,\n242\t                    reason,\n243\t                }),\n244\t            }\n245\t        }\n246\t        Ok(())\n247\t    }\n248\t\n249\t    fn prepare_destination(&self) -> Result<(), MigrationError> {\n250\t        let dest = self.lock_dest()?;\n251\t        initialize_destination(&dest)\n252\t    }\n253\t\n254\t    fn count_source_rows(&self) -> Result<usize, MigrationError> {\n255\t        let source = self.lock_source()?;\n256\t        source\n257\t            .query_row(\"SELECT COUNT(*) FROM memories\", params![], |row| {\n258\t                row.get::<_, i64>(0)\n259\t            })\n260\t            .map(|count| count as usize)\n261\t            .map_err(|error| MigrationError::SourceUnreadable(error.to_string()))\n262\t    }\n263\t\n264\t    fn read_source_rows(&self, after_row_id: i64) -> Result<Vec<LegacyMemoryRow>, MigrationError> {\n265\t        let source = self.lock_source()?;\n266\t        let mut statement = source\n267\t            .prepare(LEGACY_SELECT_SQL)\n268\t            .map_err(|error| MigrationError::SourceUnreadable(error.to_string()))?;\n269\t        let rows = statement\n270\t            .query_map(\n271\t                params![after_row_id, self.batch_size as i64],\n272\t                LegacyMemoryRow::from_row,\n273\t            )\n274\t            .map_err(|error| MigrationError::SourceUnreadable(error.to_string()))?;\n275\t        rows.collect::<Result<Vec<_>, _>>()\n276\t            .map_err(|error| MigrationError::SourceUnreadable(error.to_string()))\n277\t    }\n278\t\n279\t    fn last_migrated_source_row_id(&self) -> Result<i64, MigrationError> {\n280\t        let dest = self.lock_dest()?;\n281\t        dest.query_row(\n282\t            \"SELECT COALESCE(MAX(source_row_id), 0) FROM migration_progress WHERE status = 'migrated'\",\n283\t            params![],\n284\t            |row| row.get(0),\n285\t        )\n286\t        .map_err(|error| MigrationError::DestinationUnready(error.to_string()))\n287\t    }\n288\t\n289\t    fn is_already_migrated(&self, source_row_id: i64) -> Result<bool, MigrationError> {\n290\t        let dest = self.lock_dest()?;\n291\t        self.is_migrated_in(&dest, source_row_id)\n292\t    }\n293\t\n294\t    fn is_migrated_in(\n295\t        &self,\n296\t        conn: &Connection,\n297\t        source_row_id: i64,\n298\t    ) -> Result<bool, MigrationError> {\n299\t        conn.query_row(\n300\t            \"SELECT 1 FROM migration_progress WHERE source_row_id = ?1 AND status = 'migrated'\",\n301\t            params![source_row_id],\n302\t            |_| Ok(()),\n303\t        )\n304\t        .optional()\n305\t        .map(|value| value.is_some())\n306\t        .map_err(|error| MigrationError::DestinationUnready(error.to_string()))\n307\t    }\n308\t\n309\t    fn lock_source(&self) -> Result<std::sync::MutexGuard<'_, Connection>, MigrationError> {\n310\t        self.source_conn\n311\t            .lock()\n312\t            .map_err(|_| MigrationError::SourceUnreadable(\"source connection lock poisoned\".into()))\n313\t    }\n314\t\n315\t    fn lock_dest(&self) -> Result<std::sync::MutexGuard<'_, Connection>, MigrationError> {\n316\t        self.dest_conn.lock().map_err(|_| {\n317\t            MigrationError::DestinationUnready(\"destination connection lock poisoned\".into())\n318\t        })\n319\t    }\n320\t}\n321\t\n322\timpl MigrationTableCounts {\n323\t    fn add(&mut self, row: &MappedMemoryRow) {\n324\t        self.memories += 1;\n325\t        self.memory_links += row.links.len();\n326\t        self.memory_evidence += row.evidence.len();\n327\t        self.memory_accesses += row.accesses.len();\n328\t        self.memory_scores += row.scores.len();\n329\t    }\n330\t}\n331\t\n332\t#[derive(Clone, Debug)]\n333\tpub(super) struct LegacyMemoryRow {\n334\t    pub(super) source_row_id: i64,\n335\t    pub(super) id: String,\n336\t    pub(super) session_id: String,\n337\t    pub(super) content: String,\n338\t    pub(super) memory_type: String,\n339\t    pub(super) scope: String,\n340\t    pub(super) confidence: f64,\n341\t    pub(super) linked_symbols: String,\n342\t    pub(super) linked_files: String,\n343\t    pub(super) workspace_id: Option<String>,\n344\t    pub(super) branch: Option<String>,\n345\t    pub(super) _refresh_key: Option<String>,\n346\t    pub(super) source_query: Option<String>,\n347\t    pub(super) assertion_type: String,\n348\t    pub(super) verification_status: String,\n349\t    pub(super) confidence_reason: Opt