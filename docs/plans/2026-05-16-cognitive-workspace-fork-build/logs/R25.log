{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015KbQXauAhunrHMQDsmC7Wc","type":"tool_result","content":"1\tuse std::sync::{Arc, Mutex};\n2\t\n3\tuse rusqlite::{params, Connection};\n4\t\n5\tuse super::{MemoryMigrator, MigrationError};\n6\t\n7\tfn legacy_conn() -> Connection {\n8\t    let conn = Connection::open_in_memory().expect(\"source connection\");\n9\t    conn.execute_batch(\n10\t        \"CREATE TABLE memories (\n11\t            id TEXT PRIMARY KEY,\n12\t            session_id TEXT NOT NULL DEFAULT '',\n13\t            content TEXT NOT NULL,\n14\t            memory_type TEXT NOT NULL,\n15\t            scope TEXT NOT NULL DEFAULT 'session',\n16\t            confidence REAL NOT NULL DEFAULT 1.0,\n17\t            linked_symbols TEXT NOT NULL DEFAULT '[]',\n18\t            linked_files TEXT NOT NULL DEFAULT '[]',\n19\t            workspace_id TEXT,\n20\t            branch TEXT,\n21\t            refresh_key TEXT,\n22\t            source_query TEXT,\n23\t            assertion_type TEXT NOT NULL DEFAULT 'observation',\n24\t            verification_status TEXT NOT NULL DEFAULT 'unverified',\n25\t            confidence_reason TEXT,\n26\t            supersedes_memory_id TEXT,\n27\t            superseded_by_memory_id TEXT,\n28\t            contradicts_memory_ids TEXT NOT NULL DEFAULT '[]',\n29\t            contradicted_by_memory_ids TEXT NOT NULL DEFAULT '[]',\n30\t            freshness_policy TEXT NOT NULL DEFAULT 'session_scoped',\n31\t            freshness_policy_detail TEXT,\n32\t            provenance_json TEXT NOT NULL DEFAULT '[]',\n33\t            evidence_json TEXT NOT NULL DEFAULT '[]',\n34\t            created_at INTEGER NOT NULL,\n35\t            last_accessed INTEGER NOT NULL,\n36\t            access_count INTEGER NOT NULL DEFAULT 0,\n37\t            is_stale INTEGER NOT NULL DEFAULT 0,\n38\t            stale_reason TEXT,\n39\t            is_invalidated INTEGER NOT NULL DEFAULT 0\n40\t        );\",\n41\t    )\n42\t    .expect(\"legacy schema\");\n43\t    conn\n44\t}\n45\t\n46\tfn dest_conn() -> Connection {\n47\t    Connection::open_in_memory().expect(\"destination connection\")\n48\t}\n49\t\n50\tfn migrator(source: Connection, dest: Connection, dry_run: bool) -> MemoryMigrator {\n51\t    MemoryMigrator::new(\n52\t        Arc::new(Mutex::new(source)),\n53\t        Arc::new(Mutex::new(dest)),\n54\t        3,\n55\t        dry_run,\n56\t    )\n57\t}\n58\t\n59\t#[test]\n60\tfn empty_source_migrates_to_empty_destination() {\n61\t    let migrator = migrator(legacy_conn(), dest_conn(), false);\n62\t    let plan = migrator.plan().expect(\"plan\");\n63\t    let report = migrator.run(&plan).expect(\"run\");\n64\t\n65\t    assert_eq!(plan.source_rows, 0);\n66\t    assert_eq!(report.migrated_rows, 0);\n67\t    assert_table_count(&migrator, \"memories\", 0);\n68\t}\n69\t\n70\t#[test]\n71\tfn curated_legacy_rows_migrate_exactly_once() {\n72\t    let source = legacy_conn();\n73\t    insert_row(&source, \"obs\", \"observation\", \"observation\", \"session\");\n74\t    insert_row(&source, \"decision\", \"decision\", \"decision\", \"repo\");\n75\t    insert_row(&source, \"pattern\", \"pattern\", \"pattern\", \"branch\");\n76\t    insert_rich_row(&source);\n77\t    let migrator = migrator(source, dest_conn(), false);\n78\t\n79\t    let plan = migrator.plan().expect(\"plan\");\n80\t    let report = migrator.run(&plan).expect(\"run\");\n81\t\n82\t    assert_eq!(plan.source_rows, 4);\n83\t    assert_eq!(report.migrated_rows, 4);\n84\t    assert_eq!(report.destination_inserts.memories, 4);\n85\t    assert_eq!(\n86\t        report.destination_inserts.memory_links,\n87\t        plan.destination_inserts.memory_links\n88\t    );\n89\t    assert_table_count(&migrator, \"memories\", 4);\n90\t    assert_table_count(&migrator, \"memory_evidence\", 1);\n91\t    assert_table_count(&migrator, \"memory_accesses\", 1);\n92\t    assert_table_count(&migrator, \"memory_scores\", 4);\n93\t}\n94\t\n95\t#[test]\n96\tfn second_run_after_success_is_noop() {\n97\t    let source = legacy_conn();\n98\t    insert_row(&source, \"obs\", \"observation\", \"observation\", \"session\");\n99\t    let migrator = migrator(source, dest_conn(), false);\n100\t    let first_plan = migrator.plan().expect(\"first plan\");\n101\t    let first_report = migrator.run(&first_plan).expect(\"first run\");\n102\t    let second_plan = migrator.plan().expect(\"second plan\");\n103\t    let second_report = migrator.run(&second_plan).expect(\"second run\");\n104\t\n105\t    assert_eq!(first_report.migrated_rows, 1);\n106\t    assert_eq!(second_report.migrated_rows, 0);\n107\t    assert_table_count(&migrator, \"memories\", 1);\n108\t}\n109\t\n110\t#[test]\n111\tfn failed_batch_rolls_back_and_follow_up_run_completes() {\n112\t    let source = legacy_conn();\n113\t    insert_row(&source, \"obs\", \"observation\", \"observation\", \"session\");\n114\t    insert_row(&source, \"conflict\", \"decision\", \"decision\", \"repo\");\n115\t    let dest = dest_conn();\n116\t    super::initialize_schema(&dest).expect(\"schema\");\n117\t    dest.execute(\n118\t        \"INSERT INTO memories\n119\t            (memory_id, content, class, assertion_type, scope, scope_workspace_id,\n120\t             verification_status, confidence, confidence_reason, freshness_policy_json,\n121\t             validity_conditions_json, invalidation_triggers_json, provenance_event_ids_json,\n122\t             evidence_references_json, linked_files_json, linked_symbols_json, linked_docs_json,\n123\t             linked_tests_json, linked_memories_json, contradiction_links_json,\n124\t             supersession_links_json, access_history_json, usefulness_score,\n125\t             usefulness_score_updated_at, created_at, created_by, updated_at, updated_by,\n126\t             schema_version)\n127\t         VALUES\n128\t            ('memory:ws/conflict', 'preexisting', 'decision', 'decision', 'repo', 'ws',\n129\t             'unverified', 1.0, 'preexisting', '{}', '[]', '[]', '[]', '[]', '[]', '[]',\n130\t             '[]', '[]', '[]', '[]', '[]', '[]', 0.0, 1, 1, 'test', 1, 'test', 1)\",\n131\t        params![],\n132\t    )\n133\t    .expect(\"conflict row\");\n134\t    let migrator = migrator(source, dest, false);\n135\t    let plan = migrator.plan().expect(\"plan\");\n136\t\n137\t    let error = migrator.run(&plan).expect_err(\"conflict\");\n138\t    assert!(matches!(error, MigrationError::IdempotenceConflict { .. }));\n139\t    assert_table_count(&migrator, \"memories\", 1);\n140\t\n141\t    delete_conflict(&migrator);\n142\t    let retry_plan = migrator.plan().expect(\"retry plan\");\n143\t    let retry_report = migrator.run(&retry_plan).expect(\"retry run\");\n144\t    assert_eq!(retry_report.migrated_rows, 2);\n145\t    assert_table_count(&migrator, \"memories\", 2);\n146\t}\n147\t\n148\t#[test]\n149\tfn dry_run_matches_real_report_but_writes_nothing() {\n150\t    let dry_source = legacy_conn();\n151\t    insert_rich_row(&dry_source);\n152\t    let real_source = legacy_conn();\n153\t    insert_rich_row(&real_source);\n154\t    let dry = migrator(dry_source, dest_conn(), true);\n155\t    let real = migrator(real_source, dest_conn(), false);\n156\t\n157\t    let dry_plan = dry.plan().expect(\"dry plan\");\n158\t    let dry_report = dry.run(&dry_plan).expect(\"dry run\");\n159\t    let real_plan = real.plan().expect(\"real plan\");\n160\t    let real_report = real.run(&real_plan).expect(\"real run\");\n161\t\n162\t    assert_eq!(dry_report.migrated_rows, real_report.migrated_rows);\n163\t    assert_eq!(\n164\t        dry_report.destination_inserts,\n165\t        real_report.destination_inserts\n166\t    );\n167\t    assert_table_count(&dry, \"memories\", 0);\n168\t    assert_table_count(&real, \"memories\", 1);\n169\t}\n170\t\n171\t#[test]\n172\tfn unmappable_rows_are_reported_and_do_not_halt_migration() {\n173\t    let source = legacy_conn();\n174\t    insert_bad_row(&source);\n175\t    insert_row(&source, \"obs\", \"observation\", \"observation\", \"session\");\n176\t    let migrator = migrator(source, dest_conn(), false);\n177\t    let plan = migrator.plan().expect(\"plan\");\n178\t    let report = migrator.run(&plan).expect(\"run\");\n179\t\n180\t    assert_eq!(plan.skipped_rows.len(), 1);\n181\t    assert_eq!(report.skipped_rows.len(), 1);\n182\t    assert_eq!(report.migrated_rows, 1);\n183\t    assert_table_count(&migrator, \"memories\", 1);\n184\t}\n185\t\n186\tfn insert_row(conn: &Connection, id: &str, memory_type: &str, assertion: &str, scope: &str) {\n187\t    insert_memory(conn, id, memory_type, assertion, scope, \"[]\", \"[]\", 0);\n188\t}\n189\t\n190\tfn insert_rich_row(conn: &Connection) {\n191\t    insert_memory(\n192\t        conn,\n193\t        \"rich\",\n194\t        \"anti_pattern\",\n195\t        \"anti_pattern\",\n196\t        \"branch\",\n197\t        r#\"[\"src/lib.rs\"]\"#,\n198\t        r#\"[\"important_symbol\"]\"#,\n199\t        2,\n200\t    );\n201\t    conn.execute(\n202\t        \"UPDATE memories\n203\t         SET evidence_json = ?2, contradicts_memory_ids = ?3, supersedes_memory_id = ?4\n204\t         WHERE id = ?1\",\n205\t        params![\n206\t            \"rich\",\n207\t            r#\"[{\"kind\":\"note\",\"reference\":\"test\",\"captured_at\":12}]\"#,\n208\t            r#\"[\"obs\"]\"#,\n209\t            \"decision\"\n210\t        ],\n211\t    )\n212\t    .expect(\"rich metadata\");\n213\t}\n214\t\n215\tfn insert_bad_row(conn: &Connection) {\n216\t    insert_memory(\n217\t        conn,\n218\t        \"bad\",\n219\t        \"unknown_type\",\n220\t        \"unknown\",\n221\t        \"session\",\n222\t        \"[]\",\n223\t        \"[]\",\n224\t        0,\n225\t    );\n226\t}\n227\t\n228\tfn insert_memory(\n229\t    conn: &Connection,\n230\t    id: &str,\n231\t    memory_type: &str,\n232\t    assertion: &str,\n233\t    scope: &str,\n234\t    linked_files: &str,\n235\t    linked_symbols: &str,\n236\t    access_count: i64,\n237\t) {\n238\t    conn.execute(\n239\t        \"INSERT INTO memories\n240\t            (id, session_id, content, memory_type, scope, confidence, linked_symbols,\n241\t             linked_files, workspace_id, branch, refresh_key, source_query, assertion_type,\n242\t             verification_status, confidence_reason, supersedes_memory_id,\n243\t             superseded_by_memory_id, contradicts_memory_ids, contradicted_by_memory_ids,\n244\t             freshness_policy, freshness_policy_detail, provenance_json, evidence_json,\n245\t             created_at, last_accessed, access_count, is_stale, stale_reason, is_invalidated)\n246\t         VALUES\n247\t            (?1, 'session-a', ?2, ?3, ?4, 0.8, ?5, ?6, 'ws', 'main', NULL,\n248\t             'source query', ?7, 'unverified', NULL, NULL, NULL, '[]', '[]',\n249\t             'session_scoped', NULL, '[]', '[]', 10, 20, ?8, 0, NULL, 0)\",\n250\t        params![\n251\t            id,\n252\t            format!(\"content for {id}\"),\n253\t            memory_type,\n254\t            scope,\n255\t            linked_symbols,\n256\t            linked_files,\n257\t            assertion,\n258\t            access_count,\n259\t        ],\n260\t    )\n261\t    .expect(\"insert legacy row\");\n262\t}\n263\t\n264\tfn assert_table_count(migrator: &MemoryMigrator, table: &str, expected: i64) {\n265\t    let dest = migrator.dest_conn.lock().expect(\"dest lock\");\n266\t    let sql = format!(\"SELECT COUNT(*) FROM {table}\");\n267\t    let count: i64 = dest\n268\t        .query_row(&sql, params![], |row| row.get(0))\n269\t        .expect(\"count\");\n270\t    assert_eq!(count, expected, \"{table}\");\n271\t}\n272\t\n273\tfn delete_conflict(migrator: &MemoryMigrator) {\n274\t    let dest = migrator.dest_conn.lock().expect(\"dest lock\");\n275\t    dest.execute(\n276\t        \"DELETE FROM memories WHERE memory_id = 'memory:ws/conflict'\",\n277\t        params![],\n278\t    )\n279\t    .expect(\"delete conflict\");\n280\t}\n281\t"}]},"parent_tool_use_id":null,"session_id":"6c80d671-1437-429b-9e3a-231a1f740b4b","uuid":"278d390b-eec9-4797-a9d8-cc3e43c85042","timestamp":"2026-05-17T07:20:29.568Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/memory_graph/migration_tests.rs","content":"use std::sync::{Arc, Mutex};\n\nuse rusqlite::{params, Connection};\n\nuse super::{MemoryMigrator, MigrationError};\n\nfn legacy_conn() -> Connection {\n    let conn = Connection::open_in_memory().expect(\"source connection\");\n    conn.execute_batch(\n        \"CREATE TABLE memories (\n            id TEXT PRIMARY KEY,\n            session_id TEXT NOT NULL DEFAULT '',\n            content TEXT NOT NULL,\n            memory_type TEXT NOT NULL,\n            scope TEXT NOT NULL DEFAULT 'session',\n            confidence REAL NOT NULL DEFAULT 1.0,\n            linked_symbols TEXT NOT NULL DEFAULT '[]',\n            linked_files TEXT NOT NULL DEFAULT '[]',\n            workspace_id TEXT,\n            branch TEXT,\n            refresh_key TEXT,\n            source_query TEXT,\n            assertion_type TEXT NOT NULL DEFAULT 'observation',\n            verification_status TEXT NOT NULL DEFAULT 'unverified',\n            confidence_reason TEXT,\n            supersedes_memory_id TEXT,\n            superseded_by_memory_id TEXT,\n            contradicts_memory_ids TEXT NOT NULL DEFAULT '[]',\n            contradicted_by_memory_ids TEXT NOT NULL DEFAULT '[]',\n            freshness_policy TEXT NOT NULL DEFAULT 'session_scoped',\n            freshness_policy_detail TEXT,\n            provenance_json TEXT NOT NULL DEFAULT '[]',\n            evidence_json TEXT NOT NULL DEFAULT '[]',\n            created_at INTEGER NOT NULL,\n            last_accessed INTEGER NOT NULL,\n            access_count INTEGER NOT NULL DEFAULT 0,\n            is_stale INTEGER NOT NULL DEFAULT 0,\n            stale_reason TEXT,\n            is_invalidated INTEGER NOT NULL DEFAULT 0\n        );\",\n    )\n    .expect(\"legacy schema\");\n    conn\n}\n\nfn dest_conn() -> Connection {\n    Connection::open_in_memory().expect(\"destination connection\")\n}\n\nfn migrator(source: Connection, dest: Connection, dry_run: bool) -> MemoryMigrator {\n    MemoryMigrator::new(\n        Arc::new(Mutex::new(source)),\n        Arc::new(Mutex::new(dest)),\n        3,\n        dry_run,\n    )\n}\n\n#[test]\nfn empty_source_migrates_to_empty_destination() {\n    let migrator = migrator(legacy_conn(), dest_conn(), false);\n    let plan = migrator.plan().expect(\"plan\");\n    let report = migrator.run(&plan).expect(\"run\");\n\n    assert_eq!(plan.source_rows, 0);\n    assert_eq!(report.migrated_rows, 0);\n    assert_table_count(&migrator, \"memories\", 0);\n}\n\n#[test]\nfn curated_legacy_rows_migrate_exactly_once() {\n    let source = legacy_conn();\n    insert_row(&source, \"obs\", \"observation\", \"observation\", \"session\");\n    insert_row(&source, \"decision\", \"decision\", \"decision\", \"repo\");\n    insert_row(&source, \"pattern\", \"pattern\", \"pattern\", \"branch\");\n    insert_rich_row(&source);\n    let migrator = migrator(source, dest_conn(), false);\n\n    let plan = migrator.plan().expect(\"plan\");\n    let report = migrator.run(&plan).expect(\"run\");\n\n    assert_eq!(plan.source_rows, 4);\n    assert_eq!(report.migrated_rows, 4);\n    assert_eq!(report.destination_inserts.memories, 4);\n    assert_eq!(\n        report.destination_inserts.memory_links,\n        plan.destination_inserts.memory_links\n    );\n    assert_table_count(&migrator, \"memories\", 4);\n    assert_table_count(&migrator, \"memory_evidence\", 1);\n    assert_table_count(&migrator, \"memory_accesses\", 1);\n    assert_table_count(&migrator, \"memory_scores\", 4);\n}\n\n#[test]\nfn second_run_after_success_is_noop() {\n    let source = legacy_conn();\n    insert_row(&source, \"obs\", \"observation\", \"observation\", \"session\");\n    let migrator = migrator(source, dest_conn(), false);\n    let first_plan = migrator.plan().expect(\"first plan\");\n    let first_report = migrator.run(&first_plan).expect(\"first run\");\n    let second_plan = migrator.plan().expect(\"second plan\");\n    let second_report = migrator.run(&second_plan).expect(\"second run\");\n\n    assert_eq!(first_report.migrated_rows, 1);\n    assert_eq!(second_report.migrated_rows, 0);\n    assert_table_count(&migrator, \"memories\", 1);\n}\n\n#[test]\nfn failed_batch_rolls_back_and_follow_up_run_completes() {\n    let source = legacy_conn();\n    insert_row(&source, \"obs\", \"observation\", \"observation\", \"session\");\n    insert_row(&source, \"conflict\", \"decision\", \"decision\", \"repo\");\n    let dest = dest_conn();\n    super::initialize_schema(&dest).expect(\"schema\");\n    dest.execute(\n        \"INSERT INTO memories\n            (memory_id, content, class, assertion_type, scope, scope_workspace_id,\n             verification_status, confidence, confidence_reason, freshness_policy_json,\n             validity_conditions_json, invalidation_triggers_json, provenance_event_ids_json,\n             evidence_references_json, linked_files_json, linked_symbols_json, linked_docs_json,\n             linked_tests_json, linked_memories_json, contradiction_links_json,\n             supersession_links_json, access_history_json, usefulness_score,\n             usefulness_score_updated_at, created_at, created_by, updated_at, updated_by,\n             schema_version)\n         VALUES\n            ('memory:ws/conflict', 'preexisting', 'decision', 'decision', 'repo', 'ws',\n             'unverified', 1.0, 'preexisting', '{}', '[]', '[]', '[]', '[]', '[]', '[]',\n             '[]', '[]', '[]', '[]', '[]', '[]', 0.0, 1, 1, 'test', 1, 'test', 1)\",\n        params![],\n    )\n    .expect(\"conflict row\");\n    let migrator = migrator(source, dest, false);\n    let plan = migrator.plan().expect(\"plan\");\n\n    let error = migrator.run(&plan).expect_err(\"conflict\");\n    assert!(matches!(error, MigrationError::IdempotenceConflict { .. }));\n    assert_table_count(&migrator, \"memories\", 1);\n\n    delete_conflict(&migrator);\n    let retry_plan = migrator.plan().expect(\"retry plan\");\n    let retry_report = migrator.run(&retry_plan).expect(\"retry run\");\n    assert_eq!(retry_report.migrated_rows, 2);\n    assert_table_count(&migrator, \"memories\", 2);\n}\n\n#[test]\nfn dry_run_matches_real_report_but_writes_nothing() {\n    let dry_source = legacy_conn();\n    insert_rich_row(&dry_source);\n    let real_source = legacy_conn();\n    insert_rich_row(&real_source);\n    let dry = migrator(dry_source, dest_conn(), true);\n    let real = migrator(real_source, dest_conn(), false);\n\n    let dry_plan = dry.plan().expect(\"dry plan\");\n    let dry_report = dry.run(&dry_plan).expect(\"dry run\");\n    let real_plan = real.plan().expect(\"real plan\");\n    let real_report = real.run(&real_plan).expect(\"real run\");\n\n    assert_eq!(dry_report.migrated_rows, real_report.migrated_rows);\n    assert_eq!(\n        dry_report.destination_inserts,\n        real_report.destination_inserts\n    );\n    assert_table_count(&dry, \"memories\", 0);\n    assert_table_count(&real, \"memories\", 1);\n}\n\n#[test]\nfn unmappable_rows_are_reported_and_do_not_halt_migration() {\n    let source = legacy_conn();\n    insert_bad_row(&source);\n    insert_row(&source, \"obs\", \"observation\", \"observation\", \"session\");\n    let migrator = migrator(source, dest_conn(), false);\n    let plan = migrator.plan().expect(\"plan\");\n    let report = migrator.run(&plan).expect(\"run\");\n\n    assert_eq!(plan.skipped_rows.len(), 1);\n    assert_eq!(report.skipped_rows.len(), 1);\n    assert_eq!(report.migrated_rows, 1);\n    assert_table_count(&migrator, \"memories\", 1);\n}\n\nfn insert_row(conn: &Connection, id: &str, memory_type: &str, assertion: &str, scope: &str) {\n    insert_memory(conn, id, memory_type, assertion, scope, \"[]\", \"[]\", 0);\n}\n\nfn insert_rich_row(conn: &Connection) {\n    insert_memory(\n        conn,\n        \"rich\",\n        \"anti_pattern\",\n        \"anti_pattern\",\n        \"branch\",\n        r#\"[\"src/lib.rs\"]\"#,\n        r#\"[\"important_symbol\"]\"#,\n        2,\n    );\n    conn.execute(\n        \"UPDATE memories\n         SET evidence_json = ?2, contradicts_memory_ids = ?3, supersedes_memory_id = ?4\n         WHERE id = ?1\",\n        params![\n            \"rich\",\n            r#\"[{\"kind\":\"note\",\"reference\":\"test\",\"captured_at\":12}]\"#,\n            r#\"[\"obs\"]\"#,\n            \"decision\"\n        ],\n    )\n    .expect(\"rich metadata\");\n}\n\nfn insert_bad_row(conn: &Connection) {\n    insert_memory(\n        conn,\n        \"bad\",\n        \"unknown_type\",\n        \"unknown\",\n        \"session\",\n        \"[]\",\n        \"[]\",\n        0,\n    );\n}\n\nfn insert_memory(\n    conn: &Connection,\n    id: &str,\n    memory_type: &str,\n    assertion: &str,\n    scope: &str,\n    linked_files: &str,\n    linked_symbols: &str,\n    access_count: i64,\n) {\n    conn.execute(\n        \"INSERT INTO memories\n            (id, session_id, content, memory_type, scope, confidence, linked_symbols,\n             linked_files, workspace_id, branch, refresh_key, source_query, assertion_type,\n             verification_status, confidence_reason, supersedes_memory_id,\n             superseded_by_memory_id, contradicts_memory_ids, contradicted_by_memory_ids,\n             freshness_policy, freshness_policy_detail, provenance_json, evidence_json,\n             created_at, last_accessed, access_count, is_stale, stale_reason, is_invalidated)\n         VALUES\n            (?1, 'session-a', ?2, ?3, ?4, 0.8, ?5, ?6, 'ws', 'main', NULL,\n             'source query', ?7, 'unverified', NULL, NULL, NULL, '[]', '[]',\n             'session_scoped', NULL, '[]', '[]', 10, 20, ?8, 0, NULL, 0)\",\n        params![\n            id,\n            format!(\"content for {id}\"),\n            memory_type,\n            scope,\n            linked_symbols,\n            linked_files,\n            assertion,\n            access_count,\n        ],\n    )\n    .expect(\"insert legacy row\");\n}\n\nfn assert_table_count(migrator: &MemoryMigrator, table: &str, expected: i64) {\n    let dest = migrator.dest_conn.lock().expect(\"dest lock\");\n    let sql = format!(\"SELECT COUNT(*) FROM {table}\");\n    let count: i64 = dest\n        .query_row(&sql, params![], |row| row.get(0))\n        .expect(\"count\");\n    assert_eq!(count, expected, \"{table}\");\n}\n\nfn delete_conflict(migrator: &MemoryMigrator) {\n    let dest = migrator.dest_conn.lock().expect(\"dest lock\");\n    dest.execute(\n        \"DELETE FROM memories WHERE memory_id = 'memory:ws/conflict'\",\n        params![],\n    )\n    .expect(\"delete conflict\");\n}\n","numLines":281,"startLine":1,"totalLines":281}}}
