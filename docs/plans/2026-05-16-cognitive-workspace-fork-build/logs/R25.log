{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CM4d2rNRjms5a9EUPegYEL","type":"tool_result","content":"1\tuse std::fmt;\n2\t\n3\tuse chrono::Utc;\n4\tuse rusqlite::Connection;\n5\t\n6\tuse crate::events::{EventQuery, EventReader, QueryOrder};\n7\tuse crate::memory_graph::replay_events;\n8\tuse crate::memory_graph::tests_common::{idem, memory_evidence, stable_ulid, TestHarness};\n9\tuse crate::memory_graph::{\n10\t    get_links_to, initialize_schema, insert_link, transition_status, AssertionType, MemoryClass,\n11\t    MemoryLink, MemoryLinkId, MemoryLinkReference, MemoryLinkTarget, MemoryLinkType,\n12\t    VerificationStatus,\n13\t};\n14\t\n15\t#[test]\n16\tfn supersedes_transitions_prior_memory_to_superseded_and_sets_successor() {\n17\t    let harness = TestHarness::new();\n18\t    let prior = verified_memory(&harness, \"prior\");\n19\t    let replacement = created_memory(&harness, \"replacement\");\n20\t\n21\t    apply_supersedes(&harness, &replacement, &prior, \"prior-replacement\")\n22\t        .expect(\"supersedes applies\");\n23\t\n24\t    let loaded = harness\n25\t        .store\n26\t        .get(&prior.memory_id, &harness.branch_scope())\n27\t        .expect(\"prior reloads\");\n28\t    assert_eq!(loaded.verification_status, VerificationStatus::Superseded);\n29\t    assert_eq!(loaded.superseded_by, Some(replacement.memory_id));\n30\t}\n31\t\n32\t#[test]\n33\tfn supersession_chain_is_traversable_and_cycles_are_rejected() {\n34\t    let harness = TestHarness::new();\n35\t    let a = verified_memory(&harness, \"a\");\n36\t    let b = verified_memory(&harness, \"b\");\n37\t    let c = verified_memory(&harness, \"c\");\n38\t\n39\t    apply_supersedes(&harness, &b, &a, \"b-a\").expect(\"b supersedes a\");\n40\t    apply_supersedes(&harness, &c, &b, \"c-b\").expect(\"c supersedes b\");\n41\t\n42\t    assert_eq!(\n43\t        current_claim(&harness.conn(), &a.memory_id).expect(\"current claim resolves\"),\n44\t        c.memory_id\n45\t    );\n46\t    assert_eq!(\n47\t        get_links_to(\n48\t            &harness.conn(),\n49\t            &MemoryLinkTarget::Memory(a.memory_id.clone())\n50\t        )\n51\t        .unwrap()\n52\t        .len(),\n53\t        1\n54\t    );\n55\t    let error = apply_supersedes(&harness, &a, &c, \"a-c\").expect_err(\"cycle rejects\");\n56\t    assert!(matches!(\n57\t        error,\n58\t        SupersessionApplyError::CycleDetected { .. }\n59\t    ));\n60\t}\n61\t\n62\t#[test]\n63\tfn current_claim_walks_to_latest_successor_and_historical_lookup_preserves_prior_state() {\n64\t    let harness = TestHarness::new();\n65\t    let a = verified_memory(&harness, \"historical-a\");\n66\t    let historical_before = harness\n67\t        .store\n68\t        .get(&a.memory_id, &harness.branch_scope())\n69\t        .expect(\"a loads before supersession\");\n70\t    let b = verified_memory(&harness, \"historical-b\");\n71\t    let c = verified_memory(&harness, \"historical-c\");\n72\t\n73\t    let events_before = all_memory_events(&harness);\n74\t    apply_supersedes(&harness, &b, &a, \"historical-b-a\").expect(\"b supersedes a\");\n75\t    apply_supersedes(&harness, &c, &b, \"historical-c-b\").expect(\"c supersedes b\");\n76\t\n77\t    assert_eq!(\n78\t        current_claim(&harness.conn(), &a.memory_id).expect(\"current claim resolves\"),\n79\t        c.memory_id\n80\t    );\n81\t\n82\t    let historical_db = Connection::open_in_memory().expect(\"historical DB opens\");\n83\t    historical_db\n84\t        .execute_batch(\"PRAGMA foreign_keys = ON;\")\n85\t        .expect(\"foreign keys enable\");\n86\t    initialize_schema(&historical_db).expect(\"schema initializes\");\n87\t    replay_events(&historical_db, &events_before).expect(\"historical replay succeeds\");\n88\t    let restored = historical_db\n89\t        .query_row(\n90\t            \"SELECT verification_status, superseded_by FROM memories WHERE memory_id = ?1\",\n91\t            rusqlite::params![crate::identity::encode_identity(\n92\t                &crate::identity::Identity::Memory(a.memory_id.clone())\n93\t            )],\n94\t            |row| Ok((row.get::<_, String>(0)?, row.get::<_, Option<String>>(1)?)),\n95\t        )\n96\t        .expect(\"historical row loads\");\n97\t\n98\t    assert_eq!(restored.0, historical_before.verification_status.as_str());\n99\t    assert!(restored.1.is_none());\n100\t}\n101\t\n102\t#[derive(Debug)]\n103\tenum SupersessionApplyError {\n104\t    CycleDetected { source: String, target: String },\n105\t    Link(crate::memory_graph::MemoryLinkError),\n106\t    Transition(crate::memory_graph::MemoryTransitionError),\n107\t    Store(crate::memory_graph::MemoryStoreError),\n108\t}\n109\t\n110\timpl fmt::Display for SupersessionApplyError {\n111\t    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n112\t        match self {\n113\t            Self::CycleDetected { source, target } => {\n114\t                write!(\n115\t                    formatter,\n116\t                    \"supersession cycle `{source}` -> `{target}` is not allowed\"\n117\t                )\n118\t            }\n119\t            Self::Link(error) => error.fmt(formatter),\n120\t            Self::Transition(error) => error.fmt(formatter),\n121\t            Self::Store(error) => error.fmt(formatter),\n122\t        }\n123\t    }\n124\t}\n125\t\n126\timpl std::error::Error for SupersessionApplyError {}\n127\t\n128\tfn apply_supersedes(\n129\t    harness: &TestHarness,\n130\t    source: &crate::memory_graph::MemoryRecord,\n131\t    target: &crate::memory_graph::MemoryRecord,\n132\t    seed: &str,\n133\t) -> Result<(), SupersessionApplyError> {\n134\t    if current_claim(&harness.conn(), &source.memory_id).map_err(SupersessionApplyError::Store)?\n135\t        == target.memory_id\n136\t    {\n137\t        return Err(SupersessionApplyError::CycleDetected {\n138\t            source: source.memory_id.to_string(),\n139\t            target: target.memory_id.to_string(),\n140\t        });\n141\t    }\n142\t\n143\t    let link = MemoryLink::try_new(\n144\t        MemoryLinkId(format!(\"supersedes-{}\", stable_ulid(seed))),\n145\t        source.memory_id.clone(),\n146\t        MemoryLinkTarget::Memory(target.memory_id.clone()),\n147\t        MemoryLinkType::Supersedes,\n148\t        0.95,\n149\t        \"newer memory supersedes prior claim\".to_string(),\n150\t        None,\n151\t        crate::events::Actor::Assistant {\n152\t            model: \"gpt-test\".to_string(),\n153\t        },\n154\t        Utc::now(),\n155\t        VerificationStatus::Verified,\n156\t    )\n157\t    .map_err(SupersessionApplyError::Link)?;\n158\t    insert_link(&harness.conn(), &link).map_err(SupersessionApplyError::Link)?;\n159\t\n160\t    let source_loaded = harness\n161\t        .store\n162\t        .get(&source.memory_id, &harness.branch_scope())\n163\t        .map_err(SupersessionApplyError::Store)?;\n164\t    harness\n165\t        .store\n166\t        .write_transition(\n167\t            &source_loaded,\n168\t            source_loaded.clone(),\n169\t            \"supersession link inserted\",\n170\t            Some(memory_evidence(&format!(\"source-{seed}\"))),\n171\t        )\n172\t        .map_err(SupersessionApplyError::Store)?;\n173\t\n174\t    let mut target_loaded = harness\n175\t        .store\n176\t        .get(&target.memory_id, &harness.branch_scope())\n177\t        .map_err(SupersessionApplyError::Store)?;\n178\t    target_loaded.supersession_links.push(MemoryLinkReference {\n179\t        memory_id: source.memory_id.clone(),\n180\t        reason: \"replacement memory\".to_string(),\n181\t    });\n182\t    target_loaded.superseded_by = Some(source.memory_id.clone());\n183\t    harness\n184\t        .store\n185\t        .write_transition(\n186\t            target,\n187\t            target_loaded,\n188\t            \"newer memory superseded prior claim\",\n189\t            Some(memory_evidence(&format!(\"target-{seed}\"))),\n190\t        )\n191\t        .map_err(SupersessionApplyError::Store)?;\n192\t    let _ = transition_status(\n193\t        &harness.store,\n194\t        target.memory_id.clone(),\n195\t        VerificationStatus::Superseded,\n196\t        \"newer memory superseded prior claim\",\n197\t        Some(memory_evidence(&format!(\"status-{seed}\"))),\n198\t    )\n199\t    .map_err(SupersessionApplyError::Transition)?;\n200\t    Ok(())\n201\t}\n202\t\n203\tfn current_claim(\n204\t    conn: &Connection,\n205\t    start: &crate::identity::MemoryId,\n206\t) -> Result<crate::identity::MemoryId, crate::memory_graph::MemoryStoreError> {\n207\t    let mut current = start.clone();\n208\t    loop {\n209\t        let links =\n210\t            get_links_to(conn, &MemoryLinkTarget::Memory(current.clone())).map_err(|error| {\n211\t                crate::memory_graph::MemoryStoreError::ConstraintViolation {\n212\t                    detail: error.to_string(),\n213\t                }\n214\t            })?;\n215\t        let Some(next) = links\n216\t            .into_iter()\n217\t            .find(|link| link.link_type == MemoryLinkType::Supersedes)\n218\t            .map(|link| link.source)\n219\t        else {\n220\t            return Ok(current);\n221\t        };\n222\t        current = next;\n223\t    }\n224\t}\n225\t\n226\tfn all_memory_events(harness: &TestHarness) -> Vec<crate::events::EventEnvelope> {\n227\t    EventReader::new(harness.event_store.clone())\n228\t        .execute(\n229\t            EventQuery::new()\n230\t                .session(\"memory-graph\")\n231\t                .workspace(\"workspace\")\n232\t                .branch(\"main\")\n233\t                .order(QueryOrder::OldestFirst)\n234\t                .limit(200),\n235\t        )\n236\t        .expect(\"memory graph events load\")\n237\t}\n238\t\n239\tfn verified_memory(harness: &TestHarness, seed: &str) -> crate::memory_graph::MemoryRecord {\n240\t    let created = created_memory(harness, seed);\n241\t    transition_status(\n242\t        &harness.store,\n243\t        created.memory_id.clone(),\n244\t        VerificationStatus::Verified,\n245\t        \"seed verified\",\n246\t        Some(memory_evidence(&format!(\"verify-{seed}\"))),\n247\t    )\n248\t    .expect(\"seed verifies\")\n249\t}\n250\t\n251\tfn created_memory(harness: &TestHarness, seed: &str) -> crate::memory_graph::MemoryRecord {\n252\t    harness\n253\t        .store\n254\t        .create(\n255\t            harness\n256\t                .draft(seed)\n257\t                .with_class(MemoryClass::Observation, AssertionType::Observation)\n258\t                .into(),\n259\t            idem(&format!(\"create-{seed}\")),\n260\t        )\n261\t        .expect(\"memory creates\")\n262\t}\n263\t"}]},"parent_tool_use_id":null,"session_id":"6c80d671-1437-429b-9e3a-231a1f740b4b","uuid":"4c4a0e82-dcce-4ccb-b314-10441c329476","timestamp":"2026-05-17T07:20:15.125Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/memory_graph/supersession_tests.rs","content":"use std::fmt;\n\nuse chrono::Utc;\nuse rusqlite::Connection;\n\nuse crate::events::{EventQuery, EventReader, QueryOrder};\nuse crate::memory_graph::replay_events;\nuse crate::memory_graph::tests_common::{idem, memory_evidence, stable_ulid, TestHarness};\nuse crate::memory_graph::{\n    get_links_to, initialize_schema, insert_link, transition_status, AssertionType, MemoryClass,\n    MemoryLink, MemoryLinkId, MemoryLinkReference, MemoryLinkTarget, MemoryLinkType,\n    VerificationStatus,\n};\n\n#[test]\nfn supersedes_transitions_prior_memory_to_superseded_and_sets_successor() {\n    let harness = TestHarness::new();\n    let prior = verified_memory(&harness, \"prior\");\n    let replacement = created_memory(&harness, \"replacement\");\n\n    apply_supersedes(&harness, &replacement, &prior, \"prior-replacement\")\n        .expect(\"supersedes applies\");\n\n    let loaded = harness\n        .store\n        .get(&prior.memory_id, &harness.branch_scope())\n        .expect(\"prior reloads\");\n    assert_eq!(loaded.verification_status, VerificationStatus::Superseded);\n    assert_eq!(loaded.superseded_by, Some(replacement.memory_id));\n}\n\n#[test]\nfn supersession_chain_is_traversable_and_cycles_are_rejected() {\n    let harness = TestHarness::new();\n    let a = verified_memory(&harness, \"a\");\n    let b = verified_memory(&harness, \"b\");\n    let c = verified_memory(&harness, \"c\");\n\n    apply_supersedes(&harness, &b, &a, \"b-a\").expect(\"b supersedes a\");\n    apply_supersedes(&harness, &c, &b, \"c-b\").expect(\"c supersedes b\");\n\n    assert_eq!(\n        current_claim(&harness.conn(), &a.memory_id).expect(\"current claim resolves\"),\n        c.memory_id\n    );\n    assert_eq!(\n        get_links_to(\n            &harness.conn(),\n            &MemoryLinkTarget::Memory(a.memory_id.clone())\n        )\n        .unwrap()\n        .len(),\n        1\n    );\n    let error = apply_supersedes(&harness, &a, &c, \"a-c\").expect_err(\"cycle rejects\");\n    assert!(matches!(\n        error,\n        SupersessionApplyError::CycleDetected { .. }\n    ));\n}\n\n#[test]\nfn current_claim_walks_to_latest_successor_and_historical_lookup_preserves_prior_state() {\n    let harness = TestHarness::new();\n    let a = verified_memory(&harness, \"historical-a\");\n    let historical_before = harness\n        .store\n        .get(&a.memory_id, &harness.branch_scope())\n        .expect(\"a loads before supersession\");\n    let b = verified_memory(&harness, \"historical-b\");\n    let c = verified_memory(&harness, \"historical-c\");\n\n    let events_before = all_memory_events(&harness);\n    apply_supersedes(&harness, &b, &a, \"historical-b-a\").expect(\"b supersedes a\");\n    apply_supersedes(&harness, &c, &b, \"historical-c-b\").expect(\"c supersedes b\");\n\n    assert_eq!(\n        current_claim(&harness.conn(), &a.memory_id).expect(\"current claim resolves\"),\n        c.memory_id\n    );\n\n    let historical_db = Connection::open_in_memory().expect(\"historical DB opens\");\n    historical_db\n        .execute_batch(\"PRAGMA foreign_keys = ON;\")\n        .expect(\"foreign keys enable\");\n    initialize_schema(&historical_db).expect(\"schema initializes\");\n    replay_events(&historical_db, &events_before).expect(\"historical replay succeeds\");\n    let restored = historical_db\n        .query_row(\n            \"SELECT verification_status, superseded_by FROM memories WHERE memory_id = ?1\",\n            rusqlite::params![crate::identity::encode_identity(\n                &crate::identity::Identity::Memory(a.memory_id.clone())\n            )],\n            |row| Ok((row.get::<_, String>(0)?, row.get::<_, Option<String>>(1)?)),\n        )\n        .expect(\"historical row loads\");\n\n    assert_eq!(restored.0, historical_before.verification_status.as_str());\n    assert!(restored.1.is_none());\n}\n\n#[derive(Debug)]\nenum SupersessionApplyError {\n    CycleDetected { source: String, target: String },\n    Link(crate::memory_graph::MemoryLinkError),\n    Transition(crate::memory_graph::MemoryTransitionError),\n    Store(crate::memory_graph::MemoryStoreError),\n}\n\nimpl fmt::Display for SupersessionApplyError {\n    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n        match self {\n            Self::CycleDetected { source, target } => {\n                write!(\n                    formatter,\n                    \"supersession cycle `{source}` -> `{target}` is not allowed\"\n                )\n            }\n            Self::Link(error) => error.fmt(formatter),\n            Self::Transition(error) => error.fmt(formatter),\n            Self::Store(error) => error.fmt(formatter),\n        }\n    }\n}\n\nimpl std::error::Error for SupersessionApplyError {}\n\nfn apply_supersedes(\n    harness: &TestHarness,\n    source: &crate::memory_graph::MemoryRecord,\n    target: &crate::memory_graph::MemoryRecord,\n    seed: &str,\n) -> Result<(), SupersessionApplyError> {\n    if current_claim(&harness.conn(), &source.memory_id).map_err(SupersessionApplyError::Store)?\n        == target.memory_id\n    {\n        return Err(SupersessionApplyError::CycleDetected {\n            source: source.memory_id.to_string(),\n            target: target.memory_id.to_string(),\n        });\n    }\n\n    let link = MemoryLink::try_new(\n        MemoryLinkId(format!(\"supersedes-{}\", stable_ulid(seed))),\n        source.memory_id.clone(),\n        MemoryLinkTarget::Memory(target.memory_id.clone()),\n        MemoryLinkType::Supersedes,\n        0.95,\n        \"newer memory supersedes prior claim\".to_string(),\n        None,\n        crate::events::Actor::Assistant {\n            model: \"gpt-test\".to_string(),\n        },\n        Utc::now(),\n        VerificationStatus::Verified,\n    )\n    .map_err(SupersessionApplyError::Link)?;\n    insert_link(&harness.conn(), &link).map_err(SupersessionApplyError::Link)?;\n\n    let source_loaded = harness\n        .store\n        .get(&source.memory_id, &harness.branch_scope())\n        .map_err(SupersessionApplyError::Store)?;\n    harness\n        .store\n        .write_transition(\n            &source_loaded,\n            source_loaded.clone(),\n            \"supersession link inserted\",\n            Some(memory_evidence(&format!(\"source-{seed}\"))),\n        )\n        .map_err(SupersessionApplyError::Store)?;\n\n    let mut target_loaded = harness\n        .store\n        .get(&target.memory_id, &harness.branch_scope())\n        .map_err(SupersessionApplyError::Store)?;\n    target_loaded.supersession_links.push(MemoryLinkReference {\n        memory_id: source.memory_id.clone(),\n        reason: \"replacement memory\".to_string(),\n    });\n    target_loaded.superseded_by = Some(source.memory_id.clone());\n    harness\n        .store\n        .write_transition(\n            target,\n            target_loaded,\n            \"newer memory superseded prior claim\",\n            Some(memory_evidence(&format!(\"target-{seed}\"))),\n        )\n        .map_err(SupersessionApplyError::Store)?;\n    let _ = transition_status(\n        &harness.store,\n        target.memory_id.clone(),\n        VerificationStatus::Superseded,\n        \"newer memory superseded prior claim\",\n        Some(memory_evidence(&format!(\"status-{seed}\"))),\n    )\n    .map_err(SupersessionApplyError::Transition)?;\n    Ok(())\n}\n\nfn current_claim(\n    conn: &Connection,\n    start: &crate::identity::MemoryId,\n) -> Result<crate::identity::MemoryId, crate::memory_graph::MemoryStoreError> {\n    let mut current = start.clone();\n    loop {\n        let links =\n            get_links_to(conn, &MemoryLinkTarget::Memory(current.clone())).map_err(|error| {\n                crate::memory_graph::MemoryStoreError::ConstraintViolation {\n                    detail: error.to_string(),\n                }\n            })?;\n        let Some(next) = links\n            .into_iter()\n            .find(|link| link.link_type == MemoryLinkType::Supersedes)\n            .map(|link| link.source)\n        else {\n            return Ok(current);\n        };\n        current = next;\n    }\n}\n\nfn all_memory_events(harness: &TestHarness) -> Vec<crate::events::EventEnvelope> {\n    EventReader::new(harness.event_store.clone())\n        .execute(\n            EventQuery::new()\n                .session(\"memory-graph\")\n                .workspace(\"workspace\")\n                .branch(\"main\")\n                .order(QueryOrder::OldestFirst)\n                .limit(200),\n        )\n        .expect(\"memory graph events load\")\n}\n\nfn verified_memory(harness: &TestHarness, seed: &str) -> crate::memory_graph::MemoryRecord {\n    let created = created_memory(harness, seed);\n    transition_status(\n        &harness.store,\n        created.memory_id.clone(),\n        VerificationStatus::Verified,\n        \"seed verified\",\n        Some(memory_evidence(&format!(\"verify-{seed}\"))),\n    )\n    .expect(\"seed verifies\")\n}\n\nfn created_memory(harness: &TestHarness, seed: &str) -> crate::memory_graph::MemoryRecord {\n    harness\n        .store\n        .create(\n            harness\n                .draft(seed)\n                .with_class(MemoryClass::Observation, AssertionType::Observation)\n                .into(),\n            idem(&format!(\"create-{seed}\")),\n        )\n        .expect(\"memory creates\")\n}\n","numLines":263,"startLine":1,"totalLines":263}}}
