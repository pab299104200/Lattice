{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SnBjwyc57nAFMfGHY1CgGH","type":"tool_result","content":"1\tuse tracing::info_span;\n2\t\n3\tuse super::{MemoryEvidence, MemoryStore, MemoryStoreError, VerificationStatus};\n4\tuse crate::identity::MemoryId;\n5\t\n6\t#[derive(Debug, thiserror::Error)]\n7\tpub enum MemoryTransitionError {\n8\t    #[error(\n9\t        \"memory transition from `{from}` to `{to}` is not allowed\",\n10\t        from = .from.as_str(),\n11\t        to = .to.as_str()\n12\t    )]\n13\t    DisallowedTransition {\n14\t        from: VerificationStatus,\n15\t        to: VerificationStatus,\n16\t    },\n17\t    #[error(transparent)]\n18\t    Store(#[from] MemoryStoreError),\n19\t}\n20\t\n21\tpub fn transition_status(\n22\t    store: &MemoryStore,\n23\t    memory_id: MemoryId,\n24\t    to: VerificationStatus,\n25\t    reason: &str,\n26\t    evidence: Option<MemoryEvidence>,\n27\t) -> Result<super::MemoryRecord, MemoryTransitionError> {\n28\t    let prior = store.load_for_transition(&memory_id)?;\n29\t    ensure_allowed(prior.verification_status, to)?;\n30\t    let _span = info_span!(\n31\t        \"memory_store.transition\",\n32\t        from = ?prior.verification_status,\n33\t        to = ?to\n34\t    )\n35\t    .entered();\n36\t\n37\t    let mut updated = prior.clone();\n38\t    updated.verification_status = to;\n39\t    if to == VerificationStatus::Superseded && updated.superseded_by.is_none() {\n40\t        updated.superseded_by = updated\n41\t            .supersession_links\n42\t            .first()\n43\t            .map(|link| link.memory_id.clone());\n44\t    }\n45\t    if to != VerificationStatus::Superseded {\n46\t        updated.superseded_by = prior.superseded_by.clone();\n47\t    }\n48\t    store\n49\t        .write_transition(&prior, updated, reason, evidence)\n50\t        .map_err(MemoryTransitionError::from)\n51\t}\n52\t\n53\tfn ensure_allowed(\n54\t    from: VerificationStatus,\n55\t    to: VerificationStatus,\n56\t) -> Result<(), MemoryTransitionError> {\n57\t    let allowed = matches!(\n58\t        (from, to),\n59\t        (VerificationStatus::Unverified, VerificationStatus::InReview)\n60\t            | (VerificationStatus::Unverified, VerificationStatus::Verified)\n61\t            | (VerificationStatus::InReview, VerificationStatus::Verified)\n62\t            | (VerificationStatus::InReview, VerificationStatus::Stale)\n63\t            | (\n64\t                VerificationStatus::InReview,\n65\t                VerificationStatus::Contradicted\n66\t            )\n67\t            | (VerificationStatus::InReview, VerificationStatus::Expired)\n68\t            | (\n69\t                VerificationStatus::InReview,\n70\t                VerificationStatus::Invalidated\n71\t            )\n72\t            | (VerificationStatus::Verified, VerificationStatus::Stale)\n73\t            | (\n74\t                VerificationStatus::Verified,\n75\t                VerificationStatus::Contradicted\n76\t            )\n77\t            | (VerificationStatus::Verified, VerificationStatus::Superseded)\n78\t            | (VerificationStatus::Verified, VerificationStatus::Expired)\n79\t            | (\n80\t                VerificationStatus::Verified,\n81\t                VerificationStatus::Invalidated\n82\t            )\n83\t            | (VerificationStatus::Stale, VerificationStatus::Verified)\n84\t            | (VerificationStatus::Stale, VerificationStatus::Invalidated)\n85\t    );\n86\t    if allowed {\n87\t        Ok(())\n88\t    } else {\n89\t        Err(MemoryTransitionError::DisallowedTransition { from, to })\n90\t    }\n91\t}\n92\t"}]},"parent_tool_use_id":null,"session_id":"6c80d671-1437-429b-9e3a-231a1f740b4b","uuid":"b5e3e656-4d80-451b-966f-71b07915127f","timestamp":"2026-05-17T07:19:53.595Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/memory_graph/transitions.rs","content":"use tracing::info_span;\n\nuse super::{MemoryEvidence, MemoryStore, MemoryStoreError, VerificationStatus};\nuse crate::identity::MemoryId;\n\n#[derive(Debug, thiserror::Error)]\npub enum MemoryTransitionError {\n    #[error(\n        \"memory transition from `{from}` to `{to}` is not allowed\",\n        from = .from.as_str(),\n        to = .to.as_str()\n    )]\n    DisallowedTransition {\n        from: VerificationStatus,\n        to: VerificationStatus,\n    },\n    #[error(transparent)]\n    Store(#[from] MemoryStoreError),\n}\n\npub fn transition_status(\n    store: &MemoryStore,\n    memory_id: MemoryId,\n    to: VerificationStatus,\n    reason: &str,\n    evidence: Option<MemoryEvidence>,\n) -> Result<super::MemoryRecord, MemoryTransitionError> {\n    let prior = store.load_for_transition(&memory_id)?;\n    ensure_allowed(prior.verification_status, to)?;\n    let _span = info_span!(\n        \"memory_store.transition\",\n        from = ?prior.verification_status,\n        to = ?to\n    )\n    .entered();\n\n    let mut updated = prior.clone();\n    updated.verification_status = to;\n    if to == VerificationStatus::Superseded && updated.superseded_by.is_none() {\n        updated.superseded_by = updated\n            .supersession_links\n            .first()\n            .map(|link| link.memory_id.clone());\n    }\n    if to != VerificationStatus::Superseded {\n        updated.superseded_by = prior.superseded_by.clone();\n    }\n    store\n        .write_transition(&prior, updated, reason, evidence)\n        .map_err(MemoryTransitionError::from)\n}\n\nfn ensure_allowed(\n    from: VerificationStatus,\n    to: VerificationStatus,\n) -> Result<(), MemoryTransitionError> {\n    let allowed = matches!(\n        (from, to),\n        (VerificationStatus::Unverified, VerificationStatus::InReview)\n            | (VerificationStatus::Unverified, VerificationStatus::Verified)\n            | (VerificationStatus::InReview, VerificationStatus::Verified)\n            | (VerificationStatus::InReview, VerificationStatus::Stale)\n            | (\n                VerificationStatus::InReview,\n                VerificationStatus::Contradicted\n            )\n            | (VerificationStatus::InReview, VerificationStatus::Expired)\n            | (\n                VerificationStatus::InReview,\n                VerificationStatus::Invalidated\n            )\n            | (VerificationStatus::Verified, VerificationStatus::Stale)\n            | (\n                VerificationStatus::Verified,\n                VerificationStatus::Contradicted\n            )\n            | (VerificationStatus::Verified, VerificationStatus::Superseded)\n            | (VerificationStatus::Verified, VerificationStatus::Expired)\n            | (\n                VerificationStatus::Verified,\n                VerificationStatus::Invalidated\n            )\n            | (VerificationStatus::Stale, VerificationStatus::Verified)\n            | (VerificationStatus::Stale, VerificationStatus::Invalidated)\n    );\n    if allowed {\n        Ok(())\n    } else {\n        Err(MemoryTransitionError::DisallowedTransition { from, to })\n    }\n}\n","numLines":92,"startLine":1,"totalLines":92}}}
