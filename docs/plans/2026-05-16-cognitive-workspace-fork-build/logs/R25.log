{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012s3ZL5Vta1wg5RLoCzjz6Y","type":"tool_result","content":"1\t-- Memory graph schema, T19.\n2\t--\n3\t-- Primary memory classes: Observation, Decision, Constraint, Pattern,\n4\t-- AntiPattern, WorkflowOutcome, FailurePattern, Procedure, Preference,\n5\t-- ArchitectureInvariant, DocsContract, OpenQuestion, CounterMemory.\n6\t--\n7\t-- Each memory record requires: stable id, content, memory class, assertion\n8\t-- type, scope: session, branch, repo, user, organization, verification status,\n9\t-- confidence and confidence reason, freshness policy, validity conditions,\n10\t-- invalidation triggers, provenance events, evidence references, linked files,\n11\t-- linked symbols, linked docs, linked tests, linked memories, contradiction\n12\t-- links, supersession links, access history, usefulness scores, last verified\n13\t-- state.\n14\t\n15\tCREATE TABLE IF NOT EXISTS memories (\n16\t    memory_id TEXT PRIMARY KEY,\n17\t    content TEXT NOT NULL,\n18\t    class TEXT NOT NULL CHECK (\n19\t        class IN (\n20\t            'observation',\n21\t            'decision',\n22\t            'constraint',\n23\t            'pattern',\n24\t            'anti_pattern',\n25\t            'workflow_outcome',\n26\t            'failure_pattern',\n27\t            'procedure',\n28\t            'preference',\n29\t            'architecture_invariant',\n30\t            'docs_contract',\n31\t            'open_question',\n32\t            'counter_memory'\n33\t        )\n34\t    ),\n35\t    assertion_type TEXT NOT NULL CHECK (\n36\t        assertion_type IN (\n37\t            'observation',\n38\t            'decision',\n39\t            'constraint',\n40\t            'hypothesis',\n41\t            'procedure',\n42\t            'outcome',\n43\t            'preference',\n44\t            'question',\n45\t            'counter'\n46\t        )\n47\t    ),\n48\t    scope TEXT NOT NULL CHECK (\n49\t        scope IN ('session', 'branch', 'repo', 'user', 'organization')\n50\t    ),\n51\t    scope_session_id TEXT NULL,\n52\t    scope_branch TEXT NULL,\n53\t    scope_workspace_id TEXT NULL,\n54\t    scope_user_id TEXT NULL,\n55\t    scope_org_id TEXT NULL,\n56\t    verification_status TEXT NOT NULL CHECK (\n57\t        verification_status IN (\n58\t            'unverified',\n59\t            'in_review',\n60\t            'verified',\n61\t            'stale',\n62\t            'contradicted',\n63\t            'superseded',\n64\t            'expired',\n65\t            'invalidated'\n66\t        )\n67\t    ),\n68\t    confidence REAL NOT NULL CHECK(confidence BETWEEN 0 AND 1),\n69\t    confidence_reason TEXT NOT NULL,\n70\t    freshness_policy_json TEXT NOT NULL,\n71\t    validity_conditions_json TEXT NOT NULL,\n72\t    invalidation_triggers_json TEXT NOT NULL,\n73\t    provenance_event_ids_json TEXT NOT NULL,\n74\t    evidence_references_json TEXT NOT NULL,\n75\t    linked_files_json TEXT NOT NULL,\n76\t    linked_symbols_json TEXT NOT NULL,\n77\t    linked_docs_json TEXT NOT NULL,\n78\t    linked_tests_json TEXT NOT NULL,\n79\t    linked_memories_json TEXT NOT NULL,\n80\t    contradiction_links_json TEXT NOT NULL,\n81\t    supersession_links_json TEXT NOT NULL,\n82\t    access_history_json TEXT NOT NULL,\n83\t    last_verified_event_id INTEGER NULL,\n84\t    last_verified_state TEXT NULL,\n85\t    usefulness_score REAL NOT NULL DEFAULT 0,\n86\t    usefulness_score_updated_at INTEGER NOT NULL,\n87\t    created_at INTEGER NOT NULL,\n88\t    created_by TEXT NOT NULL,\n89\t    updated_at INTEGER NOT NULL,\n90\t    updated_by TEXT NOT NULL,\n91\t    superseded_by TEXT NULL,\n92\t    schema_version INTEGER NOT NULL,\n93\t    CHECK (\n94\t        (\n95\t            scope = 'session'\n96\t            AND scope_session_id IS NOT NULL\n97\t            AND scope_branch IS NULL\n98\t            AND scope_workspace_id IS NULL\n99\t            AND scope_user_id IS NULL\n100\t            AND scope_org_id IS NULL\n101\t        )\n102\t        OR (\n103\t            scope = 'branch'\n104\t            AND scope_session_id IS NULL\n105\t            AND scope_branch IS NOT NULL\n106\t            AND scope_workspace_id IS NOT NULL\n107\t            AND scope_user_id IS NULL\n108\t            AND scope_org_id IS NULL\n109\t        )\n110\t        OR (\n111\t            scope = 'repo'\n112\t            AND scope_session_id IS NULL\n113\t            AND scope_branch IS NULL\n114\t            AND scope_workspace_id IS NOT NULL\n115\t            AND scope_user_id IS NULL\n116\t            AND scope_org_id IS NULL\n117\t        )\n118\t        OR (\n119\t            scope = 'user'\n120\t            AND scope_session_id IS NULL\n121\t            AND scope_branch IS NULL\n122\t            AND scope_workspace_id IS NULL\n123\t            AND scope_user_id IS NOT NULL\n124\t            AND scope_org_id IS NULL\n125\t        )\n126\t        OR (\n127\t            scope = 'organization'\n128\t            AND scope_session_id IS NULL\n129\t            AND scope_branch IS NULL\n130\t            AND scope_workspace_id IS NULL\n131\t            AND scope_user_id IS NULL\n132\t            AND scope_org_id IS NOT NULL\n133\t        )\n134\t    )\n135\t);\n136\t\n137\tCREATE TABLE IF NOT EXISTS memory_idempotency (\n138\t    idempotency_key TEXT PRIMARY KEY,\n139\t    memory_id TEXT NOT NULL REFERENCES memories(memory_id)\n140\t);\n141\t\n142\tCREATE TABLE IF NOT EXISTS memory_tombstones (\n143\t    memory_id TEXT PRIMARY KEY REFERENCES memories(memory_id),\n144\t    reason TEXT NOT NULL,\n145\t    deleted_at INTEGER NOT NULL,\n146\t    deleted_by_event_id TEXT NULL\n147\t);\n148\t\n149\tCREATE TABLE IF NOT EXISTS memory_links (\n150\t    link_id TEXT PRIMARY KEY,\n151\t    source_memory_id TEXT NOT NULL REFERENCES memories(memory_id),\n152\t    target_kind TEXT NOT NULL CHECK (\n153\t        target_kind IN ('memory', 'file', 'symbol', 'doc_section', 'test')\n154\t    ),\n155\t    target_id TEXT NOT N