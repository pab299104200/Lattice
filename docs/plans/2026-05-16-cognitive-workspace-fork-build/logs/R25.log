{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VbU8gKA9LEP1YUTcoZXNts","type":"tool_result","content":"1\tuse rusqlite::types::Value;\n2\tuse std::fmt;\n3\t\n4\tuse super::MemoryScope;\n5\t\n6\t#[derive(Clone, Debug, PartialEq)]\n7\tpub struct ScopePredicate {\n8\t    pub where_clause: String,\n9\t    pub bind_values: Vec<Value>,\n10\t}\n11\t\n12\t#[derive(Clone, Debug, Default, PartialEq, Eq)]\n13\tpub struct ScopeFilter {\n14\t    clauses: Vec<ScopeClause>,\n15\t}\n16\t\n17\t#[derive(Clone, Debug, PartialEq, Eq)]\n18\tpub enum ScopeClause {\n19\t    Session {\n20\t        session_id: String,\n21\t    },\n22\t    Branch {\n23\t        workspace_id: String,\n24\t        branch_ref: String,\n25\t    },\n26\t    Repo {\n27\t        workspace_id: String,\n28\t    },\n29\t    User {\n30\t        user_id: String,\n31\t    },\n32\t    Organization {\n33\t        org_id: String,\n34\t    },\n35\t}\n36\t\n37\t#[derive(Clone, Debug, PartialEq, Eq)]\n38\tpub enum ScopeError {\n39\t    Underspecified,\n40\t    CrossScopeViolation {\n41\t        requested: MemoryScope,\n42\t        allowed: MemoryScope,\n43\t    },\n44\t    IdentityMismatch {\n45\t        field: &'static str,\n46\t    },\n47\t}\n48\t\n49\timpl fmt::Display for ScopeError {\n50\t    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n51\t        match self {\n52\t            ScopeError::Underspecified => formatter.write_str(\"scope filter is underspecified\"),\n53\t            ScopeError::CrossScopeViolation { requested, allowed } => write!(\n54\t                formatter,\n55\t                \"requested scope `{}` is outside allowed scope `{}`\",\n56\t                requested.as_str(),\n57\t                allowed.as_str()\n58\t            ),\n59\t            ScopeError::IdentityMismatch { field } => {\n60\t                write!(formatter, \"scope identity field `{field}` does not match\")\n61\t            }\n62\t        }\n63\t    }\n64\t}\n65\t\n66\timpl std::error::Error for ScopeError {}\n67\t\n68\timpl ScopeFilter {\n69\t    pub fn new() -> Self {\n70\t        Self::default()\n71\t    }\n72\t\n73\t    pub fn session(session_id: impl Into<String>) -> Self {\n74\t        Self::new().with_session(session_id)\n75\t    }\n76\t\n77\t    pub fn branch(workspace_id: impl Into<String>, branch_ref: impl Into<String>) -> Self {\n78\t        Self::new().with_branch(workspace_id, branch_ref)\n79\t    }\n80\t\n81\t    pub fn repo(workspace_id: impl Into<String>) -> Self {\n82\t        Self::new().with_repo(workspace_id)\n83\t    }\n84\t\n85\t    pub fn user(user_id: impl Into<String>) -> Self {\n86\t        Self::new().with_user(user_id)\n87\t    }\n88\t\n89\t    pub fn organization(org_id: impl Into<String>) -> Self {\n90\t        Self::new().with_organization(org_id)\n91\t    }\n92\t\n93\t    pub fn with_session(mut self, session_id: impl Into<String>) -> Self {\n94\t        self.push_unique(ScopeClause::Session {\n95\t            session_id: session_id.into(),\n96\t        });\n97\t        self\n98\t    }\n99\t\n100\t    pub fn with_branch(\n101\t        mut self,\n102\t        workspace_id: impl Into<String>,\n103\t        branch_ref: impl Into<String>,\n104\t    ) -> Self {\n105\t        self.push_unique(ScopeClause::Branch {\n106\t            workspace_id: workspace_id.into(),\n107\t            branch_ref: branch_ref.into(),\n108\t        });\n109\t        self\n110\t    }\n111\t\n112\t    pub fn with_repo(mut self, workspace_id: impl Into<String>) -> Self {\n113\t        self.push_unique(ScopeClause::Repo {\n114\t            workspace_id: workspace_id.into(),\n115\t        });\n116\t        self\n117\t    }\n118\t\n119\t    pub fn with_user(mut self, user_id: impl Into<String>) -> Self {\n120\t        self.push_unique(ScopeClause::User {\n121\t            user_id: user_id.into(),\n122\t        });\n123\t        self\n124\t    }\n125\t\n126\t    pub fn with_organization(mut self, org_id: impl Into<String>) -> Self {\n127\t        self.push_unique(ScopeClause::Organization {\n128\t            org_id: org_id.into(),\n129\t        });\n130\t        self\n131\t    }\n132\t\n133\t    pub fn clauses(&self) -> &[ScopeClause] {\n134\t        &self.clauses\n135\t    }\n136\t\n137\t    pub fn is_empty(&self) -> bool {\n138\t        self.clauses.is_empty()\n139\t    }\n140\t\n141\t    pub fn to_sql_predicate(&self) -> ScopePredicate {\n142\t        if self.is_empty() {\n143\t            return ScopePredicate {\n144\t                where_clause: \"1 = 0\".to_string(),\n145\t                bind_values: Vec::new(),\n146\t            };\n147\t        }\n148\t\n149\t        let mut predicates = Vec::with_capacity(self.clauses.len());\n150\t        let mut bind_values = Vec::new();\n151\t\n152\t        for clause in &self.clauses {\n153\t            match clause {\n154\t                ScopeClause::Session { session_id } => {\n155\t                    predicates.push(\"(scope = ? AND scope_session_id = ?)\".to_string());\n156\t                    bind_values.push(Value::Text(MemoryScope::Session.as_str().to_string()));\n157\t                    bind_values.push(Value::Text(session_id.clone()));\n158\t                }\n159\t                ScopeClause::Branch {\n160\t                    workspace_id,\n161\t                    branch_ref,\n162\t                } => {\n163\t                    predicates.push(\n164\t                        \"(scope = ? AND scope_workspace_id = ? AND scope_branch = ?)\".to_string(),\n165\t                    );\n166\t                    bind_values.push(Value::Text(MemoryScope::Branch.as_str().to_string()));\n167\t                    bind_values.push(Value::Text(workspace_id.clone()));\n168\t                    bind_values.push(Value::Text(branch_ref.clone()));\n169\t                }\n170\t                ScopeClause::Repo { workspace_id } => {\n171\t                    predicates.push(\"(scope = ? AND scope_workspace_id = ?)\".to_string());\n172\t                    bind_values.push(Value::Text(MemoryScope::Repo.as_str().to_string()));\n173\t                    bind_values.push(Value::Text(workspace_id.clone()));\n174\t                }\n175\t                ScopeClause::User { user_id } => {\n176\t                    predicates.push(\"(scope = ? AND scope_user_id = ?)\".to_string());\n177\t                    bind_values.push(Value::Text(MemoryScope::User.as_str().to_string()));\n178\t                    bind_values.push(Value::Text(user_id.clone()));\n179\t                }\n180\t                ScopeClause::Organization { org_id } => {\n181\t                    predicates.push(\"(scope = ? AND scope_org_id = ?)\".to_string());\n182\t                    bind_values.push(Value::Text(MemoryScope::Organization.as_str().to_string()));\n183\t                    bind_values.push(Value::Text(org_id.clone()));\n184\t                }\n185\t            }\n186\t        }\n187\t\n188\t        ScopePredicate {\n189\t            where_clause: format!(\"({})\", predicates.join(\" OR \")),\n190\t            bind_values,\n191\t        }\n192\t    }\n193\t\n194\t    pub fn enforce_subset(&self, allowed: &ScopeFilter) -> Result<(), ScopeError> {\n195\t        if self.is_empty() {\n196\t            return Err(ScopeError::Underspecified);\n197\t        }\n198\t\n199\t        for requested in &self.clauses {\n200\t            let requested_scope = requested.scope();\n201\t            let Some(candidate) = allowed\n202\t                .clauses\n203\t                .iter()\n204\t                .find(|allowed_clause| allowed_clause.scope() == requested_scope)\n205\t            else {\n206\t                return Err(ScopeError::CrossScopeViolation {\n207\t                    requested: requested_scope,\n208\t                    allowed: allowed.primary_scope().unwrap_or(requested_scope),\n209\t                });\n210\t            };\n211\t\n212\t            match (requested, candidate) {\n213\t                (\n214\t                    ScopeClause::Session {\n215\t                        session_id: requested,\n216\t                    },\n217\t                    ScopeClause::Session {\n218\t                        session_id: allowed,\n219\t                    },\n220\t                ) if requested != allowed => {\n221\t                    return Err(ScopeError::IdentityMismatch {\n222\t                        field: \"scope_session_id\",\n223\t                    });\n224\t                }\n225\t                (\n226\t                    ScopeClause::Branch {\n227\t                        workspace_id: requested_workspace,\n228\t                        branch_ref: requested_branch,\n229\t                    },\n230\t                    ScopeClause::Branch {\n231\t                        workspace_id: allowed_workspace,\n232\t                        branch_ref: allowed_branch,\n233\t                    },\n234\t                ) => {\n235\t                    if requested_workspace != allowed_workspace {\n236\t                        return Err(ScopeError::IdentityMismatch {\n237\t                            field: \"scope_workspace_id\",\n238\t                        });\n239\t                    }\n240\t                    if requested_branch != allowed_branch {\n241\t                        return Err(ScopeError::IdentityMismatch {\n242\t                            field: \"scope_branch\",\n243\t                        });\n244\t                    }\n245\t                }\n246\t                (\n247\t                    ScopeClause::Repo {\n248\t                        workspace_id: requested,\n249\t                    },\n250\t                    ScopeClause::Repo {\n251\t                        workspace_id: allowed,\n252\t                    },\n253\t                ) if requested != allowed => {\n254\t                    return Err(ScopeError::IdentityMismatch {\n255\t                        field: \"scope_workspace_id\",\n256\t                    });\n257\t                }\n258\t                (\n259\t                    ScopeClause::User { user_id: requested },\n260\t                    ScopeClause::User { user_id: allowed },\n261\t                ) if requested != allowed => {\n262\t                    return Err(ScopeError::IdentityMismatch {\n263\t                        field: \"scope_user_id\",\n264\t                    });\n265\t                }\n266\t                (\n267\t                    ScopeClause::Organization { org_id: requested },\n268\t                    ScopeClause::Organization { org_id: allowed },\n269\t                ) if requested != allowed => {\n270\t                    return Err(ScopeError::IdentityMismatch {\n271\t                        field: \"scope_org_id\",\n272\t                    });\n273\t                }\n274\t                _ => {}\n275\t            }\n276\t        }\n277\t\n278\t        Ok(())\n279\t    }\n280\t\n281\t    fn push_unique(&mut self, clause: ScopeClause) {\n282\t        if !self.clauses.contains(&clause) {\n283\t            self.clauses.push(clause);\n284\t        }\n285\t    }\n286\t\n287\t    fn primary_scope(&self) -> Option<MemoryScope> {\n288\t        self.clauses.first().map(ScopeClause::scope)\n289\t    }\n290\t}\n291\t\n292\timpl ScopeClause {\n293\t    pub fn scope(&self) -> MemoryScope {\n294\t        match self {\n295\t            ScopeClause::Session { .. } => MemoryScope::Session,\n296\t            ScopeClause::Branch { .. } => MemoryScope::Branch,\n297\t            ScopeClause::Repo { .. } => MemoryScope::Repo,\n298\t            ScopeClause::User { .. } => MemoryScope::User,\n299\t            ScopeClause::Organization { .. } => MemoryScope::Organization,\n300\t        }\n301\t    }\n302\t}\n303\t"}]},"parent_tool_use_id":null,"session_id":"6c80d671-1437-429b-9e3a-231a1f740b4b","uuid":"f64b52f0-bc59-4f0c-8131-d16f8db67099","timestamp":"2026-05-17T07:19:18.594Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/memory_graph/scope.rs","content":"use rusqlite::types::Value;\nuse std::fmt;\n\nuse super::MemoryScope;\n\n#[derive(Clone, Debug, PartialEq)]\npub struct ScopePredicate {\n    pub where_clause: String,\n    pub bind_values: Vec<Value>,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\npub struct ScopeFilter {\n    clauses: Vec<ScopeClause>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum ScopeClause {\n    Session {\n        session_id: String,\n    },\n    Branch {\n        workspace_id: String,\n        branch_ref: String,\n    },\n    Repo {\n        workspace_id: String,\n    },\n    User {\n        user_id: String,\n    },\n    Organization {\n        org_id: String,\n    },\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum ScopeError {\n    Underspecified,\n    CrossScopeViolation {\n        requested: MemoryScope,\n        allowed: MemoryScope,\n    },\n    IdentityMismatch {\n        field: &'static str,\n    },\n}\n\nimpl fmt::Display for ScopeError {\n    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n        match self {\n            ScopeError::Underspecified => formatter.write_str(\"scope filter is underspecified\"),\n            ScopeError::CrossScopeViolation { requested, allowed } => write!(\n                formatter,\n                \"requested scope `{}` is outside allowed scope `{}`\",\n                requested.as_str(),\n                allowed.as_str()\n            ),\n            ScopeError::IdentityMismatch { field } => {\n                write!(formatter, \"scope identity field `{field}` does not match\")\n            }\n        }\n    }\n}\n\nimpl std::error::Error for ScopeError {}\n\nimpl ScopeFilter {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    pub fn session(session_id: impl Into<String>) -> Self {\n        Self::new().with_session(session_id)\n    }\n\n    pub fn branch(workspace_id: impl Into<String>, branch_ref: impl Into<String>) -> Self {\n        Self::new().with_branch(workspace_id, branch_ref)\n    }\n\n    pub fn repo(workspace_id: impl Into<String>) -> Self {\n        Self::new().with_repo(workspace_id)\n    }\n\n    pub fn user(user_id: impl Into<String>) -> Self {\n        Self::new().with_user(user_id)\n    }\n\n    pub fn organization(org_id: impl Into<String>) -> Self {\n        Self::new().with_organization(org_id)\n    }\n\n    pub fn with_session(mut self, session_id: impl Into<String>) -> Self {\n        self.push_unique(ScopeClause::Session {\n            session_id: session_id.into(),\n        });\n        self\n    }\n\n    pub fn with_branch(\n        mut self,\n        workspace_id: impl Into<String>,\n        branch_ref: impl Into<String>,\n    ) -> Self {\n        self.push_unique(ScopeClause::Branch {\n            workspace_id: workspace_id.into(),\n            branch_ref: branch_ref.into(),\n        });\n        self\n    }\n\n    pub fn with_repo(mut self, workspace_id: impl Into<String>) -> Self {\n        self.push_unique(ScopeClause::Repo {\n            workspace_id: workspace_id.into(),\n        });\n        self\n    }\n\n    pub fn with_user(mut self, user_id: impl Into<String>) -> Self {\n        self.push_unique(ScopeClause::User {\n            user_id: user_id.into(),\n        });\n        self\n    }\n\n    pub fn with_organization(mut self, org_id: impl Into<String>) -> Self {\n        self.push_unique(ScopeClause::Organization {\n            org_id: org_id.into(),\n        });\n        self\n    }\n\n    pub fn clauses(&self) -> &[ScopeClause] {\n        &self.clauses\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.clauses.is_empty()\n    }\n\n    pub fn to_sql_predicate(&self) -> ScopePredicate {\n        if self.is_empty() {\n            return ScopePredicate {\n                where_clause: \"1 = 0\".to_string(),\n                bind_values: Vec::new(),\n            };\n        }\n\n        let mut predicates = Vec::with_capacity(self.clauses.len());\n        let mut bind_values = Vec::new();\n\n        for clause in &self.clauses {\n            match clause {\n                ScopeClause::Session { session_id } => {\n                    predicates.push(\"(scope = ? AND scope_session_id = ?)\".to_string());\n                    bind_values.push(Value::Text(MemoryScope::Session.as_str().to_string()));\n                    bind_values.push(Value::Text(session_id.clone()));\n                }\n                ScopeClause::Branch {\n                    workspace_id,\n                    branch_ref,\n                } => {\n                    predicates.push(\n                        \"(scope = ? AND scope_workspace_id = ? AND scope_branch = ?)\".to_string(),\n                    );\n                    bind_values.push(Value::Text(MemoryScope::Branch.as_str().to_string()));\n                    bind_values.push(Value::Text(workspace_id.clone()));\n                    bind_values.push(Value::Text(branch_ref.clone()));\n                }\n                ScopeClause::Repo { workspace_id } => {\n                    predicates.push(\"(scope = ? AND scope_workspace_id = ?)\".to_string());\n                    bind_values.push(Value::Text(MemoryScope::Repo.as_str().to_string()));\n                    bind_values.push(Value::Text(workspace_id.clone()));\n                }\n                ScopeClause::User { user_id } => {\n                    predicates.push(\"(scope = ? AND scope_user_id = ?)\".to_string());\n                    bind_values.push(Value::Text(MemoryScope::User.as_str().to_string()));\n                    bind_values.push(Value::Text(user_id.clone()));\n                }\n                ScopeClause::Organization { org_id } => {\n                    predicates.push(\"(scope = ? AND scope_org_id = ?)\".to_string());\n                    bind_values.push(Value::Text(MemoryScope::Organization.as_str().to_string()));\n                    bind_values.push(Value::Text(org_id.clone()));\n                }\n            }\n        }\n\n        ScopePredicate {\n            where_clause: format!(\"({})\", predicates.join(\" OR \")),\n            bind_values,\n        }\n    }\n\n    pub fn enforce_subset(&self, allowed: &ScopeFilter) -> Result<(), ScopeError> {\n        if self.is_empty() {\n            return Err(ScopeError::Underspecified);\n        }\n\n        for requested in &self.clauses {\n            let requested_scope = requested.scope();\n            let Some(candidate) = allowed\n                .clauses\n                .iter()\n                .find(|allowed_clause| allowed_clause.scope() == requested_scope)\n            else {\n                return Err(ScopeError::CrossScopeViolation {\n                    requested: requested_scope,\n                    allowed: allowed.primary_scope().unwrap_or(requested_scope),\n                });\n            };\n\n            match (requested, candidate) {\n                (\n                    ScopeClause::Session {\n                        session_id: requested,\n                    },\n                    ScopeClause::Session {\n                        session_id: allowed,\n                    },\n                ) if requested != allowed => {\n                    return Err(ScopeError::IdentityMismatch {\n                        field: \"scope_session_id\",\n                    });\n                }\n                (\n                    ScopeClause::Branch {\n                        workspace_id: requested_workspace,\n                        branch_ref: requested_branch,\n                    },\n                    ScopeClause::Branch {\n                        workspace_id: allowed_workspace,\n                        branch_ref: allowed_branch,\n                    },\n                ) => {\n                    if requested_workspace != allowed_workspace {\n                        return Err(ScopeError::IdentityMismatch {\n                            field: \"scope_workspace_id\",\n                        });\n                    }\n                    if requested_branch != allowed_branch {\n                        return Err(ScopeError::IdentityMismatch {\n                            field: \"scope_branch\",\n                        });\n                    }\n                }\n                (\n                    ScopeClause::Repo {\n                        workspace_id: requested,\n                    },\n                    ScopeClause::Repo {\n                        workspace_id: allowed,\n                    },\n                ) if requested != allowed => {\n                    return Err(ScopeError::IdentityMismatch {\n                        field: \"scope_workspace_id\",\n                    });\n                }\n                (\n                    ScopeClause::User { user_id: requested },\n                    ScopeClause::User { user_id: allowed },\n                ) if requested != allowed => {\n                    return Err(ScopeError::IdentityMismatch {\n                        field: \"scope_user_id\",\n                    });\n                }\n                (\n                    ScopeClause::Organization { org_id: requested },\n                    ScopeClause::Organization { org_id: allowed },\n                ) if requested != allowed => {\n                    return Err(ScopeError::IdentityMismatch {\n                        field: \"scope_org_id\",\n                    });\n                }\n                _ => {}\n            }\n        }\n\n        Ok(())\n    }\n\n    fn push_unique(&mut self, clause: ScopeClause) {\n        if !self.clauses.contains(&clause) {\n            self.clauses.push(clause);\n        }\n    }\n\n    fn primary_scope(&self) -> Option<MemoryScope> {\n        self.clauses.first().map(ScopeClause::scope)\n    }\n}\n\nimpl ScopeClause {\n    pub fn scope(&self) -> MemoryScope {\n        match self {\n            ScopeClause::Session { .. } => MemoryScope::Session,\n            ScopeClause::Branch { .. } => MemoryScope::Branch,\n            ScopeClause::Repo { .. } => MemoryScope::Repo,\n            ScopeClause::User { .. } => MemoryScope::User,\n            ScopeClause::Organization { .. } => MemoryScope::Organization,\n        }\n    }\n}\n","numLines":303,"startLine":1,"totalLines":303}}}
