{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WXZvP3jEBZBcZ3Xe9FvqjV","type":"tool_result","content":"1\tuse chrono::Utc;\n2\t\n3\tuse crate::events::{Actor, EventPayload, MemoryUpdatedPayload};\n4\tuse crate::memory_graph::tests_common::{\n5\t    event_id, idem, memory_evidence, stable_ulid, TestHarness,\n6\t};\n7\tuse crate::memory_graph::{\n8\t    get_links_from, get_links_to, insert_link, transition_status, AssertionType, MemoryClass,\n9\t    MemoryLink, MemoryLinkId, MemoryLinkTarget, MemoryLinkType, VerificationStatus,\n10\t};\n11\t\n12\t#[test]\n13\tfn contradiction_link_contradicts_target_and_emits_memory_updated_event() {\n14\t    let harness = TestHarness::new();\n15\t    let contradicted = verified_memory(&harness, \"a\");\n16\t    let contradictor = created_memory(&harness, \"b\");\n17\t    let link = contradiction_link(&contradictor.memory_id, &contradicted.memory_id, \"b-a\");\n18\t\n19\t    insert_link(&harness.conn(), &link).expect(\"contradiction link inserts\");\n20\t    let updated = transition_status(\n21\t        &harness.store,\n22\t        contradicted.memory_id.clone(),\n23\t        VerificationStatus::Contradicted,\n24\t        \"contradicted by newer evidence\",\n25\t        Some(memory_evidence(\"contradiction-proof\")),\n26\t    )\n27\t    .expect(\"contradiction transition succeeds\");\n28\t\n29\t    assert_eq!(\n30\t        updated.verification_status,\n31\t        VerificationStatus::Contradicted\n32\t    );\n33\t    assert_eq!(\n34\t        get_links_from(&harness.conn(), &contradictor.memory_id).unwrap(),\n35\t        vec![link.clone()]\n36\t    );\n37\t    assert_eq!(\n38\t        get_links_to(\n39\t            &harness.conn(),\n40\t            &MemoryLinkTarget::Memory(contradicted.memory_id.clone())\n41\t        )\n42\t        .unwrap(),\n43\t        vec![link.clone()]\n44\t    );\n45\t    assert!(matches!(\n46\t        harness.latest_event_payload(),\n47\t        EventPayload::MemoryUpdated(MemoryUpdatedPayload { memory_id, update_summary, .. })\n48\t            if memory_id == contradicted.memory_id\n49\t                && update_summary == \"verified -> contradicted: contradicted by newer evidence\"\n50\t    ));\n51\t    assert_eq!(link.evidence_event_id, Some(event_id(\"contradiction-b-a\")));\n52\t}\n53\t\n54\t#[test]\n55\tfn counter_memory_is_first_class_record_and_can_be_superseded_independently() {\n56\t    let harness = TestHarness::new();\n57\t    let target = verified_memory(&harness, \"target\");\n58\t    let counter = harness\n59\t        .store\n60\t        .create(\n61\t            harness\n62\t                .draft(\"counter\")\n63\t                .with_class(MemoryClass::CounterMemory, AssertionType::Counter)\n64\t                .with_initial_evidence(memory_evidence(\"counter-seed\"))\n65\t                .into(),\n66\t            idem(\"create-counter\"),\n67\t        )\n68\t        .expect(\"counter memory creates\");\n69\t    insert_link(\n70\t        &harness.conn(),\n71\t        &contradiction_link(&counter.memory_id, &target.memory_id, \"counter-target\"),\n72\t    )\n73\t    .expect(\"counter contradiction inserts\");\n74\t    transition_status(\n75\t        &harness.store,\n76\t        target.memory_id.clone(),\n77\t        VerificationStatus::Contradicted,\n78\t        \"counter memory contradicts prior claim\",\n79\t        Some(memory_evidence(\"counter-proof\")),\n80\t    )\n81\t    .expect(\"target contradicts\");\n82\t\n83\t    let loaded_counter = harness\n84\t        .store\n85\t        .get(&counter.memory_id, &harness.branch_scope())\n86\t        .expect(\"counter memory loads\");\n87\t    assert_eq!(loaded_counter.class, MemoryClass::CounterMemory);\n88\t    assert_eq!(loaded_counter.scope, counter.scope);\n89\t    assert_eq!(\n90\t        loaded_counter.verification_status,\n91\t        VerificationStatus::Unverified\n92\t    );\n93\t\n94\t    let replacement = created_memory(&harness, \"replacement\");\n95\t    insert_link(\n96\t        &harness.conn(),\n97\t        &supersedes_link(\n98\t            &replacement.memory_id,\n99\t            &counter.memory_id,\n100\t            \"replacement-counter\",\n101\t        ),\n102\t    )\n103\t    .expect(\"replacement link inserts\");\n104\t    let mut superseded_counter = loaded_counter.clone();\n105\t    superseded_counter\n106\t        .supersession_links\n107\t        .push(crate::memory_graph::MemoryLinkReference {\n108\t            memory_id: replacement.memory_id.clone(),\n109\t            reason: \"replacement counter memory\".to_string(),\n110\t        });\n111\t    superseded_counter.superseded_by = Some(replacement.memory_id.clone());\n112\t    superseded_counter.verification_status = VerificationStatus::Superseded;\n113\t    let transitioned = harness\n114\t        .store\n115\t        .write_transition(\n116\t            &loaded_counter,\n117\t            superseded_counter,\n118\t            \"replacement counter supersedes prior counter\",\n119\t            Some(memory_evidence(\"counter-superseded\")),\n120\t        )\n121\t        .expect(\"counter memory supersedes\");\n122\t\n123\t    assert_eq!(\n124\t        transitioned.verification_status,\n125\t        VerificationStatus::Superseded\n126\t    );\n127\t    assert_eq!(transitioned.superseded_by, Some(replacement.memory_id));\n128\t    assert_eq!(\n129\t        harness\n130\t            .store\n131\t            .get(&target.memory_id, &harness.branch_scope())\n132\t            .expect(\"target reloads\")\n133\t            .verification_status,\n134\t        VerificationStatus::Contradicted\n135\t    );\n136\t}\n137\t\n138\t#[test]\n139\tfn counter_memory_can_be_invalidated_without_reopening_its_target() {\n140\t    let harness = TestHarness::new();\n141\t    let target = verified_memory(&harness, \"invalid-target\");\n142\t    let counter = harness\n143\t        .store\n144\t        .create(\n145\t            harness\n146\t                .draft(\"invalid-counter\")\n