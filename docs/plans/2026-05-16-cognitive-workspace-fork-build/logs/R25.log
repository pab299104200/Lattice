{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UpLpcc2LcdMVfcGF3z1Xif","type":"tool_result","content":"1\tuse std::fmt;\n2\t\n3\tuse chrono::{DateTime, Utc};\n4\tuse rusqlite::{params, Connection};\n5\tuse serde::{Deserialize, Serialize};\n6\tuse thiserror::Error;\n7\tuse tracing::trace_span;\n8\t\n9\tuse super::{\n10\t    decode_actor, decode_timestamp, encode_actor, encode_timestamp, row_decode_error,\n11\t    warn_on_fk_violation, MemoryGraphParseError, TestId,\n12\t};\n13\tuse crate::events::{Actor, DocSectionId};\n14\tuse crate::identity::{EventId, Identity, MemoryId, SymbolId};\n15\tuse crate::memory_graph::{decode_event_id, encode_event_id, encode_identity_text};\n16\t\n17\t#[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]\n18\t#[serde(transparent)]\n19\tpub struct MemoryEvidenceId(pub String);\n20\t\n21\timpl MemoryEvidenceId {\n22\t    pub fn as_str(&self) -> &str {\n23\t        self.0.as_str()\n24\t    }\n25\t}\n26\t\n27\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n28\t#[serde(rename_all = \"snake_case\")]\n29\tpub enum EvidenceAnchor {\n30\t    FileSpan {\n31\t        file: crate::identity::FileId,\n32\t        byte_start: u64,\n33\t        byte_end: u64,\n34\t        sha256: [u8; 32],\n35\t    },\n36\t    SymbolRef(SymbolId),\n37\t    DocSection {\n38\t        id: DocSectionId,\n39\t        sha256: [u8; 32],\n40\t    },\n41\t    TestResult {\n42\t        test: TestId,\n43\t        passed: bool,\n44\t        run_event: EventId,\n45\t    },\n46\t    EventReference(EventId),\n47\t}\n48\t\n49\timpl EvidenceAnchor {\n50\t    fn kind(&self) -> &'static str {\n51\t        match self {\n52\t            Self::FileSpan { .. } => \"file_span\",\n53\t            Self::SymbolRef(_) => \"symbol_ref\",\n54\t            Self::DocSection { .. } => \"doc_section\",\n55\t            Self::TestResult { .. } => \"test_result\",\n56\t            Self::EventReference(_) => \"event_reference\",\n57\t        }\n5