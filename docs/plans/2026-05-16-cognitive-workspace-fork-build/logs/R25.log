MARY KEY,\n216\t    memory_id TEXT NOT NULL REFERENCES memories(memory_id),\n217\t    accessed_at INTEGER NOT NULL,\n218\t    accessed_in_event TEXT NOT NULL,\n219\t    accessor_kind TEXT NOT NULL CHECK (\n220\t        accessor_kind IN ('assistant', 'user', 'tool', 'daemon')\n221\t    ),\n222\t    accessor_detail TEXT NULL,\n223\t    inclusion_reason TEXT NOT NULL,\n224\t    was_used INTEGER NULL CHECK (was_used IN (0, 1)),\n225\t    downstream_outcome_event TEXT NULL\n226\t);\n227\t\n228\tCREATE TABLE IF NOT EXISTS memory_scores (\n229\t    memory_id TEXT NOT NULL REFERENCES memories(memory_id),\n230\t    score_kind TEXT NOT NULL CHECK (\n231\t        score_kind IN (\n232\t            'usefulness_prior',\n233\t            'recent_usefulness',\n234\t            'retrieval_accuracy',\n235\t            'regression_risk'\n236\t        )\n237\t    ),\n238\t    value REAL NOT NULL,\n239\t    computed_at INTEGER NOT NULL,\n240\t    computed_from_window_secs INTEGER NOT NULL CHECK (computed_from_window_secs >= 0),\n241\t    sample_size INTEGER NOT NULL CHECK (sample_size >= 0),\n242\t    PRIMARY KEY (memory_id, score_kind, computed_at)\n243\t);\n244\t\n245\tCREATE INDEX IF NOT EXISTS idx_memory_links_source\n246\t    ON memory_links(source_memory_id);\n247\tCREATE INDEX IF NOT EXISTS idx_memory_links_target\n248\t    ON memory_links(target_kind, target_id);\n249\tCREATE INDEX IF NOT EXISTS idx_memory_links_type\n250\t    ON memory_links(link_type);\n251\t\n252\tCREATE INDEX IF NOT EXISTS idx_memory_evidence_memory\n253\t    ON memory_evidence(memory_id);\n254\tCREATE INDEX IF NOT EXISTS idx_memory_evidence_event\n255\t    ON memory_evidence(event_id);\n256\t\n257\tCREATE INDEX IF NOT EXISTS idx_memory_accesses_memory_time\n258\t    ON memory_accesses(memory_id, accessed_at DESC);\n259\tCREATE INDEX IF NOT EXISTS idx_memory_accesses_event\n260\t    ON memory_accesses(accessed_in_event);\n261\t\n262\tCREATE INDEX IF NOT EXISTS idx_memory_scores_memory_kind\n263\t    ON memor