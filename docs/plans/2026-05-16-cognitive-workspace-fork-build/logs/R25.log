{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DLyV5jtPzYektZ5WDuD2dP","type":"tool_result","content":"1\t//! Typed memory graph schema for the cognitive workspace memory redesign.\n2\t//!\n3\t//! This module is the Rust model surface for\n4\t//! `docs/architecture/2026-05-16-memory-graph-schema.md`, especially\n5\t//! `## Classes`, `## Required fields`, `## Scopes`,\n6\t//! `## Verification statuses`, `## Freshness, validity, invalidation`,\n7\t//! `## CounterMemory semantics`, `## Links`, `## Evidence`,\n8\t//! `## Accesses`, `## Scores`, and `## Schema parity table`.\n9\t\n10\tuse std::time::Duration;\n11\t\n12\tuse crate::events::Actor;\n13\tuse crate::identity::{decode_identity, encode_identity, EventId, Identity};\n14\tuse crate::{DateTime, Utc};\n15\tuse rusqlite::Connection;\n16\tuse tracing::warn;\n17\t\n18\tpub mod accesses;\n19\tpub mod classes;\n20\tpub mod evidence;\n21\tpub mod links;\n22\tpub mod migration;\n23\tpub(crate) mod migration_mapping;\n24\tpub mod replay;\n25\tpub mod scope;\n26\tpub mod scores;\n27\tpub mod store;\n28\tpub mod streams;\n29\tpub mod transitions;\n30\t\n31\t#[cfg(test)]\n32\tmod contradiction_tests;\n33\t#[cfg(test)]\n34\tmod links_tests;\n35\t#[cfg(test)]\n36\tmod migration_tests;\n37\t#[cfg(test)]\n38\tmod replay_tests;\n39\t#[cfg(test)]\n40\tmod scope_tests;\n41\t#[cfg(test)]\n42\tmod store_tests;\n43\t#[cfg(test)]\n44\tmod supersession_tests;\n45\t#[cfg(test)]\n46\tmod tests_common;\n47\t\n48\tpub use accesses::{\n49\t    list_accesses_for, mark_used, record_access, MemoryAccess, MemoryAccessError, MemoryAccessId,\n50\t};\n51\tpub use classes::{\n52\t    decode_json_column, AssertionType, EvidenceReference, FreshnessKind, FreshnessPolicy,\n53\t    InvalidationTrigger, MemoryAccessRecord, MemoryClass, MemoryGraphParseError,\n54\t    MemoryLinkReference, MemoryRecord, MemoryScope, TestId, TriggerKind, ValidityCondition,\n55\t    ValidityPredicate, VerificationStatus,\n56\t};\n57\tpub use evidence::{\n58\t    get_evidence_for, insert_evidence, EvidenceAnchor, MemoryEvidence, MemoryEvidenceError,\n59\t    MemoryEvidenceId,\n60\t};\n61\tpub use links::{\n62\t    get_links_by_type, get_links_from, get_links_to, insert_link, MemoryLink, MemoryLinkError,\n63\t    MemoryLinkId, MemoryLinkTarget, MemoryLinkTargetKind, MemoryLinkType,\n64\t};\n65\tpub use migration::{MemoryMigrator, MigrationError, MigrationPlan, MigrationReport};\n66\tpub use replay::{\n67\t    capture_replay_snapshot, decode_replay_snapshot, replay_events, MemoryReplayError,\n68\t    MemoryReplaySnapshot,\n69\t};\n70\tpub use scope::{ScopeClause, ScopeError, ScopeFilter, ScopePredicate};\n71\tpub use scores::{\n72\t    latest_score, score_history, write_score, MemoryScore, MemoryScoreError, ScoreKind,\n73\t};\n74\tpub use store::{IdempotencyKey, MemoryDraft, MemoryPatch, MemoryStore, MemoryStoreError};\n75\tpub use streams::{classify_stream, default_policy, MemoryStream, RankingProfileRef, StreamPolicy};\n76\tpub use transitions::{transition_status, MemoryTransitionError};\n77\t\n78\t#[derive(Debug, thiserror::Error)]\n79\tpub enum MemoryGraphError {\n80\t    #[error(transparent)]\n81\t    Parse(#[from] MemoryGraphParseError),\n82\t    #[error(transparent)]\n83\t    Link(#[from] MemoryLinkError),\n84\t    #[error(transparent)]\n85\t    Evidence(#[from] MemoryEvidenceError),\n86\t    #[error(transparent)]\n87\t    Access(#[from] MemoryAccessError),\n88\t    #[error(transparent)]\n89\t    Score(#[from] MemoryScoreError),\n90\t}\n91\t\n92\tpub fn initialize_schema(conn: &Connection) -> Result<(), rusqlite::Error> {\n93\t    conn.execute_batch(include_str!(\"schema.sql\"))\n94\t}\n95\t\n96\tpub(crate) fn encode_actor(actor: &Actor) -> (&str, Option<&str>) {\n97\t    match actor {\n98\t        Actor::Assistant { model } => (\"assistant\", Some(model.as_str())),\n99\t        Actor::User => (\"user\", None),\n100\t        Actor::Tool { name } => (\"tool\", Some(name.as_str())),\n101\t        Actor::Daemon => (\"daemon\", None),\n102\t    }\n103\t}\n104\t\n105\tpub(crate) fn decode_actor(\n106\t    kind: &str,\n107\t    detail: Option<String>,\n108\t    column_prefix: &'static str,\n109\t) -> Result<Actor, MemoryGraphParseError> {\n110\t    let detail_for_error = detail.clone();\n111\t    match (kind, detail) {\n112\t        (\"assistant\", Some(model)) => Ok(Actor::Assistant { model }),\n113\t        (\"user\", None) => Ok(Actor::User),\n114\t        (\"tool\", Some(name)) => Ok(Actor::Tool { name }),\n115\t        (\"daemon\", None) => Ok(Actor::Daemon),\n116\t        _ => Err(MemoryGraphParseError::InvalidJsonColumn {\n117\t            column: column_prefix,\n118\t            reason: format!(\n119\t                \"invalid actor columns: kind `{kind}` detail {:?}\",\n120\t                detail_for_error.as_deref()\n121\t            ),\n122\t        }),\n123\t    }\n124\t}\n125\t\n126\tpub(crate) fn encode_identity_text(identity: &Identity) -> String {\n127\t    encode_identity(identity)\n128\t}\n129\t\n130\tpub(crate) fn decode_identity_text(\n131\t    encoded: &str,\n132\t    column: &'static str,\n133\t) -> Result<Identity, MemoryGraphParseError> {\n134\t    decode_identity(encoded).map_err(|error| MemoryGraphParseError::InvalidJsonColumn {\n135\t        column,\n136\t        reason: error.to_string(),\n137\t    })\n138\t}\n139\t\n140\tpub(crate) fn encode_event_id(event_id: &EventId) -> String {\n141\t    encode_identity_text(&Identity::Event(event_id.clone()))\n142\t}\n143\t\n144\tpub(crate) fn decode_event_id(\n145\t    encoded: &str,\n146\t    column: &'static str,\n147\t) -> Result<EventId, MemoryGraphParseError> {\n148\t    match decode_identity_text(encoded, column)? {\n149\t        Identity::Event(event_id) => Ok(event_id),\n150\t        other => Err(MemoryGraphParseError::InvalidJsonColumn {\n151\t            column,\n152\t            reason: format!(\"expected event identity, got {:?}\", other.kind()),\n153\t        }),\n154\t    }\n155\t}\n156\t\n157\tpub(crate) fn encode_timestamp(value: DateTime<Utc>) -> i64 {\n158\t    value.unix_seconds()\n159\t}\n160\t\n161\tpub(crate) fn decode_timestamp(\n162\t    unix_seconds: i64,\n163\t    column: &'static str,\n164\t) -> Result<DateTime<Utc>, MemoryGraphParseError> {\n165\t    let _ = column;\n166\t    Ok(DateTime::from_unix_seconds(unix_seconds))\n167\t}\n168\t\n169\tpub(crate) fn encode_duration_secs(value: Duration) -> Result<i64, MemoryGraphParseError> {\n170\t    i64::try_from(value.as_secs()).map_err(|_| MemoryGraphParseError::InvalidJsonColumn {\n171\t        column: \"computed_from_window_secs\",\n172\t        reason: format!(\"duration {} seconds exceeds i64\", value.as_secs()),\n173\t    })\n174\t}\n175\t\n176\tpub(crate) fn decode_duration_secs(\n177\t    seconds: i64,\n178\t    column: &'static str,\n179\t) -> Result<Duration, MemoryGraphParseError> {\n180\t    let secs = u64::try_from(seconds).map_err(|_| MemoryGraphParseError::InvalidJsonColumn {\n181\t        column,\n182\t        reason: format!(\"negative duration `{seconds}`\"),\n183\t    })?;\n184\t    Ok(Duration::from_secs(secs))\n185\t}\n186\t\n187\tpub(crate) fn warn_on_fk_violation(operation: &str, error: &rusqlite::Error) {\n188\t    if let rusqlite::Error::SqliteFailure(code, _) = error {\n189\t        if code.extended_code == rusqlite::ffi::SQLITE_CONSTRAINT_FOREIGNKEY {\n190\t            warn!(operation, sqlite_error = %error, \"memory graph foreign key violation\");\n191\t        }\n192\t    }\n193\t}\n194\t\n195\tpub(crate) fn row_decode_error(\n196\t    column_index: usize,\n197\t    value_type: rusqlite::types::Type,\n198\t    error: impl std::error::Error + Send + Sync + 'static,\n199\t) -> rusqlite::Error {\n200\t    rusqlite::Error::FromSqlConversionFailure(column_index, value_type, Box::new(error))\n201\t}\n202\t"}]},"parent_tool_use_id":null,"session_id":"6c80d671-1437-429b-9e3a-231a1f740b4b","uuid":"aeea9fa7-2fcc-4006-be25-da590a67b276","timestamp":"2026-05-17T07:19:37.251Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/memory_graph/mod.rs","content":"//! Typed memory graph schema for the cognitive workspace memory redesign.\n//!\n//! This module is the Rust model surface for\n//! `docs/architecture/2026-05-16-memory-graph-schema.md`, especially\n//! `## Classes`, `## Required fields`, `## Scopes`,\n//! `## Verification statuses`, `## Freshness, validity, invalidation`,\n//! `## CounterMemory semantics`, `## Links`, `## Evidence`,\n//! `## Accesses`, `## Scores`, and `## Schema parity table`.\n\nuse std::time::Duration;\n\nuse crate::events::Actor;\nuse crate::identity::{decode_identity, encode_identity, EventId, Identity};\nuse crate::{DateTime, Utc};\nuse rusqlite::Connection;\nuse tracing::warn;\n\npub mod accesses;\npub mod classes;\npub mod evidence;\npub mod links;\npub mod migration;\npub(crate) mod migration_mapping;\npub mod replay;\npub mod scope;\npub mod scores;\npub mod store;\npub mod streams;\npub mod transitions;\n\n#[cfg(test)]\nmod contradiction_tests;\n#[cfg(test)]\nmod links_tests;\n#[cfg(test)]\nmod migration_tests;\n#[cfg(test)]\nmod replay_tests;\n#[cfg(test)]\nmod scope_tests;\n#[cfg(test)]\nmod store_tests;\n#[cfg(test)]\nmod supersession_tests;\n#[cfg(test)]\nmod tests_common;\n\npub use accesses::{\n    list_accesses_for, mark_used, record_access, MemoryAccess, MemoryAccessError, MemoryAccessId,\n};\npub use classes::{\n    decode_json_column, AssertionType, EvidenceReference, FreshnessKind, FreshnessPolicy,\n    InvalidationTrigger, MemoryAccessRecord, MemoryClass, MemoryGraphParseError,\n    MemoryLinkReference, MemoryRecord, MemoryScope, TestId, TriggerKind, ValidityCondition,\n    ValidityPredicate, VerificationStatus,\n};\npub use evidence::{\n    get_evidence_for, insert_evidence, EvidenceAnchor, MemoryEvidence, MemoryEvidenceError,\n    MemoryEvidenceId,\n};\npub use links::{\n    get_links_by_type, get_links_from, get_links_to, insert_link, MemoryLink, MemoryLinkError,\n    MemoryLinkId, MemoryLinkTarget, MemoryLinkTargetKind, MemoryLinkType,\n};\npub use migration::{MemoryMigrator, MigrationError, MigrationPlan, MigrationReport};\npub use replay::{\n    capture_replay_snapshot, decode_replay_snapshot, replay_events, MemoryReplayError,\n    MemoryReplaySnapshot,\n};\npub use scope::{ScopeClause, ScopeError, ScopeFilter, ScopePredicate};\npub use scores::{\n    latest_score, score_history, write_score, MemoryScore, MemoryScoreError, ScoreKind,\n};\npub use store::{IdempotencyKey, MemoryDraft, MemoryPatch, MemoryStore, MemoryStoreError};\npub use streams::{classify_stream, default_policy, MemoryStream, RankingProfileRef, StreamPolicy};\npub use transitions::{transition_status, MemoryTransitionError};\n\n#[derive(Debug, thiserror::Error)]\npub enum MemoryGraphError {\n    #[error(transparent)]\n    Parse(#[from] MemoryGraphParseError),\n    #[error(transparent)]\n    Link(#[from] MemoryLinkError),\n    #[error(transparent)]\n    Evidence(#[from] MemoryEvidenceError),\n    #[error(transparent)]\n    Access(#[from] MemoryAccessError),\n    #[error(transparent)]\n    Score(#[from] MemoryScoreError),\n}\n\npub fn initialize_schema(conn: &Connection) -> Result<(), rusqlite::Error> {\n    conn.execute_batch(include_str!(\"schema.sql\"))\n}\n\npub(crate) fn encode_actor(actor: &Actor) -> (&str, Option<&str>) {\n    match actor {\n        Actor::Assistant { model } => (\"assistant\", Some(model.as_str())),\n        Actor::User => (\"user\", None),\n        Actor::Tool { name } => (\"tool\", Some(name.as_str())),\n        Actor::Daemon => (\"daemon\", None),\n    }\n}\n\npub(crate) fn decode_actor(\n    kind: &str,\n    detail: Option<String>,\n    column_prefix: &'static str,\n) -> Result<Actor, MemoryGraphParseError> {\n    let detail_for_error = detail.clone();\n    match (kind, detail) {\n        (\"assistant\", Some(model)) => Ok(Actor::Assistant { model }),\n        (\"user\", None) => Ok(Actor::User),\n        (\"tool\", Some(name)) => Ok(Actor::Tool { name }),\n        (\"daemon\", None) => Ok(Actor::Daemon),\n        _ => Err(MemoryGraphParseError::InvalidJsonColumn {\n            column: column_prefix,\n            reason: format!(\n                \"invalid actor columns: kind `{kind}` detail {:?}\",\n                detail_for_error.as_deref()\n            ),\n        }),\n    }\n}\n\npub(crate) fn encode_identity_text(identity: &Identity) -> String {\n    encode_identity(identity)\n}\n\npub(crate) fn decode_identity_text(\n    encoded: &str,\n    column: &'static str,\n) -> Result<Identity, MemoryGraphParseError> {\n    decode_identity(encoded).map_err(|error| MemoryGraphParseError::InvalidJsonColumn {\n        column,\n        reason: error.to_string(),\n    })\n}\n\npub(crate) fn encode_event_id(event_id: &EventId) -> String {\n    encode_identity_text(&Identity::Event(event_id.clone()))\n}\n\npub(crate) fn decode_event_id(\n    encoded: &str,\n    column: &'static str,\n) -> Result<EventId, MemoryGraphParseError> {\n    match decode_identity_text(encoded, column)? {\n        Identity::Event(event_id) => Ok(event_id),\n        other => Err(MemoryGraphParseError::InvalidJsonColumn {\n            column,\n            reason: format!(\"expected event identity, got {:?}\", other.kind()),\n        }),\n    }\n}\n\npub(crate) fn encode_timestamp(value: DateTime<Utc>) -> i64 {\n    value.unix_seconds()\n}\n\npub(crate) fn decode_timestamp(\n    unix_seconds: i64,\n    column: &'static str,\n) -> Result<DateTime<Utc>, MemoryGraphParseError> {\n    let _ = column;\n    Ok(DateTime::from_unix_seconds(unix_seconds))\n}\n\npub(crate) fn encode_duration_secs(value: Duration) -> Result<i64, MemoryGraphParseError> {\n    i64::try_from(value.as_secs()).map_err(|_| MemoryGraphParseError::InvalidJsonColumn {\n        column: \"computed_from_window_secs\",\n        reason: format!(\"duration {} seconds exceeds i64\", value.as_secs()),\n    })\n}\n\npub(crate) fn decode_duration_secs(\n    seconds: i64,\n    column: &'static str,\n) -> Result<Duration, MemoryGraphParseError> {\n    let secs = u64::try_from(seconds).map_err(|_| MemoryGraphParseError::InvalidJsonColumn {\n        column,\n        reason: format!(\"negative duration `{seconds}`\"),\n    })?;\n    Ok(Duration::from_secs(secs))\n}\n\npub(crate) fn warn_on_fk_violation(operation: &str, error: &rusqlite::Error) {\n    if let rusqlite::Error::SqliteFailure(code, _) = error {\n        if code.extended_code == rusqlite::ffi::SQLITE_CONSTRAINT_FOREIGNKEY {\n            warn!(operation, sqlite_error = %error, \"memory graph foreign key violation\");\n        }\n    }\n}\n\npub(crate) fn row_decode_error(\n    column_index: usize,\n    value_type: rusqlite::types::Type,\n    error: impl std::error::Error + Send + Sync + 'static,\n) -> rusqlite::Error {\n    rusqlite::Error::FromSqlConversionFailure(column_index, value_type, Box::new(error))\n}\n","numLines":202,"startLine":1,"totalLines":202}}}
