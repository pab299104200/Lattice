{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CMjTLPwe3LnEV7hxsa7Dxz","type":"tool_result","content":"1\tuse crate::events::{\n2\t    EventPayload, MemoryCreatedPayload, MemoryInvalidatedPayload, MemoryUpdatedPayload,\n3\t};\n4\tuse crate::memory_graph::store::MemoryScopeState;\n5\tuse crate::memory_graph::tests_common::{idem, memory_evidence, row_count, TestHarness};\n6\tuse crate::memory_graph::{\n7\t    get_evidence_for, transition_status, MemoryClass, MemoryPatch, MemoryScope,\n8\t    MemoryTransitionError, VerificationStatus,\n9\t};\n10\t\n11\t#[test]\n12\tfn create_and_get_round_trip_persists_initial_evidence_and_event() {\n13\t    let harness = TestHarness::new();\n14\t    let created = harness\n15\t        .store\n16\t        .create(\n17\t            harness\n18\t                .draft(\"round-trip\")\n19\t                .with_initial_evidence(memory_evidence(\"seed\"))\n20\t                .into(),\n21\t            idem(\"create-round-trip\"),\n22\t        )\n23\t        .unwrap();\n24\t\n25\t    let loaded = harness\n26\t        .store\n27\t        .get(&created.memory_id, &harness.branch_scope())\n28\t        .unwrap();\n29\t    assert_eq!(loaded.content, \"memory round-trip\");\n30\t    assert_eq!(loaded.class, MemoryClass::Observation);\n31\t    assert_eq!(loaded.verification_status, VerificationStatus::Unverified);\n32\t    assert_eq!(loaded.memory_id, created.memory_id);\n33\t    assert_eq!(loaded.provenance_event_ids.len(), 1);\n34\t    assert!(loaded\n35\t        .evidence_references\n36\t        .iter()\n37\t        .any(|reference| matches!(reference.target, crate::events::StableRef::EventRef(_))));\n38\t\n39\t    let evidence = get_evidence_for(&harness.conn(), &created.memory_id).unwrap();\n40\t    assert_eq!(evidence.len(), 2);\n41\t    assert!(evidence\n42\t        .iter()\n43\t        .any(|row| row.evidence_id.as_str() == \"seed\"));\n44\t    assert!(matches!(\n45\t        harness.latest_event_payload(),\n46\t        EventPayload::MemoryCreated(MemoryCreatedPayload { memory_id, class, stream, scope, idempotency_key, .. })\n47\t            if memory_id == created.memory_id\n48\t                && class == \"observation\"\n49\t                && stream == \"code_topology\"\n50\t                && scope == \"branch\"\n51\t                && idempotency_key == \"create-round-trip\"\n52\t    ));\n53\t}\n54\t\n55\t#[test]\n56\tfn create_with_same_idempotency_key_returns_existing_record() {\n57\t    let harness = TestHarness::new();\n58\t    let first = harness\n59\t        .store\n60\t        .create(harness.draft(\"dedupe-a\").into(), idem(\"dedupe-create\"))\n61\t        .unwrap();\n62\t    let second = harness\n63\t        .store\n64\t        .create(harness.draft(\"dedupe-b\").into(), idem(\"dedupe-create\"))\n65\t        .unwrap();\n66\t\n67\t    assert_eq!(first.memory_id, second.memory_id);\n68\t    assert_eq!(row_count(&harness.conn(), \"memories\"), 1);\n69\t    assert_eq!(row_count(&harness.conn(), \"memory_idempotency\"), 1);\n70\t}\n71\t\n72\t#[test]\n73\tfn update_preserves_immutable_fields() {\n74\t    let harness = TestHarness::new();\n75\t    let created = harness\n76\t        .store\n77\t        .create(harness.draft(\"patch-me\").into(), idem(\"update-create\"))\n78\t        .unwrap();\n79\t\n80\t    let updated = harness\n81\t        .store\n82\t        .update(\n83\t            &created.memory_id,\n84\t            MemoryPatch {\n85\t                content: Some(\"memory updated\".to_string()),\n86\t                confidence: Some(0.9),\n87\t                freshness_policy: None,\n88\t                validity_conditions: None,\n89\t                invalidation_triggers: None,\n90\t                scope: Some(MemoryScopeState {\n91\t                    scope: MemoryScope::Repo,\n92\t                    scope_session_id: None,\n93\t                    scope_branch: None,\n94\t                    scope_workspace_id: Some(\"workspace\".to_string()),\n95\t                    scope_user_id: None,\n96\t                    scope_org_id: None,\n97\t                }),\n98\t            },\n99\t            Some(memory_evidence(\"update-evidence\")),\n100\t            idem(\"update-once\"),\n101\t        )\n102\t        .unwrap();\n103\t\n104\t    assert_eq!(updated.memory_id, created.memory_id);\n105\t    assert_eq!(updated.created_at, created.created_at);\n106\t    assert_eq!(updated.created_by, created.created_by);\n107\t    assert_eq!(updated.verification_status, created.verification_status);\n108\t    assert_eq!(updated.content, \"memory updated\");\n109\t    assert_eq!(updated.confidence, 0.9);\n110\t    assert_eq!(updated.scope, MemoryScope::Repo);\n111\t\n112\t    let evidence = get_evidence_for(&harness.conn(), &created.memory_id).unwrap();\n113\t    assert!(evidence\n114\t        .iter()\n115\t        .any(|row| row.evidence_id.as_str() == \"update-evidence\"));\n116\t    assert!(matches!(\n117\t        harness.latest_event_payload(),\n118\t        EventPayload::MemoryUpdated(MemoryUpdatedPayload { memory_id, update_summary, .. })\n119\t            if memory_id == created.memory_id && update_summary == \"memory updated\"\n120\t    ));\n121\t}\n122\t\n123\t#[test]\n124\tfn soft_delete_marks_memory_invalidated_and_keeps_row_readable() {\n125\t    let harness = TestHarness::new();\n126\t    let created = harness\n127\t        .store\n128\t        .create(harness.draft(\"delete-me\").into(), idem(\"delete-create\"))\n129\t        .unwrap();\n130\t\n131\t    harness\n132\t        .store\n133\t        .delete(&created.memory_id, \"user request\")\n134\t        .unwrap();\n135\t\n136\t    let loaded = harness\n137\t        .store\n138\t        .get(&created.memory_id, &harness.branch_scope())\n139\t        .unwrap();\n140\t    assert_eq!(loaded.verification_status, VerificationStatus::Invalidated);\n141\t    assert_eq!(row_count(&harness.conn(), \"memory_tombstones\"), 1);\n142\t    assert!(matches!(\n143\t        harness.lat