import * as cp from 'child_process';
import * as fs from 'fs';
import * as path from 'path';

async function main(): Promise<void> {
    const extensionPath = path.resolve(__dirname, '..', '..');
    const workspacePath = path.resolve(extensionPath, '..');
    const testsPath = path.resolve(__dirname, 'suite', 'index.js');
    const sandboxRoot = path.join(extensionPath, '.vscode-test');
    const userDataDir = path.join(sandboxRoot, 'user-data');
    const extensionsDir = path.join(sandboxRoot, 'extensions');
    const resultsPath = path.join(sandboxRoot, 'results.json');
    if (fs.existsSync(sandboxRoot)) {
        fs.rmSync(sandboxRoot, { recursive: true, force: true });
    }
    fs.mkdirSync(userDataDir, { recursive: true });
    fs.mkdirSync(extensionsDir, { recursive: true });

    const args = [
        '-a',
        'code',
        '--user-data-dir', userDataDir,
        '--extensions-dir', extensionsDir,
        '--new-window',
        '--wait',
        '--disable-gpu',
        '--disable-chromium-sandbox',
        '--skip-welcome',
        '--disable-workspace-trust',
        `--extensionDevelopmentPath=${extensionPath}`,
        `--extensionTestsPath=${testsPath}`,
        workspacePath,
    ];
    const exitCode = await runCodeProcess(args, resultsPath);
    const results = readResults(resultsPath);
    for (const test of results.tests) {
        console.log(`${test.status === 'passed' ? 'PASS' : 'FAIL'} ${test.name}`);
        if (test.error) {
            console.error(test.error);
        }
    }
    if (exitCode !== 0) {
        throw new Error(`VS Code extension tests failed with exit code ${exitCode}`);
    }
}

function runCodeProcess(args: string[], resultsPath: string): Promise<number> {
    return new Promise((resolve, reject) => {
        const child = cp.spawn('xvfb-run', args, {
            env: {
                ...process.env,
                LATTICE_EXTENSION_TEST: '1',
                LATTICE_EXTENSION_TEST_RESULTS: resultsPath,
            },
            stdio: 'inherit',
        });
        child.once('error', reject);
        child.once('exit', (code) => {
            resolve(code ?? 1);
        });
    });
}

function readResults(resultsPath: string): { tests: Array<{ name: string; status: string; error?: string }> } {
    if (!fs.existsSync(resultsPath)) {
        throw new Error(`Extension test results were not written: ${resultsPath}`);
    }
    return JSON.parse(fs.readFileSync(resultsPath, 'utf8')) as {
        tests: Array<{ name: string; status: string; error?: string }>;
    };
}

void main().catch((error) => {
    console.error(error instanceof Error ? error.stack ?? error.message : String(error));
    process.exit(1);
});

