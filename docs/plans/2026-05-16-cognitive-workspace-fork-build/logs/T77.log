+        if (entry.isDirectory()) {
+            if (entry.name !== 'suite') {
+                files.push(...collectTestFiles(absolute));
+            }
+            continue;
+        }
+        if (entry.name.endsWith('.test.js')) {
+            files.push(absolute);
+        }
+    }
+    return files.sort();
