{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FzUq63CdA2iG78NUkhrrpe","type":"tool_result","content":"1\tuse std::path::{Path, PathBuf};\n2\tuse std::sync::Arc;\n3\tuse std::time::{Duration, Instant};\n4\t\n5\tuse rusqlite::Connection;\n6\tuse serde_json::Value;\n7\tuse tempfile::tempdir;\n8\t\n9\tuse super::{\n10\t    ConsolidationConfig, ConsolidationJobMode, ConsolidationJobRuntime, EpisodeOutcome,\n11\t    SessionConsolidationConfig, SessionConsolidationOutcome, SessionConsolidator,\n12\t};\n13\tuse crate::events::{\n14\t    Actor, AssistantTaskStartedPayload, BranchRef, CompactSummary, EventKind, EventPayload,\n15\t    EventReader, EventStore, EventWriter, FlushPolicy, PartialEnvelope, SessionId, TaskId,\n16\t    ToolCalledPayload, WorkflowSucceededPayload,\n17\t};\n18\tuse crate::identity::FileId;\n19\tuse crate::memory::MemoryStore;\n20\t\n21\t#[test]\n22\tfn small_task_slice_emits_create_memory_proposal_with_deterministic_summary() {\n23\t    let fixture = FileFixture::new();\n24\t    fixture.append_small_task(\"task-small\");\n25\t    let mut consolidator = fixture.consolidator();\n26\t    let outcome = consolidator\n27\t        .on_task_complete(\n28\t            \"workspace-main\",\n29\t            &task_id(\"task-small\"),\n30\t            EpisodeOutcome::Success,\n31\t        )\n32\t        .expect(\"task consolidates\");\n33\t\n34\t    match outcome {\n35\t        SessionConsolidationOutcome::Proposed {\n36\t            proposal_kind,\n37\t            proposal_id,\n38\t            ..\n39\t        } => {\n40\t            assert_eq!(proposal_kind.as_str(), \"create_memory\");\n41\t            let proposal = load_proposal(&fixture.memory_db_path, &proposal_id);\n42\t            assert_eq!(proposal.0, \"create_memory\");\n43\t            assert_eq!(\n44\t                proposal\n45\t                    .1\n46\t                    .get(\"summary_text\")\n47\t                    .and_then(Value::as_str)\n48\t                    .expect(\"summary text present\"),\n49\t                \"Task task-small: 1 tools, 1 files, outcome=success\"\n50\t            );\n51\t            assert_eq!(\n52\t                proposal\n53\t                    .1\n54\t                    .get(\"tools_used\")\n55\t                    .and_then(Value::as_array)\n56\t                    .expect(\"tools array present\")\n57\t                    .len(),\n58\t                1\n59\t            );\n60\t        }\n61\t        other => panic!(\"expected proposed outcome, got {other:?}\"),\n62\t    }\n63\t}\n64\t\n65\t#[test]\n66\tfn oversized_task_slice_redirects_to_background_mode() {\n67\t    let fixture = FileFixture::new();\n68\t    fixture.append_large_task(\"task-large\", 250);\n69\t    let mut consolidator = fixture.consolidator();\n70\t    let outcome = consolidator\n71\t        .on_task_complete(\n72\t            \"workspace-main\",\n73\t            &task_id(\"task-large\"),\n74\t            EpisodeOutcome::Success,\n75\t        )\n76\t        .expect(\"task redirect succeeds\");\n77\t\n78\t    match outcome {\n79\t        SessionConsolidationOutcome::RedirectedToBackground { job_id, .. } => {\n80\t            let (mode, status) = load_job(&fixture.memory_db_path, &job_id);\n81\t            assert_eq!(mode, ConsolidationJobMode::Background.as_str());\n82\t            assert_eq!(status, \"queued\");\n83\t        }\n84\t        other => panic!(\"expected redirect outcome, got {other:?}\"),\n85\t    }\n86\t}\n87\t\n88\t#[test]\n89\tfn session_consolidation_never_mutates_memories_directly() {\n90\t    let fixture = FileFixture::new();\n91\t    fixture.append_small_task(\"task-no-mutate\");\n92\t    let mut consolidator = fixture.consolidator();\n93\t    assert_eq!(\n94\t        consolidator\n95\t            .memory_store()\n96\t            .list_all()\n97\t            .expect(\"memories list\")\n98\t            .len(),\n99\t        0\n100\t    );\n101\t\n102\t    consolidator\n103\t        .on_task_complete(\n104\t            \"workspace-main\",\n105\t            &task_id(\"task-no-mutate\"),\n106\t            EpisodeOutcome::Success,\n107\t        )\n108\t        .expect(\"task consolidates\");\n109\t\n110\t    assert_eq!(\n111\t        consolidator\n112\t            .memory_store()\n113\t            .list_all()\n114\t            .expect(\"memories list\")\n115\t            .len(),\n116\t        0\n117\t    );\n118\t}\n119\t\n120\t#[test]\n121\tfn session_consolidation_hot_path_stays_under_five_milliseconds_p99() {\n122\t    let mut fixture = BudgetFixture::new();\n123\t    let mut samples = Vec::new();\n124\t\n125\t    for index in 0..16 {\n126\t        let task = format!(\"task-budget-warmup-{index}\");\n127\t        fixture.append_small_task(&task);\n128\t        fixture\n129\t            .consolidator\n130\t            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n131\t            .expect(\"warmup task consolidates\");\n132\t    }\n133\t\n134\t    for index in 0..64 {\n135\t        let task = format!(\"task-budget-{index}\");\n136\t        fixture.append_small_task(&task);\n137\t        let started = Instant::now();\n138\t        fixture\n139\t            .consolidator\n140\t            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n141\t            .expect(\"task consolidates\");\n142\t        samples.push(started.elapsed());\n143\t    }\n144\t\n145\t    samples.sort();\n146\t    let p99 = percentile_99(&samples);\n147\t    debug_assert!(p99 <= Duration::from_millis(5));\n148\t    assert!(p99 <= Duration::from_millis(5), \"p99 was {:?}\", p99);\n149\t}\n150\t\n151\t#[test]\n152\tfn session_module_forbids_llm_references() {\n153\t    let source = std::fs::read_to_string(session_source_path()).expect(\"session source reads\");\n154\t    assert!(!source.contains(\"consolidation::llm\"));\n155\t    assert!(!source.contains(\"llm::\"));\n156\t}\n157\t\n158\tstruct FileFixture {\n159\t    _dir: tempfile::TempDir,\n160\t    memory_db_path: PathBuf,\n161\t    event_store: Arc<EventStore>,\n162\t    writer: EventWriter,\n163\t}\n164\t\n165\timpl FileFixture {\n166\t    fn new() -> Self {\n167\t        let dir = tempdir().expect(\"tempdir\");\n168\t        let memory_db_path = dir.path().join(\"memories.sqlite\");\n169\t        let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n170\t        let writer = EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n171\t            .with_flush_policy(FlushPolicy::Sync);\n172\t        Self {\n173\t            _dir: dir,\n174\t            memory_db_path,\n175\t            event_store,\n176\t            writer,\n177\t        }\n178\t    }\n179\t\n180\t    fn consolidator(&self) -> SessionConsolidator {\n181\t        SessionConsolidator::new(\n182\t            EventReader::new(self.event_store.clone()),\n183\t            MemoryStore::open(&self.memory_db_path).expect(\"memory store opens\"),\n184\t            ConsolidationJobRuntime::new(\n185\t                Connection::open(&self.memory_db_path).expect(\"consolidation db opens\"),\n186\t                ConsolidationConfig::default(),\n187\t            )\n188\t            .expect(\"runtime opens\"),\n189\t            SessionConsolidationConfig::default(),\n190\t        )\n191\t    }\n192\t\n193\t    fn append_small_task(&self, task_id_value: &str) {\n194\t        let task_id = task_id(task_id_value);\n195\t        self.append_event(\n196\t            task_id.clone(),\n197\t            EventKind::AssistantTaskStarted,\n198\t            EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n199\t                context_handle_id: None,\n200\t                seed_event_ids: Vec::new(),\n201\t                initial_memory_ids: Vec::new(),\n202\t                objective: \"small task\".to_string(),\n203\t            }),\n204\t            Vec::new(),\n205\t            \"Task started\",\n206\t        );\n207\t        self.append_event(\n208\t            task_id.clone(),\n209\t            EventKind::ToolCalled,\n210\t            EventPayload::ToolCalled(ToolCalledPayload {\n211\t                call_id: format!(\"call-{task_id_value}\"),\n212\t                tool_name: \"get_context_capsule\".to_string(),\n213\t                context_handle_id: None,\n214\t                source_event_id: None,\n215\t                input_summary: \"query=small\".to_string(),\n216\t            }),\n217\t            vec![crate::events::StableRef::FileRef(file_id(\"src/lib.rs\"))],\n218\t            \"Tool called\",\n219\t        );\n220\t        self.append_event(\n221\t            task_id,\n222\t            EventKind::WorkflowSucceeded,\n223\t            EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n224\t                workflow_name: \"prepare_change\".to_string(),\n225\t                terminal_event_id: None,\n226\t                output_context_handle_id: None,\n227\t                memory_ids: Vec::new(),\n228\t                result_summary: \"success\".to_string(),\n229\t            }),\n230\t            Vec::new(),\n231\t            \"Workflow succeeded\",\n232\t        );\n233\t    }\n234\t\n235\t    fn append_large_task(&self, task_id_value: &str, event_count: usize) {\n236\t        let task_id = task_id(task_id_value);\n237\t        self.append_event(\n238\t            task_id.clone(),\n239\t            EventKind::AssistantTaskStarted,\n240\t            EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n241\t                context_handle_id: None,\n242\t                seed_event_ids: Vec::new(),\n243\t                initial_memory_ids: Vec::new(),\n244\t                objective: \"large task\".to_string(),\n245\t            }),\n246\t            Vec::new(),\n247\t            \"Task started\",\n248\t        );\n249\t        for index in 0..event_count.saturating_sub(2) {\n250\t            self.append_event(\n251\t                task_id.clone(),\n252\t                EventKind::ToolCalled,\n253\t                EventPayload::ToolCalled(ToolCalledPayload {\n254\t                    call_id: format!(\"call-{task_id_value}-{index}\"),\n255\t                    tool_name: \"get_context_capsule\".to_string(),\n256\t                    context_handle_id: None,\n257\t                    source_event_id: None,\n258\t                    input_summary: \"query=scan\".to_string(),\n259\t                }),\n260\t                vec![crate::events::StableRef::FileRef(file_id(&format!(\n261\t                    \"src/file-{index}.rs\"\n262\t                )))],\n263\t                \"Tool called\",\n264\t            );\n265\t        }\n266\t        self.append_event(\n267\t            task_id,\n268\t            EventKind::WorkflowSucceeded,\n269\t            EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n270\t                workflow_name: \"prepare_change\".to_string(),\n271\t                terminal_event_id: None,\n272\t                output_context_handle_id: None,\n273\t                memory_ids: Vec::new(),\n274\t                result_summary: \"success\".to_string(),\n275\t            }),\n276\t            Vec::new(),\n277\t            \"Workflow succeeded\",\n278\t        );\n279\t    }\n280\t\n281\t    fn append_event(\n282\t        &self,\n283\t        task_id: TaskId,\n284\t        kind: EventKind,\n285\t        payload: EventPayload,\n286\t        references: Vec<crate::events::StableRef>,\n287\t        summary: &str,\n288\t    ) {\n289\t        self.writer\n290\t            .append(PartialEnvelope {\n291\t                workspace_id: None,\n292\t                branch: BranchRef {\n293\t                    name: \"main\".to_string(),\n294\t                },\n295\t                session_id: SessionId {\n296\t                    value: \"session-main\".to_string(),\n297\t                },\n298\t                task_id: Some(task_id),\n299\t                actor: Actor::Daemon,\n300\t                kind,\n301\t                references,\n302\t                summary: CompactSummary::new(summary).expect(\"summary fits\"),\n303\t                payload,\n304\t            })\n305\t            .expect(\"event appends\");\n306\t    }\n307\t}\n308\t\n309\tstruct BudgetFixture {\n310\t    writer: EventWriter,\n311\t    consolidator: SessionConsolidator,\n312\t}\n313\t\n314\timpl BudgetFixture {\n315\t    fn new() -> Self {\n316\t        let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n317\t        let writer = EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n318\t            .with_flush_policy(FlushPolicy::Sync);\n319\t        let consolidator = SessionConsolidator::new(\n320\t            EventReader::new(event_store.clone()),\n321\t            MemoryStore::open_in_memory().expect(\"memory store opens\"),\n322\t            ConsolidationJobRuntime::new(\n323\t                Connection::open_in_memory().expect(\"consolidation db opens\"),\n324\t                ConsolidationConfig::default(),\n325\t            )\n326\t            .expect(\"runtime opens\"),\n327\t            SessionConsolidationConfig::default(),\n328\t        );\n329\t        Self {\n330\t            writer,\n331\t            consolidator,\n332\t        }\n333\t    }\n334\t\n335\t    fn append_small_task(&self, task_id_value: &str) {\n336\t        let task_id = task_id(task_id_value);\n337\t        self.writer\n338\t            .append(PartialEnvelope {\n339\t                workspace_id: None,\n340\t                branch: BranchRef {\n341\t                    name: \"main\".to_string(),\n342\t                },\n343\t                session_id: SessionId {\n344\t                    value: \"session-budget\".to_string(),\n345\t                },\n346\t                task_id: Some(task_id.clone()),\n347\t                actor: Actor::Daemon,\n348\t                kind: EventKind::AssistantTaskStarted,\n349\t                references: Vec::new(),\n350\t                summary: CompactSummary::new(\"Task started\").expect(\"summary fits\"),\n351\t                payload: EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n352\t                    context_handle_id: None,\n353\t                    seed_event_ids: Vec::new(),\n354\t                    initial_memory_ids: Vec::new(),\n355\t                    objective: \"budget\".to_string(),\n356\t                }),\n357\t            })\n358\t            .expect(\"event appends\");\n359\t        self.writer\n360\t            .append(PartialEnvelope {\n361\t                workspace_id: None,\n362\t                branch: BranchRef {\n363\t                    name: \"main\".to_string(),\n364\t                },\n365\t                session_id: SessionId {\n366\t                    value: \"session-budget\".to_string(),\n367\t                },\n368\t                task_id: Some(task_id.clone()),\n369\t                actor: Actor::Daemon,\n370\t                kind: EventKind::ToolCalled,\n371\t                references: vec![crate::events::StableRef::FileRef(file_id(\"src/lib.rs\"))],\n372\t                summary: CompactSummary::new(\"Tool called\").expect(\"summary fits\"),\n373\t                payload: EventPayload::ToolCalled(ToolCalledPayload {\n374\t                    call_id: format!(\"call-{task_id_value}\"),\n375\t                    tool_name: \"get_context_capsule\".to_string(),\n376\t                    context_handle_id: None,\n377\t                    source_event_id: None,\n378\t                    input_summary: \"budget\".to_string(),\n379\t                }),\n380\t            })\n381\t            .expect(\"event appends\");\n382\t        self.writer\n383\t            .append(PartialEnvelope {\n384\t                workspace_id: None,\n385\t                branch: BranchRef {\n386\t                    name: \"main\".to_string(),\n387\t                },\n388\t                session_id: SessionId {\n389\t                    value: \"session-budget\".to_string(),\n390\t                },\n391\t                task_id: Some(task_id),\n392\t                actor: Actor::Daemon,\n393\t                kind: EventKind::WorkflowSucceeded,\n394\t                references: Vec::new(),\n395\t                summary: CompactSummary::new(\"Workflow succeeded\").expect(\"summary fits\"),\n396\t                payload: EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n397\t                    workflow_name: \"prepare_change\".to_string(),\n398\t                    terminal_event_id: None,\n399\t                    output_context_handle_id: None,\n400\t                    memory_ids: Vec::new(),\n401\t                    result_summary: \"success\".to_string(),\n402\t                }),\n403\t            })\n404\t            .expect(\"event appends\");\n405\t    }\n406\t}\n407\t\n408\tfn load_proposal(path: &Path, proposal_id: &str) -> (String, Value) {\n409\t    let conn = Connection::open(path).expect(\"db opens\");\n410\t    conn.query_row(\n411\t        \"SELECT proposal_kind, proposed_state FROM consolidation_proposals WHERE proposal_id = ?1\",\n412\t        [proposal_id],\n413\t        |row| Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?)),\n414\t    )\n415\t    .map(|(kind, proposed_state)| {\n416\t        (\n417\t            kind,\n418\t            serde_json::from_str::<Value>(&proposed_state).expect(\"proposal json parses\"),\n419\t        )\n420\t    })\n421\t    .expect(\"proposal loads\")\n422\t}\n423\t\n424\tfn load_job(path: &Path, job_id: &str) -> (String, String) {\n425\t    let conn = Connection::open(path).expect(\"db opens\");\n426\t    conn.query_row(\n427\t        \"SELECT mode, status FROM consolidation_jobs WHERE job_id = ?1\",\n428\t        [job_id],\n429\t        |row| Ok((row.get(0)?, row.get(1)?)),\n430\t    )\n431\t    .expect(\"job loads\")\n432\t}\n433\t\n434\tfn percentile_99(samples: &[Duration]) -> Duration {\n435\t    let index = ((samples.len() as f64 * 0.99).ceil() as usize).saturating_sub(1);\n436\t    samples[index]\n437\t}\n438\t\n439\tfn file_id(path: &str) -> FileId {\n440\t    FileId {\n441\t        workspace_id: \"workspace-main\".to_string(),\n442\t        repo_relative_path: path.to_string(),\n443\t        content_hash: \"hash\".to_string(),\n444\t    }\n445\t}\n446\t\n447\tfn task_id(value: &str) -> TaskId {\n448\t    TaskId {\n449\t        value: value.to_string(),\n450\t    }\n451\t}\n452\t\n453\tfn session_source_path() -> PathBuf {\n454\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n455\t        .join(\"src\")\n456\t        .join(\"consolidation\")\n457\t        .join(\"session.rs\")\n458\t}\n459\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"344d63c8-767a-4bf9-b5d0-ba24c28297b1","timestamp":"2026-05-17T11:43:15.025Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/session_tests.rs","content":"use std::path::{Path, PathBuf};\nuse std::sync::Arc;\nuse std::time::{Duration, Instant};\n\nuse rusqlite::Connection;\nuse serde_json::Value;\nuse tempfile::tempdir;\n\nuse super::{\n    ConsolidationConfig, ConsolidationJobMode, ConsolidationJobRuntime, EpisodeOutcome,\n    SessionConsolidationConfig, SessionConsolidationOutcome, SessionConsolidator,\n};\nuse crate::events::{\n    Actor, AssistantTaskStartedPayload, BranchRef, CompactSummary, EventKind, EventPayload,\n    EventReader, EventStore, EventWriter, FlushPolicy, PartialEnvelope, SessionId, TaskId,\n    ToolCalledPayload, WorkflowSucceededPayload,\n};\nuse crate::identity::FileId;\nuse crate::memory::MemoryStore;\n\n#[test]\nfn small_task_slice_emits_create_memory_proposal_with_deterministic_summary() {\n    let fixture = FileFixture::new();\n    fixture.append_small_task(\"task-small\");\n    let mut consolidator = fixture.consolidator();\n    let outcome = consolidator\n        .on_task_complete(\n            \"workspace-main\",\n            &task_id(\"task-small\"),\n            EpisodeOutcome::Success,\n        )\n        .expect(\"task consolidates\");\n\n    match outcome {\n        SessionConsolidationOutcome::Proposed {\n            proposal_kind,\n            proposal_id,\n            ..\n        } => {\n            assert_eq!(proposal_kind.as_str(), \"create_memory\");\n            let proposal = load_proposal(&fixture.memory_db_path, &proposal_id);\n            assert_eq!(proposal.0, \"create_memory\");\n            assert_eq!(\n                proposal\n                    .1\n                    .get(\"summary_text\")\n                    .and_then(Value::as_str)\n                    .expect(\"summary text present\"),\n                \"Task task-small: 1 tools, 1 files, outcome=success\"\n            );\n            assert_eq!(\n                proposal\n                    .1\n                    .get(\"tools_used\")\n                    .and_then(Value::as_array)\n                    .expect(\"tools array present\")\n                    .len(),\n                1\n            );\n        }\n        other => panic!(\"expected proposed outcome, got {other:?}\"),\n    }\n}\n\n#[test]\nfn oversized_task_slice_redirects_to_background_mode() {\n    let fixture = FileFixture::new();\n    fixture.append_large_task(\"task-large\", 250);\n    let mut consolidator = fixture.consolidator();\n    let outcome = consolidator\n        .on_task_complete(\n            \"workspace-main\",\n            &task_id(\"task-large\"),\n            EpisodeOutcome::Success,\n        )\n        .expect(\"task redirect succeeds\");\n\n    match outcome {\n        SessionConsolidationOutcome::RedirectedToBackground { job_id, .. } => {\n            let (mode, status) = load_job(&fixture.memory_db_path, &job_id);\n            assert_eq!(mode, ConsolidationJobMode::Background.as_str());\n            assert_eq!(status, \"queued\");\n        }\n        other => panic!(\"expected redirect outcome, got {other:?}\"),\n    }\n}\n\n#[test]\nfn session_consolidation_never_mutates_memories_directly() {\n    let fixture = FileFixture::new();\n    fixture.append_small_task(\"task-no-mutate\");\n    let mut consolidator = fixture.consolidator();\n    assert_eq!(\n        consolidator\n            .memory_store()\n            .list_all()\n            .expect(\"memories list\")\n            .len(),\n        0\n    );\n\n    consolidator\n        .on_task_complete(\n            \"workspace-main\",\n            &task_id(\"task-no-mutate\"),\n            EpisodeOutcome::Success,\n        )\n        .expect(\"task consolidates\");\n\n    assert_eq!(\n        consolidator\n            .memory_store()\n            .list_all()\n            .expect(\"memories list\")\n            .len(),\n        0\n    );\n}\n\n#[test]\nfn session_consolidation_hot_path_stays_under_five_milliseconds_p99() {\n    let mut fixture = BudgetFixture::new();\n    let mut samples = Vec::new();\n\n    for index in 0..16 {\n        let task = format!(\"task-budget-warmup-{index}\");\n        fixture.append_small_task(&task);\n        fixture\n            .consolidator\n            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n            .expect(\"warmup task consolidates\");\n    }\n\n    for index in 0..64 {\n        let task = format!(\"task-budget-{index}\");\n        fixture.append_small_task(&task);\n        let started = Instant::now();\n        fixture\n            .consolidator\n            .on_task_complete(\"workspace-main\", &task_id(&task), EpisodeOutcome::Success)\n            .expect(\"task consolidates\");\n        samples.push(started.elapsed());\n    }\n\n    samples.sort();\n    let p99 = percentile_99(&samples);\n    debug_assert!(p99 <= Duration::from_millis(5));\n    assert!(p99 <= Duration::from_millis(5), \"p99 was {:?}\", p99);\n}\n\n#[test]\nfn session_module_forbids_llm_references() {\n    let source = std::fs::read_to_string(session_source_path()).expect(\"session source reads\");\n    assert!(!source.contains(\"consolidation::llm\"));\n    assert!(!source.contains(\"llm::\"));\n}\n\nstruct FileFixture {\n    _dir: tempfile::TempDir,\n    memory_db_path: PathBuf,\n    event_store: Arc<EventStore>,\n    writer: EventWriter,\n}\n\nimpl FileFixture {\n    fn new() -> Self {\n        let dir = tempdir().expect(\"tempdir\");\n        let memory_db_path = dir.path().join(\"memories.sqlite\");\n        let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n        let writer = EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n            .with_flush_policy(FlushPolicy::Sync);\n        Self {\n            _dir: dir,\n            memory_db_path,\n            event_store,\n            writer,\n        }\n    }\n\n    fn consolidator(&self) -> SessionConsolidator {\n        SessionConsolidator::new(\n            EventReader::new(self.event_store.clone()),\n            MemoryStore::open(&self.memory_db_path).expect(\"memory store opens\"),\n            ConsolidationJobRuntime::new(\n                Connection::open(&self.memory_db_path).expect(\"consolidation db opens\"),\n                ConsolidationConfig::default(),\n            )\n            .expect(\"runtime opens\"),\n            SessionConsolidationConfig::default(),\n        )\n    }\n\n    fn append_small_task(&self, task_id_value: &str) {\n        let task_id = task_id(task_id_value);\n        self.append_event(\n            task_id.clone(),\n            EventKind::AssistantTaskStarted,\n            EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n                context_handle_id: None,\n                seed_event_ids: Vec::new(),\n                initial_memory_ids: Vec::new(),\n                objective: \"small task\".to_string(),\n            }),\n            Vec::new(),\n            \"Task started\",\n        );\n        self.append_event(\n            task_id.clone(),\n            EventKind::ToolCalled,\n            EventPayload::ToolCalled(ToolCalledPayload {\n                call_id: format!(\"call-{task_id_value}\"),\n                tool_name: \"get_context_capsule\".to_string(),\n                context_handle_id: None,\n                source_event_id: None,\n                input_summary: \"query=small\".to_string(),\n            }),\n            vec![crate::events::StableRef::FileRef(file_id(\"src/lib.rs\"))],\n            \"Tool called\",\n        );\n        self.append_event(\n            task_id,\n            EventKind::WorkflowSucceeded,\n            EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n                workflow_name: \"prepare_change\".to_string(),\n                terminal_event_id: None,\n                output_context_handle_id: None,\n                memory_ids: Vec::new(),\n                result_summary: \"success\".to_string(),\n            }),\n            Vec::new(),\n            \"Workflow succeeded\",\n        );\n    }\n\n    fn append_large_task(&self, task_id_value: &str, event_count: usize) {\n        let task_id = task_id(task_id_value);\n        self.append_event(\n            task_id.clone(),\n            EventKind::AssistantTaskStarted,\n            EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n                context_handle_id: None,\n                seed_event_ids: Vec::new(),\n                initial_memory_ids: Vec::new(),\n                objective: \"large task\".to_string(),\n            }),\n            Vec::new(),\n            \"Task started\",\n        );\n        for index in 0..event_count.saturating_sub(2) {\n            self.append_event(\n                task_id.clone(),\n                EventKind::ToolCalled,\n                EventPayload::ToolCalled(ToolCalledPayload {\n                    call_id: format!(\"call-{task_id_value}-{index}\"),\n                    tool_name: \"get_context_capsule\".to_string(),\n                    context_handle_id: None,\n                    source_event_id: None,\n                    input_summary: \"query=scan\".to_string(),\n                }),\n                vec![crate::events::StableRef::FileRef(file_id(&format!(\n                    \"src/file-{index}.rs\"\n                )))],\n                \"Tool called\",\n            );\n        }\n        self.append_event(\n            task_id,\n            EventKind::WorkflowSucceeded,\n            EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n                workflow_name: \"prepare_change\".to_string(),\n                terminal_event_id: None,\n                output_context_handle_id: None,\n                memory_ids: Vec::new(),\n                result_summary: \"success\".to_string(),\n            }),\n            Vec::new(),\n            \"Workflow succeeded\",\n        );\n    }\n\n    fn append_event(\n        &self,\n        task_id: TaskId,\n        kind: EventKind,\n        payload: EventPayload,\n        references: Vec<crate::events::StableRef>,\n        summary: &str,\n    ) {\n        self.writer\n            .append(PartialEnvelope {\n                workspace_id: None,\n                branch: BranchRef {\n                    name: \"main\".to_string(),\n                },\n                session_id: SessionId {\n                    value: \"session-main\".to_string(),\n                },\n                task_id: Some(task_id),\n                actor: Actor::Daemon,\n                kind,\n                references,\n                summary: CompactSummary::new(summary).expect(\"summary fits\"),\n                payload,\n            })\n            .expect(\"event appends\");\n    }\n}\n\nstruct BudgetFixture {\n    writer: EventWriter,\n    consolidator: SessionConsolidator,\n}\n\nimpl BudgetFixture {\n    fn new() -> Self {\n        let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n        let writer = EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n            .with_flush_policy(FlushPolicy::Sync);\n        let consolidator = SessionConsolidator::new(\n            EventReader::new(event_store.clone()),\n            MemoryStore::open_in_memory().expect(\"memory store opens\"),\n            ConsolidationJobRuntime::new(\n                Connection::open_in_memory().expect(\"consolidation db opens\"),\n                ConsolidationConfig::default(),\n            )\n            .expect(\"runtime opens\"),\n            SessionConsolidationConfig::default(),\n        );\n        Self {\n            writer,\n            consolidator,\n        }\n    }\n\n    fn append_small_task(&self, task_id_value: &str) {\n        let task_id = task_id(task_id_value);\n        self.writer\n            .append(PartialEnvelope {\n                workspace_id: None,\n                branch: BranchRef {\n                    name: \"main\".to_string(),\n                },\n                session_id: SessionId {\n                    value: \"session-budget\".to_string(),\n                },\n                task_id: Some(task_id.clone()),\n                actor: Actor::Daemon,\n                kind: EventKind::AssistantTaskStarted,\n                references: Vec::new(),\n                summary: CompactSummary::new(\"Task started\").expect(\"summary fits\"),\n                payload: EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n                    context_handle_id: None,\n                    seed_event_ids: Vec::new(),\n                    initial_memory_ids: Vec::new(),\n                    objective: \"budget\".to_string(),\n                }),\n            })\n            .expect(\"event appends\");\n        self.writer\n            .append(PartialEnvelope {\n                workspace_id: None,\n                branch: BranchRef {\n                    name: \"main\".to_string(),\n                },\n                session_id: SessionId {\n                    value: \"session-budget\".to_string(),\n                },\n                task_id: Some(task_id.clone()),\n                actor: Actor::Daemon,\n                kind: EventKind::ToolCalled,\n                references: vec![crate::events::StableRef::FileRef(file_id(\"src/lib.rs\"))],\n                summary: CompactSummary::new(\"Tool called\").expect(\"summary fits\"),\n                payload: EventPayload::ToolCalled(ToolCalledPayload {\n                    call_id: format!(\"call-{task_id_value}\"),\n                    tool_name: \"get_context_capsule\".to_string(),\n                    context_handle_id: None,\n                    source_event_id: None,\n                    input_summary: \"budget\".to_string(),\n                }),\n            })\n            .expect(\"event appends\");\n        self.writer\n            .append(PartialEnvelope {\n                workspace_id: None,\n                branch: BranchRef {\n                    name: \"main\".to_string(),\n                },\n                session_id: SessionId {\n                    value: \"session-budget\".to_string(),\n                },\n                task_id: Some(task_id),\n                actor: Actor::Daemon,\n                kind: EventKind::WorkflowSucceeded,\n                references: Vec::new(),\n                summary: CompactSummary::new(\"Workflow succeeded\").expect(\"summary fits\"),\n                payload: EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n                    workflow_name: \"prepare_change\".to_string(),\n                    terminal_event_id: None,\n                    output_context_handle_id: None,\n                    memory_ids: Vec::new(),\n                    result_summary: \"success\".to_string(),\n                }),\n            })\n            .expect(\"event appends\");\n    }\n}\n\nfn load_proposal(path: &Path, proposal_id: &str) -> (String, Value) {\n    let conn = Connection::open(path).expect(\"db opens\");\n    conn.query_row(\n        \"SELECT proposal_kind, proposed_state FROM consolidation_proposals WHERE proposal_id = ?1\",\n        [proposal_id],\n        |row| Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?)),\n    )\n    .map(|(kind, proposed_state)| {\n        (\n            kind,\n            serde_json::from_str::<Value>(&proposed_state).expect(\"proposal json parses\"),\n        )\n    })\n    .expect(\"proposal loads\")\n}\n\nfn load_job(path: &Path, job_id: &str) -> (String, String) {\n    let conn = Connection::open(path).expect(\"db opens\");\n    conn.query_row(\n        \"SELECT mode, status FROM consolidation_jobs WHERE job_id = ?1\",\n        [job_id],\n        |row| Ok((row.get(0)?, row.get(1)?)),\n    )\n    .expect(\"job loads\")\n}\n\nfn percentile_99(samples: &[Duration]) -> Duration {\n    let index = ((samples.len() as f64 * 0.99).ceil() as usize).saturating_sub(1);\n    samples[index]\n}\n\nfn file_id(path: &str) -> FileId {\n    FileId {\n        workspace_id: \"workspace-main\".to_string(),\n        repo_relative_path: path.to_string(),\n        content_hash: \"hash\".to_string(),\n    }\n}\n\nfn task_id(value: &str) -> TaskId {\n    TaskId {\n        value: value.to_string(),\n    }\n}\n\nfn session_source_path() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"src\")\n        .join(\"consolidation\")\n        .join(\"session.rs\")\n}\n","numLines":459,"startLine":1,"totalLines":459}}}
