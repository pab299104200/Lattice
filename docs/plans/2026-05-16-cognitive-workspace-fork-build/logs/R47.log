{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VhGDMRCqQtRGeC7fWQWtrw","type":"tool_result","content":"1\t//! LLM proposal provenance for auditable consolidation outputs.\n2\t//!\n3\t//! Spec constraints from `## 6. Consolidation Engine` \"LLM-driven consolidation\":\n4\t//!\n5\t//! - each job records its model, prompt hash, and response hash as part of the proposal provenance so outputs are auditable and reproducible\n6\t//! - consolidation queue depth must be bounded; when the queue is full, new jobs are dropped with a log warning rather than stalling the daemon\n7\t//! - cost and latency budgets for LLM consolidation should be documented per job type before Phase 6 begins; jobs exceeding budget must fall back to deterministic approximations or skip with a stale flag\n8\t\n9\tuse std::time::Duration;\n10\t\n11\tuse serde::{Deserialize, Serialize};\n12\tuse sha2::{Digest, Sha256};\n13\t\n14\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n15\tpub struct Utc;\n16\t\n17\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n18\tpub struct DateTime<Tz> {\n19\t    pub unix_micros: u64,\n20\t    #[serde(skip)]\n21\t    timezone: std::marker::PhantomData<Tz>,\n22\t}\n23\t\n24\timpl DateTime<Utc> {\n25\t    pub fn now() -> Self {\n26\t        let unix_micros = std::time::SystemTime::now()\n27\t            .duration_since(std::time::UNIX_EPOCH)\n28\t            .unwrap_or_default()\n29\t            .as_micros()\n30\t            .min(u64::MAX as u128) as u64;\n31\t        Self {\n32\t            unix_micros,\n33\t            timezone: std::marker::PhantomData,\n34\t        }\n35\t    }\n36\t}\n37\t\n38\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n39\tpub struct LlmProvenance {\n40\t    pub model: String,\n41\t    pub prompt_sha256: [u8; 32],\n42\t    pub response_sha256: [u8; 32],\n43\t    pub prompt_token_count: u32,\n44\t    pub response_token_count: u32,\n45\t    pub latency_ms: u32,\n46\t    pub called_at: DateTime<Utc>,\n47\t}\n48\t\n49\t#[derive(Debug, thiserror::Error)]\n50\tpub enum ProvenanceError {\n51\t    #[error(\"LLM latency {0}ms exceeds provenance storage range\")]\n52\t    LatencyOutOfRange(u128),\n53\t}\n54\t\n55\timpl LlmProvenance {\n56\t    pub fn record(\n57\t        driver_name: &str,\n58\t        prompt_bytes: &[u8],\n59\t        response_bytes: &[u8],\n60\t        prompt_tokens: u32,\n61\t        response_tokens: u32,\n62\t        latency: Duration,\n63\t    ) -> Result<Self, ProvenanceError> {\n64\t        let latency_ms = latency.as_millis();\n65\t        let latency_ms = u32::try_from(latency_ms)\n66\t            .map_err(|_| ProvenanceError::LatencyOutOfRange(latency.as_millis()))?;\n67\t        Ok(Self {\n68\t            model: driver_name.to_string(),\n69\t            prompt_sha256: sha256(prompt_bytes),\n70\t            response_sha256: sha256(response_bytes),\n71\t            prompt_token_count: prompt_tokens,\n72\t            response_token_count: response_tokens,\n73\t            latency_ms,\n74\t            called_at: DateTime::<Utc>::now(),\n75\t        })\n76\t    }\n77\t}\n78\t\n79\tfn sha256(bytes: &[u8]) -> [u8; 32] {\n80\t    let digest = Sha256::digest(bytes);\n81\t    let mut hash = [0_u8; 32];\n82\t    hash.copy_from_slice(&digest);\n83\t    hash\n84\t}\n85\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"91957b7c-9b89-43b8-9fca-72981e794891","timestamp":"2026-05-17T11:42:09.914Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/llm/provenance.rs","content":"//! LLM proposal provenance for auditable consolidation outputs.\n//!\n//! Spec constraints from `## 6. Consolidation Engine` \"LLM-driven consolidation\":\n//!\n//! - each job records its model, prompt hash, and response hash as part of the proposal provenance so outputs are auditable and reproducible\n//! - consolidation queue depth must be bounded; when the queue is full, new jobs are dropped with a log warning rather than stalling the daemon\n//! - cost and latency budgets for LLM consolidation should be documented per job type before Phase 6 begins; jobs exceeding budget must fall back to deterministic approximations or skip with a stale flag\n\nuse std::time::Duration;\n\nuse serde::{Deserialize, Serialize};\nuse sha2::{Digest, Sha256};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Utc;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct DateTime<Tz> {\n    pub unix_micros: u64,\n    #[serde(skip)]\n    timezone: std::marker::PhantomData<Tz>,\n}\n\nimpl DateTime<Utc> {\n    pub fn now() -> Self {\n        let unix_micros = std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .unwrap_or_default()\n            .as_micros()\n            .min(u64::MAX as u128) as u64;\n        Self {\n            unix_micros,\n            timezone: std::marker::PhantomData,\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct LlmProvenance {\n    pub model: String,\n    pub prompt_sha256: [u8; 32],\n    pub response_sha256: [u8; 32],\n    pub prompt_token_count: u32,\n    pub response_token_count: u32,\n    pub latency_ms: u32,\n    pub called_at: DateTime<Utc>,\n}\n\n#[derive(Debug, thiserror::Error)]\npub enum ProvenanceError {\n    #[error(\"LLM latency {0}ms exceeds provenance storage range\")]\n    LatencyOutOfRange(u128),\n}\n\nimpl LlmProvenance {\n    pub fn record(\n        driver_name: &str,\n        prompt_bytes: &[u8],\n        response_bytes: &[u8],\n        prompt_tokens: u32,\n        response_tokens: u32,\n        latency: Duration,\n    ) -> Result<Self, ProvenanceError> {\n        let latency_ms = latency.as_millis();\n        let latency_ms = u32::try_from(latency_ms)\n            .map_err(|_| ProvenanceError::LatencyOutOfRange(latency.as_millis()))?;\n        Ok(Self {\n            model: driver_name.to_string(),\n            prompt_sha256: sha256(prompt_bytes),\n            response_sha256: sha256(response_bytes),\n            prompt_token_count: prompt_tokens,\n            response_token_count: response_tokens,\n            latency_ms,\n            called_at: DateTime::<Utc>::now(),\n        })\n    }\n}\n\nfn sha256(bytes: &[u8]) -> [u8; 32] {\n    let digest = Sha256::digest(bytes);\n    let mut hash = [0_u8; 32];\n    hash.copy_from_slice(&digest);\n    hash\n}\n","numLines":85,"startLine":1,"totalLines":85}}}
