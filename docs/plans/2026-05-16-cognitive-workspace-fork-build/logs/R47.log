{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L3XSY7KWxxuuANVLaNKii7","type":"tool_result","content":"1\t//! Deterministic consolidation job for \"demote unused or low-value memories\".\n2\t//!\n3\t//! This implements the `## 6. Consolidation Engine` consolidation-jobs bullet\n4\t//! \"demote unused or low-value memories\" from\n5\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`.\n6\t\n7\tuse std::time::Instant;\n8\t\n9\tuse serde_json::json;\n10\tuse tracing::info_span;\n11\t\n12\tuse super::{\n13\t    capture_memory_state, encode_memory_state, ConsolidationJobMode, ConsolidationJobRuntime,\n14\t    PendingProposalSpec, ProposalKind, ScanError, ScanReport,\n15\t};\n16\tuse crate::memory::{MemoryScoreKind, MemoryStore, MemoryVerificationStatus};\n17\t\n18\tconst DEFAULT_DEMOTION_THRESHOLD: f32 = 0.35;\n19\t\n20\tpub struct DemotionScanner<'a> {\n21\t    store: &'a MemoryStore,\n22\t    runtime: &'a mut ConsolidationJobRuntime,\n23\t    demotion_threshold: f32,\n24\t}\n25\t\n26\timpl<'a> DemotionScanner<'a> {\n27\t    pub fn new(store: &'a MemoryStore, runtime: &'a mut ConsolidationJobRuntime) -> Self {\n28\t        Self {\n29\t            store,\n30\t            runtime,\n31\t            demotion_threshold: DEFAULT_DEMOTION_THRESHOLD,\n32\t        }\n33\t    }\n34\t\n35\t    pub fn scan(&mut self, workspace_id: &str, cutoff: u64) -> Result<ScanReport, ScanError> {\n36\t        let started = Instant::now();\n37\t        let span = info_span!(\n38\t            \"consolidation.demotion.scan\",\n39\t            workspace_id,\n40\t            kind = \"demote unused or low-value memories\"\n41\t        );\n42\t        let _entered = span.enter();\n43\t        let memories = self.store.list_workspace_memories(workspace_id)?;\n44\t        let mut proposals_enqueued = 0u32;\n45\t        let mut skipped = 0u32;\n46\t\n47\t        for memory in memories {\n48\t            let access_count = self.store.count_memory_accesses_since(&memory.id, cutoff)?;\n49\t            let usefulness = self\n50\t                .store\n51\t                .latest_memory_score(&memory.id, MemoryScoreKind::UsefulnessPrior)?\n52\t                .map(|score| score.value)\n53\t                .unwrap_or(memory.confidence as f32);\n54\t            if access_count > 0 || usefulness >= self.demotion_threshold {\n55\t                skipped += 1;\n56\t                continue;\n57\t            }\n58\t\n59\t            let prior_state = capture_memory_state(self.store, &memory)?;\n60\t            let mut proposed_state = prior_state.clone();\n61\t            proposed_state.memory.confidence = (proposed_state.memory.confidence - 0.2).max(0.1);\n62\t            if proposed_state.structured_fields.verification_status\n63\t                == MemoryVerificationStatus::Verified\n64\t            {\n65\t                proposed_state.structured_fields.verification_status =\n66\t                    MemoryVerificationStatus::Unverified;\n67\t            }\n68\t\n69\t            self.runtime\n70\t                .submit(crate::consolidation::ConsolidationJobSpec {\n71\t                    job_id: format!(\"demotion-{}\", memory.id),\n72\t                    workspace_id: workspace_id.to_string(),\n73\t                    kind: \"demote unused or low-value memories\".to_string(),\n74\t                    mode: ConsolidationJobMode::Background,\n75\t                    proposal: Some(PendingProposalSpec {\n76\t                        proposal_id: format!(\"demotion-proposal-{}\", memory.id),\n77\t                        target_memory_id: Some(memory.id.clone()),\n78\t                        proposal_kind: ProposalKind::Demote,\n79\t                        prior_state: encode_memory_state(&prior_state),\n80\t                        proposed_state: encode_memory_state(&proposed_state),\n81\t                        evidence: json!({\n82\t                            \"source_memory_ids\": [memory.id.clone()],\n83\t                            \"access_count_since_cutoff\": access_count,\n84\t                            \"usefulness_score\": usefulness,\n85\t                            \"cutoff\": cutoff,\n86\t                        }),\n87\t                        provenance: None,\n88\t                    }),\n89\t                })?;\n90\t            proposals_enqueued += 1;\n91\t        }\n92\t\n93\t        let _ = self.runtime.run_due()?;\n94\t        Ok(ScanReport::from_counts(\n95\t            proposals_enqueued,\n96\t            skipped,\n97\t            started,\n98\t        ))\n99\t    }\n100\t}\n101\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"d37835ab-2687-4f43-9f8f-ba433739b393","timestamp":"2026-05-17T11:44:28.606Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/demotion.rs","content":"//! Deterministic consolidation job for \"demote unused or low-value memories\".\n//!\n//! This implements the `## 6. Consolidation Engine` consolidation-jobs bullet\n//! \"demote unused or low-value memories\" from\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`.\n\nuse std::time::Instant;\n\nuse serde_json::json;\nuse tracing::info_span;\n\nuse super::{\n    capture_memory_state, encode_memory_state, ConsolidationJobMode, ConsolidationJobRuntime,\n    PendingProposalSpec, ProposalKind, ScanError, ScanReport,\n};\nuse crate::memory::{MemoryScoreKind, MemoryStore, MemoryVerificationStatus};\n\nconst DEFAULT_DEMOTION_THRESHOLD: f32 = 0.35;\n\npub struct DemotionScanner<'a> {\n    store: &'a MemoryStore,\n    runtime: &'a mut ConsolidationJobRuntime,\n    demotion_threshold: f32,\n}\n\nimpl<'a> DemotionScanner<'a> {\n    pub fn new(store: &'a MemoryStore, runtime: &'a mut ConsolidationJobRuntime) -> Self {\n        Self {\n            store,\n            runtime,\n            demotion_threshold: DEFAULT_DEMOTION_THRESHOLD,\n        }\n    }\n\n    pub fn scan(&mut self, workspace_id: &str, cutoff: u64) -> Result<ScanReport, ScanError> {\n        let started = Instant::now();\n        let span = info_span!(\n            \"consolidation.demotion.scan\",\n            workspace_id,\n            kind = \"demote unused or low-value memories\"\n        );\n        let _entered = span.enter();\n        let memories = self.store.list_workspace_memories(workspace_id)?;\n        let mut proposals_enqueued = 0u32;\n        let mut skipped = 0u32;\n\n        for memory in memories {\n            let access_count = self.store.count_memory_accesses_since(&memory.id, cutoff)?;\n            let usefulness = self\n                .store\n                .latest_memory_score(&memory.id, MemoryScoreKind::UsefulnessPrior)?\n                .map(|score| score.value)\n                .unwrap_or(memory.confidence as f32);\n            if access_count > 0 || usefulness >= self.demotion_threshold {\n                skipped += 1;\n                continue;\n            }\n\n            let prior_state = capture_memory_state(self.store, &memory)?;\n            let mut proposed_state = prior_state.clone();\n            proposed_state.memory.confidence = (proposed_state.memory.confidence - 0.2).max(0.1);\n            if proposed_state.structured_fields.verification_status\n                == MemoryVerificationStatus::Verified\n            {\n                proposed_state.structured_fields.verification_status =\n                    MemoryVerificationStatus::Unverified;\n            }\n\n            self.runtime\n                .submit(crate::consolidation::ConsolidationJobSpec {\n                    job_id: format!(\"demotion-{}\", memory.id),\n                    workspace_id: workspace_id.to_string(),\n                    kind: \"demote unused or low-value memories\".to_string(),\n                    mode: ConsolidationJobMode::Background,\n                    proposal: Some(PendingProposalSpec {\n                        proposal_id: format!(\"demotion-proposal-{}\", memory.id),\n                        target_memory_id: Some(memory.id.clone()),\n                        proposal_kind: ProposalKind::Demote,\n                        prior_state: encode_memory_state(&prior_state),\n                        proposed_state: encode_memory_state(&proposed_state),\n                        evidence: json!({\n                            \"source_memory_ids\": [memory.id.clone()],\n                            \"access_count_since_cutoff\": access_count,\n                            \"usefulness_score\": usefulness,\n                            \"cutoff\": cutoff,\n                        }),\n                        provenance: None,\n                    }),\n                })?;\n            proposals_enqueued += 1;\n        }\n\n        let _ = self.runtime.run_due()?;\n        Ok(ScanReport::from_counts(\n            proposals_enqueued,\n            skipped,\n            started,\n        ))\n    }\n}\n","numLines":101,"startLine":1,"totalLines":101}}}
