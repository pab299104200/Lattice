{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015nxCGxtD7B1HcRtMoqRewD","type":"tool_result","content":"1\t//! Synchronous post-task consolidation for small task traces.\n2\t//!\n3\t//! This module implements the `## 6. Consolidation Engine` \"Consolidation modes\"\n4\t//! definition from `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`:\n5\t//! synchronous post-task consolidation runs immediately after a workflow\n6\t//! concludes for small traces, while larger histories are redirected to\n7\t//! background consolidation. It also enforces the `## Phase 2: Event Log\n8\t//! Substrate` hot-path rule that event writes stay bounded; no LLM inference is\n9\t//! allowed here, and slices above the configured ceiling short-circuit into a\n10\t//! background job before the synchronous path can grow unbounded.\n11\t\n12\tuse std::path::Path;\n13\tuse std::time::Instant;\n14\t\n15\tuse rusqlite::Connection;\n16\tuse serde_json::{json, Value};\n17\tuse tracing::{field, info_span};\n18\t\n19\tuse super::{\n20\t    empty_state, now_unix_micros, ConsolidationConfig, ConsolidationJobMode,\n21\t    ConsolidationJobRuntime, ConsolidationJobSpec, EnqueueOutcome, EpisodeError, EpisodeOutcome,\n22\t    EpisodeTemplate, PendingProposalSpec, ProposalKind,\n23\t};\n24\tuse crate::events::{EventQuery, EventReader, EventStore, QueryOrder, StableRef, TaskId};\n25\tuse crate::memory::{Memory, MemoryScope, MemoryStore, MemoryType};\n26\t\n27\tconst DEFAULT_SYNCHRONOUS_MAX_EVENTS: usize = 200;\n28\t#[derive(Clone, Debug, PartialEq, Eq)]\n29\tpub struct SessionConsolidationConfig {\n30\t    pub synchronous_max_events: usize,\n31\t}\n32\t\n33\timpl Default for SessionConsolidationConfig {\n34\t    fn default() -> Self {\n35\t        Self {\n36\t            synchronous_max_events: DEFAULT_SYNCHRONOUS_MAX_EVENTS,\n37\t        }\n38\t    }\n39\t}\n40\t\n41\t#[derive(Clone, Debug, PartialEq, Eq)]\n42\tpub enum SessionConsolidationOutcome {\n43\t    Proposed {\n44\t        proposal_id: String,\n45\t        job_id: String,\n46\t        proposal_kind: ProposalKind,\n47\t    },\n48\t    RedirectedToBackground {\n49\t        job_id: String,\n50\t        slice_len: usize,\n51\t        enqueue: EnqueueOutcome,\n52\t    },\n53\t}\n54\t\n55\tpub struct SessionConsolidator {\n56\t    event_reader: EventReader,\n57\t    memory_store: MemoryStore,\n58\t    runtime: ConsolidationJobRuntime,\n59\t    config: SessionConsolidationConfig,\n60\t}\n61\t\n62\timpl SessionConsolidator {\n63\t    pub fn new(\n64\t        event_reader: EventReader,\n65\t        memory_store: MemoryStore,\n66\t        runtime: ConsolidationJobRuntime,\n67\t        config: SessionConsolidationConfig,\n68\t    ) -> Self {\n69\t        Self {\n70\t            event_reader,\n71\t            memory_store,\n72\t            runtime,\n73\t            config,\n74\t        }\n75\t    }\n76\t\n77\t    pub fn open(\n78\t        event_store: std::sync::Arc<EventStore>,\n79\t        memory_db_path: &Path,\n80\t        config: SessionConsolidationConfig,\n81\t    ) -> Result<Self, EpisodeError> {\n82\t        let memory_store = MemoryStore::open(memory_db_path)\n83\t            .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))?;\n84\t        let runtime = ConsolidationJobRuntime::new(\n85\t            Connection::open(memory_db_path)\n86\t                .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))?,\n87\t            ConsolidationConfig::default(),\n88\t        )\n89\t        .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))?;\n90\t        Ok(Self::new(\n91\t            EventReader::new(event_store),\n92\t            memory_store,\n93\t            runtime,\n94\t            config,\n95\t        ))\n96\t    }\n97\t\n98\t    pub fn on_task_complete(\n99\t        &mut self,\n100\t        workspace_id: &str,\n101\t        task_id: &TaskId,\n102\t        outcome: EpisodeOutcome,\n103\t    ) -> Result<SessionConsolidationOutcome, EpisodeError> {\n104\t        let span = info_span!(\n105\t            \"session_consolidation\",\n106\t            workspace_id = workspace_id,\n107\t            task_id = task_id.value.as_str(),\n108\t            slice_len = field::Empty,\n109\t            elapsed_us = field::Empty,\n110\t            outcome = field::Empty\n111\t        );\n112\t        let _entered = span.enter();\n113\t        let started = Instant::now();\n114\t        let slice = self.read_task_slice(workspace_id, task_id)?;\n115\t        span.record(\"slice_len\", slice.len() as i64);\n116\t\n117\t        let result = if slice.is_empty() {\n118\t            Err(EpisodeError::MissingTaskSlice {\n119\t                task_id: task_id.value.clone(),\n120\t            })\n121\t        } else if slice.len() > self.config.synchronous_max_events {\n122\t            let (job_id, enqueue) =\n123\t                self.enqueue_background_redirect(workspace_id, task_id, slice.len())?;\n124\t            Ok(SessionConsolidationOutcome::RedirectedToBackground {\n125\t                job_id,\n126\t                slice_len: slice.len(),\n127\t                enqueue,\n128\t            })\n129\t        } else {\n130\t            let template = EpisodeTemplate::from_task_slice(&slice)?;\n131\t            if template.outcome != outcome {\n132\t                tracing::warn!(\n133\t                    task_id = task_id.value.as_str(),\n134\t                    expected = outcome.as_str(),\n135\t                    actual = template.outcome.as_str(),\n136\t                    \"session consolidation outcome mismatch; using event-derived outcome\"\n137\t                );\n138\t            }\n139\t            self.emit_synchronous_proposal(workspace_id, &template)\n140\t        };\n141\t\n142\t        let elapsed = started.elapsed();\n143\t        span.record(\"elapsed_us\", elapsed.as_micros() as i64);\n144\t        match &result {\n145\t            Ok(SessionConsolidationOutcome::Proposed { .. }) => {\n146\t                span.record(\"outcome\", \"proposed\");\n147\t            }\n148\t            Ok(SessionConsolidationOutcome::RedirectedToBackground { .. }) => {\n149\t                span.record(\"outcome\", \"redirected\");\n150\t            }\n151\t            Err(_) => {\n152\t                span.record(\"outcome\", \"failed\");\n153\t            }\n154\t        }\n155\t        result\n156\t    }\n157\t\n158\t    pub fn memory_store(&self) -> &MemoryStore {\n159\t        &self.memory_store\n160\t    }\n161\t\n162\t    fn read_task_slice(\n163\t        &self,\n164\t        workspace_id: &str,\n165\t        task_id: &TaskId,\n166\t    ) -> Result<Vec<crate::events::EventEnvelope>, EpisodeError> {\n167\t        EventQuery::new()\n168\t            .workspace(workspace_id.to_string())\n169\t            .task(task_id.value.clone())\n170\t            .limit(self.config.synchronous_max_events.saturating_add(1))\n171\t            .order(QueryOrder::OldestFirst)\n172\t            .execute(&self.event_reader)\n173\t            .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))\n174\t    }\n175\t\n176\t    fn enqueue_background_redirect(\n177\t        &mut self,\n178\t        workspace_id: &str,\n179\t        task_id: &TaskId,\n180\t        slice_len: usize,\n181\t    ) -> Result<(String, EnqueueOutcome), EpisodeError> {\n182\t        let job_id = redirect_job_id(task_id);\n183\t        let job = ConsolidationJobSpec {\n184\t            job_id: job_id.clone(),\n185\t            workspace_id: workspace_id.to_string(),\n186\t            kind: format!(\"session_consolidation_redirect:{}\", task_id.value),\n187\t            mode: ConsolidationJobMode::Background,\n188\t            proposal: None,\n189\t        };\n190\t        self.runtime\n191\t            .submit(job)\n192\t            .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))\n193\t            .map(|outcome| {\n194\t                tracing::info!(\n195\t                    task_id = task_id.value.as_str(),\n196\t                    slice_len,\n197\t                    \"redirected session consolidation to background mode\"\n198\t                );\n199\t                (job_id, outcome)\n200\t            })\n201\t    }\n202\t\n203\t    fn emit_synchronous_proposal(\n204\t        &mut self,\n205\t        workspace_id: &str,\n206\t        template: &EpisodeTemplate,\n207\t    ) -> Result<SessionConsolidationOutcome, EpisodeError> {\n208\t        let refresh_key = episode_refresh_key(template);\n209\t        let existing = self\n210\t            .memory_store\n211\t            .find_by_refresh_key(&refresh_key, Some(workspace_id), None)\n212\t            .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))?;\n213\t        let proposal_kind = if existing.is_some() {\n214\t            ProposalKind::UpdateMemory\n215\t        } else {\n216\t            ProposalKind::CreateMemory\n217\t        };\n218\t        let prior_state = existing\n219\t            .as_ref()\n220\t            .map(memory_with_episode_metadata)\n221\t            .unwrap_or_else(empty_state);\n222\t        let proposed_memory =\n223\t            build_episode_memory(existing.as_ref(), template, &refresh_key, workspace_id);\n224\t        let proposed_state = memory_state_with_episode(&proposed_memory, template);\n225\t        let proposal_id = format!(\n226\t            \"episode-proposal-{}-{}\",\n227\t            task_id_slug(&template.task_id.value),\n228\t            template.event_window.end.ulid\n229\t        );\n230\t        let job_id = format!(\n231\t            \"session-consolidation-{}-{}\",\n232\t            task_id_slug(&template.task_id.value),\n233\t            template.event_window.end.ulid\n234\t        );\n235\t        let job = ConsolidationJobSpec {\n236\t            job_id: job_id.clone(),\n237\t            workspace_id: workspace_id.to_string(),\n238\t            kind: format!(\"session_consolidation:{}\", template.task_id.value),\n239\t            mode: ConsolidationJobMode::SynchronousPostTask,\n240\t            proposal: Some(PendingProposalSpec {\n241\t                proposal_id: proposal_id.clone(),\n242\t                target_memory_id: existing.as_ref().map(|memory| memory.id.clone()),\n243\t                proposal_kind,\n244\t                prior_state,\n245\t                proposed_state,\n246\t                evidence: episode_evidence(template),\n247\t                provenance: None,\n248\t            }),\n249\t        };\n250\t        let (_, proposal) = self\n251\t            .runtime\n252\t            .submit_inline(job)\n253\t            .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))?;\n254\t        let proposal = proposal.ok_or_else(|| {\n255\t            EpisodeError::StoreUnavailable(\n256\t                \"synchronous session consolidation did not emit a proposal\".to_string(),\n257\t            )\n258\t        })?;\n259\t        Ok(SessionConsolidationOutcome::Proposed {\n260\t            proposal_id: proposal.proposal_id,\n261\t            job_id,\n262\t            proposal_kind,\n263\t        })\n264\t    }\n265\t}\n266\t\n267\tfn build_episode_memory(\n268\t    existing: Option<&Memory>,\n269\t    template: &EpisodeTemplate,\n270\t    refresh_key: &str,\n271\t    workspace_id: &str,\n272\t) -> Memory {\n273\t    Memory {\n274\t        id: existing.map(|memory| memory.id.clone()).unwrap_or_else(|| {\n275\t            format!(\n276\t                \"episode-{}-{}\",\n277\t                task_id_slug(&template.task_id.value),\n278\t                template.event_window.end.ulid\n279\t            )\n280\t        }),\n281\t        session_id: template.session_id.value.clone(),\n282\t        content: template.summary_text.clone(),\n283\t        memory_type: MemoryType::Pattern,\n284\t        scope: MemoryScope::Session,\n285\t        confidence: match template.outcome {\n286\t            EpisodeOutcome::Success => 0.92,\n287\t            EpisodeOutcome::Failure => 0.72,\n288\t            EpisodeOutcome::Abandoned => 0.55,\n289\t        },\n290\t        linked_symbols: template\n291\t            .salient_anchors\n292\t            .iter()\n293\t            .filter_map(|reference| match reference {\n294\t                StableRef::SymbolRef(symbol) => Some(symbol.to_string()),\n295\t                StableRef::DocSectionRef(section) => Some(section.to_string()),\n296\t                _ => None,\n297\t            })\n298\t            .collect(),\n299\t        linked_files: template\n300\t            .salient_anchors\n301\t            .iter()\n302\t            .filter_map(|reference| match reference {\n303\t                StableRef::FileRef(file) => Some(file.repo_relative_path.clone()),\n304\t                _ => None,\n305\t            })\n306\t            .collect(),\n307\t        workspace_id: Some(workspace_id.to_string()),\n308\t        branch: None,\n309\t        refresh_key: Some(refresh_key.to_string()),\n310\t        source_query: Some(format!(\n311\t            \"episode_summary:{}:{}\",\n312\t            template.session_id.value, template.task_id.value\n313\t        )),\n314\t        created_at: existing.map(|memory| memory.created_at).unwrap_or_default(),\n315\t        last_accessed: existing\n316\t            .map(|memory| memory.last_accessed)\n317\t            .unwrap_or_default(),\n318\t        access_count: existing\n319\t            .map(|memory| memory.access_count)\n320\t            .unwrap_or_default(),\n321\t        is_stale: false,\n322\t        stale_reason: None,\n323\t    }\n324\t}\n325\t\n326\tfn memory_state_with_episode(memory: &Memory, template: &EpisodeTemplate) -> Value {\n327\t    let mut state = serde_json::to_value(memory).expect(\"memory serializes\");\n328\t    if let Some(object) = state.as_object_mut() {\n329\t        object.insert(\"episode_task_id\".to_string(), json!(template.task_id));\n330\t        object.insert(\"episode_session_id\".to_string(), json!(template.session_id));\n331\t        object.insert(\n332\t            \"episode_outcome\".to_string(),\n333\t            json!(template.outcome.as_str()),\n334\t        );\n335\t        object.insert(\n336\t            \"event_window\".to_string(),\n337\t            json!({\n338\t                \"start\": template.event_window.start,\n339\t                \"end\": template.event_window.end,\n340\t            }),\n341\t        );\n342\t        object.insert(\n343\t            \"salient_anchors\".to_string(),\n344\t            serde_json::to_value(&template.salient_anchors).expect(\"anchors serialize\"),\n345\t        );\n346\t        object.insert(\n347\t            \"tools_used\".to_string(),\n348\t            serde_json::to_value(&template.tools_used).expect(\"tools serialize\"),\n349\t        );\n350\t        object.insert(\"summary_text\".to_string(), json!(template.summary_text));\n351\t    }\n352\t    state\n353\t}\n354\t\n355\tfn memory_with_episode_metadata(memory: &Memory) -> Value {\n356\t    serde_json::to_value(memory).expect(\"memory serializes\")\n357\t}\n358\t\n359\tfn episode_evidence(template: &EpisodeTemplate) -> Value {\n360\t    json!({\n361\t        \"task_id\": template.task_id.value,\n362\t        \"session_id\": template.session_id.value,\n363\t        \"outcome\": template.outcome.as_str(),\n364\t        \"event_window\": {\n365\t            \"start\": &template.event_window.start,\n366\t            \"end\": &template.event_window.end,\n367\t        },\n368\t        \"salient_anchors\": &template.salient_anchors,\n369\t        \"tools_used\": &template.tools_used,\n370\t        \"source_event_ids\": [\n371\t            &template.event_window.start,\n372\t            &template.event_window.end,\n373\t        ],\n374\t    })\n375\t}\n376\t\n377\tfn episode_refresh_key(template: &EpisodeTemplate) -> String {\n378\t    format!(\n379\t        \"workflow_episode::{}::{}\",\n380\t        template.session_id.value, template.task_id.value\n381\t    )\n382\t}\n383\t\n384\tfn redirect_job_id(task_id: &TaskId) -> String {\n385\t    format!(\n386\t        \"session-consolidation-background-{}-{}\",\n387\t        task_id_slug(&task_id.value),\n388\t        now_unix_micros()\n389\t    )\n390\t}\n391\t\n392\tfn task_id_slug(task_id: &str) -> String {\n393\t    task_id\n394\t        .chars()\n395\t        .map(|character| match character {\n396\t            'a'..='z' | 'A'..='Z' | '0'..='9' => character,\n397\t            _ => '-',\n398\t        })\n399\t        .collect()\n400\t}\n401\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"d57c690e-a18e-4c85-9c1b-36f736baaeb4","timestamp":"2026-05-17T11:41:54.940Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/session.rs","content":"//! Synchronous post-task consolidation for small task traces.\n//!\n//! This module implements the `## 6. Consolidation Engine` \"Consolidation modes\"\n//! definition from `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`:\n//! synchronous post-task consolidation runs immediately after a workflow\n//! concludes for small traces, while larger histories are redirected to\n//! background consolidation. It also enforces the `## Phase 2: Event Log\n//! Substrate` hot-path rule that event writes stay bounded; no LLM inference is\n//! allowed here, and slices above the configured ceiling short-circuit into a\n//! background job before the synchronous path can grow unbounded.\n\nuse std::path::Path;\nuse std::time::Instant;\n\nuse rusqlite::Connection;\nuse serde_json::{json, Value};\nuse tracing::{field, info_span};\n\nuse super::{\n    empty_state, now_unix_micros, ConsolidationConfig, ConsolidationJobMode,\n    ConsolidationJobRuntime, ConsolidationJobSpec, EnqueueOutcome, EpisodeError, EpisodeOutcome,\n    EpisodeTemplate, PendingProposalSpec, ProposalKind,\n};\nuse crate::events::{EventQuery, EventReader, EventStore, QueryOrder, StableRef, TaskId};\nuse crate::memory::{Memory, MemoryScope, MemoryStore, MemoryType};\n\nconst DEFAULT_SYNCHRONOUS_MAX_EVENTS: usize = 200;\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct SessionConsolidationConfig {\n    pub synchronous_max_events: usize,\n}\n\nimpl Default for SessionConsolidationConfig {\n    fn default() -> Self {\n        Self {\n            synchronous_max_events: DEFAULT_SYNCHRONOUS_MAX_EVENTS,\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum SessionConsolidationOutcome {\n    Proposed {\n        proposal_id: String,\n        job_id: String,\n        proposal_kind: ProposalKind,\n    },\n    RedirectedToBackground {\n        job_id: String,\n        slice_len: usize,\n        enqueue: EnqueueOutcome,\n    },\n}\n\npub struct SessionConsolidator {\n    event_reader: EventReader,\n    memory_store: MemoryStore,\n    runtime: ConsolidationJobRuntime,\n    config: SessionConsolidationConfig,\n}\n\nimpl SessionConsolidator {\n    pub fn new(\n        event_reader: EventReader,\n        memory_store: MemoryStore,\n        runtime: ConsolidationJobRuntime,\n        config: SessionConsolidationConfig,\n    ) -> Self {\n        Self {\n            event_reader,\n            memory_store,\n            runtime,\n            config,\n        }\n    }\n\n    pub fn open(\n        event_store: std::sync::Arc<EventStore>,\n        memory_db_path: &Path,\n        config: SessionConsolidationConfig,\n    ) -> Result<Self, EpisodeError> {\n        let memory_store = MemoryStore::open(memory_db_path)\n            .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))?;\n        let runtime = ConsolidationJobRuntime::new(\n            Connection::open(memory_db_path)\n                .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))?,\n            ConsolidationConfig::default(),\n        )\n        .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))?;\n        Ok(Self::new(\n            EventReader::new(event_store),\n            memory_store,\n            runtime,\n            config,\n        ))\n    }\n\n    pub fn on_task_complete(\n        &mut self,\n        workspace_id: &str,\n        task_id: &TaskId,\n        outcome: EpisodeOutcome,\n    ) -> Result<SessionConsolidationOutcome, EpisodeError> {\n        let span = info_span!(\n            \"session_consolidation\",\n            workspace_id = workspace_id,\n            task_id = task_id.value.as_str(),\n            slice_len = field::Empty,\n            elapsed_us = field::Empty,\n            outcome = field::Empty\n        );\n        let _entered = span.enter();\n        let started = Instant::now();\n        let slice = self.read_task_slice(workspace_id, task_id)?;\n        span.record(\"slice_len\", slice.len() as i64);\n\n        let result = if slice.is_empty() {\n            Err(EpisodeError::MissingTaskSlice {\n                task_id: task_id.value.clone(),\n            })\n        } else if slice.len() > self.config.synchronous_max_events {\n            let (job_id, enqueue) =\n                self.enqueue_background_redirect(workspace_id, task_id, slice.len())?;\n            Ok(SessionConsolidationOutcome::RedirectedToBackground {\n                job_id,\n                slice_len: slice.len(),\n                enqueue,\n            })\n        } else {\n            let template = EpisodeTemplate::from_task_slice(&slice)?;\n            if template.outcome != outcome {\n                tracing::warn!(\n                    task_id = task_id.value.as_str(),\n                    expected = outcome.as_str(),\n                    actual = template.outcome.as_str(),\n                    \"session consolidation outcome mismatch; using event-derived outcome\"\n                );\n            }\n            self.emit_synchronous_proposal(workspace_id, &template)\n        };\n\n        let elapsed = started.elapsed();\n        span.record(\"elapsed_us\", elapsed.as_micros() as i64);\n        match &result {\n            Ok(SessionConsolidationOutcome::Proposed { .. }) => {\n                span.record(\"outcome\", \"proposed\");\n            }\n            Ok(SessionConsolidationOutcome::RedirectedToBackground { .. }) => {\n                span.record(\"outcome\", \"redirected\");\n            }\n            Err(_) => {\n                span.record(\"outcome\", \"failed\");\n            }\n        }\n        result\n    }\n\n    pub fn memory_store(&self) -> &MemoryStore {\n        &self.memory_store\n    }\n\n    fn read_task_slice(\n        &self,\n        workspace_id: &str,\n        task_id: &TaskId,\n    ) -> Result<Vec<crate::events::EventEnvelope>, EpisodeError> {\n        EventQuery::new()\n            .workspace(workspace_id.to_string())\n            .task(task_id.value.clone())\n            .limit(self.config.synchronous_max_events.saturating_add(1))\n            .order(QueryOrder::OldestFirst)\n            .execute(&self.event_reader)\n            .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))\n    }\n\n    fn enqueue_background_redirect(\n        &mut self,\n        workspace_id: &str,\n        task_id: &TaskId,\n        slice_len: usize,\n    ) -> Result<(String, EnqueueOutcome), EpisodeError> {\n        let job_id = redirect_job_id(task_id);\n        let job = ConsolidationJobSpec {\n            job_id: job_id.clone(),\n            workspace_id: workspace_id.to_string(),\n            kind: format!(\"session_consolidation_redirect:{}\", task_id.value),\n            mode: ConsolidationJobMode::Background,\n            proposal: None,\n        };\n        self.runtime\n            .submit(job)\n            .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))\n            .map(|outcome| {\n                tracing::info!(\n                    task_id = task_id.value.as_str(),\n                    slice_len,\n                    \"redirected session consolidation to background mode\"\n                );\n                (job_id, outcome)\n            })\n    }\n\n    fn emit_synchronous_proposal(\n        &mut self,\n        workspace_id: &str,\n        template: &EpisodeTemplate,\n    ) -> Result<SessionConsolidationOutcome, EpisodeError> {\n        let refresh_key = episode_refresh_key(template);\n        let existing = self\n            .memory_store\n            .find_by_refresh_key(&refresh_key, Some(workspace_id), None)\n            .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))?;\n        let proposal_kind = if existing.is_some() {\n            ProposalKind::UpdateMemory\n        } else {\n            ProposalKind::CreateMemory\n        };\n        let prior_state = existing\n            .as_ref()\n            .map(memory_with_episode_metadata)\n            .unwrap_or_else(empty_state);\n        let proposed_memory =\n            build_episode_memory(existing.as_ref(), template, &refresh_key, workspace_id);\n        let proposed_state = memory_state_with_episode(&proposed_memory, template);\n        let proposal_id = format!(\n            \"episode-proposal-{}-{}\",\n            task_id_slug(&template.task_id.value),\n            template.event_window.end.ulid\n        );\n        let job_id = format!(\n            \"session-consolidation-{}-{}\",\n            task_id_slug(&template.task_id.value),\n            template.event_window.end.ulid\n        );\n        let job = ConsolidationJobSpec {\n            job_id: job_id.clone(),\n            workspace_id: workspace_id.to_string(),\n            kind: format!(\"session_consolidation:{}\", template.task_id.value),\n            mode: ConsolidationJobMode::SynchronousPostTask,\n            proposal: Some(PendingProposalSpec {\n                proposal_id: proposal_id.clone(),\n                target_memory_id: existing.as_ref().map(|memory| memory.id.clone()),\n                proposal_kind,\n                prior_state,\n                proposed_state,\n                evidence: episode_evidence(template),\n                provenance: None,\n            }),\n        };\n        let (_, proposal) = self\n            .runtime\n            .submit_inline(job)\n            .map_err(|error| EpisodeError::StoreUnavailable(error.to_string()))?;\n        let proposal = proposal.ok_or_else(|| {\n            EpisodeError::StoreUnavailable(\n                \"synchronous session consolidation did not emit a proposal\".to_string(),\n            )\n        })?;\n        Ok(SessionConsolidationOutcome::Proposed {\n            proposal_id: proposal.proposal_id,\n            job_id,\n            proposal_kind,\n        })\n    }\n}\n\nfn build_episode_memory(\n    existing: Option<&Memory>,\n    template: &EpisodeTemplate,\n    refresh_key: &str,\n    workspace_id: &str,\n) -> Memory {\n    Memory {\n        id: existing.map(|memory| memory.id.clone()).unwrap_or_else(|| {\n            format!(\n                \"episode-{}-{}\",\n                task_id_slug(&template.task_id.value),\n                template.event_window.end.ulid\n            )\n        }),\n        session_id: template.session_id.value.clone(),\n        content: template.summary_text.clone(),\n        memory_type: MemoryType::Pattern,\n        scope: MemoryScope::Session,\n        confidence: match template.outcome {\n            EpisodeOutcome::Success => 0.92,\n            EpisodeOutcome::Failure => 0.72,\n            EpisodeOutcome::Abandoned => 0.55,\n        },\n        linked_symbols: template\n            .salient_anchors\n            .iter()\n            .filter_map(|reference| match reference {\n                StableRef::SymbolRef(symbol) => Some(symbol.to_string()),\n                StableRef::DocSectionRef(section) => Some(section.to_string()),\n                _ => None,\n            })\n            .collect(),\n        linked_files: template\n            .salient_anchors\n            .iter()\n            .filter_map(|reference| match reference {\n                StableRef::FileRef(file) => Some(file.repo_relative_path.clone()),\n                _ => None,\n            })\n            .collect(),\n        workspace_id: Some(workspace_id.to_string()),\n        branch: None,\n        refresh_key: Some(refresh_key.to_string()),\n        source_query: Some(format!(\n            \"episode_summary:{}:{}\",\n            template.session_id.value, template.task_id.value\n        )),\n        created_at: existing.map(|memory| memory.created_at).unwrap_or_default(),\n        last_accessed: existing\n            .map(|memory| memory.last_accessed)\n            .unwrap_or_default(),\n        access_count: existing\n            .map(|memory| memory.access_count)\n            .unwrap_or_default(),\n        is_stale: false,\n        stale_reason: None,\n    }\n}\n\nfn memory_state_with_episode(memory: &Memory, template: &EpisodeTemplate) -> Value {\n    let mut state = serde_json::to_value(memory).expect(\"memory serializes\");\n    if let Some(object) = state.as_object_mut() {\n        object.insert(\"episode_task_id\".to_string(), json!(template.task_id));\n        object.insert(\"episode_session_id\".to_string(), json!(template.session_id));\n        object.insert(\n            \"episode_outcome\".to_string(),\n            json!(template.outcome.as_str()),\n        );\n        object.insert(\n            \"event_window\".to_string(),\n            json!({\n                \"start\": template.event_window.start,\n                \"end\": template.event_window.end,\n            }),\n        );\n        object.insert(\n            \"salient_anchors\".to_string(),\n            serde_json::to_value(&template.salient_anchors).expect(\"anchors serialize\"),\n        );\n        object.insert(\n            \"tools_used\".to_string(),\n            serde_json::to_value(&template.tools_used).expect(\"tools serialize\"),\n        );\n        object.insert(\"summary_text\".to_string(), json!(template.summary_text));\n    }\n    state\n}\n\nfn memory_with_episode_metadata(memory: &Memory) -> Value {\n    serde_json::to_value(memory).expect(\"memory serializes\")\n}\n\nfn episode_evidence(template: &EpisodeTemplate) -> Value {\n    json!({\n        \"task_id\": template.task_id.value,\n        \"session_id\": template.session_id.value,\n        \"outcome\": template.outcome.as_str(),\n        \"event_window\": {\n            \"start\": &template.event_window.start,\n            \"end\": &template.event_window.end,\n        },\n        \"salient_anchors\": &template.salient_anchors,\n        \"tools_used\": &template.tools_used,\n        \"source_event_ids\": [\n            &template.event_window.start,\n            &template.event_window.end,\n        ],\n    })\n}\n\nfn episode_refresh_key(template: &EpisodeTemplate) -> String {\n    format!(\n        \"workflow_episode::{}::{}\",\n        template.session_id.value, template.task_id.value\n    )\n}\n\nfn redirect_job_id(task_id: &TaskId) -> String {\n    format!(\n        \"session-consolidation-background-{}-{}\",\n        task_id_slug(&task_id.value),\n        now_unix_micros()\n    )\n}\n\nfn task_id_slug(task_id: &str) -> String {\n    task_id\n        .chars()\n        .map(|character| match character {\n            'a'..='z' | 'A'..='Z' | '0'..='9' => character,\n            _ => '-',\n        })\n        .collect()\n}\n","numLines":401,"startLine":1,"totalLines":401}}}
