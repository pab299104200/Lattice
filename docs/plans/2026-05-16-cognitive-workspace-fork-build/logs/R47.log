{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K6E1HdyBDH4QaN1iN56aB9","type":"tool_result","content":"1\tuse std::collections::VecDeque;\n2\tuse std::sync::{Arc, Mutex};\n3\t\n4\tuse rusqlite::{params, Connection};\n5\tuse serde::{Deserialize, Serialize};\n6\tuse tracing::warn;\n7\t\n8\tuse crate::error::LatticeError;\n9\tuse crate::events::{\n10\t    Actor, BranchRef, CompactSummary, ConsolidationFailedPayload, EventKind, EventPayload,\n11\t    EventWriter, PartialEnvelope, SessionId,\n12\t};\n13\t\n14\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n15\tpub struct ConsolidationJobSpec {\n16\t    pub job_id: String,\n17\t    pub workspace_id: String,\n18\t    pub kind: String,\n19\t    pub mode: ConsolidationJobMode,\n20\t    pub proposal: Option<PendingProposalSpec>,\n21\t}\n22\t\n23\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n24\tpub struct ConsolidationJobRecord {\n25\t    pub job_id: String,\n26\t    pub workspace_id: String,\n27\t    pub kind: String,\n28\t    pub mode: ConsolidationJobMode,\n29\t    pub status: ConsolidationJobStatus,\n30\t    pub enqueued_at: i64,\n31\t    pub started_at: Option<i64>,\n32\t    pub finished_at: Option<i64>,\n33\t    pub proposal_id: Option<String>,\n34\t    pub error_kind: Option<String>,\n35\t}\n36\t\n37\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n38\tpub struct PendingProposalSpec {\n39\t    pub proposal_id: String,\n40\t    pub target_memory_id: Option<String>,\n41\t    pub proposal_kind: crate::consolidation::ProposalKind,\n42\t    pub prior_state: serde_json::Value,\n43\t    pub proposed_state: serde_json::Value,\n44\t    pub evidence: serde_json::Value,\n45\t    pub provenance: Option<crate::consolidation::llm::LlmProvenance>,\n46\t}\n47\t\n48\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n49\t#[serde(rename_all = \"snake_case\")]\n50\tpub enum ConsolidationJobMode {\n51\t    SynchronousPostTask,\n52\t    Background,\n53\t    ManualReview,\n54\t    Replay,\n55\t}\n56\t\n57\timpl ConsolidationJobMode {\n58\t    pub fn as_str(self) -> &'static str {\n59\t        match self {\n60\t            Self::SynchronousPostTask => \"synchronous_post_task\",\n61\t            Self::Background => \"background\",\n62\t            Self::ManualReview => \"manual_review\",\n63\t            Self::Replay => \"replay\",\n64\t        }\n65\t    }\n66\t}\n67\t\n68\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n69\tpub enum ConsolidationJobStatus {\n70\t    Queued,\n71\t    Running,\n72\t    Proposed,\n73\t    Applied,\n74\t    Rejected,\n75\t    Failed,\n76\t    Dropped,\n77\t}\n78\t\n79\timpl ConsolidationJobStatus {\n80\t    pub fn as_str(self) -> &'static str {\n81\t        match self {\n82\t            Self::Queued => \"queued\",\n83\t            Self::Running => \"running\",\n84\t            Self::Proposed => \"proposed\",\n85\t            Self::Applied => \"applied\",\n86\t            Self::Rejected => \"rejected\",\n87\t            Self::Failed => \"failed\",\n88\t            Self::Dropped => \"dropped\",\n89\t        }\n90\t    }\n91\t}\n92\t\n93\t#[derive(Clone, Debug, PartialEq, Eq)]\n94\tpub enum EnqueueOutcome {\n95\t    Queued { depth: usize },\n96\t    Dropped { reason: String },\n97\t}\n98\t\n99\tpub struct BoundedJobQueue {\n100\t    max_depth: usize,\n101\t    per_kind_max_depth: Option<usize>,\n102\t    jobs: VecDeque<ConsolidationJobSpec>,\n103\t    conn: Arc<Mutex<Connection>>,\n104\t}\n105\t\n106\timpl BoundedJobQueue {\n107\t    pub fn new(max_depth: usize, conn: Arc<Mutex<Connection>>) -> Self {\n108\t        Self {\n109\t            max_depth,\n110\t            per_kind_max_depth: None,\n111\t            jobs: VecDeque::new(),\n112\t            conn,\n113\t        }\n114\t    }\n115\t\n116\t    pub fn with_per_kind_max_depth(mut self, max_depth: usize) -> Self {\n117\t        self.per_kind_max_depth = Some(max_depth);\n118\t        self\n119\t    }\n120\t\n121\t    pub fn depth(&self) -> usize {\n122\t        self.jobs.len()\n123\t    }\n124\t\n125\t    pub fn enqueue(&mut self, job: ConsolidationJobSpec) -> Result<EnqueueOutcome, LatticeError> {\n126\t        if self.jobs.len() >= self.max_depth {\n127\t            self.persist_job(&job, ConsolidationJobStatus::Dropped)?;\n128\t            warn!(\n129\t                workspace_id = job.workspace_id.as_str(),\n130\t                kind = job.kind.as_str(),\n131\t                depth = self.jobs.len(),\n132\t                max_depth = self.max_depth,\n133\t                \"consolidation queue full; dropping job\"\n134\t            );\n135\t            return Ok(EnqueueOutcome::Dropped {\n136\t                reason: format!(\"consolidation queue depth {} reached\", self.max_depth),\n137\t            });\n138\t        }\n139\t\n140\t        self.persist_job(&job, ConsolidationJobStatus::Queued)?;\n141\t        self.jobs.push_back(job);\n142\t        Ok(EnqueueOutcome::Queued {\n143\t            depth: self.depth(),\n144\t        })\n145\t    }\n146\t\n147\t    pub fn enqueue_llm(\n148\t        &mut self,\n149\t        job: ConsolidationJobSpec,\n150\t        event_writer: &EventWriter,\n151\t        model_name: &str,\n152\t    ) -> Result<EnqueueOutcome, LatticeError> {\n153\t        if let Some(max_depth) = self.per_kind_max_depth {\n154\t            let current_depth = self.kind_depth(&job.kind);\n155\t            if current_depth >= max_depth {\n156\t                self.persist_job(&job, ConsolidationJobStatus::Dropped)?;\n157\t                warn!(\n158\t                    workspace_id = job.workspace_id.as_str(),\n159\t                    kind = job.kind.as_str(),\n160\t                    current_depth,\n161\t                    max_depth,\n162\t                    \"LLM consolidation queue slice full; dropping job\"\n163\t                );\n164\t                emit_queue_full(event_writer, &job, model_name, current_depth, max_depth)?;\n165\t                return Ok(EnqueueOutcome::Dropped {\n166\t                    reason: format!(\n167\t                        \"LLM consolidation queue slice {} reached for kind {}\",\n168\t                        max_depth, job.kind\n169\t                    ),\n170\t                });\n171\t            }\n172\t        }\n173\t        self.enqueue(job)\n174\t    }\n175\t\n176\t    pub(crate) fn persist_enqueued_only(\n177\t        &self,\n178\t        job: &ConsolidationJobSpec,\n179\t    ) -> Result<EnqueueOutcome, LatticeError> {\n180\t        self.persist_job(job, ConsolidationJobStatus::Queued)?;\n181\t        Ok(EnqueueOutcome::Queued {\n182\t            depth: self.depth(),\n183\t        })\n184\t    }\n185\t\n186\t    pub fn pop(&mut self) -> Option<ConsolidationJobSpec> {\n187\t        self.jobs.pop_front()\n188\t    }\n189\t\n190\t    pub fn drain_for_shutdown(&mut self) -> Vec<ConsolidationJobSpec> {\n191\t        self.jobs.drain(..).collect()\n192\t    }\n193\t\n194\t    fn kind_depth(&self, kind: &str) -> usize {\n195\t        self.jobs.iter().filter(|job| job.kind == kind).count()\n196\t    }\n197\t\n198\t    fn persist_job(\n199\t        &self,\n200\t        job: &ConsolidationJobSpec,\n201\t        status: ConsolidationJobStatus,\n202\t    ) -> Result<(), LatticeError> {\n203\t        let conn = self.conn.lock().map_err(|_| {\n204\t            LatticeError::Storage(\"consolidation queue storage lock was poisoned\".to_string())\n205\t        })?;\n206\t        conn.execute(\n207\t            \"INSERT OR REPLACE INTO consolidation_jobs\n208\t                (job_id, workspace_id, kind, mode, status, enqueued_at)\n209\t             VALUES (?1, ?2, ?3, ?4, ?5, ?6)\",\n210\t            params![\n211\t                job.job_id,\n212\t                job.workspace_id,\n213\t                job.kind,\n214\t                job.mode.as_str(),\n215\t                status.as_str(),\n216\t                now_unix_micros()\n217\t            ],\n218\t        )\n219\t        .map_err(|e| LatticeError::Storage(format!(\"Failed to persist consolidation job: {e}\")))?;\n220\t        Ok(())\n221\t    }\n222\t}\n223\t\n224\tfn emit_queue_full(\n225\t    event_writer: &EventWriter,\n226\t    job: &ConsolidationJobSpec,\n227\t    model_name: &str,\n228\t    current_depth: usize,\n229\t    max_depth: usize,\n230\t) -> Result<(), LatticeError> {\n231\t    let payload = ConsolidationFailedPayload {\n232\t        job_id: job.job_id.clone(),\n233\t        job_kind: job.kind.clone(),\n234\t        mode: job.mode.as_str().to_string(),\n235\t        model_name: model_name.to_string(),\n236\t        error_kind: \"queue_full\".to_string(),\n237\t        error_message: format!(\n238\t            \"LLM consolidation queue slice full for kind {} ({current_depth}/{max_depth})\",\n239\t            job.kind\n240\t        ),\n241\t    };\n242\t    event_writer\n243\t        .append(PartialEnvelope {\n244\t            workspace_id: Some(job.workspace_id.clone()),\n245\t            branch: BranchRef {\n246\t                name: \"main\".to_string(),\n247\t            },\n248\t            session_id: SessionId {\n249\t                value: \"llm-consolidation\".to_string(),\n250\t            },\n251\t            task_id: None,\n252\t            actor: Actor::Daemon,\n253\t            kind: EventKind::ConsolidationFailed,\n254\t            references: Vec::new(),\n255\t            summary: CompactSummary::new(format!(\n256\t                \"LLM consolidation {} failed: queue_full\",\n257\t                job.kind\n258\t            ))\n259\t            .map_err(|e| LatticeError::Storage(e.to_string()))?,\n260\t            payload: EventPayload::ConsolidationFailed(payload),\n261\t        })\n262\t        .map_err(|e| LatticeError::Storage(format!(\"Failed to write queue-full event: {e}\")))?;\n263\t    Ok(())\n264\t}\n265\t\n266\tpub(crate) fn now_unix_micros() -> i64 {\n267\t    std::time::SystemTime::now()\n268\t        .duration_since(std::time::UNIX_EPOCH)\n269\t        .unwrap_or_default()\n270\t        .as_micros()\n271\t        .min(i64::MAX as u128) as i64\n272\t}\n273\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"af3b51a5-7c93-451e-a698-9f886b848bbf","timestamp":"2026-05-17T11:41:41.429Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/queue.rs","content":"use std::collections::VecDeque;\nuse std::sync::{Arc, Mutex};\n\nuse rusqlite::{params, Connection};\nuse serde::{Deserialize, Serialize};\nuse tracing::warn;\n\nuse crate::error::LatticeError;\nuse crate::events::{\n    Actor, BranchRef, CompactSummary, ConsolidationFailedPayload, EventKind, EventPayload,\n    EventWriter, PartialEnvelope, SessionId,\n};\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct ConsolidationJobSpec {\n    pub job_id: String,\n    pub workspace_id: String,\n    pub kind: String,\n    pub mode: ConsolidationJobMode,\n    pub proposal: Option<PendingProposalSpec>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct ConsolidationJobRecord {\n    pub job_id: String,\n    pub workspace_id: String,\n    pub kind: String,\n    pub mode: ConsolidationJobMode,\n    pub status: ConsolidationJobStatus,\n    pub enqueued_at: i64,\n    pub started_at: Option<i64>,\n    pub finished_at: Option<i64>,\n    pub proposal_id: Option<String>,\n    pub error_kind: Option<String>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct PendingProposalSpec {\n    pub proposal_id: String,\n    pub target_memory_id: Option<String>,\n    pub proposal_kind: crate::consolidation::ProposalKind,\n    pub prior_state: serde_json::Value,\n    pub proposed_state: serde_json::Value,\n    pub evidence: serde_json::Value,\n    pub provenance: Option<crate::consolidation::llm::LlmProvenance>,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum ConsolidationJobMode {\n    SynchronousPostTask,\n    Background,\n    ManualReview,\n    Replay,\n}\n\nimpl ConsolidationJobMode {\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::SynchronousPostTask => \"synchronous_post_task\",\n            Self::Background => \"background\",\n            Self::ManualReview => \"manual_review\",\n            Self::Replay => \"replay\",\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum ConsolidationJobStatus {\n    Queued,\n    Running,\n    Proposed,\n    Applied,\n    Rejected,\n    Failed,\n    Dropped,\n}\n\nimpl ConsolidationJobStatus {\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::Queued => \"queued\",\n            Self::Running => \"running\",\n            Self::Proposed => \"proposed\",\n            Self::Applied => \"applied\",\n            Self::Rejected => \"rejected\",\n            Self::Failed => \"failed\",\n            Self::Dropped => \"dropped\",\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum EnqueueOutcome {\n    Queued { depth: usize },\n    Dropped { reason: String },\n}\n\npub struct BoundedJobQueue {\n    max_depth: usize,\n    per_kind_max_depth: Option<usize>,\n    jobs: VecDeque<ConsolidationJobSpec>,\n    conn: Arc<Mutex<Connection>>,\n}\n\nimpl BoundedJobQueue {\n    pub fn new(max_depth: usize, conn: Arc<Mutex<Connection>>) -> Self {\n        Self {\n            max_depth,\n            per_kind_max_depth: None,\n            jobs: VecDeque::new(),\n            conn,\n        }\n    }\n\n    pub fn with_per_kind_max_depth(mut self, max_depth: usize) -> Self {\n        self.per_kind_max_depth = Some(max_depth);\n        self\n    }\n\n    pub fn depth(&self) -> usize {\n        self.jobs.len()\n    }\n\n    pub fn enqueue(&mut self, job: ConsolidationJobSpec) -> Result<EnqueueOutcome, LatticeError> {\n        if self.jobs.len() >= self.max_depth {\n            self.persist_job(&job, ConsolidationJobStatus::Dropped)?;\n            warn!(\n                workspace_id = job.workspace_id.as_str(),\n                kind = job.kind.as_str(),\n                depth = self.jobs.len(),\n                max_depth = self.max_depth,\n                \"consolidation queue full; dropping job\"\n            );\n            return Ok(EnqueueOutcome::Dropped {\n                reason: format!(\"consolidation queue depth {} reached\", self.max_depth),\n            });\n        }\n\n        self.persist_job(&job, ConsolidationJobStatus::Queued)?;\n        self.jobs.push_back(job);\n        Ok(EnqueueOutcome::Queued {\n            depth: self.depth(),\n        })\n    }\n\n    pub fn enqueue_llm(\n        &mut self,\n        job: ConsolidationJobSpec,\n        event_writer: &EventWriter,\n        model_name: &str,\n    ) -> Result<EnqueueOutcome, LatticeError> {\n        if let Some(max_depth) = self.per_kind_max_depth {\n            let current_depth = self.kind_depth(&job.kind);\n            if current_depth >= max_depth {\n                self.persist_job(&job, ConsolidationJobStatus::Dropped)?;\n                warn!(\n                    workspace_id = job.workspace_id.as_str(),\n                    kind = job.kind.as_str(),\n                    current_depth,\n                    max_depth,\n                    \"LLM consolidation queue slice full; dropping job\"\n                );\n                emit_queue_full(event_writer, &job, model_name, current_depth, max_depth)?;\n                return Ok(EnqueueOutcome::Dropped {\n                    reason: format!(\n                        \"LLM consolidation queue slice {} reached for kind {}\",\n                        max_depth, job.kind\n                    ),\n                });\n            }\n        }\n        self.enqueue(job)\n    }\n\n    pub(crate) fn persist_enqueued_only(\n        &self,\n        job: &ConsolidationJobSpec,\n    ) -> Result<EnqueueOutcome, LatticeError> {\n        self.persist_job(job, ConsolidationJobStatus::Queued)?;\n        Ok(EnqueueOutcome::Queued {\n            depth: self.depth(),\n        })\n    }\n\n    pub fn pop(&mut self) -> Option<ConsolidationJobSpec> {\n        self.jobs.pop_front()\n    }\n\n    pub fn drain_for_shutdown(&mut self) -> Vec<ConsolidationJobSpec> {\n        self.jobs.drain(..).collect()\n    }\n\n    fn kind_depth(&self, kind: &str) -> usize {\n        self.jobs.iter().filter(|job| job.kind == kind).count()\n    }\n\n    fn persist_job(\n        &self,\n        job: &ConsolidationJobSpec,\n        status: ConsolidationJobStatus,\n    ) -> Result<(), LatticeError> {\n        let conn = self.conn.lock().map_err(|_| {\n            LatticeError::Storage(\"consolidation queue storage lock was poisoned\".to_string())\n        })?;\n        conn.execute(\n            \"INSERT OR REPLACE INTO consolidation_jobs\n                (job_id, workspace_id, kind, mode, status, enqueued_at)\n             VALUES (?1, ?2, ?3, ?4, ?5, ?6)\",\n            params![\n                job.job_id,\n                job.workspace_id,\n                job.kind,\n                job.mode.as_str(),\n                status.as_str(),\n                now_unix_micros()\n            ],\n        )\n        .map_err(|e| LatticeError::Storage(format!(\"Failed to persist consolidation job: {e}\")))?;\n        Ok(())\n    }\n}\n\nfn emit_queue_full(\n    event_writer: &EventWriter,\n    job: &ConsolidationJobSpec,\n    model_name: &str,\n    current_depth: usize,\n    max_depth: usize,\n) -> Result<(), LatticeError> {\n    let payload = ConsolidationFailedPayload {\n        job_id: job.job_id.clone(),\n        job_kind: job.kind.clone(),\n        mode: job.mode.as_str().to_string(),\n        model_name: model_name.to_string(),\n        error_kind: \"queue_full\".to_string(),\n        error_message: format!(\n            \"LLM consolidation queue slice full for kind {} ({current_depth}/{max_depth})\",\n            job.kind\n        ),\n    };\n    event_writer\n        .append(PartialEnvelope {\n            workspace_id: Some(job.workspace_id.clone()),\n            branch: BranchRef {\n                name: \"main\".to_string(),\n            },\n            session_id: SessionId {\n                value: \"llm-consolidation\".to_string(),\n            },\n            task_id: None,\n            actor: Actor::Daemon,\n            kind: EventKind::ConsolidationFailed,\n            references: Vec::new(),\n            summary: CompactSummary::new(format!(\n                \"LLM consolidation {} failed: queue_full\",\n                job.kind\n            ))\n            .map_err(|e| LatticeError::Storage(e.to_string()))?,\n            payload: EventPayload::ConsolidationFailed(payload),\n        })\n        .map_err(|e| LatticeError::Storage(format!(\"Failed to write queue-full event: {e}\")))?;\n    Ok(())\n}\n\npub(crate) fn now_unix_micros() -> i64 {\n    std::time::SystemTime::now()\n        .duration_since(std::time::UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_micros()\n        .min(i64::MAX as u128) as i64\n}\n","numLines":273,"startLine":1,"totalLines":273}}}
