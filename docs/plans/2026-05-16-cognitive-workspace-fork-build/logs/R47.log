{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014qb383eSZEsdoZ3k12CPZQ","type":"tool_result","content":"1\t//! Manual review queue for high-scope consolidation proposals.\n2\t//!\n3\t//! This module implements the scope-gating rule from\n4\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## 6. Consolidation Engine` \"Consolidation modes\": proposals whose target\n6\t//! memory scope is `repo` or `organization` must remain pending for explicit\n7\t//! human review instead of flowing through low-scope auto-apply policy.\n8\t//! It also provides the durable queue backing required by\n9\t//! `## 10. Human Review Surface` \"Required operator views\" so the future memory\n10\t//! inbox and consolidation queue can read, inspect, and decide pending items\n11\t//! without reimplementing scope logic.\n12\t\n13\tuse std::convert::TryFrom;\n14\t\n15\tuse rusqlite::{params, Connection};\n16\tuse serde::{Deserialize, Serialize};\n17\tuse serde_json::Value;\n18\tuse tracing::info_span;\n19\t\n20\tuse crate::consolidation::llm::LlmProvenance;\n21\tuse crate::consolidation::proposal::{load_row, ConsolidationProposalRow};\n22\tuse crate::consolidation::{\n23\t    ApplyOutcome, ConsolidationProposal, ProposalDecision, ProposalKind, RejectOutcome,\n24\t};\n25\tuse crate::error::LatticeError;\n26\tuse crate::events::EventWriter;\n27\tuse crate::identity::OperatorId;\n28\tuse crate::memory::MemoryStore;\n29\tuse crate::memory_graph::MemoryScope;\n30\t\n31\t#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\n32\tpub struct ReviewQueueFilter {\n33\t    pub scope: Option<MemoryScope>,\n34\t    pub kind: Option<ProposalKind>,\n35\t    pub older_than: Option<i64>,\n36\t    pub workspace_id: Option<String>,\n37\t}\n38\t\n39\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n40\tpub struct ReviewItem {\n41\t    pub proposal_id: String,\n42\t    pub job_id: String,\n43\t    pub workspace_id: String,\n44\t    pub kind: ProposalKind,\n45\t    pub scope: MemoryScope,\n46\t    pub target_memory_id: Option<String>,\n47\t    pub prior_state: Value,\n48\t    pub proposed_state: Value,\n49\t    pub evidence: Value,\n50\t    pub provenance: Option<LlmProvenance>,\n51\t    pub enqueued_at: i64,\n52\t    pub decided_at: Option<i64>,\n53\t    pub decision: ProposalDecision,\n54\t    pub decided_by: Option<String>,\n55\t    pub decision_reason: Option<String>,\n56\t}\n57\t\n58\t#[derive(Clone, Debug, PartialEq, Eq)]\n59\tpub enum ReviewDecisionOutcome {\n60\t    Applied { outcome: ApplyOutcome },\n61\t    Rejected { outcome: RejectOutcome },\n62\t    AlreadyDecided { decision: ProposalDecision },\n63\t}\n64\t\n65\t#[derive(Debug, thiserror::Error)]\n66\tpub enum ReviewQueueError {\n67\t    #[error(transparent)]\n68\t    Storage(#[from] LatticeError),\n69\t    #[error(\"review proposal '{proposal_id}' was not found\")]\n70\t    ProposalNotFound { proposal_id: String },\n71\t    #[error(\"proposal '{proposal_id}' is not eligible for manual review (scope {scope})\")]\n72\t    ScopeMismatch { proposal_id: String, scope: String },\n73\t    #[error(\"proposal '{proposal_id}' does not encode a target scope\")]\n74\t    MissingScope { proposal_id: String },\n75\t}\n76\t\n77\tpub struct ReviewQueue<'a> {\n78\t    conn: &'a Connection,\n79\t    memory_store: &'a MemoryStore,\n80\t    event_writer: &'a EventWriter,\n81\t}\n82\t\n83\timpl<'a> ReviewQueue<'a> {\n84\t    pub fn new(\n85\t        conn: &'a Connection,\n86\t        memory_store: &'a MemoryStore,\n87\t        event_writer: &'a EventWriter,\n88\t    ) -> Self {\n89\t        Self {\n90\t            conn,\n91\t            memory_store,\n92\t            event_writer,\n93\t        }\n94\t    }\n95\t\n96\t    pub fn should_gate(proposal: &ConsolidationProposal) -> bool {\n97\t        proposal_scope_value(&proposal.proposed_state, &proposal.prior_state)\n98\t            .and_then(parse_scope_value)\n99\t            .is_some_and(is_manual_review_scope)\n100\t    }\n101\t\n102\t    pub fn enqueue(\n103\t        &self,\n104\t        proposal: &ConsolidationProposal,\n105\t    ) -> Result<Option<ReviewItem>, ReviewQueueError> {\n106\t        if !Self::should_gate(proposal) {\n107\t            return Ok(None);\n108\t        }\n109\t        self.inspect(&proposal.proposal_id).map(Some)\n110\t    }\n111\t\n112\t    pub fn list_pending(\n113\t        &self,\n114\t        workspace_id: &str,\n115\t        filter: &ReviewQueueFilter,\n116\t    ) -> Result<Vec<ReviewItem>, ReviewQueueError> {\n117\t        let requested_workspace = filter.workspace_id.as_deref().unwrap_or(workspace_id);\n118\t        let mut statement = self\n119\t            .conn\n120\t            .prepare(\n121\t                \"SELECT p.proposal_id,\n122\t                    p.job_id,\n123\t                    j.workspace_id,\n124\t                    j.enqueued_at,\n125\t                    p.target_memory_id,\n126\t                    p.proposal_kind,\n127\t                    p.prior_state,\n128\t                    p.proposed_state,\n129\t                    p.evidence,\n130\t                    p.provenance_json,\n131\t                    p.decided_at,\n132\t                    p.decision,\n133\t                    p.decided_by,\n134\t                    p.decision_reason\n135\t             FROM consolidation_proposals p\n136\t             INNER JOIN consolidation_jobs j ON j.job_id = p.job_id\n137\t             WHERE p.decision = 'pending'\n138\t               AND j.workspace_id = ?1\n139\t             ORDER BY j.enqueued_at ASC\",\n140\t            )\n141\t            .map_err(storage_error)?;\n142\t        let rows = statement\n143\t            .query_map(params![requested_workspace], map_review_row)\n144\t            .map_err(storage_error)?;\n145\t        let mut items = Vec::new();\n146\t        for row in rows {\n147\t            let item = ReviewItem::try_from(row.map_err(storage_error)?)?;\n148\t            if !is_manual_review_scope(item.scope) {\n149\t                continue;\n150\t            }\n151\t            if let Some(scope) = filter.scope {\n152\t                if item.scope != scope {\n153\t                    continue;\n154\t                }\n155\t            }\n156\t            if let Some(kind) = filter.kind {\n157\t                if item.kind != kind {\n158\t                    continue;\n159\t                }\n160\t            }\n161\t            if let Some(older_than) = filter.older_than {\n162\t                if item.enqueued_at > older_than {\n163\t                    continue;\n164\t                }\n165\t            }\n166\t            items.push(item);\n167\t        }\n168\t        Ok(items)\n169\t    }\n170\t\n171\t    /// Internal review-queue API for the Phase 10 memory inbox described in\n172\t    /// `## 10. Human Review Surface` \"Required operator views\".\n173\t    pub fn inspect(&self, proposal_id: &str) -> Result<ReviewItem, ReviewQueueError> {\n174\t        let row = load_row(self.conn, proposal_id)?.ok_or_else(|| {\n175\t            ReviewQueueError::ProposalNotFound {\n176\t                proposal_id: proposal_id.to_string(),\n177\t            }\n178\t        })?;\n179\t        let item = ReviewItem::try_from(row)?;\n180\t        if !is_manual_review_scope(item.scope) {\n181\t            return Err(ReviewQueueError::ScopeMismatch {\n182\t                proposal_id: proposal_id.to_string(),\n183\t                scope: item.scope.as_str().to_string(),\n184\t            });\n185\t        }\n186\t        Ok(item)\n187\t    }\n188\t\n189\t    pub fn decide(\n190\t        &self,\n191\t        proposal_id: &str,\n192\t        decision: ProposalDecision,\n193\t        decided_by: &OperatorId,\n194\t        reason: Option<String>,\n195\t    ) -> Result<ReviewDecisionOutcome, ReviewQueueError> {\n196\t        let item = self.inspect(proposal_id)?;\n197\t        let span = info_span!(\n198\t            \"manual_review_decision\",\n199\t            proposal_id = item.proposal_id.as_str(),\n200\t            scope = item.scope.as_str(),\n201\t            decision = decision.as_str(),\n202\t            decided_by = decided_by.value.as_str()\n203\t        );\n204\t        let _entered = span.enter();\n205\t        if item.decision != ProposalDecision::Pending {\n206\t            return Ok(ReviewDecisionOutcome::AlreadyDecided {\n207\t                decision: item.decision,\n208\t            });\n209\t        }\n210\t        let proposal = ConsolidationProposal::load(self.conn, proposal_id)?.ok_or_else(|| {\n211\t            ReviewQueueError::ProposalNotFound {\n212\t                proposal_id: proposal_id.to_string(),\n213\t            }\n214\t        })?;\n215\t        let reason_ref = reason.as_deref();\n216\t        match decision {\n217\t            ProposalDecision::Applied => {\n218\t                let outcome = proposal.apply(\n219\t                    self.conn,\n220\t                    self.memory_store,\n221\t                    self.event_writer,\n222\t                    decided_by.value.as_str(),\n223\t                    reason_ref,\n224\t                )?;\n225\t                Ok(ReviewDecisionOutcome::Applied { outcome })\n226\t            }\n227\t            ProposalDecision::Rejected => {\n228\t                let outcome = proposal.reject(\n229\t                    self.conn,\n230\t                    self.event_writer,\n231\t                    decided_by.value.as_str(),\n232\t                    reason_ref,\n233\t                )?;\n234\t                Ok(ReviewDecisionOutcome::Rejected { outcome })\n235\t            }\n236\t            ProposalDecision::Pending | ProposalDecision::Reverted => {\n237\t                Ok(ReviewDecisionOutcome::AlreadyDecided { decision })\n238\t            }\n239\t        }\n240\t    }\n241\t}\n242\t\n243\tfn storage_error(error: rusqlite::Error) -> ReviewQueueError {\n244\t    ReviewQueueError::Storage(LatticeError::Storage(format!(\n245\t        \"Review queue storage failed: {error}\"\n246\t    )))\n247\t}\n248\t\n249\timpl TryFrom<ConsolidationProposalRow> for ReviewItem {\n250\t    type Error = ReviewQueueError;\n251\t\n252\t    fn try_from(row: ConsolidationProposalRow) -> Result<Self, Self::Error> {\n253\t        let scope = proposal_scope_from_strings(\n254\t            row.proposal_id.as_str(),\n255\t            &row.proposed_state,\n256\t            &row.prior_state,\n257\t        )?;\n258\t        Ok(Self {\n259\t            proposal_id: row.proposal_id,\n260\t            job_id: row.job_id,\n261\t            workspace_id: row.workspace_id,\n262\t            kind: ProposalKind::from_str(&row.proposal_kind)?,\n263\t            scope,\n264\t            target_memory_id: row.target_memory_id,\n265\t            prior_state: serde_json::from_str(&row.prior_state).map_err(json_error)?,\n266\t            proposed_state: serde_json::from_str(&row.proposed_state).map_err(json_error)?,\n267\t            evidence: serde_json::from_str(&row.evidence).map_err(json_error)?,\n268\t            provenance: row\n269\t                .provenance_json\n270\t                .map(|value| serde_json::from_str(&value).map_err(json_error))\n271\t                .transpose()?,\n272\t            enqueued_at: row.enqueued_at,\n273\t            decided_at: row.decided_at,\n274\t            decision: ProposalDecision::from_str(&row.decision)?,\n275\t            decided_by: row.decided_by,\n276\t            decision_reason: row.decision_reason,\n277\t        })\n278\t    }\n279\t}\n280\t\n281\tfn map_review_row(row: &rusqlite::Row<'_>) -> rusqlite::Result<ConsolidationProposalRow> {\n282\t    Ok(ConsolidationProposalRow {\n283\t        proposal_id: row.get(0)?,\n284\t        job_id: row.get(1)?,\n285\t        workspace_id: row.get(2)?,\n286\t        enqueued_at: row.get(3)?,\n287\t        target_memory_id: row.get(4)?,\n288\t        proposal_kind: row.get(5)?,\n289\t        prior_state: row.get(6)?,\n290\t        proposed_state: row.get(7)?,\n291\t        evidence: row.get(8)?,\n292\t        provenance_json: row.get(9)?,\n293\t        decided_at: row.get(10)?,\n294\t        decision: row.get(11)?,\n295\t        decided_by: row.get(12)?,\n296\t        decision_reason: row.get(13)?,\n297\t    })\n298\t}\n299\t\n300\tfn proposal_scope_from_strings(\n301\t    proposal_id: &str,\n302\t    proposed_state: &str,\n303\t    prior_state: &str,\n304\t) -> Result<MemoryScope, ReviewQueueError> {\n305\t    let proposed = serde_json::from_str(proposed_state).map_err(json_error)?;\n306\t    let prior = serde_json::from_str(prior_state).map_err(json_error)?;\n307\t    proposal_scope(&proposed, &prior).ok_or_else(|| ReviewQueueError::MissingScope {\n308\t        proposal_id: proposal_id.to_string(),\n309\t    })\n310\t}\n311\t\n312\tfn proposal_scope(proposed_state: &Value, prior_state: &Value) -> Option<MemoryScope> {\n313\t    proposal_scope_value(proposed_state, prior_state).and_then(parse_scope_value)\n314\t}\n315\t\n316\tfn proposal_scope_value<'a>(proposed_state: &'a Value, prior_state: &'a Value) -> Option<&'a str> {\n317\t    proposed_state\n318\t        .pointer(\"/memory/scope\")\n319\t        .and_then(Value::as_str)\n320\t        .or_else(|| proposed_state.get(\"scope\").and_then(Value::as_str))\n321\t        .or_else(|| prior_state.pointer(\"/memory/scope\").and_then(Value::as_str))\n322\t        .or_else(|| prior_state.get(\"scope\").and_then(Value::as_str))\n323\t}\n324\t\n325\tfn parse_scope_value(value: &str) -> Option<MemoryScope> {\n326\t    match value.trim().trim_matches('\"').to_ascii_lowercase().as_str() {\n327\t        \"session\" => Some(MemoryScope::Session),\n328\t        \"branch\" => Some(MemoryScope::Branch),\n329\t        \"repo\" => Some(MemoryScope::Repo),\n330\t        \"organization\" => Some(MemoryScope::Organization),\n331\t        \"user\" => Some(MemoryScope::User),\n332\t        _ => None,\n333\t    }\n334\t}\n335\t\n336\tfn is_manual_review_scope(scope: MemoryScope) -> bool {\n337\t    matches!(scope, MemoryScope::Repo | MemoryScope::Organization)\n338\t}\n339\t\n340\tfn json_error(error: serde_json::Error) -> ReviewQueueError {\n341\t    ReviewQueueError::Storage(LatticeError::Storage(format!(\n342\t        \"Failed to process review queue JSON: {error}\"\n343\t    )))\n344\t}\n345\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"b20aa508-736a-4124-8518-842243e03e0a","timestamp":"2026-05-17T11:41:58.224Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/review_queue.rs","content":"//! Manual review queue for high-scope consolidation proposals.\n//!\n//! This module implements the scope-gating rule from\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 6. Consolidation Engine` \"Consolidation modes\": proposals whose target\n//! memory scope is `repo` or `organization` must remain pending for explicit\n//! human review instead of flowing through low-scope auto-apply policy.\n//! It also provides the durable queue backing required by\n//! `## 10. Human Review Surface` \"Required operator views\" so the future memory\n//! inbox and consolidation queue can read, inspect, and decide pending items\n//! without reimplementing scope logic.\n\nuse std::convert::TryFrom;\n\nuse rusqlite::{params, Connection};\nuse serde::{Deserialize, Serialize};\nuse serde_json::Value;\nuse tracing::info_span;\n\nuse crate::consolidation::llm::LlmProvenance;\nuse crate::consolidation::proposal::{load_row, ConsolidationProposalRow};\nuse crate::consolidation::{\n    ApplyOutcome, ConsolidationProposal, ProposalDecision, ProposalKind, RejectOutcome,\n};\nuse crate::error::LatticeError;\nuse crate::events::EventWriter;\nuse crate::identity::OperatorId;\nuse crate::memory::MemoryStore;\nuse crate::memory_graph::MemoryScope;\n\n#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub struct ReviewQueueFilter {\n    pub scope: Option<MemoryScope>,\n    pub kind: Option<ProposalKind>,\n    pub older_than: Option<i64>,\n    pub workspace_id: Option<String>,\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\npub struct ReviewItem {\n    pub proposal_id: String,\n    pub job_id: String,\n    pub workspace_id: String,\n    pub kind: ProposalKind,\n    pub scope: MemoryScope,\n    pub target_memory_id: Option<String>,\n    pub prior_state: Value,\n    pub proposed_state: Value,\n    pub evidence: Value,\n    pub provenance: Option<LlmProvenance>,\n    pub enqueued_at: i64,\n    pub decided_at: Option<i64>,\n    pub decision: ProposalDecision,\n    pub decided_by: Option<String>,\n    pub decision_reason: Option<String>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum ReviewDecisionOutcome {\n    Applied { outcome: ApplyOutcome },\n    Rejected { outcome: RejectOutcome },\n    AlreadyDecided { decision: ProposalDecision },\n}\n\n#[derive(Debug, thiserror::Error)]\npub enum ReviewQueueError {\n    #[error(transparent)]\n    Storage(#[from] LatticeError),\n    #[error(\"review proposal '{proposal_id}' was not found\")]\n    ProposalNotFound { proposal_id: String },\n    #[error(\"proposal '{proposal_id}' is not eligible for manual review (scope {scope})\")]\n    ScopeMismatch { proposal_id: String, scope: String },\n    #[error(\"proposal '{proposal_id}' does not encode a target scope\")]\n    MissingScope { proposal_id: String },\n}\n\npub struct ReviewQueue<'a> {\n    conn: &'a Connection,\n    memory_store: &'a MemoryStore,\n    event_writer: &'a EventWriter,\n}\n\nimpl<'a> ReviewQueue<'a> {\n    pub fn new(\n        conn: &'a Connection,\n        memory_store: &'a MemoryStore,\n        event_writer: &'a EventWriter,\n    ) -> Self {\n        Self {\n            conn,\n            memory_store,\n            event_writer,\n        }\n    }\n\n    pub fn should_gate(proposal: &ConsolidationProposal) -> bool {\n        proposal_scope_value(&proposal.proposed_state, &proposal.prior_state)\n            .and_then(parse_scope_value)\n            .is_some_and(is_manual_review_scope)\n    }\n\n    pub fn enqueue(\n        &self,\n        proposal: &ConsolidationProposal,\n    ) -> Result<Option<ReviewItem>, ReviewQueueError> {\n        if !Self::should_gate(proposal) {\n            return Ok(None);\n        }\n        self.inspect(&proposal.proposal_id).map(Some)\n    }\n\n    pub fn list_pending(\n        &self,\n        workspace_id: &str,\n        filter: &ReviewQueueFilter,\n    ) -> Result<Vec<ReviewItem>, ReviewQueueError> {\n        let requested_workspace = filter.workspace_id.as_deref().unwrap_or(workspace_id);\n        let mut statement = self\n            .conn\n            .prepare(\n                \"SELECT p.proposal_id,\n                    p.job_id,\n                    j.workspace_id,\n                    j.enqueued_at,\n                    p.target_memory_id,\n                    p.proposal_kind,\n                    p.prior_state,\n                    p.proposed_state,\n                    p.evidence,\n                    p.provenance_json,\n                    p.decided_at,\n                    p.decision,\n                    p.decided_by,\n                    p.decision_reason\n             FROM consolidation_proposals p\n             INNER JOIN consolidation_jobs j ON j.job_id = p.job_id\n             WHERE p.decision = 'pending'\n               AND j.workspace_id = ?1\n             ORDER BY j.enqueued_at ASC\",\n            )\n            .map_err(storage_error)?;\n        let rows = statement\n            .query_map(params![requested_workspace], map_review_row)\n            .map_err(storage_error)?;\n        let mut items = Vec::new();\n        for row in rows {\n            let item = ReviewItem::try_from(row.map_err(storage_error)?)?;\n            if !is_manual_review_scope(item.scope) {\n                continue;\n            }\n            if let Some(scope) = filter.scope {\n                if item.scope != scope {\n                    continue;\n                }\n            }\n            if let Some(kind) = filter.kind {\n                if item.kind != kind {\n                    continue;\n                }\n            }\n            if let Some(older_than) = filter.older_than {\n                if item.enqueued_at > older_than {\n                    continue;\n                }\n            }\n            items.push(item);\n        }\n        Ok(items)\n    }\n\n    /// Internal review-queue API for the Phase 10 memory inbox described in\n    /// `## 10. Human Review Surface` \"Required operator views\".\n    pub fn inspect(&self, proposal_id: &str) -> Result<ReviewItem, ReviewQueueError> {\n        let row = load_row(self.conn, proposal_id)?.ok_or_else(|| {\n            ReviewQueueError::ProposalNotFound {\n                proposal_id: proposal_id.to_string(),\n            }\n        })?;\n        let item = ReviewItem::try_from(row)?;\n        if !is_manual_review_scope(item.scope) {\n            return Err(ReviewQueueError::ScopeMismatch {\n                proposal_id: proposal_id.to_string(),\n                scope: item.scope.as_str().to_string(),\n            });\n        }\n        Ok(item)\n    }\n\n    pub fn decide(\n        &self,\n        proposal_id: &str,\n        decision: ProposalDecision,\n        decided_by: &OperatorId,\n        reason: Option<String>,\n    ) -> Result<ReviewDecisionOutcome, ReviewQueueError> {\n        let item = self.inspect(proposal_id)?;\n        let span = info_span!(\n            \"manual_review_decision\",\n            proposal_id = item.proposal_id.as_str(),\n            scope = item.scope.as_str(),\n            decision = decision.as_str(),\n            decided_by = decided_by.value.as_str()\n        );\n        let _entered = span.enter();\n        if item.decision != ProposalDecision::Pending {\n            return Ok(ReviewDecisionOutcome::AlreadyDecided {\n                decision: item.decision,\n            });\n        }\n        let proposal = ConsolidationProposal::load(self.conn, proposal_id)?.ok_or_else(|| {\n            ReviewQueueError::ProposalNotFound {\n                proposal_id: proposal_id.to_string(),\n            }\n        })?;\n        let reason_ref = reason.as_deref();\n        match decision {\n            ProposalDecision::Applied => {\n                let outcome = proposal.apply(\n                    self.conn,\n                    self.memory_store,\n                    self.event_writer,\n                    decided_by.value.as_str(),\n                    reason_ref,\n                )?;\n                Ok(ReviewDecisionOutcome::Applied { outcome })\n            }\n            ProposalDecision::Rejected => {\n                let outcome = proposal.reject(\n                    self.conn,\n                    self.event_writer,\n                    decided_by.value.as_str(),\n                    reason_ref,\n                )?;\n                Ok(ReviewDecisionOutcome::Rejected { outcome })\n            }\n            ProposalDecision::Pending | ProposalDecision::Reverted => {\n                Ok(ReviewDecisionOutcome::AlreadyDecided { decision })\n            }\n        }\n    }\n}\n\nfn storage_error(error: rusqlite::Error) -> ReviewQueueError {\n    ReviewQueueError::Storage(LatticeError::Storage(format!(\n        \"Review queue storage failed: {error}\"\n    )))\n}\n\nimpl TryFrom<ConsolidationProposalRow> for ReviewItem {\n    type Error = ReviewQueueError;\n\n    fn try_from(row: ConsolidationProposalRow) -> Result<Self, Self::Error> {\n        let scope = proposal_scope_from_strings(\n            row.proposal_id.as_str(),\n            &row.proposed_state,\n            &row.prior_state,\n        )?;\n        Ok(Self {\n            proposal_id: row.proposal_id,\n            job_id: row.job_id,\n            workspace_id: row.workspace_id,\n            kind: ProposalKind::from_str(&row.proposal_kind)?,\n            scope,\n            target_memory_id: row.target_memory_id,\n            prior_state: serde_json::from_str(&row.prior_state).map_err(json_error)?,\n            proposed_state: serde_json::from_str(&row.proposed_state).map_err(json_error)?,\n            evidence: serde_json::from_str(&row.evidence).map_err(json_error)?,\n            provenance: row\n                .provenance_json\n                .map(|value| serde_json::from_str(&value).map_err(json_error))\n                .transpose()?,\n            enqueued_at: row.enqueued_at,\n            decided_at: row.decided_at,\n            decision: ProposalDecision::from_str(&row.decision)?,\n            decided_by: row.decided_by,\n            decision_reason: row.decision_reason,\n        })\n    }\n}\n\nfn map_review_row(row: &rusqlite::Row<'_>) -> rusqlite::Result<ConsolidationProposalRow> {\n    Ok(ConsolidationProposalRow {\n        proposal_id: row.get(0)?,\n        job_id: row.get(1)?,\n        workspace_id: row.get(2)?,\n        enqueued_at: row.get(3)?,\n        target_memory_id: row.get(4)?,\n        proposal_kind: row.get(5)?,\n        prior_state: row.get(6)?,\n        proposed_state: row.get(7)?,\n        evidence: row.get(8)?,\n        provenance_json: row.get(9)?,\n        decided_at: row.get(10)?,\n        decision: row.get(11)?,\n        decided_by: row.get(12)?,\n        decision_reason: row.get(13)?,\n    })\n}\n\nfn proposal_scope_from_strings(\n    proposal_id: &str,\n    proposed_state: &str,\n    prior_state: &str,\n) -> Result<MemoryScope, ReviewQueueError> {\n    let proposed = serde_json::from_str(proposed_state).map_err(json_error)?;\n    let prior = serde_json::from_str(prior_state).map_err(json_error)?;\n    proposal_scope(&proposed, &prior).ok_or_else(|| ReviewQueueError::MissingScope {\n        proposal_id: proposal_id.to_string(),\n    })\n}\n\nfn proposal_scope(proposed_state: &Value, prior_state: &Value) -> Option<MemoryScope> {\n    proposal_scope_value(proposed_state, prior_state).and_then(parse_scope_value)\n}\n\nfn proposal_scope_value<'a>(proposed_state: &'a Value, prior_state: &'a Value) -> Option<&'a str> {\n    proposed_state\n        .pointer(\"/memory/scope\")\n        .and_then(Value::as_str)\n        .or_else(|| proposed_state.get(\"scope\").and_then(Value::as_str))\n        .or_else(|| prior_state.pointer(\"/memory/scope\").and_then(Value::as_str))\n        .or_else(|| prior_state.get(\"scope\").and_then(Value::as_str))\n}\n\nfn parse_scope_value(value: &str) -> Option<MemoryScope> {\n    match value.trim().trim_matches('\"').to_ascii_lowercase().as_str() {\n        \"session\" => Some(MemoryScope::Session),\n        \"branch\" => Some(MemoryScope::Branch),\n        \"repo\" => Some(MemoryScope::Repo),\n        \"organization\" => Some(MemoryScope::Organization),\n        \"user\" => Some(MemoryScope::User),\n        _ => None,\n    }\n}\n\nfn is_manual_review_scope(scope: MemoryScope) -> bool {\n    matches!(scope, MemoryScope::Repo | MemoryScope::Organization)\n}\n\nfn json_error(error: serde_json::Error) -> ReviewQueueError {\n    ReviewQueueError::Storage(LatticeError::Storage(format!(\n        \"Failed to process review queue JSON: {error}\"\n    )))\n}\n","numLines":345,"startLine":1,"totalLines":345}}}
{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_01DJSjm4bh4xZs46TDq5DNPe","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JmFuvuxk9Y58dW9Zu8v5Ki","name":"Read","input":{"file_path":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/replay.rs"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":5695,"cache_read_input_tokens":148676,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5695},"output_tokens":40,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"14330f83-61e1-4f93-bde9-6b34f2537eec","request_id":"req_011Cb85bRFShkdN8rLqTaWe9"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JmFuvuxk9Y58dW9Zu8v5Ki","type":"tool_result","content":"1\t//! Replay-safe consolidation rebuilds and mechanical proposal reversal.\n2\t//!\n3\t//! Spec excerpts from\n4\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## 6. Consolidation Engine` and\n6\t//! `## Non-Negotiable Product Properties`:\n7\t//!\n8\t//! > \"Consolidation modes: ... replay mode for rebuilding memory state from the event log.\"\n9\t//!\n10\t//! > \"Every background consolidation pass is recoverable, replayable, and observable.\"\n11\t\n12\tuse std::collections::HashMap;\n13\tuse std::sync::Arc;\n14\t\n15\tuse rusqlite::Connection;\n16\tuse serde_json::Value;\n17\tuse sha2::{Digest, Sha256};\n18\tuse tracing::{error, field, info_span};\n19\t\n20\tuse crate::consolidation::llm::LlmDriver;\n21\tuse crate::consolidation::proposal::{\n22\t    apply_memory_state, empty_state, state_hash_for_memory, ConsolidationProposal,\n23\t};\n24\tuse crate::events::{EventPayload, EventReader, EventStore, EventStoreError};\n25\tuse crate::identity::EventId;\n26\tuse crate::memory::MemoryStore;\n27\tuse crate::LatticeError;\n28\t\n29\tpub type PromptHash = [u8; 32];\n30\tpub type ResponseBytes = Vec<u8>;\n31\t\n32\tpub trait Clock: Send + Sync {\n33\t    fn pin(&self, unix_micros: i64);\n34\t    fn now_unix_micros(&self) -> i64;\n35\t}\n36\t\n37\t#[derive(Default)]\n38\tpub struct FixedReplayClock(std::sync::Mutex<i64>);\n39\t\n40\timpl Clock for FixedReplayClock {\n41\t    fn pin(&self, unix_micros: i64) {\n42\t        if let Ok(mut guard) = self.0.lock() {\n43\t            *guard = unix_micros;\n44\t        }\n45\t    }\n46\t\n47\t    fn now_unix_micros(&self) -> i64 {\n48\t        self.0.lock().map(|guard| *guard).unwrap_or_default()\n49\t    }\n50\t}\n51\t\n52\t#[derive(Clone, Debug, PartialEq, Eq)]\n53\tpub enum ReplayMode {\n54\t    FromGenesis,\n55\t    FromSnapshot { snapshot_id: i64 },\n56\t    FromEventId(EventId),\n57\t}\n58\t\n59\t#[derive(Clone, Debug, PartialEq, Eq)]\n60\tpub struct ReplayReport {\n61\t    pub mode: ReplayMode,\n62\t    pub baseline_events_applied: usize,\n63\t    pub events_replayed: usize,\n64\t    pub consolidation_failures_seen: usize,\n65\t    pub divergences: usize,\n66\t}\n67\t\n68\t#[derive(Clone, Debug, PartialEq, Eq)]\n69\tpub enum ReverseOutcome {\n70\t    Reverted { memory_id: String },\n71\t    AlreadyReverted,\n72\t}\n73\t\n74\t#[derive(Debug, thiserror::Error)]\n75\tpub enum ReplayError {\n76\t    #[error(\"event store query failed: {0}\")]\n77\t    EventStore(String),\n78\t    #[error(\"payload decode failed for event row {row_id}: {reason}\")]\n79\t    PayloadDecode { row_id: i64, reason: String },\n80\t    #[error(\"cached LLM response missing for prompt hash {prompt_hash:?}\")]\n81\t    CachedResponseMissing { prompt_hash: PromptHash },\n82\t    #[error(\"cached LLM response hash mismatch for prompt hash {prompt_hash:?}\")]\n83\t    CachedResponseHashMismatch { prompt_hash: PromptHash },\n84\t    #[error(\"post-apply state divergence for memory {memory_id}: expected {expected:?}, actual {actual:?}\")]\n85\t    DivergenceDetected {\n86\t        memory_id: String,\n87\t        expected: [u8; 32],\n88\t        actual: [u8; 32],\n89\t    },\n90\t    #[error(\"proposal {proposal_id} referenced by replay event was not found\")]\n91\t    MissingProposal { proposal_id: String },\n92\t    #[error(\"memory replay failed: {0}\")]\n93\t    Memory(String),\n94\t}\n95\t\n96\t#[derive(Debug, thiserror::Error)]\n97\tpub enum ReverseError {\n98\t    #[error(\"proposal {proposal_id} was not found\")]\n99\t    ProposalNotFound { proposal_id: String },\n100\t    #[error(\"proposal {proposal_id} is not applied and cannot be reverted\")]\n101\t    NotApplied { proposal_id: String },\n102\t    #[error(\"proposal {proposal_id} prior state is corrupt\")]\n103\t    PriorStateCorrupt { proposal_id: String },\n104\t    #[error(\"proposal {proposal_id} restore failed: {reason}\")]\n105\t    RestoreFailed { proposal_id: String, reason: String },\n106\t    #[error(\"proposal {proposal_id} rollback failed after reverse error: {reason}\")]\n107\t    RollbackFailed { proposal_id: String, reason: String },\n108\t    #[error(\"proposal {proposal_id} event emission failed: {reason}\")]\n109\t    EventWriteFailed { proposal_id: String, reason: String },\n110\t}\n111\t\n112\tpub struct ReplayDriver<'a> {\n113\t    pub event_reader: &'a EventReader,\n114\t    pub proposal_store: &'a Connection,\n115\t    pub memory_store: &'a MemoryStore,\n116\t    pub llm_response_cache: HashMap<PromptHash, ResponseBytes>,\n117\t    pub live_llm_driver: Option<&'a dyn LlmDriver>,\n118\t    event_store: Arc<EventStore>,\n119\t    event_writer: &'a crate::events::EventWriter,\n120\t    clock: &'a dyn Clock,\n121\t}\n122\t\n123\timpl<'a> ReplayDriver<'a> {\n124\t    pub fn new(\n125\t        event_reader: &'a EventReader,\n126\t        event_store: Arc<EventStore>,\n127\t        proposal_store: &'a Connection,\n128\t        memory_store: &'a MemoryStore,\n129\t        event_writer: &'a crate::events::EventWriter,\n130\t        clock: &'a dyn Clock,\n131\t    ) -> Self {\n132\t        Self {\n133\t            event_reader,\n134\t            proposal_store,\n135\t            memory_store,\n136\t            llm_response_cache: HashMap::new(),\n137\t            live_llm_driver: None,\n138\t            event_store,\n139\t            event_writer,\n140\t            clock,\n141\t        }\n142\t    }\n143\t\n144\t    pub fn with_cached_responses(\n145\t        mut self,\n146\t        provenance_index: impl IntoIterator<Item = (PromptHash, ResponseBytes)>,\n147\t    ) -> Self {\n148\t        self.llm_response_cache.extend(provenance_index);\n149\t        self\n150\t    }\n151\t\n152\t    pub fn with_live_llm_driver(mut self, driver: &'a dyn LlmDriver) -> Self {\n153\t        self.live_llm_driver = Some(driver);\n154\t        self\n155\t    }\n156\t\n157\t    pub fn replay(&self, mode: ReplayMode) -> Result<ReplayReport, ReplayError> {\n158\t        let (baseline_row_id, replay_start_row_id) = self.mode_boundaries(&mode)?;\n159\t        let span = info_span!(\n160\t            \"replay\",\n161\t            mode = ?mode,\n162\t            events_replayed = field::Empty,\n163\t            divergences = field::Empty\n164\t        );\n165\t        let _entered = span.enter();\n166\t        self.memory_store\n167\t            .clear_all()\n168\t            .map_err(|e| ReplayError::Memory(e.to_string()))?;\n169\t        let rows = self\n170\t            .event_store\n171\t            .query_events_after_row_id(0, 10_000)\n172\t            .map_err(store_error)?;\n173\t\n174\t        let mut baseline_events_applied = 0usize;\n175\t        let mut events_replayed = 0usize;\n176\t        let mut consolidation_failures_seen = 0usize;\n177\t        let divergences = 0usize;\n178\t\n179\t        for row in rows {\n180\t            if row.workspace_id != self.event_writer.workspace_id().as_str() || row.branch != \"main\"\n181\t            {\n182\t                continue;\n183\t            }\n184\t            let payload = decode_payload(&self.event_store, &row)?;\n185\t            if row.event_id <= baseline_row_id {\n186\t                if let EventPayload::MemoryConsolidated(ref consolidated) = payload {\n187\t                    self.apply_replayed_event(consolidated)?;\n188\t                    baseline_events_applied += 1;\n189\t                }\n190\t                continue;\n191\t            }\n192\t            if row.event_id < replay_start_row_id {\n193\t                continue;\n194\t            }\n195\t            self.clock.pin(row.ts_unix_micros);\n196\t            match payload {\n197\t                EventPayload::MemoryConsolidated(consolidated) => {\n198\t                    self.apply_replayed_event(&consolidated)?;\n199\t                    let actual = state_hash_for_memory(\n200\t                        self.memory_store,\n201\t                        &consolidated.consolidated_memory_id.ulid,\n202\t                    )\n203\t                    .map_err(|e| ReplayError::Memory(e.to_string()))?;\n204\t                    if actual != consolidated.post_apply_state_hash {\n205\t                        error!(\n206\t                            memory_id = consolidated.consolidated_memory_id.ulid.as_str(),\n207\t                            expected = ?consolidated.post_apply_state_hash,\n208\t                            actual = ?actual,\n209\t                            \"replay divergence detected\"\n210\t                        );\n211\t                        return Err(ReplayError::DivergenceDetected {\n212\t                            memory_id: consolidated.consolidated_memory_id.ulid,\n213\t                            expected: consolidated.post_apply_state_hash,\n214\t                            actual,\n215\t                        });\n216\t                    }\n217\t                    events_replayed += 1;\n218\t                }\n219\t                EventPayload::ConsolidationFailed(_) => {\n220\t                    consolidation_failures_seen += 1;\n221\t                    events_replayed += 1;\n222\t                }\n223\t                _ => {}\n224\t            }\n225\t        }\n226\t\n227\t        span.record(\"events_replayed\", events_replayed);\n228\t        span.record(\"divergences\", divergences);\n229\t        Ok(ReplayReport {\n230\t            mode,\n231\t            baseline_events_applied,\n232\t            events_replayed,\n233\t            consolidation_failures_seen,\n234\t            divergences,\n235\t        })\n236\t    }\n237\t\n238\t    pub fn reverse(&self, proposal_id: &str) -> Result<ReverseOutcome, ReverseError> {\n239\t        let span = info_span!(\"reverse_proposal\", proposal_id);\n240\t        let _entered = span.enter();\n241\t        let Some(record) = ConsolidationProposal::load_record(self.proposal_store, proposal_id)\n242\t            .map_err(|e| ReverseError::RestoreFailed {\n243\t                proposal_id: proposal_id.to_string(),\n244\t                reason: e.to_string(),\n245\t            })?\n246\t        else {\n247\t            return Err(ReverseError::ProposalNotFound {\n248\t                proposal_id: proposal_id.to_string(),\n249\t            });\n250\t        };\n251\t        match record.decision {\n252\t            crate::consolidation::ProposalDecision::Reverted => {\n253\t                return Ok(ReverseOutcome::AlreadyReverted);\n254\t            }\n255\t            crate::consolidation::ProposalDecision::Applied => {}\n256\t            _ => {\n257\t                return Err(ReverseError::NotApplied {\n258\t                    proposal_id: proposal_id.to_string(),\n259\t                });\n260\t            }\n261\t        }\n262\t\n263\t        let memory_id = proposal_memory_id(&record.proposed_state, &record.target_memory_id)\n264\t            .map_err(|_| ReverseError::PriorStateCorrupt {\n265\t                proposal_id: proposal_id.to_string(),\n266\t            })?;\n267\t        let reverse_proposal = ConsolidationProposal {\n268\t            proposal_id: record.proposal_id.clone(),\n269\t            job_id: record.job_id.clone(),\n270\t            target: record\n271\t                .target_memory_id\n272\t                .clone()\n273\t                .map(crate::consolidation::ProposalTarget::ExistingMemory)\n274\t                .unwrap_or(crate::consolidation::ProposalTarget::NewMemory),\n275\t            proposal_kind: record.proposal_kind,\n276\t            prior_state: record.proposed_state.clone(),\n277\t            proposed_state: record.prior_state.clone(),\n278\t            evidence: record.evidence.clone(),\n279\t            provenance: record.provenance.clone(),\n280\t        };\n281\t\n282\t        apply_reverse_state(self.memory_store, &record.prior_state, &memory_id).map_err(|e| {\n283\t            ReverseError::RestoreFailed {\n284\t                proposal_id: proposal_id.to_string(),\n285\t                reason: e.to_string(),\n286\t            }\n287\t        })?;\n288\t        self.proposal_store\n289\t            .execute(\n290\t                \"UPDATE consolidation_proposals\n291\t                 SET decision = 'reverted', decided_at = ?1\n292\t                 WHERE proposal_id = ?2 AND decision = 'applied'\",\n293\t                rusqlite::params![crate::consolidation::now_unix_micros(), proposal_id],\n294\t            )\n295\t            .map_err(|e| ReverseError::RestoreFailed {\n296\t                proposal_id: proposal_id.to_string(),\n297\t                reason: e.to_string(),\n298\t            })?;\n299\t        let post_apply_state_hash =\n300\t            state_hash_for_memory(self.memory_store, &memory_id).map_err(|e| {\n301\t                ReverseError::RestoreFailed {\n302\t                    proposal_id: proposal_id.to_string(),\n303\t                    reason: e.to_string(),\n304\t                }\n305\t            })?;\n306\t        if let Err(error) = reverse_proposal.emit_event(\n307\t            self.event_writer,\n308\t            &memory_id,\n309\t            post_apply_state_hash,\n310\t            \"replay\",\n311\t            Some(\"proposal reversed by replay driver\"),\n312\t        ) {\n313\t            rollback_reverse(\n314\t                self.proposal_store,\n315\t                self.memory_store,\n316\t                proposal_id,\n317\t                &record.proposed_state,\n318\t                &memory_id,\n319\t            )\n320\t            .map_err(|rollback| ReverseError::RollbackFailed {\n321\t                proposal_id: proposal_id.to_string(),\n322\t                reason: rollback.to_string(),\n323\t            })?;\n324\t            return Err(ReverseError::EventWriteFailed {\n325\t                proposal_id: proposal_id.to_string(),\n326\t                reason: error.to_string(),\n327\t            });\n328\t        }\n329\t        Ok(ReverseOutcome::Reverted { memory_id })\n330\t    }\n331\t\n332\t    fn apply_replayed_event(\n333\t        &self,\n334\t        payload: &crate::events::MemoryConsolidatedPayload,\n335\t    ) -> Result<(), ReplayError> {\n336\t        if let Some(proposal_id) = payload.proposal_id.as_deref() {\n337\t            let Some(record) = ConsolidationProposal::load_record(self.proposal_store, proposal_id)\n338\t                .map_err(|e| ReplayError::Memory(e.to_string()))?\n339\t            else {\n340\t                return Err(ReplayError::MissingProposal {\n341\t                    proposal_id: proposal_id.to_string(),\n342\t                });\n343\t            };\n344\t            if let Some(provenance) = record.provenance {\n345\t                verify_cached_response(\n346\t                    &self.llm_response_cache,\n347\t                    provenance.prompt_sha256,\n348\t                    provenance.response_sha256,\n349\t                )?;\n350\t            }\n351\t        }\n352\t        let proposed_state = payload\n353\t            .proposed_state_json\n354\t            .as_deref()\n355\t            .map(parse_json)\n356\t            .transpose()\n357\t            .map_err(|reason| ReplayError::Memory(reason.to_string()))?\n358\t            .unwrap_or_else(empty_state);\n359\t        apply_reverse_state(\n360\t            self.memory_store,\n361\t            &proposed_state,\n362\t            &payload.consolidated_memory_id.ulid,\n363\t        )\n364\t        .map_err(|e| ReplayError::Memory(e.to_string()))\n365\t    }\n366\t\n367\t    fn mode_boundaries(&self, mode: &ReplayMode) -> Result<(i64, i64), ReplayError> {\n368\t        match mode {\n369\t            ReplayMode::FromGenesis => Ok((0, 1)),\n370\t            ReplayMode::FromSnapshot { snapshot_id } => Ok((*snapshot_id, snapshot_id + 1)),\n371\t            ReplayMode::FromEventId(event_id) => {\n372\t                let row_id = self\n373\t                    .event_store\n374\t                    .row_id_for_event_uuid(&event_id.ulid)\n375\t                    .map_err(store_error)?\n376\t                    .unwrap_or_default();\n377\t                Ok((row_id.saturating_sub(1), row_id))\n378\t            }\n379\t        }\n380\t    }\n381\t}\n382\t\n383\tfn apply_reverse_state(\n384\t    memory_store: &MemoryStore,\n385\t    state: &Value,\n386\t    memory_id: &str,\n387\t) -> Result<(), LatticeError> {\n388\t    if state == &empty_state() {\n389\t        if memory_store.get_by_id(memory_id)?.is_some() {\n390\t            memory_store.invalidate(memory_id)?;\n391\t        }\n392\t        return Ok(());\n393\t    }\n394\t    if let Some(decoded) = decode_state(state)? {\n395\t        return apply_memory_state(memory_store, &decoded);\n396\t    }\n397\t    let memory: crate::memory::Memory = serde_json::from_value(state.clone())\n398\t        .map_err(|e| LatticeError::Storage(format!(\"Failed to decode replay memory: {e}\")))?;\n399\t    memory_store.store(memory)?;\n400\t    Ok(())\n401\t}\n402\t\n403\tfn rollback_reverse(\n404\t    conn: &Connection,\n405\t    memory_store: &MemoryStore,\n406\t    proposal_id: &str,\n407\t    proposed_state: &Value,\n408\t    memory_id: &str,\n409\t) -> Result<(), LatticeError> {\n410\t    apply_reverse_state(memory_store, proposed_state, memory_id)?;\n411\t    conn.execute(\n412\t        \"UPDATE consolidation_proposals\n413\t         SET decision = 'applied', decided_at = ?1\n414\t         WHERE proposal_id = ?2\",\n415\t        rusqlite::params![crate::consolidation::now_unix_micros(), proposal_id],\n416\t    )\n417\t    .map_err(|e| LatticeError::Storage(format!(\"Failed to rollback reverse decision: {e}\")))?;\n418\t    Ok(())\n419\t}\n420\t\n421\tfn verify_cached_response(\n422\t    cache: &HashMap<PromptHash, ResponseBytes>,\n423\t    prompt_hash: PromptHash,\n424\t    expected_response_hash: [u8; 32],\n425\t) -> Result<(), ReplayError> {\n426\t    let Some(bytes) = cache.get(&prompt_hash) else {\n427\t        return Err(ReplayError::CachedResponseMissing { prompt_hash });\n428\t    };\n429\t    let digest = Sha256::digest(bytes);\n430\t    let mut actual = [0_u8; 32];\n431\t    actual.copy_from_slice(&digest);\n432\t    if actual != expected_response_hash {\n433\t        return Err(ReplayError::CachedResponseHashMismatch { prompt_hash });\n434\t    }\n435\t    Ok(())\n436\t}\n437\t\n438\tfn decode_state(\n439\t    value: &Value,\n440\t) -> Result<Option<crate::consolidation::ConsolidationMemoryState>, LatticeError> {\n441\t    if value.get(\"memory\").is_none() || value.get(\"structured_fields\").is_none() {\n442\t        return Ok(None);\n443\t    }\n444\t    serde_json::from_value(value.clone())\n445\t        .map(Some)\n446\t        .map_err(|e| LatticeError::Storage(format!(\"Failed to decode replay state: {e}\")))\n447\t}\n448\t\n449\tfn proposal_memory_id(\n450\t    proposed_state: &Value,\n451\t    target_memory_id: &Option<String>,\n452\t) -> Result<String, LatticeError> {\n453\t    if let Some(state) = decode_state(proposed_state)? {\n454\t        return Ok(state.memory.id);\n455\t    }\n456\t    if let Some(memory_id) = proposed_state.get(\"id\").and_then(Value::as_str) {\n457\t        return Ok(memory_id.to_string());\n458\t    }\n459\t    target_memory_id.clone().ok_or_else(|| {\n460\t        LatticeError::Storage(\"proposal state does not include a reversible memory id\".to_string())\n461\t    })\n462\t}\n463\t\n464\tfn decode_payload(\n465\t    store: &EventStore,\n466\t    row: &crate::events::EventEnvelopeRow,\n467\t) -> Result<EventPayload, ReplayError> {\n468\t    let bytes = match (&row.payload_inline, row.payload_spill_id) {\n469\t        (Some(bytes), _) => bytes.clone(),\n470\t        (None, Some(spill_id)) => {\n471\t            store\n472\t                .get_payload_row(spill_id)\n473\t                .map_err(store_error)?\n474\t                .ok_or_else(|| ReplayError::PayloadDecode {\n475\t                    row_id: row.event_id,\n476\t                    reason: \"spilled payload row missing\".to_string(),\n477\t                })?\n478\t                .bytes\n479\t        }\n480\t        (None, None) => {\n481\t            return Err(ReplayError::PayloadDecode {\n482\t                row_id: row.event_id,\n483\t                reason: \"payload bytes missing\".to_string(),\n484\t            });\n485\t        }\n486\t    };\n487\t    serde_json::from_slice(&bytes).map_err(|e| ReplayError::PayloadDecode {\n488\t        row_id: row.event_id,\n489\t        reason: e.to_string(),\n490\t    })\n491\t}\n492\t\n493\tfn parse_json(value: &str) -> Result<Value, serde_json::Error> {\n494\t    serde_json::from_str(value)\n495\t}\n496\t\n497\tfn store_error(error: EventStoreError) -> ReplayError {\n498\t    ReplayError::EventStore(error.to_string())\n499\t}\n500\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"63c896bb-4fb0-4dde-b12f-caf8edd1ec3d","timestamp":"2026-05-17T11:42:01.500Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/replay.rs","content":"//! Replay-safe consolidation rebuilds and mechanical proposal reversal.\n//!\n//! Spec excerpts from\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 6. Consolidation Engine` and\n//! `## Non-Negotiable Product Properties`:\n//!\n//! > \"Consolidation modes: ... replay mode for rebuilding memory state from the event log.\"\n//!\n//! > \"Every background consolidation pass is recoverable, replayable, and observable.\"\n\nuse std::collections::HashMap;\nuse std::sync::Arc;\n\nuse rusqlite::Connection;\nuse serde_json::Value;\nuse sha2::{Digest, Sha256};\nuse tracing::{error, field, info_span};\n\nuse crate::consolidation::llm::LlmDriver;\nuse crate::consolidation::proposal::{\n    apply_memory_state, empty_state, state_hash_for_memory, ConsolidationProposal,\n};\nuse crate::events::{EventPayload, EventReader, EventStore, EventStoreError};\nuse crate::identity::EventId;\nuse crate::memory::MemoryStore;\nuse crate::LatticeError;\n\npub type PromptHash = [u8; 32];\npub type ResponseBytes = Vec<u8>;\n\npub trait Clock: Send + Sync {\n    fn pin(&self, unix_micros: i64);\n    fn now_unix_micros(&self) -> i64;\n}\n\n#[derive(Default)]\npub struct FixedReplayClock(std::sync::Mutex<i64>);\n\nimpl Clock for FixedReplayClock {\n    fn pin(&self, unix_micros: i64) {\n        if let Ok(mut guard) = self.0.lock() {\n            *guard = unix_micros;\n        }\n    }\n\n    fn now_unix_micros(&self) -> i64 {\n        self.0.lock().map(|guard| *guard).unwrap_or_default()\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum ReplayMode {\n    FromGenesis,\n    FromSnapshot { snapshot_id: i64 },\n    FromEventId(EventId),\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct ReplayReport {\n    pub mode: ReplayMode,\n    pub baseline_events_applied: usize,\n    pub events_replayed: usize,\n    pub consolidation_failures_seen: usize,\n    pub divergences: usize,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum ReverseOutcome {\n    Reverted { memory_id: String },\n    AlreadyReverted,\n}\n\n#[derive(Debug, thiserror::Error)]\npub enum ReplayError {\n    #[error(\"event store query failed: {0}\")]\n    EventStore(String),\n    #[error(\"payload decode failed for event row {row_id}: {reason}\")]\n    PayloadDecode { row_id: i64, reason: String },\n    #[error(\"cached LLM response missing for prompt hash {prompt_hash:?}\")]\n    CachedResponseMissing { prompt_hash: PromptHash },\n    #[error(\"cached LLM response hash mismatch for prompt hash {prompt_hash:?}\")]\n    CachedResponseHashMismatch { prompt_hash: PromptHash },\n    #[error(\"post-apply state divergence for memory {memory_id}: expected {expected:?}, actual {actual:?}\")]\n    DivergenceDetected {\n        memory_id: String,\n        expected: [u8; 32],\n        actual: [u8; 32],\n    },\n    #[error(\"proposal {proposal_id} referenced by replay event was not found\")]\n    MissingProposal { proposal_id: String },\n    #[error(\"memory replay failed: {0}\")]\n    Memory(String),\n}\n\n#[derive(Debug, thiserror::Error)]\npub enum ReverseError {\n    #[error(\"proposal {proposal_id} was not found\")]\n    ProposalNotFound { proposal_id: String },\n    #[error(\"proposal {proposal_id} is not applied and cannot be reverted\")]\n    NotApplied { proposal_id: String },\n    #[error(\"proposal {proposal_id} prior state is corrupt\")]\n    PriorStateCorrupt { proposal_id: String },\n    #[error(\"proposal {proposal_id} restore failed: {reason}\")]\n    RestoreFailed { proposal_id: String, reason: String },\n    #[error(\"proposal {proposal_id} rollback failed after reverse error: {reason}\")]\n    RollbackFailed { proposal_id: String, reason: String },\n    #[error(\"proposal {proposal_id} event emission failed: {reason}\")]\n    EventWriteFailed { proposal_id: String, reason: String },\n}\n\npub struct ReplayDriver<'a> {\n    pub event_reader: &'a EventReader,\n    pub proposal_store: &'a Connection,\n    pub memory_store: &'a MemoryStore,\n    pub llm_response_cache: HashMap<PromptHash, ResponseBytes>,\n    pub live_llm_driver: Option<&'a dyn LlmDriver>,\n    event_store: Arc<EventStore>,\n    event_writer: &'a crate::events::EventWriter,\n    clock: &'a dyn Clock,\n}\n\nimpl<'a> ReplayDriver<'a> {\n    pub fn new(\n        event_reader: &'a EventReader,\n        event_store: Arc<EventStore>,\n        proposal_store: &'a Connection,\n        memory_store: &'a MemoryStore,\n        event_writer: &'a crate::events::EventWriter,\n        clock: &'a dyn Clock,\n    ) -> Self {\n        Self {\n            event_reader,\n            proposal_store,\n            memory_store,\n            llm_response_cache: HashMap::new(),\n            live_llm_driver: None,\n            event_store,\n            event_writer,\n            clock,\n        }\n    }\n\n    pub fn with_cached_responses(\n        mut self,\n        provenance_index: impl IntoIterator<Item = (PromptHash, ResponseBytes)>,\n    ) -> Self {\n        self.llm_response_cache.extend(provenance_index);\n        self\n    }\n\n    pub fn with_live_llm_driver(mut self, driver: &'a dyn LlmDriver) -> Self {\n        self.live_llm_driver = Some(driver);\n        self\n    }\n\n    pub fn replay(&self, mode: ReplayMode) -> Result<ReplayReport, ReplayError> {\n        let (baseline_row_id, replay_start_row_id) = self.mode_boundaries(&mode)?;\n        let span = info_span!(\n            \"replay\",\n            mode = ?mode,\n            events_replayed = field::Empty,\n            divergences = field::Empty\n        );\n        let _entered = span.enter();\n        self.memory_store\n            .clear_all()\n            .map_err(|e| ReplayError::Memory(e.to_string()))?;\n        let rows = self\n            .event_store\n            .query_events_after_row_id(0, 10_000)\n            .map_err(store_error)?;\n\n        let mut baseline_events_applied = 0usize;\n        let mut events_replayed = 0usize;\n        let mut consolidation_failures_seen = 0usize;\n        let divergences = 0usize;\n\n        for row in rows {\n            if row.workspace_id != self.event_writer.workspace_id().as_str() || row.branch != \"main\"\n            {\n                continue;\n            }\n            let payload = decode_payload(&self.event_store, &row)?;\n            if row.event_id <= baseline_row_id {\n                if let EventPayload::MemoryConsolidated(ref consolidated) = payload {\n                    self.apply_replayed_event(consolidated)?;\n                    baseline_events_applied += 1;\n                }\n                continue;\n            }\n            if row.event_id < replay_start_row_id {\n                continue;\n            }\n            self.clock.pin(row.ts_unix_micros);\n            match payload {\n                EventPayload::MemoryConsolidated(consolidated) => {\n                    self.apply_replayed_event(&consolidated)?;\n                    let actual = state_hash_for_memory(\n                        self.memory_store,\n                        &consolidated.consolidated_memory_id.ulid,\n                    )\n                    .map_err(|e| ReplayError::Memory(e.to_string()))?;\n                    if actual != consolidated.post_apply_state_hash {\n                        error!(\n                            memory_id = consolidated.consolidated_memory_id.ulid.as_str(),\n                            expected = ?consolidated.post_apply_state_hash,\n                            actual = ?actual,\n                            \"replay divergence detected\"\n                        );\n                        return Err(ReplayError::DivergenceDetected {\n                            memory_id: consolidated.consolidated_memory_id.ulid,\n                            expected: consolidated.post_apply_state_hash,\n                            actual,\n                        });\n                    }\n                    events_replayed += 1;\n                }\n                EventPayload::ConsolidationFailed(_) => {\n                    consolidation_failures_seen += 1;\n                    events_replayed += 1;\n                }\n                _ => {}\n            }\n        }\n\n        span.record(\"events_replayed\", events_replayed);\n        span.record(\"divergences\", divergences);\n        Ok(ReplayReport {\n            mode,\n            baseline_events_applied,\n            events_replayed,\n            consolidation_failures_seen,\n            divergences,\n        })\n    }\n\n    pub fn reverse(&self, proposal_id: &str) -> Result<ReverseOutcome, ReverseError> {\n        let span = info_span!(\"reverse_proposal\", proposal_id);\n        let _entered = span.enter();\n        let Some(record) = ConsolidationProposal::load_record(self.proposal_store, proposal_id)\n            .map_err(|e| ReverseError::RestoreFailed {\n                proposal_id: proposal_id.to_string(),\n                reason: e.to_string(),\n            })?\n        else {\n            return Err(ReverseError::ProposalNotFound {\n                proposal_id: proposal_id.to_string(),\n            });\n        };\n        match record.decision {\n            crate::consolidation::ProposalDecision::Reverted => {\n                return Ok(ReverseOutcome::AlreadyReverted);\n            }\n            crate::consolidation::ProposalDecision::Applied => {}\n            _ => {\n                return Err(ReverseError::NotApplied {\n                    proposal_id: proposal_id.to_string(),\n                });\n            }\n        }\n\n        let memory_id = proposal_memory_id(&record.proposed_state, &record.target_memory_id)\n            .map_err(|_| ReverseError::PriorStateCorrupt {\n                proposal_id: proposal_id.to_string(),\n            })?;\n        let reverse_proposal = ConsolidationProposal {\n            proposal_id: record.proposal_id.clone(),\n            job_id: record.job_id.clone(),\n            target: record\n                .target_memory_id\n                .clone()\n                .map(crate::consolidation::ProposalTarget::ExistingMemory)\n                .unwrap_or(crate::consolidation::ProposalTarget::NewMemory),\n            proposal_kind: record.proposal_kind,\n            prior_state: record.proposed_state.clone(),\n            proposed_state: record.prior_state.clone(),\n            evidence: record.evidence.clone(),\n            provenance: record.provenance.clone(),\n        };\n\n        apply_reverse_state(self.memory_store, &record.prior_state, &memory_id).map_err(|e| {\n            ReverseError::RestoreFailed {\n                proposal_id: proposal_id.to_string(),\n                reason: e.to_string(),\n            }\n        })?;\n        self.proposal_store\n            .execute(\n                \"UPDATE consolidation_proposals\n                 SET decision = 'reverted', decided_at = ?1\n                 WHERE proposal_id = ?2 AND decision = 'applied'\",\n                rusqlite::params![crate::consolidation::now_unix_micros(), proposal_id],\n            )\n            .map_err(|e| ReverseError::RestoreFailed {\n                proposal_id: proposal_id.to_string(),\n                reason: e.to_string(),\n            })?;\n        let post_apply_state_hash =\n            state_hash_for_memory(self.memory_store, &memory_id).map_err(|e| {\n                ReverseError::RestoreFailed {\n                    proposal_id: proposal_id.to_string(),\n                    reason: e.to_string(),\n                }\n            })?;\n        if let Err(error) = reverse_proposal.emit_event(\n            self.event_writer,\n            &memory_id,\n            post_apply_state_hash,\n            \"replay\",\n            Some(\"proposal reversed by replay driver\"),\n        ) {\n            rollback_reverse(\n                self.proposal_store,\n                self.memory_store,\n                proposal_id,\n                &record.proposed_state,\n                &memory_id,\n            )\n            .map_err(|rollback| ReverseError::RollbackFailed {\n                proposal_id: proposal_id.to_string(),\n                reason: rollback.to_string(),\n            })?;\n            return Err(ReverseError::EventWriteFailed {\n                proposal_id: proposal_id.to_string(),\n                reason: error.to_string(),\n            });\n        }\n        Ok(ReverseOutcome::Reverted { memory_id })\n    }\n\n    fn apply_replayed_event(\n        &self,\n        payload: &crate::events::MemoryConsolidatedPayload,\n    ) -> Result<(), ReplayError> {\n        if let Some(proposal_id) = payload.proposal_id.as_deref() {\n            let Some(record) = ConsolidationProposal::load_record(self.proposal_store, proposal_id)\n                .map_err(|e| ReplayError::Memory(e.to_string()))?\n            else {\n                return Err(ReplayError::MissingProposal {\n                    proposal_id: proposal_id.to_string(),\n                });\n            };\n            if let Some(provenance) = record.provenance {\n                verify_cached_response(\n                    &self.llm_response_cache,\n                    provenance.prompt_sha256,\n                    provenance.response_sha256,\n                )?;\n            }\n        }\n        let proposed_state = payload\n            .proposed_state_json\n            .as_deref()\n            .map(parse_json)\n            .transpose()\n            .map_err(|reason| ReplayError::Memory(reason.to_string()))?\n            .unwrap_or_else(empty_state);\n        apply_reverse_state(\n            self.memory_store,\n            &proposed_state,\n            &payload.consolidated_memory_id.ulid,\n        )\n        .map_err(|e| ReplayError::Memory(e.to_string()))\n    }\n\n    fn mode_boundaries(&self, mode: &ReplayMode) -> Result<(i64, i64), ReplayError> {\n        match mode {\n            ReplayMode::FromGenesis => Ok((0, 1)),\n            ReplayMode::FromSnapshot { snapshot_id } => Ok((*snapshot_id, snapshot_id + 1)),\n            ReplayMode::FromEventId(event_id) => {\n                let row_id = self\n                    .event_store\n                    .row_id_for_event_uuid(&event_id.ulid)\n                    .map_err(store_error)?\n                    .unwrap_or_default();\n                Ok((row_id.saturating_sub(1), row_id))\n            }\n        }\n    }\n}\n\nfn apply_reverse_state(\n    memory_store: &MemoryStore,\n    state: &Value,\n    memory_id: &str,\n) -> Result<(), LatticeError> {\n    if state == &empty_state() {\n        if memory_store.get_by_id(memory_id)?.is_some() {\n            memory_store.invalidate(memory_id)?;\n        }\n        return Ok(());\n    }\n    if let Some(decoded) = decode_state(state)? {\n        return apply_memory_state(memory_store, &decoded);\n    }\n    let memory: crate::memory::Memory = serde_json::from_value(state.clone())\n        .map_err(|e| LatticeError::Storage(format!(\"Failed to decode replay memory: {e}\")))?;\n    memory_store.store(memory)?;\n    Ok(())\n}\n\nfn rollback_reverse(\n    conn: &Connection,\n    memory_store: &MemoryStore,\n    proposal_id: &str,\n    proposed_state: &Value,\n    memory_id: &str,\n) -> Result<(), LatticeError> {\n    apply_reverse_state(memory_store, proposed_state, memory_id)?;\n    conn.execute(\n        \"UPDATE consolidation_proposals\n         SET decision = 'applied', decided_at = ?1\n         WHERE proposal_id = ?2\",\n        rusqlite::params![crate::consolidation::now_unix_micros(), proposal_id],\n    )\n    .map_err(|e| LatticeError::Storage(format!(\"Failed to rollback reverse decision: {e}\")))?;\n    Ok(())\n}\n\nfn verify_cached_response(\n    cache: &HashMap<PromptHash, ResponseBytes>,\n    prompt_hash: PromptHash,\n    expected_response_hash: [u8; 32],\n) -> Result<(), ReplayError> {\n    let Some(bytes) = cache.get(&prompt_hash) else {\n        return Err(ReplayError::CachedResponseMissing { prompt_hash });\n    };\n    let digest = Sha256::digest(bytes);\n    let mut actual = [0_u8; 32];\n    actual.copy_from_slice(&digest);\n    if actual != expected_response_hash {\n        return Err(ReplayError::CachedResponseHashMismatch { prompt_hash });\n    }\n    Ok(())\n}\n\nfn decode_state(\n    value: &Value,\n) -> Result<Option<crate::consolidation::ConsolidationMemoryState>, LatticeError> {\n    if value.get(\"memory\").is_none() || value.get(\"structured_fields\").is_none() {\n        return Ok(None);\n    }\n    serde_json::from_value(value.clone())\n        .map(Some)\n        .map_err(|e| LatticeError::Storage(format!(\"Failed to decode replay state: {e}\")))\n}\n\nfn proposal_memory_id(\n    proposed_state: &Value,\n    target_memory_id: &Option<String>,\n) -> Result<String, LatticeError> {\n    if let Some(state) = decode_state(proposed_state)? {\n        return Ok(state.memory.id);\n    }\n    if let Some(memory_id) = proposed_state.get(\"id\").and_then(Value::as_str) {\n        return Ok(memory_id.to_string());\n    }\n    target_memory_id.clone().ok_or_else(|| {\n        LatticeError::Storage(\"proposal state does not include a reversible memory id\".to_string())\n    })\n}\n\nfn decode_payload(\n    store: &EventStore,\n    row: &crate::events::EventEnvelopeRow,\n) -> Result<EventPayload, ReplayError> {\n    let bytes = match (&row.payload_inline, row.payload_spill_id) {\n        (Some(bytes), _) => bytes.clone(),\n        (None, Some(spill_id)) => {\n            store\n                .get_payload_row(spill_id)\n                .map_err(store_error)?\n                .ok_or_else(|| ReplayError::PayloadDecode {\n                    row_id: row.event_id,\n                    reason: \"spilled payload row missing\".to_string(),\n                })?\n                .bytes\n        }\n        (None, None) => {\n            return Err(ReplayError::PayloadDecode {\n                row_id: row.event_id,\n                reason: \"payload bytes missing\".to_string(),\n            });\n        }\n    };\n    serde_json::from_slice(&bytes).map_err(|e| ReplayError::PayloadDecode {\n        row_id: row.event_id,\n        reason: e.to_string(),\n    })\n}\n\nfn parse_json(value: &str) -> Result<Value, serde_json::Error> {\n    serde_json::from_str(value)\n}\n\nfn store_error(error: EventStoreError) -> ReplayError {\n    ReplayError::EventStore(error.to_string())\n}\n","numLines":500,"startLine":1,"totalLines":500}}}
