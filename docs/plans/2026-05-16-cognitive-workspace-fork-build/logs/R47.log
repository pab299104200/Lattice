{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GTD7mfCz5iG6XWMHxLiGar","type":"tool_result","content":"1\t//! Contradiction detection across overlapping memory assertions.\n2\t//!\n3\t//! Implements `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## 6. Consolidation Engine` \"LLM-driven consolidation\" bullet:\n5\t//! \"Several consolidation jobs (... contradiction detection...) cannot be\n6\t//! implemented deterministically and require LLM inference.\" It also supports\n7\t//! `## Phase 6: Consolidation Engine` DoD for auditable consolidation.\n8\t\n9\tuse serde::{Deserialize, Serialize};\n10\tuse serde_json::json;\n11\t\n12\tuse super::{\n13\t    complete_structured_with_provenance, existing_state, forbid_hot_path, malformed_with_event,\n14\t    memory_state, submit_memory_proposal, ConsolidationJobKind, LlmJobContext, LlmJobError,\n15\t    LlmJobServices,\n16\t};\n17\tuse crate::consolidation::{ProposalKind, ProposalTarget};\n18\tuse crate::memory::{Memory, MemoryLinkRecord, MemoryVerificationStatus};\n19\t\n20\tpub struct ContradictionDetectionJob;\n21\t\n22\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n23\tpub struct ContradictionCandidatePair {\n24\t    pub first: Memory,\n25\t    pub second: Memory,\n26\t    pub deterministic_reason: String,\n27\t}\n28\t\n29\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n30\tpub struct ContradictionDecision {\n31\t    pub is_contradiction: bool,\n32\t    pub contradicted_memory_id: String,\n33\t    pub contradicting_memory_id: String,\n34\t    pub rationale: String,\n35\t}\n36\t\n37\timpl ContradictionDetectionJob {\n38\t    pub fn run(\n39\t        ctx: &LlmJobContext,\n40\t        services: &mut LlmJobServices<'_>,\n41\t        pair: &ContradictionCandidatePair,\n42\t    ) -> Result<Option<crate::consolidation::ConsolidationProposal>, LlmJobError> {\n43\t        let kind = ConsolidationJobKind::ContradictionDetection;\n44\t        forbid_hot_path(ctx, kind)?;\n45\t        let prompt = contradiction_prompt(pair);\n46\t        let completion: super::LlmCompletion<ContradictionDecision> =\n47\t            complete_structured_with_provenance(ctx, services, kind, prompt, CONTRADICTION_SCHEMA)?;\n48\t        let decision = completion.value;\n49\t        if !decision.is_contradiction {\n50\t            return Err(malformed_with_event(\n51\t                ctx,\n52\t                services,\n53\t                kind,\n54\t                \"contradiction job response did not confirm a contradiction\".to_string(),\n55\t            ));\n56\t        }\n57\t        let target = target_memory(ctx, services, kind, pair, &decision)?;\n58\t        let prior = existing_state(services.memory_store, target)?;\n59\t        let proposed = contradicted_state(services.memory_store, target, &decision)?;\n60\t        submit_memory_proposal(\n61\t            ctx,\n62\t            services,\n63\t            kind,\n64\t            ProposalTarget::ExistingMemory(target.id.clone()),\n65\t            ProposalKind::UpdateMemory,\n66\t            prior,\n67\t            proposed,\n68\t            contradiction_evidence(pair, &decision),\n69\t            Some(completion.provenance),\n70\t        )\n71\t    }\n72\t}\n73\t\n74\tfn contradicted_state(\n75\t    memory_store: &crate::memory::MemoryStore,\n76\t    target: &Memory,\n77\t    decision: &ContradictionDecision,\n78\t) -> Result<serde_json::Value, LlmJobError> {\n79\t    let mut fields = memory_store\n80\t        .get_structured_fields(&target.id)?\n81\t        .unwrap_or_default();\n82\t    fields.verification_status = MemoryVerificationStatus::Contradicted;\n83\t    if !fields\n84\t        .contradicted_by_memory_ids\n85\t        .iter()\n86\t        .any(|id| id == &decision.contradicting_memory_id)\n87\t    {\n88\t        fields\n89\t            .contradicted_by_memory_ids\n90\t            .push(decision.contradicting_memory_id.clone());\n91\t    }\n92\t    let link = MemoryLinkRecord {\n93\t        link_id: format!(\n94\t            \"contradiction-{}-{}\",\n95\t            decision.contradicted_memory_id, decision.contradicting_memory_id\n96\t        ),\n97\t        source_memory_id: decision.contradicted_memory_id.clone(),\n98\t        target_memory_id: decision.contradicting_memory_id.clone(),\n99\t        link_type: \"contradicts\".to_string(),\n100\t        reason: decision.rationale.clone(),\n101\t        created_at: crate::consolidation::now_unix_micros().max(0) as u64,\n102\t        verification_status: \"in_review\".to_string(),\n103\t    };\n104\t    memory_state(target.clone(), fields, vec![link])\n105\t}\n106\t\n107\tfn target_memory<'a>(\n108\t    ctx: &LlmJobContext,\n109\t    services: &LlmJobServices<'_>,\n110\t    kind: ConsolidationJobKind,\n111\t    pair: &'a ContradictionCandidatePair,\n112\t    decision: &ContradictionDecision,\n113\t) -> Result<&'a Memory, LlmJobError> {\n114\t    if decision.contradicted_memory_id == pair.first.id {\n115\t        return Ok(&pair.first);\n116\t    }\n117\t    if decision.contradicted_memory_id == pair.second.id {\n118\t        return Ok(&pair.second);\n119\t    }\n120\t    Err(malformed_with_event(\n121\t        ctx,\n122\t        services,\n123\t        kind,\n124\t        format!(\n125\t            \"unknown contradicted memory id {}\",\n126\t            decision.contradicted_memory_id\n127\t        ),\n128\t    ))\n129\t}\n130\t\n131\tfn contradiction_prompt(pair: &ContradictionCandidatePair) -> String {\n132\t    format!(\n133\t        \"Determine whether these memories contradict. Return JSON only.\\nReason flagged: {}\\nFirst {}: {}\\nSecond {}: {}\",\n134\t        pair.deterministic_reason,\n135\t        pair.first.id,\n136\t        pair.first.content,\n137\t        pair.second.id,\n138\t        pair.second.content\n139\t    )\n140\t}\n141\t\n142\tfn contradiction_evidence(\n143\t    pair: &ContradictionCandidatePair,\n144\t    decision: &ContradictionDecision,\n145\t) -> serde_json::Value {\n146\t    json!({\n147\t        \"source_memory_ids\": [pair.first.id, pair.second.id],\n148\t        \"deterministic_reason\": pair.deterministic_reason,\n149\t        \"rationale\": decision.rationale,\n150\t        \"contradicted_memory_id\": decision.contradicted_memory_id,\n151\t        \"contradicting_memory_id\": decision.contradicting_memory_id,\n152\t    })\n153\t}\n154\t\n155\tconst CONTRADICTION_SCHEMA: &str = r#\"{\n156\t  \"is_contradiction\": true,\n157\t  \"contradicted_memory_id\": \"memory id\",\n158\t  \"contradicting_memory_id\": \"memory id\",\n159\t  \"rationale\": \"string\"\n160\t}\"#;\n161\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"58b4e95f-0e6c-4654-bac2-0c66b23b7b36","timestamp":"2026-05-17T11:44:14.116Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/llm/contradiction.rs","content":"//! Contradiction detection across overlapping memory assertions.\n//!\n//! Implements `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 6. Consolidation Engine` \"LLM-driven consolidation\" bullet:\n//! \"Several consolidation jobs (... contradiction detection...) cannot be\n//! implemented deterministically and require LLM inference.\" It also supports\n//! `## Phase 6: Consolidation Engine` DoD for auditable consolidation.\n\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse super::{\n    complete_structured_with_provenance, existing_state, forbid_hot_path, malformed_with_event,\n    memory_state, submit_memory_proposal, ConsolidationJobKind, LlmJobContext, LlmJobError,\n    LlmJobServices,\n};\nuse crate::consolidation::{ProposalKind, ProposalTarget};\nuse crate::memory::{Memory, MemoryLinkRecord, MemoryVerificationStatus};\n\npub struct ContradictionDetectionJob;\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\npub struct ContradictionCandidatePair {\n    pub first: Memory,\n    pub second: Memory,\n    pub deterministic_reason: String,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct ContradictionDecision {\n    pub is_contradiction: bool,\n    pub contradicted_memory_id: String,\n    pub contradicting_memory_id: String,\n    pub rationale: String,\n}\n\nimpl ContradictionDetectionJob {\n    pub fn run(\n        ctx: &LlmJobContext,\n        services: &mut LlmJobServices<'_>,\n        pair: &ContradictionCandidatePair,\n    ) -> Result<Option<crate::consolidation::ConsolidationProposal>, LlmJobError> {\n        let kind = ConsolidationJobKind::ContradictionDetection;\n        forbid_hot_path(ctx, kind)?;\n        let prompt = contradiction_prompt(pair);\n        let completion: super::LlmCompletion<ContradictionDecision> =\n            complete_structured_with_provenance(ctx, services, kind, prompt, CONTRADICTION_SCHEMA)?;\n        let decision = completion.value;\n        if !decision.is_contradiction {\n            return Err(malformed_with_event(\n                ctx,\n                services,\n                kind,\n                \"contradiction job response did not confirm a contradiction\".to_string(),\n            ));\n        }\n        let target = target_memory(ctx, services, kind, pair, &decision)?;\n        let prior = existing_state(services.memory_store, target)?;\n        let proposed = contradicted_state(services.memory_store, target, &decision)?;\n        submit_memory_proposal(\n            ctx,\n            services,\n            kind,\n            ProposalTarget::ExistingMemory(target.id.clone()),\n            ProposalKind::UpdateMemory,\n            prior,\n            proposed,\n            contradiction_evidence(pair, &decision),\n            Some(completion.provenance),\n        )\n    }\n}\n\nfn contradicted_state(\n    memory_store: &crate::memory::MemoryStore,\n    target: &Memory,\n    decision: &ContradictionDecision,\n) -> Result<serde_json::Value, LlmJobError> {\n    let mut fields = memory_store\n        .get_structured_fields(&target.id)?\n        .unwrap_or_default();\n    fields.verification_status = MemoryVerificationStatus::Contradicted;\n    if !fields\n        .contradicted_by_memory_ids\n        .iter()\n        .any(|id| id == &decision.contradicting_memory_id)\n    {\n        fields\n            .contradicted_by_memory_ids\n            .push(decision.contradicting_memory_id.clone());\n    }\n    let link = MemoryLinkRecord {\n        link_id: format!(\n            \"contradiction-{}-{}\",\n            decision.contradicted_memory_id, decision.contradicting_memory_id\n        ),\n        source_memory_id: decision.contradicted_memory_id.clone(),\n        target_memory_id: decision.contradicting_memory_id.clone(),\n        link_type: \"contradicts\".to_string(),\n        reason: decision.rationale.clone(),\n        created_at: crate::consolidation::now_unix_micros().max(0) as u64,\n        verification_status: \"in_review\".to_string(),\n    };\n    memory_state(target.clone(), fields, vec![link])\n}\n\nfn target_memory<'a>(\n    ctx: &LlmJobContext,\n    services: &LlmJobServices<'_>,\n    kind: ConsolidationJobKind,\n    pair: &'a ContradictionCandidatePair,\n    decision: &ContradictionDecision,\n) -> Result<&'a Memory, LlmJobError> {\n    if decision.contradicted_memory_id == pair.first.id {\n        return Ok(&pair.first);\n    }\n    if decision.contradicted_memory_id == pair.second.id {\n        return Ok(&pair.second);\n    }\n    Err(malformed_with_event(\n        ctx,\n        services,\n        kind,\n        format!(\n            \"unknown contradicted memory id {}\",\n            decision.contradicted_memory_id\n        ),\n    ))\n}\n\nfn contradiction_prompt(pair: &ContradictionCandidatePair) -> String {\n    format!(\n        \"Determine whether these memories contradict. Return JSON only.\\nReason flagged: {}\\nFirst {}: {}\\nSecond {}: {}\",\n        pair.deterministic_reason,\n        pair.first.id,\n        pair.first.content,\n        pair.second.id,\n        pair.second.content\n    )\n}\n\nfn contradiction_evidence(\n    pair: &ContradictionCandidatePair,\n    decision: &ContradictionDecision,\n) -> serde_json::Value {\n    json!({\n        \"source_memory_ids\": [pair.first.id, pair.second.id],\n        \"deterministic_reason\": pair.deterministic_reason,\n        \"rationale\": decision.rationale,\n        \"contradicted_memory_id\": decision.contradicted_memory_id,\n        \"contradicting_memory_id\": decision.contradicting_memory_id,\n    })\n}\n\nconst CONTRADICTION_SCHEMA: &str = r#\"{\n  \"is_contradiction\": true,\n  \"contradicted_memory_id\": \"memory id\",\n  \"contradicting_memory_id\": \"memory id\",\n  \"rationale\": \"string\"\n}\"#;\n","numLines":161,"startLine":1,"totalLines":161}}}
