{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RecGhQi1E3cUhiYt9ub8fm","type":"tool_result","content":"1\tuse rusqlite::{params, Connection, OptionalExtension};\n2\tuse serde::{Deserialize, Serialize};\n3\tuse serde_json::{json, Value};\n4\tuse sha2::{Digest, Sha256};\n5\tuse tracing::{field, info_span};\n6\t\n7\tuse super::{encode_memory_state, llm::LlmProvenance};\n8\tuse crate::consolidation::ConsolidationMemoryState;\n9\tuse crate::error::LatticeError;\n10\tuse crate::events::{\n11\t    canonical_json_bytes, Actor, BranchRef, CompactSummary, EventKind, EventPayload, EventWriter,\n12\t    MemoryConsolidatedPayload, PartialEnvelope, SessionId, StableRef,\n13\t};\n14\tuse crate::identity::MemoryId;\n15\tuse crate::memory::{Memory, MemoryStore};\n16\t\n17\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n18\tpub struct ConsolidationProposal {\n19\t    pub proposal_id: String,\n20\t    pub job_id: String,\n21\t    pub target: ProposalTarget,\n22\t    pub proposal_kind: ProposalKind,\n23\t    pub prior_state: Value,\n24\t    pub proposed_state: Value,\n25\t    pub evidence: Value,\n26\t    pub provenance: Option<LlmProvenance>,\n27\t}\n28\t\n29\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n30\tpub struct ConsolidationProposalRecord {\n31\t    pub proposal_id: String,\n32\t    pub job_id: String,\n33\t    pub workspace_id: String,\n34\t    pub enqueued_at: i64,\n35\t    pub target_memory_id: Option<String>,\n36\t    pub proposal_kind: ProposalKind,\n37\t    pub prior_state: Value,\n38\t    pub proposed_state: Value,\n39\t    pub evidence: Value,\n40\t    pub provenance: Option<LlmProvenance>,\n41\t    pub decided_at: Option<i64>,\n42\t    pub decision: ProposalDecision,\n43\t    pub decided_by: Option<String>,\n44\t    pub decision_reason: Option<String>,\n45\t}\n46\t\n47\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n48\tpub struct ConsolidationProposalRow {\n49\t    pub proposal_id: String,\n50\t    pub job_id: String,\n51\t    pub workspace_id: String,\n52\t    pub enqueued_at: i64,\n53\t    pub target_memory_id: Option<String>,\n54\t    pub proposal_kind: String,\n55\t    pub prior_state: String,\n56\t    pub proposed_state: String,\n57\t    pub evidence: String,\n58\t    pub provenance_json: Option<String>,\n59\t    pub decided_at: Option<i64>,\n60\t    pub decision: String,\n61\t    pub decided_by: Option<String>,\n62\t    pub decision_reason: Option<String>,\n63\t}\n64\t\n65\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n66\tpub enum ProposalTarget {\n67\t    NewMemory,\n68\t    ExistingMemory(String),\n69\t}\n70\t\n71\timpl ProposalTarget {\n72\t    pub fn memory_id(&self) -> Option<&str> {\n73\t        match self {\n74\t            Self::NewMemory => None,\n75\t            Self::ExistingMemory(memory_id) => Some(memory_id.as_str()),\n76\t        }\n77\t    }\n78\t}\n79\t\n80\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n81\t#[serde(rename_all = \"snake_case\")]\n82\tpub enum ProposalKind {\n83\t    CreateMemory,\n84\t    UpdateMemory,\n85\t    MarkStale,\n86\t    Supersede,\n87\t    Demote,\n88\t    Refresh,\n89\t}\n90\t\n91\timpl ProposalKind {\n92\t    pub fn as_str(self) -> &'static str {\n93\t        match self {\n94\t            Self::CreateMemory => \"create_memory\",\n95\t            Self::UpdateMemory => \"update_memory\",\n96\t            Self::MarkStale => \"mark_stale\",\n97\t            Self::Supersede => \"supersede\",\n98\t            Self::Demote => \"demote\",\n99\t            Self::Refresh => \"refresh\",\n100\t        }\n101\t    }\n102\t\n103\t    pub fn from_str(value: &str) -> Result<Self, LatticeError> {\n104\t        match value {\n105\t            \"create_memory\" => Ok(Self::CreateMemory),\n106\t            \"update_memory\" => Ok(Self::UpdateMemory),\n107\t            \"mark_stale\" => Ok(Self::MarkStale),\n108\t            \"supersede\" => Ok(Self::Supersede),\n109\t            \"demote\" => Ok(Self::Demote),\n110\t            \"refresh\" => Ok(Self::Refresh),\n111\t            _ => Err(LatticeError::Storage(format!(\n112\t                \"Unknown consolidation proposal kind '{value}'\"\n113\t            ))),\n114\t        }\n115\t    }\n116\t}\n117\t\n118\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n119\t#[serde(rename_all = \"snake_case\")]\n120\tpub enum ProposalDecision {\n121\t    Pending,\n122\t    Applied,\n123\t    Rejected,\n124\t    Reverted,\n125\t}\n126\t\n127\timpl ProposalDecision {\n128\t    pub fn as_str(self) -> &'static str {\n129\t        match self {\n130\t            Self::Pending => \"pending\",\n131\t            Self::Applied => \"applied\",\n132\t            Self::Rejected => \"rejected\",\n133\t            Self::Reverted => \"reverted\",\n134\t        }\n135\t    }\n136\t\n137\t    pub fn from_str(value: &str) -> Result<Self, LatticeError> {\n138\t        match value {\n139\t            \"pending\" => Ok(Self::Pending),\n140\t            \"applied\" => Ok(Self::Applied),\n141\t            \"rejected\" => Ok(Self::Rejected),\n142\t            \"reverted\" => Ok(Self::Reverted),\n143\t            _ => Err(LatticeError::Storage(format!(\n144\t                \"Unknown consolidation proposal decision '{value}'\"\n145\t            ))),\n146\t        }\n147\t    }\n148\t}\n149\t\n150\t#[derive(Clone, Debug, PartialEq, Eq)]\n151\tpub enum ApplyOutcome {\n152\t    Applied { memory_id: String },\n153\t    AlreadyDecided { decision: ProposalDecision },\n154\t}\n155\t\n156\t#[derive(Clone, Debug, PartialEq, Eq)]\n157\tpub enum RejectOutcome {\n158\t    Rejected,\n159\t    AlreadyDecided { decision: ProposalDecision },\n160\t}\n161\t\n162\timpl ConsolidationProposal {\n163\t    pub fn load_record(\n164\t        conn: &Connection,\n165\t        proposal_id: &str,\n166\t    ) -> Result<Option<ConsolidationProposalRecord>, LatticeError> {\n167\t        conn.query_row(\n168\t            \"SELECT p.proposal_id,\n169\t                    p.job_id,\n170\t                    j.workspace_id,\n171\t                    j.enqueued_at,\n172\t                    p.target_memory_id,\n173\t                    p.proposal_kind,\n174\t                    p.prior_state,\n175\t                    p.proposed_state,\n176\t                    p.evidence,\n177\t                    p.provenance_json,\n178\t                    p.decided_at,\n179\t                    p.decision,\n180\t                    p.decided_by,\n181\t                    p.decision_reason\n182\t             FROM consolidation_proposals p\n183\t             INNER JOIN consolidation_jobs j ON j.job_id = p.job_id\n184\t             WHERE p.proposal_id = ?1\",\n185\t            params![proposal_id],\n186\t            |row| {\n187\t                Ok(ProposalRecordRow {\n188\t                    proposal_id: row.get(0)?,\n189\t                    job_id: row.get(1)?,\n190\t                    workspace_id: row.get(2)?,\n191\t                    enqueued_at: row.get(3)?,\n192\t                    target_memory_id: row.get(4)?,\n193\t                    proposal_kind: row.get(5)?,\n194\t                    prior_state: row.get(6)?,\n195\t                    proposed_state: row.get(7)?,\n196\t                    evidence: row.get(8)?,\n197\t                    provenance_json: row.get(9)?,\n198\t                    decided_at: row.get(10)?,\n199\t                    decision: row.get(11)?,\n200\t                    decided_by: row.get(12)?,\n201\t                    decision_reason: row.get(13)?,\n202\t                })\n203\t            },\n204\t        )\n205\t        .optional()\n206\t        .map_err(|e| LatticeError::Storage(format!(\"Failed to load proposal record: {e}\")))?\n207\t        .map(ProposalRecordRow::into_record)\n208\t        .transpose()\n209\t    }\n210\t\n211\t    pub fn insert_pending(&self, conn: &Connection) -> Result<(), LatticeError> {\n212\t        let prior_state = serde_json::to_string(&self.prior_state).map_err(json_error)?;\n213\t        let proposed_state = serde_json::to_string(&self.proposed_state).map_err(json_error)?;\n214\t        let evidence = serde_json::to_string(&self.evidence).map_err(json_error)?;\n215\t        let provenance = self\n216\t            .provenance\n217\t            .as_ref()\n218\t            .map(serde_json::to_string)\n219\t            .transpose()\n220\t            .map_err(json_error)?;\n221\t        conn.execute(\n222\t            \"INSERT INTO consolidation_proposals\n223\t                (proposal_id, job_id, target_memory_id, proposal_kind, prior_state,\n224\t                 proposed_state, evidence, provenance_json, decision)\n225\t             VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, 'pending')\",\n226\t            params![\n227\t                self.proposal_id,\n228\t                self.job_id,\n229\t                self.target.memory_id(),\n230\t                self.proposal_kind.as_str(),\n231\t                prior_state,\n232\t                proposed_state,\n233\t                evidence,\n234\t                provenance\n235\t            ],\n236\t        )\n237\t        .map_err(|e| LatticeError::Storage(format!(\"Failed to insert proposal: {e}\")))?;\n238\t        Ok(())\n239\t    }\n240\t\n241\t    pub fn load(conn: &Connection, proposal_id: &str) -> Result<Option<Self>, LatticeError> {\n242\t        let row = conn\n243\t            .query_row(\n244\t                \"SELECT p.proposal_id,\n245\t                        p.job_id,\n246\t                        p.target_memory_id,\n247\t                        p.proposal_kind,\n248\t                        p.prior_state,\n249\t                        p.proposed_state,\n250\t                        p.evidence,\n251\t                        p.provenance_json\n252\t                 FROM consolidation_proposals p\n253\t                 WHERE p.proposal_id = ?1\",\n254\t                params![proposal_id],\n255\t                |row| {\n256\t                    Ok(ProposalRow {\n257\t                        proposal_id: row.get(0)?,\n258\t                        job_id: row.get(1)?,\n259\t                        target_memory_id: row.get(2)?,\n260\t                        proposal_kind: row.get(3)?,\n261\t                        prior_state: row.get(4)?,\n262\t                        proposed_state: row.get(5)?,\n263\t                        evidence: row.get(6)?,\n264\t                        provenance_json: row.get(7)?,\n265\t                    })\n266\t                },\n267\t            )\n268\t            .optional()\n269\t            .map_err(|e| LatticeError::Storage(format!(\"Failed to load proposal: {e}\")))?;\n270\t        row.map(ProposalRow::into_proposal).transpose()\n271\t    }\n272\t\n273\t    pub fn apply(\n274\t        &self,\n275\t        conn: &Connection,\n276\t        memory_store: &MemoryStore,\n277\t        event_writer: &EventWriter,\n278\t        decided_by: &str,\n279\t        decision_reason: Option<&str>,\n280\t    ) -> Result<ApplyOutcome, LatticeError> {\n281\t        let span = info_span!(\n282\t            \"consolidation.proposal.apply\",\n283\t            workspace_id = event_writer.workspace_id().as_str(),\n284\t            job_id = self.job_id.as_str(),\n285\t            proposal_id = self.proposal_id.as_str(),\n286\t            outcome = field::Empty\n287\t        );\n288\t        let _entered = span.enter();\n289\t        let decision = load_decision(conn, &self.proposal_id)?;\n290\t        if decision != ProposalDecision::Pending {\n291\t            span.record(\"outcome\", \"already_decided\");\n292\t            return Ok(ApplyOutcome::AlreadyDecided { decision });\n293\t        }\n294\t\n295\t        let memory = self.materialize(memory_store)?;\n296\t        let post_apply_state_hash = state_hash_for_memory(memory_store, &memory.id)?;\n297\t        let memory_id = memory.id.clone();\n298\t        self.emit_event(\n299\t            event_writer,\n300\t            &memory_id,\n301\t            post_apply_state_hash,\n302\t            decided_by,\n303\t            decision_reason,\n304\t        )?;\n305\t        mark_decided(\n306\t            conn,\n307\t            &self.proposal_id,\n308\t            ProposalDecision::Applied,\n309\t            decided_by,\n310\t            decision_reason,\n311\t        )?;\n312\t        mark_job_status(conn, &self.job_id, \"applied\", Some(&self.proposal_id), None)?;\n313\t        span.record(\"outcome\", \"applied\");\n314\t        Ok(ApplyOutcome::Applied { memory_id })\n315\t    }\n316\t\n317\t    pub fn reject(\n318\t        &self,\n319\t        conn: &Connection,\n320\t        event_writer: &EventWriter,\n321\t        decided_by: &str,\n322\t        decision_reason: Option<&str>,\n323\t    ) -> Result<RejectOutcome, LatticeError> {\n324\t        let span = info_span!(\n325\t            \"consolidation.proposal.reject\",\n326\t            workspace_id = event_writer.workspace_id().as_str(),\n327\t            job_id = self.job_id.as_str(),\n328\t            proposal_id = self.proposal_id.as_str(),\n329\t            outcome = field::Empty\n330\t        );\n331\t        let _entered = span.enter();\n332\t        let decision = load_decision(conn, &self.proposal_id)?;\n333\t        if decision != ProposalDecision::Pending {\n334\t            span.record(\"outcome\", \"already_decided\");\n335\t            return Ok(RejectOutcome::AlreadyDecided { decision });\n336\t        }\n337\t\n338\t        mark_decided(\n339\t            conn,\n340\t            &self.proposal_id,\n341\t            ProposalDecision::Rejected,\n342\t            decided_by,\n343\t            decision_reason,\n344\t        )?;\n345\t        mark_job_status(\n346\t            conn,\n347\t            &self.job_id,\n348\t            \"rejected\",\n349\t            Some(&self.proposal_id),\n350\t            None,\n351\t        )?;\n352\t        span.record(\"outcome\", \"rejected\");\n353\t        Ok(RejectOutcome::Rejected)\n354\t    }\n355\t\n356\t    fn materialize(&self, memory_store: &MemoryStore) -> Result<Memory, LatticeError> {\n357\t        match self.proposal_kind {\n358\t            ProposalKind::CreateMemory | ProposalKind::UpdateMemory | ProposalKind::Refresh => {\n359\t                self.materialize_memory_state(memory_store)\n360\t            }\n361\t            ProposalKind::MarkStale => self.materialize_stale(memory_store),\n362\t            ProposalKind::Supersede => self.materialize_supersession(memory_store),\n363\t            ProposalKind::Demote => self.materialize_memory_state(memory_store),\n364\t        }\n365\t    }\n366\t\n367\t    fn materialize_memory_state(&self, memory_store: &MemoryStore) -> Result<Memory, LatticeError> {\n368\t        if let Some(state) = proposed_memory_state(&self.proposed_state)? {\n369\t            apply_memory_state(memory_store, &state)?;\n370\t            return Ok(state.memory);\n371\t        }\n372\t\n373\t        let memory = proposed_memory(&self.proposed_state)?;\n374\t        memory_store.store(memory.clone())?;\n375\t        Ok(memory)\n376\t    }\n377\t\n378\t    fn materialize_stale(&self, memory_store: &MemoryStore) -> Result<Memory, LatticeError> {\n379\t        if proposed_memory_state(&self.proposed_state)?.is_some() {\n380\t            return self.materialize_memory_state(memory_store);\n381\t        }\n382\t        let target_id = required_target_id(&self.target)?;\n383\t        let reason = self\n384\t            .proposed_state\n385\t            .get(\"stale_reason\")\n386\t            .and_then(Value::as_str)\n387\t            .unwrap_or(\"marked stale by consolidation proposal\");\n388\t        memory_store.mark_stale_by_id(target_id, reason)?;\n389\t        memory_store\n390\t            .get_by_id(target_id)?\n391\t            .ok_or_else(|| missing_memory(target_id))\n392\t    }\n393\t\n394\t    fn materialize_supersession(&self, memory_store: &MemoryStore) -> Result<Memory, LatticeError> {\n395\t        if proposed_memory_state(&self.proposed_state)?.is_some() {\n396\t            return self.materialize_memory_state(memory_store);\n397\t        }\n398\t        let target_id = required_target_id(&self.target)?;\n399\t        let superseded_by = self\n400\t            .proposed_state\n401\t            .get(\"superseded_by_memory_id\")\n402\t            .and_then(Value::as_str)\n403\t            .ok_or_else(|| {\n404\t                LatticeError::Storage(\"supersede proposal missing superseded_by_memory_id\".into())\n405\t            })?;\n406\t        memory_store.mark_memory_superseded(target_id, superseded_by)?;\n407\t        memory_store\n408\t            .get_by_id(target_id)?\n409\t            .ok_or_else(|| missing_memory(target_id))\n410\t    }\n411\t\n412\t    pub(crate) fn emit_event(\n413\t        &self,\n414\t        event_writer: &EventWriter,\n415\t        memory: &str,\n416\t        post_apply_state_hash: [u8; 32],\n417\t        decided_by: &str,\n418\t        decision_reason: Option<&str>,\n419\t    ) -> Result<(), LatticeError> {\n420\t        let memory_id = memory_identity(event_writer.workspace_id(), memory);\n421\t        let payload = EventPayload::MemoryConsolidated(MemoryConsolidatedPayload {\n422\t            source_memory_ids: source_memory_ids(event_writer.workspace_id(), &self.evidence),\n423\t            consolidated_memory_id: memory_id.clone(),\n424\t            source_event_ids: Vec::new(),\n425\t            consolidation_summary: consolidation_summary(self),\n426\t            proposal_id: Some(self.proposal_id.clone()),\n427\t            prior_state_json: Some(self.prior_state.to_string()),\n428\t            proposed_state_json: Some(self.proposed_state.to_string()),\n429\t            decided_by: Some(decided_by.to_string()),\n430\t            decision_reason: decision_reason.map(str::to_string),\n431\t            post_apply_state_hash,\n432\t        });\n433\t        let envelope = PartialEnvelope {\n434\t            workspace_id: Some(event_writer.workspace_id().clone()),\n435\t            branch: BranchRef {\n436\t                name: \"main\".to_string(),\n437\t            },\n438\t            session_id: SessionId {\n439\t                value: format!(\"consolidation-{}\", self.job_id),\n440\t            },\n441\t            task_id: None,\n442\t            actor: Actor::Daemon,\n443\t            kind: EventKind::MemoryConsolidated,\n444\t            references: vec![StableRef::MemoryRef(memory_id)],\n445\t            summary: CompactSummary::new(consolidation_summary(self))\n446\t                .map_err(|e| LatticeError::Storage(e.to_string()))?,\n447\t            payload,\n448\t        };\n449\t        event_writer.append(envelope).map_err(|e| {\n450\t            LatticeError::Storage(format!(\"Failed to write consolidation event: {e}\"))\n451\t        })?;\n452\t        Ok(())\n453\t    }\n454\t}\n455\t\n456\tstruct ProposalRow {\n457\t    proposal_id: String,\n458\t    job_id: String,\n459\t    target_memory_id: Option<String>,\n460\t    proposal_kind: String,\n461\t    prior_state: String,\n462\t    proposed_state: String,\n463\t    evidence: String,\n464\t    provenance_json: Option<String>,\n465\t}\n466\t\n467\tstruct ProposalRecordRow {\n468\t    proposal_id: String,\n469\t    job_id: String,\n470\t    workspace_id: String,\n471\t    enqueued_at: i64,\n472\t    target_memory_id: Option<String>,\n473\t    proposal_kind: String,\n474\t    prior_state: String,\n475\t    proposed_state: String,\n476\t    evidence: String,\n477\t    provenance_json: Option<String>,\n478\t    decided_at: Option<i64>,\n479\t    decision: String,\n480\t    decided_by: Option<String>,\n481\t    decision_reason: Option<String>,\n482\t}\n483\t\n484\timpl ProposalRow {\n485\t    fn into_proposal(self) -> Result<ConsolidationProposal, LatticeError> {\n486\t        Ok(ConsolidationProposal {\n487\t            proposal_id: self.proposal_id,\n488\t            job_id: self.job_id,\n489\t            target: match self.target_memory_id {\n490\t                Some(memory_id) => ProposalTarget::ExistingMemory(memory_id),\n491\t                None => ProposalTarget::NewMemory,\n492\t            },\n493\t            proposal_kind: ProposalKind::from_str(&self.proposal_kind)?,\n494\t            prior_state: serde_json::from_str(&self.prior_state).map_err(json_error)?,\n495\t            proposed_state: serde_json::from_str(&self.proposed_state).map_err(json_error)?,\n496\t            evidence: serde_json::from_str(&self.evidence).map_err(json_error)?,\n497\t            provenance: self\n498\t                .provenance_json\n499\t                .map(|json| serde_json::from_str(&json).map_err(json_error))\n500\t                .transpose()?,\n501\t        })\n502\t    }\n503\t}\n504\t\n505\timpl ProposalRecordRow {\n506\t    fn into_record(self) -> Result<ConsolidationProposalRecord, LatticeError> {\n507\t        Ok(ConsolidationProposalRecord {\n508\t            proposal_id: self.proposal_id,\n509\t            job_id: self.job_id,\n510\t            workspace_id: self.workspace_id,\n511\t            enqueued_at: self.enqueued_at,\n512\t            target_memory_id: self.target_memory_id,\n513\t            proposal_kind: ProposalKind::from_str(&self.proposal_kind)?,\n514\t            prior_state: serde_json::from_str(&self.prior_state).map_err(json_error)?,\n515\t            proposed_state: serde_json::from_str(&self.proposed_state).map_err(json_error)?,\n516\t            evidence: serde_json::from_str(&self.evidence).map_err(json_error)?,\n517\t            provenance: self\n518\t                .provenance_json\n519\t                .map(|json| serde_json::from_str(&json).map_err(json_error))\n520\t                .transpose()?,\n521\t            decided_at: self.decided_at,\n522\t            decision: ProposalDecision::from_str(&self.decision)?,\n523\t            decided_by: self.decided_by,\n524\t            decision_reason: self.decision_reason,\n525\t        })\n526\t    }\n527\t}\n528\t\n529\tpub fn load_row(\n530\t    conn: &Connection,\n531\t    proposal_id: &str,\n532\t) -> Result<Option<ConsolidationProposalRow>, LatticeError> {\n533\t    conn.query_row(\n534\t        \"SELECT p.proposal_id,\n535\t                p.job_id,\n536\t                j.workspace_id,\n537\t                j.enqueued_at,\n538\t                p.target_memory_id,\n539\t                p.proposal_kind,\n540\t                p.prior_state,\n541\t                p.proposed_state,\n542\t                p.evidence,\n543\t                p.provenance_json,\n544\t                p.decided_at,\n545\t                p.decision,\n546\t                p.decided_by,\n547\t                p.decision_reason\n548\t         FROM consolidation_proposals p\n549\t         INNER JOIN consolidation_jobs j ON j.job_id = p.job_id\n550\t         WHERE p.proposal_id = ?1\",\n551\t        params![proposal_id],\n552\t        |row| {\n553\t            Ok(ConsolidationProposalRow {\n554\t                proposal_id: row.get(0)?,\n555\t                job_id: row.get(1)?,\n556\t                workspace_id: row.get(2)?,\n557\t                enqueued_at: row.get(3)?,\n558\t                target_memory_id: row.get(4)?,\n559\t                proposal_kind: row.get(5)?,\n560\t                prior_state: row.get(6)?,\n561\t                proposed_state: row.get(7)?,\n562\t                evidence: row.get(8)?,\n563\t                provenance_json: row.get(9)?,\n564\t                decided_at: row.get(10)?,\n565\t                decision: row.get(11)?,\n566\t                decided_by: row.get(12)?,\n567\t                decision_reason: row.get(13)?,\n568\t            })\n569\t        },\n570\t    )\n571\t    .optional()\n572\t    .map_err(|e| LatticeError::Storage(format!(\"Failed to load proposal row: {e}\")))\n573\t}\n574\t\n575\tfn load_decision(conn: &Connection, proposal_id: &str) -> Result<ProposalDecision, LatticeError> {\n576\t    let decision: String = conn\n577\t        .query_row(\n578\t            \"SELECT decision FROM consolidation_proposals WHERE proposal_id = ?1\",\n579\t            params![proposal_id],\n580\t            |row| row.get(0),\n581\t        )\n582\t        .map_err(|e| LatticeError::Storage(format!(\"Failed to load proposal decision: {e}\")))?;\n583\t    ProposalDecision::from_str(&decision)\n584\t}\n585\t\n586\tfn mark_decided(\n587\t    conn: &Connection,\n588\t    proposal_id: &str,\n589\t    decision: ProposalDecision,\n590\t    decided_by: &str,\n591\t    decision_reason: Option<&str>,\n592\t) -> Result<(), LatticeError> {\n593\t    conn.execute(\n594\t        \"UPDATE consolidation_proposals\n595\t         SET decision = ?1, decided_at = ?2, decided_by = ?3, decision_reason = ?4\n596\t         WHERE proposal_id = ?5 AND decision = 'pending'\",\n597\t        params![\n598\t            decision.as_str(),\n599\t            crate::consolidation::now_unix_micros(),\n600\t            decided_by,\n601\t            decision_reason,\n602\t            proposal_id\n603\t        ],\n604\t    )\n605\t    .map_err(|e| LatticeError::Storage(format!(\"Failed to update proposal decision: {e}\")))?;\n606\t    Ok(())\n607\t}\n608\t\n609\tpub(crate) fn mark_job_status(\n610\t    conn: &Connection,\n611\t    job_id: &str,\n612\t    status: &str,\n613\t    proposal_id: Option<&str>,\n614\t    error_kind: Option<&str>,\n615\t) -> Result<(), LatticeError> {\n616\t    conn.execute(\n617\t        \"UPDATE consolidation_jobs\n618\t         SET status = ?1,\n619\t             finished_at = CASE WHEN ?1 IN ('proposed', 'applied', 'rejected', 'failed') THEN ?2 ELSE finished_at END,\n620\t             proposal_id = COALESCE(?3, proposal_id),\n621\t             error_kind = ?4\n622\t         WHERE job_id = ?5\",\n623\t        params![\n624\t            status,\n625\t            crate::consolidation::now_unix_micros(),\n626\t            proposal_id,\n627\t            error_kind,\n628\t            job_id\n629\t        ],\n630\t    )\n631\t    .map_err(|e| LatticeError::Storage(format!(\"Failed to update consolidation job: {e}\")))?;\n632\t    Ok(())\n633\t}\n634\t\n635\tfn proposed_memory(value: &Value) -> Result<Memory, LatticeError> {\n636\t    serde_json::from_value(value.clone()).map_err(json_error)\n637\t}\n638\t\n639\tfn proposed_memory_state(\n640\t    value: &Value,\n641\t) -> Result<Option<crate::consolidation::ConsolidationMemoryState>, LatticeError> {\n642\t    if value.get(\"memory\").is_none() || value.get(\"structured_fields\").is_none() {\n643\t        return Ok(None);\n644\t    }\n645\t    serde_json::from_value(value.clone())\n646\t        .map(Some)\n647\t        .map_err(json_error)\n648\t}\n649\t\n650\tfn required_target_id(target: &ProposalTarget) -> Result<&str, LatticeError> {\n651\t    target.memory_id().ok_or_else(|| {\n652\t        LatticeError::Storage(\"proposal kind requires an existing target memory\".to_string())\n653\t    })\n654\t}\n655\t\n656\tfn missing_memory(memory_id: &str) -> LatticeError {\n657\t    LatticeError::Storage(format!(\"Memory '{memory_id}' not found or invalidated\"))\n658\t}\n659\t\n660\tfn source_memory_ids(workspace_id: &str, evidence: &Value) -> Vec<MemoryId> {\n661\t    evidence\n662\t        .get(\"source_memory_ids\")\n663\t        .and_then(Value::as_array)\n664\t        .into_iter()\n665\t        .flatten()\n666\t        .filter_map(Value::as_str)\n667\t        .map(|id| memory_identity(workspace_id, id))\n668\t        .collect()\n669\t}\n670\t\n671\tfn memory_identity(workspace_id: &str, memory_id: &str) -> MemoryId {\n672\t    MemoryId {\n673\t        workspace_id: workspace_id.to_string(),\n674\t        ulid: memory_id.to_string(),\n675\t    }\n676\t}\n677\t\n678\tfn consolidation_summary(proposal: &ConsolidationProposal) -> String {\n679\t    let target = proposal.target.memory_id().unwrap_or(\"new memory\");\n680\t    format!(\n681\t        \"consolidation proposal {} applied to {target}\",\n682\t        proposal.proposal_id\n683\t    )\n684\t}\n685\t\n686\tfn json_error(error: serde_json::Error) -> LatticeError {\n687\t    LatticeError::Storage(format!(\"Failed to process proposal JSON: {error}\"))\n688\t}\n689\t\n690\tpub(crate) fn proposal_from_pending(\n691\t    job_id: &str,\n692\t    pending: crate::consolidation::PendingProposalSpec,\n693\t) -> ConsolidationProposal {\n694\t    ConsolidationProposal {\n695\t        proposal_id: pending.proposal_id,\n696\t        job_id: job_id.to_string(),\n697\t        target: match pending.target_memory_id {\n698\t            Some(memory_id) => ProposalTarget::ExistingMemory(memory_id),\n699\t            None => ProposalTarget::NewMemory,\n700\t        },\n701\t        proposal_kind: pending.proposal_kind,\n702\t        prior_state: pending.prior_state,\n703\t        proposed_state: pending.proposed_state,\n704\t        evidence: pending.evidence,\n705\t        provenance: pending.provenance,\n706\t    }\n707\t}\n708\t\n709\tpub fn empty_state() -> Value {\n710\t    json!({})\n711\t}\n712\t\n713\tpub(crate) fn apply_memory_state(\n714\t    memory_store: &MemoryStore,\n715\t    state: &ConsolidationMemoryState,\n716\t) -> Result<(), LatticeError> {\n717\t    memory_store.store(state.memory.clone())?;\n718\t    memory_store.update_structured_fields(&state.memory.id, &state.structured_fields)?;\n719\t    memory_store.delete_memory_links_from(&state.memory.id)?;\n720\t    for link in &state.memory_links {\n721\t        memory_store.insert_memory_link(link)?;\n722\t    }\n723\t    match state.last_verified_at {\n724\t        Some(last_verified_at) => {\n725\t            memory_store.set_last_verified_at(&state.memory.id, last_verified_at)?\n726\t        }\n727\t        None => memory_store.clear_last_verified_at(&state.memory.id)?,\n728\t    }\n729\t    Ok(())\n730\t}\n731\t\n732\tpub(crate) fn state_hash_for_memory(\n733\t    memory_store: &MemoryStore,\n734\t    memory_id: &str,\n735\t) -> Result<[u8; 32], LatticeError> {\n736\t    let state = memory_store\n737\t        .get_by_id(memory_id)?\n738\t        .ok_or_else(|| missing_memory(memory_id))?;\n739\t    let state = crate::consolidation::capture_memory_state(memory_store, &state)?;\n740\t    state_hash_from_json(&encode_memory_state(&state))\n741\t}\n742\t\n743\tpub(crate) fn state_hash_from_json(value: &Value) -> Result<[u8; 32], LatticeError> {\n744\t    let canonical = canonical_json_bytes(value).map_err(|e| {\n745\t        LatticeError::Storage(format!(\"Failed to canonicalize state hash payload: {e}\"))\n746\t    })?;\n747\t    let digest = Sha256::digest(&canonical);\n748\t    let mut hash = [0_u8; 32];\n749\t    hash.copy_from_slice(&digest);\n750\t    Ok(hash)\n751\t}\n752\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"acd0be58-82bf-4b7b-81e9-6d4bdc37a5b9","timestamp":"2026-05-17T11:39:38.559Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/proposal.rs","content":"use rusqlite::{params, Connection, OptionalExtension};\nuse serde::{Deserialize, Serialize};\nuse serde_json::{json, Value};\nuse sha2::{Digest, Sha256};\nuse tracing::{field, info_span};\n\nuse super::{encode_memory_state, llm::LlmProvenance};\nuse crate::consolidation::ConsolidationMemoryState;\nuse crate::error::LatticeError;\nuse crate::events::{\n    canonical_json_bytes, Actor, BranchRef, CompactSummary, EventKind, EventPayload, EventWriter,\n    MemoryConsolidatedPayload, PartialEnvelope, SessionId, StableRef,\n};\nuse crate::identity::MemoryId;\nuse crate::memory::{Memory, MemoryStore};\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\npub struct ConsolidationProposal {\n    pub proposal_id: String,\n    pub job_id: String,\n    pub target: ProposalTarget,\n    pub proposal_kind: ProposalKind,\n    pub prior_state: Value,\n    pub proposed_state: Value,\n    pub evidence: Value,\n    pub provenance: Option<LlmProvenance>,\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\npub struct ConsolidationProposalRecord {\n    pub proposal_id: String,\n    pub job_id: String,\n    pub workspace_id: String,\n    pub enqueued_at: i64,\n    pub target_memory_id: Option<String>,\n    pub proposal_kind: ProposalKind,\n    pub prior_state: Value,\n    pub proposed_state: Value,\n    pub evidence: Value,\n    pub provenance: Option<LlmProvenance>,\n    pub decided_at: Option<i64>,\n    pub decision: ProposalDecision,\n    pub decided_by: Option<String>,\n    pub decision_reason: Option<String>,\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\npub struct ConsolidationProposalRow {\n    pub proposal_id: String,\n    pub job_id: String,\n    pub workspace_id: String,\n    pub enqueued_at: i64,\n    pub target_memory_id: Option<String>,\n    pub proposal_kind: String,\n    pub prior_state: String,\n    pub proposed_state: String,\n    pub evidence: String,\n    pub provenance_json: Option<String>,\n    pub decided_at: Option<i64>,\n    pub decision: String,\n    pub decided_by: Option<String>,\n    pub decision_reason: Option<String>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum ProposalTarget {\n    NewMemory,\n    ExistingMemory(String),\n}\n\nimpl ProposalTarget {\n    pub fn memory_id(&self) -> Option<&str> {\n        match self {\n            Self::NewMemory => None,\n            Self::ExistingMemory(memory_id) => Some(memory_id.as_str()),\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum ProposalKind {\n    CreateMemory,\n    UpdateMemory,\n    MarkStale,\n    Supersede,\n    Demote,\n    Refresh,\n}\n\nimpl ProposalKind {\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::CreateMemory => \"create_memory\",\n            Self::UpdateMemory => \"update_memory\",\n            Self::MarkStale => \"mark_stale\",\n            Self::Supersede => \"supersede\",\n            Self::Demote => \"demote\",\n            Self::Refresh => \"refresh\",\n        }\n    }\n\n    pub fn from_str(value: &str) -> Result<Self, LatticeError> {\n        match value {\n            \"create_memory\" => Ok(Self::CreateMemory),\n            \"update_memory\" => Ok(Self::UpdateMemory),\n            \"mark_stale\" => Ok(Self::MarkStale),\n            \"supersede\" => Ok(Self::Supersede),\n            \"demote\" => Ok(Self::Demote),\n            \"refresh\" => Ok(Self::Refresh),\n            _ => Err(LatticeError::Storage(format!(\n                \"Unknown consolidation proposal kind '{value}'\"\n            ))),\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum ProposalDecision {\n    Pending,\n    Applied,\n    Rejected,\n    Reverted,\n}\n\nimpl ProposalDecision {\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::Pending => \"pending\",\n            Self::Applied => \"applied\",\n            Self::Rejected => \"rejected\",\n            Self::Reverted => \"reverted\",\n        }\n    }\n\n    pub fn from_str(value: &str) -> Result<Self, LatticeError> {\n        match value {\n            \"pending\" => Ok(Self::Pending),\n            \"applied\" => Ok(Self::Applied),\n            \"rejected\" => Ok(Self::Rejected),\n            \"reverted\" => Ok(Self::Reverted),\n            _ => Err(LatticeError::Storage(format!(\n                \"Unknown consolidation proposal decision '{value}'\"\n            ))),\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum ApplyOutcome {\n    Applied { memory_id: String },\n    AlreadyDecided { decision: ProposalDecision },\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum RejectOutcome {\n    Rejected,\n    AlreadyDecided { decision: ProposalDecision },\n}\n\nimpl ConsolidationProposal {\n    pub fn load_record(\n        conn: &Connection,\n        proposal_id: &str,\n    ) -> Result<Option<ConsolidationProposalRecord>, LatticeError> {\n        conn.query_row(\n            \"SELECT p.proposal_id,\n                    p.job_id,\n                    j.workspace_id,\n                    j.enqueued_at,\n                    p.target_memory_id,\n                    p.proposal_kind,\n                    p.prior_state,\n                    p.proposed_state,\n                    p.evidence,\n                    p.provenance_json,\n                    p.decided_at,\n                    p.decision,\n                    p.decided_by,\n                    p.decision_reason\n             FROM consolidation_proposals p\n             INNER JOIN consolidation_jobs j ON j.job_id = p.job_id\n             WHERE p.proposal_id = ?1\",\n            params![proposal_id],\n            |row| {\n                Ok(ProposalRecordRow {\n                    proposal_id: row.get(0)?,\n                    job_id: row.get(1)?,\n                    workspace_id: row.get(2)?,\n                    enqueued_at: row.get(3)?,\n                    target_memory_id: row.get(4)?,\n                    proposal_kind: row.get(5)?,\n                    prior_state: row.get(6)?,\n                    proposed_state: row.get(7)?,\n                    evidence: row.get(8)?,\n                    provenance_json: row.get(9)?,\n                    decided_at: row.get(10)?,\n                    decision: row.get(11)?,\n                    decided_by: row.get(12)?,\n                    decision_reason: row.get(13)?,\n                })\n            },\n        )\n        .optional()\n        .map_err(|e| LatticeError::Storage(format!(\"Failed to load proposal record: {e}\")))?\n        .map(ProposalRecordRow::into_record)\n        .transpose()\n    }\n\n    pub fn insert_pending(&self, conn: &Connection) -> Result<(), LatticeError> {\n        let prior_state = serde_json::to_string(&self.prior_state).map_err(json_error)?;\n        let proposed_state = serde_json::to_string(&self.proposed_state).map_err(json_error)?;\n        let evidence = serde_json::to_string(&self.evidence).map_err(json_error)?;\n        let provenance = self\n            .provenance\n            .as_ref()\n            .map(serde_json::to_string)\n            .transpose()\n            .map_err(json_error)?;\n        conn.execute(\n            \"INSERT INTO consolidation_proposals\n                (proposal_id, job_id, target_memory_id, proposal_kind, prior_state,\n                 proposed_state, evidence, provenance_json, decision)\n             VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, 'pending')\",\n            params![\n                self.proposal_id,\n                self.job_id,\n                self.target.memory_id(),\n                self.proposal_kind.as_str(),\n                prior_state,\n                proposed_state,\n                evidence,\n                provenance\n            ],\n        )\n        .map_err(|e| LatticeError::Storage(format!(\"Failed to insert proposal: {e}\")))?;\n        Ok(())\n    }\n\n    pub fn load(conn: &Connection, proposal_id: &str) -> Result<Option<Self>, LatticeError> {\n        let row = conn\n            .query_row(\n                \"SELECT p.proposal_id,\n                        p.job_id,\n                        p.target_memory_id,\n                        p.proposal_kind,\n                        p.prior_state,\n                        p.proposed_state,\n                        p.evidence,\n                        p.provenance_json\n                 FROM consolidation_proposals p\n                 WHERE p.proposal_id = ?1\",\n                params![proposal_id],\n                |row| {\n                    Ok(ProposalRow {\n                        proposal_id: row.get(0)?,\n                        job_id: row.get(1)?,\n                        target_memory_id: row.get(2)?,\n                        proposal_kind: row.get(3)?,\n                        prior_state: row.get(4)?,\n                        proposed_state: row.get(5)?,\n                        evidence: row.get(6)?,\n                        provenance_json: row.get(7)?,\n                    })\n                },\n            )\n            .optional()\n            .map_err(|e| LatticeError::Storage(format!(\"Failed to load proposal: {e}\")))?;\n        row.map(ProposalRow::into_proposal).transpose()\n    }\n\n    pub fn apply(\n        &self,\n        conn: &Connection,\n        memory_store: &MemoryStore,\n        event_writer: &EventWriter,\n        decided_by: &str,\n        decision_reason: Option<&str>,\n    ) -> Result<ApplyOutcome, LatticeError> {\n        let span = info_span!(\n            \"consolidation.proposal.apply\",\n            workspace_id = event_writer.workspace_id().as_str(),\n            job_id = self.job_id.as_str(),\n            proposal_id = self.proposal_id.as_str(),\n            outcome = field::Empty\n        );\n        let _entered = span.enter();\n        let decision = load_decision(conn, &self.proposal_id)?;\n        if decision != ProposalDecision::Pending {\n            span.record(\"outcome\", \"already_decided\");\n            return Ok(ApplyOutcome::AlreadyDecided { decision });\n        }\n\n        let memory = self.materialize(memory_store)?;\n        let post_apply_state_hash = state_hash_for_memory(memory_store, &memory.id)?;\n        let memory_id = memory.id.clone();\n        self.emit_event(\n            event_writer,\n            &memory_id,\n            post_apply_state_hash,\n            decided_by,\n            decision_reason,\n        )?;\n        mark_decided(\n            conn,\n            &self.proposal_id,\n            ProposalDecision::Applied,\n            decided_by,\n            decision_reason,\n        )?;\n        mark_job_status(conn, &self.job_id, \"applied\", Some(&self.proposal_id), None)?;\n        span.record(\"outcome\", \"applied\");\n        Ok(ApplyOutcome::Applied { memory_id })\n    }\n\n    pub fn reject(\n        &self,\n        conn: &Connection,\n        event_writer: &EventWriter,\n        decided_by: &str,\n        decision_reason: Option<&str>,\n    ) -> Result<RejectOutcome, LatticeError> {\n        let span = info_span!(\n            \"consolidation.proposal.reject\",\n            workspace_id = event_writer.workspace_id().as_str(),\n            job_id = self.job_id.as_str(),\n            proposal_id = self.proposal_id.as_str(),\n            outcome = field::Empty\n        );\n        let _entered = span.enter();\n        let decision = load_decision(conn, &self.proposal_id)?;\n        if decision != ProposalDecision::Pending {\n            span.record(\"outcome\", \"already_decided\");\n            return Ok(RejectOutcome::AlreadyDecided { decision });\n        }\n\n        mark_decided(\n            conn,\n            &self.proposal_id,\n            ProposalDecision::Rejected,\n            decided_by,\n            decision_reason,\n        )?;\n        mark_job_status(\n            conn,\n            &self.job_id,\n            \"rejected\",\n            Some(&self.proposal_id),\n            None,\n        )?;\n        span.record(\"outcome\", \"rejected\");\n        Ok(RejectOutcome::Rejected)\n    }\n\n    fn materialize(&self, memory_store: &MemoryStore) -> Result<Memory, LatticeError> {\n        match self.proposal_kind {\n            ProposalKind::CreateMemory | ProposalKind::UpdateMemory | ProposalKind::Refresh => {\n                self.materialize_memory_state(memory_store)\n            }\n            ProposalKind::MarkStale => self.materialize_stale(memory_store),\n            ProposalKind::Supersede => self.materialize_supersession(memory_store),\n            ProposalKind::Demote => self.materialize_memory_state(memory_store),\n        }\n    }\n\n    fn materialize_memory_state(&self, memory_store: &MemoryStore) -> Result<Memory, LatticeError> {\n        if let Some(state) = proposed_memory_state(&self.proposed_state)? {\n            apply_memory_state(memory_store, &state)?;\n            return Ok(state.memory);\n        }\n\n        let memory = proposed_memory(&self.proposed_state)?;\n        memory_store.store(memory.clone())?;\n        Ok(memory)\n    }\n\n    fn materialize_stale(&self, memory_store: &MemoryStore) -> Result<Memory, LatticeError> {\n        if proposed_memory_state(&self.proposed_state)?.is_some() {\n            return self.materialize_memory_state(memory_store);\n        }\n        let target_id = required_target_id(&self.target)?;\n        let reason = self\n            .proposed_state\n            .get(\"stale_reason\")\n            .and_then(Value::as_str)\n            .unwrap_or(\"marked stale by consolidation proposal\");\n        memory_store.mark_stale_by_id(target_id, reason)?;\n        memory_store\n            .get_by_id(target_id)?\n            .ok_or_else(|| missing_memory(target_id))\n    }\n\n    fn materialize_supersession(&self, memory_store: &MemoryStore) -> Result<Memory, LatticeError> {\n        if proposed_memory_state(&self.proposed_state)?.is_some() {\n            return self.materialize_memory_state(memory_store);\n        }\n        let target_id = required_target_id(&self.target)?;\n        let superseded_by = self\n            .proposed_state\n            .get(\"superseded_by_memory_id\")\n            .and_then(Value::as_str)\n            .ok_or_else(|| {\n                LatticeError::Storage(\"supersede proposal missing superseded_by_memory_id\".into())\n            })?;\n        memory_store.mark_memory_superseded(target_id, superseded_by)?;\n        memory_store\n            .get_by_id(target_id)?\n            .ok_or_else(|| missing_memory(target_id))\n    }\n\n    pub(crate) fn emit_event(\n        &self,\n        event_writer: &EventWriter,\n        memory: &str,\n        post_apply_state_hash: [u8; 32],\n        decided_by: &str,\n        decision_reason: Option<&str>,\n    ) -> Result<(), LatticeError> {\n        let memory_id = memory_identity(event_writer.workspace_id(), memory);\n        let payload = EventPayload::MemoryConsolidated(MemoryConsolidatedPayload {\n            source_memory_ids: source_memory_ids(event_writer.workspace_id(), &self.evidence),\n            consolidated_memory_id: memory_id.clone(),\n            source_event_ids: Vec::new(),\n            consolidation_summary: consolidation_summary(self),\n            proposal_id: Some(self.proposal_id.clone()),\n            prior_state_json: Some(self.prior_state.to_string()),\n            proposed_state_json: Some(self.proposed_state.to_string()),\n            decided_by: Some(decided_by.to_string()),\n            decision_reason: decision_reason.map(str::to_string),\n            post_apply_state_hash,\n        });\n        let envelope = PartialEnvelope {\n            workspace_id: Some(event_writer.workspace_id().clone()),\n            branch: BranchRef {\n                name: \"main\".to_string(),\n            },\n            session_id: SessionId {\n                value: format!(\"consolidation-{}\", self.job_id),\n            },\n            task_id: None,\n            actor: Actor::Daemon,\n            kind: EventKind::MemoryConsolidated,\n            references: vec![StableRef::MemoryRef(memory_id)],\n            summary: CompactSummary::new(consolidation_summary(self))\n                .map_err(|e| LatticeError::Storage(e.to_string()))?,\n            payload,\n        };\n        event_writer.append(envelope).map_err(|e| {\n            LatticeError::Storage(format!(\"Failed to write consolidation event: {e}\"))\n        })?;\n        Ok(())\n    }\n}\n\nstruct ProposalRow {\n    proposal_id: String,\n    job_id: String,\n    target_memory_id: Option<String>,\n    proposal_kind: String,\n    prior_state: String,\n    proposed_state: String,\n    evidence: String,\n    provenance_json: Option<String>,\n}\n\nstruct ProposalRecordRow {\n    proposal_id: String,\n    job_id: String,\n    workspace_id: String,\n    enqueued_at: i64,\n    target_memory_id: Option<String>,\n    proposal_kind: String,\n    prior_state: String,\n    proposed_state: String,\n    evidence: String,\n    provenance_json: Option<String>,\n    decided_at: Option<i64>,\n    decision: String,\n    decided_by: Option<String>,\n    decision_reason: Option<String>,\n}\n\nimpl ProposalRow {\n    fn into_proposal(self) -> Result<ConsolidationProposal, LatticeError> {\n        Ok(ConsolidationProposal {\n            proposal_id: self.proposal_id,\n            job_id: self.job_id,\n            target: match self.target_memory_id {\n                Some(memory_id) => ProposalTarget::ExistingMemory(memory_id),\n                None => ProposalTarget::NewMemory,\n            },\n            proposal_kind: ProposalKind::from_str(&self.proposal_kind)?,\n            prior_state: serde_json::from_str(&self.prior_state).map_err(json_error)?,\n            proposed_state: serde_json::from_str(&self.proposed_state).map_err(json_error)?,\n            evidence: serde_json::from_str(&self.evidence).map_err(json_error)?,\n            provenance: self\n                .provenance_json\n                .map(|json| serde_json::from_str(&json).map_err(json_error))\n                .transpose()?,\n        })\n    }\n}\n\nimpl ProposalRecordRow {\n    fn into_record(self) -> Result<ConsolidationProposalRecord, LatticeError> {\n        Ok(ConsolidationProposalRecord {\n            proposal_id: self.proposal_id,\n            job_id: self.job_id,\n            workspace_id: self.workspace_id,\n            enqueued_at: self.enqueued_at,\n            target_memory_id: self.target_memory_id,\n            proposal_kind: ProposalKind::from_str(&self.proposal_kind)?,\n            prior_state: serde_json::from_str(&self.prior_state).map_err(json_error)?,\n            proposed_state: serde_json::from_str(&self.proposed_state).map_err(json_error)?,\n            evidence: serde_json::from_str(&self.evidence).map_err(json_error)?,\n            provenance: self\n                .provenance_json\n                .map(|json| serde_json::from_str(&json).map_err(json_error))\n                .transpose()?,\n            decided_at: self.decided_at,\n            decision: ProposalDecision::from_str(&self.decision)?,\n            decided_by: self.decided_by,\n            decision_reason: self.decision_reason,\n        })\n    }\n}\n\npub fn load_row(\n    conn: &Connection,\n    proposal_id: &str,\n) -> Result<Option<ConsolidationProposalRow>, LatticeError> {\n    conn.query_row(\n        \"SELECT p.proposal_id,\n                p.job_id,\n                j.workspace_id,\n                j.enqueued_at,\n                p.target_memory_id,\n                p.proposal_kind,\n                p.prior_state,\n                p.proposed_state,\n                p.evidence,\n                p.provenance_json,\n                p.decided_at,\n                p.decision,\n                p.decided_by,\n                p.decision_reason\n         FROM consolidation_proposals p\n         INNER JOIN consolidation_jobs j ON j.job_id = p.job_id\n         WHERE p.proposal_id = ?1\",\n        params![proposal_id],\n        |row| {\n            Ok(ConsolidationProposalRow {\n                proposal_id: row.get(0)?,\n                job_id: row.get(1)?,\n                workspace_id: row.get(2)?,\n                enqueued_at: row.get(3)?,\n                target_memory_id: row.get(4)?,\n                proposal_kind: row.get(5)?,\n                prior_state: row.get(6)?,\n                proposed_state: row.get(7)?,\n                evidence: row.get(8)?,\n                provenance_json: row.get(9)?,\n                decided_at: row.get(10)?,\n                decision: row.get(11)?,\n                decided_by: row.get(12)?,\n                decision_reason: row.get(13)?,\n            })\n        },\n    )\n    .optional()\n    .map_err(|e| LatticeError::Storage(format!(\"Failed to load proposal row: {e}\")))\n}\n\nfn load_decision(conn: &Connection, proposal_id: &str) -> Result<ProposalDecision, LatticeError> {\n    let decision: String = conn\n        .query_row(\n            \"SELECT decision FROM consolidation_proposals WHERE proposal_id = ?1\",\n            params![proposal_id],\n            |row| row.get(0),\n        )\n        .map_err(|e| LatticeError::Storage(format!(\"Failed to load proposal decision: {e}\")))?;\n    ProposalDecision::from_str(&decision)\n}\n\nfn mark_decided(\n    conn: &Connection,\n    proposal_id: &str,\n    decision: ProposalDecision,\n    decided_by: &str,\n    decision_reason: Option<&str>,\n) -> Result<(), LatticeError> {\n    conn.execute(\n        \"UPDATE consolidation_proposals\n         SET decision = ?1, decided_at = ?2, decided_by = ?3, decision_reason = ?4\n         WHERE proposal_id = ?5 AND decision = 'pending'\",\n        params![\n            decision.as_str(),\n            crate::consolidation::now_unix_micros(),\n            decided_by,\n            decision_reason,\n            proposal_id\n        ],\n    )\n    .map_err(|e| LatticeError::Storage(format!(\"Failed to update proposal decision: {e}\")))?;\n    Ok(())\n}\n\npub(crate) fn mark_job_status(\n    conn: &Connection,\n    job_id: &str,\n    status: &str,\n    proposal_id: Option<&str>,\n    error_kind: Option<&str>,\n) -> Result<(), LatticeError> {\n    conn.execute(\n        \"UPDATE consolidation_jobs\n         SET status = ?1,\n             finished_at = CASE WHEN ?1 IN ('proposed', 'applied', 'rejected', 'failed') THEN ?2 ELSE finished_at END,\n             proposal_id = COALESCE(?3, proposal_id),\n             error_kind = ?4\n         WHERE job_id = ?5\",\n        params![\n            status,\n            crate::consolidation::now_unix_micros(),\n            proposal_id,\n            error_kind,\n            job_id\n        ],\n    )\n    .map_err(|e| LatticeError::Storage(format!(\"Failed to update consolidation job: {e}\")))?;\n    Ok(())\n}\n\nfn proposed_memory(value: &Value) -> Result<Memory, LatticeError> {\n    serde_json::from_value(value.clone()).map_err(json_error)\n}\n\nfn proposed_memory_state(\n    value: &Value,\n) -> Result<Option<crate::consolidation::ConsolidationMemoryState>, LatticeError> {\n    if value.get(\"memory\").is_none() || value.get(\"structured_fields\").is_none() {\n        return Ok(None);\n    }\n    serde_json::from_value(value.clone())\n        .map(Some)\n        .map_err(json_error)\n}\n\nfn required_target_id(target: &ProposalTarget) -> Result<&str, LatticeError> {\n    target.memory_id().ok_or_else(|| {\n        LatticeError::Storage(\"proposal kind requires an existing target memory\".to_string())\n    })\n}\n\nfn missing_memory(memory_id: &str) -> LatticeError {\n    LatticeError::Storage(format!(\"Memory '{memory_id}' not found or invalidated\"))\n}\n\nfn source_memory_ids(workspace_id: &str, evidence: &Value) -> Vec<MemoryId> {\n    evidence\n        .get(\"source_memory_ids\")\n        .and_then(Value::as_array)\n        .into_iter()\n        .flatten()\n        .filter_map(Value::as_str)\n        .map(|id| memory_identity(workspace_id, id))\n        .collect()\n}\n\nfn memory_identity(workspace_id: &str, memory_id: &str) -> MemoryId {\n    MemoryId {\n        workspace_id: workspace_id.to_string(),\n        ulid: memory_id.to_string(),\n    }\n}\n\nfn consolidation_summary(proposal: &ConsolidationProposal) -> String {\n    let target = proposal.target.memory_id().unwrap_or(\"new memory\");\n    format!(\n        \"consolidation proposal {} applied to {target}\",\n        proposal.proposal_id\n    )\n}\n\nfn json_error(error: serde_json::Error) -> LatticeError {\n    LatticeError::Storage(format!(\"Failed to process proposal JSON: {error}\"))\n}\n\npub(crate) fn proposal_from_pending(\n    job_id: &str,\n    pending: crate::consolidation::PendingProposalSpec,\n) -> ConsolidationProposal {\n    ConsolidationProposal {\n        proposal_id: pending.proposal_id,\n        job_id: job_id.to_string(),\n        target: match pending.target_memory_id {\n            Some(memory_id) => ProposalTarget::ExistingMemory(memory_id),\n            None => ProposalTarget::NewMemory,\n        },\n        proposal_kind: pending.proposal_kind,\n        prior_state: pending.prior_state,\n        proposed_state: pending.proposed_state,\n        evidence: pending.evidence,\n        provenance: pending.provenance,\n    }\n}\n\npub fn empty_state() -> Value {\n    json!({})\n}\n\npub(crate) fn apply_memory_state(\n    memory_store: &MemoryStore,\n    state: &ConsolidationMemoryState,\n) -> Result<(), LatticeError> {\n    memory_store.store(state.memory.clone())?;\n    memory_store.update_structured_fields(&state.memory.id, &state.structured_fields)?;\n    memory_store.delete_memory_links_from(&state.memory.id)?;\n    for link in &state.memory_links {\n        memory_store.insert_memory_link(link)?;\n    }\n    match state.last_verified_at {\n        Some(last_verified_at) => {\n            memory_store.set_last_verified_at(&state.memory.id, last_verified_at)?\n        }\n        None => memory_store.clear_last_verified_at(&state.memory.id)?,\n    }\n    Ok(())\n}\n\npub(crate) fn state_hash_for_memory(\n    memory_store: &MemoryStore,\n    memory_id: &str,\n) -> Result<[u8; 32], LatticeError> {\n    let state = memory_store\n        .get_by_id(memory_id)?\n        .ok_or_else(|| missing_memory(memory_id))?;\n    let state = crate::consolidation::capture_memory_state(memory_store, &state)?;\n    state_hash_from_json(&encode_memory_state(&state))\n}\n\npub(crate) fn state_hash_from_json(value: &Value) -> Result<[u8; 32], LatticeError> {\n    let canonical = canonical_json_bytes(value).map_err(|e| {\n        LatticeError::Storage(format!(\"Failed to canonicalize state hash payload: {e}\"))\n    })?;\n    let digest = Sha256::digest(&canonical);\n    let mut hash = [0_u8; 32];\n    hash.copy_from_slice(&digest);\n    Ok(hash)\n}\n","numLines":752,"startLine":1,"totalLines":752}}}
