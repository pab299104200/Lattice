{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VpN68F8yRZnioCaASoqcfk","type":"tool_result","content":"1\tuse std::io::Write;\n2\tuse std::sync::{Arc, Mutex};\n3\t\n4\tuse rusqlite::{params, Connection};\n5\tuse serde_json::json;\n6\tuse tempfile::tempdir;\n7\tuse tracing_subscriber::fmt::MakeWriter;\n8\t\n9\tuse super::*;\n10\tuse crate::events::{EventKind, EventPayload, EventQuery, EventReader, EventStore, EventWriter};\n11\tuse crate::memory::{Memory, MemoryScope, MemoryStore, MemoryType};\n12\t\n13\t#[test]\n14\tfn deterministic_job_emits_proposal_without_mutating_memory() {\n15\t    let fixture = Fixture::new();\n16\t    let mut runtime = fixture.runtime(8);\n17\t    runtime\n18\t        .submit(create_memory_job(\n19\t            \"job-create\",\n20\t            \"proposal-create\",\n21\t            \"created memory\",\n22\t        ))\n23\t        .expect(\"job enqueues\");\n24\t\n25\t    let proposals = runtime.run_due().expect(\"job runs\");\n26\t\n27\t    assert_eq!(proposals.len(), 1);\n28\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n29\t    assert_eq!(\n30\t        proposal_decision(fixture.consolidation_db.path(), \"proposal-create\"),\n31\t        \"pending\"\n32\t    );\n33\t}\n34\t\n35\t#[test]\n36\tfn apply_materializes_memory_and_writes_consolidated_event_with_states() {\n37\t    let fixture = Fixture::new();\n38\t    let mut runtime = fixture.runtime(8);\n39\t    runtime\n40\t        .submit(create_memory_job(\n41\t            \"job-apply\",\n42\t            \"proposal-apply\",\n43\t            \"applied memory\",\n44\t        ))\n45\t        .expect(\"job enqueues\");\n46\t    runtime.run_due().expect(\"job runs\");\n47\t\n48\t    let outcome = runtime\n49\t        .decide(\n50\t            \"proposal-apply\",\n51\t            ProposalDecision::Applied,\n52\t            &fixture.memory_store,\n53\t            &fixture.event_writer,\n54\t            \"operator\",\n55\t        )\n56\t        .expect(\"proposal applies\");\n57\t\n58\t    assert_eq!(\n59\t        outcome,\n60\t        Some(ApplyOutcome::Applied {\n61\t            memory_id: \"mem-proposal-apply\".to_string()\n62\t        })\n63\t    );\n64\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 1);\n65\t    let event = fixture.memory_consolidated_event();\n66\t    match event.payload {\n67\t        EventPayload::MemoryConsolidated(payload) => {\n68\t            assert_eq!(payload.proposal_id.as_deref(), Some(\"proposal-apply\"));\n69\t            assert!(payload.prior_state_json.unwrap().contains(\"{}\"));\n70\t            assert!(payload\n71\t                .proposed_state_json\n72\t                .unwrap()\n73\t                .contains(\"applied memory\"));\n74\t        }\n75\t        _ => panic!(\"expected memory_consolidated payload\"),\n76\t    }\n77\t}\n78\t\n79\t#[test]\n80\tfn reject_leaves_memory_unchanged_and_records_decision() {\n81\t    let fixture = Fixture::new();\n82\t    let mut runtime = fixture.runtime(8);\n83\t    runtime\n84\t        .submit(create_memory_job(\n85\t            \"job-reject\",\n86\t            \"proposal-reject\",\n87\t            \"rejected memory\",\n88\t        ))\n89\t        .expect(\"job enqueues\");\n90\t    runtime.run_due().expect(\"job runs\");\n91\t\n92\t    let outcome = runtime\n93\t        .decide(\n94\t            \"proposal-reject\",\n95\t            ProposalDecision::Rejected,\n96\t            &fixture.memory_store,\n97\t            &fixture.event_writer,\n98\t            \"operator\",\n99\t        )\n100\t        .expect(\"proposal rejects\");\n101\t\n102\t    assert_eq!(outcome, None);\n103\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n104\t    assert_eq!(\n105\t        proposal_decision(fixture.consolidation_db.path(), \"proposal-reject\"),\n106\t        \"rejected\"\n107\t    );\n108\t}\n109\t\n110\t#[test]\n111\tfn double_apply_is_no_op_after_first_decision() {\n112\t    let fixture = Fixture::new();\n11