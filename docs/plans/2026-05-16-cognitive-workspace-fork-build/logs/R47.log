{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MqzgTPA8F33dTJsbuBDU88","type":"tool_result","content":"1\tuse std::collections::HashMap;\n2\tuse std::sync::Arc;\n3\tuse std::time::Duration;\n4\t\n5\tuse rusqlite::{params, Connection};\n6\tuse serde_json::json;\n7\tuse tempfile::tempdir;\n8\t\n9\tuse super::llm::{LlmDriver, LlmDriverError, LlmProvenance, LlmRequest, LlmResponse};\n10\tuse super::proposal::{apply_memory_state, state_hash_from_json};\n11\tuse super::*;\n12\tuse crate::events::{EventReader, EventStore, EventWriter, FlushPolicy};\n13\tuse crate::memory::model::MemoryProvenance;\n14\tuse crate::memory::{\n15\t    Memory, MemoryLinkRecord, MemoryScope, MemoryStore, MemoryStructuredFields, MemoryType,\n16\t    MemoryVerificationStatus,\n17\t};\n18\t\n19\t#[test]\n20\tfn replay_from_genesis_reconstructs_same_state_for_fifty_mixed_proposals() {\n21\t    let fixture = Fixture::new();\n22\t    let mut cache = HashMap::new();\n23\t\n24\t    for index in 0..50 {\n25\t        let proposal_id = format!(\"proposal-{index}\");\n26\t        let job_id = format!(\"job-{index}\");\n27\t        let memory_id = format!(\"mem-{index:02}\");\n28\t        let response_bytes = format!(\"response-{index}\").into_bytes();\n29\t        let prompt_bytes = format!(\"prompt-{index}\").into_bytes();\n30\t        let provenance = (index % 2 == 0).then(|| {\n31\t            let provenance = LlmProvenance::record(\n32\t                \"fake-llm\",\n33\t                &prompt_bytes,\n34\t                &response_bytes,\n35\t                8,\n36\t                4,\n37\t                Duration::from_millis(12),\n38\t            )\n39\t            .expect(\"provenance records\");\n40\t            cache.insert(provenance.prompt_sha256, response_bytes.clone());\n41\t            provenance\n42\t        });\n43\t        let state = memory_state(&memory_id, &format!(\"memory {index}\"));\n44\t        let proposal = ConsolidationProposal {\n45\t            proposal_id: proposal_id.clone(),\n46\t            job_id: job_id.clone(),\n47\t            target: ProposalTarget::NewMemory,\n48\t            proposal_kind: ProposalKind::CreateMemory,\n49\t            prior_state: empty_state(),\n50\t            proposed_state: encode_memory_state(&state),\n51\t            evidence: json!({ \"source_memory_ids\": [memory_id.clone()] }),\n52\t            provenance,\n53\t        };\n54\t        fixture.insert_job(&job_id);\n55\t        proposal\n56\t            .insert_pending(&fixture.conn)\n57\t            .expect(\"proposal inserts\");\n58\t        proposal\n59\t            .apply(\n60\t                &fixture.conn,\n61\t                &fixture.memory_store,\n62\t                &fixture.event_writer,\n63\t                \"operator\",\n64\t                Some(\"apply for replay\"),\n65\t            )\n66\t            .expect(\"proposal applies\");\n67\t    }\n68\t\n69\t    let expected_hash = fixture.store_hash();\n70\t    let driver = ReplayDriver::new(\n71\t        &fixture.event_reader,\n72\t        fixture.event_store.clone(),\n73\t        &fixture.conn,\n74\t        &fixture.memory_store,\n75\t        &fixture.event_writer,\n76\t        &fixture.clock,\n77\t    )\n78\t    .with_cached_responses(cache);\n79\t    let report = driver\n80\t        .replay(ReplayMode::FromGenesis)\n81\t        .expect(\"replay succeeds\");\n82\t\n83\t    assert_eq!(report.events_replayed, 50);\n84\t    assert_eq!(fixture.store_hash(), expected_hash);\n85\t}\n86\t\n87\t#[test]\n88\tfn reverse_refresh_restores_last_verified_at_exactly() {\n89\t    let fixture = Fixture::new();\n90\t    let prior = memory_state(\"mem-refresh\", \"refresh candidate\");\n91\t    apply_memory_state(&fixture.memory_store, &prior).expect(\"prior state stores\");\n92\t    let mut proposed = prior.clone();\n93\t    proposed.last_verified_at = Some(999);\n94\t    let proposal = ConsolidationProposal {\n95\t        proposal_id: \"proposal-refresh\".to_string(),\n96\t        job_id: \"job-refresh\".to_string(),\n97\t        target: ProposalTarget::ExistingMemory(\"mem-refresh\".to_string()),\n98\t        proposal_kind: ProposalKind::Refresh,\n99\t        prior_state: encode_memory_state(&prior),\n100\t        proposed_state: encode_memory_state(&proposed),\n101\t        evidence: json!({ \"source_memory_ids\": [\"mem-refresh\"] }),\n102\t        provenance: None,\n103\t    };\n104\t    fixture.insert_job(\"job-refresh\");\n105\t    proposal\n106\t        .insert_pending(&fixture.conn)\n107\t        .expect(\"proposal inserts\");\n108\t    proposal\n109\t        .apply(\n110\t            &fixture.conn,\n111\t            &fixture.memory_store,\n112\t            &fixture.event_writer,\n113\t            \"operator\",\n114\t            None,\n115\t        )\n116\t        .expect(\"proposal applies\");\n117\t\n118\t    let driver = fixture.replay_driver();\n119\t    let outcome = driver\n120\t        .reverse(\"proposal-refresh\")\n121\t        .expect(\"reverse succeeds\");\n122\t\n123\t    assert_eq!(\n124\t        outcome,\n125\t        ReverseOutcome::Reverted {\n126\t            memory_id: \"mem-refresh\".to_string()\n127\t        }\n128\t    );\n129\t    assert_eq!(\n130\t        fixture\n131\t            .memory_store\n132\t            .get_last_verified_at(\"mem-refresh\")\n133\t            .expect(\"timestamp loads\"),\n134\t        prior.last_verified_at\n135\t    );\n136\t}\n137\t\n138\t#[test]\n139\tfn reverse_supersede_restores_status_and_clears_memory_links() {\n140\t    let fixture = Fixture::new();\n141\t    let older = memory_state(\"mem-older\", \"older memory\");\n142\t    let newer = memory_state(\"mem-newer\", \"newer memory\");\n143\t    apply_memory_state(&fixture.memory_store, &older).expect(\"older stores\");\n144\t    apply_memory_state(&fixture.memory_store, &newer).expect(\"newer stores\");\n145\t\n146\t    let mut proposed = older.clone();\n147\t    proposed.structured_fields.verification_status = MemoryVerificationStatus::Superseded;\n148\t    proposed.structured_fields.superseded_by_memory_id = Some(\"mem-newer\".to_string());\n149\t    proposed.memory_links.push(MemoryLinkRecord {\n150\t        link_id: \"dup:mem-older:mem-newer\".to_string(),\n151\t        source_memory_id: \"mem-older\".to_string(),\n152\t        target_memory_id: \"mem-newer\".to_string(),\n153\t        link_type: \"supersedes\".to_string(),\n154\t        reason: \"duplicate detector\".to_string(),\n155\t        created_at: 2,\n156\t        verification_status: \"verified\".to_string(),\n157\t    });\n158\t    let proposal = ConsolidationProposal {\n159\t        proposal_id: \"proposal-supersede\".to_string(),\n160\t        job_id: \"job-supersede\".to_string(),\n161\t        target: ProposalTarget::ExistingMemory(\"mem-older\".to_string()),\n162\t        proposal_kind: ProposalKind::Supersede,\n163\t        prior_state: encode_memory_state(&older),\n164\t        proposed_state: encode_memory_state(&proposed),\n165\t        evidence: json!({ \"source_memory_ids\": [\"mem-older\", \"mem-newer\"] }),\n166\t        provenance: None,\n167\t    };\n168\t    fixture.insert_job(\"job-supersede\");\n169\t    proposal\n170\t        .insert_pending(&fixture.conn)\n171\t        .expect(\"proposal inserts\");\n172\t    proposal\n173\t        .apply(\n174\t            &fixture.conn,\n175\t            &fixture.memory_store,\n176\t            &fixture.event_writer,\n177\t            \"operator\",\n178\t            None,\n179\t        )\n180\t        .expect(\"proposal applies\");\n181\t\n182\t    fixture\n183\t        .replay_driver()\n184\t        .reverse(\"proposal-supersede\")\n185\t        .expect(\"reverse succeeds\");\n186\t\n187\t    let restored = fixture\n188\t        .memory_store\n189\t        .get_structured_fields(\"mem-older\")\n190\t        .expect(\"fields load\")\n191\t        .expect(\"fields exist\");\n192\t    assert_eq!(\n193\t        restored.verification_status,\n194\t        MemoryVerificationStatus::Unverified\n195\t    );\n196\t    assert!(restored.superseded_by_memory_id.is_none());\n197\t    assert!(fixture\n198\t        .memory_store\n199\t        .list_memory_links_from(\"mem-older\")\n200\t        .expect(\"links load\")\n201\t        .is_empty());\n202\t}\n203\t\n204\t#[test]\n205\tfn replay_succeeds_with_cached_llm_responses_and_fails_cleanly_without_them() {\n206\t    let fixture = Fixture::new();\n207\t    let (proposal, cache) = llm_backed_create(\"proposal-cache\", \"job-cache\", \"mem-cache\");\n208\t    fixture.insert_job(\"job-cache\");\n209\t    proposal\n210\t        .insert_pending(&fixture.conn)\n211\t        .expect(\"proposal inserts\");\n212\t    proposal\n213\t        .apply(\n214\t            &fixture.conn,\n215\t            &fixture.memory_store,\n216\t            &fixture.event_writer,\n217\t            \"operator\",\n218\t            None,\n219\t        )\n220\t        .expect(\"proposal applies\");\n221\t\n222\t    fixture\n223\t        .replay_driver()\n224\t        .with_cached_responses(cache.clone())\n225\t        .replay(ReplayMode::FromGenesis)\n226\t        .expect(\"cache-backed replay succeeds\");\n227\t\n228\t    let error = fixture\n229\t        .replay_driver()\n230\t        .replay(ReplayMode::FromGenesis)\n231\t        .expect_err(\"replay without cache fails\");\n232\t    assert!(matches!(error, ReplayError::CachedResponseMissing { .. }));\n233\t}\n234\t\n235\t#[test]\n236\tfn replay_never_calls_live_llm_driver() {\n237\t    let fixture = Fixture::new();\n238\t    let (proposal, cache) = llm_backed_create(\"proposal-live\", \"job-live\", \"mem-live\");\n239\t    fixture.insert_job(\"job-live\");\n240\t    proposal\n241\t        .insert_pending(&fixture.conn)\n242\t        .expect(\"proposal inserts\");\n243\t    proposal\n244\t        .apply(\n245\t            &fixture.conn,\n246\t            &fixture.memory_store,\n247\t            &fixture.event_writer,\n248\t            \"operator\",\n249\t            None,\n250\t        )\n251\t        .expect(\"proposal applies\");\n252\t\n253\t    fixture\n254\t        .replay_driver()\n255\t        .with_cached_responses(cache)\n256\t        .with_live_llm_driver(&PanicDriver)\n257\t        .replay(ReplayMode::FromGenesis)\n258\t        .expect(\"replay ignores live LLM driver\");\n259\t}\n260\t\n261\t#[test]\n262\tfn reverse_is_idempotent_for_already_reverted_proposals() {\n263\t    let fixture = Fixture::new();\n264\t    let prior = memory_state(\"mem-idempotent\", \"idempotent memory\");\n265\t    apply_memory_state(&fixture.memory_store, &prior).expect(\"prior stores\");\n266\t    let mut proposed = prior.clone();\n267\t    proposed.last_verified_at = Some(77);\n268\t    let proposal = ConsolidationProposal {\n269\t        proposal_id: \"proposal-idempotent\".to_string(),\n270\t        job_id: \"job-idempotent\".to_string(),\n271\t        target: ProposalTarget::ExistingMemory(\"mem-idempotent\".to_string()),\n272\t        proposal_kind: ProposalKind::Refresh,\n273\t        prior_state: encode_memory_state(&prior),\n274\t        proposed_state: encode_memory_state(&proposed),\n275\t        evidence: json!({ \"source_memory_ids\": [\"mem-idempotent\"] }),\n276\t        provenance: None,\n277\t    };\n278\t    fixture.insert_job(\"job-idempotent\");\n279\t    proposal\n280\t        .insert_pending(&fixture.conn)\n281\t        .expect(\"proposal inserts\");\n282\t    proposal\n283\t        .apply(\n284\t            &fixture.conn,\n285\t            &fixture.memory_store,\n286\t            &fixture.event_writer,\n287\t            \"operator\",\n288\t            None,\n289\t        )\n290\t        .expect(\"proposal applies\");\n291\t\n292\t    let driver = fixture.replay_driver();\n293\t    assert!(matches!(\n294\t        driver.reverse(\"proposal-idempotent\"),\n295\t        Ok(ReverseOutcome::Reverted { .. })\n296\t    ));\n297\t    assert_eq!(\n298\t        driver\n299\t            .reverse(\"proposal-idempotent\")\n300\t            .expect(\"second reverse handled\"),\n301\t        ReverseOutcome::AlreadyReverted\n302\t    );\n303\t}\n304\t\n305\tstruct Fixture {\n306\t    _dir: tempfile::TempDir,\n307\t    conn: Connection,\n308\t    memory_store: MemoryStore,\n309\t    event_store: Arc<EventStore>,\n310\t    event_reader: EventReader,\n311\t    event_writer: EventWriter,\n312\t    clock: FixedReplayClock,\n313\t}\n314\t\n315\timpl Fixture {\n316\t    fn new() -> Self {\n317\t        let dir = tempdir().expect(\"tempdir\");\n318\t        let conn = Connection::open(dir.path().join(\"consolidation.sqlite\")).expect(\"db opens\");\n319\t        initialize_schema(&conn).expect(\"schema initializes\");\n320\t        let memory_store = MemoryStore::open(&dir.path().join(\"memory.sqlite\")).unwrap();\n321\t        let event_store = Arc::new(EventStore::open_in_memory().unwrap());\n322\t        let event_reader = EventReader::new(event_store.clone());\n323\t        let event_writer =\n324\t            EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n325\t                .with_flush_policy(FlushPolicy::Sync);\n326\t        Self {\n327\t            _dir: dir,\n328\t            conn,\n329\t            memory_store,\n330\t            event_store,\n331\t            event_reader,\n332\t            event_writer,\n333\t            clock: FixedReplayClock::default(),\n334\t        }\n335\t    }\n336\t\n337\t    fn insert_job(&self, job_id: &str) {\n338\t        self.conn\n339\t            .execute(\n340\t                \"INSERT INTO consolidation_jobs\n341\t                    (job_id, workspace_id, kind, mode, status, enqueued_at)\n342\t                 VALUES (?1, 'workspace-main', 'replay-test', 'background', 'queued', 1)\",\n343\t                params![job_id],\n344\t            )\n345\t            .expect(\"job inserts\");\n346\t    }\n347\t\n348\t    fn replay_driver(&self) -> ReplayDriver<'_> {\n349\t        ReplayDriver::new(\n350\t            &self.event_reader,\n351\t            self.event_store.clone(),\n352\t            &self.conn,\n353\t            &self.memory_store,\n354\t            &self.event_writer,\n355\t            &self.clock,\n356\t        )\n357\t    }\n358\t\n359\t    fn store_hash(&self) -> [u8; 32] {\n360\t        let mut states = self\n361\t            .memory_store\n362\t            .query_unscoped_admin(None, usize::MAX)\n363\t            .expect(\"memories list\");\n364\t        states.sort_by(|left, right| left.id.cmp(&right.id));\n365\t        let payload = states\n366\t            .into_iter()\n367\t            .map(|memory| {\n368\t                let state =\n369\t                    capture_memory_state(&self.memory_store, &memory).expect(\"state captures\");\n370\t                serde_json::to_value(state).expect(\"state serializes\")\n371\t            })\n372\t            .collect::<Vec<_>>();\n373\t        state_hash_from_json(&serde_json::Value::Array(payload)).expect(\"hash computes\")\n374\t    }\n375\t}\n376\t\n377\t#[derive(Clone)]\n378\tstruct PanicDriver;\n379\t\n380\timpl LlmDriver for PanicDriver {\n381\t    fn complete(&self, _request: LlmRequest) -> Result<LlmResponse, LlmDriverError> {\n382\t        panic!(\"replay must not call the live LLM driver\");\n383\t    }\n384\t\n385\t    fn name(&self) -> &str {\n386\t        \"panic-driver\"\n387\t    }\n388\t}\n389\t\n390\tfn llm_backed_create(\n391\t    proposal_id: &str,\n392\t    job_id: &str,\n393\t    memory_id: &str,\n394\t) -> (ConsolidationProposal, HashMap<[u8; 32], Vec<u8>>) {\n395\t    let prompt_bytes = format!(\"prompt-{proposal_id}\").into_bytes();\n396\t    let response_bytes = format!(\"response-{proposal_id}\").into_bytes();\n397\t    let provenance = LlmProvenance::record(\n398\t        \"fake-llm\",\n399\t        &prompt_bytes,\n400\t        &response_bytes,\n401\t        10,\n402\t        5,\n403\t        Duration::from_millis(7),\n404\t    )\n405\t    .expect(\"provenance records\");\n406\t    let mut cache = HashMap::new();\n407\t    cache.insert(provenance.prompt_sha256, response_bytes);\n408\t    (\n409\t        ConsolidationProposal {\n410\t            proposal_id: proposal_id.to_string(),\n411\t            job_id: job_id.to_string(),\n412\t            target: ProposalTarget::NewMemory,\n413\t            proposal_kind: ProposalKind::CreateMemory,\n414\t            prior_state: empty_state(),\n415\t            proposed_state: encode_memory_state(&memory_state(memory_id, \"llm-backed memory\")),\n416\t            evidence: json!({ \"source_memory_ids\": [memory_id] }),\n417\t            provenance: Some(provenance),\n418\t        },\n419\t        cache,\n420\t    )\n421\t}\n422\t\n423\tfn memory_state(memory_id: &str, content: &str) -> ConsolidationMemoryState {\n424\t    ConsolidationMemoryState {\n425\t        memory: Memory {\n426\t            id: memory_id.to_string(),\n427\t            session_id: \"session-main\".to_string(),\n428\t            content: content.to_string(),\n429\t            memory_type: MemoryType::Observation,\n430\t            scope: MemoryScope::Session,\n431\t            confidence: 0.9,\n432\t            linked_symbols: Vec::new(),\n433\t            linked_files: Vec::new(),\n434\t            workspace_id: Some(\"workspace-main\".to_string()),\n435\t            branch: Some(\"main\".to_string()),\n436\t            refresh_key: None,\n437\t            source_query: None,\n438\t            created_at: 1,\n439\t            last_accessed: 1,\n440\t            access_count: 0,\n441\t            is_stale: false,\n442\t            stale_reason: None,\n443\t        },\n444\t        structured_fields: MemoryStructuredFields {\n445\t            provenance: vec![MemoryProvenance {\n446\t                source: \"replay-tests\".to_string(),\n447\t                reference: None,\n448\t                captured_at: Some(1),\n449\t                note: Some(\"fixture\".to_string()),\n450\t            }],\n451\t            ..MemoryStructuredFields::default()\n452\t        },\n453\t        last_verified_at: Some(10),\n454\t        memory_links: Vec::new(),\n455\t    }\n456\t}\n457\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"c83bf6fc-c816-4601-af30-5bdd70ddf472","timestamp":"2026-05-17T11:43:11.339Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/replay_tests.rs","content":"use std::collections::HashMap;\nuse std::sync::Arc;\nuse std::time::Duration;\n\nuse rusqlite::{params, Connection};\nuse serde_json::json;\nuse tempfile::tempdir;\n\nuse super::llm::{LlmDriver, LlmDriverError, LlmProvenance, LlmRequest, LlmResponse};\nuse super::proposal::{apply_memory_state, state_hash_from_json};\nuse super::*;\nuse crate::events::{EventReader, EventStore, EventWriter, FlushPolicy};\nuse crate::memory::model::MemoryProvenance;\nuse crate::memory::{\n    Memory, MemoryLinkRecord, MemoryScope, MemoryStore, MemoryStructuredFields, MemoryType,\n    MemoryVerificationStatus,\n};\n\n#[test]\nfn replay_from_genesis_reconstructs_same_state_for_fifty_mixed_proposals() {\n    let fixture = Fixture::new();\n    let mut cache = HashMap::new();\n\n    for index in 0..50 {\n        let proposal_id = format!(\"proposal-{index}\");\n        let job_id = format!(\"job-{index}\");\n        let memory_id = format!(\"mem-{index:02}\");\n        let response_bytes = format!(\"response-{index}\").into_bytes();\n        let prompt_bytes = format!(\"prompt-{index}\").into_bytes();\n        let provenance = (index % 2 == 0).then(|| {\n            let provenance = LlmProvenance::record(\n                \"fake-llm\",\n                &prompt_bytes,\n                &response_bytes,\n                8,\n                4,\n                Duration::from_millis(12),\n            )\n            .expect(\"provenance records\");\n            cache.insert(provenance.prompt_sha256, response_bytes.clone());\n            provenance\n        });\n        let state = memory_state(&memory_id, &format!(\"memory {index}\"));\n        let proposal = ConsolidationProposal {\n            proposal_id: proposal_id.clone(),\n            job_id: job_id.clone(),\n            target: ProposalTarget::NewMemory,\n            proposal_kind: ProposalKind::CreateMemory,\n            prior_state: empty_state(),\n            proposed_state: encode_memory_state(&state),\n            evidence: json!({ \"source_memory_ids\": [memory_id.clone()] }),\n            provenance,\n        };\n        fixture.insert_job(&job_id);\n        proposal\n            .insert_pending(&fixture.conn)\n            .expect(\"proposal inserts\");\n        proposal\n            .apply(\n                &fixture.conn,\n                &fixture.memory_store,\n                &fixture.event_writer,\n                \"operator\",\n                Some(\"apply for replay\"),\n            )\n            .expect(\"proposal applies\");\n    }\n\n    let expected_hash = fixture.store_hash();\n    let driver = ReplayDriver::new(\n        &fixture.event_reader,\n        fixture.event_store.clone(),\n        &fixture.conn,\n        &fixture.memory_store,\n        &fixture.event_writer,\n        &fixture.clock,\n    )\n    .with_cached_responses(cache);\n    let report = driver\n        .replay(ReplayMode::FromGenesis)\n        .expect(\"replay succeeds\");\n\n    assert_eq!(report.events_replayed, 50);\n    assert_eq!(fixture.store_hash(), expected_hash);\n}\n\n#[test]\nfn reverse_refresh_restores_last_verified_at_exactly() {\n    let fixture = Fixture::new();\n    let prior = memory_state(\"mem-refresh\", \"refresh candidate\");\n    apply_memory_state(&fixture.memory_store, &prior).expect(\"prior state stores\");\n    let mut proposed = prior.clone();\n    proposed.last_verified_at = Some(999);\n    let proposal = ConsolidationProposal {\n        proposal_id: \"proposal-refresh\".to_string(),\n        job_id: \"job-refresh\".to_string(),\n        target: ProposalTarget::ExistingMemory(\"mem-refresh\".to_string()),\n        proposal_kind: ProposalKind::Refresh,\n        prior_state: encode_memory_state(&prior),\n        proposed_state: encode_memory_state(&proposed),\n        evidence: json!({ \"source_memory_ids\": [\"mem-refresh\"] }),\n        provenance: None,\n    };\n    fixture.insert_job(\"job-refresh\");\n    proposal\n        .insert_pending(&fixture.conn)\n        .expect(\"proposal inserts\");\n    proposal\n        .apply(\n            &fixture.conn,\n            &fixture.memory_store,\n            &fixture.event_writer,\n            \"operator\",\n            None,\n        )\n        .expect(\"proposal applies\");\n\n    let driver = fixture.replay_driver();\n    let outcome = driver\n        .reverse(\"proposal-refresh\")\n        .expect(\"reverse succeeds\");\n\n    assert_eq!(\n        outcome,\n        ReverseOutcome::Reverted {\n            memory_id: \"mem-refresh\".to_string()\n        }\n    );\n    assert_eq!(\n        fixture\n            .memory_store\n            .get_last_verified_at(\"mem-refresh\")\n            .expect(\"timestamp loads\"),\n        prior.last_verified_at\n    );\n}\n\n#[test]\nfn reverse_supersede_restores_status_and_clears_memory_links() {\n    let fixture = Fixture::new();\n    let older = memory_state(\"mem-older\", \"older memory\");\n    let newer = memory_state(\"mem-newer\", \"newer memory\");\n    apply_memory_state(&fixture.memory_store, &older).expect(\"older stores\");\n    apply_memory_state(&fixture.memory_store, &newer).expect(\"newer stores\");\n\n    let mut proposed = older.clone();\n    proposed.structured_fields.verification_status = MemoryVerificationStatus::Superseded;\n    proposed.structured_fields.superseded_by_memory_id = Some(\"mem-newer\".to_string());\n    proposed.memory_links.push(MemoryLinkRecord {\n        link_id: \"dup:mem-older:mem-newer\".to_string(),\n        source_memory_id: \"mem-older\".to_string(),\n        target_memory_id: \"mem-newer\".to_string(),\n        link_type: \"supersedes\".to_string(),\n        reason: \"duplicate detector\".to_string(),\n        created_at: 2,\n        verification_status: \"verified\".to_string(),\n    });\n    let proposal = ConsolidationProposal {\n        proposal_id: \"proposal-supersede\".to_string(),\n        job_id: \"job-supersede\".to_string(),\n        target: ProposalTarget::ExistingMemory(\"mem-older\".to_string()),\n        proposal_kind: ProposalKind::Supersede,\n        prior_state: encode_memory_state(&older),\n        proposed_state: encode_memory_state(&proposed),\n        evidence: json!({ \"source_memory_ids\": [\"mem-older\", \"mem-newer\"] }),\n        provenance: None,\n    };\n    fixture.insert_job(\"job-supersede\");\n    proposal\n        .insert_pending(&fixture.conn)\n        .expect(\"proposal inserts\");\n    proposal\n        .apply(\n            &fixture.conn,\n            &fixture.memory_store,\n            &fixture.event_writer,\n            \"operator\",\n            None,\n        )\n        .expect(\"proposal applies\");\n\n    fixture\n        .replay_driver()\n        .reverse(\"proposal-supersede\")\n        .expect(\"reverse succeeds\");\n\n    let restored = fixture\n        .memory_store\n        .get_structured_fields(\"mem-older\")\n        .expect(\"fields load\")\n        .expect(\"fields exist\");\n    assert_eq!(\n        restored.verification_status,\n        MemoryVerificationStatus::Unverified\n    );\n    assert!(restored.superseded_by_memory_id.is_none());\n    assert!(fixture\n        .memory_store\n        .list_memory_links_from(\"mem-older\")\n        .expect(\"links load\")\n        .is_empty());\n}\n\n#[test]\nfn replay_succeeds_with_cached_llm_responses_and_fails_cleanly_without_them() {\n    let fixture = Fixture::new();\n    let (proposal, cache) = llm_backed_create(\"proposal-cache\", \"job-cache\", \"mem-cache\");\n    fixture.insert_job(\"job-cache\");\n    proposal\n        .insert_pending(&fixture.conn)\n        .expect(\"proposal inserts\");\n    proposal\n        .apply(\n            &fixture.conn,\n            &fixture.memory_store,\n            &fixture.event_writer,\n            \"operator\",\n            None,\n        )\n        .expect(\"proposal applies\");\n\n    fixture\n        .replay_driver()\n        .with_cached_responses(cache.clone())\n        .replay(ReplayMode::FromGenesis)\n        .expect(\"cache-backed replay succeeds\");\n\n    let error = fixture\n        .replay_driver()\n        .replay(ReplayMode::FromGenesis)\n        .expect_err(\"replay without cache fails\");\n    assert!(matches!(error, ReplayError::CachedResponseMissing { .. }));\n}\n\n#[test]\nfn replay_never_calls_live_llm_driver() {\n    let fixture = Fixture::new();\n    let (proposal, cache) = llm_backed_create(\"proposal-live\", \"job-live\", \"mem-live\");\n    fixture.insert_job(\"job-live\");\n    proposal\n        .insert_pending(&fixture.conn)\n        .expect(\"proposal inserts\");\n    proposal\n        .apply(\n            &fixture.conn,\n            &fixture.memory_store,\n            &fixture.event_writer,\n            \"operator\",\n            None,\n        )\n        .expect(\"proposal applies\");\n\n    fixture\n        .replay_driver()\n        .with_cached_responses(cache)\n        .with_live_llm_driver(&PanicDriver)\n        .replay(ReplayMode::FromGenesis)\n        .expect(\"replay ignores live LLM driver\");\n}\n\n#[test]\nfn reverse_is_idempotent_for_already_reverted_proposals() {\n    let fixture = Fixture::new();\n    let prior = memory_state(\"mem-idempotent\", \"idempotent memory\");\n    apply_memory_state(&fixture.memory_store, &prior).expect(\"prior stores\");\n    let mut proposed = prior.clone();\n    proposed.last_verified_at = Some(77);\n    let proposal = ConsolidationProposal {\n        proposal_id: \"proposal-idempotent\".to_string(),\n        job_id: \"job-idempotent\".to_string(),\n        target: ProposalTarget::ExistingMemory(\"mem-idempotent\".to_string()),\n        proposal_kind: ProposalKind::Refresh,\n        prior_state: encode_memory_state(&prior),\n        proposed_state: encode_memory_state(&proposed),\n        evidence: json!({ \"source_memory_ids\": [\"mem-idempotent\"] }),\n        provenance: None,\n    };\n    fixture.insert_job(\"job-idempotent\");\n    proposal\n        .insert_pending(&fixture.conn)\n        .expect(\"proposal inserts\");\n    proposal\n        .apply(\n            &fixture.conn,\n            &fixture.memory_store,\n            &fixture.event_writer,\n            \"operator\",\n            None,\n        )\n        .expect(\"proposal applies\");\n\n    let driver = fixture.replay_driver();\n    assert!(matches!(\n        driver.reverse(\"proposal-idempotent\"),\n        Ok(ReverseOutcome::Reverted { .. })\n    ));\n    assert_eq!(\n        driver\n            .reverse(\"proposal-idempotent\")\n            .expect(\"second reverse handled\"),\n        ReverseOutcome::AlreadyReverted\n    );\n}\n\nstruct Fixture {\n    _dir: tempfile::TempDir,\n    conn: Connection,\n    memory_store: MemoryStore,\n    event_store: Arc<EventStore>,\n    event_reader: EventReader,\n    event_writer: EventWriter,\n    clock: FixedReplayClock,\n}\n\nimpl Fixture {\n    fn new() -> Self {\n        let dir = tempdir().expect(\"tempdir\");\n        let conn = Connection::open(dir.path().join(\"consolidation.sqlite\")).expect(\"db opens\");\n        initialize_schema(&conn).expect(\"schema initializes\");\n        let memory_store = MemoryStore::open(&dir.path().join(\"memory.sqlite\")).unwrap();\n        let event_store = Arc::new(EventStore::open_in_memory().unwrap());\n        let event_reader = EventReader::new(event_store.clone());\n        let event_writer =\n            EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096)\n                .with_flush_policy(FlushPolicy::Sync);\n        Self {\n            _dir: dir,\n            conn,\n            memory_store,\n            event_store,\n            event_reader,\n            event_writer,\n            clock: FixedReplayClock::default(),\n        }\n    }\n\n    fn insert_job(&self, job_id: &str) {\n        self.conn\n            .execute(\n                \"INSERT INTO consolidation_jobs\n                    (job_id, workspace_id, kind, mode, status, enqueued_at)\n                 VALUES (?1, 'workspace-main', 'replay-test', 'background', 'queued', 1)\",\n                params![job_id],\n            )\n            .expect(\"job inserts\");\n    }\n\n    fn replay_driver(&self) -> ReplayDriver<'_> {\n        ReplayDriver::new(\n            &self.event_reader,\n            self.event_store.clone(),\n            &self.conn,\n            &self.memory_store,\n            &self.event_writer,\n            &self.clock,\n        )\n    }\n\n    fn store_hash(&self) -> [u8; 32] {\n        let mut states = self\n            .memory_store\n            .query_unscoped_admin(None, usize::MAX)\n            .expect(\"memories list\");\n        states.sort_by(|left, right| left.id.cmp(&right.id));\n        let payload = states\n            .into_iter()\n            .map(|memory| {\n                let state =\n                    capture_memory_state(&self.memory_store, &memory).expect(\"state captures\");\n                serde_json::to_value(state).expect(\"state serializes\")\n            })\n            .collect::<Vec<_>>();\n        state_hash_from_json(&serde_json::Value::Array(payload)).expect(\"hash computes\")\n    }\n}\n\n#[derive(Clone)]\nstruct PanicDriver;\n\nimpl LlmDriver for PanicDriver {\n    fn complete(&self, _request: LlmRequest) -> Result<LlmResponse, LlmDriverError> {\n        panic!(\"replay must not call the live LLM driver\");\n    }\n\n    fn name(&self) -> &str {\n        \"panic-driver\"\n    }\n}\n\nfn llm_backed_create(\n    proposal_id: &str,\n    job_id: &str,\n    memory_id: &str,\n) -> (ConsolidationProposal, HashMap<[u8; 32], Vec<u8>>) {\n    let prompt_bytes = format!(\"prompt-{proposal_id}\").into_bytes();\n    let response_bytes = format!(\"response-{proposal_id}\").into_bytes();\n    let provenance = LlmProvenance::record(\n        \"fake-llm\",\n        &prompt_bytes,\n        &response_bytes,\n        10,\n        5,\n        Duration::from_millis(7),\n    )\n    .expect(\"provenance records\");\n    let mut cache = HashMap::new();\n    cache.insert(provenance.prompt_sha256, response_bytes);\n    (\n        ConsolidationProposal {\n            proposal_id: proposal_id.to_string(),\n            job_id: job_id.to_string(),\n            target: ProposalTarget::NewMemory,\n            proposal_kind: ProposalKind::CreateMemory,\n            prior_state: empty_state(),\n            proposed_state: encode_memory_state(&memory_state(memory_id, \"llm-backed memory\")),\n            evidence: json!({ \"source_memory_ids\": [memory_id] }),\n            provenance: Some(provenance),\n        },\n        cache,\n    )\n}\n\nfn memory_state(memory_id: &str, content: &str) -> ConsolidationMemoryState {\n    ConsolidationMemoryState {\n        memory: Memory {\n            id: memory_id.to_string(),\n            session_id: \"session-main\".to_string(),\n            content: content.to_string(),\n            memory_type: MemoryType::Observation,\n            scope: MemoryScope::Session,\n            confidence: 0.9,\n            linked_symbols: Vec::new(),\n            linked_files: Vec::new(),\n            workspace_id: Some(\"workspace-main\".to_string()),\n            branch: Some(\"main\".to_string()),\n            refresh_key: None,\n            source_query: None,\n            created_at: 1,\n            last_accessed: 1,\n            access_count: 0,\n            is_stale: false,\n            stale_reason: None,\n        },\n        structured_fields: MemoryStructuredFields {\n            provenance: vec![MemoryProvenance {\n                source: \"replay-tests\".to_string(),\n                reference: None,\n                captured_at: Some(1),\n                note: Some(\"fixture\".to_string()),\n            }],\n            ..MemoryStructuredFields::default()\n        },\n        last_verified_at: Some(10),\n        memory_links: Vec::new(),\n    }\n}\n","numLines":457,"startLine":1,"totalLines":457}}}
