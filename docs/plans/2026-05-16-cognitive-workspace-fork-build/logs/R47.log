{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W5TLybWmt7z2bYwmRozZ1C","type":"tool_result","content":"1\t//! Phase 6 consolidation integration tests.\n2\t//!\n3\t//! Spec invariants from `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## 6. Consolidation Engine`, `## Phase 6: Consolidation Engine`, and\n5\t//! `## Testing Requirements`:\n6\t//!\n7\t//! - \"consolidation is auditable, reversible, and test-covered\"\n8\t//! - \"Every background consolidation pass is recoverable, replayable, and observable.\"\n9\t//! - \"failed or malformed LLM responses must leave the prior memory state unchanged and emit a consolidation failure event\"\n10\t//! - \"consolidation queue depth must be bounded; when the queue is full, new jobs are dropped with a log warning rather than stalling the daemon\"\n11\t\n12\tuse std::sync::{Arc, Mutex};\n13\t\n14\tuse super::integration_test_support::*;\n15\tuse super::*;\n16\tuse crate::events::EventPayload;\n17\tuse crate::memory::{MemoryScope, MemoryVerificationStatus};\n18\t\n19\t#[test]\n20\tfn test_synchronous_session_consolidation_emits_proposal_not_silent_write() {\n21\t    let harness = ConsolidationHarness::new();\n22\t    harness.append_small_task(\"task-sync\");\n23\t    let outcome = harness\n24\t        .session_consolidator()\n25\t        .on_task_complete(\n26\t            \"workspace-main\",\n27\t            &task_id(\"task-sync\"),\n28\t            EpisodeOutcome::Success,\n29\t        )\n30\t        .expect(\"session consolidation succeeds\");\n31\t    let proposal_id = expect_session_proposal(outcome);\n32\t\n33\t    assert_pending_create_memory(&harness, &proposal_id);\n34\t    assert_eq!(harness.memory_count(), 0);\n35\t    harness.apply_proposal(&proposal_id);\n36\t    assert_eq!(harness.memory_count(), 1);\n37\t    assert_eq!(harness.consolidated_events().len(), 1);\n38\t}\n39\t\n40\t#[test]\n41\tfn test_deterministic_supersession_proposal_apply_then_reject_round_trip() {\n42\t    let harness = ConsolidationHarness::new();\n43\t    let older_id = harness.seed_memory(\n44\t        \"mem-older\",\n45\t        \"Duplicate login memory\",\n46\t        MemoryScope::Repo,\n47\t        10,\n48\t        vec![\"src/auth.ts\"],\n49\t        Vec::new(),\n50\t    );\n51\t    let newer_id = harness.seed_memory(\n52\t        \"mem-newer\",\n53\t        \"Duplicate login memory\",\n54\t        MemoryScope::Repo,\n55\t        20,\n56\t        vec![\"src/auth.ts\"],\n57\t        Vec::new(),\n58\t    );\n59\t    let proposal_id = harness.run_supersession_scan();\n60\t\n61\t    harness.apply_proposal(&proposal_id);\n62\t    assert_superseded_state(&harness, &older_id, &newer_id);\n63\t    assert_eq!(\n64\t        harness.reverse_proposal(&proposal_id),\n65\t        ReverseOutcome::Reverted {\n66\t            memory_id: older_id.clone(),\n67\t        }\n68\t    );\n69\t    assert_restored_state(&harness, &older_id);\n70\t}\n71\t\n72\t#[test]\n73\tfn test_llm_episode_job_well_formed_response_emits_proposal_with_provenance() {\n74\t    let mut harness = ConsolidationHarness::new();\n75\t    harness.driver.push_ok(episode_response());\n76\t    let slice = harness.task_slice(\"task-llm-provenance\");\n77\t    let proposal = harness\n78\t        .run_episode_job(background_ctx(), &slice)\n79\t        .expect(\"episode job succeeds\")\n80\t        .expect(\"proposal emitted\");\n81\t    let request = harness.driver.last_request().expect(\"request recorded\");\n82\t    let provenance = proposal.provenance.expect(\"provenance recorded\");\n83\t\n84\t    assert_eq!(provenance.model, \"fake-llm\");\n85\t    assert_eq!(provenance.prompt_sha256, sha256(request.prompt.as_bytes()));\n86\t    assert_eq!(\n87\t        provenance.response_sha256,\n88\t        sha256(episode_response().as_bytes())\n89\t    );\n90\t}\n91\t\n92\t#[test]\n93\tfn test_llm_malformed_response_leaves_memory_unchanged_and_emits_failure_event() {\n94\t    let mut harness = ConsolidationHarness::new();\n95\t    harness.driver.push_ok(\"{not json\".to_string());\n96\t    let slice = harness.task_slice(\"task-llm-malformed\");\n97\t\n98\t    let result = harness.run_episode_job(background_ctx(), &slice);\n99\t\n100\t    assert!(matches!(\n101\t        result,\n102\t        Err(super::llm::LlmJobError::MalformedResponse(_))\n103\t    ));\n104\t    assert_eq!(harness.proposal_ids().len(), 0);\n105\t    assert_eq!(harness.memory_count(), 0);\n106\t    assert_single_failure_kind(&harness, \"malformed_response\");\n107\t}\n108\t\n109\t#[test]\n110\tfn test_llm_synchronous_mode_is_forbidden_and_driver_never_called() {\n111\t    let mut harness = ConsolidationHarness::new();\n112\t    harness.driver.push_ok(episode_response());\n113\t    let slice = harness.task_slice(\"task-llm-sync-guard\");\n114\t\n115\t    let result = harness.run_episode_job(synchronous_ctx(), &slice);\n116\t\n117\t    assert!(matches!(\n118\t        result,\n119\t        Err(super::llm::LlmJobError::ForbiddenOnHotPath(\n120\t            \"episode_summary\"\n121\t        ))\n122\t    ));\n123\t    assert_eq!(harness.driver.call_count(), 0);\n124\t}\n125\t\n126\t#[test]\n127\tfn test_bounded_queue_overflow_drops_jobs_with_warning_event() {\n128\t    let harness = ConsolidationHarness::new();\n129\t    let logs = Arc::new(Mutex::new(Vec::new()));\n130\t    let subscriber = tracing_subscriber::fmt()\n131\t        .with_writer(BufferWriter(logs.clone()))\n132\t        .with_ansi(false)\n133\t        .finish();\n134\t    let _guard = tracing::subscriber::set_default(subscriber);\n135\t    let mut queue = harness.llm_queue(2);\n136\t\n137\t    let outcomes = (0..5)\n138\t        .map(|index| queue.enqueue_llm(llm_queue_job(index), &harness.event_writer, \"fake-llm\"))\n139\t        .collect::<Result<Vec<_>, _>>()\n140\t        .expect(\"enqueue succeeds\");\n141\t\n142\t    assert_eq!(count_dropped(&outcomes), 3);\n143\t    assert_failure_count(&harness, \"queue_full\", 3);\n144\t    assert!(String::from_utf8(logs.lock().unwrap().clone())\n145\t        .expect(\"logs are utf8\")\n146\t        .contains(\"LLM consolidation queue slice full; dropping job\"));\n147\t}\n148\t\n149\t#[test]\n150\tfn test_high_scope_proposal_routes_to_manual_review_queue() {\n151\t    let harness = ConsolidationHarness::new();\n152\t    let memory_id = harness.seed_memory(\n153\t        \"mem-repo-review\",\n154\t        \"Repo memory\",\n155\t        MemoryScope::Repo,\n156\t        1,\n157\t        vec![\"src/repo.rs\"],\n158\t        vec![\"repoFact\"],\n159\t    );\n160\t    let proposal_id = harness.execute_ready(repo_scope_update_job(&memory_id));\n161\t    let pending = harness.pending_repo_review_items();\n162\t\n163\t    assert_eq!(\n164\t        harness.proposal_decision(&proposal_id),\n165\t        ProposalDecision::Pending\n166\t    );\n167\t    assert_eq!(harness.memory_count(), 1);\n168\t    assert_eq!(pending.len(), 1);\n169\t    assert_eq!(pending[0].proposal_id, proposal_id);\n170\t}\n171\t\n172\t#[test]\n173\tfn test_replay_from_genesis_reconstructs_memory_state() {\n174\t    let harness = ConsolidationHarness::new();\n175\t    let cache = harness.apply_replay_mix();\n176\t    let expected_hash = harness.store_hash();\n177\t    let driver = CountingDriver::default();\n178\t\n179\t    harness.clear_memory_tables();\n180\t    harness\n181\t        .replay_driver_with_cache(cache, &driver)\n182\t        .replay(ReplayMode::FromGenesis)\n183\t        .expect(\"replay succeeds\");\n184\t\n185\t    assert_eq!(harness.store_hash(), expected_hash);\n186\t    assert_eq!(driver.call_count(), 0);\n187\t}\n188\t\n189\tfn expect_session_proposal(outcome: SessionConsolidationOutcome) -> String {\n190\t    match outcome {\n191\t        SessionConsolidationOutcome::Proposed { proposal_id, .. } => proposal_id,\n192\t        other => panic!(\"expected proposal outcome, got {other:?}\"),\n193\t    }\n194\t}\n195\t\n196\tfn assert_pending_create_memory(harness: &ConsolidationHarness, proposal_id: &str) {\n197\t    let proposal = harness.load_proposal(proposal_id);\n198\t    let record = harness.proposal_record(proposal_id);\n199\t    assert_eq!(proposal.proposal_kind, ProposalKind::CreateMemory);\n200\t    assert_eq!(record.decision, ProposalDecision::Pending);\n201\t}\n202\t\n203\tfn assert_superseded_state(harness: &ConsolidationHarness, older_id: &str, newer_id: &str) {\n204\t    let fields = harness.structured_fields(older_id);\n205\t    assert_eq!(\n206\t        fields.verification_status,\n207\t        MemoryVerificationStatus::Superseded\n208\t    );\n209\t    assert_eq!(fields.superseded_by_memory_id.as_deref(), Some(newer_id));\n210\t    assert_eq!(harness.memory_links_from(older_id).len(), 1);\n211\t}\n212\t\n213\tfn assert_restored_state(harness: &ConsolidationHarness, older_id: &str) {\n214\t    let fields = harness.structured_fields(older_id);\n215\t    assert_eq!(\n216\t        fields.verification_status,\n217\t        MemoryVerificationStatus::Verified\n218\t    );\n219\t    assert!(fields.superseded_by_memory_id.is_none());\n220\t    assert!(harness.memory_links_from(older_id).is_empty());\n221\t}\n222\t\n223\tfn assert_single_failure_kind(harness: &ConsolidationHarness, error_kind: &str) {\n224\t    assert_failure_count(harness, error_kind, 1);\n225\t    assert_eq!(harness.failure_events().len(), 1);\n226\t}\n227\t\n228\tfn assert_failure_count(harness: &ConsolidationHarness, error_kind: &str, expected: usize) {\n229\t    let actual = harness\n230\t        .failure_events()\n231\t        .into_iter()\n232\t        .filter_map(|event| match event.payload {\n233\t            EventPayload::ConsolidationFailed(payload) => Some(payload.error_kind),\n234\t            _ => None,\n235\t        })\n236\t        .filter(|kind| kind == error_kind)\n237\t        .count();\n238\t    assert_eq!(actual, expected);\n239\t}\n240\t\n241\tfn count_dropped(outcomes: &[EnqueueOutcome]) -> usize {\n242\t    outcomes\n243\t        .iter()\n244\t        .filter(|outcome| matches!(outcome, EnqueueOutcome::Dropped { .. }))\n245\t        .count()\n246\t}\n247\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"a4e3f1e0-1ec4-40c2-9abd-359a26cd8234","timestamp":"2026-05-17T11:41:48.086Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/integration_tests.rs","content":"//! Phase 6 consolidation integration tests.\n//!\n//! Spec invariants from `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 6. Consolidation Engine`, `## Phase 6: Consolidation Engine`, and\n//! `## Testing Requirements`:\n//!\n//! - \"consolidation is auditable, reversible, and test-covered\"\n//! - \"Every background consolidation pass is recoverable, replayable, and observable.\"\n//! - \"failed or malformed LLM responses must leave the prior memory state unchanged and emit a consolidation failure event\"\n//! - \"consolidation queue depth must be bounded; when the queue is full, new jobs are dropped with a log warning rather than stalling the daemon\"\n\nuse std::sync::{Arc, Mutex};\n\nuse super::integration_test_support::*;\nuse super::*;\nuse crate::events::EventPayload;\nuse crate::memory::{MemoryScope, MemoryVerificationStatus};\n\n#[test]\nfn test_synchronous_session_consolidation_emits_proposal_not_silent_write() {\n    let harness = ConsolidationHarness::new();\n    harness.append_small_task(\"task-sync\");\n    let outcome = harness\n        .session_consolidator()\n        .on_task_complete(\n            \"workspace-main\",\n            &task_id(\"task-sync\"),\n            EpisodeOutcome::Success,\n        )\n        .expect(\"session consolidation succeeds\");\n    let proposal_id = expect_session_proposal(outcome);\n\n    assert_pending_create_memory(&harness, &proposal_id);\n    assert_eq!(harness.memory_count(), 0);\n    harness.apply_proposal(&proposal_id);\n    assert_eq!(harness.memory_count(), 1);\n    assert_eq!(harness.consolidated_events().len(), 1);\n}\n\n#[test]\nfn test_deterministic_supersession_proposal_apply_then_reject_round_trip() {\n    let harness = ConsolidationHarness::new();\n    let older_id = harness.seed_memory(\n        \"mem-older\",\n        \"Duplicate login memory\",\n        MemoryScope::Repo,\n        10,\n        vec![\"src/auth.ts\"],\n        Vec::new(),\n    );\n    let newer_id = harness.seed_memory(\n        \"mem-newer\",\n        \"Duplicate login memory\",\n        MemoryScope::Repo,\n        20,\n        vec![\"src/auth.ts\"],\n        Vec::new(),\n    );\n    let proposal_id = harness.run_supersession_scan();\n\n    harness.apply_proposal(&proposal_id);\n    assert_superseded_state(&harness, &older_id, &newer_id);\n    assert_eq!(\n        harness.reverse_proposal(&proposal_id),\n        ReverseOutcome::Reverted {\n            memory_id: older_id.clone(),\n        }\n    );\n    assert_restored_state(&harness, &older_id);\n}\n\n#[test]\nfn test_llm_episode_job_well_formed_response_emits_proposal_with_provenance() {\n    let mut harness = ConsolidationHarness::new();\n    harness.driver.push_ok(episode_response());\n    let slice = harness.task_slice(\"task-llm-provenance\");\n    let proposal = harness\n        .run_episode_job(background_ctx(), &slice)\n        .expect(\"episode job succeeds\")\n        .expect(\"proposal emitted\");\n    let request = harness.driver.last_request().expect(\"request recorded\");\n    let provenance = proposal.provenance.expect(\"provenance recorded\");\n\n    assert_eq!(provenance.model, \"fake-llm\");\n    assert_eq!(provenance.prompt_sha256, sha256(request.prompt.as_bytes()));\n    assert_eq!(\n        provenance.response_sha256,\n        sha256(episode_response().as_bytes())\n    );\n}\n\n#[test]\nfn test_llm_malformed_response_leaves_memory_unchanged_and_emits_failure_event() {\n    let mut harness = ConsolidationHarness::new();\n    harness.driver.push_ok(\"{not json\".to_string());\n    let slice = harness.task_slice(\"task-llm-malformed\");\n\n    let result = harness.run_episode_job(background_ctx(), &slice);\n\n    assert!(matches!(\n        result,\n        Err(super::llm::LlmJobError::MalformedResponse(_))\n    ));\n    assert_eq!(harness.proposal_ids().len(), 0);\n    assert_eq!(harness.memory_count(), 0);\n    assert_single_failure_kind(&harness, \"malformed_response\");\n}\n\n#[test]\nfn test_llm_synchronous_mode_is_forbidden_and_driver_never_called() {\n    let mut harness = ConsolidationHarness::new();\n    harness.driver.push_ok(episode_response());\n    let slice = harness.task_slice(\"task-llm-sync-guard\");\n\n    let result = harness.run_episode_job(synchronous_ctx(), &slice);\n\n    assert!(matches!(\n        result,\n        Err(super::llm::LlmJobError::ForbiddenOnHotPath(\n            \"episode_summary\"\n        ))\n    ));\n    assert_eq!(harness.driver.call_count(), 0);\n}\n\n#[test]\nfn test_bounded_queue_overflow_drops_jobs_with_warning_event() {\n    let harness = ConsolidationHarness::new();\n    let logs = Arc::new(Mutex::new(Vec::new()));\n    let subscriber = tracing_subscriber::fmt()\n        .with_writer(BufferWriter(logs.clone()))\n        .with_ansi(false)\n        .finish();\n    let _guard = tracing::subscriber::set_default(subscriber);\n    let mut queue = harness.llm_queue(2);\n\n    let outcomes = (0..5)\n        .map(|index| queue.enqueue_llm(llm_queue_job(index), &harness.event_writer, \"fake-llm\"))\n        .collect::<Result<Vec<_>, _>>()\n        .expect(\"enqueue succeeds\");\n\n    assert_eq!(count_dropped(&outcomes), 3);\n    assert_failure_count(&harness, \"queue_full\", 3);\n    assert!(String::from_utf8(logs.lock().unwrap().clone())\n        .expect(\"logs are utf8\")\n        .contains(\"LLM consolidation queue slice full; dropping job\"));\n}\n\n#[test]\nfn test_high_scope_proposal_routes_to_manual_review_queue() {\n    let harness = ConsolidationHarness::new();\n    let memory_id = harness.seed_memory(\n        \"mem-repo-review\",\n        \"Repo memory\",\n        MemoryScope::Repo,\n        1,\n        vec![\"src/repo.rs\"],\n        vec![\"repoFact\"],\n    );\n    let proposal_id = harness.execute_ready(repo_scope_update_job(&memory_id));\n    let pending = harness.pending_repo_review_items();\n\n    assert_eq!(\n        harness.proposal_decision(&proposal_id),\n        ProposalDecision::Pending\n    );\n    assert_eq!(harness.memory_count(), 1);\n    assert_eq!(pending.len(), 1);\n    assert_eq!(pending[0].proposal_id, proposal_id);\n}\n\n#[test]\nfn test_replay_from_genesis_reconstructs_memory_state() {\n    let harness = ConsolidationHarness::new();\n    let cache = harness.apply_replay_mix();\n    let expected_hash = harness.store_hash();\n    let driver = CountingDriver::default();\n\n    harness.clear_memory_tables();\n    harness\n        .replay_driver_with_cache(cache, &driver)\n        .replay(ReplayMode::FromGenesis)\n        .expect(\"replay succeeds\");\n\n    assert_eq!(harness.store_hash(), expected_hash);\n    assert_eq!(driver.call_count(), 0);\n}\n\nfn expect_session_proposal(outcome: SessionConsolidationOutcome) -> String {\n    match outcome {\n        SessionConsolidationOutcome::Proposed { proposal_id, .. } => proposal_id,\n        other => panic!(\"expected proposal outcome, got {other:?}\"),\n    }\n}\n\nfn assert_pending_create_memory(harness: &ConsolidationHarness, proposal_id: &str) {\n    let proposal = harness.load_proposal(proposal_id);\n    let record = harness.proposal_record(proposal_id);\n    assert_eq!(proposal.proposal_kind, ProposalKind::CreateMemory);\n    assert_eq!(record.decision, ProposalDecision::Pending);\n}\n\nfn assert_superseded_state(harness: &ConsolidationHarness, older_id: &str, newer_id: &str) {\n    let fields = harness.structured_fields(older_id);\n    assert_eq!(\n        fields.verification_status,\n        MemoryVerificationStatus::Superseded\n    );\n    assert_eq!(fields.superseded_by_memory_id.as_deref(), Some(newer_id));\n    assert_eq!(harness.memory_links_from(older_id).len(), 1);\n}\n\nfn assert_restored_state(harness: &ConsolidationHarness, older_id: &str) {\n    let fields = harness.structured_fields(older_id);\n    assert_eq!(\n        fields.verification_status,\n        MemoryVerificationStatus::Verified\n    );\n    assert!(fields.superseded_by_memory_id.is_none());\n    assert!(harness.memory_links_from(older_id).is_empty());\n}\n\nfn assert_single_failure_kind(harness: &ConsolidationHarness, error_kind: &str) {\n    assert_failure_count(harness, error_kind, 1);\n    assert_eq!(harness.failure_events().len(), 1);\n}\n\nfn assert_failure_count(harness: &ConsolidationHarness, error_kind: &str, expected: usize) {\n    let actual = harness\n        .failure_events()\n        .into_iter()\n        .filter_map(|event| match event.payload {\n            EventPayload::ConsolidationFailed(payload) => Some(payload.error_kind),\n            _ => None,\n        })\n        .filter(|kind| kind == error_kind)\n        .count();\n    assert_eq!(actual, expected);\n}\n\nfn count_dropped(outcomes: &[EnqueueOutcome]) -> usize {\n    outcomes\n        .iter()\n        .filter(|outcome| matches!(outcome, EnqueueOutcome::Dropped { .. }))\n        .count()\n}\n","numLines":247,"startLine":1,"totalLines":247}}}
