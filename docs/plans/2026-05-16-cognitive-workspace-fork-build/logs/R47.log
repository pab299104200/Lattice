{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q5zACPZbBaSURUjyA5YbTJ","type":"tool_result","content":"1\tuse std::sync::{Arc, Mutex};\n2\tuse std::time::Duration;\n3\t\n4\tuse rusqlite::Connection;\n5\tuse sha2::{Digest, Sha256};\n6\t\n7\tuse super::*;\n8\tuse crate::consolidation::{\n9\t    initialize_schema, BoundedJobQueue, ConsolidationJobMode, ConsolidationJobSpec, EnqueueOutcome,\n10\t};\n11\tuse crate::events::{EventKind, EventQuery, EventReader, EventStore, EventWriter, QueryOrder};\n12\t\n13\t#[test]\n14\tfn successful_job_provenance_records_deterministic_hashes() {\n15\t    let prompt = b\"Summarize this task\";\n16\t    let response = br#\"{\"summary\":\"done\"}\"#;\n17\t    let provenance = LlmProvenance::record(\n18\t        \"test-model\",\n19\t        prompt,\n20\t        response,\n21\t        3,\n22\t        2,\n23\t        Duration::from_millis(42),\n24\t    )\n25\t    .expect(\"provenance records\");\n26\t\n27\t    assert_eq!(provenance.model, \"test-model\");\n28\t    assert_eq!(provenance.prompt_sha256, sha256(prompt));\n29\t    assert_eq!(provenance.response_sha256, sha256(response));\n30\t    assert_eq!(provenance.prompt_token_count, 3);\n31\t    assert_eq!(provenance.response_token_count, 2);\n32\t    assert_eq!(provenance.latency_ms, 42);\n33\t}\n34\t\n35\t#[test]\n36\tfn identical_prompt_and_response_reproduce_hashes() {\n37\t    let first = LlmProvenance::record(\n38\t        \"test-model\",\n39\t        b\"same prompt\",\n40\t        b\"same response\",\n41\t        2,\n42\t        2,\n43\t        Duration::from_millis(7),\n44\t    )\n45\t    .expect(\"first provenance\");\n46\t    let second = LlmProvenance::record(\n47\t        \"test-model\",\n48\t        b\"same prompt\",\n49\t        b\"same response\",\n50\t        2,\n51\t        2,\n52\t        Duration::from_millis(7),\n53\t    )\n54\t    .expect(\"second provenance\");\n55\t\n56\t    assert_eq!(first.prompt_sha256, second.prompt_sha256);\n57\t    assert_eq!(first.response_sha256, second.response_sha256);\n58\t}\n59\t\n60\t#[test]\n61\tfn budget_overruns_route_to_required_outcomes() {\n62\t    let catalog = BudgetCatalog::default();\n63\t\n64\t    assert_eq!(\n65\t        catalog.evaluate(ConsolidationJobKind::EpisodeSummary, over_budget_usage()),\n66\t        BudgetOutcome::ExceededFallback(DeterministicFallback::EpisodeTemplate)\n67\t    );\n68\t    assert_eq!(\n69\t        catalog.evaluate(\n70\t            ConsolidationJobKind::ContradictionDetection,\n71\t            over_budget_usage()\n72\t        ),\n73\t        BudgetOutcome::ExceededFallback(DeterministicFallback::ContradictionSupersessionCandidate)\n74\t    );\n75\t    assert_eq!(\n76\t        catalog.evaluate(\n77\t            ConsolidationJobKind::ProcedureExtraction,\n78\t            over_budget_usage()\n79\t        ),\n80\t        BudgetOutcome::ExceededSkipWithStale\n81\t    );\n82\t    assert_eq!(\n83\t        catalog.evaluate(\n84\t            ConsolidationJobKind::FailurePatternExtraction,\n85\t            over_budget_usage()\n86\t        ),\n87\t        BudgetOutcome::ExceededSkipWithStale\n88\t    );\n89\t}\n90\t\n91\t#[test]\n92\tfn per_kind_queue_overflow_drops_job_and_emits_failure_event() {\n93\t    let conn = Connection::open_in_memory().expect(\"db opens\");\n94\t    initialize_schema(&conn).expect(\"schema initializes\");\n95\t    let conn = Arc::new(Mutex::new(conn));\n96\t    let mut queue = BoundedJobQueue::new(10, conn).with_per_kind_max_depth(1);\n97\t    let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n98\t    let event_writer = EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096);\n99\t\n100\t    let first = queue\n101\t        .enqueue_llm(job(\"job-a\"), &event_writer, \"test-model\")\n102\t        .expect(\"first job queues\");\n103\t    let second = queue\n104\t        .enqueue_llm(job(\"job-b\"), &event_writer, \"test-model\")\n105\t        .expect(\"second job drops\");\n106\t\n107\t    assert!(matches!(first, EnqueueOutcome::Queued { depth: 1 }));\n108\t    assert!(matches!(second, EnqueueOutcome::Dropped { .. }));\n109\t    let events = EventQuery::new()\n110\t        .workspace(\"workspace-main\")\n111\t        .branch(\"main\")\n112\t        .kind(EventKind::ConsolidationFailed)\n113\t        .order(QueryOrder::OldestFirst)\n114\t        .execute(&EventReader::new(event_store))\n115\t        .expect(\"failure event queries\");\n116\t    assert_eq!(events.len(), 1);\n117\t    match &events[0].payload {\n118\t        crate::events::EventPayload::ConsolidationFailed(payload) => {\n119\t            assert_eq!(payload.error_kind, \"queue_full\");\n120\t            assert_eq!(payload.job_kind, \"episode_summary\");\n121\t        }\n122\t        payload => panic!(\"unexpected payload {payload:?}\"),\n123\t    }\n124\t}\n125\t\n126\t#[test]\n127\tfn budget_architecture_doc_contains_required_headings() {\n128\t    let doc =\n129\t        include_str!(\"../../../../../../docs/architecture/2026-05-16-consolidation-llm-budgets.md\");\n130\t    for heading in [\n131\t        \"## Scope\",\n132\t        \"## Per-job budgets\",\n133\t        \"## Bounded queue depth\",\n134\t        \"## Failure handling\",\n135\t        \"## Provenance record\",\n136\t        \"## Operator overrides\",\n137\t        \"## Spec citation\",\n138\t    ] {\n139\t        assert!(doc.contains(heading), \"missing heading {heading}\");\n140\t    }\n141\t}\n142\t\n143\tfn sha256(bytes: &[u8]) -> [u8; 32] {\n144\t    let digest = Sha256::digest(bytes);\n145\t    let mut hash = [0_u8; 32];\n146\t    hash.copy_from_slice(&digest);\n147\t    hash\n148\t}\n149\t\n150\tfn over_budget_usage() -> BudgetUsage {\n151\t    BudgetUsage {\n152\t        prompt_tokens: u32::MAX,\n153\t        response_tokens: 0,\n154\t        latency_ms: 0,\n155\t        cost_micro_usd: 0,\n156\t    }\n157\t}\n158\t\n159\tfn job(job_id: &str) -> ConsolidationJobSpec {\n160\t    ConsolidationJobSpec {\n161\t        job_id: job_id.to_string(),\n162\t        workspace_id: \"workspace-main\".to_string(),\n163\t        kind: ConsolidationJobKind::EpisodeSummary.as_str().to_string(),\n164\t        mode: ConsolidationJobMode::Background,\n165\t        proposal: None,\n166\t    }\n167\t}\n168\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"68a72bbf-2e00-4c5d-b70b-caa003ab7667","timestamp":"2026-05-17T11:42:35.971Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/llm/provenance_tests.rs","content":"use std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse rusqlite::Connection;\nuse sha2::{Digest, Sha256};\n\nuse super::*;\nuse crate::consolidation::{\n    initialize_schema, BoundedJobQueue, ConsolidationJobMode, ConsolidationJobSpec, EnqueueOutcome,\n};\nuse crate::events::{EventKind, EventQuery, EventReader, EventStore, EventWriter, QueryOrder};\n\n#[test]\nfn successful_job_provenance_records_deterministic_hashes() {\n    let prompt = b\"Summarize this task\";\n    let response = br#\"{\"summary\":\"done\"}\"#;\n    let provenance = LlmProvenance::record(\n        \"test-model\",\n        prompt,\n        response,\n        3,\n        2,\n        Duration::from_millis(42),\n    )\n    .expect(\"provenance records\");\n\n    assert_eq!(provenance.model, \"test-model\");\n    assert_eq!(provenance.prompt_sha256, sha256(prompt));\n    assert_eq!(provenance.response_sha256, sha256(response));\n    assert_eq!(provenance.prompt_token_count, 3);\n    assert_eq!(provenance.response_token_count, 2);\n    assert_eq!(provenance.latency_ms, 42);\n}\n\n#[test]\nfn identical_prompt_and_response_reproduce_hashes() {\n    let first = LlmProvenance::record(\n        \"test-model\",\n        b\"same prompt\",\n        b\"same response\",\n        2,\n        2,\n        Duration::from_millis(7),\n    )\n    .expect(\"first provenance\");\n    let second = LlmProvenance::record(\n        \"test-model\",\n        b\"same prompt\",\n        b\"same response\",\n        2,\n        2,\n        Duration::from_millis(7),\n    )\n    .expect(\"second provenance\");\n\n    assert_eq!(first.prompt_sha256, second.prompt_sha256);\n    assert_eq!(first.response_sha256, second.response_sha256);\n}\n\n#[test]\nfn budget_overruns_route_to_required_outcomes() {\n    let catalog = BudgetCatalog::default();\n\n    assert_eq!(\n        catalog.evaluate(ConsolidationJobKind::EpisodeSummary, over_budget_usage()),\n        BudgetOutcome::ExceededFallback(DeterministicFallback::EpisodeTemplate)\n    );\n    assert_eq!(\n        catalog.evaluate(\n            ConsolidationJobKind::ContradictionDetection,\n            over_budget_usage()\n        ),\n        BudgetOutcome::ExceededFallback(DeterministicFallback::ContradictionSupersessionCandidate)\n    );\n    assert_eq!(\n        catalog.evaluate(\n            ConsolidationJobKind::ProcedureExtraction,\n            over_budget_usage()\n        ),\n        BudgetOutcome::ExceededSkipWithStale\n    );\n    assert_eq!(\n        catalog.evaluate(\n            ConsolidationJobKind::FailurePatternExtraction,\n            over_budget_usage()\n        ),\n        BudgetOutcome::ExceededSkipWithStale\n    );\n}\n\n#[test]\nfn per_kind_queue_overflow_drops_job_and_emits_failure_event() {\n    let conn = Connection::open_in_memory().expect(\"db opens\");\n    initialize_schema(&conn).expect(\"schema initializes\");\n    let conn = Arc::new(Mutex::new(conn));\n    let mut queue = BoundedJobQueue::new(10, conn).with_per_kind_max_depth(1);\n    let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n    let event_writer = EventWriter::new(event_store.clone(), \"workspace-main\".to_string(), 4096);\n\n    let first = queue\n        .enqueue_llm(job(\"job-a\"), &event_writer, \"test-model\")\n        .expect(\"first job queues\");\n    let second = queue\n        .enqueue_llm(job(\"job-b\"), &event_writer, \"test-model\")\n        .expect(\"second job drops\");\n\n    assert!(matches!(first, EnqueueOutcome::Queued { depth: 1 }));\n    assert!(matches!(second, EnqueueOutcome::Dropped { .. }));\n    let events = EventQuery::new()\n        .workspace(\"workspace-main\")\n        .branch(\"main\")\n        .kind(EventKind::ConsolidationFailed)\n        .order(QueryOrder::OldestFirst)\n        .execute(&EventReader::new(event_store))\n        .expect(\"failure event queries\");\n    assert_eq!(events.len(), 1);\n    match &events[0].payload {\n        crate::events::EventPayload::ConsolidationFailed(payload) => {\n            assert_eq!(payload.error_kind, \"queue_full\");\n            assert_eq!(payload.job_kind, \"episode_summary\");\n        }\n        payload => panic!(\"unexpected payload {payload:?}\"),\n    }\n}\n\n#[test]\nfn budget_architecture_doc_contains_required_headings() {\n    let doc =\n        include_str!(\"../../../../../../docs/architecture/2026-05-16-consolidation-llm-budgets.md\");\n    for heading in [\n        \"## Scope\",\n        \"## Per-job budgets\",\n        \"## Bounded queue depth\",\n        \"## Failure handling\",\n        \"## Provenance record\",\n        \"## Operator overrides\",\n        \"## Spec citation\",\n    ] {\n        assert!(doc.contains(heading), \"missing heading {heading}\");\n    }\n}\n\nfn sha256(bytes: &[u8]) -> [u8; 32] {\n    let digest = Sha256::digest(bytes);\n    let mut hash = [0_u8; 32];\n    hash.copy_from_slice(&digest);\n    hash\n}\n\nfn over_budget_usage() -> BudgetUsage {\n    BudgetUsage {\n        prompt_tokens: u32::MAX,\n        response_tokens: 0,\n        latency_ms: 0,\n        cost_micro_usd: 0,\n    }\n}\n\nfn job(job_id: &str) -> ConsolidationJobSpec {\n    ConsolidationJobSpec {\n        job_id: job_id.to_string(),\n        workspace_id: \"workspace-main\".to_string(),\n        kind: ConsolidationJobKind::EpisodeSummary.as_str().to_string(),\n        mode: ConsolidationJobMode::Background,\n        proposal: None,\n    }\n}\n","numLines":168,"startLine":1,"totalLines":168}}}
