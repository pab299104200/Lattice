{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014QrzM4sV9fuKNoDAh8VU1r","type":"tool_result","content":"1\tuse std::path::PathBuf;\n2\tuse std::sync::Arc;\n3\t\n4\tuse rusqlite::{params, Connection};\n5\tuse serde_json::{json, Value};\n6\tuse tempfile::tempdir;\n7\t\n8\tuse super::*;\n9\tuse crate::events::{EventKind, EventPayload, EventQuery, EventReader, EventStore, EventWriter};\n10\tuse crate::identity::OperatorId;\n11\tuse crate::memory::{Memory, MemoryScope, MemoryStore, MemoryType};\n12\t\n13\t#[test]\n14\tfn session_scope_proposal_is_not_gated_and_auto_applies() {\n15\t    let fixture = Fixture::new();\n16\t    let mut runtime = fixture.runtime();\n17\t    runtime.submit(job_for_scope(\"session\")).unwrap();\n18\t\n19\t    let proposals = runtime\n20\t        .execute_ready(\n21\t            &fixture.memory_store,\n22\t            &fixture.event_writer,\n23\t            &fixture.operator(\"auto-policy\"),\n24\t        )\n25\t        .unwrap();\n26\t\n27\t    assert_eq!(proposals.len(), 1);\n28\t    assert_eq!(\n29\t        proposal_decision(&fixture.db_path, \"proposal-session\"),\n30\t        \"applied\"\n31\t    );\n32\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 1);\n33\t}\n34\t\n35\t#[test]\n36\tfn branch_scope_proposal_is_not_gated_and_auto_applies() {\n37\t    let fixture = Fixture::new();\n38\t    let mut runtime = fixture.runtime();\n39\t    runtime.submit(job_for_scope(\"branch\")).unwrap();\n40\t\n41\t    runtime\n42\t        .execute_ready(\n43\t            &fixture.memory_store,\n44\t            &fixture.event_writer,\n45\t            &fixture.operator(\"auto-policy\"),\n46\t        )\n47\t        .unwrap();\n48\t\n49\t    assert_eq!(\n50\t        proposal_decision(&fixture.db_path, \"proposal-branch\"),\n51\t        \"applied\"\n52\t    );\n53\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 1);\n54\t}\n55\t\n56\t#[test]\n57\tfn repo_scope_proposal_is_gated_and_stays_pending() {\n58\t    let fixture = Fixture::new();\n59\t    let mut runtime = fixture.runtime();\n60\t    runtime.submit(job_for_scope(\"repo\")).unwrap();\n61\t\n62\t    runtime\n63\t        .execute_ready(\n64\t            &fixture.memory_store,\n65\t            &fixture.event_writer,\n66\t            &fixture.operator(\"auto-policy\"),\n67\t        )\n68\t        .unwrap();\n69\t\n70\t    assert_eq!(\n71\t        proposal_decision(&fixture.db_path, \"proposal-repo\"),\n72\t        \"pending\"\n73\t    );\n74\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n75\t    let queue = fixture.review_queue();\n76\t    let items = queue\n77\t        .list_pending(\"workspace-main\", &ReviewQueueFilter::default())\n78\t        .unwrap();\n79\t    assert_eq!(items.len(), 1);\n80\t    assert_eq!(items[0].scope, crate::memory_graph::MemoryScope::Repo);\n81\t}\n82\t\n83\t#[test]\n84\tfn organization_scope_proposal_is_gated_and_stays_pending() {\n85\t    let fixture = Fixture::new();\n86\t    let mut runtime = fixture.runtime();\n87\t    runtime.submit(job_for_scope(\"organization\")).unwrap();\n88\t\n89\t    runtime\n90\t        .execute_ready(\n91\t            &fixture.memory_store,\n92\t            &fixture.event_writer,\n93\t            &fixture.operator(\"auto-policy\"),\n94\t        )\n95\t        .unwrap();\n96\t\n97\t    assert_eq!(\n98\t        proposal_decision(&fixture.db_path, \"proposal-organization\"),\n99\t        \"pending\"\n100\t    );\n101\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n102\t}\n103\t\n104\t#[test]\n105\tfn decide_apply_routes_through_proposal_apply_and_records_operator() {\n106\t    let fixture = Fixture::new();\n107\t    let mut runtime = fixture.runtime();\n108\t    runtime.submit(job_for_scope(\"repo\")).unwrap();\n109\t    runtime\n110\t        .execute_ready(\n111\t            &fixture.memory_store,\n112\t            &fixture.event_writer,\n113\t            &fixture.operator(\"auto-policy\"),\n114\t        )\n115\t        .unwrap();\n116\t    let queue = fixture.review_queue();\n117\t\n118\t    let outcome = queue\n119\t        .decide(\n120\t            \"proposal-repo\",\n121\t            ProposalDecision::Applied,\n122\t            &fixture.operator(\"reviewer-1\"),\n123\t            Some(\"promote durable fact\".to_string()),\n124\t        )\n125\t        .unwrap();\n126\t\n127\t    match outcome {\n128\t        ReviewDecisionOutcome::Applied { outcome } => {\n129\t            assert_eq!(\n130\t                outcome,\n131\t                ApplyOutcome::Applied {\n132\t                    memory_id: \"mem-proposal-repo\".to_string()\n133\t                }\n134\t            );\n135\t        }\n136\t        other => panic!(\"unexpected outcome: {other:?}\"),\n137\t    }\n138\t    assert_eq!(\n139\t        proposal_decision(&fixture.db_path, \"proposal-repo\"),\n140\t        \"applied\"\n141\t    );\n142\t    assert_eq!(\n143\t        proposal_decision_reason(&fixture.db_path, \"proposal-repo\").as_deref(),\n144\t        Some(\"promote durable fact\")\n145\t    );\n146\t    let event = fixture.memory_consolidated_event();\n147\t    match event.payload {\n148\t        EventPayload::MemoryConsolidated(payload) => {\n149\t            assert_eq!(payload.decided_by.as_deref(), Some(\"reviewer-1\"));\n150\t            assert_eq!(\n151\t                payload.decision_reason.as_deref(),\n152\t                Some(\"promote durable fact\")\n153\t            );\n154\t            assert_eq!(payload.proposal_id.as_deref(), Some(\"proposal-repo\"));\n155\t        }\n156\t        _ => panic!(\"expected memory_consolidated\"),\n157\t    }\n158\t}\n159\t\n160\t#[test]\n161\tfn decide_reject_leaves_memory_unchanged_and_records_rejection() {\n162\t    let fixture = Fixture::new();\n163\t    let mut runtime = fixture.runtime();\n164\t    runtime.submit(job_for_scope(\"repo\")).unwrap();\n165\t    runtime\n166\t        .execute_ready(\n167\t            &fixture.memory_store,\n168\t            &fixture.event_writer,\n169\t            &fixture.operator(\"auto-policy\"),\n170\t        )\n171\t        .unwrap();\n172\t    let queue = fixture.review_queue();\n173\t\n174\t    let outcome = queue\n175\t        .decide(\n176\t            \"proposal-repo\",\n177\t            ProposalDecision::Rejected,\n178\t            &fixture.operator(\"reviewer-2\"),\n179\t            Some(\"insufficient evidence\".to_string()),\n180\t        )\n181\t        .unwrap();\n182\t\n183\t    match outcome {\n184\t        ReviewDecisionOutcome::Rejected { outcome } => {\n185\t            assert_eq!(outcome, RejectOutcome::Rejected);\n186\t        }\n187\t        other => panic!(\"unexpected outcome: {other:?}\"),\n188\t    }\n189\t    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n190\t    assert_eq!(\n191\t        proposal_decision(&fixture.db_path, \"proposal-repo\"),\n192\t        \"rejected\"\n193\t    );\n194\t    assert_eq!(\n195\t        proposal_decision_reason(&fixture.db_path, \"proposal-repo\").as_deref(),\n196\t        Some(\"insufficient evidence\")\n197\t    );\n198\t}\n199\t\n200\t#[test]\n201\tfn list_pending_returns_oldest_first_and_honors_filters() {\n202\t    let fixture = Fixture::new();\n203\t    let mut runtime = fixture.runtime();\n204\t    runtime.submit(job_for_scope(\"repo\")).unwrap();\n205\t    runtime.submit(job_for_scope(\"organization\")).unwrap();\n206\t    runtime\n207\t        .execute_ready(\n208\t            &fixture.memory_store,\n209\t            &fixture.event_writer,\n210\t            &fixture.operator(\"auto-policy\"),\n211\t        )\n212\t        .unwrap();\n213\t    fixture.set_enqueued_at(\"job-repo\", 10);\n214\t    fixture.set_enqueued_at(\"job-organization\", 20);\n215\t\n216\t    let queue = fixture.review_queue();\n217\t    let items = queue\n218\t        .list_pending(\"workspace-main\", &ReviewQueueFilter::default())\n219\t        .unwrap();\n220\t    assert_eq!(items.len(), 2);\n221\t    assert_eq!(items[0].proposal_id, \"proposal-repo\");\n222\t    assert_eq!(items[1].proposal_id, \"proposal-organization\");\n223\t\n224\t    let repo_only = queue\n225\t        .list_pending(\n226\t            \"workspace-main\",\n227\t            &ReviewQueueFilter {\n228\t                scope: Some(crate::memory_graph::MemoryScope::Repo),\n229\t                ..ReviewQueueFilter::default()\n230\t            },\n231\t        )\n232\t        .unwrap();\n233\t    assert_eq!(repo_only.len(), 1);\n234\t    assert_eq!(repo_only[0].proposal_id, \"proposal-repo\");\n235\t\n236\t    let older_only = queue\n237\t        .list_pending(\n238\t            \"workspace-main\",\n239\t            &ReviewQueueFilter {\n240\t                older_than: Some(10),\n241\t                ..ReviewQueueFilter::default()\n242\t            },\n243\t        )\n244\t        .unwrap();\n245\t    assert_eq!(older_only.len(), 1);\n246\t    assert_eq!(older_only[0].proposal_id, \"proposal-repo\");\n247\t}\n248\t\n249\t#[test]\n250\tfn second_decision_is_idempotent() {\n251\t    let fixture = Fixture::new();\n252\t    let mut runtime = fixture.runtime();\n253\t    runtime.submit(job_for_scope(\"repo\")).unwrap();\n254\t    runtime\n255\t        .execute_ready(\n256\t            &fixture.memory_store,\n257\t            &fixture.event_writer,\n258\t            &fixture.operator(\"auto-policy\"),\n259\t        )\n260\t        .unwrap();\n261\t    let queue = fixture.review_queue();\n262\t    queue\n263\t        .decide(\n264\t            \"proposal-repo\",\n265\t            ProposalDecision::Applied,\n266\t            &fixture.operator(\"reviewer-1\"),\n267\t            Some(\"accept\".to_string()),\n268\t        )\n269\t        .unwrap();\n270\t\n271\t    let second = queue\n272\t        .decide(\n273\t            \"proposal-repo\",\n274\t            ProposalDecision::Applied,\n275\t            &fixture.operator(\"reviewer-1\"),\n276\t            Some(\"duplicate\".to_string()),\n277\t        )\n278\t        .unwrap();\n279\t\n280\t    assert_eq!(\n281\t        second,\n282\t        ReviewDecisionOutcome::AlreadyDecided {\n283\t            decision: ProposalDecision::Applied\n284\t        }\n285\t    );\n286\t}\n287\t\n288\t#[test]\n289\tfn decision_reason_column_round_trips() {\n290\t    let fixture = Fixture::new();\n291\t    let conn = Connection::open(&fixture.db_path).unwrap();\n292\t    initialize_schema(&conn).unwrap();\n293\t    let exists: i64 = conn\n294\t        .query_row(\n295\t            \"SELECT COUNT(*) FROM pragma_table_info('consolidation_proposals') WHERE name = 'decision_reason'\",\n296\t            [],\n297\t            |row| row.get(0),\n298\t        )\n299\t        .unwrap();\n300\t    assert_eq!(exists, 1);\n301\t\n302\t    conn.execute(\n303\t        \"INSERT INTO consolidation_jobs\n304\t            (job_id, workspace_id, kind, mode, status, enqueued_at)\n305\t         VALUES ('job-schema', 'workspace-main', 'schema', 'manual_review', 'proposed', 1)\",\n306\t        [],\n307\t    )\n308\t    .unwrap();\n309\t    conn.execute(\n310\t        \"INSERT INTO consolidation_proposals\n311\t            (proposal_id, job_id, target_memory_id, proposal_kind, prior_state, proposed_state,\n312\t             evidence, provenance_json, decision, decided_by, decision_reason)\n313\t         VALUES (?1, ?2, NULL, ?3, ?4, ?5, ?6, NULL, 'rejected', 'reviewer', 'schema-check')\",\n314\t        params![\n315\t            \"proposal-schema\",\n316\t            \"job-schema\",\n317\t            ProposalKind::CreateMemory.as_str(),\n318\t            \"{}\",\n319\t            \"{\\\"scope\\\":\\\"repo\\\"}\",\n320\t            \"{}\"\n321\t        ],\n322\t    )\n323\t    .unwrap();\n324\t\n325\t    let record = ConsolidationProposal::load_record(&conn, \"proposal-schema\")\n326\t        .unwrap()\n327\t        .unwrap();\n328\t    assert_eq!(record.decision_reason.as_deref(), Some(\"schema-check\"));\n329\t}\n330\t\n331\tstruct Fixture {\n332\t    _dir: tempfile::TempDir,\n333\t    db_path: PathBuf,\n334\t    memory_store: MemoryStore,\n335\t    event_store: Arc<EventStore>,\n336\t    event_writer: EventWriter,\n337\t}\n338\t\n339\timpl Fixture {\n340\t    fn new() -> Self {\n341\t        let dir = tempdir().unwrap();\n342\t        let db_path = dir.path().join(\"consolidation.sqlite\");\n343\t        let event_store = Arc::new(EventStore::open_in_memory().unwrap());\n344\t        Self {\n345\t            memory_store: MemoryStore::open(&dir.path().join(\"memory.sqlite\")).unwrap(),\n346\t            event_store: event_store.clone(),\n347\t            event_writer: EventWriter::new(event_store, \"workspace-main\".to_string(), 4096),\n348\t            db_path,\n349\t            _dir: dir,\n350\t        }\n351\t    }\n352\t\n353\t    fn runtime(&self) -> ConsolidationJobRuntime {\n354\t        ConsolidationJobRuntime::new(\n355\t            Connection::open(&self.db_path).unwrap(),\n356\t            ConsolidationConfig::default(),\n357\t        )\n358\t        .unwrap()\n359\t    }\n360\t\n361\t    fn review_queue(&self) -> ReviewQueue<'_> {\n362\t        let conn = Box::leak(Box::new(Connection::open(&self.db_path).unwrap()));\n363\t        ReviewQueue::new(conn, &self.memory_store, &self.event_writer)\n364\t    }\n365\t\n366\t    fn operator(&self, value: &str) -> OperatorId {\n367\t        OperatorId {\n368\t            value: value.to_string(),\n369\t        }\n370\t    }\n371\t\n372\t    fn set_enqueued_at(&self, job_id: &str, enqueued_at: i64) {\n373\t        let conn = Connection::open(&self.db_path).unwrap();\n374\t        conn.execute(\n375\t            \"UPDATE consolidation_jobs SET enqueued_at = ?1 WHERE job_id = ?2\",\n376\t            params![enqueued_at, job_id],\n377\t        )\n378\t        .unwrap();\n379\t    }\n380\t\n381\t    fn memory_consolidated_event(&self) -> crate::events::EventEnvelope {\n382\t        let reader = EventReader::new(self.event_store.clone());\n383\t        EventQuery::new()\n384\t            .workspace(\"workspace-main\")\n385\t            .branch(\"main\")\n386\t            .kind(EventKind::MemoryConsolidated)\n387\t            .execute(&reader)\n388\t            .unwrap()\n389\t            .into_iter()\n390\t            .next()\n391\t            .unwrap()\n392\t    }\n393\t}\n394\t\n395\tfn job_for_scope(scope: &str) -> ConsolidationJobSpec {\n396\t    ConsolidationJobSpec {\n397\t        job_id: format!(\"job-{scope}\"),\n398\t        workspace_id: \"workspace-main\".to_string(),\n399\t        kind: format!(\"scope-{scope}\"),\n400\t        mode: ConsolidationJobMode::ManualReview,\n401\t        proposal: Some(PendingProposalSpec {\n402\t            proposal_id: format!(\"proposal-{scope}\"),\n403\t            target_memory_id: None,\n404\t            proposal_kind: ProposalKind::CreateMemory,\n405\t            prior_state: json!({}),\n406\t            proposed_state: proposal_state_for_scope(scope),\n407\t            evidence: json!({\"source_memory_ids\":[]}),\n408\t            provenance: None,\n409\t        }),\n410\t    }\n411\t}\n412\t\n413\tfn proposal_state_for_scope(scope: &str) -> Value {\n414\t    match scope {\n415\t        \"organization\" => json!({\n416\t            \"scope\": \"organization\",\n417\t            \"memory\": { \"scope\": \"organization\" }\n418\t        }),\n419\t        _ => {\n420\t            let legacy_scope = match scope {\n421\t                \"session\" => MemoryScope::Session,\n422\t                \"branch\" => MemoryScope::Branch,\n423\t                \"repo\" => MemoryScope::Repo,\n424\t                other => panic!(\"unsupported scope: {other}\"),\n425\t            };\n426\t            let mut value = serde_json::to_value(ConsolidationMemoryState {\n427\t                memory: Memory {\n428\t                    id: format!(\"mem-proposal-{scope}\"),\n429\t                    session_id: \"session-main\".to_string(),\n430\t                    content: format!(\"{scope} memory\"),\n431\t                    memory_type: MemoryType::Observation,\n432\t                    scope: legacy_scope,\n433\t                    confidence: 0.9,\n434\t                    linked_symbols: Vec::new(),\n435\t                    linked_files: Vec::new(),\n436\t                    workspace_id: Some(\"workspace-main\".to_string()),\n437\t                    branch: Some(\"main\".to_string()),\n438\t                    refresh_key: Some(format!(\"refresh-{scope}\")),\n439\t                    source_query: Some(\"review queue test\".to_string()),\n440\t                    created_at: 1,\n441\t                    last_accessed: 1,\n442\t                    access_count: 0,\n443\t                    is_stale: false,\n444\t                    stale_reason: None,\n445\t                },\n446\t                structured_fields: crate::memory::MemoryStructuredFields::default(),\n447\t                last_verified_at: None,\n448\t                memory_links: Vec::new(),\n449\t            })\n450\t            .unwrap();\n451\t            value[\"scope\"] = Value::String(scope.to_string());\n452\t            value\n453\t        }\n454\t    }\n455\t}\n456\t\n457\tfn proposal_decision(path: &PathBuf, proposal_id: &str) -> String {\n458\t    let conn = Connection::open(path).unwrap();\n459\t    conn.query_row(\n460\t        \"SELECT decision FROM consolidation_proposals WHERE proposal_id = ?1\",\n461\t        params![proposal_id],\n462\t        |row| row.get(0),\n463\t    )\n464\t    .unwrap()\n465\t}\n466\t\n467\tfn proposal_decision_reason(path: &PathBuf, proposal_id: &str) -> Option<String> {\n468\t    let conn = Connection::open(path).unwrap();\n469\t    conn.query_row(\n470\t        \"SELECT decision_reason FROM consolidation_proposals WHERE proposal_id = ?1\",\n471\t        params![proposal_id],\n472\t        |row| row.get(0),\n473\t    )\n474\t    .unwrap()\n475\t}\n476\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"b0902dca-b28a-4ad5-b2e4-b64802da8193","timestamp":"2026-05-17T11:43:19.837Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/review_queue_tests.rs","content":"use std::path::PathBuf;\nuse std::sync::Arc;\n\nuse rusqlite::{params, Connection};\nuse serde_json::{json, Value};\nuse tempfile::tempdir;\n\nuse super::*;\nuse crate::events::{EventKind, EventPayload, EventQuery, EventReader, EventStore, EventWriter};\nuse crate::identity::OperatorId;\nuse crate::memory::{Memory, MemoryScope, MemoryStore, MemoryType};\n\n#[test]\nfn session_scope_proposal_is_not_gated_and_auto_applies() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime();\n    runtime.submit(job_for_scope(\"session\")).unwrap();\n\n    let proposals = runtime\n        .execute_ready(\n            &fixture.memory_store,\n            &fixture.event_writer,\n            &fixture.operator(\"auto-policy\"),\n        )\n        .unwrap();\n\n    assert_eq!(proposals.len(), 1);\n    assert_eq!(\n        proposal_decision(&fixture.db_path, \"proposal-session\"),\n        \"applied\"\n    );\n    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 1);\n}\n\n#[test]\nfn branch_scope_proposal_is_not_gated_and_auto_applies() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime();\n    runtime.submit(job_for_scope(\"branch\")).unwrap();\n\n    runtime\n        .execute_ready(\n            &fixture.memory_store,\n            &fixture.event_writer,\n            &fixture.operator(\"auto-policy\"),\n        )\n        .unwrap();\n\n    assert_eq!(\n        proposal_decision(&fixture.db_path, \"proposal-branch\"),\n        \"applied\"\n    );\n    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 1);\n}\n\n#[test]\nfn repo_scope_proposal_is_gated_and_stays_pending() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime();\n    runtime.submit(job_for_scope(\"repo\")).unwrap();\n\n    runtime\n        .execute_ready(\n            &fixture.memory_store,\n            &fixture.event_writer,\n            &fixture.operator(\"auto-policy\"),\n        )\n        .unwrap();\n\n    assert_eq!(\n        proposal_decision(&fixture.db_path, \"proposal-repo\"),\n        \"pending\"\n    );\n    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n    let queue = fixture.review_queue();\n    let items = queue\n        .list_pending(\"workspace-main\", &ReviewQueueFilter::default())\n        .unwrap();\n    assert_eq!(items.len(), 1);\n    assert_eq!(items[0].scope, crate::memory_graph::MemoryScope::Repo);\n}\n\n#[test]\nfn organization_scope_proposal_is_gated_and_stays_pending() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime();\n    runtime.submit(job_for_scope(\"organization\")).unwrap();\n\n    runtime\n        .execute_ready(\n            &fixture.memory_store,\n            &fixture.event_writer,\n            &fixture.operator(\"auto-policy\"),\n        )\n        .unwrap();\n\n    assert_eq!(\n        proposal_decision(&fixture.db_path, \"proposal-organization\"),\n        \"pending\"\n    );\n    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n}\n\n#[test]\nfn decide_apply_routes_through_proposal_apply_and_records_operator() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime();\n    runtime.submit(job_for_scope(\"repo\")).unwrap();\n    runtime\n        .execute_ready(\n            &fixture.memory_store,\n            &fixture.event_writer,\n            &fixture.operator(\"auto-policy\"),\n        )\n        .unwrap();\n    let queue = fixture.review_queue();\n\n    let outcome = queue\n        .decide(\n            \"proposal-repo\",\n            ProposalDecision::Applied,\n            &fixture.operator(\"reviewer-1\"),\n            Some(\"promote durable fact\".to_string()),\n        )\n        .unwrap();\n\n    match outcome {\n        ReviewDecisionOutcome::Applied { outcome } => {\n            assert_eq!(\n                outcome,\n                ApplyOutcome::Applied {\n                    memory_id: \"mem-proposal-repo\".to_string()\n                }\n            );\n        }\n        other => panic!(\"unexpected outcome: {other:?}\"),\n    }\n    assert_eq!(\n        proposal_decision(&fixture.db_path, \"proposal-repo\"),\n        \"applied\"\n    );\n    assert_eq!(\n        proposal_decision_reason(&fixture.db_path, \"proposal-repo\").as_deref(),\n        Some(\"promote durable fact\")\n    );\n    let event = fixture.memory_consolidated_event();\n    match event.payload {\n        EventPayload::MemoryConsolidated(payload) => {\n            assert_eq!(payload.decided_by.as_deref(), Some(\"reviewer-1\"));\n            assert_eq!(\n                payload.decision_reason.as_deref(),\n                Some(\"promote durable fact\")\n            );\n            assert_eq!(payload.proposal_id.as_deref(), Some(\"proposal-repo\"));\n        }\n        _ => panic!(\"expected memory_consolidated\"),\n    }\n}\n\n#[test]\nfn decide_reject_leaves_memory_unchanged_and_records_rejection() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime();\n    runtime.submit(job_for_scope(\"repo\")).unwrap();\n    runtime\n        .execute_ready(\n            &fixture.memory_store,\n            &fixture.event_writer,\n            &fixture.operator(\"auto-policy\"),\n        )\n        .unwrap();\n    let queue = fixture.review_queue();\n\n    let outcome = queue\n        .decide(\n            \"proposal-repo\",\n            ProposalDecision::Rejected,\n            &fixture.operator(\"reviewer-2\"),\n            Some(\"insufficient evidence\".to_string()),\n        )\n        .unwrap();\n\n    match outcome {\n        ReviewDecisionOutcome::Rejected { outcome } => {\n            assert_eq!(outcome, RejectOutcome::Rejected);\n        }\n        other => panic!(\"unexpected outcome: {other:?}\"),\n    }\n    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 0);\n    assert_eq!(\n        proposal_decision(&fixture.db_path, \"proposal-repo\"),\n        \"rejected\"\n    );\n    assert_eq!(\n        proposal_decision_reason(&fixture.db_path, \"proposal-repo\").as_deref(),\n        Some(\"insufficient evidence\")\n    );\n}\n\n#[test]\nfn list_pending_returns_oldest_first_and_honors_filters() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime();\n    runtime.submit(job_for_scope(\"repo\")).unwrap();\n    runtime.submit(job_for_scope(\"organization\")).unwrap();\n    runtime\n        .execute_ready(\n            &fixture.memory_store,\n            &fixture.event_writer,\n            &fixture.operator(\"auto-policy\"),\n        )\n        .unwrap();\n    fixture.set_enqueued_at(\"job-repo\", 10);\n    fixture.set_enqueued_at(\"job-organization\", 20);\n\n    let queue = fixture.review_queue();\n    let items = queue\n        .list_pending(\"workspace-main\", &ReviewQueueFilter::default())\n        .unwrap();\n    assert_eq!(items.len(), 2);\n    assert_eq!(items[0].proposal_id, \"proposal-repo\");\n    assert_eq!(items[1].proposal_id, \"proposal-organization\");\n\n    let repo_only = queue\n        .list_pending(\n            \"workspace-main\",\n            &ReviewQueueFilter {\n                scope: Some(crate::memory_graph::MemoryScope::Repo),\n                ..ReviewQueueFilter::default()\n            },\n        )\n        .unwrap();\n    assert_eq!(repo_only.len(), 1);\n    assert_eq!(repo_only[0].proposal_id, \"proposal-repo\");\n\n    let older_only = queue\n        .list_pending(\n            \"workspace-main\",\n            &ReviewQueueFilter {\n                older_than: Some(10),\n                ..ReviewQueueFilter::default()\n            },\n        )\n        .unwrap();\n    assert_eq!(older_only.len(), 1);\n    assert_eq!(older_only[0].proposal_id, \"proposal-repo\");\n}\n\n#[test]\nfn second_decision_is_idempotent() {\n    let fixture = Fixture::new();\n    let mut runtime = fixture.runtime();\n    runtime.submit(job_for_scope(\"repo\")).unwrap();\n    runtime\n        .execute_ready(\n            &fixture.memory_store,\n            &fixture.event_writer,\n            &fixture.operator(\"auto-policy\"),\n        )\n        .unwrap();\n    let queue = fixture.review_queue();\n    queue\n        .decide(\n            \"proposal-repo\",\n            ProposalDecision::Applied,\n            &fixture.operator(\"reviewer-1\"),\n            Some(\"accept\".to_string()),\n        )\n        .unwrap();\n\n    let second = queue\n        .decide(\n            \"proposal-repo\",\n            ProposalDecision::Applied,\n            &fixture.operator(\"reviewer-1\"),\n            Some(\"duplicate\".to_string()),\n        )\n        .unwrap();\n\n    assert_eq!(\n        second,\n        ReviewDecisionOutcome::AlreadyDecided {\n            decision: ProposalDecision::Applied\n        }\n    );\n}\n\n#[test]\nfn decision_reason_column_round_trips() {\n    let fixture = Fixture::new();\n    let conn = Connection::open(&fixture.db_path).unwrap();\n    initialize_schema(&conn).unwrap();\n    let exists: i64 = conn\n        .query_row(\n            \"SELECT COUNT(*) FROM pragma_table_info('consolidation_proposals') WHERE name = 'decision_reason'\",\n            [],\n            |row| row.get(0),\n        )\n        .unwrap();\n    assert_eq!(exists, 1);\n\n    conn.execute(\n        \"INSERT INTO consolidation_jobs\n            (job_id, workspace_id, kind, mode, status, enqueued_at)\n         VALUES ('job-schema', 'workspace-main', 'schema', 'manual_review', 'proposed', 1)\",\n        [],\n    )\n    .unwrap();\n    conn.execute(\n        \"INSERT INTO consolidation_proposals\n            (proposal_id, job_id, target_memory_id, proposal_kind, prior_state, proposed_state,\n             evidence, provenance_json, decision, decided_by, decision_reason)\n         VALUES (?1, ?2, NULL, ?3, ?4, ?5, ?6, NULL, 'rejected', 'reviewer', 'schema-check')\",\n        params![\n            \"proposal-schema\",\n            \"job-schema\",\n            ProposalKind::CreateMemory.as_str(),\n            \"{}\",\n            \"{\\\"scope\\\":\\\"repo\\\"}\",\n            \"{}\"\n        ],\n    )\n    .unwrap();\n\n    let record = ConsolidationProposal::load_record(&conn, \"proposal-schema\")\n        .unwrap()\n        .unwrap();\n    assert_eq!(record.decision_reason.as_deref(), Some(\"schema-check\"));\n}\n\nstruct Fixture {\n    _dir: tempfile::TempDir,\n    db_path: PathBuf,\n    memory_store: MemoryStore,\n    event_store: Arc<EventStore>,\n    event_writer: EventWriter,\n}\n\nimpl Fixture {\n    fn new() -> Self {\n        let dir = tempdir().unwrap();\n        let db_path = dir.path().join(\"consolidation.sqlite\");\n        let event_store = Arc::new(EventStore::open_in_memory().unwrap());\n        Self {\n            memory_store: MemoryStore::open(&dir.path().join(\"memory.sqlite\")).unwrap(),\n            event_store: event_store.clone(),\n            event_writer: EventWriter::new(event_store, \"workspace-main\".to_string(), 4096),\n            db_path,\n            _dir: dir,\n        }\n    }\n\n    fn runtime(&self) -> ConsolidationJobRuntime {\n        ConsolidationJobRuntime::new(\n            Connection::open(&self.db_path).unwrap(),\n            ConsolidationConfig::default(),\n        )\n        .unwrap()\n    }\n\n    fn review_queue(&self) -> ReviewQueue<'_> {\n        let conn = Box::leak(Box::new(Connection::open(&self.db_path).unwrap()));\n        ReviewQueue::new(conn, &self.memory_store, &self.event_writer)\n    }\n\n    fn operator(&self, value: &str) -> OperatorId {\n        OperatorId {\n            value: value.to_string(),\n        }\n    }\n\n    fn set_enqueued_at(&self, job_id: &str, enqueued_at: i64) {\n        let conn = Connection::open(&self.db_path).unwrap();\n        conn.execute(\n            \"UPDATE consolidation_jobs SET enqueued_at = ?1 WHERE job_id = ?2\",\n            params![enqueued_at, job_id],\n        )\n        .unwrap();\n    }\n\n    fn memory_consolidated_event(&self) -> crate::events::EventEnvelope {\n        let reader = EventReader::new(self.event_store.clone());\n        EventQuery::new()\n            .workspace(\"workspace-main\")\n            .branch(\"main\")\n            .kind(EventKind::MemoryConsolidated)\n            .execute(&reader)\n            .unwrap()\n            .into_iter()\n            .next()\n            .unwrap()\n    }\n}\n\nfn job_for_scope(scope: &str) -> ConsolidationJobSpec {\n    ConsolidationJobSpec {\n        job_id: format!(\"job-{scope}\"),\n        workspace_id: \"workspace-main\".to_string(),\n        kind: format!(\"scope-{scope}\"),\n        mode: ConsolidationJobMode::ManualReview,\n        proposal: Some(PendingProposalSpec {\n            proposal_id: format!(\"proposal-{scope}\"),\n            target_memory_id: None,\n            proposal_kind: ProposalKind::CreateMemory,\n            prior_state: json!({}),\n            proposed_state: proposal_state_for_scope(scope),\n            evidence: json!({\"source_memory_ids\":[]}),\n            provenance: None,\n        }),\n    }\n}\n\nfn proposal_state_for_scope(scope: &str) -> Value {\n    match scope {\n        \"organization\" => json!({\n            \"scope\": \"organization\",\n            \"memory\": { \"scope\": \"organization\" }\n        }),\n        _ => {\n            let legacy_scope = match scope {\n                \"session\" => MemoryScope::Session,\n                \"branch\" => MemoryScope::Branch,\n                \"repo\" => MemoryScope::Repo,\n                other => panic!(\"unsupported scope: {other}\"),\n            };\n            let mut value = serde_json::to_value(ConsolidationMemoryState {\n                memory: Memory {\n                    id: format!(\"mem-proposal-{scope}\"),\n                    session_id: \"session-main\".to_string(),\n                    content: format!(\"{scope} memory\"),\n                    memory_type: MemoryType::Observation,\n                    scope: legacy_scope,\n                    confidence: 0.9,\n                    linked_symbols: Vec::new(),\n                    linked_files: Vec::new(),\n                    workspace_id: Some(\"workspace-main\".to_string()),\n                    branch: Some(\"main\".to_string()),\n                    refresh_key: Some(format!(\"refresh-{scope}\")),\n                    source_query: Some(\"review queue test\".to_string()),\n                    created_at: 1,\n                    last_accessed: 1,\n                    access_count: 0,\n                    is_stale: false,\n                    stale_reason: None,\n                },\n                structured_fields: crate::memory::MemoryStructuredFields::default(),\n                last_verified_at: None,\n                memory_links: Vec::new(),\n            })\n            .unwrap();\n            value[\"scope\"] = Value::String(scope.to_string());\n            value\n        }\n    }\n}\n\nfn proposal_decision(path: &PathBuf, proposal_id: &str) -> String {\n    let conn = Connection::open(path).unwrap();\n    conn.query_row(\n        \"SELECT decision FROM consolidation_proposals WHERE proposal_id = ?1\",\n        params![proposal_id],\n        |row| row.get(0),\n    )\n    .unwrap()\n}\n\nfn proposal_decision_reason(path: &PathBuf, proposal_id: &str) -> Option<String> {\n    let conn = Connection::open(path).unwrap();\n    conn.query_row(\n        \"SELECT decision_reason FROM consolidation_proposals WHERE proposal_id = ?1\",\n        params![proposal_id],\n        |row| row.get(0),\n    )\n    .unwrap()\n}\n","numLines":476,"startLine":1,"totalLines":476}}}
