{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VnEUmLKJS9NgsQkzNDKebK","type":"tool_result","content":"1\t//! Consolidation runtime for proposal-only memory changes.\n2\t//!\n3\t//! This module implements the consolidation kernel described in\n4\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## 6. Consolidation Engine` and persists its job/proposal state according\n6\t//! to `## Storage Design`.\n7\t//!\n8\t//! \"No consolidation job may silently rewrite high-scope memory without\n9\t//! preserving provenance and prior state.\"\n10\t\n11\tuse std::sync::{Arc, Mutex};\n12\tuse std::time::{Duration, Instant};\n13\t\n14\tuse rusqlite::{params, Connection, OptionalExtension};\n15\tuse serde::{Deserialize, Serialize};\n16\tuse serde_json::{json, Value};\n17\tuse tracing::{field, info_span};\n18\t\n19\tuse crate::error::LatticeError;\n20\tuse crate::events::EventWriter;\n21\tuse crate::identity::EventId;\n22\tuse crate::memory::{\n23\t    Memory, MemoryLinkRecord, MemoryStore, MemoryStructuredFields, MemoryVerificationStatus,\n24\t};\n25\t\n26\tpub mod demotion;\n27\tpub mod duplicates;\n28\tpub mod episode;\n29\tpub mod llm;\n30\tpub mod proposal;\n31\tpub mod queue;\n32\tpub mod refresh;\n33\tpub mod replay;\n34\tpub mod review_queue;\n35\tpub mod session;\n36\tpub mod stale_marker;\n37\tpub mod supersession;\n38\t\n39\t#[cfg(test)]\n40\tmod deterministic_tests;\n41\t#[cfg(test)]\n42\tmod integration_test_support;\n43\t#[cfg(test)]\n44\tmod integration_tests;\n45\t#[cfg(test)]\n46\tmod proposal_tests;\n47\t#[cfg(test)]\n48\tmod replay_tests;\n49\t#[cfg(test)]\n50\tmod review_queue_tests;\n51\t#[cfg(test)]\n52\tmod session_tests;\n53\t\n54\tpub use demotion::DemotionScanner;\n55\tpub use duplicates::DuplicateDetector;\n56\tpub use episode::{EpisodeError, EpisodeOutcome, EpisodeTemplate, ToolName};\n57\tpub use proposal::{\n58\t    empty_state, ApplyOutcome, ConsolidationProposal, ConsolidationProposalRecord,\n59\t    ProposalDecision, ProposalKind, ProposalTarget, RejectOutcome,\n60\t};\n61\tpub use queue::{\n62\t    BoundedJobQueue, ConsolidationJobMode, ConsolidationJobRecord, ConsolidationJobSpec,\n63\t    ConsolidationJobStatus, EnqueueOutcome, PendingProposalSpec,\n64\t};\n65\tpub use refresh::RefreshScanner;\n66\tpub use replay::{\n67\t    Clock, FixedReplayClock, ReplayDriver, ReplayError, ReplayMode, ReplayReport, ReverseError,\n68\t    ReverseOutcome,\n69\t};\n70\tpub use review_queue::{\n71\t    ReviewDecisionOutcome, ReviewItem, ReviewQueue, ReviewQueueError, ReviewQueueFilter,\n72\t};\n73\tpub use session::{SessionConsolidationConfig, SessionConsolidationOutcome, SessionConsolidator};\n74\tpub use stale_marker::StaleMarker;\n75\tpub use supersession::SupersessionCandidates;\n76\t\n77\tconst CONSOLIDATION_SCHEMA_SQL: &str = include_str!(\"schema.sql\");\n78\tconst DEFAULT_CONSOLIDATION_QUEUE_DEPTH: usize = 128;\n79\t\n80\t#[derive(Clone, Debug, PartialEq, Eq)]\n81\tpub struct ScanReport {\n82\t    pub proposals_enqueued: u32,\n83\t    pub skipped: u32,\n84\t    pub elapsed: Duration,\n85\t}\n86\t\n87\timpl ScanReport {\n88\t    pub fn from_counts(proposals_enqueued: u32, skipped: u32, started: Instant) -> Self {\n89\t        Self {\n90\t            proposals_enqueued,\n91\t            skipped,\n92\t            elapsed: started.elapsed(),\n93\t        }\n94\t    }\n95\t}\n96\t\n97\t#[derive(Debug, thiserror::Error)]\n98\tpub enum ScanError {\n99\t    #[error(transparent)]\n100\t    Storage(#[from] LatticeError),\n101\t    #[error(\"proposal routing failed: {0}\")]\n102\t    Proposal(String),\n103\t}\n104\t\n105\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n106\tpub struct ConsolidationMemoryState {\n107\t    pub memory: Memory,\n108\t    pub structured_fields: MemoryStructuredFields,\n109\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n110\t    pub last_verified_at: Option<u64>,\n111\t    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n112\t    pub memory_links: Vec<MemoryLinkRecord>,\n113\t}\n114\t\n115\tpub(crate) fn capture_memory_state(\n116\t    store: &MemoryStore,\n117\t    memory: &Memory,\n118\t) -> Result<ConsolidationMemoryState, LatticeError> {\n119\t    let structured_fields = store.get_structured_fields(&memory.id)?.unwrap_or_default();\n120\t    let memory_links = store.list_memory_links_from(&memory.id)?;\n121\t    Ok(ConsolidationMemoryState {\n122\t        memory: memory.clone(),\n123\t        structured_fields,\n124\t        last_verified_at: store.get_last_verified_at(&memory.id)?,\n125\t        memory_links,\n126\t    })\n127\t}\n128\t\n129\tpub(crate) fn encode_memory_state(state: &ConsolidationMemoryState) -> Value {\n130\t    serde_json::to_value(state).unwrap_or_else(|_| json!({}))\n131\t}\n132\t\n133\tpub(crate) fn mark_state_stale(\n134\t    state: &ConsolidationMemoryState,\n135\t    reason: String,\n136\t) -> ConsolidationMemoryState {\n137\t    let mut next = state.clone();\n138\t    next.memory.is_stale = true;\n139\t    next.memory.stale_reason = Some(reason);\n140\t    next.structured_fields.verification_status = MemoryVerificationStatus::Stale;\n141\t    next\n142\t}\n143\t\n144\t#[derive(Clone, Debug, PartialEq, Eq)]\n145\tpub struct ConsolidationConfig {\n146\t    pub max_queue_depth: usize,\n147\t    pub llm_budget_catalog: Option<llm::BudgetCatalog>,\n148\t}\n149\t\n150\timpl Default for ConsolidationConfig {\n151\t    fn default() -> Self {\n152\t        Self {\n153\t            max_queue_depth: DEFAULT_CONSOLIDATION_QUEUE_DEPTH,\n154\t            llm_budget_catalog: None,\n155\t        }\n156\t    }\n157\t}\n158\t\n159\tpub fn initialize_schema(conn: &Connection) -> Result<(), LatticeError> {\n160\t    conn.execute_batch(CONSOLIDATION_SCHEMA_SQL).map_err(|e| {\n161\t        LatticeError::Storage(format!(\"Failed to initialize consolidation schema: {e}\"))\n162\t    })?;\n163\t    migrate_consolidation_schema(conn)?;\n164\t    Ok(())\n165\t}\n166\t\n167\tfn migrate_consolidation_schema(conn: &Connection) -> Result<(), LatticeError> {\n168\t    if !column_exists(conn, \"consolidation_proposals\", \"provenance_json\")? {\n169\t        conn.execute(\n170\t            \"ALTER TABLE consolidation_proposals ADD COLUMN provenance_json TEXT CHECK (provenance_json IS NULL OR json_valid(provenance_json))\",\n171\t            [],\n172\t        )\n173\t        .map_err(|e| LatticeError::Storage(format!(\"Failed to add proposal provenance column: {e}\")))?;\n174\t    }\n175\t    if !column_exists(conn, \"consolidation_proposals\", \"decision_reason\")? {\n176\t        conn.execute(\n177\t            \"ALTER TABLE consolidation_proposals ADD COLUMN decision_reason TEXT\",\n178\t            [],\n179\t        )\n180\t        .map_err(|e| {\n181\t            LatticeError::Storage(format!(\n182\t                \"Failed to add proposal decision_reason column: {e}\"\n183\t            ))\n184\t        })?;\n185\t    }\n186\t    if !decision_supports_reverted(conn)? {\n187\t        conn.execute_batch(\n188\t            \"ALTER TABLE consolidation_proposals RENAME TO consolidation_proposals_legacy;\n189\t             CREATE TABLE consolidation_proposals (\n190\t                 proposal_id TEXT PRIMARY KEY,\n191\t                 job_id TEXT NOT NULL,\n192\t                 target_memory_id TEXT,\n193\t                 proposal_kind TEXT NOT NULL,\n194\t                 prior_state TEXT NOT NULL CHECK (json_valid(prior_state)),\n195\t                 proposed_state TEXT NOT NULL CHECK (json_valid(proposed_state)),\n196\t                 evidence TEXT NOT NULL CHECK (json_valid(evidence)),\n197\t                 provenance_json TEXT CHECK (provenance_json IS NULL OR json_valid(provenance_json)),\n198\t                 decided_at INTEGER,\n199\t                 decision TEXT NOT NULL CHECK (decision IN ('pending', 'applied', 'rejected', 'reverted')),\n200\t                 decided_by TEXT,\n201\t                 decision_reason TEXT,\n202\t                 FOREIGN KEY (job_id) REFERENCES consolidation_jobs(job_id)\n203\t             );\n204\t             INSERT INTO consolidation_proposals (\n205\t                 proposal_id, job_id, target_memory_id, proposal_kind, prior_state,\n206\t                 proposed_state, evidence, provenance_json, decided_at, decision, decided_by,\n207\t                 decision_reason\n208\t             )\n209\t             SELECT\n210\t                 proposal_id, job_id, target_memory_id, proposal_kind, prior_state,\n211\t                 proposed_state, evidence, provenance_json, decided_at, decision, decided_by,\n212\t                 decision_reason\n213\t             FROM consolidation_proposals_legacy;\n214\t             DROP TABLE consolidation_proposals_legacy;\",\n215\t        )\n216\t        .map_err(|e| LatticeError::Storage(format!(\"Failed to add reverted proposal decision: {e}\")))?;\n217\t    }\n218\t    Ok(())\n219\t}\n220\t\n221\tfn column_exists(conn: &Connection, table: &str, column: &str) -> Result<bool, LatticeError> {\n222\t    let mut statement = conn\n223\t        .prepare(&format!(\"PRAGMA table_info({table})\"))\n224\t        .map_err(|e| LatticeError::Storage(format!(\"Failed to inspect table {table}: {e}\")))?;\n225\t    let columns = statement\n226\t        .query_map([], |row| row.get::<_, String>(1))\n227\t        .map_err(|e| LatticeError::Storage(format!(\"Failed to inspect table {table}: {e}\")))?;\n228\t    for name in columns {\n229\t        if name.map_err(|e| LatticeError::Storage(e.to_string()))? == column {\n230\t            return Ok(true);\n231\t        }\n232\t    }\n233\t    Ok(false)\n234\t}\n235\t\n236\tfn decision_supports_reverted(conn: &Connection) -> Result<bool, LatticeError> {\n237\t    let table_sql: Option<String> = conn\n238\t        .query_row(\n239\t            \"SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'consolidation_proposals'\",\n240\t            [],\n241\t            |row| row.get(0),\n242\t        )\n243\t        .optional()\n244\t        .map_err(|e| {\n245\t            LatticeError::Storage(format!(\n246\t                \"Failed to inspect consolidation_proposals table SQL: {e}\"\n247\t            ))\n248\t        })?;\n249\t    Ok(table_sql\n250\t        .as_deref()\n251\t        .is_some_and(|sql| sql.contains(\"'reverted'\")))\n252\t}\n253\t\n254\tpub struct ConsolidationJobRuntime {\n255\t    conn: Arc<Mutex<Connection>>,\n256\t    queue: BoundedJobQueue,\n257\t    config: ConsolidationConfig,\n258\t}\n259\t\n260\timpl ConsolidationJobRuntime {\n261\t    pub fn new(conn: Connection, config: ConsolidationConfig) -> Result<Self, LatticeError> {\n262\t        initialize_schema(&conn)?;\n263\t        let conn = Arc::new(Mutex::new(conn));\n264\t        let queue = BoundedJobQueue::new(config.max_queue_depth, conn.clone());\n265\t        Ok(Self {\n266\t            conn,\n267\t            queue,\n268\t            config,\n269\t        })\n270\t    }\n271\t\n272\t    pub fn config(&self) -> &ConsolidationConfig {\n273\t        &self.config\n274\t    }\n275\t\n276\t    pub fn submit(\n277\t        &mut self,\n278\t        job_spec: ConsolidationJobSpec,\n279\t    ) -> Result<EnqueueOutcome, LatticeError> {\n280\t        self.queue.enqueue(job_spec)\n281\t    }\n282\t\n283\t    pub(crate) fn submit_inline(\n284\t        &mut self,\n285\t        job_spec: ConsolidationJobSpec,\n286\t    ) -> Result<(EnqueueOutcome, Option<ConsolidationProposal>), LatticeError> {\n287\t        let enqueue = self.queue.persist_enqueued_only(&job_spec)?;\n288\t        let proposal = self.run_job(job_spec, None)?;\n289\t        Ok((enqueue, proposal))\n290\t    }\n291\t\n292\t    pub fn run_due(&mut self) -> Result<Vec<ConsolidationProposal>, LatticeError> {\n293\t        let mut proposals = Vec::new();\n294\t        while let Some(job) = self.queue.pop() {\n295\t            match self.run_job(job, None) {\n296\t                Ok(Some(proposal)) => proposals.push(proposal),\n297\t                Ok(None) => {}\n298\t                Err(error) => return Err(error),\n299\t            }\n300\t        }\n301\t        Ok(proposals)\n302\t    }\n303\t\n304\t    pub fn execute_ready(\n305\t        &mut self,\n306\t        memory_store: &MemoryStore,\n307\t        event_writer: &EventWriter,\n308\t        decided_by: &crate::identity::OperatorId,\n309\t    ) -> Result<Vec<ConsolidationProposal>, LatticeError> {\n310\t        let mut proposals = Vec::new();\n311\t        while let Some(job) = self.queue.pop() {\n312\t            match self.run_job(job, Some((memory_store, event_writer, decided_by))) {\n313\t                Ok(Some(proposal)) => proposals.push(proposal),\n314\t                Ok(None) => {}\n315\t                Err(error) => return Err(error),\n316\t            }\n317\t        }\n318\t        Ok(proposals)\n319\t    }\n320\t\n321\t    pub fn decide(\n322\t        &self,\n323\t        proposal_id: &str,\n324\t        decision: ProposalDecision,\n325\t        memory_store: &MemoryStore,\n326\t        event_writer: &EventWriter,\n327\t        decided_by: &str,\n328\t    ) -> Result<Option<ApplyOutcome>, LatticeError> {\n329\t        let conn = self.lock_conn()?;\n330\t        let proposal = match ConsolidationProposal::load(&conn, proposal_id)? {\n331\t            Some(proposal) => proposal,\n332\t            None => return Ok(None),\n333\t        };\n334\t        match decision {\n335\t            ProposalDecision::Pending => Ok(None),\n336\t            ProposalDecision::Applied => {\n337\t                let outcome =\n338\t                    proposal.apply(&conn, memory_store, event_writer, decided_by, None)?;\n339\t                Ok(Some(outcome))\n340\t            }\n341\t            ProposalDecision::Rejected => {\n342\t                proposal.reject(&conn, event_writer, decided_by, None)?;\n343\t                Ok(None)\n344\t            }\n345\t            ProposalDecision::Reverted => Ok(None),\n346\t        }\n347\t    }\n348\t\n349\t    pub fn replay_from(&mut self, event_id: EventId) -> Result<EnqueueOutcome, LatticeError> {\n350\t        let job = ConsolidationJobSpec {\n351\t            job_id: format!(\"replay-{}\", event_id.ulid),\n352\t            workspace_id: event_id.workspace_id,\n353\t            kind: \"replay_from_event\".to_string(),\n354\t            mode: ConsolidationJobMode::Replay,\n355\t            proposal: None,\n356\t        };\n357\t        self.submit(job)\n358\t    }\n359\t\n360\t    pub fn depth(&self) -> usize {\n361\t        self.queue.depth()\n362\t    }\n363\t\n364\t    pub fn drain_for_shutdown(&mut self) -> Vec<ConsolidationJobSpec> {\n365\t        self.queue.drain_for_shutdown()\n366\t    }\n367\t\n368\t    fn run_job(\n369\t        &self,\n370\t        job: ConsolidationJobSpec,\n371\t        auto_apply: Option<(&MemoryStore, &EventWriter, &crate::identity::OperatorId)>,\n372\t    ) -> Result<Option<ConsolidationProposal>, LatticeError> {\n373\t        let proposal_id = job\n374\t            .proposal\n375\t            .as_ref()\n376\t            .map(|proposal| proposal.proposal_id.clone())\n377\t            .unwrap_or_default();\n378\t        let span = info_span!(\n379\t            \"consolidation.job.run\",\n380\t            workspace_id = job.workspace_id.as_str(),\n381\t            job_id = job.job_id.as_str(),\n382\t            proposal_id = proposal_id.as_str(),\n383\t            outcome = field::Empty\n384\t        );\n385\t        let _entered = span.enter();\n386\t        let conn = self.lock_conn()?;\n387\t        mark_running(&conn, &job.job_id)?;\n388\t        let Some(pending) = job.proposal else {\n389\t            proposal::mark_job_status(&conn, &job.job_id, \"failed\", None, Some(\"no_proposal\"))?;\n390\t            span.record(\"outcome\", \"failed\");\n391\t            return Ok(None);\n392\t        };\n393\t        let proposal = proposal::proposal_from_pending(&job.job_id, pending);\n394\t        proposal.insert_pending(&conn)?;\n395\t        proposal::mark_job_status(\n396\t            &conn,\n397\t            &job.job_id,\n398\t            \"proposed\",\n399\t            Some(&proposal.proposal_id),\n400\t            None,\n401\t        )?;\n402\t        if let Some((memory_store, event_writer, decided_by)) = auto_apply {\n403\t            if !ReviewQueue::should_gate(&proposal) {\n404\t                let _ = proposal.apply(\n405\t                    &conn,\n406\t                    memory_store,\n407\t                    event_writer,\n408\t                    decided_by.value.as_str(),\n409\t                    None,\n410\t                )?;\n411\t                span.record(\"outcome\", \"applied\");\n412\t                return Ok(Some(proposal));\n413\t            }\n414\t        }\n415\t        span.record(\"outcome\", \"proposed\");\n416\t        Ok(Some(proposal))\n417\t    }\n418\t\n419\t    fn lock_conn(&self) -> Result<std::sync::MutexGuard<'_, Connection>, LatticeError> {\n420\t        self.conn.lock().map_err(|_| {\n421\t            LatticeError::Storage(\"consolidation runtime storage lock was poisoned\".to_string())\n422\t        })\n423\t    }\n424\t}\n425\t\n426\tfn mark_running(conn: &Connection, job_id: &str) -> Result<(), LatticeError> {\n427\t    conn.execute(\n428\t        \"UPDATE consolidation_jobs\n429\t         SET status = 'running', started_at = ?1\n430\t         WHERE job_id = ?2\",\n431\t        params![now_unix_micros(), job_id],\n432\t    )\n433\t    .map_err(|e| LatticeError::Storage(format!(\"Failed to start consolidation job: {e}\")))?;\n434\t    Ok(())\n435\t}\n436\t\n437\tpub(crate) fn now_unix_micros() -> i64 {\n438\t    queue::now_unix_micros()\n439\t}\n440\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"c6bc5b6c-c6f1-43e8-8628-326da1008ae8","timestamp":"2026-05-17T11:39:07.837Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/mod.rs","content":"//! Consolidation runtime for proposal-only memory changes.\n//!\n//! This module implements the consolidation kernel described in\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 6. Consolidation Engine` and persists its job/proposal state according\n//! to `## Storage Design`.\n//!\n//! \"No consolidation job may silently rewrite high-scope memory without\n//! preserving provenance and prior state.\"\n\nuse std::sync::{Arc, Mutex};\nuse std::time::{Duration, Instant};\n\nuse rusqlite::{params, Connection, OptionalExtension};\nuse serde::{Deserialize, Serialize};\nuse serde_json::{json, Value};\nuse tracing::{field, info_span};\n\nuse crate::error::LatticeError;\nuse crate::events::EventWriter;\nuse crate::identity::EventId;\nuse crate::memory::{\n    Memory, MemoryLinkRecord, MemoryStore, MemoryStructuredFields, MemoryVerificationStatus,\n};\n\npub mod demotion;\npub mod duplicates;\npub mod episode;\npub mod llm;\npub mod proposal;\npub mod queue;\npub mod refresh;\npub mod replay;\npub mod review_queue;\npub mod session;\npub mod stale_marker;\npub mod supersession;\n\n#[cfg(test)]\nmod deterministic_tests;\n#[cfg(test)]\nmod integration_test_support;\n#[cfg(test)]\nmod integration_tests;\n#[cfg(test)]\nmod proposal_tests;\n#[cfg(test)]\nmod replay_tests;\n#[cfg(test)]\nmod review_queue_tests;\n#[cfg(test)]\nmod session_tests;\n\npub use demotion::DemotionScanner;\npub use duplicates::DuplicateDetector;\npub use episode::{EpisodeError, EpisodeOutcome, EpisodeTemplate, ToolName};\npub use proposal::{\n    empty_state, ApplyOutcome, ConsolidationProposal, ConsolidationProposalRecord,\n    ProposalDecision, ProposalKind, ProposalTarget, RejectOutcome,\n};\npub use queue::{\n    BoundedJobQueue, ConsolidationJobMode, ConsolidationJobRecord, ConsolidationJobSpec,\n    ConsolidationJobStatus, EnqueueOutcome, PendingProposalSpec,\n};\npub use refresh::RefreshScanner;\npub use replay::{\n    Clock, FixedReplayClock, ReplayDriver, ReplayError, ReplayMode, ReplayReport, ReverseError,\n    ReverseOutcome,\n};\npub use review_queue::{\n    ReviewDecisionOutcome, ReviewItem, ReviewQueue, ReviewQueueError, ReviewQueueFilter,\n};\npub use session::{SessionConsolidationConfig, SessionConsolidationOutcome, SessionConsolidator};\npub use stale_marker::StaleMarker;\npub use supersession::SupersessionCandidates;\n\nconst CONSOLIDATION_SCHEMA_SQL: &str = include_str!(\"schema.sql\");\nconst DEFAULT_CONSOLIDATION_QUEUE_DEPTH: usize = 128;\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct ScanReport {\n    pub proposals_enqueued: u32,\n    pub skipped: u32,\n    pub elapsed: Duration,\n}\n\nimpl ScanReport {\n    pub fn from_counts(proposals_enqueued: u32, skipped: u32, started: Instant) -> Self {\n        Self {\n            proposals_enqueued,\n            skipped,\n            elapsed: started.elapsed(),\n        }\n    }\n}\n\n#[derive(Debug, thiserror::Error)]\npub enum ScanError {\n    #[error(transparent)]\n    Storage(#[from] LatticeError),\n    #[error(\"proposal routing failed: {0}\")]\n    Proposal(String),\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\npub struct ConsolidationMemoryState {\n    pub memory: Memory,\n    pub structured_fields: MemoryStructuredFields,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub last_verified_at: Option<u64>,\n    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n    pub memory_links: Vec<MemoryLinkRecord>,\n}\n\npub(crate) fn capture_memory_state(\n    store: &MemoryStore,\n    memory: &Memory,\n) -> Result<ConsolidationMemoryState, LatticeError> {\n    let structured_fields = store.get_structured_fields(&memory.id)?.unwrap_or_default();\n    let memory_links = store.list_memory_links_from(&memory.id)?;\n    Ok(ConsolidationMemoryState {\n        memory: memory.clone(),\n        structured_fields,\n        last_verified_at: store.get_last_verified_at(&memory.id)?,\n        memory_links,\n    })\n}\n\npub(crate) fn encode_memory_state(state: &ConsolidationMemoryState) -> Value {\n    serde_json::to_value(state).unwrap_or_else(|_| json!({}))\n}\n\npub(crate) fn mark_state_stale(\n    state: &ConsolidationMemoryState,\n    reason: String,\n) -> ConsolidationMemoryState {\n    let mut next = state.clone();\n    next.memory.is_stale = true;\n    next.memory.stale_reason = Some(reason);\n    next.structured_fields.verification_status = MemoryVerificationStatus::Stale;\n    next\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct ConsolidationConfig {\n    pub max_queue_depth: usize,\n    pub llm_budget_catalog: Option<llm::BudgetCatalog>,\n}\n\nimpl Default for ConsolidationConfig {\n    fn default() -> Self {\n        Self {\n            max_queue_depth: DEFAULT_CONSOLIDATION_QUEUE_DEPTH,\n            llm_budget_catalog: None,\n        }\n    }\n}\n\npub fn initialize_schema(conn: &Connection) -> Result<(), LatticeError> {\n    conn.execute_batch(CONSOLIDATION_SCHEMA_SQL).map_err(|e| {\n        LatticeError::Storage(format!(\"Failed to initialize consolidation schema: {e}\"))\n    })?;\n    migrate_consolidation_schema(conn)?;\n    Ok(())\n}\n\nfn migrate_consolidation_schema(conn: &Connection) -> Result<(), LatticeError> {\n    if !column_exists(conn, \"consolidation_proposals\", \"provenance_json\")? {\n        conn.execute(\n            \"ALTER TABLE consolidation_proposals ADD COLUMN provenance_json TEXT CHECK (provenance_json IS NULL OR json_valid(provenance_json))\",\n            [],\n        )\n        .map_err(|e| LatticeError::Storage(format!(\"Failed to add proposal provenance column: {e}\")))?;\n    }\n    if !column_exists(conn, \"consolidation_proposals\", \"decision_reason\")? {\n        conn.execute(\n            \"ALTER TABLE consolidation_proposals ADD COLUMN decision_reason TEXT\",\n            [],\n        )\n        .map_err(|e| {\n            LatticeError::Storage(format!(\n                \"Failed to add proposal decision_reason column: {e}\"\n            ))\n        })?;\n    }\n    if !decision_supports_reverted(conn)? {\n        conn.execute_batch(\n            \"ALTER TABLE consolidation_proposals RENAME TO consolidation_proposals_legacy;\n             CREATE TABLE consolidation_proposals (\n                 proposal_id TEXT PRIMARY KEY,\n                 job_id TEXT NOT NULL,\n                 target_memory_id TEXT,\n                 proposal_kind TEXT NOT NULL,\n                 prior_state TEXT NOT NULL CHECK (json_valid(prior_state)),\n                 proposed_state TEXT NOT NULL CHECK (json_valid(proposed_state)),\n                 evidence TEXT NOT NULL CHECK (json_valid(evidence)),\n                 provenance_json TEXT CHECK (provenance_json IS NULL OR json_valid(provenance_json)),\n                 decided_at INTEGER,\n                 decision TEXT NOT NULL CHECK (decision IN ('pending', 'applied', 'rejected', 'reverted')),\n                 decided_by TEXT,\n                 decision_reason TEXT,\n                 FOREIGN KEY (job_id) REFERENCES consolidation_jobs(job_id)\n             );\n             INSERT INTO consolidation_proposals (\n                 proposal_id, job_id, target_memory_id, proposal_kind, prior_state,\n                 proposed_state, evidence, provenance_json, decided_at, decision, decided_by,\n                 decision_reason\n             )\n             SELECT\n                 proposal_id, job_id, target_memory_id, proposal_kind, prior_state,\n                 proposed_state, evidence, provenance_json, decided_at, decision, decided_by,\n                 decision_reason\n             FROM consolidation_proposals_legacy;\n             DROP TABLE consolidation_proposals_legacy;\",\n        )\n        .map_err(|e| LatticeError::Storage(format!(\"Failed to add reverted proposal decision: {e}\")))?;\n    }\n    Ok(())\n}\n\nfn column_exists(conn: &Connection, table: &str, column: &str) -> Result<bool, LatticeError> {\n    let mut statement = conn\n        .prepare(&format!(\"PRAGMA table_info({table})\"))\n        .map_err(|e| LatticeError::Storage(format!(\"Failed to inspect table {table}: {e}\")))?;\n    let columns = statement\n        .query_map([], |row| row.get::<_, String>(1))\n        .map_err(|e| LatticeError::Storage(format!(\"Failed to inspect table {table}: {e}\")))?;\n    for name in columns {\n        if name.map_err(|e| LatticeError::Storage(e.to_string()))? == column {\n            return Ok(true);\n        }\n    }\n    Ok(false)\n}\n\nfn decision_supports_reverted(conn: &Connection) -> Result<bool, LatticeError> {\n    let table_sql: Option<String> = conn\n        .query_row(\n            \"SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'consolidation_proposals'\",\n            [],\n            |row| row.get(0),\n        )\n        .optional()\n        .map_err(|e| {\n            LatticeError::Storage(format!(\n                \"Failed to inspect consolidation_proposals table SQL: {e}\"\n            ))\n        })?;\n    Ok(table_sql\n        .as_deref()\n        .is_some_and(|sql| sql.contains(\"'reverted'\")))\n}\n\npub struct ConsolidationJobRuntime {\n    conn: Arc<Mutex<Connection>>,\n    queue: BoundedJobQueue,\n    config: ConsolidationConfig,\n}\n\nimpl ConsolidationJobRuntime {\n    pub fn new(conn: Connection, config: ConsolidationConfig) -> Result<Self, LatticeError> {\n        initialize_schema(&conn)?;\n        let conn = Arc::new(Mutex::new(conn));\n        let queue = BoundedJobQueue::new(config.max_queue_depth, conn.clone());\n        Ok(Self {\n            conn,\n            queue,\n            config,\n        })\n    }\n\n    pub fn config(&self) -> &ConsolidationConfig {\n        &self.config\n    }\n\n    pub fn submit(\n        &mut self,\n        job_spec: ConsolidationJobSpec,\n    ) -> Result<EnqueueOutcome, LatticeError> {\n        self.queue.enqueue(job_spec)\n    }\n\n    pub(crate) fn submit_inline(\n        &mut self,\n        job_spec: ConsolidationJobSpec,\n    ) -> Result<(EnqueueOutcome, Option<ConsolidationProposal>), LatticeError> {\n        let enqueue = self.queue.persist_enqueued_only(&job_spec)?;\n        let proposal = self.run_job(job_spec, None)?;\n        Ok((enqueue, proposal))\n    }\n\n    pub fn run_due(&mut self) -> Result<Vec<ConsolidationProposal>, LatticeError> {\n        let mut proposals = Vec::new();\n        while let Some(job) = self.queue.pop() {\n            match self.run_job(job, None) {\n                Ok(Some(proposal)) => proposals.push(proposal),\n                Ok(None) => {}\n                Err(error) => return Err(error),\n            }\n        }\n        Ok(proposals)\n    }\n\n    pub fn execute_ready(\n        &mut self,\n        memory_store: &MemoryStore,\n        event_writer: &EventWriter,\n        decided_by: &crate::identity::OperatorId,\n    ) -> Result<Vec<ConsolidationProposal>, LatticeError> {\n        let mut proposals = Vec::new();\n        while let Some(job) = self.queue.pop() {\n            match self.run_job(job, Some((memory_store, event_writer, decided_by))) {\n                Ok(Some(proposal)) => proposals.push(proposal),\n                Ok(None) => {}\n                Err(error) => return Err(error),\n            }\n        }\n        Ok(proposals)\n    }\n\n    pub fn decide(\n        &self,\n        proposal_id: &str,\n        decision: ProposalDecision,\n        memory_store: &MemoryStore,\n        event_writer: &EventWriter,\n        decided_by: &str,\n    ) -> Result<Option<ApplyOutcome>, LatticeError> {\n        let conn = self.lock_conn()?;\n        let proposal = match ConsolidationProposal::load(&conn, proposal_id)? {\n            Some(proposal) => proposal,\n            None => return Ok(None),\n        };\n        match decision {\n            ProposalDecision::Pending => Ok(None),\n            ProposalDecision::Applied => {\n                let outcome =\n                    proposal.apply(&conn, memory_store, event_writer, decided_by, None)?;\n                Ok(Some(outcome))\n            }\n            ProposalDecision::Rejected => {\n                proposal.reject(&conn, event_writer, decided_by, None)?;\n                Ok(None)\n            }\n            ProposalDecision::Reverted => Ok(None),\n        }\n    }\n\n    pub fn replay_from(&mut self, event_id: EventId) -> Result<EnqueueOutcome, LatticeError> {\n        let job = ConsolidationJobSpec {\n            job_id: format!(\"replay-{}\", event_id.ulid),\n            workspace_id: event_id.workspace_id,\n            kind: \"replay_from_event\".to_string(),\n            mode: ConsolidationJobMode::Replay,\n            proposal: None,\n        };\n        self.submit(job)\n    }\n\n    pub fn depth(&self) -> usize {\n        self.queue.depth()\n    }\n\n    pub fn drain_for_shutdown(&mut self) -> Vec<ConsolidationJobSpec> {\n        self.queue.drain_for_shutdown()\n    }\n\n    fn run_job(\n        &self,\n        job: ConsolidationJobSpec,\n        auto_apply: Option<(&MemoryStore, &EventWriter, &crate::identity::OperatorId)>,\n    ) -> Result<Option<ConsolidationProposal>, LatticeError> {\n        let proposal_id = job\n            .proposal\n            .as_ref()\n            .map(|proposal| proposal.proposal_id.clone())\n            .unwrap_or_default();\n        let span = info_span!(\n            \"consolidation.job.run\",\n            workspace_id = job.workspace_id.as_str(),\n            job_id = job.job_id.as_str(),\n            proposal_id = proposal_id.as_str(),\n            outcome = field::Empty\n        );\n        let _entered = span.enter();\n        let conn = self.lock_conn()?;\n        mark_running(&conn, &job.job_id)?;\n        let Some(pending) = job.proposal else {\n            proposal::mark_job_status(&conn, &job.job_id, \"failed\", None, Some(\"no_proposal\"))?;\n            span.record(\"outcome\", \"failed\");\n            return Ok(None);\n        };\n        let proposal = proposal::proposal_from_pending(&job.job_id, pending);\n        proposal.insert_pending(&conn)?;\n        proposal::mark_job_status(\n            &conn,\n            &job.job_id,\n            \"proposed\",\n            Some(&proposal.proposal_id),\n            None,\n        )?;\n        if let Some((memory_store, event_writer, decided_by)) = auto_apply {\n            if !ReviewQueue::should_gate(&proposal) {\n                let _ = proposal.apply(\n                    &conn,\n                    memory_store,\n                    event_writer,\n                    decided_by.value.as_str(),\n                    None,\n                )?;\n                span.record(\"outcome\", \"applied\");\n                return Ok(Some(proposal));\n            }\n        }\n        span.record(\"outcome\", \"proposed\");\n        Ok(Some(proposal))\n    }\n\n    fn lock_conn(&self) -> Result<std::sync::MutexGuard<'_, Connection>, LatticeError> {\n        self.conn.lock().map_err(|_| {\n            LatticeError::Storage(\"consolidation runtime storage lock was poisoned\".to_string())\n        })\n    }\n}\n\nfn mark_running(conn: &Connection, job_id: &str) -> Result<(), LatticeError> {\n    conn.execute(\n        \"UPDATE consolidation_jobs\n         SET status = 'running', started_at = ?1\n         WHERE job_id = ?2\",\n        params![now_unix_micros(), job_id],\n    )\n    .map_err(|e| LatticeError::Storage(format!(\"Failed to start consolidation job: {e}\")))?;\n    Ok(())\n}\n\npub(crate) fn now_unix_micros() -> i64 {\n    queue::now_unix_micros()\n}\n","numLines":440,"startLine":1,"totalLines":440}}}
