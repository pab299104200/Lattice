{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013fAaUGdGRW3RFczBhYH8vP","type":"tool_result","content":"1\t//! LLM-driven consolidation jobs for proposal-only memory changes.\n2\t//!\n3\t//! This module implements `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## 6. Consolidation Engine` \"LLM-driven consolidation\" and supports the\n5\t//! `## Phase 6: Consolidation Engine` DoD that repeated traces produce\n6\t//! procedures, recurring diagnostics produce failure patterns, and consolidation\n7\t//! stays auditable, reversible, and test-covered.\n8\t//!\n9\t//! Required LLM-driven constraints from `## 6. Consolidation Engine`:\n10\t//!\n11\t//! - each LLM-driven job produces a proposal record, not a direct write; proposals require explicit apply or reject before altering durable memory\n12\t//! - failed or malformed LLM responses must leave the prior memory state unchanged and emit a consolidation failure event\n13\t//! - LLM-driven jobs run only in background or manual review modes, never on the synchronous post-task hot path\n14\t//! - each job records its model, prompt hash, and response hash as part of the proposal provenance so outputs are auditable and reproducible\n15\t//! - consolidation queue depth must be bounded; when the queue is full, new jobs are dropped with a log warning rather than stalling the daemon\n16\t//! - cost and latency budgets for LLM consolidation should be documented per job type before Phase 6 begins; jobs exceeding budget must fall back to deterministic approximations or skip with a stale flag\n17\t\n18\tuse std::time::Instant;\n19\t\n20\tuse serde::{Deserialize, Serialize};\n21\tuse serde_json::Value;\n22\tuse tracing::{field, info_span, warn};\n23\t\n24\tuse crate::consolidation::{\n25\t    empty_state, now_unix_micros, ConsolidationJobMode, ConsolidationJobRuntime,\n26\t    ConsolidationJobSpec, ConsolidationMemoryState, PendingProposalSpec, ProposalKind,\n27\t    ProposalTarget,\n28\t};\n29\tuse crate::error::LatticeError;\n30\tuse crate::events::{\n31\t    Actor, BranchRef, CompactSummary, ConsolidationFailedPayload, EventKind, EventPayload,\n32\t    EventWriter, PartialEnvelope, SessionId,\n33\t};\n34\tuse crate::memory::model::{MemoryAssertionType, MemoryFreshnessPolicy, MemoryProvenance};\n35\tuse crate::memory::{\n36\t    Memory, MemoryEvidence, MemoryLinkRecord, MemoryScope, MemoryStore, MemoryStructuredFields,\n37\t    MemoryType, MemoryVerificationStatus,\n38\t};\n39\t\n40\tpub mod budget;\n41\tpub mod contradiction;\n42\tpub mod episode;\n43\tpub mod failure_pattern;\n44\tpub mod procedure;\n45\tpub mod provenance;\n46\t\n47\t#[cfg(test)]\n48\tmod llm_tests;\n49\t#[cfg(test)]\n50\tmod provenance_tests;\n51\t\n52\tpub use budget::{\n53\t    BudgetCatalog, BudgetError, BudgetOutcome, BudgetUsage, DeterministicFallback, LlmBudget,\n54\t};\n55\tpub use contradiction::{ContradictionCandidatePair, ContradictionDetectionJob};\n56\tpub use episode::{EpisodeMemoryCandidate, EpisodeSummaryJob};\n57\tpub use failure_pattern::{DiagnosticCluster, FailurePatternJob, FailurePatternMemoryCandidate};\n58\tpub use procedure::{ProcedureExtractionJob, ProcedureMemoryCandidate, WorkflowOccurrence};\n59\tpub use provenance::{LlmProvenance, ProvenanceError};\n60\t\n61\tpub type ConsolidationMode = ConsolidationJobMode;\n62\t\n63\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n64\tpub struct LlmRequest {\n65\t    pub workspace_id: String,\n66\t    pub job_kind: ConsolidationJobKind,\n67\t    pub prompt: String,\n68\t    pub response_schema: String,\n69\t}\n70\t\n71\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n72\tpub struct LlmResponse {\n73\t    pub content: String,\n74\t}\n75\t\n76\tpub trait LlmDriver {\n77\t    fn complete(&self, request: LlmRequest) -> Result<LlmResponse, LlmDriverError>;\n78\t    fn name(&self) -> &str;\n79\t}\n80\t\n81\t#[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]\n82\tpub enum LlmDriverError {\n83\t    #[error(\"LLM driver unavailable: {0}\")]\n84\t    Unavailable(String),\n85\t    #[error(\"LLM driver budget exceeded: {0}\")]\n86\t    BudgetExceeded(String),\n87\t    #[error(\"LLM driver failed: {0}\")]\n88\t    Failed(String),\n89\t}\n90\t\n91\t#[derive(Clone, Debug, PartialEq, Eq)]\n92\tpub struct LlmJobContext {\n93\t    pub workspace_id: String,\n94\t    pub mode: ConsolidationMode,\n95\t    pub budget_catalog: BudgetCatalog,\n96\t}\n97\t\n98\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n99\t#[serde(rename_all = \"snake_case\")]\n100\tpub enum ConsolidationJobKind {\n101\t    EpisodeSummary,\n102\t    ProcedureExtraction,\n103\t    ContradictionDetection,\n104\t    FailurePatternExtraction,\n105\t}\n106\t\n107\timpl ConsolidationJobKind {\n108\t    pub fn as_str(self) -> &'static str {\n109\t        match self {\n110\t            Self::EpisodeSummary => \"episode_summary\",\n111\t            Self::ProcedureExtraction => \"procedure_extraction\",\n112\t            Self::ContradictionDetection => \"contradiction_detection\",\n113\t            Self::FailurePatternExtraction => \"failure_pattern_extraction\",\n114\t        }\n115\t    }\n116\t}\n117\t\n118\t#[derive(Debug, thiserror::Error)]\n119\tpub enum LlmJobError {\n120\t    #[error(\"LLM consolidation job `{0}` is forbidden on the synchronous post-task hot path\")]\n121\t    ForbiddenOnHotPath(&'static str),\n122\t    #[error(transparent)]\n123\t    DriverError(#[from] LlmDriverError),\n124\t    #[error(\"malformed LLM response: {0}\")]\n125\t    MalformedResponse(String),\n126\t    #[error(\"LLM budget exceeded: {0}\")]\n127\t    BudgetExceeded(String),\n128\t    #[error(\"LLM provenance failed: {0}\")]\n129\t    Provenance(String),\n130\t    #[error(\"consolidation storage failed: {0}\")]\n131\t    Storage(String),\n132\t}\n133\t\n134\timpl From<LatticeError> for LlmJobError {\n135\t    fn from(value: LatticeError) -> Self {\n136\t        Self::Storage(value.to_string())\n137\t    }\n138\t}\n139\t\n140\tpub(crate) struct LlmCompletion<T> {\n141\t    pub value: T,\n142\t    pub provenance: LlmProvenance,\n143\t}\n144\t\n145\tpub struct LlmJobServices<'a> {\n146\t    pub driver: &'a dyn LlmDriver,\n147\t    pub runtime: &'a mut ConsolidationJobRuntime,\n148\t    pub memory_store: &'a MemoryStore,\n149\t    pub event_writer: &'a EventWriter,\n150\t}\n151\t\n152\tpub enum LlmJobInput {\n153\t    EpisodeSummary(Vec<crate::events::EventEnvelope>),\n154\t    ProcedureExtraction {\n155\t        workflow_id: String,\n156\t        occurrences: Vec<WorkflowOccurrence>,\n157\t    },\n158\t    ContradictionDetection(ContradictionCandidatePair),\n159\t    FailurePatternExtraction(DiagnosticCluster),\n160\t}\n161\t\n162\tpub fn dispatch_llm_job(\n163\t    ctx: &LlmJobContext,\n164\t    services: &mut LlmJobServices<'_>,\n165\t    input: LlmJobInput,\n166\t) -> Result<Option<crate::consolidation::ConsolidationProposal>, LlmJobError> {\n167\t    forbid_hot_path(ctx, input.kind())?;\n168\t    match input {\n169\t        LlmJobInput::EpisodeSummary(slice) => EpisodeSummaryJob::run(ctx, services, &slice),\n170\t        LlmJobInput::ProcedureExtraction {\n171\t            workflow_id,\n172\t            occurrences,\n173\t        } => ProcedureExtractionJob::run(ctx, services, &workflow_id, &occurrences),\n174\t        LlmJobInput::ContradictionDetection(pair) => {\n175\t            ContradictionDetectionJob::run(ctx, services, &pair)\n176\t        }\n177\t        LlmJobInput::FailurePatternExtraction(cluster) => {\n178\t            FailurePatternJob::run(ctx, services, &cluster)\n179\t        }\n180\t    }\n181\t}\n182\t\n183\timpl LlmJobInput {\n184\t    fn kind(&self) -> ConsolidationJobKind {\n185\t        match self {\n186\t            Self::EpisodeSummary(_) => ConsolidationJobKind::EpisodeSummary,\n187\t            Self::ProcedureExtraction { .. } => ConsolidationJobKind::ProcedureExtraction,\n188\t            Self::ContradictionDetection(_) => ConsolidationJobKind::ContradictionDetection,\n189\t            Self::FailurePatternExtraction(_) => ConsolidationJobKind::FailurePatternExtraction,\n190\t        }\n191\t    }\n192\t}\n193\t\n194\tpub(crate) fn forbid_hot_path(\n195\t    ctx: &LlmJobContext,\n196\t    kind: ConsolidationJobKind,\n197\t) -> Result<(), LlmJobError> {\n198\t    if ctx.mode == ConsolidationMode::SynchronousPostTask {\n199\t        return Err(LlmJobError::ForbiddenOnHotPath(kind.as_str()));\n200\t    }\n201\t    Ok(())\n202\t}\n203\t\n204\tpub(crate) fn complete_structured_with_provenance<T>(\n205\t    ctx: &LlmJobContext,\n206\t    services: &mut LlmJobServices<'_>,\n207\t    kind: ConsolidationJobKind,\n208\t    prompt: String,\n209\t    response_schema: &str,\n210\t) -> Result<LlmCompletion<T>, LlmJobError>\n211\twhere\n212\t    T: serde::de::DeserializeOwned,\n213\t{\n214\t    let prompt_tokens = token_count(&prompt);\n215\t    enforce_budget(\n216\t        ctx,\n217\t        services,\n218\t        kind,\n219\t        BudgetUsage {\n220\t            prompt_tokens,\n221\t            response_tokens: 0,\n222\t            latency_ms: 0,\n223\t            cost_micro_usd: estimate_cost_micro_usd(prompt_tokens, 0),\n224\t        },\n225\t    )?;\n226\t    let _span = info_span!(\n227\t        \"llm_consolidation\",\n228\t        job_kind = kind.as_str(),\n229\t        workspace_id = ctx.workspace_id.as_str(),\n230\t        mode = ctx.mode.as_str(),\n231\t        model_name = services.driver.name(),\n232\t        outcome = field::Empty\n233\t    )\n234\t    .entered();\n235\t    let request = LlmRequest {\n236\t        workspace_id: ctx.workspace_id.clone(),\n237\t        job_kind: kind,\n238\t        prompt: prompt.clone(),\n239\t        response_schema: response_schema.to_string(),\n240\t    };\n241\t    let started = Instant::now();\n242\t    let response = match services.driver.complete(request) {\n243\t        Ok(response) => response,\n244\t        Err(error) => return fail_driver(ctx, services, kind, error),\n245\t    };\n246\t    let latency = started.elapsed();\n247\t    let response_tokens = token_count(&response.content);\n248\t    let latency_ms = u32::try_from(latency.as_millis()).unwrap_or(u32::MAX);\n249\t    enforce_budget(\n250\t        ctx,\n251\t        services,\n252\t        kind,\n253\t        BudgetUsage {\n254\t            prompt_tokens,\n255\t            response_tokens,\n256\t            latency_ms,\n257\t            cost_micro_usd: estimate_cost_micro_usd(prompt_tokens, response_tokens),\n258\t        },\n259\t    )?;\n260\t    let value = parse_response(ctx, services, kind, response.clone())?;\n261\t    let provenance = LlmProvenance::record(\n262\t        services.driver.name(),\n263\t        prompt.as_bytes(),\n264\t        response.content.as_bytes(),\n265\t        prompt_tokens,\n266\t        response_tokens,\n267\t        latency,\n268\t    )\n269\t    .map_err(|e| LlmJobError::Provenance(e.to_string()))?;\n270\t    Ok(LlmCompletion { value, provenance })\n271\t}\n272\t\n273\tfn parse_response<T>(\n274\t    ctx: &LlmJobContext,\n275\t    services: &LlmJobServices<'_>,\n276\t    kind: ConsolidationJobKind,\n277\t    response: LlmResponse,\n278\t) -> Result<T, LlmJobError>\n279\twhere\n280\t    T: serde::de::DeserializeOwned,\n281\t{\n282\t    serde_json::from_str(&response.content).map_err(|error| {\n283\t        let job_error = LlmJobError::MalformedResponse(error.to_string());\n284\t        let _ = emit_failure(\n285\t            ctx,\n286\t            services.event_writer,\n287\t            services.driver.name(),\n288\t            kind,\n289\t            &job_error,\n290\t        );\n291\t        job_error\n292\t    })\n293\t}\n294\t\n295\tfn fail_driver<T>(\n296\t    ctx: &LlmJobContext,\n297\t    services: &LlmJobServices<'_>,\n298\t    kind: ConsolidationJobKind,\n299\t    error: LlmDriverError,\n300\t) -> Result<T, LlmJobError> {\n301\t    let job_error = LlmJobError::DriverError(error);\n302\t    emit_failure(\n303\t        ctx,\n304\t        services.event_writer,\n305\t        services.driver.name(),\n306\t        kind,\n307\t        &job_error,\n308\t    )?;\n309\t    Err(job_error)\n310\t}\n311\t\n312\tpub(crate) fn submit_memory_proposal(\n313\t    ctx: &LlmJobContext,\n314\t    services: &mut LlmJobServices<'_>,\n315\t    kind: ConsolidationJobKind,\n316\t    target: ProposalTarget,\n317\t    proposal_kind: ProposalKind,\n318\t    prior_state: Value,\n319\t    proposed_state: Value,\n320\t    evidence: Value,\n321\t    provenance: Option<LlmProvenance>,\n322\t) -> Result<Option<crate::consolidation::ConsolidationProposal>, LlmJobError> {\n323\t    let proposal_id = stable_id(kind.as_str(), \"proposal\");\n324\t    let job_id = stable_id(kind.as_str(), \"job\");\n325\t    let job = ConsolidationJobSpec {\n326\t        job_id,\n327\t        workspace_id: ctx.workspace_id.clone(),\n328\t        kind: kind.as_str().to_string(),\n329\t        mode: ctx.mode,\n330\t        proposal: Some(PendingProposalSpec {\n331\t            proposal_id,\n332\t            target_memory_id: target.memory_id().map(str::to_string),\n333\t            proposal_kind,\n334\t            prior_state,\n335\t            proposed_state,\n336\t            evidence,\n337\t            provenance,\n338\t        }),\n339\t    };\n340\t    let (_, proposal) = services.runtime.submit_inline(job)?;\n341\t    Ok(proposal)\n342\t}\n343\t\n344\tfn enforce_budget(\n345\t    ctx: &LlmJobContext,\n346\t    services: &LlmJobServices<'_>,\n347\t    kind: ConsolidationJobKind,\n348\t    usage: BudgetUsage,\n349\t) -> Result<(), LlmJobError> {\n350\t    match ctx.budget_catalog.require_within(kind, usage) {\n351\t        Ok(()) => Ok(()),\n352\t        Err(error) => {\n353\t            warn_budget_overrun(ctx, kind, usage, &error);\n354\t            let job_error = LlmJobError::BudgetExceeded(error.to_string());\n355\t            emit_failure(\n356\t                ctx,\n357\t                services.event_writer,\n358\t                services.driver.name(),\n359\t                kind,\n360\t                &job_error,\n361\t            )?;\n362\t            Err(job_error)\n363\t        }\n364\t    }\n365\t}\n366\t\n367\tfn warn_budget_overrun(\n368\t    ctx: &LlmJobContext,\n369\t    kind: ConsolidationJobKind,\n370\t    usage: BudgetUsage,\n371\t    error: &BudgetError,\n372\t) {\n373\t    let budget = ctx.budget_catalog.for_kind(kind);\n374\t    warn!(\n375\t        workspace_id = ctx.workspace_id.as_str(),\n376\t        kind = kind.as_str(),\n377\t        actual_prompt_tokens = usage.prompt_tokens,\n378\t        budget_prompt_tokens = budget.max_prompt_tokens,\n379\t        actual_response_tokens = usage.response_tokens,\n380\t        budget_response_tokens = budget.max_response_tokens,\n381\t        actual_latency_ms = usage.latency_ms,\n382\t        budget_latency_ms = budget.max_latency_ms,\n383\t        actual_cost_micro_usd = usage.cost_micro_usd,\n384\t        budget_cost_micro_usd = budget.max_cost_micro_usd,\n385\t        error = error.to_string().as_str(),\n386\t        \"LLM consolidation budget exceeded\"\n387\t    );\n388\t}\n389\t\n390\tfn token_count(text: &str) -> u32 {\n391\t    let count = text.split_whitespace().count();\n392\t    u32::try_from(count.max(1)).unwrap_or(u32::MAX)\n393\t}\n394\t\n395\tfn estimate_cost_micro_usd(prompt_tokens: u32, response_tokens: u32) -> u32 {\n396\t    prompt_tokens\n397\t        .saturating_add(response_tokens.saturating_mul(2))\n398\t        .saturating_div(10)\n399\t        .max(1)\n400\t}\n401\t\n402\tpub(crate) fn emit_failure(\n403\t    ctx: &LlmJobContext,\n404\t    event_writer: &EventWriter,\n405\t    model_name: &str,\n406\t    kind: ConsolidationJobKind,\n407\t    error: &LlmJobError,\n408\t) -> Result<(), LlmJobError> {\n409\t    let payload = ConsolidationFailedPayload {\n410\t        job_id: stable_id(kind.as_str(), \"job\"),\n411\t        job_kind: kind.as_str().to_string(),\n412\t        mode: ctx.mode.as_str().to_string(),\n413\t        model_name: model_name.to_string(),\n414\t        error_kind: error_kind(error).to_string(),\n415\t        error_message: error.to_string(),\n416\t    };\n417\t    warn!(\n418\t        workspace_id = ctx.workspace_id.as_str(),\n419\t        job_kind = payload.job_kind.as_str(),\n420\t        mode = payload.mode.as_str(),\n421\t        error_kind = payload.error_kind.as_str(),\n422\t        error_message = payload.error_message.as_str(),\n423\t        \"LLM consolidation failed\"\n424\t    );\n425\t    event_writer\n426\t        .append(PartialEnvelope {\n427\t            workspace_id: Some(ctx.workspace_id.clone()),\n428\t            branch: BranchRef {\n429\t                name: \"main\".to_string(),\n430\t            },\n431\t            session_id: SessionId {\n432\t                value: \"llm-consolidation\".to_string(),\n433\t            },\n434\t            task_id: None,\n435\t            actor: Actor::Daemon,\n436\t            kind: EventKind::ConsolidationFailed,\n437\t            references: Vec::new(),\n438\t            summary: CompactSummary::new(format!(\n439\t                \"LLM consolidation {} failed: {}\",\n440\t                kind.as_str(),\n441\t                error_kind(error)\n442\t            ))\n443\t            .map_err(|e| LlmJobError::Storage(e.to_string()))?,\n444\t            payload: EventPayload::ConsolidationFailed(payload),\n445\t        })\n446\t        .map_err(|e| LlmJobError::Storage(e.to_string()))?;\n447\t    Ok(())\n448\t}\n449\t\n450\tpub(crate) fn malformed_with_event(\n451\t    ctx: &LlmJobContext,\n452\t    services: &LlmJobServices<'_>,\n453\t    kind: ConsolidationJobKind,\n454\t    message: impl Into<String>,\n455\t) -> LlmJobError {\n456\t    let error = LlmJobError::MalformedResponse(message.into());\n457\t    let _ = emit_failure(\n458\t        ctx,\n459\t        services.event_writer,\n460\t        services.driver.name(),\n461\t        kind,\n462\t        &error,\n463\t    );\n464\t    error\n465\t}\n466\t\n467\tpub(crate) fn memory_state(\n468\t    memory: Memory,\n469\t    fields: MemoryStructuredFields,\n470\t    links: Vec<MemoryLinkRecord>,\n471\t) -> Result<Value, LlmJobError> {\n472\t    serde_json::to_value(ConsolidationMemoryState {\n473\t        memory,\n474\t        structured_fields: fields,\n475\t        last_verified_at: None,\n476\t        memory_links: links,\n477\t    })\n478\t    .map_err(|e| LlmJobError::MalformedResponse(e.to_string()))\n479\t}\n480\t\n481\tpub(crate) fn create_memory(\n482\t    ctx: &LlmJobContext,\n483\t    content: String,\n484\t    memory_type: MemoryType,\n485\t    refresh_key: String,\n486\t    source_query: String,\n487\t    confidence: f64,\n488\t) -> Memory {\n489\t    Memory {\n490\t        id: stable_id(&refresh_key, \"memory\"),\n491\t        session_id: \"llm-consolidation\".to_string(),\n492\t        content,\n493\t        memory_type,\n494\t        scope: MemoryScope::Session,\n495\t        confidence,\n496\t        linked_symbols: Vec::new(),\n497\t        linked_files: Vec::new(),\n498\t        workspace_id: Some(ctx.workspace_id.clone()),\n499\t        branch: Some(\"main\".to_string()),\n500\t        refresh_key: Some(refresh_key),\n501\t        source_query: Some(source_query),\n502\t        created_at: 0,\n503\t        last_accessed: 0,\n504\t        access_count: 0,\n505\t        is_stale: false,\n506\t        stale_reason: None,\n507\t    }\n508\t}\n509\t\n510\tpub(crate) fn structured_fields(\n511\t    assertion_type: MemoryAssertionType,\n512\t    verification_status: MemoryVerificationStatus,\n513\t    confidence_reason: String,\n514\t    evidence_detail: String,\n515\t) -> MemoryStructuredFields {\n516\t    MemoryStructuredFields {\n517\t        assertion_type,\n518\t        verification_status,\n519\t        confidence_reason: Some(confidence_reason),\n520\t        supersedes_memory_id: None,\n521\t        superseded_by_memory_id: None,\n522\t        contradicts_memory_ids: Vec::new(),\n523\t        contradicted_by_memory_ids: Vec::new(),\n524\t        freshness_policy: MemoryFreshnessPolicy::SessionScoped,\n525\t        freshness_policy_detail: None,\n526\t        provenance: vec![MemoryProvenance {\n527\t            source: \"llm_consolidation\".to_string(),\n528\t            reference: None,\n529\t            captured_at: Some(now_unix_micros().max(0) as u64),\n530\t            note: Some(\"proposal-only LLM consolidation candidate\".to_string()),\n531\t        }],\n532\t        evidence: vec![MemoryEvidence {\n533\t            kind: \"llm_consolidation\".to_string(),\n534\t            reference: None,\n535\t            detail: Some(evidence_detail),\n536\t            captured_at: Some(now_unix_micros().max(0) as u64),\n537\t        }],\n538\t    }\n539\t}\n540\t\n541\tpub(crate) fn existing_state(\n542\t    memory_store: &MemoryStore,\n543\t    memory: &Memory,\n544\t) -> Result<Value, LlmJobError> {\n545\t    crate::consolidation::capture_memory_state(memory_store, memory)\n546\t        .map(|state| crate::consolidation::encode_memory_state(&state))\n547\t        .map_err(Into::into)\n548\t}\n549\t\n550\tpub(crate) fn stable_id(seed: &str, prefix: &str) -> String {\n551\t    let mut hash = 14_695_981_039_346_656_037_u64;\n552\t    for byte in seed.as_bytes() {\n553\t        hash ^= u64::from(*byte);\n554\t        hash = hash.wrapping_mul(1_099_511_628_211);\n555\t    }\n556\t    format!(\"{prefix}-{hash:016x}-{}\", now_unix_micros().max(0))\n557\t}\n558\t\n559\tfn error_kind(error: &LlmJobError) -> &'static str {\n560\t    match error {\n561\t        LlmJobError::ForbiddenOnHotPath(_) => \"forbidden_on_hot_path\",\n562\t        LlmJobError::DriverError(_) => \"driver_error\",\n563\t        LlmJobError::MalformedResponse(_) => \"malformed_response\",\n564\t        LlmJobError::BudgetExceeded(_) => \"budget_exceeded\",\n565\t        LlmJobError::Provenance(_) => \"provenance\",\n566\t        LlmJobError::Storage(_) => \"storage\",\n567\t    }\n568\t}\n569\t"}]},"parent_tool_use_id":null,"session_id":"67f9c4ff-29cf-4b48-8541-b2a63bf25834","uuid":"07695024-fae3-4ebc-816a-450efe5918a7","timestamp":"2026-05-17T11:41:38.164Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/consolidation/llm/mod.rs","content":"//! LLM-driven consolidation jobs for proposal-only memory changes.\n//!\n//! This module implements `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 6. Consolidation Engine` \"LLM-driven consolidation\" and supports the\n//! `## Phase 6: Consolidation Engine` DoD that repeated traces produce\n//! procedures, recurring diagnostics produce failure patterns, and consolidation\n//! stays auditable, reversible, and test-covered.\n//!\n//! Required LLM-driven constraints from `## 6. Consolidation Engine`:\n//!\n//! - each LLM-driven job produces a proposal record, not a direct write; proposals require explicit apply or reject before altering durable memory\n//! - failed or malformed LLM responses must leave the prior memory state unchanged and emit a consolidation failure event\n//! - LLM-driven jobs run only in background or manual review modes, never on the synchronous post-task hot path\n//! - each job records its model, prompt hash, and response hash as part of the proposal provenance so outputs are auditable and reproducible\n//! - consolidation queue depth must be bounded; when the queue is full, new jobs are dropped with a log warning rather than stalling the daemon\n//! - cost and latency budgets for LLM consolidation should be documented per job type before Phase 6 begins; jobs exceeding budget must fall back to deterministic approximations or skip with a stale flag\n\nuse std::time::Instant;\n\nuse serde::{Deserialize, Serialize};\nuse serde_json::Value;\nuse tracing::{field, info_span, warn};\n\nuse crate::consolidation::{\n    empty_state, now_unix_micros, ConsolidationJobMode, ConsolidationJobRuntime,\n    ConsolidationJobSpec, ConsolidationMemoryState, PendingProposalSpec, ProposalKind,\n    ProposalTarget,\n};\nuse crate::error::LatticeError;\nuse crate::events::{\n    Actor, BranchRef, CompactSummary, ConsolidationFailedPayload, EventKind, EventPayload,\n    EventWriter, PartialEnvelope, SessionId,\n};\nuse crate::memory::model::{MemoryAssertionType, MemoryFreshnessPolicy, MemoryProvenance};\nuse crate::memory::{\n    Memory, MemoryEvidence, MemoryLinkRecord, MemoryScope, MemoryStore, MemoryStructuredFields,\n    MemoryType, MemoryVerificationStatus,\n};\n\npub mod budget;\npub mod contradiction;\npub mod episode;\npub mod failure_pattern;\npub mod procedure;\npub mod provenance;\n\n#[cfg(test)]\nmod llm_tests;\n#[cfg(test)]\nmod provenance_tests;\n\npub use budget::{\n    BudgetCatalog, BudgetError, BudgetOutcome, BudgetUsage, DeterministicFallback, LlmBudget,\n};\npub use contradiction::{ContradictionCandidatePair, ContradictionDetectionJob};\npub use episode::{EpisodeMemoryCandidate, EpisodeSummaryJob};\npub use failure_pattern::{DiagnosticCluster, FailurePatternJob, FailurePatternMemoryCandidate};\npub use procedure::{ProcedureExtractionJob, ProcedureMemoryCandidate, WorkflowOccurrence};\npub use provenance::{LlmProvenance, ProvenanceError};\n\npub type ConsolidationMode = ConsolidationJobMode;\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct LlmRequest {\n    pub workspace_id: String,\n    pub job_kind: ConsolidationJobKind,\n    pub prompt: String,\n    pub response_schema: String,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct LlmResponse {\n    pub content: String,\n}\n\npub trait LlmDriver {\n    fn complete(&self, request: LlmRequest) -> Result<LlmResponse, LlmDriverError>;\n    fn name(&self) -> &str;\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]\npub enum LlmDriverError {\n    #[error(\"LLM driver unavailable: {0}\")]\n    Unavailable(String),\n    #[error(\"LLM driver budget exceeded: {0}\")]\n    BudgetExceeded(String),\n    #[error(\"LLM driver failed: {0}\")]\n    Failed(String),\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct LlmJobContext {\n    pub workspace_id: String,\n    pub mode: ConsolidationMode,\n    pub budget_catalog: BudgetCatalog,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum ConsolidationJobKind {\n    EpisodeSummary,\n    ProcedureExtraction,\n    ContradictionDetection,\n    FailurePatternExtraction,\n}\n\nimpl ConsolidationJobKind {\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::EpisodeSummary => \"episode_summary\",\n            Self::ProcedureExtraction => \"procedure_extraction\",\n            Self::ContradictionDetection => \"contradiction_detection\",\n            Self::FailurePatternExtraction => \"failure_pattern_extraction\",\n        }\n    }\n}\n\n#[derive(Debug, thiserror::Error)]\npub enum LlmJobError {\n    #[error(\"LLM consolidation job `{0}` is forbidden on the synchronous post-task hot path\")]\n    ForbiddenOnHotPath(&'static str),\n    #[error(transparent)]\n    DriverError(#[from] LlmDriverError),\n    #[error(\"malformed LLM response: {0}\")]\n    MalformedResponse(String),\n    #[error(\"LLM budget exceeded: {0}\")]\n    BudgetExceeded(String),\n    #[error(\"LLM provenance failed: {0}\")]\n    Provenance(String),\n    #[error(\"consolidation storage failed: {0}\")]\n    Storage(String),\n}\n\nimpl From<LatticeError> for LlmJobError {\n    fn from(value: LatticeError) -> Self {\n        Self::Storage(value.to_string())\n    }\n}\n\npub(crate) struct LlmCompletion<T> {\n    pub value: T,\n    pub provenance: LlmProvenance,\n}\n\npub struct LlmJobServices<'a> {\n    pub driver: &'a dyn LlmDriver,\n    pub runtime: &'a mut ConsolidationJobRuntime,\n    pub memory_store: &'a MemoryStore,\n    pub event_writer: &'a EventWriter,\n}\n\npub enum LlmJobInput {\n    EpisodeSummary(Vec<crate::events::EventEnvelope>),\n    ProcedureExtraction {\n        workflow_id: String,\n        occurrences: Vec<WorkflowOccurrence>,\n    },\n    ContradictionDetection(ContradictionCandidatePair),\n    FailurePatternExtraction(DiagnosticCluster),\n}\n\npub fn dispatch_llm_job(\n    ctx: &LlmJobContext,\n    services: &mut LlmJobServices<'_>,\n    input: LlmJobInput,\n) -> Result<Option<crate::consolidation::ConsolidationProposal>, LlmJobError> {\n    forbid_hot_path(ctx, input.kind())?;\n    match input {\n        LlmJobInput::EpisodeSummary(slice) => EpisodeSummaryJob::run(ctx, services, &slice),\n        LlmJobInput::ProcedureExtraction {\n            workflow_id,\n            occurrences,\n        } => ProcedureExtractionJob::run(ctx, services, &workflow_id, &occurrences),\n        LlmJobInput::ContradictionDetection(pair) => {\n            ContradictionDetectionJob::run(ctx, services, &pair)\n        }\n        LlmJobInput::FailurePatternExtraction(cluster) => {\n            FailurePatternJob::run(ctx, services, &cluster)\n        }\n    }\n}\n\nimpl LlmJobInput {\n    fn kind(&self) -> ConsolidationJobKind {\n        match self {\n            Self::EpisodeSummary(_) => ConsolidationJobKind::EpisodeSummary,\n            Self::ProcedureExtraction { .. } => ConsolidationJobKind::ProcedureExtraction,\n            Self::ContradictionDetection(_) => ConsolidationJobKind::ContradictionDetection,\n            Self::FailurePatternExtraction(_) => ConsolidationJobKind::FailurePatternExtraction,\n        }\n    }\n}\n\npub(crate) fn forbid_hot_path(\n    ctx: &LlmJobContext,\n    kind: ConsolidationJobKind,\n) -> Result<(), LlmJobError> {\n    if ctx.mode == ConsolidationMode::SynchronousPostTask {\n        return Err(LlmJobError::ForbiddenOnHotPath(kind.as_str()));\n    }\n    Ok(())\n}\n\npub(crate) fn complete_structured_with_provenance<T>(\n    ctx: &LlmJobContext,\n    services: &mut LlmJobServices<'_>,\n    kind: ConsolidationJobKind,\n    prompt: String,\n    response_schema: &str,\n) -> Result<LlmCompletion<T>, LlmJobError>\nwhere\n    T: serde::de::DeserializeOwned,\n{\n    let prompt_tokens = token_count(&prompt);\n    enforce_budget(\n        ctx,\n        services,\n        kind,\n        BudgetUsage {\n            prompt_tokens,\n            response_tokens: 0,\n            latency_ms: 0,\n            cost_micro_usd: estimate_cost_micro_usd(prompt_tokens, 0),\n        },\n    )?;\n    let _span = info_span!(\n        \"llm_consolidation\",\n        job_kind = kind.as_str(),\n        workspace_id = ctx.workspace_id.as_str(),\n        mode = ctx.mode.as_str(),\n        model_name = services.driver.name(),\n        outcome = field::Empty\n    )\n    .entered();\n    let request = LlmRequest {\n        workspace_id: ctx.workspace_id.clone(),\n        job_kind: kind,\n        prompt: prompt.clone(),\n        response_schema: response_schema.to_string(),\n    };\n    let started = Instant::now();\n    let response = match services.driver.complete(request) {\n        Ok(response) => response,\n        Err(error) => return fail_driver(ctx, services, kind, error),\n    };\n    let latency = started.elapsed();\n    let response_tokens = token_count(&response.content);\n    let latency_ms = u32::try_from(latency.as_millis()).unwrap_or(u32::MAX);\n    enforce_budget(\n        ctx,\n        services,\n        kind,\n        BudgetUsage {\n            prompt_tokens,\n            response_tokens,\n            latency_ms,\n            cost_micro_usd: estimate_cost_micro_usd(prompt_tokens, response_tokens),\n        },\n    )?;\n    let value = parse_response(ctx, services, kind, response.clone())?;\n    let provenance = LlmProvenance::record(\n        services.driver.name(),\n        prompt.as_bytes(),\n        response.content.as_bytes(),\n        prompt_tokens,\n        response_tokens,\n        latency,\n    )\n    .map_err(|e| LlmJobError::Provenance(e.to_string()))?;\n    Ok(LlmCompletion { value, provenance })\n}\n\nfn parse_response<T>(\n    ctx: &LlmJobContext,\n    services: &LlmJobServices<'_>,\n    kind: ConsolidationJobKind,\n    response: LlmResponse,\n) -> Result<T, LlmJobError>\nwhere\n    T: serde::de::DeserializeOwned,\n{\n    serde_json::from_str(&response.content).map_err(|error| {\n        let job_error = LlmJobError::MalformedResponse(error.to_string());\n        let _ = emit_failure(\n            ctx,\n            services.event_writer,\n            services.driver.name(),\n            kind,\n            &job_error,\n        );\n        job_error\n    })\n}\n\nfn fail_driver<T>(\n    ctx: &LlmJobContext,\n    services: &LlmJobServices<'_>,\n    kind: ConsolidationJobKind,\n    error: LlmDriverError,\n) -> Result<T, LlmJobError> {\n    let job_error = LlmJobError::DriverError(error);\n    emit_failure(\n        ctx,\n        services.event_writer,\n        services.driver.name(),\n        kind,\n        &job_error,\n    )?;\n    Err(job_error)\n}\n\npub(crate) fn submit_memory_proposal(\n    ctx: &LlmJobContext,\n    services: &mut LlmJobServices<'_>,\n    kind: ConsolidationJobKind,\n    target: ProposalTarget,\n    proposal_kind: ProposalKind,\n    prior_state: Value,\n    proposed_state: Value,\n    evidence: Value,\n    provenance: Option<LlmProvenance>,\n) -> Result<Option<crate::consolidation::ConsolidationProposal>, LlmJobError> {\n    let proposal_id = stable_id(kind.as_str(), \"proposal\");\n    let job_id = stable_id(kind.as_str(), \"job\");\n    let job = ConsolidationJobSpec {\n        job_id,\n        workspace_id: ctx.workspace_id.clone(),\n        kind: kind.as_str().to_string(),\n        mode: ctx.mode,\n        proposal: Some(PendingProposalSpec {\n            proposal_id,\n            target_memory_id: target.memory_id().map(str::to_string),\n            proposal_kind,\n            prior_state,\n            proposed_state,\n            evidence,\n            provenance,\n        }),\n    };\n    let (_, proposal) = services.runtime.submit_inline(job)?;\n    Ok(proposal)\n}\n\nfn enforce_budget(\n    ctx: &LlmJobContext,\n    services: &LlmJobServices<'_>,\n    kind: ConsolidationJobKind,\n    usage: BudgetUsage,\n) -> Result<(), LlmJobError> {\n    match ctx.budget_catalog.require_within(kind, usage) {\n        Ok(()) => Ok(()),\n        Err(error) => {\n            warn_budget_overrun(ctx, kind, usage, &error);\n            let job_error = LlmJobError::BudgetExceeded(error.to_string());\n            emit_failure(\n                ctx,\n                services.event_writer,\n                services.driver.name(),\n                kind,\n                &job_error,\n            )?;\n            Err(job_error)\n        }\n    }\n}\n\nfn warn_budget_overrun(\n    ctx: &LlmJobContext,\n    kind: ConsolidationJobKind,\n    usage: BudgetUsage,\n    error: &BudgetError,\n) {\n    let budget = ctx.budget_catalog.for_kind(kind);\n    warn!(\n        workspace_id = ctx.workspace_id.as_str(),\n        kind = kind.as_str(),\n        actual_prompt_tokens = usage.prompt_tokens,\n        budget_prompt_tokens = budget.max_prompt_tokens,\n        actual_response_tokens = usage.response_tokens,\n        budget_response_tokens = budget.max_response_tokens,\n        actual_latency_ms = usage.latency_ms,\n        budget_latency_ms = budget.max_latency_ms,\n        actual_cost_micro_usd = usage.cost_micro_usd,\n        budget_cost_micro_usd = budget.max_cost_micro_usd,\n        error = error.to_string().as_str(),\n        \"LLM consolidation budget exceeded\"\n    );\n}\n\nfn token_count(text: &str) -> u32 {\n    let count = text.split_whitespace().count();\n    u32::try_from(count.max(1)).unwrap_or(u32::MAX)\n}\n\nfn estimate_cost_micro_usd(prompt_tokens: u32, response_tokens: u32) -> u32 {\n    prompt_tokens\n        .saturating_add(response_tokens.saturating_mul(2))\n        .saturating_div(10)\n        .max(1)\n}\n\npub(crate) fn emit_failure(\n    ctx: &LlmJobContext,\n    event_writer: &EventWriter,\n    model_name: &str,\n    kind: ConsolidationJobKind,\n    error: &LlmJobError,\n) -> Result<(), LlmJobError> {\n    let payload = ConsolidationFailedPayload {\n        job_id: stable_id(kind.as_str(), \"job\"),\n        job_kind: kind.as_str().to_string(),\n        mode: ctx.mode.as_str().to_string(),\n        model_name: model_name.to_string(),\n        error_kind: error_kind(error).to_string(),\n        error_message: error.to_string(),\n    };\n    warn!(\n        workspace_id = ctx.workspace_id.as_str(),\n        job_kind = payload.job_kind.as_str(),\n        mode = payload.mode.as_str(),\n        error_kind = payload.error_kind.as_str(),\n        error_message = payload.error_message.as_str(),\n        \"LLM consolidation failed\"\n    );\n    event_writer\n        .append(PartialEnvelope {\n            workspace_id: Some(ctx.workspace_id.clone()),\n            branch: BranchRef {\n                name: \"main\".to_string(),\n            },\n            session_id: SessionId {\n                value: \"llm-consolidation\".to_string(),\n            },\n            task_id: None,\n            actor: Actor::Daemon,\n            kind: EventKind::ConsolidationFailed,\n            references: Vec::new(),\n            summary: CompactSummary::new(format!(\n                \"LLM consolidation {} failed: {}\",\n                kind.as_str(),\n                error_kind(error)\n            ))\n            .map_err(|e| LlmJobError::Storage(e.to_string()))?,\n            payload: EventPayload::ConsolidationFailed(payload),\n        })\n        .map_err(|e| LlmJobError::Storage(e.to_string()))?;\n    Ok(())\n}\n\npub(crate) fn malformed_with_event(\n    ctx: &LlmJobContext,\n    services: &LlmJobServices<'_>,\n    kind: ConsolidationJobKind,\n    message: impl Into<String>,\n) -> LlmJobError {\n    let error = LlmJobError::MalformedResponse(message.into());\n    let _ = emit_failure(\n        ctx,\n        services.event_writer,\n        services.driver.name(),\n        kind,\n        &error,\n    );\n    error\n}\n\npub(crate) fn memory_state(\n    memory: Memory,\n    fields: MemoryStructuredFields,\n    links: Vec<MemoryLinkRecord>,\n) -> Result<Value, LlmJobError> {\n    serde_json::to_value(ConsolidationMemoryState {\n        memory,\n        structured_fields: fields,\n        last_verified_at: None,\n        memory_links: links,\n    })\n    .map_err(|e| LlmJobError::MalformedResponse(e.to_string()))\n}\n\npub(crate) fn create_memory(\n    ctx: &LlmJobContext,\n    content: String,\n    memory_type: MemoryType,\n    refresh_key: String,\n    source_query: String,\n    confidence: f64,\n) -> Memory {\n    Memory {\n        id: stable_id(&refresh_key, \"memory\"),\n        session_id: \"llm-consolidation\".to_string(),\n        content,\n        memory_type,\n        scope: MemoryScope::Session,\n        confidence,\n        linked_symbols: Vec::new(),\n        linked_files: Vec::new(),\n        workspace_id: Some(ctx.workspace_id.clone()),\n        branch: Some(\"main\".to_string()),\n        refresh_key: Some(refresh_key),\n        source_query: Some(source_query),\n        created_at: 0,\n        last_accessed: 0,\n        access_count: 0,\n        is_stale: false,\n        stale_reason: None,\n    }\n}\n\npub(crate) fn structured_fields(\n    assertion_type: MemoryAssertionType,\n    verification_status: MemoryVerificationStatus,\n    confidence_reason: String,\n    evidence_detail: String,\n) -> MemoryStructuredFields {\n    MemoryStructuredFields {\n        assertion_type,\n        verification_status,\n        confidence_reason: Some(confidence_reason),\n        supersedes_memory_id: None,\n        superseded_by_memory_id: None,\n        contradicts_memory_ids: Vec::new(),\n        contradicted_by_memory_ids: Vec::new(),\n        freshness_policy: MemoryFreshnessPolicy::SessionScoped,\n        freshness_policy_detail: None,\n        provenance: vec![MemoryProvenance {\n            source: \"llm_consolidation\".to_string(),\n            reference: None,\n            captured_at: Some(now_unix_micros().max(0) as u64),\n            note: Some(\"proposal-only LLM consolidation candidate\".to_string()),\n        }],\n        evidence: vec![MemoryEvidence {\n            kind: \"llm_consolidation\".to_string(),\n            reference: None,\n            detail: Some(evidence_detail),\n            captured_at: Some(now_unix_micros().max(0) as u64),\n        }],\n    }\n}\n\npub(crate) fn existing_state(\n    memory_store: &MemoryStore,\n    memory: &Memory,\n) -> Result<Value, LlmJobError> {\n    crate::consolidation::capture_memory_state(memory_store, memory)\n        .map(|state| crate::consolidation::encode_memory_state(&state))\n        .map_err(Into::into)\n}\n\npub(crate) fn stable_id(seed: &str, prefix: &str) -> String {\n    let mut hash = 14_695_981_039_346_656_037_u64;\n    for byte in seed.as_bytes() {\n        hash ^= u64::from(*byte);\n        hash = hash.wrapping_mul(1_099_511_628_211);\n    }\n    format!(\"{prefix}-{hash:016x}-{}\", now_unix_micros().max(0))\n}\n\nfn error_kind(error: &LlmJobError) -> &'static str {\n    match error {\n        LlmJobError::ForbiddenOnHotPath(_) => \"forbidden_on_hot_path\",\n        LlmJobError::DriverError(_) => \"driver_error\",\n        LlmJobError::MalformedResponse(_) => \"malformed_response\",\n        LlmJobError::BudgetExceeded(_) => \"budget_exceeded\",\n        LlmJobError::Provenance(_) => \"provenance\",\n        LlmJobError::Storage(_) => \"storage\",\n    }\n}\n","numLines":569,"startLine":1,"totalLines":569}}}
