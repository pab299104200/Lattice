{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016Qj7oN7tzKuuiABb6az3SK","type":"tool_result","content":"950\t    /// Replace structured assertion metadata for an existing, non-invalidated memory.\n951\t    pub fn update_structured_fields(\n952\t        &self,\n953\t        id: &str,\n954\t        fields: &MemoryStructuredFields,\n955\t    ) -> Result<(), LatticeError> {\n956\t        record_direct_write();\n957\t        self.persist_structured_fields(id, fields)\n958\t    }\n959\t\n960\t    /// Mark a memory as superseded by another memory id and downgrade verification state.\n961\t    pub fn mark_memory_superseded(\n962\t        &self,\n963\t        id: &str,\n964\t        superseded_by_memory_id: &str,\n965\t    ) -> Result<(), LatticeError> {\n966\t        record_direct_write();\n967\t        let mut fields = self.get_structured_fields(id)?.ok_or_else(|| {\n968\t            LatticeError::Storage(format!(\"Memory '{}' not found or invalidated\", id))\n969\t        })?;\n970\t        fields.superseded_by_memory_id = Some(superseded_by_memory_id.to_string());\n971\t        fields.verification_status = MemoryVerificationStatus::Superseded;\n972\t        self.persist_structured_fields(id, &fields)\n973\t    }\n974\t\n975\t    /// Mark a contradiction edge between two memory rows.\n976\t    pub fn mark_memory_contradicted(\n977\t        &self,\n978\t        id: &str,\n979\t        contradicted_by_memory_id: &str,\n980\t    ) -> Result<(), LatticeError> {\n981\t        record_direct_write();\n982\t        let mut fields = self.get_structured_fields(id)?.ok_or_else(|| {\n983\t            LatticeError::Storage(format!(\"Memory '{}' not found or invalidated\", id))\n984\t        })?;\n985\t        if !fields\n986\t            .contradicted_by_memory_ids\n987\t            .iter()\n988\t            .any(|v| v == contradicted_by_memory_id)\n989\t        {\n990\t            fields\n991\t                .contradicted_by_memory_ids\n992\t                .push(contradicted_by_memory_id.to_string());\n993\t        }\n994\t        fields.verification_status = MemoryVerificationStatus::Contradicted;\n995\t        self.persist_structured_fields(id, &fields)?;\n996\t\n997\t        if let Some(mut contradictor) = self.get_structured_fields(contradicted_by_memory_id)? {\n998\t            if !contradictor.contradicts_memory_ids.iter().any(|v| v == id) {\n999\t                contradictor.contradicts_memory_ids.push(id.to_string());\n1000\t            }\n1001\t            self.persist_structured_fields(contradicted_by_memory_id, &contradictor)?;\n1002\t        }\n1003\t\n1004\t        Ok(())\n1005\t    }\n1006\t\n1007\t    /// Search memories by keyword (per-word AND match on content + linked_symbols). Excludes invalidated.\n1008\t    pub fn search_by_keyword(&self, keyword: &str) -> Result<Vec<Memory>, LatticeError> {\n1009\t        let memories = if let Some(fts_query) = build_fts_query(keyword) {\n1010\t            let sql = format!(\n1011\t                \"SELECT memories.id, memories.session_id, memories.content, memories.memory_type,\n1012\t                        memories.scope, memories.confidence, memories.linked_symbols,\n1013\t                        memories.linked_files, memories.workspace_id, memories.branch,\n1014\t                        memories.refresh_key, memories.source_query, memories.created_at,\n1015\t                        memories.last_accessed, memories.access_count, memories.is_stale,\n1016\t                        memories.stale_reason\n1017\t                 FROM memories\n1018\t                 INNER JOIN {table}\n1019\t                    ON {table}.memory_id = memories.id\n1020\t                 WHERE memories.is_invalidated = 0\n1021\t                   AND {table} MATCH ?1\n1022\t                 ORDER BY memories.created_at DESC\",\n1023\t                table = MEMORIES_FTS_TABLE,\n1024\t            );\n1025\t            self.query_memories(&sql, params![fts_query], \"search memories\")?\n1026\t        } else {\n1027\t            self.query_memories(\n1028\t                \"SELECT id, session_id, content, memory_type, scope, confidence, linked_symbols,\n1029\t                        linked_files, workspace_id, branch, refresh_key, source_query,\n1030\t                        created_at, last_accessed, access_count, is_stale, stale_reason\n1031\t                 FROM memories\n1032\t                 WHERE is_invalidated = 0\n1033\t                 ORDER BY created_at DESC\",\n1034\t                [],\n1035\t                \"search memories\",\n1036\t            )?\n1037\t        };\n1038\t\n1039\t        // Touch each returned memory to update last_accessed\n1040\t        for mem in &memories {\n1041\t            let _ = self.touch_memory(&mem.id);\n1042\t        }\n1043\t\n1044\t        Ok(memories)\n1045\t    }\n1046\t\n1047\t    /// Mark all memories that reference a given symbol as stale with the provided reason.\n1048\t    /// Uses LIKE match on the linked_symbols JSON column.\n1049\t    pub fn mark_stale_by_symbol(\n1050\t        &self,\n1051\t        symbol_name: &str,\n1052\t        reason: &str,\n1053\t    ) -> Result<u64, LatticeError> {\n1054\t        record_direct_write();\n1055\t        // The linked_symbols column stores JSON arrays like [\"foo\",\"bar\"].\n1056\t        // We match symbol names contained inside the JSON string.\n1057\t        let escaped = symbol_name.replace('%', \"\\\\%\").replace('_', \"\\\\_\");\n1058\t        let pattern = format!(\"%\\\"{}\\\"%\", escaped);\n1059\t\n1060\t        let updated = self\n1061\t            .conn\n1062\t            .execute(\n1063\t                \"UPDATE memories\n1064\t                    SET is_stale = 1,\n1065\t                        stale_reason = ?1,\n1066\t                        verification_status = 'stale'\n1067\t                 WHERE is_invalidated = 0 AND linked_symbols LIKE ?2 ESCAPE '\\\\'\",\n1068\t                params![reason, pattern],\n1069\t            )\n