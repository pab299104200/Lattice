{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VffJJA7x3Pvn3gvRV2TEv6","type":"tool_result","content":"1\t// Contract gate R79 — extension ↔ daemon review-UI MCP plumbing.\n2\t//\n3\t// Spawns the real daemon binary from `extension/bin/lattice` (per\n4\t// `lattice/CLAUDE.md ## Deploy`) and exercises one happy-path and one\n5\t// error-path tools/call per review-UI tool consumed by `ReviewRpcBridge`.\n6\t// Every typed response is parsed through the same `normalize*` helper the\n7\t// extension uses at runtime, so any wire-shape drift surfaces here rather\n8\t// than in the webview.\n9\t//\n10\t// Spec anchors:\n11\t//   - `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md` `## 9. MCP Surface`\n12\t//   - `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md` `## MCP Tool Contract Principles`\n13\t//   - `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md` `## 10. Human Review Surface`\n14\t\n15\timport * as assert from 'assert';\n16\timport * as cp from 'child_process';\n17\timport * as fs from 'fs';\n18\timport * as os from 'os';\n19\timport * as path from 'path';\n20\timport { suite, test, suiteSetup, suiteTeardown } from 'mocha';\n21\t\n22\timport {\n23\t    arrayValue,\n24\t    normalizeConflictList,\n25\t    normalizeConsolidationReport,\n26\t    normalizeEventTracePage,\n27\t    normalizeEvolutionProposal,\n28\t    normalizeIndexStatus,\n29\t    normalizeMemory,\n30\t    normalizeMetricSnapshot,\n31\t    normalizeSessionMetrics,\n32\t    normalizeVerifyExplainResponse,\n33\t    recordValue,\n34\t} from '../review/rpcPayloads';\n35\t\n36\tinterface JsonRpcResponse {\n37\t    jsonrpc: '2.0';\n38\t    id: number;\n39\t    result?: unknown;\n40\t    error?: { code: number; message: string; data?: unknown };\n41\t}\n42\t\n43\tinterface McpToolResponse {\n44\t    content?: Array<{ type?: string; text?: string }>;\n45\t}\n46\t\n47\tinterface ContractLog {\n48\t    method: string;\n49\t    params: unknown;\n50\t    response: unknown;\n51\t}\n52\t\n53\tclass DaemonClient {\n54\t    private nextId = 1;\n55\t    private buffer = '';\n56\t    private pending = new Map<number, {\n57\t        resolve: (value: unknown) => void;\n58\t        reject: (reason: Error) => void;\n59\t        timer: NodeJS.Timeout;\n60\t    }>();\n61\t    public readonly transcript: ContractLog[] = [];\n62\t    public stderr = '';\n63\t\n64\t    private constructor(private readonly proc: cp.ChildProcessWithoutNullStreams) {\n65\t        proc.stdout.setEncoding('utf-8');\n66\t        proc.stdout.on('data', (chunk: string) => this.onStdout(chunk));\n67\t        proc.stderr.setEncoding('utf-8');\n68\t        proc.stderr.on('data', (chunk: string) => {\n69\t            this.stderr += chunk;\n70\t        });\n71\t        proc.on('exit', (code, signal) => {\n72\t            for (const [id, pending] of this.pending) {\n73\t                clearTimeout(pending.timer);\n74\t                pending.reject(\n75\t                    new Error(`Daemon exited code=${code} signal=${signal} before responding to id=${id}`)\n76\t                );\n77\t                this.pending.delete(id);\n78\t            }\n79\t        });\n80\t    }\n81\t\n82\t    public static async spawn(binaryPath: string, workspace: string): Promise<DaemonClient> {\n83\t        const proc = cp.spawn(binaryPath, ['--stdio', '--workspace', workspace], {\n84\t            cwd: workspace,\n85\t            stdio: ['pipe', 'pipe', 'pipe'],\n86\t            env: { ...process.env, RUST_LOG: 'warn' },\n87\t        });\n88\t        return new DaemonClient(proc);\n89\t    }\n90\t\n91\t    private onStdout(chunk: string): void {\n92\t        this.buffer += chunk;\n93\t        while (true) {\n94\t            const newline = this.buffer.indexOf('\\n');\n95\t            if (newline === -1) {\n96\t                return;\n97\t            }\n98\t            const line = this.buffer.substring(0, newline).trim();\n99\t            this.buffer = this.buffer.substring(newline + 1);\n100\t            if (!line || !line.startsWith('{')) {\n101\t                continue;\n102\t            }\n103\t            try {\n104\t                const message = JSON.parse(line) as JsonRpcResponse;\n105\t                const pending = this.pending.get(message.id);\n106\t                if (!pending) {\n107\t                    continue;\n108\t                }\n109\t                this.pending.delete(message.id);\n110\t                clearTimeout(pending.timer);\n111\t                if (message.error) {\n112\t                    pending.reject(\n113\t                        new Error(`JSON-RPC error ${message.error.code}: ${message.error.message}`)\n114\t                    );\n115\t                } else {\n116\t                    pending.resolve(message.result);\n117\t                }\n118\t            } catch (error) {\n119\t                console.error('[contract-test] failed to parse line:', line, error);\n120\t            }\n121\t        }\n122\t    }\n123\t\n124\t    public send(method: string, params?: unknown, timeoutMs = 30_000): Promise<unknown> {\n125\t        return new Promise<unknown>((resolve, reject) => {\n126\t            const id = this.nextId++;\n127\t            const request = {\n128\t                jsonrpc: '2.0',\n129\t                id,\n130\t                method,\n131\t                ...(params !== undefined ? { params } : {}),\n132\t            };\n133\t            const timer = setTimeout(() => {\n134\t                this.pending.delete(id);\n135\t                reject(new Error(\n136\t                    `Request ${method} (id=${id}) timed out after ${timeoutMs}ms; stderr=${this.stderr.slice(-2000)}`\n137\t                ));\n138\t            }, timeoutMs);\n139\t            this.pending.set(id, {\n140\t                resolve: (value) => {\n141\t                    this.transcript.push({ method, params, response: value });\n142\t                    resolve(value);\n143\t                },\n144\t                reject,\n145\t                timer,\n146\t            });\n147\t            const serialized = JSON.stringify(request) + '\\n';\n148\t            this.proc.stdin.write(serialized, 'utf-8', (writeError) => {\n149\t                if (writeError) {\n150\t                    this.pending.delete(id);\n151\t                    clearTimeout(timer);\n152\t                    reject(writeError);\n153\t                }\n154\t            });\n155\t        });\n156\t    }\n157\t\n158\t    public async initialize(): Promise<void> {\n159\t        const result = await this.send('initialize', {\n160\t            protocolVersion: '2024-11-05',\n161\t            capabilities: {},\n162\t            clientInfo: { name: 'contract-test', version: '0.0.1' },\n163\t        }, 15_000);\n164\t        const record = recordValue(result);\n165\t        assert.strictEqual(record.protocolVersion, '2024-11-05');\n166\t        assert.ok(typeof record.serverInfo === 'object');\n167\t    }\n168\t\n169\t    public async toolCallRaw(name: string, args: Record<string, unknown>): Promise<unknown> {\n170\t        const response = await this.send('tools/call', {\n171\t            name,\n172\t            arguments: args,\n173\t        }, 60_000) as McpToolResponse;\n174\t        const text = response.content?.find((item) => item.type === 'text')?.text;\n175\t        if (typeof text !== 'string') {\n176\t            throw new Error(`tools/call ${name} returned no text payload: ${JSON.stringify(response)}`);\n177\t        }\n178\t        return JSON.parse(text);\n179\t    }\n180\t\n181\t    public async toolCall(name: string, args: Record<string, unknown>): Promise<Record<string, unknown>> {\n182\t        return recordValue(await this.toolCallRaw(name, args));\n183\t    }\n184\t\n185\t    public async toolCallExpectError(name: string, args: Record<string, unknown>): Promise<string> {\n186\t        try {\n187\t            await this.toolCallRaw(name, args);\n188\t            assert.fail(`Expected tools/call ${name} to fail with arguments ${JSON.stringify(args)}`);\n189\t            return '';\n190\t        } catch (error) {\n191\t            this.transcript.push({\n192\t                method: `tools/call:error:${name}`,\n193\t                params: args,\n194\t                response: error instanceof Error ? error.message : String(error),\n195\t            });\n196\t            return error instanceof Error ? error.message : String(error);\n197\t        }\n198\t    }\n199\t\n200\t    public async dispose(): Promise<void> {\n201\t        try {\n202\t            this.proc.stdin.end();\n203\t        } catch {\n204\t            // ignore\n205\t        }\n206\t        if (!this.proc.killed) {\n207\t            this.proc.kill('SIGTERM');\n208\t        }\n209\t        await new Promise<void>((resolve) => {\n210\t            if (this.proc.exitCode !== null || this.proc.signalCode !== null) {\n211\t                resolve();\n212\t                return;\n213\t            }\n214\t            this.proc.once('exit', () => resolve());\n215\t            setTimeout(() => resolve(), 3_000);\n216\t        });\n217\t    }\n218\t}\n219\t\n220\tfunction resolveDaemonBinary(): string {\n221\t    const candidates = [\n222\t        path.resolve(__dirname, '..', '..', 'bin', 'lattice'),\n223\t        path.resolve(__dirname, '..', '..', '..', 'daemon', 'target', 'release', 'lattice'),\n224\t    ];\n225\t    for (const candidate of candidates) {\n226\t        if (fs.existsSync(candidate)) {\n227\t            return candidate;\n228\t        }\n229\t    }\n230\t    throw new Error(`Lattice daemon binary not found in: ${candidates.join(', ')}`);\n231\t}\n232\t\n233\tasync function seedMemory(client: DaemonClient): Promise<string> {\n234\t    const stored = await client.toolCall('save_observation', {\n235\t        content: 'Contract gate seed memory for R79',\n236\t        memory_type: 'observation',\n237\t        scope: 'session',\n238\t        linked_files: ['README.md'],\n239\t    });\n240\t    const id = stored.id;\n241\t    assert.ok(typeof id === 'string' && id.length > 0, 'save_observation should return a non-empty id');\n242\t    return id as string;\n243\t}\n244\t\n245\tsuite('contract: ReviewRpcBridge ↔ daemon MCP tools', function () {\n246\t    this.timeout(120_000);\n247\t\n248\t    let client: DaemonClient;\n249\t    let workspace: string;\n250\t    let seededMemoryId: string;\n251\t    let proposedEvolutionId: string | undefined;\n252\t\n253\t    suiteSetup(async () => {\n254\t        workspace = fs.mkdtempSync(path.join(os.tmpdir(), 'lattice-contract-'));\n255\t        fs.writeFileSync(path.join(workspace, 'README.md'), '# Contract Test Workspace\\n');\n256\t        client = await DaemonClient.spawn(resolveDaemonBinary(), workspace);\n257\t        await client.initialize();\n258\t        seededMemoryId = await seedMemory(client);\n259\t    });\n260\t\n261\t    suiteTeardown(async () => {\n262\t        if (client) {\n263\t            await client.dispose();\n264\t        }\n265\t        if (workspace && fs.existsSync(workspace)) {\n266\t            try {\n267\t                fs.rmSync(workspace, { recursive: true, force: true });\n268\t            } catch {\n269\t                // best-effort cleanup\n270\t            }\n271\t        }\n272\t    });\n273\t\n274\t    test('list_observations: happy-path returns typed memory list', async () => {\n275\t        const payload = await client.toolCall('list_observations', { limit: 50 });\n276\t        const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n277\t        assert.ok(memories.length >= 1, `expected at least one seeded memory; got ${memories.length}`);\n278\t        const seeded = memories.find((entry) => entry.id === seededMemoryId);\n279\t        assert.ok(seeded, 'seeded memory should be present in list_observations response');\n280\t        assert.strictEqual(seeded?.content, 'Contract gate seed memory for R79');\n281\t        assert.ok(seeded.linkedFiles.includes('README.md'));\n282\t        assert.ok(['observation'].includes(seeded.memoryClass) || seeded.memoryClass.length > 0);\n283\t    });\n284\t\n285\t    test('list_observations: invalid limit shape is gracefully clamped', async () => {\n286\t        // The dispatcher accepts limit as integer but treats non-numeric defaults as 50.\n287\t        // Provide a string and assert the call still returns a typed payload.\n288\t        const payload = await client.toolCall('list_observations', { limit: 'not-a-number' as unknown });\n289\t        const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n290\t        assert.ok(Array.isArray(memories));\n291\t    });\n292\t\n293\t    test('list_stale_memories: happy-path returns typed memory list', async () => {\n294\t        const payload = await client.toolCall('list_stale_memories', { limit: 25 });\n295\t        const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n296\t        assert.ok(typeof payload.count === 'number');\n297\t        assert.ok(Array.isArray(memories));\n298\t    });\n299\t\n300\t    test('list_stale_memories: oversize limit is clamped to ≤200', async () => {\n301\t        const payload = await client.toolCall('list_stale_memories', { limit: 9999 });\n302\t        const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n303\t        assert.ok(memories.length <= 200);\n304\t    });\n305\t\n306\t    test('index_status: happy-path returns typed snapshot', async () => {\n307\t        const payload = await client.toolCall('index_status', {});\n308\t        const snapshot = normalizeIndexStatus(payload);\n309\t        assert.ok(['ready', 'indexing'].includes(snapshot.status));\n310\t        assert.strictEqual(typeof snapshot.version, 'string');\n311\t        assert.strictEqual(typeof snapshot.workspace, 'string');\n312\t        assert.ok(snapshot.workspace.length > 0);\n313\t        assert.strictEqual(typeof snapshot.nodes, 'number');\n314\t        assert.strictEqual(typeof snapshot.edges, 'number');\n315\t        assert.strictEqual(typeof snapshot.files, 'number');\n316\t        assert.ok(typeof snapshot.languages === 'object' && snapshot.languages !== null);\n317\t    });\n318\t\n319\t    test('get_session_metrics: happy-path returns typed session metrics', async () => {\n320\t        const raw = await client.toolCallRaw('get_session_metrics', {});\n321\t        const metrics = normalizeSessionMetrics(raw);\n322\t        assert.strictEqual(typeof metrics.totalToolCalls, 'number');\n323\t        assert.strictEqual(typeof metrics.workflowToolCalls, 'number');\n324\t        assert.strictEqual(typeof metrics.totalPayloadTokens, 'number');\n325\t        assert.strictEqual(typeof metrics.averagePayloadTokensPerTool, 'number');\n326\t        assert.strictEqual(typeof metrics.totalPayloadBytes, 'number');\n327\t        assert.strictEqual(typeof metrics.averagePayloadBytesPerTool, 'number');\n328\t        assert.strictEqual(typeof metrics.contextHandleReuses, 'number');\n329\t        assert.strictEqual(typeof metrics.contextHandleReuseRate, 'number');\n330\t    });\n331\t\n332\t    test('get_memory_metrics: happy-path returns typed metric snapshot', async () => {\n333\t        const payload = await client.toolCall('get_memory_metrics', {\n334\t            scope: 'session',\n335\t            render_mode: 'compact',\n336\t        });\n337\t        const snapshot = normalizeMetricSnapshot(payload);\n338\t        assert.strictEqual(typeof snapshot.scope, 'string');\n339\t        assert.strictEqual(typeof snapshot.renderMode, 'string');\n340\t        assert.strictEqual(typeof snapshot.incomplete, 'boolean');\n341\t        assert.ok(Array.isArray(snapshot.notes));\n342\t        assert.ok(Array.isArray(snapshot.signals));\n343\t        for (const signal of snapshot.signals) {\n344\t            assert.strictEqual(typeof signal.signal, 'string');\n345\t            assert.ok(signal.value === null || typeof signal.value === 'number');\n346\t        }\n347\t    });\n348\t\n349\t    test('get_memory_metrics: invalid scope rejected by serde', async () => {\n350\t        const message = await client.toolCallExpectError('get_memory_metrics', {\n351\t            scope: 'not-a-real-scope',\n352\t        });\n353\t        assert.ok(message.length > 0, 'invalid scope must surface a JSON-RPC error');\n354\t    });\n355\t\n356\t    test('get_event_trace: happy-path returns typed paginated page', async () => {\n357\t        const payload = await client.toolCall('get_event_trace', {\n358\t            workspace_id: workspace,\n359\t            limit: 25,\n360\t            render_mode: 'full',\n361\t        });\n362\t        const page = normalizeEventTracePage(payload);\n363\t        assert.strictEqual(typeof page.renderMode, 'string');\n364\t        assert.ok(typeof page.scope.kind === 'string' && page.scope.kind.length > 0);\n365\t        assert.ok(Array.isArray(page.events));\n366\t        for (const event of page.events) {\n367\t            assert.strictEqual(typeof event.eventId, 'string');\n368\t            assert.strictEqual(typeof event.expansionHandle, 'string');\n369\t            assert.strictEqual(typeof event.kind, 'string');\n370\t            assert.strictEqual(typeof event.timestamp, 'string');\n371\t            assert.strictEqual(typeof event.workspaceId, 'string');\n372\t            assert.strictEqual(typeof event.summary, 'string');\n373\t            assert.ok(Array.isArray(event.references));\n374\t        }\n375\t    });\n376\t\n377\t    test('get_event_trace: missing scope is rejected', async () => {\n378\t        const message = await client.toolCallExpectError('get_event_trace', {\n379\t            limit: 25,\n380\t        });\n381\t        assert.ok(\n382\t            message.includes('task_id') ||\n383\t                message.includes('session_id') ||\n384\t                message.includes('workspace_id') ||\n385\t                message.toLowerCase().includes('scope'),\n386\t            `expected scope-required error, got: ${message}`\n387\t        );\n388\t    });\n389\t\n390\t    test('consolidate_session: happy-path returns typed consolidation report', async () => {\n391\t        const payload = await client.toolCall('consolidate_session', {\n392\t            session_id: 'contract-test-session',\n393\t            mode: 'manual_review',\n394\t            render_mode: 'diagnostic',\n395\t        });\n396\t        const report = normalizeConsolidationReport(payload);\n397\t        assert.strictEqual(report.sessionId, 'contract-test-session');\n398\t        assert.strictEqual(report.mode, 'manual_review');\n399\t        assert.strictEqual(report.renderMode, 'diagnostic');\n400\t        assert.strictEqual(typeof report.incomplete, 'boolean');\n401\t        assert.ok(Array.isArray(report.notes));\n402\t        assert.ok(Array.isArray(report.proposals));\n403\t        assert.ok(Array.isArray(report.categories));\n404\t    });\n405\t\n406\t    test('consolidate_session: empty session_id is rejected', async () => {\n407\t        const message = await client.toolCallExpectError('consolidate_session', {\n408\t            session_id: '',\n409\t            mode: 'manual_review',\n410\t        });\n411\t        assert.ok(\n412\t            message.toLowerCase().includes('session_id'),\n413\t            `expected session_id validation error, got: ${message}`\n414\t        );\n415\t    });\n416\t\n417\t    test('propose_memory_evolution: action=propose returns typed proposal', async () => {\n418\t        const payload = await client.toolCall('propose_memory_evolution', {\n419\t            action: 'propose',\n420\t            memory_id: seededMemoryId,\n421\t            reason: 'Contract test propose',\n422\t            invalidate_reason: 'Contract test - simulate invalidation',\n423\t        });\n424\t        const proposal = normalizeEvolutionProposal(payload);\n425\t        assert.strictEqual(proposal.action, 'propose');\n426\t        assert.ok(proposal.proposalId.length > 0);\n427\t        proposedEvolutionId = proposal.proposalId;\n428\t    });\n429\t\n430\t    test('propose_memory_evolution: action=reject closes the proposal', async () => {\n431\t        assert.ok(proposedEvolutionId, 'previous proposal must have been recorded');\n432\t        const payload = await client.toolCall('propose_memory_evolution', {\n433\t            action: 'reject',\n434\t            proposal_id: proposedEvolutionId,\n435\t            reason: 'Contract test reject',\n436\t            decided_by: 'contract-test',\n437\t        });\n438\t        const proposal = normalizeEvolutionProposal(payload);\n439\t        assert.strictEqual(proposal.action, 'reject');\n440\t        assert.strictEqual(proposal.proposalId, proposedEvolutionId);\n441\t    });\n442\t\n443\t    test('propose_memory_evolution: action=apply requires proposal_id', async () => {\n444\t        const message = await client.toolCallExpectError('propose_memory_evolution', {\n445\t            action: 'apply',\n446\t        });\n447\t        assert.ok(\n448\t            message.toLowerCase().includes('proposal_id'),\n449\t            `expected proposal_id requirement, got: ${message}`\n450\t        );\n451\t    });\n452\t\n453\t    test('verify_explain_memory: happy-path returns typed verify-explain response', async () => {\n454\t        const payload = await client.toolCall('verify_explain_memory', {\n455\t            memory_id: seededMemoryId,\n456\t            mode: 'verify_and_explain',\n457\t            render_mode: 'full',\n458\t        });\n459\t        const response = normalizeVerifyExplainResponse(payload);\n460\t        assert.strictEqual(typeof response.status, 'string');\n461\t        assert.ok(response.status.length > 0);\n462\t        assert.strictEqual(typeof response.confidenceDelta, 'number');\n463\t        assert.strictEqual(typeof response.expansionHandle, 'string');\n464\t        assert.ok(Array.isArray(response.summaryLines));\n465\t        assert.ok(Array.isArray(response.checks));\n466\t        assert.strictEqual(response.renderMode, 'full');\n467\t    });\n468\t\n469\t    test('verify_explain_memory: unknown memory id is rejected', async () => {\n470\t        const message = await client.toolCallExpectError('verify_explain_memory', {\n471\t            memory_id: 'memory-that-does-not-exist',\n472\t            mode: 'verify_and_explain',\n473\t        });\n474\t        assert.ok(message.length > 0);\n475\t    });\n476\t\n477\t    test('list_memory_conflicts: happy-path on legacy anchor returns typed list', async () => {\n478\t        const payload = await client.toolCall('list_memory_conflicts', {\n479\t            anchor: seededMemoryId,\n480\t            render_mode: 'full',\n481\t            limit: 25,\n482\t        });\n483\t        const list = normalizeConflictList(payload);\n484\t        assert.strictEqual(typeof list.anchor, 'string');\n485\t        assert.ok(list.anchor.length > 0);\n486\t        assert.strictEqual(typeof list.total, 'number');\n487\t        assert.strictEqual(list.renderMode, 'full');\n488\t        assert.ok(Array.isArray(list.summaryLines));\n489\t        assert.ok(Array.isArray(list.conflicts));\n490\t    });\n491\t\n492\t    test('list_memory_conflicts: missing anchor is rejected', async () => {\n493\t        const message = await client.toolCallExpectError('list_memory_conflicts', {\n494\t            render_mode: 'full',\n495\t        });\n496\t        assert.ok(\n497\t            message.toLowerCase().includes('anchor'),\n498\t            `expected anchor requirement, got: ${message}`\n499\t        );\n500\t    });\n501\t\n502\t    test('contract transcript captures every covered tool', () => {\n503\t        const covered = new Set<string>();\n504\t        for (const entry of client.transcript) {\n505\t            if (entry.method === 'tools/call' && entry.params && typeof entry.params === 'object') {\n506\t                const name = (entry.params as { name?: string }).name;\n507\t                if (name) {\n508\t                    covered.add(name);\n509\t                }\n510\t            } else if (entry.method.startsWith('tools/call:error:')) {\n511\t                covered.add(entry.method.replace('tools/call:error:', ''));\n512\t            }\n513\t        }\n514\t        // Every review-UI tool advertised by `ReviewRpcBridge.getCapabilities()` must\n515\t        // appear in the transcript. Composite methods (overview/evidence/queue) are\n516\t        // built from these primitives and inherit their coverage transitively.\n517\t        const expected = [\n518\t            'save_observation',\n519\t            'list_observations',\n520\t            'list_stale_memories',\n521\t            'index_status',\n522\t            'get_session_metrics',\n523\t            'get_memory_metrics',\n524\t            'get_event_trace',\n525\t            'consolidate_session',\n526\t            'propose_memory_evolution',\n527\t            'verify_explain_memory',\n528\t            'list_memory_conflicts',\n529\t        ];\n530\t        for (const name of expected) {\n531\t            assert.ok(covered.has(name), `contract test did not exercise tool: ${name}`);\n532\t        }\n533\t    });\n534\t});\n535\t"}]},"parent_tool_use_id":null,"session_id":"fbec9507-2ec8-4c28-a044-dba0cf5769ae","uuid":"307ade70-0a3e-45f0-86f2-735898adf99f","timestamp":"2026-05-17T19:06:04.721Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/extension/src/test/contract.test.ts","content":"// Contract gate R79 — extension ↔ daemon review-UI MCP plumbing.\n//\n// Spawns the real daemon binary from `extension/bin/lattice` (per\n// `lattice/CLAUDE.md ## Deploy`) and exercises one happy-path and one\n// error-path tools/call per review-UI tool consumed by `ReviewRpcBridge`.\n// Every typed response is parsed through the same `normalize*` helper the\n// extension uses at runtime, so any wire-shape drift surfaces here rather\n// than in the webview.\n//\n// Spec anchors:\n//   - `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md` `## 9. MCP Surface`\n//   - `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md` `## MCP Tool Contract Principles`\n//   - `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md` `## 10. Human Review Surface`\n\nimport * as assert from 'assert';\nimport * as cp from 'child_process';\nimport * as fs from 'fs';\nimport * as os from 'os';\nimport * as path from 'path';\nimport { suite, test, suiteSetup, suiteTeardown } from 'mocha';\n\nimport {\n    arrayValue,\n    normalizeConflictList,\n    normalizeConsolidationReport,\n    normalizeEventTracePage,\n    normalizeEvolutionProposal,\n    normalizeIndexStatus,\n    normalizeMemory,\n    normalizeMetricSnapshot,\n    normalizeSessionMetrics,\n    normalizeVerifyExplainResponse,\n    recordValue,\n} from '../review/rpcPayloads';\n\ninterface JsonRpcResponse {\n    jsonrpc: '2.0';\n    id: number;\n    result?: unknown;\n    error?: { code: number; message: string; data?: unknown };\n}\n\ninterface McpToolResponse {\n    content?: Array<{ type?: string; text?: string }>;\n}\n\ninterface ContractLog {\n    method: string;\n    params: unknown;\n    response: unknown;\n}\n\nclass DaemonClient {\n    private nextId = 1;\n    private buffer = '';\n    private pending = new Map<number, {\n        resolve: (value: unknown) => void;\n        reject: (reason: Error) => void;\n        timer: NodeJS.Timeout;\n    }>();\n    public readonly transcript: ContractLog[] = [];\n    public stderr = '';\n\n    private constructor(private readonly proc: cp.ChildProcessWithoutNullStreams) {\n        proc.stdout.setEncoding('utf-8');\n        proc.stdout.on('data', (chunk: string) => this.onStdout(chunk));\n        proc.stderr.setEncoding('utf-8');\n        proc.stderr.on('data', (chunk: string) => {\n            this.stderr += chunk;\n        });\n        proc.on('exit', (code, signal) => {\n            for (const [id, pending] of this.pending) {\n                clearTimeout(pending.timer);\n                pending.reject(\n                    new Error(`Daemon exited code=${code} signal=${signal} before responding to id=${id}`)\n                );\n                this.pending.delete(id);\n            }\n        });\n    }\n\n    public static async spawn(binaryPath: string, workspace: string): Promise<DaemonClient> {\n        const proc = cp.spawn(binaryPath, ['--stdio', '--workspace', workspace], {\n            cwd: workspace,\n            stdio: ['pipe', 'pipe', 'pipe'],\n            env: { ...process.env, RUST_LOG: 'warn' },\n        });\n        return new DaemonClient(proc);\n    }\n\n    private onStdout(chunk: string): void {\n        this.buffer += chunk;\n        while (true) {\n            const newline = this.buffer.indexOf('\\n');\n            if (newline === -1) {\n                return;\n            }\n            const line = this.buffer.substring(0, newline).trim();\n            this.buffer = this.buffer.substring(newline + 1);\n            if (!line || !line.startsWith('{')) {\n                continue;\n            }\n            try {\n                const message = JSON.parse(line) as JsonRpcResponse;\n                const pending = this.pending.get(message.id);\n                if (!pending) {\n                    continue;\n                }\n                this.pending.delete(message.id);\n                clearTimeout(pending.timer);\n                if (message.error) {\n                    pending.reject(\n                        new Error(`JSON-RPC error ${message.error.code}: ${message.error.message}`)\n                    );\n                } else {\n                    pending.resolve(message.result);\n                }\n            } catch (error) {\n                console.error('[contract-test] failed to parse line:', line, error);\n            }\n        }\n    }\n\n    public send(method: string, params?: unknown, timeoutMs = 30_000): Promise<unknown> {\n        return new Promise<unknown>((resolve, reject) => {\n            const id = this.nextId++;\n            const request = {\n                jsonrpc: '2.0',\n                id,\n                method,\n                ...(params !== undefined ? { params } : {}),\n            };\n            const timer = setTimeout(() => {\n                this.pending.delete(id);\n                reject(new Error(\n                    `Request ${method} (id=${id}) timed out after ${timeoutMs}ms; stderr=${this.stderr.slice(-2000)}`\n                ));\n            }, timeoutMs);\n            this.pending.set(id, {\n                resolve: (value) => {\n                    this.transcript.push({ method, params, response: value });\n                    resolve(value);\n                },\n                reject,\n                timer,\n            });\n            const serialized = JSON.stringify(request) + '\\n';\n            this.proc.stdin.write(serialized, 'utf-8', (writeError) => {\n                if (writeError) {\n                    this.pending.delete(id);\n                    clearTimeout(timer);\n                    reject(writeError);\n                }\n            });\n        });\n    }\n\n    public async initialize(): Promise<void> {\n        const result = await this.send('initialize', {\n            protocolVersion: '2024-11-05',\n            capabilities: {},\n            clientInfo: { name: 'contract-test', version: '0.0.1' },\n        }, 15_000);\n        const record = recordValue(result);\n        assert.strictEqual(record.protocolVersion, '2024-11-05');\n        assert.ok(typeof record.serverInfo === 'object');\n    }\n\n    public async toolCallRaw(name: string, args: Record<string, unknown>): Promise<unknown> {\n        const response = await this.send('tools/call', {\n            name,\n            arguments: args,\n        }, 60_000) as McpToolResponse;\n        const text = response.content?.find((item) => item.type === 'text')?.text;\n        if (typeof text !== 'string') {\n            throw new Error(`tools/call ${name} returned no text payload: ${JSON.stringify(response)}`);\n        }\n        return JSON.parse(text);\n    }\n\n    public async toolCall(name: string, args: Record<string, unknown>): Promise<Record<string, unknown>> {\n        return recordValue(await this.toolCallRaw(name, args));\n    }\n\n    public async toolCallExpectError(name: string, args: Record<string, unknown>): Promise<string> {\n        try {\n            await this.toolCallRaw(name, args);\n            assert.fail(`Expected tools/call ${name} to fail with arguments ${JSON.stringify(args)}`);\n            return '';\n        } catch (error) {\n            this.transcript.push({\n                method: `tools/call:error:${name}`,\n                params: args,\n                response: error instanceof Error ? error.message : String(error),\n            });\n            return error instanceof Error ? error.message : String(error);\n        }\n    }\n\n    public async dispose(): Promise<void> {\n        try {\n            this.proc.stdin.end();\n        } catch {\n            // ignore\n        }\n        if (!this.proc.killed) {\n            this.proc.kill('SIGTERM');\n        }\n        await new Promise<void>((resolve) => {\n            if (this.proc.exitCode !== null || this.proc.signalCode !== null) {\n                resolve();\n                return;\n            }\n            this.proc.once('exit', () => resolve());\n            setTimeout(() => resolve(), 3_000);\n        });\n    }\n}\n\nfunction resolveDaemonBinary(): string {\n    const candidates = [\n        path.resolve(__dirname, '..', '..', 'bin', 'lattice'),\n        path.resolve(__dirname, '..', '..', '..', 'daemon', 'target', 'release', 'lattice'),\n    ];\n    for (const candidate of candidates) {\n        if (fs.existsSync(candidate)) {\n            return candidate;\n        }\n    }\n    throw new Error(`Lattice daemon binary not found in: ${candidates.join(', ')}`);\n}\n\nasync function seedMemory(client: DaemonClient): Promise<string> {\n    const stored = await client.toolCall('save_observation', {\n        content: 'Contract gate seed memory for R79',\n        memory_type: 'observation',\n        scope: 'session',\n        linked_files: ['README.md'],\n    });\n    const id = stored.id;\n    assert.ok(typeof id === 'string' && id.length > 0, 'save_observation should return a non-empty id');\n    return id as string;\n}\n\nsuite('contract: ReviewRpcBridge ↔ daemon MCP tools', function () {\n    this.timeout(120_000);\n\n    let client: DaemonClient;\n    let workspace: string;\n    let seededMemoryId: string;\n    let proposedEvolutionId: string | undefined;\n\n    suiteSetup(async () => {\n        workspace = fs.mkdtempSync(path.join(os.tmpdir(), 'lattice-contract-'));\n        fs.writeFileSync(path.join(workspace, 'README.md'), '# Contract Test Workspace\\n');\n        client = await DaemonClient.spawn(resolveDaemonBinary(), workspace);\n        await client.initialize();\n        seededMemoryId = await seedMemory(client);\n    });\n\n    suiteTeardown(async () => {\n        if (client) {\n            await client.dispose();\n        }\n        if (workspace && fs.existsSync(workspace)) {\n            try {\n                fs.rmSync(workspace, { recursive: true, force: true });\n            } catch {\n                // best-effort cleanup\n            }\n        }\n    });\n\n    test('list_observations: happy-path returns typed memory list', async () => {\n        const payload = await client.toolCall('list_observations', { limit: 50 });\n        const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n        assert.ok(memories.length >= 1, `expected at least one seeded memory; got ${memories.length}`);\n        const seeded = memories.find((entry) => entry.id === seededMemoryId);\n        assert.ok(seeded, 'seeded memory should be present in list_observations response');\n        assert.strictEqual(seeded?.content, 'Contract gate seed memory for R79');\n        assert.ok(seeded.linkedFiles.includes('README.md'));\n        assert.ok(['observation'].includes(seeded.memoryClass) || seeded.memoryClass.length > 0);\n    });\n\n    test('list_observations: invalid limit shape is gracefully clamped', async () => {\n        // The dispatcher accepts limit as integer but treats non-numeric defaults as 50.\n        // Provide a string and assert the call still returns a typed payload.\n        const payload = await client.toolCall('list_observations', { limit: 'not-a-number' as unknown });\n        const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n        assert.ok(Array.isArray(memories));\n    });\n\n    test('list_stale_memories: happy-path returns typed memory list', async () => {\n        const payload = await client.toolCall('list_stale_memories', { limit: 25 });\n        const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n        assert.ok(typeof payload.count === 'number');\n        assert.ok(Array.isArray(memories));\n    });\n\n    test('list_stale_memories: oversize limit is clamped to ≤200', async () => {\n        const payload = await client.toolCall('list_stale_memories', { limit: 9999 });\n        const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n        assert.ok(memories.length <= 200);\n    });\n\n    test('index_status: happy-path returns typed snapshot', async () => {\n        const payload = await client.toolCall('index_status', {});\n        const snapshot = normalizeIndexStatus(payload);\n        assert.ok(['ready', 'indexing'].includes(snapshot.status));\n        assert.strictEqual(typeof snapshot.version, 'string');\n        assert.strictEqual(typeof snapshot.workspace, 'string');\n        assert.ok(snapshot.workspace.length > 0);\n        assert.strictEqual(typeof snapshot.nodes, 'number');\n        assert.strictEqual(typeof snapshot.edges, 'number');\n        assert.strictEqual(typeof snapshot.files, 'number');\n        assert.ok(typeof snapshot.languages === 'object' && snapshot.languages !== null);\n    });\n\n    test('get_session_metrics: happy-path returns typed session metrics', async () => {\n        const raw = await client.toolCallRaw('get_session_metrics', {});\n        const metrics = normalizeSessionMetrics(raw);\n        assert.strictEqual(typeof metrics.totalToolCalls, 'number');\n        assert.strictEqual(typeof metrics.workflowToolCalls, 'number');\n        assert.strictEqual(typeof metrics.totalPayloadTokens, 'number');\n        assert.strictEqual(typeof metrics.averagePayloadTokensPerTool, 'number');\n        assert.strictEqual(typeof metrics.totalPayloadBytes, 'number');\n        assert.strictEqual(typeof metrics.averagePayloadBytesPerTool, 'number');\n        assert.strictEqual(typeof metrics.contextHandleReuses, 'number');\n        assert.strictEqual(typeof metrics.contextHandleReuseRate, 'number');\n    });\n\n    test('get_memory_metrics: happy-path returns typed metric snapshot', async () => {\n        const payload = await client.toolCall('get_memory_metrics', {\n            scope: 'session',\n            render_mode: 'compact',\n        });\n        const snapshot = normalizeMetricSnapshot(payload);\n        assert.strictEqual(typeof snapshot.scope, 'string');\n        assert.strictEqual(typeof snapshot.renderMode, 'string');\n        assert.strictEqual(typeof snapshot.incomplete, 'boolean');\n        assert.ok(Array.isArray(snapshot.notes));\n        assert.ok(Array.isArray(snapshot.signals));\n        for (const signal of snapshot.signals) {\n            assert.strictEqual(typeof signal.signal, 'string');\n            assert.ok(signal.value === null || typeof signal.value === 'number');\n        }\n    });\n\n    test('get_memory_metrics: invalid scope rejected by serde', async () => {\n        const message = await client.toolCallExpectError('get_memory_metrics', {\n            scope: 'not-a-real-scope',\n        });\n        assert.ok(message.length > 0, 'invalid scope must surface a JSON-RPC error');\n    });\n\n    test('get_event_trace: happy-path returns typed paginated page', async () => {\n        const payload = await client.toolCall('get_event_trace', {\n            workspace_id: workspace,\n            limit: 25,\n            render_mode: 'full',\n        });\n        const page = normalizeEventTracePage(payload);\n        assert.strictEqual(typeof page.renderMode, 'string');\n        assert.ok(typeof page.scope.kind === 'string' && page.scope.kind.length > 0);\n        assert.ok(Array.isArray(page.events));\n        for (const event of page.events) {\n            assert.strictEqual(typeof event.eventId, 'string');\n            assert.strictEqual(typeof event.expansionHandle, 'string');\n            assert.strictEqual(typeof event.kind, 'string');\n            assert.strictEqual(typeof event.timestamp, 'string');\n            assert.strictEqual(typeof event.workspaceId, 'string');\n            assert.strictEqual(typeof event.summary, 'string');\n            assert.ok(Array.isArray(event.references));\n        }\n    });\n\n    test('get_event_trace: missing scope is rejected', async () => {\n        const message = await client.toolCallExpectError('get_event_trace', {\n            limit: 25,\n        });\n        assert.ok(\n            message.includes('task_id') ||\n                message.includes('session_id') ||\n                message.includes('workspace_id') ||\n                message.toLowerCase().includes('scope'),\n            `expected scope-required error, got: ${message}`\n        );\n    });\n\n    test('consolidate_session: happy-path returns typed consolidation report', async () => {\n        const payload = await client.toolCall('consolidate_session', {\n            session_id: 'contract-test-session',\n            mode: 'manual_review',\n            render_mode: 'diagnostic',\n        });\n        const report = normalizeConsolidationReport(payload);\n        assert.strictEqual(report.sessionId, 'contract-test-session');\n        assert.strictEqual(report.mode, 'manual_review');\n        assert.strictEqual(report.renderMode, 'diagnostic');\n        assert.strictEqual(typeof report.incomplete, 'boolean');\n        assert.ok(Array.isArray(report.notes));\n        assert.ok(Array.isArray(report.proposals));\n        assert.ok(Array.isArray(report.categories));\n    });\n\n    test('consolidate_session: empty session_id is rejected', async () => {\n        const message = await client.toolCallExpectError('consolidate_session', {\n            session_id: '',\n            mode: 'manual_review',\n        });\n        assert.ok(\n            message.toLowerCase().includes('session_id'),\n            `expected session_id validation error, got: ${message}`\n        );\n    });\n\n    test('propose_memory_evolution: action=propose returns typed proposal', async () => {\n        const payload = await client.toolCall('propose_memory_evolution', {\n            action: 'propose',\n            memory_id: seededMemoryId,\n            reason: 'Contract test propose',\n            invalidate_reason: 'Contract test - simulate invalidation',\n        });\n        const proposal = normalizeEvolutionProposal(payload);\n        assert.strictEqual(proposal.action, 'propose');\n        assert.ok(proposal.proposalId.length > 0);\n        proposedEvolutionId = proposal.proposalId;\n    });\n\n    test('propose_memory_evolution: action=reject closes the proposal', async () => {\n        assert.ok(proposedEvolutionId, 'previous proposal must have been recorded');\n        const payload = await client.toolCall('propose_memory_evolution', {\n            action: 'reject',\n            proposal_id: proposedEvolutionId,\n            reason: 'Contract test reject',\n            decided_by: 'contract-test',\n        });\n        const proposal = normalizeEvolutionProposal(payload);\n        assert.strictEqual(proposal.action, 'reject');\n        assert.strictEqual(proposal.proposalId, proposedEvolutionId);\n    });\n\n    test('propose_memory_evolution: action=apply requires proposal_id', async () => {\n        const message = await client.toolCallExpectError('propose_memory_evolution', {\n            action: 'apply',\n        });\n        assert.ok(\n            message.toLowerCase().includes('proposal_id'),\n            `expected proposal_id requirement, got: ${message}`\n        );\n    });\n\n    test('verify_explain_memory: happy-path returns typed verify-explain response', async () => {\n        const payload = await client.toolCall('verify_explain_memory', {\n            memory_id: seededMemoryId,\n            mode: 'verify_and_explain',\n            render_mode: 'full',\n        });\n        const response = normalizeVerifyExplainResponse(payload);\n        assert.strictEqual(typeof response.status, 'string');\n        assert.ok(response.status.length > 0);\n        assert.strictEqual(typeof response.confidenceDelta, 'number');\n        assert.strictEqual(typeof response.expansionHandle, 'string');\n        assert.ok(Array.isArray(response.summaryLines));\n        assert.ok(Array.isArray(response.checks));\n        assert.strictEqual(response.renderMode, 'full');\n    });\n\n    test('verify_explain_memory: unknown memory id is rejected', async () => {\n        const message = await client.toolCallExpectError('verify_explain_memory', {\n            memory_id: 'memory-that-does-not-exist',\n            mode: 'verify_and_explain',\n        });\n        assert.ok(message.length > 0);\n    });\n\n    test('list_memory_conflicts: happy-path on legacy anchor returns typed list', async () => {\n        const payload = await client.toolCall('list_memory_conflicts', {\n            anchor: seededMemoryId,\n            render_mode: 'full',\n            limit: 25,\n        });\n        const list = normalizeConflictList(payload);\n        assert.strictEqual(typeof list.anchor, 'string');\n        assert.ok(list.anchor.length > 0);\n        assert.strictEqual(typeof list.total, 'number');\n        assert.strictEqual(list.renderMode, 'full');\n        assert.ok(Array.isArray(list.summaryLines));\n        assert.ok(Array.isArray(list.conflicts));\n    });\n\n    test('list_memory_conflicts: missing anchor is rejected', async () => {\n        const message = await client.toolCallExpectError('list_memory_conflicts', {\n            render_mode: 'full',\n        });\n        assert.ok(\n            message.toLowerCase().includes('anchor'),\n            `expected anchor requirement, got: ${message}`\n        );\n    });\n\n    test('contract transcript captures every covered tool', () => {\n        const covered = new Set<string>();\n        for (const entry of client.transcript) {\n            if (entry.method === 'tools/call' && entry.params && typeof entry.params === 'object') {\n                const name = (entry.params as { name?: string }).name;\n                if (name) {\n                    covered.add(name);\n                }\n            } else if (entry.method.startsWith('tools/call:error:')) {\n                covered.add(entry.method.replace('tools/call:error:', ''));\n            }\n        }\n        // Every review-UI tool advertised by `ReviewRpcBridge.getCapabilities()` must\n        // appear in the transcript. Composite methods (overview/evidence/queue) are\n        // built from these primitives and inherit their coverage transitively.\n        const expected = [\n            'save_observation',\n            'list_observations',\n            'list_stale_memories',\n            'index_status',\n            'get_session_metrics',\n            'get_memory_metrics',\n            'get_event_trace',\n            'consolidate_session',\n            'propose_memory_evolution',\n            'verify_explain_memory',\n            'list_memory_conflicts',\n        ];\n        for (const name of expected) {\n            assert.ok(covered.has(name), `contract test did not exercise tool: ${name}`);\n        }\n    });\n});\n","numLines":535,"startLine":1,"totalLines":535}}}
