{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NHwmw2dyFytZEM1FMg5a7p","type":"tool_result","content":"1\timport * as vscode from 'vscode';\n2\timport { DaemonManager } from '../daemon';\n3\timport {\n4\t    arrayValue,\n5\t    matchesMemoryFilters,\n6\t    normalizeConflictList,\n7\t    normalizeConsolidationReport,\n8\t    normalizeEventTracePage,\n9\t    normalizeEvolutionProposal,\n10\t    normalizeIndexStatus,\n11\t    normalizeMemory,\n12\t    normalizeMetricSnapshot,\n13\t    normalizeSessionMetrics,\n14\t    normalizeVerifyExplainResponse,\n15\t    numberValue,\n16\t    recordValue,\n17\t    ReviewConflictList,\n18\t    ReviewConsolidationJob,\n19\t    ReviewConsolidationQueueData,\n20\t    ReviewConsolidationReport,\n21\t    ReviewEventTracePage,\n22\t    ReviewEvolutionProposal,\n23\t    ReviewGraphDiagnosticRow,\n24\t    ReviewIndexingHealth,\n25\t    ReviewIndexStatus,\n26\t    ReviewMemory,\n27\t    ReviewMemoryEvidenceBundle,\n28\t    ReviewQueueDepthSnapshot,\n29\t    ReviewMemoryList,\n30\t    ReviewMetricSnapshot,\n31\t    ReviewOverview,\n32\t    ReviewRetrievalExplanation,\n33\t    ReviewSessionMetrics,\n34\t    ReviewVerifyExplainResponse,\n35\t    ReviewWorkspaceGraphHealth,\n36\t} from './rpcPayloads';\n37\t\n38\tinterface McpToolContentItem {\n39\t    type?: string;\n40\t    text?: string;\n41\t}\n42\t\n43\tinterface McpToolResponse {\n44\t    content?: McpToolContentItem[];\n45\t}\n46\t\n47\ttype ReviewErrorCode =\n48\t    | 'daemon_not_running'\n49\t    | 'rpc_error'\n50\t    | 'parse_error'\n51\t    | 'not_found'\n52\t    | 'unsupported';\n53\t\n54\texport interface ReviewRpcError {\n55\t    code: ReviewErrorCode;\n56\t    message: string;\n57\t    cause?: unknown;\n58\t}\n59\t\n60\texport type ReviewResult<T> =\n61\t    | { ok: true; value: T }\n62\t    | { ok: false; error: ReviewRpcError };\n63\t\n64\texport interface ReviewRouteSupport {\n65\t    mode: 'direct' | 'composed' | 'unsupported';\n66\t    reason: string;\n67\t}\n68\t\n69\texport interface ReviewBridgeCapabilities {\n70\t    memoryInbox: ReviewRouteSupport;\n71\t    promotionQueue: ReviewRouteSupport;\n72\t    contradictionQueue: ReviewRouteSupport;\n73\t    staleView: ReviewRouteSupport;\n74\t    evidenceInspector: ReviewRouteSupport;\n75\t    eventTrace: ReviewRouteSupport;\n76\t    retrievalExplanation: ReviewRouteSupport;\n77\t    usefulnessMetrics: ReviewRouteSupport;\n78\t    workspaceGraphHealth: ReviewRouteSupport;\n79\t    indexingHealth: ReviewRouteSupport;\n80\t    consolidationQueue: ReviewRouteSupport;\n81\t}\n82\t\n83\texport interface ReviewContradictionDecisionArgs {\n84\t    proposalId?: string;\n85\t    sourceMemoryId: string;\n86\t    targetMemoryId: string;\n87\t    linkType: string;\n88\t    reason?: string;\n89\t    detectedBy?: string;\n90\t}\n91\t\n92\texport interface ReviewRpcBridgeContract extends vscode.Disposable {\n93\t    setWebview(webview: vscode.Webview | undefined): void;\n94\t    getCapabilities(): ReviewBridgeCapabilities;\n95\t    getOverview(): Promise<ReviewResult<ReviewOverview>>;\n96\t    listMemories(filters?: {\n97\t        sessionId?: string;\n98\t        status?: string[];\n99\t        scope?: string[];\n100\t        memoryClass?: string[];\n101\t        limit?: number;\n102\t    }): Promise<ReviewResult<ReviewMemoryList>>;\n103\t    listPromotionProposals(sessionId?: string): Promise<ReviewResult<ReviewConsolidationReport>>;\n104\t    applyPromotion(proposalId: string, reason?: string): Promise<ReviewResult<ReviewEvolutionProposal>>;\n105\t    rejectPromotion(proposalId: string, reason: string): Promise<ReviewResult<ReviewEvolutionProposal>>;\n106\t    listContradictions(anchor?: string): Promise<ReviewResult<ReviewConflictList>>;\n107\t    applyContradictionResolution(\n108\t        args: ReviewContradictionDecisionArgs\n109\t    ): Promise<ReviewResult<ReviewEvolutionProposal>>;\n110\t    rejectContradictionResolution(\n111\t        args: ReviewContradictionDecisionArgs\n112\t    ): Promise<ReviewResult<ReviewEvolutionProposal>>;\n113\t    listStaleMemories(query?: string, limit?: number): Promise<ReviewResult<ReviewMemoryList>>;\n114\t    getMemoryEvidence(memoryId: string): Promise<ReviewResult<ReviewMemoryEvidenceBundle>>;\n115\t    verifyMemory(memoryId: string): Promise<ReviewResult<ReviewVerifyExplainResponse>>;\n116\t    getEventTrace(args: {\n117\t        taskId?: string;\n118\t        sessionId?: string;\n119\t        workspaceId?: string;\n120\t        kinds?: string[];\n121\t        since?: string;\n122\t        until?: string;\n123\t        cursor?: string;\n124\t        limit?: number;\n125\t        renderMode?: 'compact' | 'full' | 'diagnostic';\n126\t    }): Promise<ReviewResult<ReviewEventTracePage>>;\n127\t    getRetrievalExplanation(requestId: string): Promise<ReviewResult<ReviewRetrievalExplanation>>;\n128\t    listConsolidationJobs(sessionId?: string): Promise<ReviewResult<ReviewConsolidationQueueData>>;\n129\t    getConsolidationQueueDepth(): Promise<ReviewResult<ReviewQueueDepthSnapshot>>;\n130\t    getIndexingHealth(): Promise<ReviewResult<ReviewIndexingHealth>>;\n131\t    getWorkspaceGraphHealth(): Promise<ReviewResult<ReviewWorkspaceGraphHealth>>;\n132\t    retryConsolidationSession(\n133\t        sessionId: string,\n134\t        mode?: 'background' | 'manual_review' | 'replay' | 'post_task'\n135\t    ): Promise<ReviewResult<ReviewConsolidationReport>>;\n136\t}\n137\t\n138\texport type { ReviewMemory } from './rpcPayloads';\n139\t\n140\tconst DEFAULT_CONSOLIDATION_QUEUE_DEPTH = 128;\n141\tconst WORKSPACE_GRAPH_NODE_FAMILIES = [\n142\t    'File',\n143\t    'Directory',\n144\t    'Symbol',\n145\t    'Type',\n146\t    'Module',\n147\t    'Test',\n148\t    'Document',\n149\t    'Section',\n150\t    'ConfigKey',\n151\t    'Command',\n152\t    'Route',\n153\t    'Schema',\n154\t    'Package',\n155\t    'BuildTarget',\n156\t    'RuntimeSurface',\n157\t] as const;\n158\tconst WORKSPACE_GRAPH_EDGE_FAMILIES = [\n159\t    'contains',\n160\t    'imports',\n161\t    'calls',\n162\t    'implements',\n163\t    'extends',\n164\t    'type_ref',\n165\t    'tested_by',\n166\t    'documents',\n167\t    'mentions',\n168\t    'depends_on',\n169\t    'configured_by',\n170\t    'generated_by',\n171\t    'co_changed_with',\n172\t    'stale_against',\n173\t] as const;\n174\t\n175\texport class ReviewRpcBridge implements ReviewRpcBridgeContract {\n176\t    private webview: vscode.Webview | undefined;\n177\t\n178\t    constructor(private readonly daemon: DaemonManager) {}\n179\t\n180\t    public dispose(): void {\n181\t        this.webview = undefined;\n182\t    }\n183\t\n184\t    public setWebview(webview: vscode.Webview | undefined): void {\n185\t        this.webview = webview;\n186\t    }\n187\t\n188\t    public getCapabilities(): ReviewBridgeCapabilities {\n189\t        return {\n190\t            memoryInbox: support('direct', 'list_observations'),\n191\t            promotionQueue: support('direct', 'consolidate_session + propose_memory_evolution'),\n192\t            contradictionQueue: support('composed', 'list_memory_conflicts'),\n193\t            staleView: support('direct', 'list_stale_memories + verify_explain_memory'),\n194\t            evidenceInspector: support('composed', 'list_observations'),\n195\t            eventTrace: support('direct', 'get_event_trace'),\n196\t            retrievalExplanation: support('unsupported', 'no public retrieval-explanation MCP tool'),\n197\t            usefulnessMetrics: support('direct', 'get_memory_metrics'),\n198\t            workspaceGraphHealth: support('composed', 'index_status'),\n199\t            indexingHealth: support('direct', 'index_status'),\n200\t            consolidationQueue: support('direct', 'consolidate_session'),\n201\t        };\n202\t    }\n203\t\n204\t    public async getOverview(): Promise<ReviewResult<ReviewOverview>> {\n205\t        return this.run(async () => {\n206\t            const indexStatusResult = await this.getIndexingHealth();\n207\t            const memoryListResult = await this.listMemories({ limit: 50 });\n208\t            const metricsResult = await this.getMemoryMetrics();\n209\t            const sessionMetricsResult = await this.getSessionMetrics();\n210\t            if (!indexStatusResult.ok) {\n211\t                throw indexStatusResult.error;\n212\t            }\n213\t            if (!memoryListResult.ok) {\n214\t                throw memoryListResult.error;\n215\t            }\n216\t            if (!metricsResult.ok) {\n217\t                throw metricsResult.error;\n218\t            }\n219\t            if (!sessionMetricsResult.ok) {\n220\t                throw sessionMetricsResult.error;\n221\t            }\n222\t            return {\n223\t                indexStatus: indexStatusResult.value.snapshot,\n224\t                memoryList: memoryListResult.value,\n225\t                metrics: metricsResult.value,\n226\t                sessionMetrics: sessionMetricsResult.value,\n227\t            };\n228\t        });\n229\t    }\n230\t\n231\t    public async listMemories(filters?: {\n232\t        sessionId?: string;\n233\t        status?: string[];\n234\t        scope?: string[];\n235\t        memoryClass?: string[];\n236\t        limit?: number;\n237\t    }): Promise<ReviewResult<ReviewMemoryList>> {\n238\t        return this.run(async () => {\n239\t            const args: Record<string, unknown> = {};\n240\t            if (filters?.sessionId) {\n241\t                args.session_id = filters.sessionId;\n242\t            }\n243\t            if (filters?.limit) {\n244\t                args.limit = filters.limit;\n245\t            }\n246\t            const payload = await this.callTool('list_observations', args);\n247\t            const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n248\t            const filtered = memories.filter((memory) => matchesMemoryFilters(memory, filters));\n249\t            return {\n250\t                count: filtered.length,\n251\t                memories: filtered,\n252\t            };\n253\t        });\n254\t    }\n255\t\n256\t    public async listPromotionProposals(\n257\t        sessionId?: string\n258\t    ): Promise<ReviewResult<ReviewConsolidationReport>> {\n259\t        return this.run(async () => {\n260\t            const activeSessionId = sessionId ?? 'review-panel';\n261\t            const payload = await this.callTool('consolidate_session', {\n262\t                session_id: activeSessionId,\n263\t                mode: 'manual_review',\n264\t                render_mode: 'diagnostic',\n265\t            });\n266\t            return normalizeConsolidationReport(payload);\n267\t        });\n268\t    }\n269\t\n270\t    public async applyPromotion(\n271\t        proposalId: string,\n272\t        reason?: string\n273\t    ): Promise<ReviewResult<ReviewEvolutionProposal>> {\n274\t        return this.run(async () => {\n275\t            const payload = await this.callTool('propose_memory_evolution', {\n276\t                action: 'apply',\n277\t                proposal_id: proposalId,\n278\t                reason,\n279\t                decided_by: 'operator',\n280\t            });\n281\t            return normalizeEvolutionProposal(payload);\n282\t        }, true);\n283\t    }\n284\t\n285\t    public async rejectPromotion(\n286\t        proposalId: string,\n287\t        reason: string\n288\t    ): Promise<ReviewResult<ReviewEvolutionProposal>> {\n289\t        return this.run(async () => {\n290\t            const payload = await this.callTool('propose_memory_evolution', {\n291\t                action: 'reject',\n292\t                proposal_id: proposalId,\n293\t                reason,\n294\t                decided_by: 'operator',\n295\t            });\n296\t            return normalizeEvolutionProposal(payload);\n297\t        }, true);\n298\t    }\n299\t\n300\t    public async listContradictions(anchor?: string): Promise<ReviewResult<ReviewConflictList>> {\n301\t        return this.run(async () => {\n302\t            if (anchor) {\n303\t                const payload = await this.callTool('list_memory_conflicts', {\n304\t                    anchor,\n305\t                    render_mode: 'full',\n306\t                    limit: 50,\n307\t                });\n308\t                return normalizeConflictList(payload);\n309\t            }\n310\t            const memories = await this.listMemories({ limit: 50 });\n311\t            if (!memories.ok) {\n312\t                throw memories.error;\n313\t            }\n314\t            const firstMemory = memories.value.memories[0];\n315\t            if (!firstMemory) {\n316\t                return {\n317\t                    anchor: 'memory-list',\n318\t                    total: 0,\n319\t                    renderMode: 'full',\n320\t                    summaryLines: [],\n321\t                    conflicts: [],\n322\t                };\n323\t            }\n324\t            const payload = await this.callTool('list_memory_conflicts', {\n325\t                anchor: firstMemory.id,\n326\t                render_mode: 'full',\n327\t                limit: 50,\n328\t            });\n329\t            return normalizeConflictList(payload);\n330\t        });\n331\t    }\n332\t\n333\t    public async applyContradictionResolution(\n334\t        args: ReviewContradictionDecisionArgs\n335\t    ): Promise<ReviewResult<ReviewEvolutionProposal>> {\n336\t        return this.run(async () => {\n337\t            const proposalId = await this.ensureContradictionProposal(args);\n338\t            const payload = await this.callTool('propose_memory_evolution', {\n339\t                action: 'apply',\n340\t                proposal_id: proposalId,\n341\t                reason: args.reason,\n342\t                decided_by: 'operator',\n343\t            });\n344\t            return normalizeEvolutionProposal(payload);\n345\t        }, true);\n346\t    }\n347\t\n348\t    public async rejectContradictionResolution(\n349\t        args: ReviewContradictionDecisionArgs\n350\t    ): Promise<ReviewResult<ReviewEvolutionProposal>> {\n351\t        return this.run(async () => {\n352\t            if (!args.reason) {\n353\t                throw createError('parse_error', 'Contradiction rejection requires a reason.');\n354\t            }\n355\t            const proposalId = await this.ensureContradictionProposal(args);\n356\t            const payload = await this.callTool('propose_memory_evolution', {\n357\t                action: 'reject',\n358\t                proposal_id: proposalId,\n359\t                reason: args.reason,\n360\t                decided_by: 'operator',\n361\t            });\n362\t            return normalizeEvolutionProposal(payload);\n363\t        }, true);\n364\t    }\n365\t\n366\t    public async listStaleMemories(\n367\t        query?: string,\n368\t        limit = 50\n369\t    ): Promise<ReviewResult<ReviewMemoryList>> {\n370\t        return this.run(async () => {\n371\t            const payload = await this.callTool('list_stale_memories', {\n372\t                query,\n373\t                limit,\n374\t            });\n375\t            const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n376\t            return {\n377\t                count: numberValue(payload, 'count'),\n378\t                memories,\n379\t            };\n380\t        });\n381\t    }\n382\t\n383\t    public async getMemoryEvidence(\n384\t        memoryId: string\n385\t    ): Promise<ReviewResult<ReviewMemoryEvidenceBundle>> {\n386\t        return this.run(async () => {\n387\t            const listResult = await this.listMemories({ limit: 200 });\n388\t            if (!listResult.ok) {\n389\t                throw listResult.error;\n390\t            }\n391\t            const memory = listResult.value.memories.find((entry) => entry.id === memoryId);\n392\t            if (!memory) {\n393\t                throw createError('not_found', `Memory ${memoryId} was not found in the current review scope.`);\n394\t            }\n395\t\n396\t            let provenanceEvents: ReviewEventTracePage['events'] = [];\n397\t            if (memory.sessionId) {\n398\t                const eventTraceResult = await this.getEventTrace({\n399\t                    sessionId: memory.sessionId,\n400\t                    limit: 200,\n401\t                    renderMode: 'full',\n402\t                });\n403\t                if (eventTraceResult.ok) {\n404\t                    provenanceEvents = eventTraceResult.value.events.filter((event) =>\n405\t                        eventReferencesMemory(event, memory.id)\n406\t                    );\n407\t                }\n408\t            }\n409\t\n410\t            const explainResult = memory.lastVerifiedAt\n411\t                ? await this.explainMemory(memory.id)\n412\t                : { ok: false, error: createError('not_found', 'No verification report is available yet.') } as const;\n413\t            return {\n414\t                memory,\n415\t                provenanceEvents,\n416\t                lastVerification: explainResult.ok ? explainResult.value : undefined,\n417\t            };\n418\t        });\n419\t    }\n420\t\n421\t    public async verifyMemory(\n422\t        memoryId: string\n423\t    ): Promise<ReviewResult<ReviewVerifyExplainResponse>> {\n424\t        return this.run(async () => {\n425\t            const payload = await this.callTool('verify_explain_memory', {\n426\t                memory_id: memoryId,\n427\t                mode: 'verify_and_explain',\n428\t                render_mode: 'full',\n429\t            });\n430\t            return normalizeVerifyExplainResponse(payload);\n431\t        }, true);\n432\t    }\n433\t\n434\t    public async getEventTrace(args: {\n435\t        taskId?: string;\n436\t        sessionId?: string;\n437\t        workspaceId?: string;\n438\t        kinds?: string[];\n439\t        since?: string;\n440\t        until?: string;\n441\t        cursor?: string;\n442\t        limit?: number;\n443\t        renderMode?: 'compact' | 'full' | 'diagnostic';\n444\t    }): Promise<ReviewResult<ReviewEventTracePage>> {\n445\t        return this.run(async () => {\n446\t            const payload = await this.callTool('get_event_trace', {\n447\t                task_id: args.taskId,\n448\t                session_id: args.sessionId,\n449\t                workspace_id: args.workspaceId,\n450\t                kinds: args.kinds,\n451\t                since: args.since,\n452\t                until: args.until,\n453\t                cursor: args.cursor,\n454\t                limit: args.limit ?? 25,\n455\t                render_mode: args.renderMode ?? 'full',\n456\t            });\n457\t            return normalizeEventTracePage(payload);\n458\t        });\n459\t    }\n460\t\n461\t    public async getRetrievalExplanation(\n462\t        requestId: string\n463\t    ): Promise<ReviewResult<ReviewRetrievalExplanation>> {\n464\t        return this.run(async () => {\n465\t            return {\n466\t                requestId,\n467\t                supported: false,\n468\t                reason: 'No public retrieval explanation tool is currently exposed by the daemon.',\n469\t            };\n470\t        }, true);\n471\t    }\n472\t\n473\t    public async listConsolidationJobs(\n474\t        sessionId?: string\n475\t    ): Promise<ReviewResult<ReviewConsolidationQueueData>> {\n476\t        return this.run(async () => {\n477\t            const workspaceId = await this.resolveWorkspaceId();\n478\t            const traceResult = await this.getEventTrace({\n479\t                sessionId,\n480\t                workspaceId: sessionId ? undefined : workspaceId,\n481\t                kinds: ['memory_consolidated', 'consolidation_failed'],\n482\t                limit: sessionId ? 200 : 500,\n483\t                renderMode: 'diagnostic',\n484\t            });\n485\t            if (!traceResult.ok) {\n486\t                throw traceResult.error;\n487\t            }\n488\t            const jobs = dedupeJobs(traceResult.value.events\n489\t                .map((event) => toConsolidationJob(event))\n490\t                .filter((job): job is ReviewConsolidationJob => job !== undefined));\n491\t            return {\n492\t                workspaceId,\n493\t                jobs,\n494\t                queueDepth: buildQueueDepth(jobs),\n495\t            };\n496\t        });\n497\t    }\n498\t\n499\t    public async getConsolidationQueueDepth(): Promise<ReviewResult<ReviewQueueDepthSnapshot>> {\n500\t        return this.run(async () => {\n501\t            const jobs = await this.listConsolidationJobs();\n502\t            if (!jobs.ok) {\n503\t                throw jobs.error;\n504\t            }\n505\t            return jobs.value.queueDepth;\n506\t        });\n507\t    }\n508\t\n509\t    public async getIndexingHealth(): Promise<ReviewResult<ReviewIndexingHealth>> {\n510\t        return this.run(async () => {\n511\t            const payload = await this.callTool('index_status', {});\n512\t            const snapshot = normalizeIndexStatus(payload);\n513\t            const workspaceEvents = await this.getEventTrace({\n514\t                workspaceId: snapshot.workspace,\n515\t                limit: 500,\n516\t                renderMode: 'diagnostic',\n517\t            });\n518\t            if (!workspaceEvents.ok) {\n519\t                throw workspaceEvents.error;\n520\t            }\n521\t            return {\n522\t                snapshot,\n523\t                parserHealth: Object.entries(snapshot.languages)\n524\t                    .sort(([left], [right]) => left.localeCompare(right))\n525\t                    .map(([language, parsedCount]) => ({\n526\t                        language,\n527\t                        parsedCount,\n528\t                    })),\n529\t                watcherStatus: snapshot.status === 'indexing' ? 'indexing' : 'watching',\n530\t                lastFullRescanAt: undefined,\n531\t                vectorIndex: {\n532\t                    notes: ['The current daemon snapshot does not expose vector index counters in the review bridge yet.'],\n533\t                },\n534\t                ftsIndex: {\n535\t                    rows: [],\n536\t                    notes: ['The current daemon snapshot does not expose FTS table counters in the review bridge yet.'],\n537\t                },\n538\t                eventLog: {\n539\t                    lastHourCount: countEventsSinceHours(workspaceEvents.value.events, 1),\n540\t                    last24HoursCount: countEventsSinceHours(workspaceEvents.value.events, 24),\n541\t                    last7DaysCount: countEventsSinceHours(workspaceEvents.value.events, 24 * 7),\n542\t                    lastCompactionAt: undefined,\n543\t                    spilloverRows: workspaceEvents.value.events.filter((event) => event.spilledPayloadRowId !== undefined).length,\n544\t                    notes: ['Compaction timestamps are not exposed by the current daemon snapshot.'],\n545\t                },\n546\t            };\n547\t        });\n548\t    }\n549\t\n550\t    public async getWorkspaceGraphHealth(): Promise<ReviewResult<ReviewWorkspaceGraphHealth>> {\n551\t        return this.run(async () => {\n552\t            const indexing = await this.getIndexingHealth();\n553\t            if (!indexing.ok) {\n554\t                throw indexing.error;\n555\t            }\n556\t            const staleMemories = await this.listStaleMemories(undefined, 100);\n557\t            if (!staleMemories.ok) {\n558\t                throw staleMemories.error;\n559\t            }\n560\t            const staleEdges: ReviewGraphDiagnosticRow[] = staleMemories.value.memories.map((memory) => ({\n561\t                identity: memory.id,\n562\t                reason: memory.staleReason || memory.freshnessStatus || memory.verificationStatus,\n563\t                detail: [\n564\t                    memory.linkedFiles.slice(0, 2).join(', '),\n565\t                    memory.linkedSymbols.slice(0, 2).join(', '),\n566\t                ].filter(Boolean).join(' | '),\n567\t                relatedMemoryId: memory.id,\n568\t            }));\n569\t            return {\n570\t                snapshot: indexing.value.snapshot,\n571\t                nodeFamilies: WORKSPACE_GRAPH_NODE_FAMILIES.map((family) => {\n572\t                    const count = nodeFamilyCount(family, indexing.value.snapshot);\n573\t                    return {\n574\t                        family,\n575\t                        count,\n576\t                        note: count === undefined ? 'Not reported by the current daemon snapshot.' : undefined,\n577\t                    };\n578\t                }),\n579\t                edgeFamilies: WORKSPACE_GRAPH_EDGE_FAMILIES.map((family) => ({\n580\t                    family,\n581\t                    count: family === 'stale_against' ? staleEdges.length : undefined,\n582\t                    note: family === 'stale_against' ? undefined : 'Not reported by the current daemon snapshot.',\n583\t                })),\n584\t                brokenReferences: [],\n585\t                staleEdges,\n586\t                orphanSymbols: [],\n587\t                notes: [\n588\t                    'Broken-reference and orphan-symbol diagnostics require daemon-side graph family enumeration that is not yet exposed through the review bridge.',\n589\t                ],\n590\t            };\n591\t        });\n592\t    }\n593\t\n594\t    public async retryConsolidationSession(\n595\t        sessionId: string,\n596\t        mode: 'background' | 'manual_review' | 'replay' | 'post_task' = 'manual_review'\n597\t    ): Promise<ReviewResult<ReviewConsolidationReport>> {\n598\t        return this.run(async () => {\n599\t            const payload = await this.callTool('consolidate_session', {\n600\t                session_id: sessionId,\n601\t                mode,\n602\t                render_mode: 'diagnostic',\n603\t            });\n604\t            return normalizeConsolidationReport(payload);\n605\t        }, true);\n606\t    }\n607\t\n608\t    private async getMemoryMetrics(): Promise<ReviewResult<ReviewMetricSnapshot>> {\n609\t        return this.run(async () => {\n610\t            const payload = await this.callTool('get_memory_metrics', {\n611\t                scope: 'session',\n612\t                render_mode: 'compact',\n613\t            });\n614\t            return normalizeMetricSnapshot(payload);\n615\t        });\n616\t    }\n617\t\n618\t    private async getSessionMetrics(): Promise<ReviewResult<ReviewSessionMetrics>> {\n619\t        return this.run(async () => {\n620\t            const payload = await this.callToolRaw('get_session_metrics', {});\n621\t            return normalizeSessionMetrics(payload);\n622\t        });\n623\t    }\n624\t\n625\t    private async ensureContradictionProposal(\n626\t        args: ReviewContradictionDecisionArgs\n627\t    ): Promise<string> {\n628\t        if (args.proposalId) {\n629\t            return args.proposalId;\n630\t        }\n631\t        const reason = contradictionReason(args);\n632\t        const proposalArgs: Record<string, unknown> = {\n633\t            action: 'propose',\n634\t            memory_id: args.targetMemoryId,\n635\t            reason,\n636\t        };\n637\t        if (args.linkType === 'supersedes') {\n638\t            proposalArgs.superseded_by_memory_id = args.sourceMemoryId;\n639\t        } else {\n640\t            proposalArgs.invalidate_reason = reason;\n641\t        }\n642\t        const payload = await this.callTool('propose_memory_evolution', proposalArgs);\n643\t        return normalizeEvolutionProposal(payload).proposalId;\n644\t    }\n645\t\n646\t    private async explainMemory(\n647\t        memoryId: string\n648\t    ): Promise<ReviewResult<ReviewVerifyExplainResponse>> {\n649\t        return this.run(async () => {\n650\t            const payload = await this.callTool('verify_explain_memory', {\n651\t                memory_id: memoryId,\n652\t                mode: 'explain',\n653\t                render_mode: 'full',\n654\t            });\n655\t            return normalizeVerifyExplainResponse(payload);\n656\t        });\n657\t    }\n658\t\n659\t    private async resolveWorkspaceId(): Promise<string | undefined> {\n660\t        const payload = await this.callTool('index_status', {});\n661\t        return normalizeIndexStatus(payload).workspace || undefined;\n662\t    }\n663\t\n664\t    private async run<T>(\n665\t        operation: () => Promise<T>,\n666\t        postError = false\n667\t    ): Promise<ReviewResult<T>> {\n668\t        try {\n669\t            return { ok: true, value: await operation() };\n670\t        } catch (error) {\n671\t            const reviewError = normalizeError(error);\n672\t            vscode.window.showErrorMessage(reviewError.message);\n673\t            if (postError) {\n674\t                void this.webview?.postMessage({\n675\t                    type: 'error',\n676\t                    message: reviewError.message,\n677\t                });\n678\t            }\n679\t            return { ok: false, error: reviewError };\n680\t        }\n681\t    }\n682\t\n683\t    private async callTool(name: string, args: Record<string, unknown>): Promise<Record<string, unknown>> {\n684\t        const response = await this.callToolRaw(name, args);\n685\t        return recordValue(response);\n686\t    }\n687\t\n688\t    private async callToolRaw(name: string, args: Record<string, unknown>): Promise<unknown> {\n689\t        if (this.daemon.getStatus() !== 'running') {\n690\t            throw createError('daemon_not_running', 'Lattice daemon is not running.');\n691\t        }\n692\t        const response = await this.daemon.sendRequest('tools/call', {\n693\t            name,\n694\t            arguments: stripUndefined(args),\n695\t        }, 120_000) as McpToolResponse;\n696\t        const text = response.content?.find((item) => item.type === 'text')?.text;\n697\t        if (typeof text !== 'string') {\n698\t            throw createError('parse_error', `Unexpected response payload from ${name}.`, response);\n699\t        }\n700\t        try {\n701\t            return JSON.parse(text) as unknown;\n702\t        } catch (error) {\n703\t            throw createError('parse_error', `Failed to parse JSON payload from ${name}.`, error);\n704\t        }\n705\t    }\n706\t}\n707\t\n708\tfunction support(mode: ReviewRouteSupport['mode'], reason: string): ReviewRouteSupport {\n709\t    return { mode, reason };\n710\t}\n711\t\n712\tfunction stripUndefined(args: Record<string, unknown>): Record<string, unknown> {\n713\t    return Object.fromEntries(Object.entries(args).filter(([, value]) => value !== undefined));\n714\t}\n715\t\n716\tfunction normalizeError(error: unknown): ReviewRpcError {\n717\t    if (isReviewRpcError(error)) {\n718\t        return error;\n719\t    }\n720\t    if (error instanceof Error) {\n721\t        return createError('rpc_error', error.message, error);\n722\t    }\n723\t    return createError('rpc_error', String(error));\n724\t}\n725\t\n726\tfunction isReviewRpcError(error: unknown): error is ReviewRpcError {\n727\t    return typeof error === 'object' && error !== null && 'code' in error && 'message' in error;\n728\t}\n729\t\n730\tfunction createError(code: ReviewErrorCode, message: string, cause?: unknown): ReviewRpcError {\n731\t    return { code, message, cause };\n732\t}\n733\t\n734\tfunction contradictionReason(args: ReviewContradictionDecisionArgs): string {\n735\t    const detector = args.detectedBy?.trim();\n736\t    const base = args.reason?.trim();\n737\t    if (args.linkType === 'supersedes') {\n738\t        return base\n739\t            || `Marked ${args.targetMemoryId} as superseded by ${args.sourceMemoryId}${detector ? ` (${detector})` : ''}.`;\n740\t    }\n741\t    return base\n742\t        || `Invalidated ${args.targetMemoryId} because it contradicts ${args.sourceMemoryId}${detector ? ` (${detector})` : ''}.`;\n743\t}\n744\t\n745\tfunction eventReferencesMemory(event: ReviewEventTracePage['events'][number], memoryId: string): boolean {\n746\t    if (event.references.some((reference) => reference.includes(memoryId))) {\n747\t        return true;\n748\t    }\n749\t    if (event.summary.includes(memoryId)) {\n750\t        return true;\n751\t    }\n752\t    return containsMemoryId(event.payload, memoryId);\n753\t}\n754\t\n755\tfunction containsMemoryId(value: unknown, memoryId: string): boolean {\n756\t    if (typeof value === 'string') {\n757\t        return value.includes(memoryId);\n758\t    }\n759\t    if (Array.isArray(value)) {\n760\t        return value.some((entry) => containsMemoryId(entry, memoryId));\n761\t    }\n762\t    if (typeof value === 'object' && value !== null) {\n763\t        return Object.values(value).some((entry) => containsMemoryId(entry, memoryId));\n764\t    }\n765\t    return false;\n766\t}\n767\t\n768\tfunction toConsolidationJob(event: ReviewEventTracePage['events'][number]): ReviewConsolidationJob | undefined {\n769\t    const payload = typedPayload(event.payload);\n770\t    if (event.kind === 'consolidation_failed') {\n771\t        const failure = payload?.payload ?? {};\n772\t        const errorKind = stringProperty(failure, 'error_kind');\n773\t        return {\n774\t            jobId: stringProperty(failure, 'job_id') || event.eventId,\n775\t            status: errorKind === 'queue_full' ? 'dropped' : 'failed',\n776\t            kind: stringProperty(failure, 'job_kind') || 'unknown',\n777\t            mode: stringProperty(failure, 'mode') || 'background',\n778\t            sessionId: event.sessionId,\n779\t            taskId: event.taskId,\n780\t            createdAt: event.timestamp,\n781\t            completedAt: event.timestamp,\n782\t            llmModel: stringProperty(failure, 'model_name') || undefined,\n783\t            resultSummary: event.summary,\n784\t            sourceEventId: event.eventId,\n785\t            errorKind: errorKind || undefined,\n786\t            errorMessage: stringProperty(failure, 'error_message') || undefined,\n787\t        };\n788\t    }\n789\t    if (event.kind !== 'memory_consolidated') {\n790\t        return undefined;\n791\t    }\n792\t    const memoryPayload = payload?.payload ?? {};\n793\t    const proposalId = stringProperty(memoryPayload, 'proposal_id');\n794\t    const createdAt = event.timestamp;\n795\t    return {\n796\t        jobId: proposalId || event.eventId,\n797\t        proposalId: proposalId || undefined,\n798\t        status: proposalId ? 'proposed' : 'applied',\n799\t        kind: inferConsolidationKind(event.summary, proposalId),\n800\t        mode: inferConsolidationMode(event.summary),\n801\t        sessionId: event.sessionId,\n802\t        taskId: event.taskId,\n803\t        createdAt,\n804\t        completedAt: proposalId ? undefined : createdAt,\n805\t        resultSummary: event.summary,\n806\t        targetMemoryId: extractMemoryIdFromPayload(memoryPayload),\n807\t        sourceEventId: event.eventId,\n808\t    };\n809\t}\n810\t\n811\tfunction buildQueueDepth(jobs: ReviewConsolidationJob[]): ReviewQueueDepthSnapshot {\n812\t    const currentDepth = jobs.filter((job) => ['queued', 'running', 'proposed'].includes(job.status)).length;\n813\t    const droppedCount = jobs.filter((job) => job.status === 'dropped').length;\n814\t    const notes = droppedCount > 0\n815\t        ? ['Dropped jobs were reconstructed from consolidation failure events with error_kind=queue_full.']\n816\t        : [];\n817\t    return {\n818\t        currentDepth,\n819\t        maxDepth: DEFAULT_CONSOLIDATION_QUEUE_DEPTH,\n820\t        droppedCount,\n821\t        notes,\n822\t    };\n823\t}\n824\t\n825\tfunction dedupeJobs(jobs: ReviewConsolidationJob[]): ReviewConsolidationJob[] {\n826\t    const seen = new Set<string>();\n827\t    return jobs\n828\t        .sort((left, right) => (Date.parse(right.createdAt ?? '') || 0) - (Date.parse(left.createdAt ?? '') || 0))\n829\t        .filter((job) => {\n830\t            const key = `${job.jobId}:${job.status}`;\n831\t            if (seen.has(key)) {\n832\t                return false;\n833\t            }\n834\t            seen.add(key);\n835\t            return true;\n836\t        });\n837\t}\n838\t\n839\tfunction typedPayload(value: unknown): { kind?: string; payload?: Record<string, unknown> } | undefined {\n840\t    if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n841\t        return undefined;\n842\t    }\n843\t    const record = value as Record<string, unknown>;\n844\t    const payload = record.payload;\n845\t    return {\n846\t        kind: typeof record.kind === 'string' ? record.kind : undefined,\n847\t        payload: typeof payload === 'object' && payload !== null && !Array.isArray(payload)\n848\t            ? payload as Record<string, unknown>\n849\t            : record,\n850\t    };\n851\t}\n852\t\n853\tfunction stringProperty(record: Record<string, unknown>, key: string): string {\n854\t    return typeof record[key] === 'string' ? record[key] as string : '';\n855\t}\n856\t\n857\tfunction countEventsSinceHours(events: ReviewEventTracePage['events'], hours: number): number {\n858\t    const cutoff = Date.now() - hours * 60 * 60 * 1000;\n859\t    return events.filter((event) => {\n860\t        const timestamp = Date.parse(event.timestamp);\n861\t        return !Number.isNaN(timestamp) && timestamp >= cutoff;\n862\t    }).length;\n863\t}\n864\t\n865\tfunction extractMemoryIdFromPayload(payload: Record<string, unknown>): string | undefined {\n866\t    const value = payload.consolidated_memory_id;\n867\t    if (typeof value === 'string') {\n868\t        return value;\n869\t    }\n870\t    if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n871\t        return undefined;\n872\t    }\n873\t    const record = value as Record<string, unknown>;\n874\t    return typeof record.ulid === 'string' ? record.ulid : undefined;\n875\t}\n876\t\n877\tfunction inferConsolidationKind(summary: string, proposalId: string): string {\n878\t    const normalized = `${summary} ${proposalId}`.toLowerCase();\n879\t    if (normalized.includes('procedure')) {\n880\t        return 'procedure_extraction';\n881\t    }\n882\t    if (normalized.includes('failure')) {\n883\t        return 'failure_pattern_extraction';\n884\t    }\n885\t    if (normalized.includes('duplicate')) {\n886\t        return 'duplicate_detection';\n887\t    }\n888\t    if (normalized.includes('contradict')) {\n889\t        return 'contradiction_detection';\n890\t    }\n891\t    if (normalized.includes('supersed')) {\n892\t        return 'supersession_proposal';\n893\t    }\n894\t    if (normalized.includes('docs')) {\n895\t        return 'docs_update_proposal';\n896\t    }\n897\t    return 'episode_summary';\n898\t}\n899\t\n900\tfunction inferConsolidationMode(summary: string): string {\n901\t    const normalized = summary.toLowerCase();\n902\t    if (normalized.includes('replay')) {\n903\t        return 'replay';\n904\t    }\n905\t    if (normalized.includes('background')) {\n906\t        return 'background';\n907\t    }\n908\t    return 'manual_review';\n909\t}\n910\t\n911\tfunction nodeFamilyCount(family: string, snapshot: ReviewIndexStatus): number | undefined {\n912\t    switch (family) {\n913\t        case 'File':\n914\t            return snapshot.files;\n915\t        case 'Package':\n916\t            return snapshot.repos.length || 1;\n917\t        default:\n918\t            return undefined;\n919\t    }\n920\t}\n921\t"}]},"parent_tool_use_id":null,"session_id":"fbec9507-2ec8-4c28-a044-dba0cf5769ae","uuid":"6b34f304-b36b-4560-a6ce-e7b280cb4eca","timestamp":"2026-05-17T19:06:07.889Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/extension/src/review/rpcBridge.ts","content":"import * as vscode from 'vscode';\nimport { DaemonManager } from '../daemon';\nimport {\n    arrayValue,\n    matchesMemoryFilters,\n    normalizeConflictList,\n    normalizeConsolidationReport,\n    normalizeEventTracePage,\n    normalizeEvolutionProposal,\n    normalizeIndexStatus,\n    normalizeMemory,\n    normalizeMetricSnapshot,\n    normalizeSessionMetrics,\n    normalizeVerifyExplainResponse,\n    numberValue,\n    recordValue,\n    ReviewConflictList,\n    ReviewConsolidationJob,\n    ReviewConsolidationQueueData,\n    ReviewConsolidationReport,\n    ReviewEventTracePage,\n    ReviewEvolutionProposal,\n    ReviewGraphDiagnosticRow,\n    ReviewIndexingHealth,\n    ReviewIndexStatus,\n    ReviewMemory,\n    ReviewMemoryEvidenceBundle,\n    ReviewQueueDepthSnapshot,\n    ReviewMemoryList,\n    ReviewMetricSnapshot,\n    ReviewOverview,\n    ReviewRetrievalExplanation,\n    ReviewSessionMetrics,\n    ReviewVerifyExplainResponse,\n    ReviewWorkspaceGraphHealth,\n} from './rpcPayloads';\n\ninterface McpToolContentItem {\n    type?: string;\n    text?: string;\n}\n\ninterface McpToolResponse {\n    content?: McpToolContentItem[];\n}\n\ntype ReviewErrorCode =\n    | 'daemon_not_running'\n    | 'rpc_error'\n    | 'parse_error'\n    | 'not_found'\n    | 'unsupported';\n\nexport interface ReviewRpcError {\n    code: ReviewErrorCode;\n    message: string;\n    cause?: unknown;\n}\n\nexport type ReviewResult<T> =\n    | { ok: true; value: T }\n    | { ok: false; error: ReviewRpcError };\n\nexport interface ReviewRouteSupport {\n    mode: 'direct' | 'composed' | 'unsupported';\n    reason: string;\n}\n\nexport interface ReviewBridgeCapabilities {\n    memoryInbox: ReviewRouteSupport;\n    promotionQueue: ReviewRouteSupport;\n    contradictionQueue: ReviewRouteSupport;\n    staleView: ReviewRouteSupport;\n    evidenceInspector: ReviewRouteSupport;\n    eventTrace: ReviewRouteSupport;\n    retrievalExplanation: ReviewRouteSupport;\n    usefulnessMetrics: ReviewRouteSupport;\n    workspaceGraphHealth: ReviewRouteSupport;\n    indexingHealth: ReviewRouteSupport;\n    consolidationQueue: ReviewRouteSupport;\n}\n\nexport interface ReviewContradictionDecisionArgs {\n    proposalId?: string;\n    sourceMemoryId: string;\n    targetMemoryId: string;\n    linkType: string;\n    reason?: string;\n    detectedBy?: string;\n}\n\nexport interface ReviewRpcBridgeContract extends vscode.Disposable {\n    setWebview(webview: vscode.Webview | undefined): void;\n    getCapabilities(): ReviewBridgeCapabilities;\n    getOverview(): Promise<ReviewResult<ReviewOverview>>;\n    listMemories(filters?: {\n        sessionId?: string;\n        status?: string[];\n        scope?: string[];\n        memoryClass?: string[];\n        limit?: number;\n    }): Promise<ReviewResult<ReviewMemoryList>>;\n    listPromotionProposals(sessionId?: string): Promise<ReviewResult<ReviewConsolidationReport>>;\n    applyPromotion(proposalId: string, reason?: string): Promise<ReviewResult<ReviewEvolutionProposal>>;\n    rejectPromotion(proposalId: string, reason: string): Promise<ReviewResult<ReviewEvolutionProposal>>;\n    listContradictions(anchor?: string): Promise<ReviewResult<ReviewConflictList>>;\n    applyContradictionResolution(\n        args: ReviewContradictionDecisionArgs\n    ): Promise<ReviewResult<ReviewEvolutionProposal>>;\n    rejectContradictionResolution(\n        args: ReviewContradictionDecisionArgs\n    ): Promise<ReviewResult<ReviewEvolutionProposal>>;\n    listStaleMemories(query?: string, limit?: number): Promise<ReviewResult<ReviewMemoryList>>;\n    getMemoryEvidence(memoryId: string): Promise<ReviewResult<ReviewMemoryEvidenceBundle>>;\n    verifyMemory(memoryId: string): Promise<ReviewResult<ReviewVerifyExplainResponse>>;\n    getEventTrace(args: {\n        taskId?: string;\n        sessionId?: string;\n        workspaceId?: string;\n        kinds?: string[];\n        since?: string;\n        until?: string;\n        cursor?: string;\n        limit?: number;\n        renderMode?: 'compact' | 'full' | 'diagnostic';\n    }): Promise<ReviewResult<ReviewEventTracePage>>;\n    getRetrievalExplanation(requestId: string): Promise<ReviewResult<ReviewRetrievalExplanation>>;\n    listConsolidationJobs(sessionId?: string): Promise<ReviewResult<ReviewConsolidationQueueData>>;\n    getConsolidationQueueDepth(): Promise<ReviewResult<ReviewQueueDepthSnapshot>>;\n    getIndexingHealth(): Promise<ReviewResult<ReviewIndexingHealth>>;\n    getWorkspaceGraphHealth(): Promise<ReviewResult<ReviewWorkspaceGraphHealth>>;\n    retryConsolidationSession(\n        sessionId: string,\n        mode?: 'background' | 'manual_review' | 'replay' | 'post_task'\n    ): Promise<ReviewResult<ReviewConsolidationReport>>;\n}\n\nexport type { ReviewMemory } from './rpcPayloads';\n\nconst DEFAULT_CONSOLIDATION_QUEUE_DEPTH = 128;\nconst WORKSPACE_GRAPH_NODE_FAMILIES = [\n    'File',\n    'Directory',\n    'Symbol',\n    'Type',\n    'Module',\n    'Test',\n    'Document',\n    'Section',\n    'ConfigKey',\n    'Command',\n    'Route',\n    'Schema',\n    'Package',\n    'BuildTarget',\n    'RuntimeSurface',\n] as const;\nconst WORKSPACE_GRAPH_EDGE_FAMILIES = [\n    'contains',\n    'imports',\n    'calls',\n    'implements',\n    'extends',\n    'type_ref',\n    'tested_by',\n    'documents',\n    'mentions',\n    'depends_on',\n    'configured_by',\n    'generated_by',\n    'co_changed_with',\n    'stale_against',\n] as const;\n\nexport class ReviewRpcBridge implements ReviewRpcBridgeContract {\n    private webview: vscode.Webview | undefined;\n\n    constructor(private readonly daemon: DaemonManager) {}\n\n    public dispose(): void {\n        this.webview = undefined;\n    }\n\n    public setWebview(webview: vscode.Webview | undefined): void {\n        this.webview = webview;\n    }\n\n    public getCapabilities(): ReviewBridgeCapabilities {\n        return {\n            memoryInbox: support('direct', 'list_observations'),\n            promotionQueue: support('direct', 'consolidate_session + propose_memory_evolution'),\n            contradictionQueue: support('composed', 'list_memory_conflicts'),\n            staleView: support('direct', 'list_stale_memories + verify_explain_memory'),\n            evidenceInspector: support('composed', 'list_observations'),\n            eventTrace: support('direct', 'get_event_trace'),\n            retrievalExplanation: support('unsupported', 'no public retrieval-explanation MCP tool'),\n            usefulnessMetrics: support('direct', 'get_memory_metrics'),\n            workspaceGraphHealth: support('composed', 'index_status'),\n            indexingHealth: support('direct', 'index_status'),\n            consolidationQueue: support('direct', 'consolidate_session'),\n        };\n    }\n\n    public async getOverview(): Promise<ReviewResult<ReviewOverview>> {\n        return this.run(async () => {\n            const indexStatusResult = await this.getIndexingHealth();\n            const memoryListResult = await this.listMemories({ limit: 50 });\n            const metricsResult = await this.getMemoryMetrics();\n            const sessionMetricsResult = await this.getSessionMetrics();\n            if (!indexStatusResult.ok) {\n                throw indexStatusResult.error;\n            }\n            if (!memoryListResult.ok) {\n                throw memoryListResult.error;\n            }\n            if (!metricsResult.ok) {\n                throw metricsResult.error;\n            }\n            if (!sessionMetricsResult.ok) {\n                throw sessionMetricsResult.error;\n            }\n            return {\n                indexStatus: indexStatusResult.value.snapshot,\n                memoryList: memoryListResult.value,\n                metrics: metricsResult.value,\n                sessionMetrics: sessionMetricsResult.value,\n            };\n        });\n    }\n\n    public async listMemories(filters?: {\n        sessionId?: string;\n        status?: string[];\n        scope?: string[];\n        memoryClass?: string[];\n        limit?: number;\n    }): Promise<ReviewResult<ReviewMemoryList>> {\n        return this.run(async () => {\n            const args: Record<string, unknown> = {};\n            if (filters?.sessionId) {\n                args.session_id = filters.sessionId;\n            }\n            if (filters?.limit) {\n                args.limit = filters.limit;\n            }\n            const payload = await this.callTool('list_observations', args);\n            const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n            const filtered = memories.filter((memory) => matchesMemoryFilters(memory, filters));\n            return {\n                count: filtered.length,\n                memories: filtered,\n            };\n        });\n    }\n\n    public async listPromotionProposals(\n        sessionId?: string\n    ): Promise<ReviewResult<ReviewConsolidationReport>> {\n        return this.run(async () => {\n            const activeSessionId = sessionId ?? 'review-panel';\n            const payload = await this.callTool('consolidate_session', {\n                session_id: activeSessionId,\n                mode: 'manual_review',\n                render_mode: 'diagnostic',\n            });\n            return normalizeConsolidationReport(payload);\n        });\n    }\n\n    public async applyPromotion(\n        proposalId: string,\n        reason?: string\n    ): Promise<ReviewResult<ReviewEvolutionProposal>> {\n        return this.run(async () => {\n            const payload = await this.callTool('propose_memory_evolution', {\n                action: 'apply',\n                proposal_id: proposalId,\n                reason,\n                decided_by: 'operator',\n            });\n            return normalizeEvolutionProposal(payload);\n        }, true);\n    }\n\n    public async rejectPromotion(\n        proposalId: string,\n        reason: string\n    ): Promise<ReviewResult<ReviewEvolutionProposal>> {\n        return this.run(async () => {\n            const payload = await this.callTool('propose_memory_evolution', {\n                action: 'reject',\n                proposal_id: proposalId,\n                reason,\n                decided_by: 'operator',\n            });\n            return normalizeEvolutionProposal(payload);\n        }, true);\n    }\n\n    public async listContradictions(anchor?: string): Promise<ReviewResult<ReviewConflictList>> {\n        return this.run(async () => {\n            if (anchor) {\n                const payload = await this.callTool('list_memory_conflicts', {\n                    anchor,\n                    render_mode: 'full',\n                    limit: 50,\n                });\n                return normalizeConflictList(payload);\n            }\n            const memories = await this.listMemories({ limit: 50 });\n            if (!memories.ok) {\n                throw memories.error;\n            }\n            const firstMemory = memories.value.memories[0];\n            if (!firstMemory) {\n                return {\n                    anchor: 'memory-list',\n                    total: 0,\n                    renderMode: 'full',\n                    summaryLines: [],\n                    conflicts: [],\n                };\n            }\n            const payload = await this.callTool('list_memory_conflicts', {\n                anchor: firstMemory.id,\n                render_mode: 'full',\n                limit: 50,\n            });\n            return normalizeConflictList(payload);\n        });\n    }\n\n    public async applyContradictionResolution(\n        args: ReviewContradictionDecisionArgs\n    ): Promise<ReviewResult<ReviewEvolutionProposal>> {\n        return this.run(async () => {\n            const proposalId = await this.ensureContradictionProposal(args);\n            const payload = await this.callTool('propose_memory_evolution', {\n                action: 'apply',\n                proposal_id: proposalId,\n                reason: args.reason,\n                decided_by: 'operator',\n            });\n            return normalizeEvolutionProposal(payload);\n        }, true);\n    }\n\n    public async rejectContradictionResolution(\n        args: ReviewContradictionDecisionArgs\n    ): Promise<ReviewResult<ReviewEvolutionProposal>> {\n        return this.run(async () => {\n            if (!args.reason) {\n                throw createError('parse_error', 'Contradiction rejection requires a reason.');\n            }\n            const proposalId = await this.ensureContradictionProposal(args);\n            const payload = await this.callTool('propose_memory_evolution', {\n                action: 'reject',\n                proposal_id: proposalId,\n                reason: args.reason,\n                decided_by: 'operator',\n            });\n            return normalizeEvolutionProposal(payload);\n        }, true);\n    }\n\n    public async listStaleMemories(\n        query?: string,\n        limit = 50\n    ): Promise<ReviewResult<ReviewMemoryList>> {\n        return this.run(async () => {\n            const payload = await this.callTool('list_stale_memories', {\n                query,\n                limit,\n            });\n            const memories = arrayValue(payload, 'memories').map(normalizeMemory);\n            return {\n                count: numberValue(payload, 'count'),\n                memories,\n            };\n        });\n    }\n\n    public async getMemoryEvidence(\n        memoryId: string\n    ): Promise<ReviewResult<ReviewMemoryEvidenceBundle>> {\n        return this.run(async () => {\n            const listResult = await this.listMemories({ limit: 200 });\n            if (!listResult.ok) {\n                throw listResult.error;\n            }\n            const memory = listResult.value.memories.find((entry) => entry.id === memoryId);\n            if (!memory) {\n                throw createError('not_found', `Memory ${memoryId} was not found in the current review scope.`);\n            }\n\n            let provenanceEvents: ReviewEventTracePage['events'] = [];\n            if (memory.sessionId) {\n                const eventTraceResult = await this.getEventTrace({\n                    sessionId: memory.sessionId,\n                    limit: 200,\n                    renderMode: 'full',\n                });\n                if (eventTraceResult.ok) {\n                    provenanceEvents = eventTraceResult.value.events.filter((event) =>\n                        eventReferencesMemory(event, memory.id)\n                    );\n                }\n            }\n\n            const explainResult = memory.lastVerifiedAt\n                ? await this.explainMemory(memory.id)\n                : { ok: false, error: createError('not_found', 'No verification report is available yet.') } as const;\n            return {\n                memory,\n                provenanceEvents,\n                lastVerification: explainResult.ok ? explainResult.value : undefined,\n            };\n        });\n    }\n\n    public async verifyMemory(\n        memoryId: string\n    ): Promise<ReviewResult<ReviewVerifyExplainResponse>> {\n        return this.run(async () => {\n            const payload = await this.callTool('verify_explain_memory', {\n                memory_id: memoryId,\n                mode: 'verify_and_explain',\n                render_mode: 'full',\n            });\n            return normalizeVerifyExplainResponse(payload);\n        }, true);\n    }\n\n    public async getEventTrace(args: {\n        taskId?: string;\n        sessionId?: string;\n        workspaceId?: string;\n        kinds?: string[];\n        since?: string;\n        until?: string;\n        cursor?: string;\n        limit?: number;\n        renderMode?: 'compact' | 'full' | 'diagnostic';\n    }): Promise<ReviewResult<ReviewEventTracePage>> {\n        return this.run(async () => {\n            const payload = await this.callTool('get_event_trace', {\n                task_id: args.taskId,\n                session_id: args.sessionId,\n                workspace_id: args.workspaceId,\n                kinds: args.kinds,\n                since: args.since,\n                until: args.until,\n                cursor: args.cursor,\n                limit: args.limit ?? 25,\n                render_mode: args.renderMode ?? 'full',\n            });\n            return normalizeEventTracePage(payload);\n        });\n    }\n\n    public async getRetrievalExplanation(\n        requestId: string\n    ): Promise<ReviewResult<ReviewRetrievalExplanation>> {\n        return this.run(async () => {\n            return {\n                requestId,\n                supported: false,\n                reason: 'No public retrieval explanation tool is currently exposed by the daemon.',\n            };\n        }, true);\n    }\n\n    public async listConsolidationJobs(\n        sessionId?: string\n    ): Promise<ReviewResult<ReviewConsolidationQueueData>> {\n        return this.run(async () => {\n            const workspaceId = await this.resolveWorkspaceId();\n            const traceResult = await this.getEventTrace({\n                sessionId,\n                workspaceId: sessionId ? undefined : workspaceId,\n                kinds: ['memory_consolidated', 'consolidation_failed'],\n                limit: sessionId ? 200 : 500,\n                renderMode: 'diagnostic',\n            });\n            if (!traceResult.ok) {\n                throw traceResult.error;\n            }\n            const jobs = dedupeJobs(traceResult.value.events\n                .map((event) => toConsolidationJob(event))\n                .filter((job): job is ReviewConsolidationJob => job !== undefined));\n            return {\n                workspaceId,\n                jobs,\n                queueDepth: buildQueueDepth(jobs),\n            };\n        });\n    }\n\n    public async getConsolidationQueueDepth(): Promise<ReviewResult<ReviewQueueDepthSnapshot>> {\n        return this.run(async () => {\n            const jobs = await this.listConsolidationJobs();\n            if (!jobs.ok) {\n                throw jobs.error;\n            }\n            return jobs.value.queueDepth;\n        });\n    }\n\n    public async getIndexingHealth(): Promise<ReviewResult<ReviewIndexingHealth>> {\n        return this.run(async () => {\n            const payload = await this.callTool('index_status', {});\n            const snapshot = normalizeIndexStatus(payload);\n            const workspaceEvents = await this.getEventTrace({\n                workspaceId: snapshot.workspace,\n                limit: 500,\n                renderMode: 'diagnostic',\n            });\n            if (!workspaceEvents.ok) {\n                throw workspaceEvents.error;\n            }\n            return {\n                snapshot,\n                parserHealth: Object.entries(snapshot.languages)\n                    .sort(([left], [right]) => left.localeCompare(right))\n                    .map(([language, parsedCount]) => ({\n                        language,\n                        parsedCount,\n                    })),\n                watcherStatus: snapshot.status === 'indexing' ? 'indexing' : 'watching',\n                lastFullRescanAt: undefined,\n                vectorIndex: {\n                    notes: ['The current daemon snapshot does not expose vector index counters in the review bridge yet.'],\n                },\n                ftsIndex: {\n                    rows: [],\n                    notes: ['The current daemon snapshot does not expose FTS table counters in the review bridge yet.'],\n                },\n                eventLog: {\n                    lastHourCount: countEventsSinceHours(workspaceEvents.value.events, 1),\n                    last24HoursCount: countEventsSinceHours(workspaceEvents.value.events, 24),\n                    last7DaysCount: countEventsSinceHours(workspaceEvents.value.events, 24 * 7),\n                    lastCompactionAt: undefined,\n                    spilloverRows: workspaceEvents.value.events.filter((event) => event.spilledPayloadRowId !== undefined).length,\n                    notes: ['Compaction timestamps are not exposed by the current daemon snapshot.'],\n                },\n            };\n        });\n    }\n\n    public async getWorkspaceGraphHealth(): Promise<ReviewResult<ReviewWorkspaceGraphHealth>> {\n        return this.run(async () => {\n            const indexing = await this.getIndexingHealth();\n            if (!indexing.ok) {\n                throw indexing.error;\n            }\n            const staleMemories = await this.listStaleMemories(undefined, 100);\n            if (!staleMemories.ok) {\n                throw staleMemories.error;\n            }\n            const staleEdges: ReviewGraphDiagnosticRow[] = staleMemories.value.memories.map((memory) => ({\n                identity: memory.id,\n                reason: memory.staleReason || memory.freshnessStatus || memory.verificationStatus,\n                detail: [\n                    memory.linkedFiles.slice(0, 2).join(', '),\n                    memory.linkedSymbols.slice(0, 2).join(', '),\n                ].filter(Boolean).join(' | '),\n                relatedMemoryId: memory.id,\n            }));\n            return {\n                snapshot: indexing.value.snapshot,\n                nodeFamilies: WORKSPACE_GRAPH_NODE_FAMILIES.map((family) => {\n                    const count = nodeFamilyCount(family, indexing.value.snapshot);\n                    return {\n                        family,\n                        count,\n                        note: count === undefined ? 'Not reported by the current daemon snapshot.' : undefined,\n                    };\n                }),\n                edgeFamilies: WORKSPACE_GRAPH_EDGE_FAMILIES.map((family) => ({\n                    family,\n                    count: family === 'stale_against' ? staleEdges.length : undefined,\n                    note: family === 'stale_against' ? undefined : 'Not reported by the current daemon snapshot.',\n                })),\n                brokenReferences: [],\n                staleEdges,\n                orphanSymbols: [],\n                notes: [\n                    'Broken-reference and orphan-symbol diagnostics require daemon-side graph family enumeration that is not yet exposed through the review bridge.',\n                ],\n            };\n        });\n    }\n\n    public async retryConsolidationSession(\n        sessionId: string,\n        mode: 'background' | 'manual_review' | 'replay' | 'post_task' = 'manual_review'\n    ): Promise<ReviewResult<ReviewConsolidationReport>> {\n        return this.run(async () => {\n            const payload = await this.callTool('consolidate_session', {\n                session_id: sessionId,\n                mode,\n                render_mode: 'diagnostic',\n            });\n            return normalizeConsolidationReport(payload);\n        }, true);\n    }\n\n    private async getMemoryMetrics(): Promise<ReviewResult<ReviewMetricSnapshot>> {\n        return this.run(async () => {\n            const payload = await this.callTool('get_memory_metrics', {\n                scope: 'session',\n                render_mode: 'compact',\n            });\n            return normalizeMetricSnapshot(payload);\n        });\n    }\n\n    private async getSessionMetrics(): Promise<ReviewResult<ReviewSessionMetrics>> {\n        return this.run(async () => {\n            const payload = await this.callToolRaw('get_session_metrics', {});\n            return normalizeSessionMetrics(payload);\n        });\n    }\n\n    private async ensureContradictionProposal(\n        args: ReviewContradictionDecisionArgs\n    ): Promise<string> {\n        if (args.proposalId) {\n            return args.proposalId;\n        }\n        const reason = contradictionReason(args);\n        const proposalArgs: Record<string, unknown> = {\n            action: 'propose',\n            memory_id: args.targetMemoryId,\n            reason,\n        };\n        if (args.linkType === 'supersedes') {\n            proposalArgs.superseded_by_memory_id = args.sourceMemoryId;\n        } else {\n            proposalArgs.invalidate_reason = reason;\n        }\n        const payload = await this.callTool('propose_memory_evolution', proposalArgs);\n        return normalizeEvolutionProposal(payload).proposalId;\n    }\n\n    private async explainMemory(\n        memoryId: string\n    ): Promise<ReviewResult<ReviewVerifyExplainResponse>> {\n        return this.run(async () => {\n            const payload = await this.callTool('verify_explain_memory', {\n                memory_id: memoryId,\n                mode: 'explain',\n                render_mode: 'full',\n            });\n            return normalizeVerifyExplainResponse(payload);\n        });\n    }\n\n    private async resolveWorkspaceId(): Promise<string | undefined> {\n        const payload = await this.callTool('index_status', {});\n        return normalizeIndexStatus(payload).workspace || undefined;\n    }\n\n    private async run<T>(\n        operation: () => Promise<T>,\n        postError = false\n    ): Promise<ReviewResult<T>> {\n        try {\n            return { ok: true, value: await operation() };\n        } catch (error) {\n            const reviewError = normalizeError(error);\n            vscode.window.showErrorMessage(reviewError.message);\n            if (postError) {\n                void this.webview?.postMessage({\n                    type: 'error',\n                    message: reviewError.message,\n                });\n            }\n            return { ok: false, error: reviewError };\n        }\n    }\n\n    private async callTool(name: string, args: Record<string, unknown>): Promise<Record<string, unknown>> {\n        const response = await this.callToolRaw(name, args);\n        return recordValue(response);\n    }\n\n    private async callToolRaw(name: string, args: Record<string, unknown>): Promise<unknown> {\n        if (this.daemon.getStatus() !== 'running') {\n            throw createError('daemon_not_running', 'Lattice daemon is not running.');\n        }\n        const response = await this.daemon.sendRequest('tools/call', {\n            name,\n            arguments: stripUndefined(args),\n        }, 120_000) as McpToolResponse;\n        const text = response.content?.find((item) => item.type === 'text')?.text;\n        if (typeof text !== 'string') {\n            throw createError('parse_error', `Unexpected response payload from ${name}.`, response);\n        }\n        try {\n            return JSON.parse(text) as unknown;\n        } catch (error) {\n            throw createError('parse_error', `Failed to parse JSON payload from ${name}.`, error);\n        }\n    }\n}\n\nfunction support(mode: ReviewRouteSupport['mode'], reason: string): ReviewRouteSupport {\n    return { mode, reason };\n}\n\nfunction stripUndefined(args: Record<string, unknown>): Record<string, unknown> {\n    return Object.fromEntries(Object.entries(args).filter(([, value]) => value !== undefined));\n}\n\nfunction normalizeError(error: unknown): ReviewRpcError {\n    if (isReviewRpcError(error)) {\n        return error;\n    }\n    if (error instanceof Error) {\n        return createError('rpc_error', error.message, error);\n    }\n    return createError('rpc_error', String(error));\n}\n\nfunction isReviewRpcError(error: unknown): error is ReviewRpcError {\n    return typeof error === 'object' && error !== null && 'code' in error && 'message' in error;\n}\n\nfunction createError(code: ReviewErrorCode, message: string, cause?: unknown): ReviewRpcError {\n    return { code, message, cause };\n}\n\nfunction contradictionReason(args: ReviewContradictionDecisionArgs): string {\n    const detector = args.detectedBy?.trim();\n    const base = args.reason?.trim();\n    if (args.linkType === 'supersedes') {\n        return base\n            || `Marked ${args.targetMemoryId} as superseded by ${args.sourceMemoryId}${detector ? ` (${detector})` : ''}.`;\n    }\n    return base\n        || `Invalidated ${args.targetMemoryId} because it contradicts ${args.sourceMemoryId}${detector ? ` (${detector})` : ''}.`;\n}\n\nfunction eventReferencesMemory(event: ReviewEventTracePage['events'][number], memoryId: string): boolean {\n    if (event.references.some((reference) => reference.includes(memoryId))) {\n        return true;\n    }\n    if (event.summary.includes(memoryId)) {\n        return true;\n    }\n    return containsMemoryId(event.payload, memoryId);\n}\n\nfunction containsMemoryId(value: unknown, memoryId: string): boolean {\n    if (typeof value === 'string') {\n        return value.includes(memoryId);\n    }\n    if (Array.isArray(value)) {\n        return value.some((entry) => containsMemoryId(entry, memoryId));\n    }\n    if (typeof value === 'object' && value !== null) {\n        return Object.values(value).some((entry) => containsMemoryId(entry, memoryId));\n    }\n    return false;\n}\n\nfunction toConsolidationJob(event: ReviewEventTracePage['events'][number]): ReviewConsolidationJob | undefined {\n    const payload = typedPayload(event.payload);\n    if (event.kind === 'consolidation_failed') {\n        const failure = payload?.payload ?? {};\n        const errorKind = stringProperty(failure, 'error_kind');\n        return {\n            jobId: stringProperty(failure, 'job_id') || event.eventId,\n            status: errorKind === 'queue_full' ? 'dropped' : 'failed',\n            kind: stringProperty(failure, 'job_kind') || 'unknown',\n            mode: stringProperty(failure, 'mode') || 'background',\n            sessionId: event.sessionId,\n            taskId: event.taskId,\n            createdAt: event.timestamp,\n            completedAt: event.timestamp,\n            llmModel: stringProperty(failure, 'model_name') || undefined,\n            resultSummary: event.summary,\n            sourceEventId: event.eventId,\n            errorKind: errorKind || undefined,\n            errorMessage: stringProperty(failure, 'error_message') || undefined,\n        };\n    }\n    if (event.kind !== 'memory_consolidated') {\n        return undefined;\n    }\n    const memoryPayload = payload?.payload ?? {};\n    const proposalId = stringProperty(memoryPayload, 'proposal_id');\n    const createdAt = event.timestamp;\n    return {\n        jobId: proposalId || event.eventId,\n        proposalId: proposalId || undefined,\n        status: proposalId ? 'proposed' : 'applied',\n        kind: inferConsolidationKind(event.summary, proposalId),\n        mode: inferConsolidationMode(event.summary),\n        sessionId: event.sessionId,\n        taskId: event.taskId,\n        createdAt,\n        completedAt: proposalId ? undefined : createdAt,\n        resultSummary: event.summary,\n        targetMemoryId: extractMemoryIdFromPayload(memoryPayload),\n        sourceEventId: event.eventId,\n    };\n}\n\nfunction buildQueueDepth(jobs: ReviewConsolidationJob[]): ReviewQueueDepthSnapshot {\n    const currentDepth = jobs.filter((job) => ['queued', 'running', 'proposed'].includes(job.status)).length;\n    const droppedCount = jobs.filter((job) => job.status === 'dropped').length;\n    const notes = droppedCount > 0\n        ? ['Dropped jobs were reconstructed from consolidation failure events with error_kind=queue_full.']\n        : [];\n    return {\n        currentDepth,\n        maxDepth: DEFAULT_CONSOLIDATION_QUEUE_DEPTH,\n        droppedCount,\n        notes,\n    };\n}\n\nfunction dedupeJobs(jobs: ReviewConsolidationJob[]): ReviewConsolidationJob[] {\n    const seen = new Set<string>();\n    return jobs\n        .sort((left, right) => (Date.parse(right.createdAt ?? '') || 0) - (Date.parse(left.createdAt ?? '') || 0))\n        .filter((job) => {\n            const key = `${job.jobId}:${job.status}`;\n            if (seen.has(key)) {\n                return false;\n            }\n            seen.add(key);\n            return true;\n        });\n}\n\nfunction typedPayload(value: unknown): { kind?: string; payload?: Record<string, unknown> } | undefined {\n    if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n        return undefined;\n    }\n    const record = value as Record<string, unknown>;\n    const payload = record.payload;\n    return {\n        kind: typeof record.kind === 'string' ? record.kind : undefined,\n        payload: typeof payload === 'object' && payload !== null && !Array.isArray(payload)\n            ? payload as Record<string, unknown>\n            : record,\n    };\n}\n\nfunction stringProperty(record: Record<string, unknown>, key: string): string {\n    return typeof record[key] === 'string' ? record[key] as string : '';\n}\n\nfunction countEventsSinceHours(events: ReviewEventTracePage['events'], hours: number): number {\n    const cutoff = Date.now() - hours * 60 * 60 * 1000;\n    return events.filter((event) => {\n        const timestamp = Date.parse(event.timestamp);\n        return !Number.isNaN(timestamp) && timestamp >= cutoff;\n    }).length;\n}\n\nfunction extractMemoryIdFromPayload(payload: Record<string, unknown>): string | undefined {\n    const value = payload.consolidated_memory_id;\n    if (typeof value === 'string') {\n        return value;\n    }\n    if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n        return undefined;\n    }\n    const record = value as Record<string, unknown>;\n    return typeof record.ulid === 'string' ? record.ulid : undefined;\n}\n\nfunction inferConsolidationKind(summary: string, proposalId: string): string {\n    const normalized = `${summary} ${proposalId}`.toLowerCase();\n    if (normalized.includes('procedure')) {\n        return 'procedure_extraction';\n    }\n    if (normalized.includes('failure')) {\n        return 'failure_pattern_extraction';\n    }\n    if (normalized.includes('duplicate')) {\n        return 'duplicate_detection';\n    }\n    if (normalized.includes('contradict')) {\n        return 'contradiction_detection';\n    }\n    if (normalized.includes('supersed')) {\n        return 'supersession_proposal';\n    }\n    if (normalized.includes('docs')) {\n        return 'docs_update_proposal';\n    }\n    return 'episode_summary';\n}\n\nfunction inferConsolidationMode(summary: string): string {\n    const normalized = summary.toLowerCase();\n    if (normalized.includes('replay')) {\n        return 'replay';\n    }\n    if (normalized.includes('background')) {\n        return 'background';\n    }\n    return 'manual_review';\n}\n\nfunction nodeFamilyCount(family: string, snapshot: ReviewIndexStatus): number | undefined {\n    switch (family) {\n        case 'File':\n            return snapshot.files;\n        case 'Package':\n            return snapshot.repos.length || 1;\n        default:\n            return undefined;\n    }\n}\n","numLines":921,"startLine":1,"totalLines":921}}}
