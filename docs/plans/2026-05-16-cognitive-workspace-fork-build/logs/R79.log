alue.filter((entry): entry is string => typeof entry === 'string');\n386\t}\n387\t\n388\texport function normalizeMemory(record: Record<string, unknown>): ReviewMemory {\n389\t    return {\n390\t        id: stringValue(record, 'id'),\n391\t        sessionId: optionalString(record, 'session_id'),\n392\t        content: stringValue(record, 'content'),\n393\t        memoryClass: stringValue(record, 'memory_class'),\n394\t        assertionType: stringValue(record, 'assertion_type'),\n395\t        scope: stringValue(record, 'scope'),\n396\t        confidence: numberValue(record, 'confidence'),\n397\t        confidenceReason: optionalString(record, 'confidence_reason'),\n398\t        verificationStatus: stringValue(record, 'verification_status'),\n399\t        freshnessStatus: stringValue(record, 'freshness_status'),\n400\t        contradictionState: stringValue(record, 'contradiction_state'),\n401\t        supersessionState: stringValue(record, 'supersession_state'),\n402\t        inclusionReason: stringValue(record, 'inclusion_reason'),\n403\t        evidenceStrength: numberValue(record, 'evidence_strength'),\n404\t        linkedFiles: stringArrayValue(record, 'linked_files'),\n405\t        linkedSymbols: stringArrayValue(record, 'linked_symbols'),\n406\t        linkedDocs: stringArrayValue(record, 'linked_docs'),\n407\t        linkedTests: stringArrayValue(record, 'linked_tests'),\n408\t        linkedMemories: stringArrayValue(record, 'linked_memories'),\n409\t        validityConditions: stringArrayValue(record, 'validity_conditions'),\n410\t        invalidationTriggers: stringArrayValue(record, 'invalidation_triggers'),\n411\t        sourceQuery: optionalString(record, 'source_query'),\n412\t        branch: optionalString(record, 'branch'),\n413\t        refreshKey: optionalString(record, 'refresh_key'),\n414\t        workspaceId: optionalString(record, 'workspace_id'),\n415\t        createdAt: typeof record.created_at === 'number' ? record.created_at : undefined,\n41