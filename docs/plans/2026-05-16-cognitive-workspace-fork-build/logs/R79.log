\t    return {\n503\t        totalToolCalls: numberValue(record, 'total_tool_calls'),\n504\t        workflowToolCalls: numberValue(record, 'workflow_tool_calls'),\n505\t        totalPayloadTokens: numberValue(record, 'total_payload_tokens'),\n506\t        averagePayloadTokensPerTool: numberValue(record, 'average_payload_tokens_per_tool'),\n507\t        totalPayloadBytes: numberValue(record, 'total_payload_bytes'),\n508\t        averagePayloadBytesPerTool: numberValue(record, 'average_payload_bytes_per_tool'),\n509\t        contextHandleReuses: numberValue(record, 'context_handle_reuses'),\n510\t        contextHandleReuseRate: numberValue(record, 'context_handle_reuse_rate'),\n511\t    };\n512\t}\n513\t\n514\texport function normalizeEventTracePage(payload: Record<string, unknown>): ReviewEventTracePage {\n515\t    const scopeRecord = typeof payload.scope === 'object' && payload.scope !== null\n516\t        ? payload.scope as Record<string, unknown>\n517\t        : {};\n518\t    const events = arrayValue(payload, 'events').map((event) => ({\n519\t        eventId: stringValue(event, 'event_id'),\n520\t        expansionHandle: stringValue(event, 'expansion_handle'),\n521\t        kind: stringValue(event, 'kind'),\n522\t        timestamp: stringValue(event, 'timestamp'),\n523\t        actor: normalizeActor(event.actor),\n524\t        branch: stringValue(event, 'branch'),\n525\t        sessionId: stringValue(event, 'session_id'),\n526\t        taskId: optionalString(event, 'task_id'),\n527\t        workspaceId: stringValue(event, 'workspace_id'),\n528\t        summary: stringValue(event, 'summary'),\n529\t        references: stringArrayValue(event, 'references'),\n530\t        payload: event.payload,\n531\t        payloadHash: optionalString(event, 'payload_hash'),\n532\t        spilledPayloadRowId: typeof event.spilled_payload_row_id === 'number'\n533\t            ? event.spilled_payload_row_id\n534\t            : undefined,\n535\t    }));\n536\t    return {\n537\t     