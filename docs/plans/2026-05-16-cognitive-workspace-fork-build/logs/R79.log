      enqueuedAt: typeof proposal.enqueued_at === 'number' ? proposal.enqueued_at : undefined,\n618\t        decision: stringValue(proposal, 'decision'),\n619\t        proposedClass: optionalString(proposal, 'proposed_class'),\n620\t        currentScope: optionalString(proposal, 'current_scope'),\n621\t        targetScope: optionalString(proposal, 'target_scope'),\n622\t        confidence: typeof proposal.confidence === 'number' ? proposal.confidence : undefined,\n623\t        evidenceCount: numberValue(proposal, 'evidence_count'),\n624\t        priorState: proposal.prior_state,\n625\t        proposedState: proposal.proposed_state,\n626\t        evidence: proposal.evidence,\n627\t        provenance: proposal.provenance,\n628\t    }));\n629\t    const categories = arrayValue(payload, 'categories').map((category) => ({\n630\t        category: stringValue(category, 'category'),\n631\t        proposalIds: stringArrayValue(category, 'proposal_ids'),\n632\t        note: optionalString(category, 'note'),\n633\t    }));\n634\t    return {\n635\t        sessionId: stringValue(payload, 'session_id'),\n636\t        mode: stringValue(payload, 'mode'),\n637\t        renderMode: stringValue(payload, 'render_mode'),\n638\t        budgetMs: typeof payload.budget_ms === 'number' ? payload.budget_ms : undefined,\n639\t        incomplete: payload.incomplete === true,\n640\t        notes: stringArrayValue(payload, 'notes'),\n641\t        proposals,\n642\t        categories,\n643\t    };\n644\t}\n645\t\n646\tfunction normalizeActor(value: unknown): string {\n647\t    if (typeof value === 'string') {\n648\t        return value;\n649\t    }\n650\t    if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n651\t        return '';\n652\t    }\n653\t    const record = value as Record<string, unknown>;\n654\t    const type = typeof record.type === 'string' ? record.type : '';\n655\t    const label = typeof record.label === 'string' ? record.label : '';\n656\t    if (label) {\n657\t        return label;\n658\t    }\n659\t    if (type) {\n660\t        return type;\n661\t    }\n662\t    const keys = Object.keys(record);\n663\t    if (keys.length === 1) {\n664\t        const [kind] = keys;\n665\t        const detail = record[kind];\n666\t        if (typeof detail === 'object' && detail !== null && !Array.isArray(detail)) {\n667\t            const named = detail as Record<string, unknown>;\n668\t            const suffix = typeof named.model === 'string'\n669\t                ? named.model\n670\t                : typeof named.name === 'string'\n671\t                    ? named.name\n672\t                    : '';\n673\t            return suffix ? `${kind}:${suffix}` : kind;\n674\t        }\n675\t        return kind;\n676\t    }\n677\t    return '';\n678\t}\n679\t"}]},"parent_tool_use_id":null,"session_id":"fbec9507-2ec8-4c28-a044-dba0cf5769ae","uuid":"1e99a872-7f4e-4414-8203-d187eaff21b6","timestamp":"2026-05-17T19:06:19.921Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/extension/src/review/rpcPayloads.ts","content":"export interface ReviewMemory {\n    id: string;\n    sessionId?: string;\n    content: string;\n    memoryClass: string;\n    assertionType: string;\n    scope: string;\n    confidence: number;\n    confidenceReason?: string;\n    verificationStatus: string;\n    freshnessStatus: string;\n    contradictionState: string;\n    supersessionState: string;\n    inclusionReason: string;\n    evidenceStrength: number;\n    linkedFiles: string[];\n    linkedSymbols: string[];\n    linkedDocs: string[];\n    linkedTests: string[];\n    linkedMemories: string[];\n    validityConditions: string[];\n    invalidationTriggers: string[];\n    sourceQuery?: string;\n    branch?: string;\n    refreshKey?: string;\n    workspaceId?: string;\n    createdAt?: number;\n    staleReason?: string;\n    lastVerifiedAt?: number;\n    lastVerifiedGraphSnapshotId?: number;\n    evidence: unknown[];\n    links: unknown[