\t\n3822\t        let entries = serialize_memory_values(&store, &memories, true)?;\n3823\t\n3824\t        Ok(wrap_tool_result(json!({\n3825\t            \"count\": entries.len(),\n3826\t            \"query\": query,\n3827\t            \"memories\": entries\n3828\t        })))\n3829\t    }\n3830\t\n3831\t    async fn tool_promote_observation(&self, args: &Value) -> Result<Value, (i32, String)> {\n3832\t        let id = args[\"id\"]\n3833\t            .as_str()\n3834\t            .ok_or((-32602, \"Missing required parameter: id\".to_string()))?;\n3835\t        let scope =\n3836\t            parse_memory_scope(args[\"scope\"].as_str()).map_err(|message| (-32602, message))?;\n3837\t        let linked_files = parse_optional_string_array(args, \"linked_files\");\n3838\t        let workspace_id = args[\"workspace_id\"]\n3839\t            .as_str()\n3840\t            .map(|value| value.to_string())\n3841\t            .or_else(|| Some(self.workspace_root.to_string_lossy().to_string()));\n3842\t        let branch = args[\"branch\"].as_str().map(|value| value.to_string());\n3843\t        let refresh_key = args[\"refresh_key\"].as_str().map(|value| value.to_string());\n3844\t\n3845\t        let store = self.memory_store.lock().await;\n3846\t        store\n3847\t            .promote_memory(\n3848\t                id,\n3849\t                scope.clone(),\n3850\t                linked_files.as_deref(),\n3851\t                workspace_id.as_deref(),\n3852\t                branch.as_deref(),\n3853\t                refresh_key.as_deref(),\n3854\t            )\n3855\t            .map_err(|e| (-32603, format!(\"Failed to promote observation: {}\", e)))?;\n3856\t\n3857\t        Ok(wrap_tool_result(json!({\n3858\t            \"status\": \"promoted\",\n3859\t            \"id\": id,\n3860\t            \"scope\": scope.as_str(),\n3861\t            \"linked_files\": linked_files,\n3862\t            \"workspace_id\": workspace_id,\n3863\t            \"branch\": branch,\n3864\t            \"refresh_key\": refresh_key\n3865\t        })))\n3866\t    }\n3867\t\n3868\t    async fn tool_refresh_memory(&self, args: &Value) -> Result<Value, (i32, String)> {\n3869\t        let id = args[\"id\"]\n3870\t            .as_str()\n3871\t            .ok_or((-32602, \"Missing required parameter: id\".to_string()))?;\n3872\t        let content = args[\"content\"].as_str();\n3873\t        let memory_type = args[\"memory_type\"].as_str().map(MemoryType::from_str);\n3874\t        let scope = if args.get(\"scope\").is_some() {\n3875\t            Some(parse_memory_scope(args[\"scope\"].as_str()).map_err(|message| (-32602, message))?)\n3876\t        } else {\n3877\t            None\n3878\t        };\n3879\t        let linked_symbols = parse_optional_string_array(args, \"linked_symbols\");\n3880\t        let linked_files = parse_optional_string_array(args, \"linked_files\");\n3881\t        let workspace_id = args[\"workspace_id\"].as_str();\n3882\t        let branch = args[\"branch\"].as_str();\n3883\t        let refresh_key = args[\"refresh_key\"].as_str();\n3884\t        let source_query = args[\"source_query\"].as_str();\n3885\t        let confidence = args[\"confidence\"].as_f64();\n3886\t\n3887\t        if let Some(confidence) = confidence {\n3888\t            if !(0.0..=1.0).contains(&confidence) {\n3889\t                return Err((\n3890\t                    -32602,\n3891\t                    \"Invalid confidence: expected a value between 0.0 and 1.0\".to_string(),\n3892\t                ));\n3893\t            }\n3894\t        }\n3895\t\n3896\t        let has_updates = content.is_some()\n3897\t            || memory_type.is_some()\n3898\t            || scope.is_some()\n3899\t            || linked_symbols.is_some()\n3900\t            || linked_files.is_some()\n3901\t            || workspace_id.is_some()\n3902\t            || branch.is_some()"}]},"parent_tool_use_id":null,"session_id":"fbec9507-2ec8-4c28-a044-dba0cf5769ae","uuid":"fafbfa6d-b063-4704-a660-d11bea5ed591","ti