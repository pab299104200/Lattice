 color: true,\n        timeout: 30_000,\n    });\n    const testsRoot = path.resolve(__dirname, '..');\n\n    for (const file of collectTestFiles(testsRoot)) {\n        mocha.addFile(file);\n    }\n\n    await new Promise<void>((resolve, reject) => {\n        mocha.run((failures) => {\n            if (failures > 0) {\n                reject(new Error(`${failures} extension smoke tests failed.`));\n                return;\n            }\n            resolve();\n        });\n    });\n}\n\nfunction collectTestFiles(root: string): string[] {\n    const files: string[] = [];\n    for (const entry of fs.readdirSync(root, { withFileTypes: true })) {\n        const absolute = path.join(root, entry.name);\n        if (entry.isDirectory()) {\n            if (entry.name !== 'suite') {\n                files.push(...collectTestFiles(absolute));\n            }\n            continue;\n        }\n        if (entry.name.endsWith('.test.js')) {\n            files.push(absolute);\n        }\n    }\n    return files.sort();\n}\n","numLines":44,"startLine":1,"totalLines":44}}}
