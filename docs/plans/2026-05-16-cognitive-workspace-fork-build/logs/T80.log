diff --git a/daemon/crates/lattice-core/src/hardening/large_repo_tests.rs b/daemon/crates/lattice-core/src/hardening/large_repo_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c99a1e011b2e18dbbabe3d393fc93a63041291fa
