+fn search_symbols(graph: &CodeGraph, pattern: &str) -> Vec<String> {
+    let needle = pattern.to_lowercase();
+    graph
+        .all_nodes()
+        .into_iter()
+        .filter(|node| node.name.to_lowercase().contains(&needle))
+        .take(20)
+        .map(|node| format!("{}::{}", node.file, node.name))
+        .collect()
+}
+
