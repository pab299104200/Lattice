+        .ok()
+        .as_deref()
+        == Some("1")
+    {
+        return target_files;
+    }
+    target_files.clamp(10, 20)
+}
+
+fn compaction_event_count() -> usize {
+    if std::env::var("LATTICE_FULL_LARGE_REPO_PERF")
