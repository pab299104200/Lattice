+                Some("test"),
+                &runtime.rules,
+                BundleMode::Compact,
+            )
+        }),
+        measure_tool("search_symbols", |index| {
+            search_symbols(&runtime.graph, &format!("service_login_{}", index % 8))
+        }),
+        measure_tool("find_relevant_tests", |_| {
+            find_relevant_tests(
+                &runtime.graph,
+                &anchor_files(),
+                &anchor_symbols(),
+                None,
+                &runtime.rules,
+                8,
+            )
+        }),
