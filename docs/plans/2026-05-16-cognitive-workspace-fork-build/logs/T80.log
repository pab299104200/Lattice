    let mut files: Vec<String> = graph
        .all_nodes()
        .into_iter()
        .map(|node| node.file.clone())
        .collect();
    files.sort();
    files.dedup();
    RulesDetector::new().detect_rules(&files)
}

fn graph_file_count(graph: &CodeGraph) -> usize {
    graph
        .all_nodes()
        .into_iter()
        .map(|node| node.file.clone())
        .collect::<BTreeSet<_>>()
        .len()
}

