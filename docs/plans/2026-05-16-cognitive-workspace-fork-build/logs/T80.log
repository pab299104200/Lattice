+fn traversal_budget(graph: &CodeGraph) -> TraversalBudget {
+    let node = graph
+        .all_nodes()
+        .into_iter()
+        .find(|node| node.name == "service_login_0")
+        .expect("anchor symbol exists");
+    TraversalBudget {
+        max_hops: 2,
+        max_neighbors_seen: graph.n_hop_neighbors(&node.id, 2).len(),
+    }
+}
