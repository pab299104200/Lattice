    }

    fn flush_if_needed(&self, flush_policy: FlushPolicy) -> Result<(), EventWriteError> {
        match flush_policy {
            FlushPolicy::Sync => self.store.checkpoint_wal().map_err(EventWriteError::from),
            FlushPolicy::Batched { interval_ms: _ } => Ok(()),
        }
