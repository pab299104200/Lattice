+fn detect_rules(graph: &CodeGraph) -> Vec<ProjectRule> {
+    let mut files = graph
+        .all_nodes()
+        .into_iter()
+        .map(|node| node.file.clone())
+        .collect::<Vec<_>>();
+    files.sort();
+    files.dedup();
+    RulesDetector::new().detect_rules(&files)
+}
