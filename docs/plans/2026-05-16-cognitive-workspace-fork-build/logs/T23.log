+fn insert_memory(tx: &Transaction<'_>, record: &MemoryRecord) -> Result<(), MemoryStoreError> {
+    tx.execute(
+        "INSERT INTO memories
+            (memory_id, content, class, assertion_type, scope, scope_session_id, scope_branch,
