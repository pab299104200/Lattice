+        Value::Text(
+            serde_json::to_string(&record.supersession_links).expect("supersessions encode"),
+        ),
+        Value::Text(serde_json::to_string(&record.access_history).expect("access history encodes")),
+        optional_i64(record.last_verified_event_id),
