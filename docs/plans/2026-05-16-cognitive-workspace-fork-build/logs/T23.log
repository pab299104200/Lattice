+            ScopeFilter::session(record.scope_session_id.clone().unwrap_or_default())
+        }
+        MemoryScope::Branch => ScopeFilter::branch(
+            record.scope_workspace_id.clone().unwrap_or_default(),
+            record.scope_branch.clone().unwrap_or_default(),
+        ),
+        MemoryScope::Repo => {
