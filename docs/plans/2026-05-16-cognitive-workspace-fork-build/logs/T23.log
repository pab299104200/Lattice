+fn ensure_scope_filter(scope: &ScopeFilter) -> Result<(), MemoryStoreError> {
+    if scope.is_empty() {
+        Err(MemoryStoreError::ScopeViolation(ScopeError::Underspecified))
+    } else {
+        Ok(())
