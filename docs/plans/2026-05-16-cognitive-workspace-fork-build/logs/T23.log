+        event_id.clone(),
+        now,
+        "memory created",
+    )?);
+    for (index, reference) in record.evidence_references.iter().enumerate() {
+        if let StableRef::EventRef(existing_event_id) = &reference.target {
+            evidence.push(MemoryEvidence {
+                evidence_id: MemoryEvidenceId(format!("{}-seed-{index}", memory_id.ulid)),
+                memory_id: memory_id.clone(),
+                event_id: Some(existing_event_id.clone()),
+                anchor: EvidenceAnchor::EventReference(existing_event_id.clone()),
+                captured_at: chrono_timestamp(now)?,
+                captured_by: Actor::Daemon,
             });
         }
-        Ok(())
     }
+    Ok(evidence)
+}
+
+fn stamp_evidence(
+    mut evidence: MemoryEvidence,
+    memory_id: MemoryId,
+    event_id: EventId,
+    now: i64,
+) -> Result<MemoryEvidence, MemoryStoreError> {
+    evidence.memory_id = memory_id;
+    evidence.event_id = Some(event_id);
+    evidence.captured_at = chrono_timestamp(now)?;
+    Ok(evidence)
+}
+
+fn event_reference_evidence(
+    memory_id: MemoryId,
+    event_id: EventId,
+    now: i64,
+    suffix: &str,
+) -> Result<MemoryEvidence, MemoryStoreError> {
+    Ok(MemoryEvidence {
+        evidence_id: MemoryEvidenceId(format!("{}-{}", memory_id.ulid, suffix.replace(' ', "-"))),
+        memory_id,
+        event_id: Some(event_id.clone()),
+        anchor: EvidenceAnchor::EventReference(event_id),
+        captured_at: chrono_timestamp(now)?,
+        captured_by: Actor::Daemon,
+    })
+}
+
+fn chrono_timestamp(unix_seconds: i64) -> Result<DateTime<Utc>, MemoryStoreError> {
+    Ok(DateTime::from_unix_seconds(unix_seconds))
+}
