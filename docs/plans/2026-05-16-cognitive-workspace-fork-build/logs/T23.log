+                VerificationStatus::Invalidated
+            )
+            | (VerificationStatus::Stale, VerificationStatus::Verified)
+            | (VerificationStatus::Stale, VerificationStatus::Invalidated)
+    );
+    if allowed {
+        Ok(())
+    } else {
+        Err(MemoryTransitionError::DisallowedTransition { from, to })
     }
 }

