    pub qualified_name: String,
    pub byte_offset: usize,
    pub kind: String,
}

#[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]
pub struct DocId {
    pub workspace_id: String,
    pub repo_relative_path: String,
