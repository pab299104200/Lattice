+fn lock_connection(conn: &Arc<Mutex<Connection>>) -> Result<std::sync::MutexGuard<'_, Connection>, MemoryStoreError> {
+    conn.lock().map_err(|_| MemoryStoreError::ConstraintViolation {
+        detail: "memory store connection lock was poisoned".to_string(),
+    })
+}
