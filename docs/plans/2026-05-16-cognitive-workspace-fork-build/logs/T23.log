const EVENT_DB_JOURNAL_SIZE_LIMIT_BYTES: u32 = 1_048_576;
pub const MAX_EVENT_PAYLOAD_BYTES: usize = 64 * 1024 * 1024;
const MAX_SPILLED_PAYLOAD_BYTES: usize = 64 * 1024 * 1024;
const MAX_QUERY_LIMIT: i64 = 10_000;
