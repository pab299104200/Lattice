+fn collect_initial_evidence(
+    memory_id: &MemoryId,
+    event_id: &EventId,
+    record: &MemoryRecord,
+    now: i64,
+) -> Result<Vec<MemoryEvidence>, MemoryStoreError> {
+    let mut evidence = Vec::new();
+    evidence.push(event_reference_evidence(
