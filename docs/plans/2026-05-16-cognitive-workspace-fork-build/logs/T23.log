+            last_verified_state = ?28,
+            usefulness_score = ?29,
+            usefulness_score_updated_at = ?30,
+            created_at = ?31,
+            created_by = ?32,
+            updated_at = ?33,
+            updated_by = ?34,
+            superseded_by = ?35,
+            schema_version = ?36
+         WHERE memory_id = ?1",
