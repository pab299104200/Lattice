+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct MemoryPatch {
+    pub content: Option<String>,
+    pub confidence: Option<f64>,
+    pub freshness_policy: Option<FreshnessPolicy>,
+    pub validity_conditions: Option<Vec<ValidityCondition>>,
+    pub invalidation_triggers: Option<Vec<InvalidationTrigger>>,
+    pub scope: Option<MemoryScopeState>,
+}
+
+#[derive(Debug, Error)]
+pub enum MemoryStoreError {
+    #[error("memory `{0}` was not found")]
+    NotFound(MemoryId),
+    #[error(transparent)]
+    ScopeViolation(#[from] ScopeError),
+    #[error("memory store constraint violation: {detail}")]
+    ConstraintViolation { detail: String },
+    #[error("memory store SQLite error: {0}")]
+    Storage(#[from] rusqlite::Error),
+    #[error(transparent)]
+    Identity(#[from] crate::events::IdentityError),
+    #[error(transparent)]
+    EventEmit(#[from] EventWriteError),
+}
+
+pub struct MemoryStore {
+    conn: Arc<Mutex<Connection>>,
+    event_writer: Arc<EventWriter>,
+}
+
+impl MemoryStore {
+    pub fn open(conn: Arc<Mutex<Connection>>, event_writer: Arc<EventWriter>) -> Self {
+        Self { conn, event_writer }
+    }
+
+    pub fn create(
+        &self,
+        draft: MemoryDraft,
+        idempotency_key: IdempotencyKey,
+    ) -> Result<MemoryRecord, MemoryStoreError> {
+        validate_scope(&draft.scope)?;
+        validate_confidence(draft.confidence)?;
+        let mut conn = self
+            .conn
+            .lock()
+            .map_err(|_| poisoned_lock_error("memory store connection"))?;
+        if let Some(memory_id) = lookup_idempotency(conn.deref(), &idempotency_key)? {
+            return load_memory(conn.deref(), &memory_id);
+        }
+
+        let memory_id = MemoryId {
+            workspace_id: scope_workspace(&draft.scope, &draft.initial_evidence, &draft.linked_files)?,
+            ulid: next_ulid(now_unix_seconds()?),
+        };
+        let timestamp = now_unix_seconds()?;
+        let mut tx = conn.transaction()?;
+        let mut record = record_from_draft(memory_id.clone(), draft, timestamp);
+        insert_memory(&tx, &record)?;
+        bind_idempotency(&tx, &idempotency_key, &record.memory_id)?;
+
+        let source_event_id = record.provenance_event_ids.last().cloned();
+        let lifecycle_event = self.append_memory_created(&record, &idempotency_key, source_event_id)?;
+        record.provenance_event_ids.push(lifecycle_event.clone());
+        record.evidence_references.push(EvidenceReference {
+            target: StableRef::EventRef(lifecycle_event.clone()),
+            event_id: Some(lifecycle_event.clone()),
+            summary: "memory created".to_string(),
+        });
+        replace_memory(&tx, &record)?;
+        for evidence in record
+            .evidence_references
+            .iter()
+            .zip(record_from_evidence(&record.memory_id, lifecycle_event.clone(), &tx, &record)?)
+            .map(|(_, evidence)| evidence)
+        {
+            insert_evidence(&tx, &evidence).map_err(map_evidence_error)?;
+        }
+        tx.commit()?;
+        load_memory(conn.deref(), &memory_id)
+    }
+
+    pub fn get(
+        &self,
+        memory_id: &MemoryId,
+        scope: &ScopeFilter,
+    ) -> Result<MemoryRecord, MemoryStoreError> {
+        ensure_scope_filter(scope)?;
+        let conn = self
+            .conn
+            .lock()
+            .map_err(|_| poisoned_lock_error("memory store connection"))?;
+        let record = load_memory(conn.deref(), memory_id)?;
+        record_scope_filter(&record).enforce_subset(scope)?;
+        Ok(record)
+    }
+
+    pub fn list_by_class(
+        &self,
+        class: MemoryClass,
+        scope: &ScopeFilter,
+        limit: usize,
+    ) -> Result<Vec<MemoryRecord>, MemoryStoreError> {
+        self.list_with_filter("class = ?", Value::Text(class.as_str().to_string()), scope, limit)
+    }
+
+    pub fn list_by_stream(
+        &self,
+        stream: super::MemoryStream,
+        scope: &ScopeFilter,
+        limit: usize,
+    ) -> Result<Vec<MemoryRecord>, MemoryStoreError> {
+        let conn = self
+            .conn
+            .lock()
+            .map_err(|_| poisoned_lock_error("memory store connection"))?;
+        ensure_scope_filter(scope)?;
+        let predicate = scope.to_sql_predicate();
+        let mut params = predicate.bind_values;
+        params.push(Value::Integer(limit_i64(limit)?));
+        let mut statement = conn.prepare(&format!(
+            "SELECT {} FROM memories WHERE {} ORDER BY created_at DESC, memory_id ASC LIMIT ?",
+            select_columns(),
+            predicate.where_clause
+        ))?;
+        let rows = statement.query_map(params_from_iter(params), |row| decode_memory_row(row))?;
+        let records = rows
+            .collect::<Result<Vec<_>, _>>()
+            .map_err(convert_row_error)?;
+        Ok(records
+            .into_iter()
+            .filter(|record| classify_stream(record.class, record.assertion_type) == stream)
+            .collect())
+    }
+
+    pub fn list_by_status(
+        &self,
+        status: VerificationStatus,
+        scope: &ScopeFilter,
+        limit: usize,
+    ) -> Result<Vec<MemoryRecord>, MemoryStoreError> {
+        self.list_with_filter(
+            "verification_status = ?",
+            Value::Text(status.as_str().to_string()),
+            scope,
+            limit,
+        )
+    }
+
+    pub fn update(
+        &self,
+        memory_id: &MemoryId,
+        patch: MemoryPatch,
+        evidence: Option<MemoryEvidence>,
+        idempotency_key: IdempotencyKey,
+    ) -> Result<MemoryRecord, MemoryStoreError> {
+        let mut conn = self
+            .conn
+            .lock()
+            .map_err(|_| poisoned_lock_error("memory store connection"))?;
+        if let Some(existing_memory_id) = lookup_idempotency(conn.deref(), &idempotency_key)? {
+            if existing_memory_id != *memory_id {
+                return Err(MemoryStoreError::ConstraintViolation {
+                    detail: format!(
+                        "idempotency key `{}` is already bound to `{}`",
+                        idempotency_key.as_str(),
+                        existing_memory_id
+                    ),
+                });
+            }
+            return load_memory(conn.deref(), memory_id);
+        }
+
+        let mut tx = conn.transaction()?;
+        let existing = load_memory(tx.deref(), memory_id)?;
+        let mut updated = apply_patch(existing.clone(), patch)?;
+        updated.updated_at = now_unix_seconds()?;
+        insert_or_ignore_idempotency(&tx, &idempotency_key, memory_id)?;
+        replace_memory(&tx, &updated)?;
+        let lifecycle_event = self.append_memory_updated(&existing, &updated, None, None)?;
+        updated.provenance_event_ids.push(lifecycle_event.clone());
+        if let Some(evidence_row) = evidence {
+            let stored = stamp_evidence(evidence_row, memory_id.clone(), lifecycle_event.clone());
+            insert_evidence(&tx, &stored).map_err(map_evidence_error)?;
+            updated.evidence_references.push(EvidenceReference {
+                target: StableRef::EventRef(lifecycle_event.clone()),
+                event_id: Some(lifecycle_event.clone()),
+                summary: "memory updated".to_string(),
+            });
+        }
+        replace_memory(&tx, &updated)?;
+        tx.commit()?;
+        load_memory(conn.deref(), memory_id)
+    }
+
+    pub fn delete(&self, memory_id: &MemoryId, reason: &str) -> Result<(), MemoryStoreError> {
+        let mut conn = self
+            .conn
+            .lock()
+            .map_err(|_| poisoned_lock_error("memory store connection"))?;
+        let mut tx = conn.transaction()?;
+        let mut record = load_memory(tx.deref(), memory_id)?;
+        record.verification_status = VerificationStatus::Invalidated;
+        record.updated_at = now_unix_seconds()?;
+        let event_id = self.append_memory_invalidated(&record, reason.to_string(), None)?;
+        record.provenance_event_ids.push(event_id.clone());
+        record.last_verified_state = Some(json!({
+            "status": VerificationStatus::Invalidated.as_str(),
+            "reason": reason,
+            "event_id": encode_identity(&Identity::Event(event_id.clone())),
+        }));
+        replace_memory(&tx, &record)?;
+        upsert_tombstone(&tx, memory_id, reason, record.updated_at, &event_id)?;
+        tx.commit()?;
+        Ok(())
+    }
+
+    pub(crate) fn load_for_transition(
+        &self,
+        memory_id: &MemoryId,
+    ) -> Result<MemoryRecord, MemoryStoreError> {
+        let conn = self
+            .conn
+            .lock()
+            .map_err(|_| poisoned_lock_error("memory store connection"))?;
+        load_memory(conn.deref(), memory_id)
+    }
+
+    pub(crate) fn write_transition(
+        &self,
+        prior: &MemoryRecord,
+        updated: &MemoryRecord,
+        reason: &str,
+        evidence: Option<MemoryEvidence>,
+    ) -> Result<MemoryRecord, MemoryStoreError> {
+        let mut conn = self
+            .conn
+            .lock()
+            .map_err(|_| poisoned_lock_error("memory store connection"))?;
+        let mut tx = conn.transaction()?;
+        replace_memory(&tx, updated)?;
+        let event_id = match updated.verification_status {
+            VerificationStatus::Invalidated => {
+                self.append_memory_invalidated(updated, reason.to_string(), None)?
+            }
+            _ => self.append_memory_updated(
+                prior,
+                updated,
+                Some(prior.verification_status),
+                Some(reason.to_string()),
+            )?,
+        };
+        let mut stored = updated.clone();
+        stored.provenance_event_ids.push(event_id.clone());
+        stored.last_verified_state = Some(json!({
+            "status": stored.verification_status.as_str(),
+            "reason": reason,
+            "event_id": encode_identity(&Identity::Event(event_id.clone())),
+        }));
+        if matches!(stored.verification_status, VerificationStatus::Superseded)
+            && stored.superseded_by.is_none()
+        {
+            return Err(MemoryStoreError::ConstraintViolation {
+                detail: "superseded memories must set superseded_by".to_string(),
+            });
+        }
+        if let Some(evidence_row) = evidence {
+            let stored_evidence =
+                stamp_evidence(evidence_row, stored.memory_id.clone(), event_id.clone());
+            insert_evidence(&tx, &stored_evidence).map_err(map_evidence_error)?;
+            stored.evidence_references.push(EvidenceReference {
+                target: StableRef::EventRef(event_id.clone()),
+                event_id: Some(event_id.clone()),
+                summary: format!("verification transition: {}", stored.verification_status.as_str()),
+            });
+        }
+        replace_memory(&tx, &stored)?;
+        if stored.verification_status == VerificationStatus::Invalidated {
+            upsert_tombstone(&tx, &stored.memory_id, reason, stored.updated_at, &event_id)?;
+        }
+        tx.commit()?;
+        load_memory(conn.deref(), &stored.memory_id)
+    }
+
+    fn list_with_filter(
+        &self,
+        filter_sql: &str,
+        filter_value: Value,
+        scope: &ScopeFilter,
+        limit: usize,
+    ) -> Result<Vec<MemoryRecord>, MemoryStoreError> {
+        let conn = self
+            .conn
+            .lock()
+            .map_err(|_| poisoned_lock_error("memory store connection"))?;
+        ensure_scope_filter(scope)?;
+        let predicate = scope.to_sql_predicate();
+        let mut params = vec![filter_value];
+        params.extend(predicate.bind_values);
+        params.push(Value::Integer(limit_i64(limit)?));
+        let sql = format!(
+            "SELECT {} FROM memories WHERE {} AND {} ORDER BY created_at DESC, memory_id ASC LIMIT ?",
+            select_columns(),
+            filter_sql,
+            predicate.where_clause
+        );
+        let mut statement = conn.prepare(&sql)?;
+        let rows = statement.query_map(params_from_iter(params), |row| decode_memory_row(row))?;
+        rows.collect::<Result<Vec<_>, _>>().map_err(convert_row_error)
+    }
+
+    fn append_memory_created(
+        &self,
+        record: &MemoryRecord,
+        idempotency_key: &IdempotencyKey,
+        source_event_id: Option<EventId>,
+    ) -> Result<EventId, MemoryStoreError> {
+        let payload = EventPayload::MemoryCreated(MemoryCreatedPayload {
+            memory_id: record.memory_id.clone(),
+            class: record.class.as_str().to_string(),
+            stream: classify_stream(record.class, record.assertion_type)
+                .as_str()
+                .to_string(),
+            scope: record.scope.as_str().to_string(),
+            idempotency_key: idempotency_key.as_str().to_string(),
+            source_event_id,
+            evidence_event_ids: collect_evidence_event_ids(record),
+            symbol_ids: record.linked_symbols.clone(),
+            doc_section_ids: record.linked_docs.clone(),
+        });
+        self.append_lifecycle_event(record, payload, "memory created", FlushPolicy::Batched { interval_ms: 50 })
+    }
+
+    fn append_memory_updated(
+        &self,
+        prior: &MemoryRecord,
+        updated: &MemoryRecord,
+        from_status: Option<VerificationStatus>,
+        reason: Option<String>,
+    ) -> Result<EventId, MemoryStoreError> {
+        let summary = match (from_status, reason) {
+            (Some(from), Some(reason)) => {
+                format!("{from:?}->{:?}: {reason}", updated.verification_status)
+            }
+            _ => "memory updated".to_string(),
+        };
+        let payload = EventPayload::MemoryUpdated(MemoryUpdatedPayload {
+            memory_id: updated.memory_id.clone(),
+            previous_event_id: prior.provenance_event_ids.last().cloned(),
+            evidence_event_ids: collect_evidence_event_ids(updated),
+            superseded_memory_id: updated.superseded_by.clone(),
+            update_summary: summary.clone(),
+        });
+        self.append_lifecycle_event(updated, payload, &summary, FlushPolicy::Batched { interval_ms: 50 })
+    }
+
+    fn append_memory_invalidated(
+        &self,
+        record: &MemoryRecord,
+        reason: String,
+        invalidated_by_event_id: Option<EventId>,
+    ) -> Result<EventId, MemoryStoreError> {
+        let payload = EventPayload::MemoryInvalidated(MemoryInvalidatedPayload {
+            memory_id: record.memory_id.clone(),
+            invalidated_by_event_id,
+            contradicting_memory_ids: record
+                .contradiction_links
+                .iter()
+                .map(|link| link.memory_id.clone())
+                .collect(),
+            reason: reason.clone(),
+        });
+        self.append_lifecycle_event(record, payload, &reason, FlushPolicy::Sync)
+    }
+
+    fn append_lifecycle_event(
+        &self,
+        record: &MemoryRecord,
+        payload: EventPayload,
+        summary: &str,
+        flush_policy: FlushPolicy,
+    ) -> Result<EventId, MemoryStoreError> {
+        let envelope = PartialEnvelope {
+            workspace_id: None,
+            branch: BranchRef {
+                name: record
+                    .scope_branch
+                    .clone()
+                    .unwrap_or_else(|| "memory-graph".to_string()),
+            },
+            session_id: SessionId {
+                value: record
+                    .scope_session_id
+                    .clone()
+                    .unwrap_or_else(|| "memory-graph".to_string()),
+            },
+            task_id: None,
+            actor: Actor::Daemon,
+            kind: payload.kind(),
+            references: lifecycle_refs(record),
+            summary: CompactSummary::new(summary.to_string())
+                .map_err(|error| MemoryStoreError::ConstraintViolation {
+                    detail: error.to_string(),
+                })?,
+            payload,
+        };
+        self.event_writer
+            .append_with_flush_policy(envelope, flush_policy)
+            .map_err(MemoryStoreError::EventEmit)
+    }
+}
+
+fn record_from_draft(memory_id: MemoryId, draft: MemoryDraft, timestamp: i64) -> MemoryRecord {
+    MemoryRecord {
+        memory_id,
+        content: draft.content,
+        class: draft.class,
+        assertion_type: draft.assertion_type,
+        scope: draft.scope.scope,
+        scope_session_id: draft.scope.scope_session_id,
+        scope_branch: draft.scope.scope_branch,
+        scope_workspace_id: draft.scope.scope_workspace_id,
+        scope_user_id: draft.scope.scope_user_id,
+        scope_org_id: draft.scope.scope_org_id,
+        verification_status: VerificationStatus::Unverified,
+        confidence: draft.confidence,
+        confidence_reason: draft.confidence_reason,
+        freshness_policy: draft.freshness_policy,
+        validity_conditions: draft.validity_conditions,
+        invalidation_triggers: draft.invalidation_triggers,
+        provenance_event_ids: draft.provenance_event_ids,
+        evidence_references: draft.evidence_references,
+        linked_files: draft.linked_files,
+        linked_symbols: draft.linked_symbols,
+        linked_docs: draft.linked_docs,
+        linked_tests: draft.linked_tests,
+        linked_memories: draft.linked_memories,
+        contradiction_links: draft.contradiction_links,
+        supersession_links: draft.supersession_links,
+        access_history: draft.access_history,
+        last_verified_event_id: None,
+        last_verified_state: None,
+        usefulness_score: 0.0,
+        usefulness_score_updated_at: timestamp,
+        created_at: timestamp,
+        created_by: draft.created_by,
+        updated_at: timestamp,
+        updated_by: draft.updated_by,
+        superseded_by: draft.superseded_by,
+        schema_version: if draft.schema_version == 0 {
+            MEMORY_SCHEMA_VERSION
+        } else {
+            draft.schema_version
+        },
+    }
+}
+
+fn apply_patch(mut record: MemoryRecord, patch: MemoryPatch) -> Result<MemoryRecord, MemoryStoreError> {
+    if let Some(content) = patch.content {
+        record.content = content;
+    }
+    if let Some(confidence) = patch.confidence {
+        validate_confidence(confidence)?;
+        record.confidence = confidence;
+    }
+    if let Some(freshness_policy) = patch.freshness_policy {
+        record.freshness_policy = freshness_policy;
+    }
+    if let Some(validity_conditions) = patch.validity_conditions {
+        record.validity_conditions = validity_conditions;
+    }
+    if let Some(invalidation_triggers) = patch.invalidation_triggers {
+        record.invalidation_triggers = invalidation_triggers;
+    }
+    if let Some(scope) = patch.scope {
+        validate_scope(&scope)?;
+        record.scope = scope.scope;
+        record.scope_session_id = scope.scope_session_id;
+        record.scope_branch = scope.scope_branch;
+        record.scope_workspace_id = scope.scope_workspace_id;
+        record.scope_user_id = scope.scope_user_id;
+        record.scope_org_id = scope.scope_org_id;
+    }
+    Ok(record)
+}
+
+fn lifecycle_refs(record: &MemoryRecord) -> Vec<EventStableRef> {
+    let mut refs = vec![EventStableRef::MemoryRef(record.memory_id.clone())];
+    refs.extend(record.linked_symbols.iter().cloned().map(EventStableRef::SymbolRef));
+    refs.extend(record.linked_docs.iter().cloned().map(EventStableRef::DocSectionRef));
+    refs
+}
+
+fn collect_evidence_event_ids(record: &MemoryRecord) -> Vec<EventId> {
+    record
+        .evidence_references
+        .iter()
+        .filter_map(|reference| reference.event_id.clone())
+        .collect()
+}
+
+fn record_from_evidence(
+    memory_id: &MemoryId,
+    event_id: EventId,
+    tx: &Transaction<'_>,
+    record: &MemoryRecord,
+) -> Result<Vec<MemoryEvidence>, MemoryStoreError> {
+    let mut evidence = get_evidence_for(tx.deref(), memory_id).map_err(map_evidence_error)?;
+    if evidence.is_empty() {
+        evidence = Vec::new();
+    }
+    let existing_ids: std::collections::HashSet<String> =
+        evidence.iter().map(|row| row.evidence_id.0.clone()).collect();
+    let stored = record
+        .evidence_references
+        .iter()
+        .enumerate()
+        .filter_map(|(index, reference)| match &reference.target {
+            StableRef::EventRef(_) => Some(MemoryEvidence {
+                evidence_id: super::MemoryEvidenceId(format!("evidence-{}-{index}", record.memory_id.ulid)),
+                memory_id: memory_id.clone(),
+                event_id: Some(event_id.clone()),
+                anchor: super::EvidenceAnchor::EventReference(event_id.clone()),
+                captured_at: chrono::Utc::now(),
+                captured_by: Actor::Daemon,
+            }),
+            _ => None,
+        })
+        .filter(|row| !existing_ids.contains(row.evidence_id.as_str()))
+        .collect();
+    Ok(stored)
+}
+
+fn stamp_evidence(mut evidence: MemoryEvidence, memory_id: MemoryId, event_id: EventId) -> MemoryEvidence {
+    evidence.memory_id = memory_id;
+    evidence.event_id = Some(event_id);
+    evidence
+}
