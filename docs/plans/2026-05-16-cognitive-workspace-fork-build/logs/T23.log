+        }
+        MemoryScope::User => ScopeFilter::user(record.scope_user_id.clone().unwrap_or_default()),
+        MemoryScope::Organization => {
+            ScopeFilter::organization(record.scope_org_id.clone().unwrap_or_default())
+        }
+    }
 }
 
