+fn upsert_tombstone(
+    tx: &Transaction<'_>,
+    memory_id: &MemoryId,
+    reason: &str,
+    deleted_at: i64,
+    event_id: &EventId,
+) -> Result<(), MemoryStoreError> {
+    tx.execute(
+        "INSERT INTO memory_tombstones (memory_id, reason, deleted_at, deleted_by_event_id)
+         VALUES (?1, ?2, ?3, ?4)
+         ON CONFLICT(memory_id) DO UPDATE SET
