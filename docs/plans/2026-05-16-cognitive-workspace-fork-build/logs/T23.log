+            .get::<_, Option<String>>(27)?
+            .map(|value| serde_json::from_str(&value))
+            .transpose()
+            .map_err(|error| row_decode_error(27, rusqlite::types::Type::Text, error))?,
+        usefulness_score: row.get(28)?,
