-        ),
-        InReview => matches!(
-            requested,
-            Verified | Unverified | Stale | Contradicted | Superseded | Expired | Invalidated
-        ),
-        Verified => matches!(
-            requested,
-            Stale | Contradicted | Superseded | Expired | Invalidated | InReview
-        ),
-        Stale => matches!(
