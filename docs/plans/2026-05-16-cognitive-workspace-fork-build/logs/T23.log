+fn lifecycle_refs(record: &MemoryRecord) -> Vec<StableRef> {
+    let mut refs = vec![StableRef::MemoryRef(record.memory_id.clone())];
+    refs.extend(
+        record
+            .linked_symbols
+            .iter()
+            .cloned()
+            .map(StableRef::SymbolRef),
+    );
+    refs.extend(
