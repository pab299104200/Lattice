+fn memory_params(record: &MemoryRecord) -> [Value; 36] {
+    [
+        Value::Text(encode_identity(&Identity::Memory(record.memory_id.clone()))),
+        Value::Text(record.content.clone()),
+        Value::Text(record.class.as_str().to_string()),
