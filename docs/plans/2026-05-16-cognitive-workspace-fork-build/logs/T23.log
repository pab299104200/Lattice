+fn validate_confidence(confidence: f64) -> Result<(), MemoryStoreError> {
+    if (0.0..=1.0).contains(&confidence) {
+        Ok(())
+    } else {
+        Err(MemoryStoreError::ConstraintViolation {
+            detail: format!("confidence `{confidence}` must be between 0 and 1"),
+        })
+    }
+}
