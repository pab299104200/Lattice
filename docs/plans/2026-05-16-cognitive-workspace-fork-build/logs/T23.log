+            linked_files_json = ?19,
+            linked_symbols_json = ?20,
+            linked_docs_json = ?21,
+            linked_tests_json = ?22,
+            linked_memories_json = ?23,
+            contradiction_links_json = ?24,
+            supersession_links_json = ?25,
+            access_history_json = ?26,
+            last_verified_event_id = ?27,
