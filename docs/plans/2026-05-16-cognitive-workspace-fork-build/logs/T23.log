+    evidence: Option<MemoryEvidence>,
+) -> Result<super::MemoryRecord, MemoryTransitionError> {
+    let prior = store.load_for_transition(&memory_id)?;
+    ensure_allowed(prior.verification_status, to)?;
+    let _span = info_span!(
+        "memory_store.transition",
