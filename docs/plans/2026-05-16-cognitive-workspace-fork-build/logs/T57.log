use super::WorkflowRenderChoice;
use lattice_core::intelligence::DiffImpactReport;
use serde_json::{json, Value};

/// Build a workflow-v2 diff-impact payload.
pub fn build_bundle(
    _graph: &lattice_core::graph::model::CodeGraph,
    report: &DiffImpactReport,
    render_choice: WorkflowRenderChoice,
) -> Value {
    let mut value = serde_json::to_value(report).unwrap_or_else(|_| json!({}));
    if let Some(object) = value.as_object_mut() {
        object.insert(
            "overview".to_string(),
            json!(format!(
                "Diff touches {} files and {} changed symbols.",
                report.changed_files.len(),
                report.changed_symbols.len()
            )),
        );
        object.insert(
            "render_choice".to_string(),
            json!(format!("{:?}", render_choice).to_lowercase()),
        );
    }
    value
}

