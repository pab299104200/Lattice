+++ b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/mod.rs
@@ -0,0 +1,282 @@
+//! Shared workflow-v2 bundle surface for Phase 8 workflow tools.
+//!
+//! This module follows the spec headings `## Phase 8: Workflow Engine V2`,
+//! `## MCP Surface`, and `## Non-Negotiable Product Properties`.
+
+pub mod context_capsule;
+pub mod docs_capsule;
+pub mod impact_from_diff;
+pub mod relevant_tests;
+
+#[cfg(test)]
+mod discovery_workflows_tests;
+
+use lattice_core::intelligence::ExpandContextSeed;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::collections::HashSet;
+
+/// Delivery shape requested by the caller.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum WorkflowRenderChoice {
+    /// Tightest bounded first pass.
+    Focused,
+    /// Compact default bundle.
+    Compact,
+    /// Larger operator-facing payload.
+    Full,
+    /// Full payload plus scoring diagnostics.
+    Diagnostic,
+}
+
+impl WorkflowRenderChoice {
+    /// Parse a render choice from MCP arguments.
+    pub fn from_mode_str(value: Option<&str>) -> Self {
+        match value.unwrap_or("compact") {
+            "focused" => Self::Focused,
+            "full" => Self::Full,
+            "diagnostic" => Self::Diagnostic,
+            _ => Self::Compact,
+        }
+    }
+
+    /// Maximum primary pivots to keep for this render mode.
+    pub fn pivot_limit(self) -> usize {
+        match self {
+            Self::Focused => 3,
+            Self::Compact => 8,
+            Self::Full | Self::Diagnostic => 12,
+        }
+    }
+
+    /// Maximum supporting context items to keep for this render mode.
+    pub fn context_limit(self) -> usize {
+        match self {
+            Self::Focused => 3,
+            Self::Compact => 6,
+            Self::Full | Self::Diagnostic => 10,
+        }
+    }
+
+    /// Maximum memories to keep for this render mode.
+    pub fn memory_limit(self) -> usize {
+        match self {
+            Self::Focused => 1,
+            Self::Compact => 3,
+            Self::Full | Self::Diagnostic => 6,
+        }
+    }
+}
+
+/// One ranked anchor or context item inside a workflow bundle.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Pivot {
+    /// Stable category of this item such as `code`, `doc_primary`, `code_referenced`, or `test`.
+    pub pivot_type: String,
+    /// Short operator-facing title.
+    pub title: String,
+    /// Repo-relative file path when known.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub file: Option<String>,
+    /// Symbol or section name when known.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub symbol: Option<String>,
+    /// 1-based line number when known.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub line: Option<usize>,
+    /// Short summary used in compact mode.
+    pub summary: String,
+    /// Why this item was included.
+    pub inclusion_reason: String,
+    /// Stable expansion focus to use with `expand_context`.
+    pub expansion_focus: String,
+    /// Relative score for ranking and diagnostics.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub score: Option<f64>,
+    /// Verification status if this item is backed by verified memory or evidence.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub verification_status: Option<String>,
+    /// Optional verification command associated with this item.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub verification_command: Option<String>,
+    /// Provenance snippets describing how the item was ranked.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub provenance: Vec<String>,
+}
+
+/// Memory evidence surfaced in a workflow bundle.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct MemoryHighlight {
+    /// Short memory content excerpt.
+    pub content: String,
+    /// Memory type such as `observation` or `decision`.
+    pub memory_type: String,
+    /// Durability scope such as `session`, `branch`, or `repo`.
+    pub scope: String,
+    /// Why the memory was included.
+    pub inclusion_reason: String,
+    /// Whether the memory must be treated as stale or contradicted.
+    pub stale_label: bool,
+    /// Verification status from the verification engine.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub verification_status: Option<String>,
+}
+
+/// Event-log evidence surfaced alongside graph and memory results.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct EventEpisode {
+    /// Stable category such as `tool_call`, `workflow_failed`, or `test_run`.
+    pub episode_type: String,
+    /// Short summary for the event episode.
+    pub summary: String,
+    /// Why the episode matters to the current bundle.
+    pub inclusion_reason: String,
+}
+
+/// Explicit uncertainty or failure information in the workflow bundle.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct RiskNote {
+    /// Severity label such as `info`, `warning`, or `high`.
+    pub level: String,
+    /// Short title.
+    pub summary: String,
+    /// More specific detail about the risk.
+    pub detail: String,
+}
+
+/// Suggested next focus to expand without broad re-querying.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ExpansionHint {
+    /// Focus token accepted by `expand_context`.
+    pub focus: String,
+    /// Why the focus is the best next delta.
+    pub reason: String,
+}
+
+/// Shared Phase 8 workflow bundle.
+///
+/// Self-documenting spec field list: overview, ranked pivots, relevant context,
+/// memory highlights, event episodes, suggested next expansion, stable handles,
+/// risks, render choice, structured payload.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct WorkflowBundle {
+    /// Tool name that produced the bundle.
+    pub tool: String,
+    /// Render mode used for this bundle.
+    pub render_choice: WorkflowRenderChoice,
+    /// Compact overview for the assistant.
+    pub overview: String,
+    /// Ranked primary pivots.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub pivots: Vec<Pivot>,
+    /// Additional supporting context kept compact by default.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub relevant_context: Vec<Pivot>,
+    /// Relevant memory evidence.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub memory_highlights: Vec<MemoryHighlight>,
+    /// Relevant event-log evidence.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub event_episodes: Vec<EventEpisode>,
+    /// Best next delta to expand.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub suggested_expansion: Option<ExpansionHint>,
+    /// Risks, contradictions, or gaps that affect trust.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub risks: Vec<RiskNote>,
+    /// Verification commands inferred from the surfaced evidence.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub verification_commands: Vec<String>,
+    /// Raw structured payload for clients that need the underlying detail.
+    pub structured_payload: Value,
+    /// Optional diagnostic notes used in diagnostic mode.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub diagnostics: Vec<String>,
+}
+
+/// Convert a workflow bundle into an `expand_context` seed.
+pub fn build_expand_seed(bundle: &WorkflowBundle) -> ExpandContextSeed {
+    let mut files = Vec::new();
+    let mut symbols = Vec::new();
+    let mut tests = Vec::new();
+    let mut memories = Vec::new();
+    for pivot in bundle.pivots.iter().chain(bundle.relevant_context.iter()) {
+        if let Some(file) = &pivot.file {
+            if pivot.pivot_type == "test" {
+                tests.push(file.clone());
+            } else {
+                files.push(file.clone());
+            }
+        }
+        if let Some(symbol) = &pivot.symbol {
+            symbols.push(symbol.clone());
+        }
+    }
+    for memory in &bundle.memory_highlights {
+        memories.push(serde_json::json!({
+            "content": memory.content,
+            "memory_type": memory.memory_type,
+            "scope": memory.scope,
+            "verification_status": memory.verification_status,
+            "is_stale": memory.stale_label,
+        }));
+    }
+    dedupe(&mut files);
+    dedupe(&mut symbols);
+    dedupe(&mut tests);
+    ExpandContextSeed {
+        query: Some(bundle.overview.clone()),
+        files,
+        symbols,
+        tests,
+        memories,
+    }
+}
+
+/// Infer a verification command from a test file path.
+pub fn infer_test_command(file: &str) -> String {
+    if file.ends_with(".rs") {
+        let stem = file
+            .rsplit('/')
+            .next()
+            .unwrap_or(file)
+            .trim_end_matches(".rs")
+            .replace('-', "_");
+        return format!("cargo test {stem}");
+    }
+    if file.ends_with(".py") {
+        return format!("pytest {file}");
+    }
+    if file.ends_with(".ts")
+        || file.ends_with(".tsx")
+        || file.ends_with(".js")
+        || file.ends_with(".jsx")
+    {
+        return format!("npm test -- {file}");
+    }
+    format!("test {file}")
+}
+
+/// Build a stable `expand_context` focus token for file/symbol pairs.
+pub fn expansion_focus(file: Option<&str>, symbol: Option<&str>) -> String {
+    match (file, symbol) {
+        (Some(file), Some(symbol)) => format!("symbol:{file}::{symbol}"),
+        (Some(file), None) => format!("file:{file}"),
+        (None, Some(symbol)) => format!("symbol:{symbol}"),
+        (None, None) => "file:".to_string(),
+    }
+}
+
+/// True when a verification status must be surfaced as stale.
+pub fn is_stale_status(status: Option<&str>) -> bool {
+    matches!(
+        status,
+        Some("stale" | "contradicted" | "superseded" | "expired" | "invalidated")
+    )
+}
+
+fn dedupe(values: &mut Vec<String>) {
+    let mut seen = HashSet::new();
+    values.retain(|value| seen.insert(value.clone()));
+}
