use super::WorkflowRenderChoice;
use lattice_core::intelligence::DocsCapsule;
use serde_json::{json, Value};

/// Build a workflow-v2 docs capsule payload.
pub fn build_bundle(report: &DocsCapsule, render_choice: WorkflowRenderChoice) -> Value {
    let mut value = serde_json::to_value(report).unwrap_or_else(|_| json!({}));
    if let Some(object) = value.as_object_mut() {
        object.insert(
            "overview".to_string(),
            json!(format!("Selected {} relevant documentation sections.", report.docs.len())),
        );
        object.insert(
            "render_choice".to_string(),
            json!(format!("{:?}", render_choice).to_lowercase()),
        );
    }
    value
}

