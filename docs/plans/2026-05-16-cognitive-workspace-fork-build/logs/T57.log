diff --git a/daemon/crates/lattice-daemon/src/rpc/workflow_v2/context_capsule.rs b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/context_capsule.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1dac7b5d328bf59ef7db6cb46030c68c5f4f103d
--- /dev/null
+++ b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/context_capsule.rs
@@ -0,0 +1,204 @@
+//! Workflow-v2 adapter for `get_context_capsule`.
+//!
+//! Bound to spec headings `## Phase 8: Workflow Engine V2`, `## MCP Surface`,
+//! and `## Non-Negotiable Product Properties`.
+
+use super::{
+    expansion_focus, infer_test_command, is_stale_status, ExpansionHint, MemoryHighlight, Pivot,
+    RiskNote, WorkflowBundle, WorkflowRenderChoice,
+};
+use lattice_core::graph::model::CodeGraph;
+use lattice_core::query::ContextCapsule;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+/// Request payload for workflow-v2 context capsules.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ContextCapsuleRequest {
+    /// Free-form task or understanding request.
+    pub query: String,
+    /// Requested render mode.
+    pub mode: WorkflowRenderChoice,
+}
+
+/// Convert the legacy query-engine capsule into the shared Phase 8 bundle.
+pub fn build_bundle(
+    graph: &CodeGraph,
+    capsule: &ContextCapsule,
+    mode: WorkflowRenderChoice,
+) -> WorkflowBundle {
+    let mut pivots = capsule
+        .pivots
+        .iter()
+        .map(|pivot| Pivot {
+            pivot_type: "code".to_string(),
+            title: pivot.symbol.clone(),
+            file: Some(pivot.file.clone()),
+            symbol: Some(pivot.symbol.clone()),
+            line: Some(pivot.line),
+            summary: compact_source(&pivot.source),
+            inclusion_reason: pivot.reason.clone(),
+            expansion_focus: expansion_focus(Some(&pivot.file), Some(&pivot.symbol)),
+            score: Some(pivot.score),
+            verification_status: None,
+            verification_command: related_test_command(graph, &pivot.file),
+            provenance: vec![format!("query-intent:{:?}", capsule.intent)],
+        })
+        .collect::<Vec<_>>();
+    pivots.truncate(mode.pivot_limit());
+
+    let mut relevant_context = capsule
+        .context
+        .iter()
+        .map(|context| Pivot {
+            pivot_type: "related_code".to_string(),
+            title: context.symbol.clone(),
+            file: Some(context.file.clone()),
+            symbol: Some(context.symbol.clone()),
+            line: Some(context.line),
+            summary: compact_source(&context.skeleton),
+            inclusion_reason: context.relationship.clone(),
+            expansion_focus: expansion_focus(Some(&context.file), Some(&context.symbol)),
+            score: Some(context.score),
+            verification_status: None,
+            verification_command: related_test_command(graph, &context.file),
+            provenance: Vec::new(),
+        })
+        .collect::<Vec<_>>();
+    relevant_context.truncate(mode.context_limit());
+
+    let mut memory_highlights = capsule
+        .memories
+        .iter()
+        .take(mode.memory_limit())
+        .filter_map(|value| memory_highlight(value, "retrieved by context query"))
+        .collect::<Vec<_>>();
+    if memory_highlights.is_empty() {
+        memory_highlights.push(MemoryHighlight {
+            content: "No relevant memory matched this query.".to_string(),
+            memory_type: "observation".to_string(),
+            scope: "session".to_string(),
+            inclusion_reason: "explicit empty rationale".to_string(),
+            stale_label: false,
+            verification_status: None,
+        });
+    }
+
+    let overview = format!(
+        "Context capsule for {:?} surfaced {} primary pivot(s) and {} supporting item(s).",
+        capsule.intent,
+        pivots.len(),
+        relevant_context.len()
+    );
+    let suggested_expansion = pivots.first().map(|pivot| ExpansionHint {
+        focus: pivot.expansion_focus.clone(),
+        reason: "Highest-ranked pivot carries the densest local code context.".to_string(),
+    });
+    let mut verification_commands = pivots
+        .iter()
+        .filter_map(|pivot| pivot.verification_command.clone())
+        .collect::<Vec<_>>();
+    verification_commands.dedup();
+
+    WorkflowBundle {
+        tool: "get_context_capsule".to_string(),
+        render_choice: mode,
+        overview,
+        pivots,
+        relevant_context,
+        memory_highlights,
+        event_episodes: Vec::new(),
+        suggested_expansion,
+        risks: capsule_risks(capsule),
+        verification_commands,
+        structured_payload: serde_json::to_value(capsule).unwrap_or(Value::Null),
+        diagnostics: diagnostics(capsule, mode),
+    }
+}
+
+fn capsule_risks(capsule: &ContextCapsule) -> Vec<RiskNote> {
+    let mut risks = Vec::new();
+    if capsule.pivots.is_empty() {
+        risks.push(RiskNote {
+            level: "warning".to_string(),
+            summary: "No primary pivots".to_string(),
+            detail: "The query engine did not find any high-confidence primary anchors."
+                .to_string(),
+        });
+    }
+    if capsule.memories.iter().any(|value| {
+        is_stale_status(
+            value.get("verification_status")
+                .and_then(|item| item.as_str()),
+        )
+    }) {
+        risks.push(RiskNote {
+            level: "warning".to_string(),
+            summary: "Stale memory included".to_string(),
+            detail: "At least one retrieved memory is stale or contradicted and must be treated cautiously."
+                .to_string(),
+        });
+    }
+    risks
+}
+
+fn diagnostics(capsule: &ContextCapsule, mode: WorkflowRenderChoice) -> Vec<String> {
+    if mode != WorkflowRenderChoice::Diagnostic {
+        return Vec::new();
+    }
+    vec![
+        format!("nodes_evaluated={}", capsule.stats.nodes_evaluated),
+        format!("nodes_included={}", capsule.stats.nodes_included),
+        format!("seed_count={}", capsule.stats.seed_count),
+    ]
+}
+
+fn memory_highlight(value: &Value, inclusion_reason: &str) -> Option<MemoryHighlight> {
+    let content = value.get("content")?.as_str()?.trim();
+    let verification_status = value
+        .get("verification_status")
+        .and_then(|item| item.as_str())
+        .map(str::to_string);
+    Some(MemoryHighlight {
+        content: truncate(content, 120),
+        memory_type: value
+            .get("type")
+            .or_else(|| value.get("memory_type"))
+            .and_then(|item| item.as_str())
+            .unwrap_or("observation")
+            .to_string(),
+        scope: value
+            .get("scope")
+            .and_then(|item| item.as_str())
+            .unwrap_or("session")
+            .to_string(),
+        inclusion_reason: inclusion_reason.to_string(),
+        stale_label: is_stale_status(verification_status.as_deref())
+            || value.get("is_stale").and_then(|item| item.as_bool()).unwrap_or(false),
+        verification_status,
+    })
+}
+
+fn related_test_command(graph: &CodeGraph, file: &str) -> Option<String> {
+    graph.all_nodes().into_iter().find_map(|node| {
+        if node.file == file {
+            return graph.get_dependents(&node.id).into_iter().find_map(|(dependent, _)| {
+                (dependent.file.contains("test") || dependent.file.contains("spec"))
+                    .then(|| infer_test_command(&dependent.file))
+            });
+        }
+        None
+    })
+}
+
+fn compact_source(source: &str) -> String {
+    let trimmed = source.trim().replace('\n', " ");
+    truncate(&trimmed, 140)
+}
+
+fn truncate(value: &str, limit: usize) -> String {
+    if value.chars().count() <= limit {
+        return value.to_string();
+    }
+    value.chars().take(limit.saturating_sub(1)).collect::<String>() + "…"
+}
diff --git a/daemon/crates/lattice-daemon/src/rpc/workflow_v2/discovery_workflows_tests.rs b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/discovery_workflows_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..734a48885ed3df2c3e88bb53d8f451144332ef32
--- /dev/null
+++ b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/discovery_workflows_tests.rs
@@ -0,0 +1,271 @@
+use super::context_capsule::{build_bundle as build_context_bundle, ContextCapsuleRequest};
+use super::docs_capsule::{build_bundle as build_docs_bundle, DocsCapsuleRequest};
+use super::impact_from_diff::{build_bundle as build_impact_bundle, ImpactFromDiffRequest};
+use super::relevant_tests::{build_bundle as build_tests_bundle, RelevantTestsRequest};
+use super::{build_expand_seed, WorkflowBundle, WorkflowRenderChoice};
+use crate::rpc::context_cache::ContextHandleCache;
+use lattice_core::graph::model::{CodeGraph, EdgeKind};
+use lattice_core::intelligence::{
+    expand_context, find_relevant_tests, get_docs_capsule, impact_from_diff, BundleMode,
+    RulesDetector,
+};
+use lattice_core::query::{CapsuleStats, ContextCapsule, ContextNode, PivotNode, QueryIntent};
+use lattice_core::symbols::{Language, SymbolId, SymbolKind};
+use serde_json::json;
+use std::time::Duration;
+
+fn make_id(file: &str, name: &str, offset: usize) -> SymbolId {
+    SymbolId {
+        file: file.to_string(),
+        name: name.to_string(),
+        byte_offset: offset,
+    }
+}
+
+fn build_graph() -> CodeGraph {
+    let mut graph = CodeGraph::new();
+    let login_id = make_id("src/auth.ts", "loginUser", 0);
+    let session_id = make_id("src/session.ts", "createSession", 1);
+    let route_id = make_id("src/routes/auth.ts", "loginRoute", 2);
+    let test_id = make_id("tests/auth.test.ts", "loginUserTest", 3);
+    let doc_id = make_id("docs/auth.md", "Login Flow", 4);
+
+    graph.add_node(
+        login_id.clone(),
+        SymbolKind::Function,
+        "loginUser".to_string(),
+        "fn loginUser()".to_string(),
+        "function loginUser() { return createSession(); }".to_string(),
+        "src/auth.ts".to_string(),
+        10,
+        20,
+        true,
+        Language::TypeScript,
+    );
+    graph.add_node(
+        session_id.clone(),
+        SymbolKind::Function,
+        "createSession".to_string(),
+        "fn createSession()".to_string(),
+        "function createSession() { return {}; }".to_string(),
+        "src/session.ts".to_string(),
+        5,
+        12,
+        true,
+        Language::TypeScript,
+    );
+    graph.add_node(
+        route_id.clone(),
+        SymbolKind::Function,
+        "loginRoute".to_string(),
+        "fn loginRoute()".to_string(),
+        "function loginRoute() { return loginUser(); }".to_string(),
+        "src/routes/auth.ts".to_string(),
+        3,
+        9,
+        true,
+        Language::TypeScript,
+    );
+    graph.add_node(
+        test_id.clone(),
+        SymbolKind::Function,
+        "loginUserTest".to_string(),
+        "test loginUser".to_string(),
+        "test('login', () => loginRoute());".to_string(),
+        "tests/auth.test.ts".to_string(),
+        4,
+        8,
+        false,
+        Language::TypeScript,
+    );
+    graph.add_node(
+        doc_id.clone(),
+        SymbolKind::Module,
+        "Login Flow".to_string(),
+        "# Login Flow".to_string(),
+        "Login Flow references loginUser and loginRoute.".to_string(),
+        "docs/auth.md".to_string(),
+        1,
+        6,
+        true,
+        Language::Markdown,
+    );
+
+    graph.add_edge(&login_id, &session_id, EdgeKind::Calls);
+    graph.add_edge(&route_id, &login_id, EdgeKind::Calls);
+    graph.add_edge(&test_id, &route_id, EdgeKind::Calls);
+    graph.add_edge(&doc_id, &login_id, EdgeKind::Mentions);
+    graph.add_edge(&doc_id, &route_id, EdgeKind::Mentions);
+    graph
+}
+
+fn build_capsule() -> ContextCapsule {
+    ContextCapsule {
+        query: "trace login".to_string(),
+        intent: QueryIntent::Explore,
+        pivots: vec![PivotNode {
+            symbol: "loginUser".to_string(),
+            kind: "fn".to_string(),
+            file: "src/auth.ts".to_string(),
+            line: 10,
+            source: "function loginUser() { return createSession(); }".to_string(),
+            score: 0.92,
+            reason: "query matched login flow".to_string(),
+        }],
+        context: vec![ContextNode {
+            symbol: "loginRoute".to_string(),
+            kind: "fn".to_string(),
+            file: "src/routes/auth.ts".to_string(),
+            line: 3,
+            skeleton: "function loginRoute(): Response".to_string(),
+            relationship: "caller".to_string(),
+            score: 0.73,
+        }],
+        memories: vec![json!({
+            "content": "Previous login regressions were caused by session creation.",
+            "memory_type": "observation",
+            "scope": "repo",
+            "verification_status": "stale"
+        })],
+        stats: CapsuleStats {
+            tokens_used: 10,
+            tokens_saved: 20,
+            nodes_evaluated: 4,
+            nodes_included: 2,
+            engine_version: "test".to_string(),
+            seed_count: 1,
+            seed_symbols: vec!["loginUser".to_string()],
+        },
+    }
+}
+
+#[test]
+fn context_capsule_bundle_round_trips_and_expands() {
+    let graph = build_graph();
+    let request = ContextCapsuleRequest {
+        query: "trace login".to_string(),
+        mode: WorkflowRenderChoice::Compact,
+    };
+    let request_json = serde_json::to_string(&request).expect("serialize request");
+    let _: ContextCapsuleRequest = serde_json::from_str(&request_json).expect("deserialize request");
+
+    let bundle = build_context_bundle(&graph, &build_capsule(), request.mode);
+    round_trip_bundle(&bundle);
+    assert_eq!(bundle.render_choice, WorkflowRenderChoice::Compact);
+    assert!(bundle.pivots.len() <= 8);
+    assert!(
+        bundle.memory_highlights.iter().all(|memory| {
+            memory.verification_status.as_deref() != Some("stale") || memory.stale_label
+        }),
+        "stale memory must carry stale_label"
+    );
+
+    let seed = build_expand_seed(&bundle);
+    let mut cache = ContextHandleCache::new_with_limits(4, Duration::from_secs(60));
+    let handle = cache.insert("get_context_capsule", seed, "workspace", "session");
+    let cached = cache
+        .get(&handle.legacy_handle)
+        .expect("expected cached handle");
+    let expanded = expand_context(&graph, &cached.seed, &bundle.pivots[0].expansion_focus, 800);
+    assert!(!expanded.symbols.is_empty() || !expanded.files.is_empty());
+}
+
+#[test]
+fn docs_capsule_bundle_round_trips() {
+    let graph = build_graph();
+    let request = DocsCapsuleRequest {
+        query: "login".to_string(),
+        files: vec!["src/auth.ts".to_string()],
+        symbols: vec!["loginUser".to_string()],
+        mode: WorkflowRenderChoice::Compact,
+        limit: 6,
+    };
+    let report = get_docs_capsule(&graph, &request.query, &request.files, &request.symbols, 6);
+    let bundle = build_docs_bundle(&report, request.mode);
+    round_trip_bundle(&bundle);
+    assert_eq!(bundle.render_choice, WorkflowRenderChoice::Compact);
+    assert!(bundle.pivots.iter().any(|pivot| pivot.pivot_type == "doc_primary"));
+    assert!(
+        bundle
+            .relevant_context
+            .iter()
+            .any(|pivot| pivot.pivot_type == "code_referenced")
+    );
+}
+
+#[test]
+fn relevant_tests_bundle_recovers_golden_test() {
+    let graph = build_graph();
+    let rules = RulesDetector::new().detect_rules(&[
+        "src/auth.ts".to_string(),
+        "src/session.ts".to_string(),
+        "src/routes/auth.ts".to_string(),
+        "tests/auth.test.ts".to_string(),
+    ]);
+    let request = RelevantTestsRequest {
+        files: vec!["src/auth.ts".to_string()],
+        symbols: vec!["loginUser".to_string()],
+        diff: None,
+        mode: WorkflowRenderChoice::Compact,
+        limit: 8,
+    };
+    let report = find_relevant_tests(
+        &graph,
+        &request.files,
+        &request.symbols,
+        None,
+        &rules,
+        request.limit,
+    );
+    let bundle = build_tests_bundle(&report, request.mode);
+    round_trip_bundle(&bundle);
+    assert!(bundle.pivots.iter().any(|pivot| {
+        pivot.file.as_deref() == Some("tests/auth.test.ts")
+            && pivot.verification_command.as_deref() == Some("npm test -- tests/auth.test.ts")
+    }));
+    assert!(bundle.pivots.iter().all(|pivot| !pivot.provenance.is_empty()));
+}
+
+#[test]
+fn impact_bundle_enforces_bounded_traversal_and_attaches_docs() {
+    let graph = build_graph();
+    let rules = RulesDetector::new().detect_rules(&[
+        "src/auth.ts".to_string(),
+        "src/session.ts".to_string(),
+        "src/routes/auth.ts".to_string(),
+        "tests/auth.test.ts".to_string(),
+        "docs/auth.md".to_string(),
+    ]);
+    let request = ImpactFromDiffRequest {
+        diff: Some("diff --git a/src/auth.ts b/src/auth.ts\n--- a/src/auth.ts\n+++ b/src/auth.ts\n@@ -10,1 +10,1 @@\n-old\n+new\n".to_string()),
+        files: Vec::new(),
+        symbols: Vec::new(),
+        mode: WorkflowRenderChoice::Compact,
+        hops: 1,
+    };
+    let report = impact_from_diff(
+        &graph,
+        request.diff.as_deref().expect("diff"),
+        &request.files,
+        &request.symbols,
+        &rules,
+        BundleMode::Compact,
+        request.hops,
+    );
+    let bundle = build_impact_bundle(&graph, &report, request.mode);
+    round_trip_bundle(&bundle);
+    assert!(report.affected_symbols.len() <= 1);
+    assert!(
+        bundle
+            .relevant_context
+            .iter()
+            .any(|pivot| pivot.pivot_type == "affected_doc")
+    );
+}
+
+fn round_trip_bundle(bundle: &WorkflowBundle) {
+    let serialized = serde_json::to_string(bundle).expect("serialize bundle");
+    let restored: WorkflowBundle =
+        serde_json::from_str(&serialized).expect("deserialize bundle");
+    assert_eq!(restored.tool, bundle.tool);
+}
