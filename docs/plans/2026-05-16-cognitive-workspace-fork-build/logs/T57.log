diff --git a/daemon/crates/lattice-daemon/src/rpc/workflow_v2/context_capsule.rs b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/context_capsule.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1dac7b5d328bf59ef7db6cb46030c68c5f4f103d
--- /dev/null
+++ b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/context_capsule.rs
@@ -0,0 +1,204 @@
+//! Workflow-v2 adapter for `get_context_capsule`.
+//!
+//! Bound to spec headings `## Phase 8: Workflow Engine V2`, `## MCP Surface`,
+//! and `## Non-Negotiable Product Properties`.
+
+use super::{
+    expansion_focus, infer_test_command, is_stale_status, ExpansionHint, MemoryHighlight, Pivot,
+    RiskNote, WorkflowBundle, WorkflowRenderChoice,
+};
+use lattice_core::graph::model::CodeGraph;
+use lattice_core::query::ContextCapsule;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+/// Request payload for workflow-v2 context capsules.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ContextCapsuleRequest {
+    /// Free-form task or understanding request.
+    pub query: String,
+    /// Requested render mode.
+    pub mode: WorkflowRenderChoice,
+}
+
+/// Convert the legacy query-engine capsule into the shared Phase 8 bundle.
+pub fn build_bundle(
+    graph: &CodeGraph,
+    capsule: &ContextCapsule,
+    mode: WorkflowRenderChoice,
+) -> WorkflowBundle {
+    let mut pivots = capsule
+        .pivots
+        .iter()
+        .map(|pivot| Pivot {
+            pivot_type: "code".to_string(),
+            title: pivot.symbol.clone(),
+            file: Some(pivot.file.clone()),
+            symbol: Some(pivot.symbol.clone()),
+            line: Some(pivot.line),
+            summary: compact_source(&pivot.source),
+            inclusion_reason: pivot.reason.clone(),
+            expansion_focus: expansion_focus(Some(&pivot.file), Some(&pivot.symbol)),
+            score: Some(pivot.score),
+            verification_status: None,
+            verification_command: related_test_command(graph, &pivot.file),
+            provenance: vec![format!("query-intent:{:?}", capsule.intent)],
+        })
+        .collect::<Vec<_>>();
+    pivots.truncate(mode.pivot_limit());
+
+    let mut relevant_context = capsule
+        .context
+        .iter()
+        .map(|context| Pivot {
+            pivot_type: "related_code".to_string(),
+            title: context.symbol.clone(),
+            file: Some(context.file.clone()),
+            symbol: Some(context.symbol.clone()),
+            line: Some(context.line),
+            summary: compact_source(&context.skeleton),
+            inclusion_reason: context.relationship.clone(),
+            expansion_focus: expansion_focus(Some(&context.file), Some(&context.symbol)),
+            score: Some(context.score),
+            verification_status: None,
+            verification_command: related_test_command(graph, &context.file),
+            provenance: Vec::new(),
+        })
+        .collect::<Vec<_>>();
+    relevant_context.truncate(mode.context_limit());
+
+    let mut memory_highlights = capsule
+        .memories
+        .iter()
+        .take(mode.memory_limit())
+        .filter_map(|value| memory_highlight(value, "retrieved by context query"))
+        .collect::<Vec<_>>();
+    if memory_highlights.is_empty() {
+        memory_highlights.push(MemoryHighlight {
+            content: "No relevant memory matched this query.".to_string(),
+            memory_type: "observation".to_string(),
+            scope: "session".to_string(),
+            inclusion_reason: "explicit empty rationale".to_string(),
+            stale_label: false,
+            verification_status: None,
+        });
+    }
+
+    let overview = format!(
+        "Context capsule for {:?} surfaced {} primary pivot(s) and {} supporting item(s).",
+        capsule.intent,
+        pivots.len(),
+        relevant_context.len()
+    );
+    let suggested_expansion = pivots.first().map(|pivot| ExpansionHint {
+        focus: pivot.expansion_focus.clone(),
+        reason: "Highest-ranked pivot carries the densest local code context.".to_string(),
+    });
+    let mut verification_commands = pivots
+        .iter()
+        .filter_map(|pivot| pivot.verification_command.clone())
+        .collect::<Vec<_>>();
+    verification_commands.dedup();
+
+    WorkflowBundle {
+        tool: "get_context_capsule".to_string(),
+        render_choice: mode,
+        overview,
+        pivots,
+        relevant_context,
+        memory_highlights,
+        event_episodes: Vec::new(),
+        suggested_expansion,
+        risks: capsule_risks(capsule),
+        verification_commands,
+        structured_payload: serde_json::to_value(capsule).unwrap_or(Value::Null),
+        diagnostics: diagnostics(capsule, mode),
+    }
+}
+
+fn capsule_risks(capsule: &ContextCapsule) -> Vec<RiskNote> {
+    let mut risks = Vec::new();
+    if capsule.pivots.is_empty() {
+        risks.push(RiskNote {
+            level: "warning".to_string(),
+            summary: "No primary pivots".to_string(),
+            detail: "The query engine did not find any high-confidence primary anchors."
+                .to_string(),
+        });
+    }
+    if capsule.memories.iter().any(|value| {
+        is_stale_status(
+            value.get("verification_status")
+                .and_then(|item| item.as_str()),
+        )
+    }) {
+        risks.push(RiskNote {
+            level: "warning".to_string(),
+            summary: "Stale memory included".to_string(),
+            detail: "At least one retrieved memory is stale or contradicted and must be treated cautiously."
+                .to_string(),
+        });
+    }
+    risks
+}
+
+fn diagnostics(capsule: &ContextCapsule, mode: WorkflowRenderChoice) -> Vec<String> {
+    if mode != WorkflowRenderChoice::Diagnostic {
+        return Vec::new();
+    }
+    vec![
+        format!("nodes_evaluated={}", capsule.stats.nodes_evaluated),
+        format!("nodes_included={}", capsule.stats.nodes_included),
+        format!("seed_count={}", capsule.stats.seed_count),
+    ]
+}
+
+fn memory_highlight(value: &Value, inclusion_reason: &str) -> Option<MemoryHighlight> {
+    let content = value.get("content")?.as_str()?.trim();
+    let verification_status = value
+        .get("verification_status")
+        .and_then(|item| item.as_str())
+        .map(str::to_string);
+    Some(MemoryHighlight {
+        content: truncate(content, 120),
+        memory_type: value
+            .get("type")
+            .or_else(|| value.get("memory_type"))
+            .and_then(|item| item.as_str())
+            .unwrap_or("observation")
+            .to_string(),
+        scope: value
+            .get("scope")
+            .and_then(|item| item.as_str())
+            .unwrap_or("session")
+            .to_string(),
+        inclusion_reason: inclusion_reason.to_string(),
+        stale_label: is_stale_status(verification_status.as_deref())
+            || value.get("is_stale").and_then(|item| item.as_bool()).unwrap_or(false),
+        verification_status,
+    })
+}
+
+fn related_test_command(graph: &CodeGraph, file: &str) -> Option<String> {
+    graph.all_nodes().into_iter().find_map(|node| {
+        if node.file == file {
+            return graph.get_dependents(&node.id).into_iter().find_map(|(dependent, _)| {
+                (dependent.file.contains("test") || dependent.file.contains("spec"))
+                    .then(|| infer_test_command(&dependent.file))
+            });
+        }
+        None
+    })
+}
+
+fn compact_source(source: &str) -> String {
+    let trimmed = source.trim().replace('\n', " ");
+    truncate(&trimmed, 140)
+}
+
+fn truncate(value: &str, limit: usize) -> String {
+    if value.chars().count() <= limit {
+        return value.to_string();
+    }
+    value.chars().take(limit.saturating_sub(1)).collect::<String>() + "…"
+}
diff --git a/daemon/crates/lattice-daemon/src/rpc/workflow_v2/discovery_workflows_tests.rs b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/discovery_workflows_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..734a48885ed3df2c3e88bb53d8f451144332ef32
--- /dev/null
+++ b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/discovery_workflows_tests.rs
@@ -0,0 +1,271 @@
+use super::context_capsule::{build_bundle as build_context_bundle, ContextCapsuleRequest};
+use super::docs_capsule::{build_bundle as build_docs_bundle, DocsCapsuleRequest};
+use super::impact_from_diff::{build_bundle as build_impact_bundle, ImpactFromDiffRequest};
+use super::relevant_tests::{build_bundle as build_tests_bundle, RelevantTestsRequest};
+use super::{build_expand_seed, WorkflowBundle, WorkflowRenderChoice};
+use crate::rpc::context_cache::ContextHandleCache;
+use lattice_core::graph::model::{CodeGraph, EdgeKind};
+use lattice_core::intelligence::{
+    expand_context, find_relevant_tests, get_docs_capsule, impact_from_diff, BundleMode,
+    RulesDetector,
+};
+use lattice_core::query::{CapsuleStats, ContextCapsule, ContextNode, PivotNode, QueryIntent};
+use lattice_core::symbols::{Language, SymbolId, SymbolKind};
+use serde_json::json;
+use std::time::Duration;
+
+fn make_id(file: &str, name: &str, offset: usize) -> SymbolId {
+    SymbolId {
+        file: file.to_string(),
+        name: name.to_string(),
+        byte_offset: offset,
+    }
+}
+
+fn build_graph() -> CodeGraph {
+    let mut graph = CodeGraph::new();
+    let login_id = make_id("src/auth.ts", "loginUser", 0);
+    let session_id = make_id("src/session.ts", "createSession", 1);
+    let route_id = make_id("src/routes/auth.ts", "loginRoute", 2);
+    let test_id = make_id("tests/auth.test.ts", "loginUserTest", 3);
+    let doc_id = make_id("docs/auth.md", "Login Flow", 4);
+
+    graph.add_node(
+        login_id.clone(),
+        SymbolKind::Function,
+        "loginUser".to_string(),
+        "fn loginUser()".to_string(),
+        "function loginUser() { return createSession(); }".to_string(),
+        "src/auth.ts".to_string(),
+        10,
+        20,
+        true,
+        Language::TypeScript,
+    );
+    graph.add_node(
+        session_id.clone(),
+        SymbolKind::Function,
+        "createSession".to_string(),
+        "fn createSession()".to_string(),
+        "function createSession() { return {}; }".to_string(),
+        "src/session.ts".to_string(),
+        5,
+        12,
+        true,
+        Language::TypeScript,
+    );
+    graph.add_node(
+        route_id.clone(),
+        SymbolKind::Function,
+        "loginRoute".to_string(),
+        "fn loginRoute()".to_string(),
+        "function loginRoute() { return loginUser(); }".to_string(),
+        "src/routes/auth.ts".to_string(),
+        3,
+        9,
+        true,
+        Language::TypeScript,
+    );
+    graph.add_node(
+        test_id.clone(),
+        SymbolKind::Function,
+        "loginUserTest".to_string(),
+        "test loginUser".to_string(),
+        "test('login', () => loginRoute());".to_string(),
+        "tests/auth.test.ts".to_string(),
+        4,
+        8,
+        false,
+        Language::TypeScript,
+    );
+    graph.add_node(
+        doc_id.clone(),
+        SymbolKind::Module,
+        "Login Flow".to_string(),
+        "# Login Flow".to_string(),
+        "Login Flow references loginUser and loginRoute.".to_string(),
+        "docs/auth.md".to_string(),
+        1,
+        6,
+        true,
+        Language::Markdown,
+    );
+
+    graph.add_edge(&login_id, &session_id, EdgeKind::Calls);
+    graph.add_edge(&route_id, &login_id, EdgeKind::Calls);
+    graph.add_edge(&test_id, &route_id, EdgeKind::Calls);
+    graph.add_edge(&doc_id, &login_id, EdgeKind::Mentions);
+    graph.add_edge(&doc_id, &route_id, EdgeKind::Mentions);
+    graph
+}
+
+fn build_capsule() -> ContextCapsule {
+    ContextCapsule {
+        query: "trace login".to_string(),
+        intent: QueryIntent::Explore,
+        pivots: vec![PivotNode {
+            symbol: "loginUser".to_string(),
+            kind: "fn".to_string(),
+            file: "src/auth.ts".to_string(),
+            line: 10,
+            source: "function loginUser() { return createSession(); }".to_string(),
+            score: 0.92,
+            reason: "query matched login flow".to_string(),
+        }],
+        context: vec![ContextNode {
+            symbol: "loginRoute".to_string(),
+            kind: "fn".to_string(),
+            file: "src/routes/auth.ts".to_string(),
+            line: 3,
+            skeleton: "function loginRoute(): Response".to_string(),
+            relationship: "caller".to_string(),
+            score: 0.73,
+        }],
+        memories: vec![json!({
+            "content": "Previous login regressions were caused by session creation.",
+            "memory_type": "observation",
+            "scope": "repo",
+            "verification_status": "stale"
+        })],
+        stats: CapsuleStats {
+            tokens_used: 10,
+            tokens_saved: 20,
+            nodes_evaluated: 4,
+            nodes_included: 2,
+            engine_version: "test".to_string(),
+            seed_count: 1,
+            seed_symbols: vec!["loginUser".to_string()],
+        },
+    }
+}
+
+#[test]
+fn context_capsule_bundle_round_trips_and_expands() {
+    let graph = build_graph();
+    let request = ContextCapsuleRequest {
+        query: "trace login".to_string(),
+        mode: WorkflowRenderChoice::Compact,
+    };
+    let request_json = serde_json::to_string(&request).expect("serialize request");
+    let _: ContextCapsuleRequest = serde_json::from_str(&request_json).expect("deserialize request");
+
+    let bundle = build_context_bundle(&graph, &build_capsule(), request.mode);
+    round_trip_bundle(&bundle);
+    assert_eq!(bundle.render_choice, WorkflowRenderChoice::Compact);
+    assert!(bundle.pivots.len() <= 8);
+    assert!(
+        bundle.memory_highlights.iter().all(|memory| {
+            memory.verification_status.as_deref() != Some("stale") || memory.stale_label
+        }),
+        "stale memory must carry stale_label"
+    );
+
+    let seed = build_expand_seed(&bundle);
+    let mut cache = ContextHandleCache::new_with_limits(4, Duration::from_secs(60));
+    let handle = cache.insert("get_context_capsule", seed, "workspace", "session");
+    let cached = cache
+        .get(&handle.legacy_handle)
+        .expect("expected cached handle");
+    let expanded = expand_context(&graph, &cached.seed, &bundle.pivots[0].expansion_focus, 800);
+    assert!(!expanded.symbols.is_empty() || !expanded.files.is_empty());
+}
+
+#[test]
+fn docs_capsule_bundle_round_trips() {
+    let graph = build_graph();
+    let request = DocsCapsuleRequest {
+        query: "login".to_string(),
+        files: vec!["src/auth.ts".to_string()],
+        symbols: vec!["loginUser".to_string()],
+        mode: WorkflowRenderChoice::Compact,
+        limit: 6,
+    };
+    let report = get_docs_capsule(&graph, &request.query, &request.files, &request.symbols, 6);
+    let bundle = build_docs_bundle(&report, request.mode);
+    round_trip_bundle(&bundle);
+    assert_eq!(bundle.render_choice, WorkflowRenderChoice::Compact);
+    assert!(bundle.pivots.iter().any(|pivot| pivot.pivot_type == "doc_primary"));
+    assert!(
+        bundle
+            .relevant_context
+            .iter()
+            .any(|pivot| pivot.pivot_type == "code_referenced")
+    );
+}
+
+#[test]
+fn relevant_tests_bundle_recovers_golden_test() {
+    let graph = build_graph();
+    let rules = RulesDetector::new().detect_rules(&[
+        "src/auth.ts".to_string(),
+        "src/session.ts".to_string(),
+        "src/routes/auth.ts".to_string(),
+        "tests/auth.test.ts".to_string(),
+    ]);
+    let request = RelevantTestsRequest {
+        files: vec!["src/auth.ts".to_string()],
+        symbols: vec!["loginUser".to_string()],
+        diff: None,
+        mode: WorkflowRenderChoice::Compact,
+        limit: 8,
+    };
+    let report = find_relevant_tests(
+        &graph,
+        &request.files,
+        &request.symbols,
+        None,
+        &rules,
+        request.limit,
+    );
+    let bundle = build_tests_bundle(&report, request.mode);
+    round_trip_bundle(&bundle);
+    assert!(bundle.pivots.iter().any(|pivot| {
+        pivot.file.as_deref() == Some("tests/auth.test.ts")
+            && pivot.verification_command.as_deref() == Some("npm test -- tests/auth.test.ts")
+    }));
+    assert!(bundle.pivots.iter().all(|pivot| !pivot.provenance.is_empty()));
+}
+
+#[test]
+fn impact_bundle_enforces_bounded_traversal_and_attaches_docs() {
+    let graph = build_graph();
+    let rules = RulesDetector::new().detect_rules(&[
+        "src/auth.ts".to_string(),
+        "src/session.ts".to_string(),
+        "src/routes/auth.ts".to_string(),
+        "tests/auth.test.ts".to_string(),
+        "docs/auth.md".to_string(),
+    ]);
+    let request = ImpactFromDiffRequest {
+        diff: Some("diff --git a/src/auth.ts b/src/auth.ts\n--- a/src/auth.ts\n+++ b/src/auth.ts\n@@ -10,1 +10,1 @@\n-old\n+new\n".to_string()),
+        files: Vec::new(),
+        symbols: Vec::new(),
+        mode: WorkflowRenderChoice::Compact,
+        hops: 1,
+    };
+    let report = impact_from_diff(
+        &graph,
+        request.diff.as_deref().expect("diff"),
+        &request.files,
+        &request.symbols,
+        &rules,
+        BundleMode::Compact,
+        request.hops,
+    );
+    let bundle = build_impact_bundle(&graph, &report, request.mode);
+    round_trip_bundle(&bundle);
+    assert!(report.affected_symbols.len() <= 1);
+    assert!(
+        bundle
+            .relevant_context
+            .iter()
+            .any(|pivot| pivot.pivot_type == "affected_doc")
+    );
+}
+
+fn round_trip_bundle(bundle: &WorkflowBundle) {
+    let serialized = serde_json::to_string(bundle).expect("serialize bundle");
+    let restored: WorkflowBundle =
+        serde_json::from_str(&serialized).expect("deserialize bundle");
+    assert_eq!(restored.tool, bundle.tool);
+}
diff --git a/daemon/crates/lattice-daemon/src/rpc/workflow_v2/docs_capsule.rs b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/docs_capsule.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b126501a914982df8c47c864ec0336773889a361
--- /dev/null
+++ b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/docs_capsule.rs
@@ -0,0 +1,122 @@
+//! Workflow-v2 adapter for `get_docs_capsule`.
+//!
+//! Bound to spec headings `## Phase 8: Workflow Engine V2`, `## MCP Surface`,
+//! and `## Non-Negotiable Product Properties`.
+
+use super::{expansion_focus, ExpansionHint, Pivot, RiskNote, WorkflowBundle, WorkflowRenderChoice};
+use lattice_core::intelligence::DocsCapsule;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+/// Request payload for workflow-v2 docs capsules.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct DocsCapsuleRequest {
+    /// Natural-language docs query.
+    pub query: String,
+    /// File anchors used to bias retrieval.
+    #[serde(default)]
+    pub files: Vec<String>,
+    /// Symbol anchors used to bias retrieval.
+    #[serde(default)]
+    pub symbols: Vec<String>,
+    /// Requested render mode.
+    pub mode: WorkflowRenderChoice,
+    /// Maximum primary doc pivots to keep.
+    pub limit: usize,
+}
+
+/// Convert the docs capsule into the shared Phase 8 bundle.
+pub fn build_bundle(report: &DocsCapsule, mode: WorkflowRenderChoice) -> WorkflowBundle {
+    let mut pivots = report
+        .docs
+        .iter()
+        .map(|doc| Pivot {
+            pivot_type: "doc_primary".to_string(),
+            title: doc.symbol.clone(),
+            file: Some(doc.file.clone()),
+            symbol: Some(doc.symbol.clone()),
+            line: Some(doc.line),
+            summary: doc.summary.clone(),
+            inclusion_reason: doc.reasons.first().cloned().unwrap_or_else(|| {
+                "Matched the docs query and graph-adjacent documentation edges.".to_string()
+            }),
+            expansion_focus: expansion_focus(Some(&doc.file), Some(&doc.symbol)),
+            score: Some(doc.score),
+            verification_status: None,
+            verification_command: None,
+            provenance: doc.reasons.clone(),
+        })
+        .collect::<Vec<_>>();
+    pivots.truncate(mode.pivot_limit());
+
+    let mut relevant_context = report
+        .related_symbols
+        .iter()
+        .map(|symbol| Pivot {
+            pivot_type: "code_referenced".to_string(),
+            title: symbol.symbol.clone(),
+            file: Some(symbol.file.clone()),
+            symbol: Some(symbol.symbol.clone()),
+            line: Some(symbol.line),
+            summary: format!(
+                "Mentioned from {} doc section(s).",
+                symbol.mention_count
+            ),
+            inclusion_reason: format!(
+                "Authoritative docs reference this code symbol from {} section(s).",
+                symbol.mention_count
+            ),
+            expansion_focus: expansion_focus(Some(&symbol.file), Some(&symbol.symbol)),
+            score: Some(symbol.mention_count as f64),
+            verification_status: None,
+            verification_command: None,
+            provenance: symbol.mentioned_from.clone(),
+        })
+        .collect::<Vec<_>>();
+    relevant_context.truncate(mode.context_limit());
+
+    WorkflowBundle {
+        tool: "get_docs_capsule".to_string(),
+        render_choice: mode,
+        overview: format!(
+            "Docs capsule returned {} authoritative doc pivot(s) and {} code reference(s).",
+            pivots.len(),
+            relevant_context.len()
+        ),
+        pivots,
+        relevant_context,
+        memory_highlights: Vec::new(),
+        event_episodes: Vec::new(),
+        suggested_expansion: report.docs.first().map(|doc| ExpansionHint {
+            focus: expansion_focus(Some(&doc.file), Some(&doc.symbol)),
+            reason: "Top-ranked doc section is the best authoritative text to expand next."
+                .to_string(),
+        }),
+        risks: docs_risks(report),
+        verification_commands: Vec::new(),
+        structured_payload: serde_json::to_value(report).unwrap_or(Value::Null),
+        diagnostics: if mode == WorkflowRenderChoice::Diagnostic {
+            vec![
+                format!("doc_candidates={}", report.stats.doc_candidates),
+                format!("docs_returned={}", report.stats.docs_returned),
+                format!(
+                    "related_symbols_returned={}",
+                    report.stats.related_symbols_returned
+                ),
+            ]
+        } else {
+            Vec::new()
+        },
+    }
+}
+
+fn docs_risks(report: &DocsCapsule) -> Vec<RiskNote> {
+    if report.docs.is_empty() {
+        return vec![RiskNote {
+            level: "warning".to_string(),
+            summary: "No matching documentation".to_string(),
+            detail: "No doc sections matched the supplied query and anchors.".to_string(),
+        }];
+    }
+    Vec::new()
+}
diff --git a/daemon/crates/lattice-daemon/src/rpc/workflow_v2/impact_from_diff.rs b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/impact_from_diff.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f0f3e2677d32bf912609acc38fd9418c6024143f
--- /dev/null
+++ b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/impact_from_diff.rs
@@ -0,0 +1,203 @@
+//! Workflow-v2 adapter for `impact_from_diff`.
+//!
+//! Bound to spec headings `## Phase 8: Workflow Engine V2`, `## MCP Surface`,
+//! and `## Non-Negotiable Product Properties`.
+
+use super::{
+    expansion_focus, infer_test_command, ExpansionHint, Pivot, RiskNote, WorkflowBundle,
+    WorkflowRenderChoice,
+};
+use lattice_core::graph::model::CodeGraph;
+use lattice_core::intelligence::DiffImpactReport;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+/// Request payload for workflow-v2 diff-impact analysis.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ImpactFromDiffRequest {
+    /// Unified diff text.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub diff: Option<String>,
+    /// Changed files when a diff is unavailable.
+    #[serde(default)]
+    pub files: Vec<String>,
+    /// Changed symbols when a diff is unavailable.
+    #[serde(default)]
+    pub symbols: Vec<String>,
+    /// Requested render mode.
+    pub mode: WorkflowRenderChoice,
+    /// Bounded traversal depth.
+    pub hops: usize,
+}
+
+/// Convert legacy diff-impact output into the shared Phase 8 bundle.
+pub fn build_bundle(
+    graph: &CodeGraph,
+    report: &DiffImpactReport,
+    mode: WorkflowRenderChoice,
+) -> WorkflowBundle {
+    let mut pivots = report
+        .changed_symbols
+        .iter()
+        .map(|symbol| Pivot {
+            pivot_type: "changed_symbol".to_string(),
+            title: symbol.symbol.clone(),
+            file: Some(symbol.file.clone()),
+            symbol: Some(symbol.symbol.clone()),
+            line: Some(symbol.line),
+            summary: format!(
+                "{} changed with {} downstream dependent(s).",
+                symbol.change_kind, symbol.impact_count
+            ),
+            inclusion_reason: symbol
+                .reasons
+                .first()
+                .cloned()
+                .unwrap_or_else(|| "Mapped changed diff lines onto a graph symbol.".to_string()),
+            expansion_focus: expansion_focus(Some(&symbol.file), Some(&symbol.symbol)),
+            score: Some(symbol.impact_count as f64),
+            verification_status: None,
+            verification_command: first_related_test_command(report),
+            provenance: symbol.reasons.clone(),
+        })
+        .collect::<Vec<_>>();
+    pivots.truncate(mode.pivot_limit());
+
+    let mut relevant_context = report
+        .affected_symbols
+        .iter()
+        .map(|symbol| Pivot {
+            pivot_type: "affected_symbol".to_string(),
+            title: symbol.symbol.clone(),
+            file: Some(symbol.file.clone()),
+            symbol: Some(symbol.symbol.clone()),
+            line: Some(symbol.line),
+            summary: format!(
+                "Affected via {} with {} provenance hop(s).",
+                symbol.relationship,
+                symbol.via.len()
+            ),
+            inclusion_reason: symbol.relationship.clone(),
+            expansion_focus: expansion_focus(Some(&symbol.file), Some(&symbol.symbol)),
+            score: Some(symbol.score),
+            verification_status: None,
+            verification_command: None,
+            provenance: symbol.via.clone(),
+        })
+        .collect::<Vec<_>>();
+    attach_docs_context(graph, &mut relevant_context, report, mode);
+    relevant_context.truncate(mode.context_limit());
+
+    let verification_commands = report
+        .tests
+        .iter()
+        .map(|test| infer_test_command(&test.file))
+        .collect::<Vec<_>>();
+    WorkflowBundle {
+        tool: "impact_from_diff".to_string(),
+        render_choice: mode,
+        overview: format!(
+            "Diff impact surfaced {} changed symbol(s), {} affected symbol(s), and {} test target(s).",
+            report.changed_symbols.len(),
+            report.affected_symbols.len(),
+            report.tests.len()
+        ),
+        pivots,
+        relevant_context,
+        memory_highlights: Vec::new(),
+        event_episodes: Vec::new(),
+        suggested_expansion: report.suggested_expand.as_ref().map(|hint| ExpansionHint {
+            focus: hint.focus.clone(),
+            reason: hint.reason.clone(),
+        }),
+        risks: impact_risks(report),
+        verification_commands,
+        structured_payload: serde_json::to_value(report).unwrap_or(Value::Null),
+        diagnostics: diagnostics(report, mode),
+    }
+}
+
+fn attach_docs_context(
+    graph: &CodeGraph,
+    relevant_context: &mut Vec<Pivot>,
+    report: &DiffImpactReport,
+    mode: WorkflowRenderChoice,
+) {
+    if mode == WorkflowRenderChoice::Focused {
+        return;
+    }
+    for changed in &report.changed_symbols {
+        if relevant_context.len() >= mode.context_limit() {
+            return;
+        }
+        for node in graph.all_nodes() {
+            if !node.file.ends_with(".md") {
+                continue;
+            }
+            let mentions_changed = graph.get_dependencies(&node.id).into_iter().any(|(dep, edge)| {
+                dep.file == changed.file
+                    && dep.name == changed.symbol
+                    && matches!(edge, lattice_core::graph::model::EdgeKind::Mentions)
+            });
+            if mentions_changed {
+                relevant_context.push(Pivot {
+                    pivot_type: "affected_doc".to_string(),
+                    title: node.name.clone(),
+                    file: Some(node.file.clone()),
+                    symbol: Some(node.name.clone()),
+                    line: Some(node.line),
+                    summary: "Documentation section references a changed symbol.".to_string(),
+                    inclusion_reason: format!(
+                        "Markdown documentation mentions changed symbol {}.",
+                        changed.symbol
+                    ),
+                    expansion_focus: expansion_focus(Some(&node.file), Some(&node.name)),
+                    score: Some(1.0),
+                    verification_status: None,
+                    verification_command: None,
+                    provenance: vec![changed.symbol.clone()],
+                });
+                break;
+            }
+        }
+    }
+}
+
+fn impact_risks(report: &DiffImpactReport) -> Vec<RiskNote> {
+    let mut risks = report
+        .risks
+        .iter()
+        .map(|risk| RiskNote {
+            level: risk.level.clone(),
+            summary: format!("{} in {}", risk.symbol, risk.file),
+            detail: format!("{} (impact_count={})", risk.reason, risk.impact_count),
+        })
+        .collect::<Vec<_>>();
+    if report.changed_symbols.is_empty() {
+        risks.push(RiskNote {
+            level: "warning".to_string(),
+            summary: "No changed symbols mapped".to_string(),
+            detail: "The diff changed files, but no graph symbols overlapped the modified lines."
+                .to_string(),
+        });
+    }
+    risks
+}
+
+fn diagnostics(report: &DiffImpactReport, mode: WorkflowRenderChoice) -> Vec<String> {
+    if mode != WorkflowRenderChoice::Diagnostic {
+        return Vec::new();
+    }
+    vec![
+        format!("changed_files={}", report.changed_files.len()),
+        format!("changed_symbols={}", report.changed_symbols.len()),
+        format!("affected_symbols={}", report.affected_symbols.len()),
+    ]
+}
+
+fn first_related_test_command(report: &DiffImpactReport) -> Option<String> {
+    report
+        .tests
+        .first()
+        .map(|test| infer_test_command(&test.file))
+}
diff --git a/daemon/crates/lattice-daemon/src/rpc/workflow_v2/mod.rs b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/mod.rs
new file mode 100644
index 0000000000000000000000000000000000000000..997851fabf3ad28260c7c5e3a0a74ad207c18d87
--- /dev/null
+++ b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/mod.rs
@@ -0,0 +1,282 @@
+//! Shared workflow-v2 bundle surface for Phase 8 workflow tools.
+//!
+//! This module follows the spec headings `## Phase 8: Workflow Engine V2`,
+//! `## MCP Surface`, and `## Non-Negotiable Product Properties`.
+
+pub mod context_capsule;
+pub mod docs_capsule;
+pub mod impact_from_diff;
+pub mod relevant_tests;
+
+#[cfg(test)]
+mod discovery_workflows_tests;
+
+use lattice_core::intelligence::ExpandContextSeed;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::collections::HashSet;
+
+/// Delivery shape requested by the caller.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum WorkflowRenderChoice {
+    /// Tightest bounded first pass.
+    Focused,
+    /// Compact default bundle.
+    Compact,
+    /// Larger operator-facing payload.
+    Full,
+    /// Full payload plus scoring diagnostics.
+    Diagnostic,
+}
+
+impl WorkflowRenderChoice {
+    /// Parse a render choice from MCP arguments.
+    pub fn from_mode_str(value: Option<&str>) -> Self {
+        match value.unwrap_or("compact") {
+            "focused" => Self::Focused,
+            "full" => Self::Full,
+            "diagnostic" => Self::Diagnostic,
+            _ => Self::Compact,
+        }
+    }
+
+    /// Maximum primary pivots to keep for this render mode.
+    pub fn pivot_limit(self) -> usize {
+        match self {
+            Self::Focused => 3,
+            Self::Compact => 8,
+            Self::Full | Self::Diagnostic => 12,
+        }
+    }
+
+    /// Maximum supporting context items to keep for this render mode.
+    pub fn context_limit(self) -> usize {
+        match self {
+            Self::Focused => 3,
+            Self::Compact => 6,
+            Self::Full | Self::Diagnostic => 10,
+        }
+    }
+
+    /// Maximum memories to keep for this render mode.
+    pub fn memory_limit(self) -> usize {
+        match self {
+            Self::Focused => 1,
+            Self::Compact => 3,
+            Self::Full | Self::Diagnostic => 6,
+        }
+    }
+}
+
+/// One ranked anchor or context item inside a workflow bundle.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Pivot {
+    /// Stable category of this item such as `code`, `doc_primary`, `code_referenced`, or `test`.
+    pub pivot_type: String,
+    /// Short operator-facing title.
+    pub title: String,
+    /// Repo-relative file path when known.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub file: Option<String>,
+    /// Symbol or section name when known.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub symbol: Option<String>,
+    /// 1-based line number when known.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub line: Option<usize>,
+    /// Short summary used in compact mode.
+    pub summary: String,
+    /// Why this item was included.
+    pub inclusion_reason: String,
+    /// Stable expansion focus to use with `expand_context`.
+    pub expansion_focus: String,
+    /// Relative score for ranking and diagnostics.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub score: Option<f64>,
+    /// Verification status if this item is backed by verified memory or evidence.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub verification_status: Option<String>,
+    /// Optional verification command associated with this item.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub verification_command: Option<String>,
+    /// Provenance snippets describing how the item was ranked.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub provenance: Vec<String>,
+}
+
+/// Memory evidence surfaced in a workflow bundle.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct MemoryHighlight {
+    /// Short memory content excerpt.
+    pub content: String,
+    /// Memory type such as `observation` or `decision`.
+    pub memory_type: String,
+    /// Durability scope such as `session`, `branch`, or `repo`.
+    pub scope: String,
+    /// Why the memory was included.
+    pub inclusion_reason: String,
+    /// Whether the memory must be treated as stale or contradicted.
+    pub stale_label: bool,
+    /// Verification status from the verification engine.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub verification_status: Option<String>,
+}
+
+/// Event-log evidence surfaced alongside graph and memory results.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct EventEpisode {
+    /// Stable category such as `tool_call`, `workflow_failed`, or `test_run`.
+    pub episode_type: String,
+    /// Short summary for the event episode.
+    pub summary: String,
+    /// Why the episode matters to the current bundle.
+    pub inclusion_reason: String,
+}
+
+/// Explicit uncertainty or failure information in the workflow bundle.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct RiskNote {
+    /// Severity label such as `info`, `warning`, or `high`.
+    pub level: String,
+    /// Short title.
+    pub summary: String,
+    /// More specific detail about the risk.
+    pub detail: String,
+}
+
+/// Suggested next focus to expand without broad re-querying.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ExpansionHint {
+    /// Focus token accepted by `expand_context`.
+    pub focus: String,
+    /// Why the focus is the best next delta.
+    pub reason: String,
+}
+
+/// Shared Phase 8 workflow bundle.
+///
+/// Self-documenting spec field list: overview, ranked pivots, relevant context,
+/// memory highlights, event episodes, suggested next expansion, stable handles,
+/// risks, render choice, structured payload.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct WorkflowBundle {
+    /// Tool name that produced the bundle.
+    pub tool: String,
+    /// Render mode used for this bundle.
+    pub render_choice: WorkflowRenderChoice,
+    /// Compact overview for the assistant.
+    pub overview: String,
+    /// Ranked primary pivots.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub pivots: Vec<Pivot>,
+    /// Additional supporting context kept compact by default.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub relevant_context: Vec<Pivot>,
+    /// Relevant memory evidence.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub memory_highlights: Vec<MemoryHighlight>,
+    /// Relevant event-log evidence.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub event_episodes: Vec<EventEpisode>,
+    /// Best next delta to expand.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub suggested_expansion: Option<ExpansionHint>,
+    /// Risks, contradictions, or gaps that affect trust.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub risks: Vec<RiskNote>,
+    /// Verification commands inferred from the surfaced evidence.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub verification_commands: Vec<String>,
+    /// Raw structured payload for clients that need the underlying detail.
+    pub structured_payload: Value,
+    /// Optional diagnostic notes used in diagnostic mode.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub diagnostics: Vec<String>,
+}
+
+/// Convert a workflow bundle into an `expand_context` seed.
+pub fn build_expand_seed(bundle: &WorkflowBundle) -> ExpandContextSeed {
+    let mut files = Vec::new();
+    let mut symbols = Vec::new();
+    let mut tests = Vec::new();
+    let mut memories = Vec::new();
+    for pivot in bundle.pivots.iter().chain(bundle.relevant_context.iter()) {
+        if let Some(file) = &pivot.file {
+            if pivot.pivot_type == "test" {
+                tests.push(file.clone());
+            } else {
+                files.push(file.clone());
+            }
+        }
+        if let Some(symbol) = &pivot.symbol {
+            symbols.push(symbol.clone());
+        }
+    }
+    for memory in &bundle.memory_highlights {
+        memories.push(serde_json::json!({
+            "content": memory.content,
+            "memory_type": memory.memory_type,
+            "scope": memory.scope,
+            "verification_status": memory.verification_status,
+            "is_stale": memory.stale_label,
+        }));
+    }
+    dedupe(&mut files);
+    dedupe(&mut symbols);
+    dedupe(&mut tests);
+    ExpandContextSeed {
+        query: Some(bundle.overview.clone()),
+        files,
+        symbols,
+        tests,
+        memories,
+    }
+}
+
+/// Infer a verification command from a test file path.
+pub fn infer_test_command(file: &str) -> String {
+    if file.ends_with(".rs") {
+        let stem = file
+            .rsplit('/')
+            .next()
+            .unwrap_or(file)
+            .trim_end_matches(".rs")
+            .replace('-', "_");
+        return format!("cargo test {stem}");
+    }
+    if file.ends_with(".py") {
+        return format!("pytest {file}");
+    }
+    if file.ends_with(".ts")
+        || file.ends_with(".tsx")
+        || file.ends_with(".js")
+        || file.ends_with(".jsx")
+    {
+        return format!("npm test -- {file}");
+    }
+    format!("test {file}")
+}
+
+/// Build a stable `expand_context` focus token for file/symbol pairs.
+pub fn expansion_focus(file: Option<&str>, symbol: Option<&str>) -> String {
+    match (file, symbol) {
+        (Some(file), Some(symbol)) => format!("symbol:{file}::{symbol}"),
+        (Some(file), None) => format!("file:{file}"),
+        (None, Some(symbol)) => format!("symbol:{symbol}"),
+        (None, None) => "file:".to_string(),
+    }
+}
+
+/// True when a verification status must be surfaced as stale.
+pub fn is_stale_status(status: Option<&str>) -> bool {
+    matches!(
+        status,
+        Some("stale" | "contradicted" | "superseded" | "expired" | "invalidated")
+    )
+}
+
+fn dedupe(values: &mut Vec<String>) {
+    let mut seen = HashSet::new();
+    values.retain(|value| seen.insert(value.clone()));
+}
diff --git a/daemon/crates/lattice-daemon/src/rpc/workflow_v2/relevant_tests.rs b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/relevant_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5959db2d00fff09f2b63c6b7fc57c89659bad216
--- /dev/null
+++ b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/relevant_tests.rs
@@ -0,0 +1,143 @@
+//! Workflow-v2 adapter for `find_relevant_tests`.
+//!
+//! Bound to spec headings `## Phase 8: Workflow Engine V2`, `## MCP Surface`,
+//! and `## Non-Negotiable Product Properties`.
+
+use super::{
+    expansion_focus, infer_test_command, ExpansionHint, Pivot, RiskNote, WorkflowBundle,
+    WorkflowRenderChoice,
+};
+use lattice_core::intelligence::TestSelectionReport;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+/// Request payload for workflow-v2 relevant-test discovery.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct RelevantTestsRequest {
+    /// Candidate source files.
+    #[serde(default)]
+    pub files: Vec<String>,
+    /// Candidate symbols.
+    #[serde(default)]
+    pub symbols: Vec<String>,
+    /// Optional unified diff text.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub diff: Option<String>,
+    /// Requested render mode.
+    pub mode: WorkflowRenderChoice,
+    /// Maximum test count to keep.
+    pub limit: usize,
+}
+
+/// Convert legacy test-selection output into the shared Phase 8 bundle.
+pub fn build_bundle(report: &TestSelectionReport, mode: WorkflowRenderChoice) -> WorkflowBundle {
+    let mut pivots = report
+        .tests
+        .iter()
+        .map(|test| Pivot {
+            pivot_type: "test".to_string(),
+            title: test.file.clone(),
+            file: Some(test.file.clone()),
+            symbol: None,
+            line: None,
+            summary: format!(
+                "{} confidence with {} provenance item(s).",
+                test.confidence_band,
+                test.evidence.len().max(test.reasons.len())
+            ),
+            inclusion_reason: test
+                .reasons
+                .first()
+                .cloned()
+                .unwrap_or_else(|| "Ranked from graph proximity and diff anchors.".to_string()),
+            expansion_focus: expansion_focus(Some(&test.file), None),
+            score: Some(test.confidence),
+            verification_status: Some("verified".to_string()),
+            verification_command: Some(infer_test_command(&test.file)),
+            provenance: provenance(test),
+        })
+        .collect::<Vec<_>>();
+    pivots.truncate(mode.pivot_limit());
+
+    let mut relevant_context = report
+        .source_files
+        .iter()
+        .map(|file| Pivot {
+            pivot_type: "source_anchor".to_string(),
+            title: file.clone(),
+            file: Some(file.clone()),
+            symbol: None,
+            line: None,
+            summary: "Anchored source file used for test ranking.".to_string(),
+            inclusion_reason: "Source file or diff path seeded test traversal.".to_string(),
+            expansion_focus: expansion_focus(Some(file), None),
+            score: None,
+            verification_status: None,
+            verification_command: None,
+            provenance: Vec::new(),
+        })
+        .collect::<Vec<_>>();
+    relevant_context.truncate(mode.context_limit());
+
+    let verification_commands = pivots
+        .iter()
+        .filter_map(|pivot| pivot.verification_command.clone())
+        .collect::<Vec<_>>();
+    WorkflowBundle {
+        tool: "find_relevant_tests".to_string(),
+        render_choice: mode,
+        overview: format!(
+            "Relevant-test discovery ranked {} test file(s) from {} source anchor(s).",
+            pivots.len(),
+            report.source_files.len()
+        ),
+        pivots,
+        relevant_context,
+        memory_highlights: Vec::new(),
+        event_episodes: Vec::new(),
+        suggested_expansion: report.tests.first().map(|test| ExpansionHint {
+            focus: expansion_focus(Some(&test.file), None),
+            reason: "Top-ranked test is the cheapest verification surface to inspect next."
+                .to_string(),
+        }),
+        risks: test_risks(report),
+        verification_commands,
+        structured_payload: serde_json::to_value(report).unwrap_or(Value::Null),
+        diagnostics: if mode == WorkflowRenderChoice::Diagnostic {
+            vec![
+                format!("gaps={}", report.gaps.len()),
+                format!("matched_rules={}", report.matched_rules.len()),
+            ]
+        } else {
+            Vec::new()
+        },
+    }
+}
+
+fn provenance(test: &lattice_core::intelligence::TestRecommendation) -> Vec<String> {
+    let mut result = test.evidence.clone();
+    result.extend(test.reasons.clone());
+    result.truncate(5);
+    result
+}
+
+fn test_risks(report: &TestSelectionReport) -> Vec<RiskNote> {
+    let mut risks = report
+        .gaps
+        .iter()
+        .map(|gap| RiskNote {
+            level: "warning".to_string(),
+            summary: "Coverage gap".to_string(),
+            detail: gap.clone(),
+        })
+        .collect::<Vec<_>>();
+    if report.tests.is_empty() {
+        risks.push(RiskNote {
+            level: "high".to_string(),
+            summary: "No tests recommended".to_string(),
+            detail: "The graph did not surface a credible verification target for this change."
+                .to_string(),
+        });
+    }
+    risks
+}

