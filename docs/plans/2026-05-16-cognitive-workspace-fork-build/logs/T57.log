+    Memory, MemoryClass, MemoryScope, MemoryStore, MemoryStructuredFields,
+    MemoryVerificationStatus,
+};
+use lattice_core::memory::model::{
+    MemoryAssertionType, MemoryFreshnessPolicy, MemoryProvenance,
 };
