use super::WorkflowRenderChoice;
use lattice_core::query::ContextCapsule;
use serde_json::{json, Value};

/// Build a workflow-v2 context capsule payload.
pub fn build_bundle(
    _graph: &lattice_core::graph::model::CodeGraph,
    capsule: &ContextCapsule,
    render_choice: WorkflowRenderChoice,
) -> Value {
    let mut value = serde_json::to_value(capsule).unwrap_or_else(|_| json!({}));
    if let Some(object) = value.as_object_mut() {
        object.insert(
            "overview".to_string(),
            json!(format!(
                "Found {} ranked pivots and {} supporting context items.",
                capsule.pivots.len(),
                capsule.context.len()
            )),
        );
        object.insert(
            "render_choice".to_string(),
            json!(format!("{:?}", render_choice).to_lowercase()),
        );
        if let Some(pivot) = capsule.pivots.first() {
            object.insert(
                "suggested_expand".to_string(),
                json!({
                    "focus": format!("symbol:{}", pivot.symbol),
                    "reason": "Expand the lead pivot before broad file reads."
                }),
            );
        }
    }
    value
}

