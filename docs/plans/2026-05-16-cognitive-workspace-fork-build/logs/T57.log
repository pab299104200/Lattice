+++ b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/impact_from_diff.rs
@@ -0,0 +1,203 @@
+//! Workflow-v2 adapter for `impact_from_diff`.
+//!
+//! Bound to spec headings `## Phase 8: Workflow Engine V2`, `## MCP Surface`,
+//! and `## Non-Negotiable Product Properties`.
+
+use super::{
+    expansion_focus, infer_test_command, ExpansionHint, Pivot, RiskNote, WorkflowBundle,
+    WorkflowRenderChoice,
+};
+use lattice_core::graph::model::CodeGraph;
+use lattice_core::intelligence::DiffImpactReport;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+/// Request payload for workflow-v2 diff-impact analysis.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ImpactFromDiffRequest {
+    /// Unified diff text.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub diff: Option<String>,
+    /// Changed files when a diff is unavailable.
+    #[serde(default)]
+    pub files: Vec<String>,
+    /// Changed symbols when a diff is unavailable.
+    #[serde(default)]
+    pub symbols: Vec<String>,
+    /// Requested render mode.
+    pub mode: WorkflowRenderChoice,
+    /// Bounded traversal depth.
+    pub hops: usize,
+}
+
+/// Convert legacy diff-impact output into the shared Phase 8 bundle.
+pub fn build_bundle(
+    graph: &CodeGraph,
+    report: &DiffImpactReport,
+    mode: WorkflowRenderChoice,
+) -> WorkflowBundle {
+    let mut pivots = report
+        .changed_symbols
+        .iter()
+        .map(|symbol| Pivot {
+            pivot_type: "changed_symbol".to_string(),
+            title: symbol.symbol.clone(),
+            file: Some(symbol.file.clone()),
+            symbol: Some(symbol.symbol.clone()),
+            line: Some(symbol.line),
+            summary: format!(
+                "{} changed with {} downstream dependent(s).",
+                symbol.change_kind, symbol.impact_count
+            ),
+            inclusion_reason: symbol
+                .reasons
+                .first()
+                .cloned()
+                .unwrap_or_else(|| "Mapped changed diff lines onto a graph symbol.".to_string()),
+            expansion_focus: expansion_focus(Some(&symbol.file), Some(&symbol.symbol)),
+            score: Some(symbol.impact_count as f64),
+            verification_status: None,
+            verification_command: first_related_test_command(report),
+            provenance: symbol.reasons.clone(),
+        })
+        .collect::<Vec<_>>();
+    pivots.truncate(mode.pivot_limit());
+
+    let mut relevant_context = report
+        .affected_symbols
+        .iter()
+        .map(|symbol| Pivot {
+            pivot_type: "affected_symbol".to_string(),
+            title: symbol.symbol.clone(),
+            file: Some(symbol.file.clone()),
+            symbol: Some(symbol.symbol.clone()),
+            line: Some(symbol.line),
+            summary: format!(
+                "Affected via {} with {} provenance hop(s).",
+                symbol.relationship,
+                symbol.via.len()
+            ),
+            inclusion_reason: symbol.relationship.clone(),
+            expansion_focus: expansion_focus(Some(&symbol.file), Some(&symbol.symbol)),
+            score: Some(symbol.score),
+            verification_status: None,
+            verification_command: None,
+            provenance: symbol.via.clone(),
+        })
+        .collect::<Vec<_>>();
+    attach_docs_context(graph, &mut relevant_context, report, mode);
+    relevant_context.truncate(mode.context_limit());
+
+    let verification_commands = report
+        .tests
+        .iter()
+        .map(|test| infer_test_command(&test.file))
+        .collect::<Vec<_>>();
+    WorkflowBundle {
+        tool: "impact_from_diff".to_string(),
+        render_choice: mode,
+        overview: format!(
+            "Diff impact surfaced {} changed symbol(s), {} affected symbol(s), and {} test target(s).",
+            report.changed_symbols.len(),
+            report.affected_symbols.len(),
+            report.tests.len()
+        ),
+        pivots,
+        relevant_context,
+        memory_highlights: Vec::new(),
+        event_episodes: Vec::new(),
+        suggested_expansion: report.suggested_expand.as_ref().map(|hint| ExpansionHint {
+            focus: hint.focus.clone(),
+            reason: hint.reason.clone(),
+        }),
+        risks: impact_risks(report),
+        verification_commands,
+        structured_payload: serde_json::to_value(report).unwrap_or(Value::Null),
+        diagnostics: diagnostics(report, mode),
+    }
+}
+
+fn attach_docs_context(
+    graph: &CodeGraph,
+    relevant_context: &mut Vec<Pivot>,
+    report: &DiffImpactReport,
+    mode: WorkflowRenderChoice,
+) {
+    if mode == WorkflowRenderChoice::Focused {
+        return;
+    }
+    for changed in &report.changed_symbols {
+        if relevant_context.len() >= mode.context_limit() {
+            return;
+        }
+        for node in graph.all_nodes() {
+            if !node.file.ends_with(".md") {
+                continue;
+            }
+            let mentions_changed = graph.get_dependencies(&node.id).into_iter().any(|(dep, edge)| {
+                dep.file == changed.file
+                    && dep.name == changed.symbol
+                    && matches!(edge, lattice_core::graph::model::EdgeKind::Mentions)
+            });
+            if mentions_changed {
+                relevant_context.push(Pivot {
+                    pivot_type: "affected_doc".to_string(),
+                    title: node.name.clone(),
+                    file: Some(node.file.clone()),
+                    symbol: Some(node.name.clone()),
+                    line: Some(node.line),
+                    summary: "Documentation section references a changed symbol.".to_string(),
+                    inclusion_reason: format!(
+                        "Markdown documentation mentions changed symbol {}.",
+                        changed.symbol
+                    ),
+                    expansion_focus: expansion_focus(Some(&node.file), Some(&node.name)),
+                    score: Some(1.0),
+                    verification_status: None,
+                    verification_command: None,
+                    provenance: vec![changed.symbol.clone()],
+                });
+                break;
+            }
+        }
+    }
+}
+
+fn impact_risks(report: &DiffImpactReport) -> Vec<RiskNote> {
+    let mut risks = report
+        .risks
+        .iter()
+        .map(|risk| RiskNote {
+            level: risk.level.clone(),
+            summary: format!("{} in {}", risk.symbol, risk.file),
+            detail: format!("{} (impact_count={})", risk.reason, risk.impact_count),
+        })
+        .collect::<Vec<_>>();
+    if report.changed_symbols.is_empty() {
+        risks.push(RiskNote {
+            level: "warning".to_string(),
+            summary: "No changed symbols mapped".to_string(),
+            detail: "The diff changed files, but no graph symbols overlapped the modified lines."
+                .to_string(),
+        });
+    }
+    risks
+}
+
+fn diagnostics(report: &DiffImpactReport, mode: WorkflowRenderChoice) -> Vec<String> {
+    if mode != WorkflowRenderChoice::Diagnostic {
+        return Vec::new();
+    }
+    vec![
+        format!("changed_files={}", report.changed_files.len()),
+        format!("changed_symbols={}", report.changed_symbols.len()),
+        format!("affected_symbols={}", report.affected_symbols.len()),
+    ]
+}
+
+fn first_related_test_command(report: &DiffImpactReport) -> Option<String> {
+    report
+        .tests
+        .first()
+        .map(|test| infer_test_command(&test.file))
+}
