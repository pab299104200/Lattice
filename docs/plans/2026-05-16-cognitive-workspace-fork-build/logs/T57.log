+++ b/daemon/crates/lattice-daemon/src/rpc/workflow_v2/relevant_tests.rs
@@ -0,0 +1,143 @@
+//! Workflow-v2 adapter for `find_relevant_tests`.
+//!
+//! Bound to spec headings `## Phase 8: Workflow Engine V2`, `## MCP Surface`,
+//! and `## Non-Negotiable Product Properties`.
+
+use super::{
+    expansion_focus, infer_test_command, ExpansionHint, Pivot, RiskNote, WorkflowBundle,
+    WorkflowRenderChoice,
+};
+use lattice_core::intelligence::TestSelectionReport;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+/// Request payload for workflow-v2 relevant-test discovery.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct RelevantTestsRequest {
+    /// Candidate source files.
+    #[serde(default)]
+    pub files: Vec<String>,
+    /// Candidate symbols.
+    #[serde(default)]
+    pub symbols: Vec<String>,
+    /// Optional unified diff text.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub diff: Option<String>,
+    /// Requested render mode.
+    pub mode: WorkflowRenderChoice,
+    /// Maximum test count to keep.
+    pub limit: usize,
+}
+
+/// Convert legacy test-selection output into the shared Phase 8 bundle.
+pub fn build_bundle(report: &TestSelectionReport, mode: WorkflowRenderChoice) -> WorkflowBundle {
+    let mut pivots = report
+        .tests
+        .iter()
+        .map(|test| Pivot {
+            pivot_type: "test".to_string(),
+            title: test.file.clone(),
+            file: Some(test.file.clone()),
+            symbol: None,
+            line: None,
+            summary: format!(
+                "{} confidence with {} provenance item(s).",
+                test.confidence_band,
+                test.evidence.len().max(test.reasons.len())
+            ),
+            inclusion_reason: test
+                .reasons
+                .first()
+                .cloned()
+                .unwrap_or_else(|| "Ranked from graph proximity and diff anchors.".to_string()),
+            expansion_focus: expansion_focus(Some(&test.file), None),
+            score: Some(test.confidence),
+            verification_status: Some("verified".to_string()),
+            verification_command: Some(infer_test_command(&test.file)),
+            provenance: provenance(test),
+        })
+        .collect::<Vec<_>>();
+    pivots.truncate(mode.pivot_limit());
+
+    let mut relevant_context = report
+        .source_files
+        .iter()
+        .map(|file| Pivot {
+            pivot_type: "source_anchor".to_string(),
+            title: file.clone(),
+            file: Some(file.clone()),
+            symbol: None,
+            line: None,
+            summary: "Anchored source file used for test ranking.".to_string(),
+            inclusion_reason: "Source file or diff path seeded test traversal.".to_string(),
+            expansion_focus: expansion_focus(Some(file), None),
+            score: None,
+            verification_status: None,
+            verification_command: None,
+            provenance: Vec::new(),
+        })
+        .collect::<Vec<_>>();
+    relevant_context.truncate(mode.context_limit());
+
+    let verification_commands = pivots
+        .iter()
+        .filter_map(|pivot| pivot.verification_command.clone())
+        .collect::<Vec<_>>();
+    WorkflowBundle {
+        tool: "find_relevant_tests".to_string(),
+        render_choice: mode,
+        overview: format!(
+            "Relevant-test discovery ranked {} test file(s) from {} source anchor(s).",
+            pivots.len(),
+            report.source_files.len()
+        ),
+        pivots,
+        relevant_context,
+        memory_highlights: Vec::new(),
+        event_episodes: Vec::new(),
+        suggested_expansion: report.tests.first().map(|test| ExpansionHint {
+            focus: expansion_focus(Some(&test.file), None),
+            reason: "Top-ranked test is the cheapest verification surface to inspect next."
+                .to_string(),
+        }),
+        risks: test_risks(report),
+        verification_commands,
+        structured_payload: serde_json::to_value(report).unwrap_or(Value::Null),
+        diagnostics: if mode == WorkflowRenderChoice::Diagnostic {
+            vec![
+                format!("gaps={}", report.gaps.len()),
+                format!("matched_rules={}", report.matched_rules.len()),
+            ]
+        } else {
+            Vec::new()
+        },
+    }
+}
+
+fn provenance(test: &lattice_core::intelligence::TestRecommendation) -> Vec<String> {
+    let mut result = test.evidence.clone();
+    result.extend(test.reasons.clone());
+    result.truncate(5);
+    result
+}
+
+fn test_risks(report: &TestSelectionReport) -> Vec<RiskNote> {
+    let mut risks = report
+        .gaps
+        .iter()
+        .map(|gap| RiskNote {
+            level: "warning".to_string(),
+            summary: "Coverage gap".to_string(),
+            detail: gap.clone(),
+        })
+        .collect::<Vec<_>>();
+    if report.tests.is_empty() {
+        risks.push(RiskNote {
+            level: "high".to_string(),
+            summary: "No tests recommended".to_string(),
+            detail: "The graph did not surface a credible verification target for this change."
+                .to_string(),
+        });
+    }
+    risks
+}

