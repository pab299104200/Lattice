                writer.store(),
                &memory_db_path,
                SessionConsolidationConfig::default(),
            ) {
                Ok(consolidator) => Some(Arc::new(StdMutex::new(consolidator))),
                Err(error) => {
                    tracing::warn!(%error, "session consolidation disabled for workspace");
                    None
                }
