+    let bundle = fixture.context_bundle();
+    assert_eq!(bundle.render_choice.mode, "compact");
+    assert!(bundle.ranked_pivots.len() <= 8);
+}
+
+#[test]
+fn context_capsule_returns_expansion_handle_that_expand_context_can_use() {
