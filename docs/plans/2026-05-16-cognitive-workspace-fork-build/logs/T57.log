 }
 
diff --git a/daemon/crates/lattice-core/src/memory/store.rs b/daemon/crates/lattice-core/src/memory/store.rs
index 7310e8e658f7549b330a1d55ac777d2ad613c9e8..6b16be6099207b303eb9291093bf17f9f33a7947
--- a/daemon/crates/lattice-core/src/memory/store.rs
