+
+    assert_eq!(resolved.repo_relative_path, "src/renamed.rs");
+    assert_eq!(resolved.content_hash, helpers::content_hash(source));
+}
+
+#[test]
+fn test_resolve_symbol_unique_returns_symbolid() {
