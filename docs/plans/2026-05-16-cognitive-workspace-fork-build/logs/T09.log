+    fn resolve_file_identity_compat(
+        &self,
+        workspace: &WorkspaceId,
+        query: &str,
+    ) -> Result<Option<FileId>, ResolveError> {
+        let Ok(identity) = decode_identity(query) else {
+            return Ok(None);
