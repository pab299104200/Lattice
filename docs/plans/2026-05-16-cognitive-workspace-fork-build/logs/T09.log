        let Some(relative_path) = self.relative_path_in_workspace(workspace, &node.file) else {
            return false;
        };
        relative_path == wanted
            || relative_path.ends_with(&format!("/{wanted}"))
            || relative_path.rsplit('/').next() == Some(wanted.as_str())
    }

