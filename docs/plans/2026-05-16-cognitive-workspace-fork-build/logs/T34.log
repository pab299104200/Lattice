+struct LegacyScopePredicate {
+    where_clause: String,
+    bind_values: Vec<Value>,
+}
+
+fn legacy_scope_predicate(scope: &ScopeFilter) -> Result<LegacyScopePredicate, LatticeError> {
+    if scope.is_empty() {
+        return Err(LatticeError::Storage(
+            "Scoped memory query denied: explicit scope is required".to_string(),
+        ));
+    }
+
+    let mut predicates = Vec::new();
+    let mut bind_values = Vec::new();
+
+    for clause in scope.clauses() {
+        match clause {
+            ScopeClause::Session { session_id } => {
+                predicates.push("(scope = ? AND session_id = ?)".to_string());
+                bind_values.push(Value::Text("session".to_string()));
+                bind_values.push(Value::Text(session_id.clone()));
+            }
+            ScopeClause::Branch {
+                workspace_id,
+                branch_ref,
+            } => {
+                predicates.push("(scope = ? AND workspace_id = ? AND branch = ?)".to_string());
+                bind_values.push(Value::Text("branch".to_string()));
+                bind_values.push(Value::Text(workspace_id.clone()));
+                bind_values.push(Value::Text(branch_ref.clone()));
+            }
+            ScopeClause::Repo { workspace_id } => {
+                predicates.push("(scope = ? AND workspace_id = ?)".to_string());
+                bind_values.push(Value::Text("repo".to_string()));
+                bind_values.push(Value::Text(workspace_id.clone()));
+            }
+            ScopeClause::User { .. } | ScopeClause::Organization { .. } => {}
+        }
+    }
+
+    if predicates.is_empty() {
+        return Ok(LegacyScopePredicate {
+            where_clause: "1 = 0".to_string(),
+            bind_values,
+        });
+    }
+
+    Ok(LegacyScopePredicate {
+        where_clause: format!("({})", predicates.join(" OR ")),
+        bind_values,
+    })
 }
 
