diff --git a/daemon/crates/lattice-core/src/working_memory/mod.rs b/daemon/crates/lattice-core/src/working_memory/mod.rs
new file mode 100644
index 0000000000000000000000000000000000000000..67783af020baf132398583acaf798bfd014a821f
