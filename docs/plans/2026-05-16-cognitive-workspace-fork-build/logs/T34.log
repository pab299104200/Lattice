macro_rules! impl_identity_display {
    ($type_name:ty, $variant:ident) => {
        impl fmt::Display for $type_name {
            fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
                write!(
                    formatter,
                    "{}",
                    encode_identity(&Identity::$variant(self.clone()))
                )
            }
        }
    };
}

