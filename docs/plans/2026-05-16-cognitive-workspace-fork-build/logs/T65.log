//! Typed event log records for the cognitive workspace fork plan.
//!
//! This module implements the event model described in
//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`
//! `### 3. Event Log`.

pub mod compaction;
pub mod envelope;
