+) -> Vec<String> {
+    let mut recommendations = tests
+        .iter()
+        .map(|test| test.file.clone())
+        .collect::<Vec<_>>();
+    recommendations.extend(task.expected_tests.clone());
+    dedupe(&mut recommendations);
+    recommendations
+}
