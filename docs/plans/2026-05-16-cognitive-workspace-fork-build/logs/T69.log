+#[derive(Clone, Debug, Deserialize)]
+struct GoldenTask {
+    task_id: String,
+    repo: String,
+    #[serde(rename = "intent")]
+    _intent: String,
+    task_prompt: String,
+    expected_anchors: Vec<ExpectedAnchor>,
+    expected_tests: Vec<String>,
+}
