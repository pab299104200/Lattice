fn tool_called(
    workspace: &str,
    branch: &str,
    session: &str,
    task: &str,
    tool_name: &str,
    second: i64,
) -> EventEnvelope {
    event(
        workspace,
        branch,
        session,
        task,
        second,
        EventKind::ToolCalled,
        EventPayload::ToolCalled(crate::events::ToolCalledPayload {
            call_id: format!("call-{second}"),
            tool_name: tool_name.to_string(),
            context_handle_id: None,
            source_event_id: None,
            input_summary: tool_name.to_string(),
        }),
    )
}

fn file_read(
    workspace: &str,
    branch: &str,
    session: &str,
    task: &str,
    path: &str,
    second: i64,
) -> EventEnvelope {
    event(
        workspace,
        branch,
        session,
        task,
        second,
        EventKind::FileRead,
        EventPayload::FileRead(crate::events::FileReadPayload {
            file_id: file_id(workspace, path),
            source_event_id: None,
            byte_start: None,
            byte_end: None,
            reason: "inspect".to_string(),
        }),
    )
}

