+            path.display()
+        ))
+    }
+}
+
+fn assert_temp_event_store_exists(root: &Path) -> Result<(), String> {
+    let path = root.join(".lattice/events.db");
+    if path.exists() {
+        Ok(())
+    } else {
+        Err(format!("isolated event store was not created at {}", path.display()))
+    }
+}
