+        },
+        kind: payload.kind(),
+        references: Vec::new(),
+        summary: CompactSummary::new(format!("{} {summary}", report.task_id))
+            .map_err(|error| format!("build compact event summary: {error}"))?,
+        payload,
+    })
+}
+
+fn file_id(file: &str) -> FileId {
+    FileId {
+        workspace_id: "t69".to_string(),
