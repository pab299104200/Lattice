docs/plans/2026-05-16-cognitive-workspace5078d8b5d473","timestamp":"2026-05-17T14:58:38.061Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/memory_v2/get_memory_metrics.rs","content":"//! Assistant-facing memory metrics surface for Phase 9 signals.\n//!\n//! This module implements the `## MCP Surface`, `## Event Log`, and\n//! `## Phase 9: Metrics And Evaluation` contracts from\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`.\n//! When the canonical metrics module is not present yet, this tool returns\n//! honest partial data with explicit null reasons instead of fabricated values.\n\nuse lattice_core::{DateTime, Utc};\nuse serde::{Deserialize, Serialize};\nuse serde_json::{json, Value};\n\n/// Arguments for the `get_memory_metrics` tool.\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct GetMemoryMetricsArgs {\n    /// Aggregation scope for the requested metrics.\n    #[serde(default)]\n    pub scope: Option<MetricScopeKind>,\n    /// Optional time-range filter.\n    #[serde(default)]\n    pub time_range: Option<MetricTimeRange>,\n    /// Optional subset of signals to return.\n    #[serde(default)]\n    pub signals: Vec<MetricSignal>,\n    /// Response verbosity.\n    #[serde(default)]\n    pub render_mode: Option<MetricRenderMode>,\n}\n\n/// Scope taxonomy accepted by the metrics surface.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum MetricScopeKind {\n    Session,\n    Branch,\n    Repo,\n    User,\n    Organization,\n}\n\nimpl Default for MetricScopeKind {\n    fn default() -> Self {\n        Self::Session\n    }\n}\n\n/// Optional UTC time-range filter.\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct MetricTimeRange {\n    /// Inclusive lower bound.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub since: Option<DateTime<Utc>>,\n    /// Inclusive upper bound.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub until: Option<DateTime<Utc>>,\n}\n\n/// The spec-required metric signals.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum MetricSignal {\n    ToolCallsPerSuccessfulTask,\n    IrrelevantFilesOpenedPerTask,\n    RelevantAnchorRecall,\n    MemoryInclusionPrecision,\n    MemoryLaterUsedRate,\n    StaleMemorySurfacedRate,\n    ContradictionMissedRate,\n    TestsRecommendedVsNeeded,\n    WorkflowSuccessAfterFirstPlan,\n}\n\nimpl MetricSignal {\n    /// Canonical snake_case wire name for the signal.\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::ToolCallsPerSuccessfulTask => \"tool_calls_per_successful_task\",\n            Self::IrrelevantFilesOpenedPerTask => \"irrelevant_files_opened_per_task\",\n            Self::RelevantAnchorRecall => \"relevant_anchor_recall\",\n            Self::MemoryInclusionPrecision => \"memory_inclusion_precision\",\n            Self::MemoryLaterUsedRate => \"memory_later_used_rate\",\n            Self::StaleMemorySurfacedRate => \"stale_memory_surfaced_rate\",\n            Self::ContradictionMissedRate => \"contradiction_missed_rate\",\n            Self::TestsRecommendedVsNeeded => \"tests_recommended_vs_needed\",\n            Self::WorkflowSuccessAfterFirstPlan => \"workflow_success_after_first_plan\",\n        }\n    }\n}\n\n/// Data source for a metric value.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum MetricSource {\n    EventLog,\n    SessionMetrics,\n    CanonicalMetricsModule,\n    Unavailable,\n}\n\n/// Response verbosity for the metrics payload.","numLines":100,"startLine":1,"totalLines":212}}}
