+        .collect()
+}
+
+fn expected_symbols(task: &GoldenTask) -> Vec<String> {
+    task.expected_anchors
+        .iter()
+        .map(|anchor| anchor.symbol.clone())
+        .collect::<BTreeSet<_>>()
+        .into_iter()
+        .collect()
+}
