+      "memoryInbox": "Filter and inspect durable memories by status, class, scope, and verification state.",
+      "promotionQueue": "Review auditable promotion proposals before any durable memory write is applied.",
+      "contradictionQueue": "Inspect contradiction and supersession edges that require a human decision.",
+      "staleView": "Surface stale, contradicted, superseded, expired, and invalidated memories for re-verification.",
+      "evidenceInspector": "Deep-dive into one memory's claim, evidence, provenance, links, and verification history.",
+      "eventTrace": "Inspect task, session, or workspace event history with stable payload references.",
+      "retrievalExplanation": "Explain why retrieval included, excluded, or expanded specific context candidates.",
+      "usefulnessMetrics": "Inspect Phase 9 metrics and evaluation signals with explicit provenance.",
+      "workspaceGraphHealth": "Review node, edge, and broken-reference health for the current workspace graph.",
+      "indexingHealth": "Inspect live index status, language coverage, and indexing progress.",
+      "consolidationQueue": "Track consolidation proposals, queue depth, and background review workload."
+    }
+  },
+  "reviewStatus": {
