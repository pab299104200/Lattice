 -p lattice-core --lib hardening::partial_index_tests\",\n1515\t        \"cd daemon && cargo test -p lattice-core --lib hardening::workspace_boundary_tests\"\n1516\t      ]\n1517\t    },\n1518\t    {\n1519\t      \"task_id\": \"T84\",\n1520\t      \"title\": \"Phase 11 — Migration tests + MCP schema compatibility regression\",\n1521\t      \"task_type\": \"tests\",\n1522\t      \"depends_on\": [\"R79\", \"T22\", \"R64\"],\n1523\t      \"model_class\": \"advanced\",\n1524\t      \"status\": \"pending\",\n1525\t      \"files_expected\": [\n1526\t        \"daemon/crates/lattice-core/src/hardening/migration_tests.rs\",\n1527\t        \"daemon/crates/lattice-daemon/src/rpc/mcp_compat_tests.rs\"\n1528\t      ],\n1529\t      \"verification_commands\": [\n1530\t        \"test -f daemon/crates/lattice-core/src/hardening/migration_tests.rs\",\n1531\t        \"test -f daemon/crates/lattice-daemon/src/rpc/mcp_compat_tests.rs\",\n1532\t        \"cd daemon && cargo test -p lattice-core --lib hardening::migration_tests\",\n1533\t        \"cd daemon && cargo test -p lattice-daemon --lib rpc::mcp_compat_tests\"\n1534\t      ]\n1535\t    },\n1536\t    {\n1537\t      \"task_id\": \"T85\",\n1538\t      \"title\": \"Phase 11 — Documentation suite (all 11 required docs from spec §Documentation Requirements)\",\n1539\t      \"task_type\": \"docs\",\n1540\t      \"depends_on\": [\"R47\", \"R54\", \"R63\", \"R70\", \"R78\"],\n1541\t      \"model_class\": \"advanced\",\n1542\t      \"status\": \"pending\",\n1543\t      \"files_expected\": [\n1544\t        \"docs/architecture/2026-05-16-successor-architecture-overview.md\",\n1545\t        \"docs/architecture/2026-05-16-memory-model-reference.md\",\n1546\t        \"docs/architecture/2026-05-16-event-log-design.md\",\n1547\t        \"docs/architecture/2026-05-16-consolidation-design.md\",\n1548\t        \"docs/architecture/2026-05-16-retrieval-ranking-design.md\",\n1549\t        \"docs/architecture/2026-05-16-verification-freshness-design.md\",