type BridgeFactory = (daemon: DaemonManager) => ReviewRpcBridgeContract;

let bridgeFactory: BridgeFactory = (daemon) => new ReviewRpcBridge(daemon);

export function setBridgeForTests(factory?: BridgeFactory): void {
