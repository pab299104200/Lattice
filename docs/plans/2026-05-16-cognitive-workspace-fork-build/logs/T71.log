            let stableCount = 0;
            for (let i = 0; i < 60; i++) {
                await new Promise(r => setTimeout(r, 2000));
                const result = await daemon.sendRequest('lattice/status') as DaemonStatusSnapshot;
                if (result && typeof result === 'object') {
