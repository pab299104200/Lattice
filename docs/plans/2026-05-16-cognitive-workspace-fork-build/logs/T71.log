+        renderMode: stringValue(payload, 'render_mode'),
+        budgetMs: typeof payload.budget_ms === 'number' ? payload.budget_ms : undefined,
+        incomplete: payload.incomplete === true,
+        notes: stringArrayValue(payload, 'notes'),
+        proposals,
+        categories,
+    };
+}

