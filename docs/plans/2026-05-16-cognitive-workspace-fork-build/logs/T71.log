+        evidenceStrength: numberValue(record, 'evidence_strength'),
+        linkedFiles: stringArrayValue(record, 'linked_files'),
+        linkedSymbols: stringArrayValue(record, 'linked_symbols'),
+        linkedDocs: stringArrayValue(record, 'linked_docs'),
