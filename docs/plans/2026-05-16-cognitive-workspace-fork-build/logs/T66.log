+        second,
+        EventKind::ToolCalled,
+        EventPayload::ToolCalled(ToolCalledPayload {
+            call_id: format!("{}-{second}", report.task_id),
+            tool_name: tool.tool.clone(),
+            context_handle_id: None,
+            source_event_id: None,
+            input_summary: report.intent.clone(),
+        }),
+    )
+}
+
+fn file_read_event(
