+        session_id: Some(session_id(&runtime.workspace.name)),
+        user_id: None,
+        organization_id: None,
+        task_id: Some(report.task_id.clone()),
+        observed_at: DateTime::from_unix_seconds(1_779_000_000 + second),
+    }
+}
