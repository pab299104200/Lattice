+        content_hash: format!("hash-{path}"),
+    }
+}
+
+fn memory_id(runtime: &FixtureRuntime, report: &TaskReport) -> MemoryId {
+    MemoryId {
+        workspace_id: runtime.workspace.name.clone(),
