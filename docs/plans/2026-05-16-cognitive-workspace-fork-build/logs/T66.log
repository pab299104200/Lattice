+[
+  {
+    "task_id": "rust_scheduler_retry_policy",
+    "repo": "rust-repo",
+    "intent": "prepare_change",
+    "task_prompt": "Change scheduler retry policy capping and verify the cross-module audit behavior.",
+    "expected_anchors": [
+      {
