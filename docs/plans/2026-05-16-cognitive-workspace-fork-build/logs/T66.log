+fn anchor_id(file: &str, symbol: &str) -> String {
+    format!("{file}::{symbol}")
+}
+
+fn task_diff(task: &GoldenTask) -> String {
+    let file = task
+        .expected_anchors
+        .first()
+        .expect("task has expected anchors")
+        .file
+        .clone();
+    format!(
+        "diff --git a/{file} b/{file}\n--- a/{file}\n+++ b/{file}\n@@ -1,3 +1,4 @@\n- old behavior\n+ new behavior\n"
+    )
+}
