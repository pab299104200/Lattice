+}
+
+fn session_id(fixture: &str) -> String {
+    format!("session-{fixture}")
+}
+
+fn elapsed_us(started_at: Instant) -> u64 {
+    let nanos = started_at.elapsed().as_nanos();
+    ((nanos + 999) / 1_000) as u64
+}
+
+fn recorded_at() -> String {
