--- /dev/null
+++ b/daemon/crates/lattice-core/benches/fixtures/typescript-repo/src/notifications.ts
@@ -0,0 +1,13 @@
+import type { Incident } from "./models";
+
+export interface NotificationMessage {
+  channel: "email" | "slack";
+  body: string;
+}
+
+export function buildAssignmentNotice(incident: Incident): NotificationMessage {
+  return {
+    channel: incident.severity === "critical" ? "slack" : "email",
+    body: `Incident ${incident.id} assigned`,
+  };
+}
diff --git a/daemon/crates/lattice-core/benches/fixtures/typescript-repo/tests/assignment.test.ts b/daemon/crates/lattice-core/benches/fixtures/typescript-repo/tests/assignment.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5545e0a35ba206edb9b71130ef75b558fd2ef4f4
--- /dev/null
+++ b/daemon/crates/lattice-core/benches/fixtures/typescript-repo/tests/assignment.test.ts
@@ -0,0 +1,18 @@
+import { describe, expect, it } from "vitest";
+import { IncidentQueue, assignIncident } from "../src/models";
+
+describe("incident assignment", () => {
+  it("assigns an active group", () => {
+    const incident = { id: "inc-1", title: "Disk full", severity: "high" as const };
+    const group = { id: "grp-1", name: "Operations", active: true };
+
+    expect(assignIncident(incident, group).assignmentGroupId).toBe("grp-1");
+  });
+
+  it("throws when the incident cannot be found", () => {
+    const queue = new IncidentQueue([]);
+    const group = { id: "grp-1", name: "Operations", active: true };
+
+    expect(() => queue.assignIncident("missing", group)).toThrow("Incident not found");
+  });
+});
