+            task_id = task.task_id.as_str(),
+            tool = report.tool.as_str(),
+            latency_ms = report.latency_us as f64 / 1_000.0,
+            metric_signal_count = MetricSignal::ALL.len(),
+            "cognitive workspace benchmark tool run"
+        );
+    }
+}
