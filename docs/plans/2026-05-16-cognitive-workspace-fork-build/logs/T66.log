+            plan_summary: report.intent.clone(),
+        }),
+    )
+}
+
+fn workflow_succeeded_event(
+    runtime: &FixtureRuntime,
+    report: &TaskReport,
+    second: i64,
+) -> EventEnvelope {
+    event(
+        runtime,
+        report,
