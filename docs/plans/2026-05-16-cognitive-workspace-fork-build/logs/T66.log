+    "expected_anchors": [
+      {
+        "file": "src/scheduler.rs",
+        "symbol": "RetryPolicy::bounded",
+        "doc_section": "docs/scheduler.md#Scheduler Workflow"
+      },
+      {
+        "file": "src/scheduler.rs",
+        "symbol": "Scheduler::schedule",
+        "doc_section": "docs/scheduler.md#Scheduler Workflow"
+      },
+      {
+        "file": "src/audit.rs",
+        "symbol": "audit_schedule",
+        "doc_section": "docs/scheduler.md#Scheduler Workflow"
