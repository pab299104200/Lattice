+  {
+    "task_id": "rust_audit_trait_impact",
+    "repo": "rust-repo",
+    "intent": "impact_from_diff",
+    "task_prompt": "Review the impact of changing the AuditSink trait used by scheduler job creation.",
+    "expected_anchors": [
+      {
+        "file": "src/audit.rs",
+        "symbol": "AuditSink",
+        "doc_section": "docs/scheduler.md#Scheduler Workflow"
+      },
+      {
+        "file": "src/audit.rs",
+        "symbol": "VecAuditSink",
+        "doc_section": "docs/scheduler.md#Scheduler Workflow"
+      },
+      {
+        "file": "src/scheduler.rs",
+        "symbol": "Scheduler",
+        "doc_section": "docs/scheduler.md#Scheduler Workflow"
+      }
+    ],
+    "expected_tests": ["tests/scheduler_tests.rs"],
+    "expected_memory_classes": ["architecture_invariant", "workflow_outcome"],
