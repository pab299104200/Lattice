+        workspace_id: "workspace-main".to_string(),
+        repo_relative_path: path.to_string(),
+        content_hash: "hash".to_string(),
+    }
+}
+
+fn task_id(value: &str) -> TaskId {
+    TaskId {
+        value: value.to_string(),
+    }
+}
