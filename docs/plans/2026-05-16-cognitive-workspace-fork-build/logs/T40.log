+            "abandoned" => EpisodeOutcome::Abandoned,
+            _ => EpisodeOutcome::Success,
+        };
+        tokio::task::spawn_blocking(move || {
+            let mut consolidator = match consolidator.lock() {
+                Ok(guard) => guard,
+                Err(_) => {
