+use rusqlite::Connection;
+
+use super::{ConsolidationConfig, ConsolidationJobRuntime};
+
+#[test]
+fn deterministic_scanners_share_the_consolidation_runtime_schema() {
+    let runtime = ConsolidationJobRuntime::new(
+        Connection::open_in_memory().expect("db opens"),
+        ConsolidationConfig::default(),
+    )
+    .expect("runtime opens");
+
+    assert_eq!(runtime.config().max_queue_depth, ConsolidationConfig::default().max_queue_depth);
+}
