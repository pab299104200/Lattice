+fn is_due_for_refresh(
+    store: &MemoryStore,
+    memory: &Memory,
+    now: u64,
+    min_age_since_verification: u64,
+) -> Result<bool, ScanError> {
+    let last_verified_at = store
+        .get_last_verified_at(&memory.id)?
+        .unwrap_or(memory.created_at);
+    Ok(now.saturating_sub(last_verified_at) >= min_age_since_verification)
