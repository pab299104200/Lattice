+
+impl BudgetFixture {
+    fn new() -> Self {
+        let event_store = Arc::new(EventStore::open_in_memory().expect("event store opens"));
+        let writer = EventWriter::new(event_store.clone(), "workspace-main".to_string(), 4096)
+            .with_flush_policy(FlushPolicy::Sync);
