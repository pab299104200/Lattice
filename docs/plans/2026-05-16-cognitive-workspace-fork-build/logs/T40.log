+
+    fn append_event(
+        &self,
+        task_id: TaskId,
+        kind: EventKind,
+        payload: EventPayload,
+        references: Vec<crate::events::StableRef>,
+        summary: &str,
+    ) {
+        self.writer
+            .append(PartialEnvelope {
+                workspace_id: None,
