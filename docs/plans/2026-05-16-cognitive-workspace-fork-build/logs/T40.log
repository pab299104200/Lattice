+            .expect("event appends");
+        self.writer
+            .append(PartialEnvelope {
+                workspace_id: None,
+                branch: BranchRef {
+                    name: "main".to_string(),
+                },
+                session_id: SessionId {
+                    value: "session-budget".to_string(),
+                },
+                task_id: Some(task_id.clone()),
+                actor: Actor::Daemon,
+                kind: EventKind::FileRead,
+                references: vec![crate::events::StableRef::FileRef(file_id("src/lib.rs"))],
+                summary: CompactSummary::new("File read").expect("summary fits"),
+                payload: EventPayload::FileRead(FileReadPayload {
+                    file_id: file_id("src/lib.rs"),
