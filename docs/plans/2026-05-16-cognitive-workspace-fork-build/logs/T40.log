+        .all_nodes()
+        .into_iter()
+        .map(|node| node.file)
+        .collect::<BTreeSet<_>>();
+    let graph_symbols = graph
+        .all_nodes()
+        .into_iter()
+        .map(|node| node.name)
+        .collect::<BTreeSet<_>>();
+
