+fn anchors_still_match(graph: &CodeGraph, memory: &Memory) -> bool {
+    let graph_files = graph
+        .all_nodes()
+        .into_iter()
+        .map(|node| node.file)
+        .collect::<BTreeSet<_>>();
+    let graph_symbols = graph
+        .all_nodes()
+        .into_iter()
+        .map(|node| node.name)
+        .collect::<BTreeSet<_>>();
+
