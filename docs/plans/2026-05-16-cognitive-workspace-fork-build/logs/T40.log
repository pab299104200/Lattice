+
+fn anchors_still_match(graph: &CodeGraph, memory: &Memory) -> bool {
+    let graph_files = graph
+        .all_nodes()
+        .into_iter()
+        .map(|node| node.file)
+        .collect::<BTreeSet<_>>();
+    let graph_symbols = graph
+        .all_nodes()
+        .into_iter()
+        .map(|node| node.name)
+        .collect::<BTreeSet<_>>();
+
+    let file_match = memory.linked_files.is_empty()
+        || memory
+            .linked_files
+            .iter()
+            .any(|file| graph_files.contains(file.as_str()));
+    let symbol_match = memory.linked_symbols.is_empty()
+        || memory
+            .linked_symbols
+            .iter()
+            .any(|symbol| graph_symbols.contains(symbol.as_str()));
+    file_match && symbol_match
+}
