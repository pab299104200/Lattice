+    fn trigger_session_consolidation(&self, task: &str, status: &str) {
+        let Some(consolidator) = self.session_consolidator.as_ref().cloned() else {
+            return;
+        };
+        let workspace_id = self.workspace_root.to_string_lossy().to_string();
