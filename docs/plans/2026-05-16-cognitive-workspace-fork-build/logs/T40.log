+#[test]
+fn session_consolidation_never_mutates_memories_directly() {
+    let fixture = FileFixture::new();
+    fixture.append_small_task("task-no-mutate");
+    let consolidator = fixture.consolidator();
+    assert_eq!(
+        consolidator.memory_store().list_all().expect("memories list").len(),
+        0
+    );
+
+    consolidator
+        .on_task_complete(
+            "workspace-main",
+            &task_id("task-no-mutate"),
+            EpisodeOutcome::Success,
+        )
+        .expect("task consolidates");
+
+    assert_eq!(
