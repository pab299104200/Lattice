+            let mut consolidator = match consolidator.lock() {
+                Ok(guard) => guard,
+                Err(_) => {
+                    tracing::warn!("session consolidation lock was poisoned");
+                    return;
+                }
+            };
+            if let Err(error) = consolidator.on_task_complete(
