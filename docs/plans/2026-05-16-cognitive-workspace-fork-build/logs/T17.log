+
+    let bootstrapped = Bootstrap::load(&second, &fixture.reopen_store()).expect("fallback loads");
+    assert_eq!(bootstrapped.snapshot.up_to_event_id, 1);
+    assert_eq!(bootstrapped.replayed_event_rows, 1);
