    graph
        .all_nodes()
        .into_iter()
        .find(|node| node.file == file && (node.name == symbol || node.name.ends_with(symbol)))
        .map(|node| node.line)
        .unwrap_or_else(|| panic!("Benchmark symbol {} not found in {}", symbol, file))
}

