+struct CorruptionFixture {
+    tempdir: TempDir,
+    db_path: PathBuf,
+}
+
+impl CorruptionFixture {
+    fn new() -> Self {
+        let tempdir = TempDir::new().expect("tempdir creates");
+        let db_path = tempdir.path().join("events.db");
+        Self { tempdir, db_path }
+    }
+
+    fn db_path(&self) -> &Path {
+        &self.db_path
+    }
