+async fn dispatch_error_tail_includes_tool_called_and_failed_result_events() {
+    let fixture = CaptureFixture::new("error-tail");
+    let _ = RequestHandler::handle(
+        &fixture.handler,
+        "tools/call",
+        json!({"name": "prepare_change", "arguments": {}}),
