+            .query_events_by_task("task-hash", 1)
+            .expect("task rows load")[0]
+            .payload_hash
+            .clone();
+        drop(writer);
+        drop(store);
+        flip_first_occurrence(fixture.db_path(), &hash);
+    }
+
+    let error = fixture
+        .reopen_reader()
+        .execute(
+            EventQuery::new()
