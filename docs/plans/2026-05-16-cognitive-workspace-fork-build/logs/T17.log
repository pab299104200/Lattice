diff --git a/daemon/crates/lattice-core/src/events/replay_tests.rs b/daemon/crates/lattice-core/src/events/replay_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f5679c8d1404cb77e2965e0b3ad75835fec2a4c0
