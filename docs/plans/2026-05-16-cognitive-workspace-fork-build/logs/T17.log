+    assert_eq!(bootstrapped.snapshot.up_to_event_id, 1);
+    assert_eq!(bootstrapped.replayed_event_rows, 1);
+}
+
+#[test]
+fn events_table_update_fails_with_append_only_trigger_error() {
+    let fixture = CorruptionFixture::new();
