+        source_query: None,
+        created_at: 1,
+        last_accessed: 1,
+        access_count: 0,
+        is_stale: false,
+        stale_reason: None,
+    }
+}
+
+fn symbol_id(file: &str, name: &str, byte_offset: usize) -> SymbolId {
+    SymbolId {
+        file: file.to_string(),
+        name: name.to_string(),
+        byte_offset,
+    }
+}
