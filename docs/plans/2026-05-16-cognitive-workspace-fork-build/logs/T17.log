    let mut envelope = base_envelope(EventPayload::AssistantTaskStarted(
        AssistantTaskStartedPayload {
            context_handle_id: None,
            seed_event_ids: Vec::new(),
            initial_memory_ids: Vec::new(),
            objective: "x".repeat(5000),
