+            "UPDATE events SET payload_hash = ?1 WHERE task_id = ?2",
+            params![vec![1_u8; 32], "task-trigger"],
+        )
+        .expect_err("append-only trigger rejects update")
+    });
+
+    assert!(error.to_string().contains("append-only"));
+}
