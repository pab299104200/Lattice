+    graph.add_node(
+        left.clone(),
+        SymbolKind::Function,
+        "main".to_string(),
+        "fn main()".to_string(),
+        "fn main() { helper(); }".to_string(),
+        "src/main.rs".to_string(),
+        1,
+        3,
+        true,
+        Language::Rust,
+    );
+    graph.add_node(
+        right.clone(),
+        SymbolKind::Function,
+        "helper".to_string(),
+        "fn helper()".to_string(),
+        "fn helper() {}".to_string(),
+        "src/lib.rs".to_string(),
+        1,
+        1,
+        false,
+        Language::Rust,
+    );
+    graph.add_edge(&left, &right, EdgeKind::Calls);
+    graph
+}
