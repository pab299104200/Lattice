-         SET decision = ?1, decided_at = ?2, decided_by = ?3
-         WHERE proposal_id = ?4 AND decision = 'pending'",
+         SET decision = ?1, decided_at = ?2, decided_by = ?3, decision_reason = ?4
+         WHERE proposal_id = ?5 AND decision = 'pending'",
         params![
