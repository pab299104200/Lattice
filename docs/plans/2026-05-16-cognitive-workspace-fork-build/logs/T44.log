+        .unwrap();
+
+    assert_eq!(proposal_decision(&fixture.db_path, "proposal-branch"), "applied");
+    assert_eq!(fixture.memory_store.list_all().unwrap().len(), 1);
+}
+
+#[test]
+fn repo_scope_proposal_is_gated_and_stays_pending() {
+    let fixture = Fixture::new();
