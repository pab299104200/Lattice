        scope: MemoryScope,
        linked_files: Option<&[String]>,
        workspace_id: Option<&str>,
        branch: Option<&str>,
        refresh_key: Option<&str>,
    ) -> Result<(), LatticeError> {
        record_direct_write();
        let freshness_policy = MemoryFreshnessPolicy::from_scope(&scope);
        let updated = if let Some(linked_files) = linked_files {
