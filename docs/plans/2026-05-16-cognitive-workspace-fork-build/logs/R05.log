{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LwafPgkK4mkrXVE5uqeCDZ","type":"tool_result","content":"1\tuse std::collections::BTreeMap;\n2\tuse std::fs;\n3\tuse std::path::{Path, PathBuf};\n4\tuse std::process::Command;\n5\tuse std::sync::{Mutex, OnceLock};\n6\tuse std::time::{Instant, SystemTime, UNIX_EPOCH};\n7\t\n8\tuse criterion::{black_box, criterion_group, criterion_main, Criterion};\n9\tuse lattice_core::graph::CodeGraph;\n10\tuse lattice_core::indexer::Indexer;\n11\tuse lattice_core::intelligence::{\n12\t    diagnose_failure, expand_context, find_relevant_tests, impact_from_diff, prepare_change,\n13\t    BundleMode, ExpandContextSeed, ExpandedContext, FailureDiagnosis, ProjectRule, RulesDetector,\n14\t    TaskBundle, TestSelectionReport,\n15\t};\n16\tuse lattice_core::query::{ContextCapsule, QueryEngine};\n17\tuse lattice_core::symbols::stable_file_handle;\n18\tuse serde::Serialize;\n19\t\n20\tconst PREPARE_QUERY: &str = \"fix login session creation and audit trail\";\n21\tconst CONTEXT_QUERY: &str = \"understand the login session creation flow\";\n22\tconst SEARCH_PATTERN: &str = \"login\";\n23\tconst DIFF_TEXT: &str = \"\\\n24\tdiff --git a/src/auth.ts b/src/auth.ts\n25\t--- a/src/auth.ts\n26\t+++ b/src/auth.ts\n27\t@@ -6,8 +6,10 @@ export async function loginUser(\n28\t-  const session = createSession(email);\n29\t-  recordLogin(email);\n30\t+  const session = createSession(email, \\\"password\\\");\n31\t+  recordLogin(email);\n32\t+  incrementLoginMetric(email);\n33\t   return session;\n34\t }\n35\t\";\n36\tconst FAILURE_INPUT: &str = \"\\\n37\tAssertionError: expected session strategy to be password\n38\t  at tests/auth.test.ts:10\n39\t  at src/auth.ts:8\n40\t\";\n41\tconst SAMPLE_COUNT: usize = 96;\n42\tconst WARM_UP_COUNT: usize = 8;\n43\t\n44\tstatic FIXTURE: OnceLock<BenchmarkFixture> = OnceLock::new();\n45\tstatic METRICS: OnceLock<Mutex<BTreeMap<String, BaselineMetric>>> = OnceLock::new();\n46\t\n47\t#[derive(Clone)]\n48\tstruct BenchmarkFixture {\n49\t    graph: CodeGraph,\n50\t    rules: Vec<ProjectRule>,\n51\t    expand_seed: ExpandContextSeed,\n52\t}\n53\t\n54\t#[derive(Clone, Serialize)]\n55\tstruct SearchSymbolMatch {\n56\t    symbol: String,\n57\t    file: String,\n58\t    line: usize,\n59\t}\n60\t\n61\t#[derive(Clone, Serialize)]\n62\tstruct SearchSymbolsReport {\n63\t    pattern: String,\n64\t    results: Vec<SearchSymbolMatch>,\n65\t    count: usize,\n66\t}\n67\t\n68\t#[derive(Clone, Serialize)]\n69\tstruct BaselineMetric {\n70\t    name: String,\n71\t    p50_us: u64,\n72\t    p95_us: u64,\n73\t    p99_us: u64,\n74\t    bytes_returned: usize,\n75\t    candidate_count: usize,\n76\t    commit_sha: String,\n77\t    recorded_at: String,\n78\t}\n79\t\n80\tfn fixture() -> &'static BenchmarkFixture {\n81\t    FIXTURE.get_or_init(build_fixture)\n82\t}\n83\t\n84\tfn build_fixture() -> BenchmarkFixture {\n85\t    let workspace_root = fixture_workspace_root();\n86\t    materialize_fixture_workspace(&workspace_root);\n87\t\n88\t    let runtime = tokio::runtime::Runtime::new().expect(\"benchmark runtime\");\n89\t    let mut indexer = Indexer::new(workspace_root.clone());\n90\t    runtime\n91\t        .block_on(indexer.index_directory_parallel(&workspace_root))\n92\t        .expect(\"fixture indexing\");\n93\t\n94\t    let graph = indexer.graph().clone();\n95\t    let rules = detect_rules(&graph);\n96\t    let expand_seed = build_expand_seed(&graph);\n97\t    BenchmarkFixture {\n98\t        graph,\n99\t        rules,\n100\t        expand_seed,\n101\t    }\n102\t}\n103\t\n104\tfn fixture_workspace_root() -> PathBuf {\n105\t    let root = std::env::temp_dir().join(\"lattice-baseline-workflows-fixture\");\n106\t    if root.exists() {\n107\t        fs::remove_dir_all(&root).expect(\"remove old fixture workspace\");\n108\t    }\n109\t    fs::create_dir_all(&root).expect(\"create fixture workspace\");\n110\t    root\n111\t}\n112\t\n113\tfn materialize_fixture_workspace(root: &Path) {\n114\t    for (relative_path, content) in fixture_files() {\n115\t        let path = root.join(relative_path);\n116\t        if let Some(parent) = path.parent() {\n117\t            fs::create_dir_all(parent).expect(\"create fixture parent directory\");\n118\t        }\n119\t        fs::write(path, content).expect(\"write fixture file\");\n120\t    }\n121\t}\n122\t\n123\tfn fixture_files() -> Vec<(&'static str, &'static str)> {\n124\t    vec![\n125\t        (\n126\t            \"src/auth.ts\",\n127\t            \"import { verifyPassword } from './security/password';\\n\\\n128\timport { createSession } from './session';\\n\\\n129\timport { recordLogin } from './audit';\\n\\\n130\timport { incrementLoginMetric } from './metrics';\\n\\\n131\t\\n\\\n132\texport async function loginUser(email: string, password: string) {\\n\\\n133\t  verifyPassword(password);\\n\\\n134\t  const session = createSession(email, 'password');\\n\\\n135\t  recordLogin(email);\\n\\\n136\t  incrementLoginMetric(email);\\n\\\n137\t  return session;\\n\\\n138\t}\\n\",\n139\t        ),\n140\t        (\n141\t            \"src/session.ts\",\n142\t            \"export interface Session {\\n\\\n143\t  user: string;\\n\\\n144\t  strategy: string;\\n\\\n145\t}\\n\\\n146\t\\n\\\n147\texport function createSession(user: string, strategy: string): Session {\\n\\\n148\t  return { user, strategy };\\n\\\n149\t}\\n\",\n150\t        ),\n151\t        (\n152\t            \"src/routes/auth.ts\",\n153\t            \"import { loginUser } from '../auth';\\n\\\n154\t\\n\\\n155\texport async function loginRoute(request: { email: string; password: string }) {\\n\\\n156\t  return loginUser(request.email, request.password);\\n\\\n157\t}\\n\",\n158\t        ),\n159\t        (\n160\t            \"src/security/password.ts\",\n161\t            \"export function verifyPassword(password: string): void {\\n\\\n162\t  if (password.length < 8) {\\n\\\n163\t    throw new Error('Password too short');\\n\\\n164\t  }\\n\\\n165\t}\\n\",\n166\t        ),\n167\t        (\n168\t            \"src/audit.ts\",\n169\t            \"export function recordLogin(email: string): string {\\n\\\n170\t  return `login:${email}`;\\n\\\n171\t}\\n\",\n172\t        ),\n173\t        (\n174\t            \"src/metrics.ts\",\n175\t            \"export function incrementLoginMetric(metricKey: string): string {\\n\\\n176\t  return `metric:${metricKey}`;\\n\\\n177\t}\\n\",\n178\t        ),\n179\t        (\n180\t            \"tests/auth.test.ts\",\n181\t            \"import { loginUser } from '../src/auth';\\n\\\n182\t\\n\\\n183\ttest('loginUser returns a password session', async () => {\\n\\\n184\t  const session = await loginUser('alice@example.com', 'supersecret');\\n\\\n185\t  expect(session.strategy).toBe('password');\\n\\\n186\t});\\n\",\n187\t        ),\n188\t        (\n189\t            \"tests/session.test.ts\",\n190\t            \"import { createSession } from '../src/session';\\n\\\n191\t\\n\\\n192\ttest('createSession captures the strategy', () => {\\n\\\n193\t  expect(createSession('alice@example.com', 'password').strategy).toBe('password');\\n\\\n194\t});\\n\",\n195\t        ),\n196\t        (\n197\t            \"docs/auth.md\",\n198\t            \"# Auth Flow\\n\\n\\\n199\tThe login route calls `loginUser`, which validates the password,\\n\\\n200\tcreates a session, records an audit event, and increments login metrics.\\n\",\n201\t        ),\n202\t        (\n203\t            \"docs/session.md\",\n204\t            \"# Session Lifecycle\\n\\n\\\n205\t`createSession` stores the user identifier and the selected strategy.\\n\",\n206\t        ),\n207\t    ]\n208\t}\n209\t\n210\tfn detect_rules(graph: &CodeGraph) -> Vec<ProjectRule> {\n211\t    let mut files: Vec<String> = graph\n212\t        .all_nodes()\n213\t        .into_iter()\n214\t        .map(|node| node.file.clone())\n215\t        .collect();\n216\t    files.sort();\n217\t    files.dedup();\n218\t    RulesDetector::new().detect_rules(&files)\n219\t}\n220\t\n221\tfn build_expand_seed(graph: &CodeGraph) -> ExpandContextSeed {\n222\t    let capsule = context_capsule(graph, CONTEXT_QUERY);\n223\t    let primary = capsule\n224\t        .pivots\n225\t        .first()\n226\t        .map(|item| (item.file.clone(), item.symbol.clone(), item.line))\n227\t        .or_else(|| {\n228\t            capsule\n229\t                .context\n230\t                .first()\n231\t                .map(|item| (item.file.clone(), item.symbol.clone(), item.line))\n232\t        })\n233\t        .expect(\"expected a symbol for expand_context fixture\");\n234\t    let stable_symbol = graph\n235\t        .all_nodes()\n236\t        .into_iter()\n237\t        .find(|node| node.file == primary.0 && node.name == primary.1 && node.line == primary.2)\n238\t        .map(|node| node.id.stable_handle())\n239\t        .expect(\"expected stable symbol handle\");\n240\t    ExpandContextSeed {\n241\t        query: Some(CONTEXT_QUERY.to_string()),\n242\t        files: vec![\n243\t            stable_file_handle(&primary.0),\n244\t            primary.0.clone(),\n245\t            \"src/session.ts\".to_string(),\n246\t            stable_file_handle(\"src/session.ts\"),\n247\t        ],\n248\t        symbols: vec![\n249\t            stable_symbol,\n250\t            primary.1.clone(),\n251\t            \"createSession\".to_string(),\n252\t        ],\n253\t        tests: vec![\"tests/auth.test.ts\".to_string()],\n254\t        memories: Vec::new(),\n255\t    }\n256\t}\n257\t\n258\tfn context_capsule(graph: &CodeGraph, query: &str) -> ContextCapsule {\n259\t    let mut engine = QueryEngine::new(graph.clone(), None, None);\n260\t    engine.query(query, None, false)\n261\t}\n262\t\n263\tfn prepare_change_report(fixture: &BenchmarkFixture) -> TaskBundle {\n264\t    let capsule = context_capsule(&fixture.graph, PREPARE_QUERY);\n265\t    prepare_change(\n266\t        &fixture.graph,\n267\t        &capsule,\n268\t        &[],\n269\t        &[],\n270\t        &fixture.rules,\n271\t        BundleMode::Compact,\n272\t    )\n273\t}\n274\t\n275\tfn expand_context_report(fixture: &BenchmarkFixture) -> ExpandedContext {\n276\t    let focus = fixture\n277\t        .expand_seed\n278\t        .symbols\n279\t        .first()\n280\t        .expect(\"expand seed symbol\")\n281\t        .clone();\n282\t    expand_context(&fixture.graph, &fixture.expand_seed, &focus, 1200)\n283\t}\n284\t\n285\tfn impact_from_diff_report(\n286\t    fixture: &BenchmarkFixture,\n287\t) -> lattice_core::intelligence::DiffImpactReport {\n288\t    impact_from_diff(\n289\t        &fixture.graph,\n290\t        DIFF_TEXT,\n291\t        &[],\n292\t        &[],\n293\t        &fixture.rules,\n294\t        BundleMode::Compact,\n295\t        2,\n296\t    )\n297\t}\n298\t\n299\tfn diagnose_failure_report(fixture: &BenchmarkFixture) -> FailureDiagnosis {\n300\t    diagnose_failure(\n301\t        &fixture.graph,\n302\t        FAILURE_INPUT,\n303\t        Some(\"test\"),\n304\t        &fixture.rules,\n305\t        BundleMode::Compact,\n306\t    )\n307\t}\n308\t\n309\tfn find_relevant_tests_report(fixture: &BenchmarkFixture) -> TestSelectionReport {\n310\t    find_relevant_tests(\n311\t        &fixture.graph,\n312\t        &[\"src/auth.ts\".to_string(), \"src/session.ts\".to_string()],\n313\t        &[\"loginUser\".to_string(), \"createSession\".to_string()],\n314\t        None,\n315\t        &fixture.rules,\n316\t        8,\n317\t    )\n318\t}\n319\t\n320\tfn search_symbols_report(fixture: &BenchmarkFixture) -> SearchSymbolsReport {\n321\t    let pattern = SEARCH_PATTERN.to_lowercase();\n322\t    let mut results: Vec<SearchSymbolMatch> = fixture\n323\t        .graph\n324\t        .all_nodes()\n325\t        .into_iter()\n326\t        .filter(|node| node.name.to_lowercase().contains(&pattern))\n327\t        .map(|node| SearchSymbolMatch {\n328\t            symbol: node.name.clone(),\n329\t            file: node.file.clone(),\n330\t            line: node.line,\n331\t        })\n332\t        .collect();\n333\t    results.truncate(20);\n334\t    SearchSymbolsReport {\n335\t        pattern: SEARCH_PATTERN.to_string(),\n336\t        count: results.len(),\n337\t        results,\n338\t    }\n339\t}\n340\t\n341\tfn register_report_benchmark<T, F, C>(c: &mut Criterion, name: &'static str, run: F, count: C)\n342\twhere\n343\t    T: Serialize,\n344\t    F: Fn() -> T + Copy,\n345\t    C: Fn(&T) -> usize + Copy,\n346\t{\n347\t    store_metric(measure_report(name, run, count));\n348\t    c.bench_function(name, |b| b.iter(|| black_box(run())));\n349\t}\n350\t\n351\tfn measure_report<T, F, C>(name: &str, run: F, count: C) -> BaselineMetric\n352\twhere\n353\t    T: Serialize,\n354\t    F: Fn() -> T,\n355\t    C: Fn(&T) -> usize,\n356\t{\n357\t    warm_up(&run);\n358\t    let samples = collect_samples(&run);\n359\t    let report = run();\n360\t    let bytes_returned = serde_json::to_vec(&report)\n361\t        .expect(\"serialize benchmark report\")\n362\t        .len();\n363\t    BaselineMetric {\n364\t        name: name.to_string(),\n365\t        p50_us: percentile_us(&samples, 0.50),\n366\t        p95_us: percentile_us(&samples, 0.95),\n367\t        p99_us: percentile_us(&samples, 0.99),\n368\t        bytes_returned,\n369\t        candidate_count: count(&report),\n370\t        commit_sha: git_commit_sha(),\n371\t        recorded_at: recorded_at(),\n372\t    }\n373\t}\n374\t\n375\tfn warm_up<T, F>(run: &F)\n376\twhere\n377\t    F: Fn() -> T,\n378\t{\n379\t    for _ in 0..WARM_UP_COUNT {\n380\t        black_box(run());\n381\t    }\n382\t}\n383\t\n384\tfn collect_samples<T, F>(run: &F) -> Vec<u64>\n385\twhere\n386\t    F: Fn() -> T,\n387\t{\n388\t    let mut samples = Vec::with_capacity(SAMPLE_COUNT);\n389\t    for _ in 0..SAMPLE_COUNT {\n390\t        let started_at = Instant::now();\n391\t        black_box(run());\n392\t        samples.push(elapsed_us(started_at));\n393\t    }\n394\t    samples.sort_unstable();\n395\t    samples\n396\t}\n397\t\n398\tfn elapsed_us(started_at: Instant) -> u64 {\n399\t    let nanos = started_at.elapsed().as_nanos();\n400\t    ((nanos + 999) / 1_000) as u64\n401\t}\n402\t\n403\tfn percentile_us(samples: &[u64], percentile: f64) -> u64 {\n404\t    let max_index = samples.len().saturating_sub(1);\n405\t    let index = ((max_index as f64) * percentile).round() as usize;\n406\t    samples.get(index).copied().unwrap_or(0)\n407\t}\n408\t\n409\tfn store_metric(metric: BaselineMetric) {\n410\t    let metrics = METRICS.get_or_init(|| Mutex::new(BTreeMap::new()));\n411\t    let mut guard = metrics.lock().expect(\"baseline metrics lock\");\n412\t    guard.insert(metric.name.clone(), metric);\n413\t    write_metrics_snapshot(&guard);\n414\t}\n415\t\n416\tfn write_metrics_snapshot(metrics: &BTreeMap<String, BaselineMetric>) {\n417\t    let snapshot: Vec<&BaselineMetric> = metrics.values().collect();\n418\t    let output_path = benchmark_root().join(\n419\t        \"docs/plans/2026-05-16-cognitive-workspace-fork-build/baselines/baseline_metrics.json\",\n420\t    );\n421\t    if let Some(parent) = output_path.parent() {\n422\t        fs::create_dir_all(parent).expect(\"create baseline metrics directory\");\n423\t    }\n424\t    let body = serde_json::to_string_pretty(&snapshot).expect(\"serialize metrics snapshot\");\n425\t    let payload = format!(\"{body}\\n\");\n426\t    if let Err(error) = fs::write(&output_path, &payload) {\n427\t        let shadow_path = shadow_metrics_path();\n428\t        if let Some(parent) = shadow_path.parent() {\n429\t            fs::create_dir_all(parent).expect(\"create shadow metrics directory\");\n430\t        }\n431\t        fs::write(&shadow_path, payload).unwrap_or_else(|shadow_error| {\n432\t            panic!(\n433\t                \"write baseline metrics snapshot to {} failed with {}; shadow write to {} also failed with {}\",\n434\t                output_path.display(),\n435\t                error,\n436\t                shadow_path.display(),\n437\t                shadow_error\n438\t            )\n439\t        });\n440\t        eprintln!(\n441\t            \"Baseline metrics repo write failed for {}; wrote shadow snapshot to {} instead: {}\",\n442\t            output_path.display(),\n443\t            shadow_path.display(),\n444\t            error\n445\t        );\n446\t    }\n447\t}\n448\t\n449\tfn benchmark_root() -> PathBuf {\n450\t    if let Ok(pwd) = std::env::var(\"PWD\") {\n451\t        let candidate = PathBuf::from(pwd);\n452\t        if let Some(parent) = candidate.parent() {\n453\t            let repo_root = parent.to_path_buf();\n454\t            if repo_root.join(\"docs\").is_dir() && repo_root.join(\"daemon\").is_dir() {\n455\t                return repo_root;\n456\t            }\n457\t        }\n458\t    }\n459\t\n460\t    if let Ok(current_dir) = std::env::current_dir() {\n461\t        if let Some(parent) = current_dir.parent() {\n462\t            let candidate = parent.to_path_buf();\n463\t            if candidate.join(\"docs\").is_dir() && candidate.join(\"daemon\").is_dir() {\n464\t                return candidate;\n465\t            }\n466\t        }\n467\t    }\n468\t\n469\t    let manifest_dir = Path::new(env!(\"CARGO_MANIFEST_DIR\"));\n470\t    manifest_dir\n471\t        .parent()\n472\t        .and_then(Path::parent)\n473\t        .and_then(Path::parent)\n474\t        .expect(\"repo root from manifest dir\")\n475\t        .to_path_buf()\n476\t}\n477\t\n478\tfn git_commit_sha() -> String {\n479\t    let output = Command::new(\"git\")\n480\t        .arg(\"rev-parse\")\n481\t        .arg(\"HEAD\")\n482\t        .current_dir(benchmark_root())\n483\t        .output()\n484\t        .expect(\"run git rev-parse HEAD\");\n485\t    String::from_utf8_lossy(&output.stdout).trim().to_string()\n486\t}\n487\t\n488\tfn recorded_at() -> String {\n489\t    let unix_seconds = SystemTime::now()\n490\t        .duration_since(UNIX_EPOCH)\n491\t        .expect(\"system clock before unix epoch\")\n492\t        .as_secs();\n493\t    unix_seconds.to_string()\n494\t}\n495\t\n496\tfn shadow_metrics_path() -> PathBuf {\n497\t    std::env::temp_dir()\n498\t        .join(\"lattice-benchmarks\")\n499\t        .join(\"baseline_metrics.json\")\n500\t}\n501\t\n502\tfn bench_prepare_change(c: &mut Criterion) {\n503\t    let fixture = fixture();\n504\t    register_report_benchmark(\n505\t        c,\n506\t        \"prepare_change\",\n507\t        || prepare_change_report(fixture),\n508\t        |report| {\n509\t            report.primary_files.len()\n510\t                + report.secondary_files.len()\n511\t                + report.symbols.len()\n512\t                + report.tests.len()\n513\t        },\n514\t    );\n515\t}\n516\t\n517\tfn bench_get_context_capsule(c: &mut Criterion) {\n518\t    let fixture = fixture();\n519\t    register_report_benchmark(\n520\t        c,\n521\t        \"get_context_capsule\",\n522\t        || context_capsule(&fixture.graph, CONTEXT_QUERY),\n523\t        |report| report.pivots.len() + report.context.len(),\n524\t    );\n525\t}\n526\t\n527\tfn bench_expand_context(c: &mut Criterion) {\n528\t    let fixture = fixture();\n529\t    register_report_benchmark(\n530\t        c,\n531\t        \"expand_context\",\n532\t        || expand_context_report(fixture),\n533\t        |report| {\n534\t            report.files.len() + report.symbols.len() + report.tests.len() + report.memories.len()\n535\t        },\n536\t    );\n537\t}\n538\t\n539\tfn bench_impact_from_diff(c: &mut Criterion) {\n540\t    let fixture = fixture();\n541\t    register_report_benchmark(\n542\t        c,\n543\t        \"impact_from_diff\",\n544\t        || impact_from_diff_report(fixture),\n545\t        |report| {\n546\t            report.changed_files.len()\n547\t                + report.changed_symbols.len()\n548\t                + report.affected_symbols.len()\n549\t                + report.tests.len()\n550\t        },\n551\t    );\n552\t}\n553\t\n554\tfn bench_diagnose_failure(c: &mut Criterion) {\n555\t    let fixture = fixture();\n556\t    register_report_benchmark(\n557\t        c,\n558\t        \"diagnose_failure\",\n559\t        || diagnose_failure_report(fixture),\n560\t        |report| report.suspects.len() + report.related_symbols.len() + report.tests.len(),\n561\t    );\n562\t}\n563\t\n564\tfn bench_search_symbols(c: &mut Criterion) {\n565\t    let fixture = fixture();\n566\t    register_report_benchmark(\n567\t        c,\n568\t        \"search_symbols\",\n569\t        || search_symbols_report(fixture),\n570\t        |report| report.results.len(),\n571\t    );\n572\t}\n573\t\n574\tfn bench_find_relevant_tests(c: &mut Criterion) {\n575\t    let fixture = fixture();\n576\t    register_report_benchmark(\n577\t        c,\n578\t        \"find_relevant_tests\",\n579\t        || find_relevant_tests_report(fixture),\n580\t        |report| report.tests.len(),\n581\t    );\n582\t}\n583\t\n584\tcriterion_group!(\n585\t    baseline_workflows,\n586\t    bench_prepare_change,\n587\t    bench_get_context_capsule,\n588\t    bench_expand_context,\n589\t    bench_impact_from_diff,\n590\t    bench_diagnose_failure,\n591\t    bench_search_symbols,\n592\t    bench_find_relevant_tests\n593\t);\n594\tcriterion_main!(baseline_workflows);\n595\t"}]},"parent_tool_use_id":null,"session_id":"4cb46183-2e7c-4dbc-b888-4ae03f7bba08","uuid":"a069e5dd-95b9-4157-99e7-026079443bb8","timestamp":"2026-05-17T03:28:09.588Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/benches/baseline_workflows.rs","content":"use std::collections::BTreeMap;\nuse std::fs;\nuse std::path::{Path, PathBuf};\nuse std::process::Command;\nuse std::sync::{Mutex, OnceLock};\nuse std::time::{Instant, SystemTime, UNIX_EPOCH};\n\nuse criterion::{black_box, criterion_group, criterion_main, Criterion};\nuse lattice_core::graph::CodeGraph;\nuse lattice_core::indexer::Indexer;\nuse lattice_core::intelligence::{\n    diagnose_failure, expand_context, find_relevant_tests, impact_from_diff, prepare_change,\n    BundleMode, ExpandContextSeed, ExpandedContext, FailureDiagnosis, ProjectRule, RulesDetector,\n    TaskBundle, TestSelectionReport,\n};\nuse lattice_core::query::{ContextCapsule, QueryEngine};\nuse lattice_core::symbols::stable_file_handle;\nuse serde::Serialize;\n\nconst PREPARE_QUERY: &str = \"fix login session creation and audit trail\";\nconst CONTEXT_QUERY: &str = \"understand the login session creation flow\";\nconst SEARCH_PATTERN: &str = \"login\";\nconst DIFF_TEXT: &str = \"\\\ndiff --git a/src/auth.ts b/src/auth.ts\n--- a/src/auth.ts\n+++ b/src/auth.ts\n@@ -6,8 +6,10 @@ export async function loginUser(\n-  const session = createSession(email);\n-  recordLogin(email);\n+  const session = createSession(email, \\\"password\\\");\n+  recordLogin(email);\n+  incrementLoginMetric(email);\n   return session;\n }\n\";\nconst FAILURE_INPUT: &str = \"\\\nAssertionError: expected session strategy to be password\n  at tests/auth.test.ts:10\n  at src/auth.ts:8\n\";\nconst SAMPLE_COUNT: usize = 96;\nconst WARM_UP_COUNT: usize = 8;\n\nstatic FIXTURE: OnceLock<BenchmarkFixture> = OnceLock::new();\nstatic METRICS: OnceLock<Mutex<BTreeMap<String, BaselineMetric>>> = OnceLock::new();\n\n#[derive(Clone)]\nstruct BenchmarkFixture {\n    graph: CodeGraph,\n    rules: Vec<ProjectRule>,\n    expand_seed: ExpandContextSeed,\n}\n\n#[derive(Clone, Serialize)]\nstruct SearchSymbolMatch {\n    symbol: String,\n    file: String,\n    line: usize,\n}\n\n#[derive(Clone, Serialize)]\nstruct SearchSymbolsReport {\n    pattern: String,\n    results: Vec<SearchSymbolMatch>,\n    count: usize,\n}\n\n#[derive(Clone, Serialize)]\nstruct BaselineMetric {\n    name: String,\n    p50_us: u64,\n    p95_us: u64,\n    p99_us: u64,\n    bytes_returned: usize,\n    candidate_count: usize,\n    commit_sha: String,\n    recorded_at: String,\n}\n\nfn fixture() -> &'static BenchmarkFixture {\n    FIXTURE.get_or_init(build_fixture)\n}\n\nfn build_fixture() -> BenchmarkFixture {\n    let workspace_root = fixture_workspace_root();\n    materialize_fixture_workspace(&workspace_root);\n\n    let runtime = tokio::runtime::Runtime::new().expect(\"benchmark runtime\");\n    let mut indexer = Indexer::new(workspace_root.clone());\n    runtime\n        .block_on(indexer.index_directory_parallel(&workspace_root))\n        .expect(\"fixture indexing\");\n\n    let graph = indexer.graph().clone();\n    let rules = detect_rules(&graph);\n    let expand_seed = build_expand_seed(&graph);\n    BenchmarkFixture {\n        graph,\n        rules,\n        expand_seed,\n    }\n}\n\nfn fixture_workspace_root() -> PathBuf {\n    let root = std::env::temp_dir().join(\"lattice-baseline-workflows-fixture\");\n    if root.exists() {\n        fs::remove_dir_all(&root).expect(\"remove old fixture workspace\");\n    }\n    fs::create_dir_all(&root).expect(\"create fixture workspace\");\n    root\n}\n\nfn materialize_fixture_workspace(root: &Path) {\n    for (relative_path, content) in fixture_files() {\n        let path = root.join(relative_path);\n        if let Some(parent) = path.parent() {\n            fs::create_dir_all(parent).expect(\"create fixture parent directory\");\n        }\n        fs::write(path, content).expect(\"write fixture file\");\n    }\n}\n\nfn fixture_files() -> Vec<(&'static str, &'static str)> {\n    vec![\n        (\n            \"src/auth.ts\",\n            \"import { verifyPassword } from './security/password';\\n\\\nimport { createSession } from './session';\\n\\\nimport { recordLogin } from './audit';\\n\\\nimport { incrementLoginMetric } from './metrics';\\n\\\n\\n\\\nexport async function loginUser(email: string, password: string) {\\n\\\n  verifyPassword(password);\\n\\\n  const session = createSession(email, 'password');\\n\\\n  recordLogin(email);\\n\\\n  incrementLoginMetric(email);\\n\\\n  return session;\\n\\\n}\\n\",\n        ),\n        (\n            \"src/session.ts\",\n            \"export interface Session {\\n\\\n  user: string;\\n\\\n  strategy: string;\\n\\\n}\\n\\\n\\n\\\nexport function createSession(user: string, strategy: string): Session {\\n\\\n  return { user, strategy };\\n\\\n}\\n\",\n        ),\n        (\n            \"src/routes/auth.ts\",\n            \"import { loginUser } from '../auth';\\n\\\n\\n\\\nexport async function loginRoute(request: { email: string; password: string }) {\\n\\\n  return loginUser(request.email, request.password);\\n\\\n}\\n\",\n        ),\n        (\n            \"src/security/password.ts\",\n            \"export function verifyPassword(password: string): void {\\n\\\n  if (password.length < 8) {\\n\\\n    throw new Error('Password too short');\\n\\\n  }\\n\\\n}\\n\",\n        ),\n        (\n            \"src/audit.ts\",\n            \"export function recordLogin(email: string): string {\\n\\\n  return `login:${email}`;\\n\\\n}\\n\",\n        ),\n        (\n            \"src/metrics.ts\",\n            \"export function incrementLoginMetric(metricKey: string): string {\\n\\\n  return `metric:${metricKey}`;\\n\\\n}\\n\",\n        ),\n        (\n            \"tests/auth.test.ts\",\n            \"import { loginUser } from '../src/auth';\\n\\\n\\n\\\ntest('loginUser returns a password session', async () => {\\n\\\n  const session = await loginUser('alice@example.com', 'supersecret');\\n\\\n  expect(session.strategy).toBe('password');\\n\\\n});\\n\",\n        ),\n        (\n            \"tests/session.test.ts\",\n            \"import { createSession } from '../src/session';\\n\\\n\\n\\\ntest('createSession captures the strategy', () => {\\n\\\n  expect(createSession('alice@example.com', 'password').strategy).toBe('password');\\n\\\n});\\n\",\n        ),\n        (\n            \"docs/auth.md\",\n            \"# Auth Flow\\n\\n\\\nThe login route calls `loginUser`, which validates the password,\\n\\\ncreates a session, records an audit event, and increments login metrics.\\n\",\n        ),\n        (\n            \"docs/session.md\",\n            \"# Session Lifecycle\\n\\n\\\n`createSession` stores the user identifier and the selected strategy.\\n\",\n        ),\n    ]\n}\n\nfn detect_rules(graph: &CodeGraph) -> Vec<ProjectRule> {\n    let mut files: Vec<String> = graph\n        .all_nodes()\n        .into_iter()\n        .map(|node| node.file.clone())\n        .collect();\n    files.sort();\n    files.dedup();\n    RulesDetector::new().detect_rules(&files)\n}\n\nfn build_expand_seed(graph: &CodeGraph) -> ExpandContextSeed {\n    let capsule = context_capsule(graph, CONTEXT_QUERY);\n    let primary = capsule\n        .pivots\n        .first()\n        .map(|item| (item.file.clone(), item.symbol.clone(), item.line))\n        .or_else(|| {\n            capsule\n                .context\n                .first()\n                .map(|item| (item.file.clone(), item.symbol.clone(), item.line))\n        })\n        .expect(\"expected a symbol for expand_context fixture\");\n    let stable_symbol = graph\n        .all_nodes()\n        .into_iter()\n        .find(|node| node.file == primary.0 && node.name == primary.1 && node.line == primary.2)\n        .map(|node| node.id.stable_handle())\n        .expect(\"expected stable symbol handle\");\n    ExpandContextSeed {\n        query: Some(CONTEXT_QUERY.to_string()),\n        files: vec![\n            stable_file_handle(&primary.0),\n            primary.0.clone(),\n            \"src/session.ts\".to_string(),\n            stable_file_handle(\"src/session.ts\"),\n        ],\n        symbols: vec![\n            stable_symbol,\n            primary.1.clone(),\n            \"createSession\".to_string(),\n        ],\n        tests: vec![\"tests/auth.test.ts\".to_string()],\n        memories: Vec::new(),\n    }\n}\n\nfn context_capsule(graph: &CodeGraph, query: &str) -> ContextCapsule {\n    let mut engine = QueryEngine::new(graph.clone(), None, None);\n    engine.query(query, None, false)\n}\n\nfn prepare_change_report(fixture: &BenchmarkFixture) -> TaskBundle {\n    let capsule = context_capsule(&fixture.graph, PREPARE_QUERY);\n    prepare_change(\n        &fixture.graph,\n        &capsule,\n        &[],\n        &[],\n        &fixture.rules,\n        BundleMode::Compact,\n    )\n}\n\nfn expand_context_report(fixture: &BenchmarkFixture) -> ExpandedContext {\n    let focus = fixture\n        .expand_seed\n        .symbols\n        .first()\n        .expect(\"expand seed symbol\")\n        .clone();\n    expand_context(&fixture.graph, &fixture.expand_seed, &focus, 1200)\n}\n\nfn impact_from_diff_report(\n    fixture: &BenchmarkFixture,\n) -> lattice_core::intelligence::DiffImpactReport {\n    impact_from_diff(\n        &fixture.graph,\n        DIFF_TEXT,\n        &[],\n        &[],\n        &fixture.rules,\n        BundleMode::Compact,\n        2,\n    )\n}\n\nfn diagnose_failure_report(fixture: &BenchmarkFixture) -> FailureDiagnosis {\n    diagnose_failure(\n        &fixture.graph,\n        FAILURE_INPUT,\n        Some(\"test\"),\n        &fixture.rules,\n        BundleMode::Compact,\n    )\n}\n\nfn find_relevant_tests_report(fixture: &BenchmarkFixture) -> TestSelectionReport {\n    find_relevant_tests(\n        &fixture.graph,\n        &[\"src/auth.ts\".to_string(), \"src/session.ts\".to_string()],\n        &[\"loginUser\".to_string(), \"createSession\".to_string()],\n        None,\n        &fixture.rules,\n        8,\n    )\n}\n\nfn search_symbols_report(fixture: &BenchmarkFixture) -> SearchSymbolsReport {\n    let pattern = SEARCH_PATTERN.to_lowercase();\n    let mut results: Vec<SearchSymbolMatch> = fixture\n        .graph\n        .all_nodes()\n        .into_iter()\n        .filter(|node| node.name.to_lowercase().contains(&pattern))\n        .map(|node| SearchSymbolMatch {\n            symbol: node.name.clone(),\n            file: node.file.clone(),\n            line: node.line,\n        })\n        .collect();\n    results.truncate(20);\n    SearchSymbolsReport {\n        pattern: SEARCH_PATTERN.to_string(),\n        count: results.len(),\n        results,\n    }\n}\n\nfn register_report_benchmark<T, F, C>(c: &mut Criterion, name: &'static str, run: F, count: C)\nwhere\n    T: Serialize,\n    F: Fn() -> T + Copy,\n    C: Fn(&T) -> usize + Copy,\n{\n    store_metric(measure_report(name, run, count));\n    c.bench_function(name, |b| b.iter(|| black_box(run())));\n}\n\nfn measure_report<T, F, C>(name: &str, run: F, count: C) -> BaselineMetric\nwhere\n    T: Serialize,\n    F: Fn() -> T,\n    C: Fn(&T) -> usize,\n{\n    warm_up(&run);\n    let samples = collect_samples(&run);\n    let report = run();\n    let bytes_returned = serde_json::to_vec(&report)\n        .expect(\"serialize benchmark report\")\n        .len();\n    BaselineMetric {\n        name: name.to_string(),\n        p50_us: percentile_us(&samples, 0.50),\n        p95_us: percentile_us(&samples, 0.95),\n        p99_us: percentile_us(&samples, 0.99),\n        bytes_returned,\n        candidate_count: count(&report),\n        commit_sha: git_commit_sha(),\n        recorded_at: recorded_at(),\n    }\n}\n\nfn warm_up<T, F>(run: &F)\nwhere\n    F: Fn() -> T,\n{\n    for _ in 0..WARM_UP_COUNT {\n        black_box(run());\n    }\n}\n\nfn collect_samples<T, F>(run: &F) -> Vec<u64>\nwhere\n    F: Fn() -> T,\n{\n    let mut samples = Vec::with_capacity(SAMPLE_COUNT);\n    for _ in 0..SAMPLE_COUNT {\n        let started_at = Instant::now();\n        black_box(run());\n        samples.push(elapsed_us(started_at));\n    }\n    samples.sort_unstable();\n    samples\n}\n\nfn elapsed_us(started_at: Instant) -> u64 {\n    let nanos = started_at.elapsed().as_nanos();\n    ((nanos + 999) / 1_000) as u64\n}\n\nfn percentile_us(samples: &[u64], percentile: f64) -> u64 {\n    let max_index = samples.len().saturating_sub(1);\n    let index = ((max_index as f64) * percentile).round() as usize;\n    samples.get(index).copied().unwrap_or(0)\n}\n\nfn store_metric(metric: BaselineMetric) {\n    let metrics = METRICS.get_or_init(|| Mutex::new(BTreeMap::new()));\n    let mut guard = metrics.lock().expect(\"baseline metrics lock\");\n    guard.insert(metric.name.clone(), metric);\n    write_metrics_snapshot(&guard);\n}\n\nfn write_metrics_snapshot(metrics: &BTreeMap<String, BaselineMetric>) {\n    let snapshot: Vec<&BaselineMetric> = metrics.values().collect();\n    let output_path = benchmark_root().join(\n        \"docs/plans/2026-05-16-cognitive-workspace-fork-build/baselines/baseline_metrics.json\",\n    );\n    if let Some(parent) = output_path.parent() {\n        fs::create_dir_all(parent).expect(\"create baseline metrics directory\");\n    }\n    let body = serde_json::to_string_pretty(&snapshot).expect(\"serialize metrics snapshot\");\n    let payload = format!(\"{body}\\n\");\n    if let Err(error) = fs::write(&output_path, &payload) {\n        let shadow_path = shadow_metrics_path();\n        if let Some(parent) = shadow_path.parent() {\n            fs::create_dir_all(parent).expect(\"create shadow metrics directory\");\n        }\n        fs::write(&shadow_path, payload).unwrap_or_else(|shadow_error| {\n            panic!(\n                \"write baseline metrics snapshot to {} failed with {}; shadow write to {} also failed with {}\",\n                output_path.display(),\n                error,\n                shadow_path.display(),\n                shadow_error\n            )\n        });\n        eprintln!(\n            \"Baseline metrics repo write failed for {}; wrote shadow snapshot to {} instead: {}\",\n            output_path.display(),\n            shadow_path.display(),\n            error\n        );\n    }\n}\n\nfn benchmark_root() -> PathBuf {\n    if let Ok(pwd) = std::env::var(\"PWD\") {\n        let candidate = PathBuf::from(pwd);\n        if let Some(parent) = candidate.parent() {\n            let repo_root = parent.to_path_buf();\n            if repo_root.join(\"docs\").is_dir() && repo_root.join(\"daemon\").is_dir() {\n                return repo_root;\n            }\n        }\n    }\n\n    if let Ok(current_dir) = std::env::current_dir() {\n        if let Some(parent) = current_dir.parent() {\n            let candidate = parent.to_path_buf();\n            if candidate.join(\"docs\").is_dir() && candidate.join(\"daemon\").is_dir() {\n                return candidate;\n            }\n        }\n    }\n\n    let manifest_dir = Path::new(env!(\"CARGO_MANIFEST_DIR\"));\n    manifest_dir\n        .parent()\n        .and_then(Path::parent)\n        .and_then(Path::parent)\n        .expect(\"repo root from manifest dir\")\n        .to_path_buf()\n}\n\nfn git_commit_sha() -> String {\n    let output = Command::new(\"git\")\n        .arg(\"rev-parse\")\n        .arg(\"HEAD\")\n        .current_dir(benchmark_root())\n        .output()\n        .expect(\"run git rev-parse HEAD\");\n    String::from_utf8_lossy(&output.stdout).trim().to_string()\n}\n\nfn recorded_at() -> String {\n    let unix_seconds = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .expect(\"system clock before unix epoch\")\n        .as_secs();\n    unix_seconds.to_string()\n}\n\nfn shadow_metrics_path() -> PathBuf {\n    std::env::temp_dir()\n        .join(\"lattice-benchmarks\")\n        .join(\"baseline_metrics.json\")\n}\n\nfn bench_prepare_change(c: &mut Criterion) {\n    let fixture = fixture();\n    register_report_benchmark(\n        c,\n        \"prepare_change\",\n        || prepare_change_report(fixture),\n        |report| {\n            report.primary_files.len()\n                + report.secondary_files.len()\n                + report.symbols.len()\n                + report.tests.len()\n        },\n    );\n}\n\nfn bench_get_context_capsule(c: &mut Criterion) {\n    let fixture = fixture();\n    register_report_benchmark(\n        c,\n        \"get_context_capsule\",\n        || context_capsule(&fixture.graph, CONTEXT_QUERY),\n        |report| report.pivots.len() + report.context.len(),\n    );\n}\n\nfn bench_expand_context(c: &mut Criterion) {\n    let fixture = fixture();\n    register_report_benchmark(\n        c,\n        \"expand_context\",\n        || expand_context_report(fixture),\n        |report| {\n            report.files.len() + report.symbols.len() + report.tests.len() + report.memories.len()\n        },\n    );\n}\n\nfn bench_impact_from_diff(c: &mut Criterion) {\n    let fixture = fixture();\n    register_report_benchmark(\n        c,\n        \"impact_from_diff\",\n        || impact_from_diff_report(fixture),\n        |report| {\n            report.changed_files.len()\n                + report.changed_symbols.len()\n                + report.affected_symbols.len()\n                + report.tests.len()\n        },\n    );\n}\n\nfn bench_diagnose_failure(c: &mut Criterion) {\n    let fixture = fixture();\n    register_report_benchmark(\n        c,\n        \"diagnose_failure\",\n        || diagnose_failure_report(fixture),\n        |report| report.suspects.len() + report.related_symbols.len() + report.tests.len(),\n    );\n}\n\nfn bench_search_symbols(c: &mut Criterion) {\n    let fixture = fixture();\n    register_report_benchmark(\n        c,\n        \"search_symbols\",\n        || search_symbols_report(fixture),\n        |report| report.results.len(),\n    );\n}\n\nfn bench_find_relevant_tests(c: &mut Criterion) {\n    let fixture = fixture();\n    register_report_benchmark(\n        c,\n        \"find_relevant_tests\",\n        || find_relevant_tests_report(fixture),\n        |report| report.tests.len(),\n    );\n}\n\ncriterion_group!(\n    baseline_workflows,\n    bench_prepare_change,\n    bench_get_context_capsule,\n    bench_expand_context,\n    bench_impact_from_diff,\n    bench_diagnose_failure,\n    bench_search_symbols,\n    bench_find_relevant_tests\n);\ncriterion_main!(baseline_workflows);\n","numLines":595,"startLine":1,"totalLines":595}}}
