+#[cfg(test)]
 mod store_tests;
 #[cfg(test)]
 mod tests;
@@ -36,6 +40,8 @@
     UserCorrectionPayload, UserPreferenceObservedPayload, WorkflowFailedPayload,
     WorkflowSucceededPayload,
 };
+pub use query::{EventQuery, EventQueryError, QueryOrder, SessionScope, TaskScope};
+pub use reader::EventReader;
