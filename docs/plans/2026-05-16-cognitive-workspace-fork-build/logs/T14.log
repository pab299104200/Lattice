+    let fixture = ReaderFixture::new();
+    fixture.append("task-a", "session-a", "workspace-a", "main", "alpha");
+    fixture.append("task-b", "session-b", "workspace-a", "dev", "beta");
+    fixture.append("task-c", "session-c", "workspace-b", "main", "gamma");
+
+    let events = fixture
