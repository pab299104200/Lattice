  let incremental = tokio::task::spawn_blocking(move || {\n136\t                    build_incremental_index_for_roots(&roots, Some(&manifest), parsed_cache)\n137\t                })\n138\t                .await\n139\t                .unwrap_or_else(|err| {\n140\t                    tracing::warn!(\"Incremental multi-repo indexing task failed: {}\", err);\n141\t                    IncrementalIndexResult::empty()\n142\t                });\n143\t\n144\t                {\n145\t                    let mut wm = wm.lock().await;\n146\t                    for root in &ws_roots_bg {\n147\t                        let repo_name = repo_name_for_root(root);\n148\t                        if let Err(e) = wm.add_repo(repo_name.clone(), root.clone()) {\n149\t                            tracing::warn!(\"Failed to add repo {}: {}\", repo_name, e);\n150\t                            continue;\n151\t                        }\n152\t                        let repo_prefix = format!(\"{}/\", repo_name);\n153\t                        let repo_files: HashMap<String, ParsedFile> = incremental\n154\t                            .parsed_files\n155\t                            .iter()\n156\t                            .filter(|(file, _)| file.starts_with(&repo_prefix))\n157\t                            .map(|(file, parsed)| (file.clone(), parsed.clone()))\n158\t                            .collect();\n159\t                        wm.replace_repo_parsed_files(&repo_name, repo_files);\n160\t                    }\n161\t                    wm.detect_cross_repo_edges();\n162\t                    tracing::info!(\"Detected {} cross-repo edges\", wm.cross_repo_edges().len());\n163\t                }\n164\t\n165\t                persist_incremental_cache(\n166\t                    &graph_store_bg,\n167\t                    &incremental.graph,\n168\t                    &incremental.file_index,\n169\t                    &incremental.parsed_files,\n170\t                )\n171\t                .await;\n172\t                tracing::info!(\n173\t                    \"Incremental multi-repo indexing: {} current files, {} parsed/updated, {} removed\",\n174\t                    incremental.file_index.len(),\n175\t                    incremental.changed_count,\n176\t                    incremental.removed_count\n177\t                );\n178\t                incremental.changed_count\n179\t            } else {\n180\t                let ws = ws_root.clone();\n181\t                let (manifest, parsed_cache) = load_incremental_cache(&graph_store_bg).await;\n182\t                let incremental = tokio::task::spawn_blocking(move || {\n183\t                    build_incremental_index_for_roots(&[ws], Some(&manifest), parsed_cache)\n184\t                })\n185\t                .await\n186\t                .unwrap_or_else(|err| {\n187\t                    tracing::warn!(\"Incremental indexing task failed: {}\", err);\n188\t                    IncrementalIndexResult::empty()\n189\t                });\n190\t\n191\t                {\n192\t                    let mut idx = indexer_bg.lock().await;\n193\t                    idx.replace_parsed_files(incremental.parsed_files.clone());\n194\t                }\n195\t\n196\t                persist_incremental_cache(\n197\t                    &graph_store_bg,\n198\t                    &incremental.graph,\n199\t                    &incremental.file_index,\n200\t                    &incremental.parsed_files,\n201\t                )\n202\t                .await;\n203\t                tracing::info!(\n204\t                    \"Incremental indexing: {} current files, {} parsed/updated, {} removed\",\n205\t                    incremental.file_index.len(),\n206\t                    incremental.changed_count,\n207\t                    incremental.removed_count\n208\t                );\n209\t                incremental.changed_count\n210\t            };\n211\t            tracing::info!(\"Indexed {} files total\", files_indexed);\n212\t\n213\t            // Final save to graph store\n214\t            {\n215\t                let new_graph = if let Some(wm) = &ws_manager_bg {\n216\t                    let wm = wm.lock().await;\n217\t                    wm.unified_graph()\n218\t                } else {\n219\t                    let idx = indexer_bg.lock().await;\n220\t                    idx.graph().clone()\n221\t                };\n222\t\n223\t                let stats = new_graph.stats();\n224\t                tracing::info!(\n225\t                    \"Graph ready: {} nodes, {} edges, {} files\",\n226\t                    stats.node_count,\n227\t                    stats.edge_count,\n228\t                    stats.file_count\n229\t                );\n230\t\n231\t                {\n232\t                    let gs = graph_store_bg.lock().await;\n233\t                    if let Err(e) = gs.save_graph(&new_graph) {\n234\t                        tracing::warn!(\"Failed to save graph: {}\", e);\n235\t                    }\n236\t                }\n237\t\n238\t                let mut eng = engine_bg.lock().await;\n239\t                eng.update_graph(new_graph);\n240\t            }\n241\t\n242\t            // Try to load ONNX embedding model\n243\t            let model_path = lattice_dir_bg.join(\"models\").join(\"model.onnx\");\n244\t            if model_path.exists() {\n245\t                match EmbeddingEngine::new(model_path.to_string_lossy().as_ref()) {\n246\t                    Ok(emb_engine) => {\n247\t                        tracing::info!(\"ONNX embedding model loaded\");\n248\t                        let emb = Arc::new(emb_engine);\n249\t                        let _ = embedding_engine_bg.set(Arc::clone(&emb));"}]},"parent_tool_use_id":"toolu_01RDjDdnJFRiz86tbrxskniG","session_id":"88204e0b-a61b-4ed7-ba98-4fcc53be0768","uuid":"48dd3b84-5f31-4063-a942-e88519fed8ec","timestamp":"2026-05-17T02:18:21.648Z","subagent_type":"Explore","task_description":"Explore daemon architecture"}
docs/plans/2026-05-16-cognitive-workspace-fork-build/logs/00-decompose.log:90:{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q1o8EpLjrUYmMgYGNDMSoi","type":"tool_result","content":"1\timport * as vscode from 'vscode';\n2\timport * as cp from 'child_process';\n3\timport { DaemonManager } from './daemon';\n4\timport { StatusBarProvider } from './statusbar';\n5\timport { LatticeCodeLensProvider } from './codelens';\n6\timport { LatticeHoverProvider } from './hover';\n7\timport { LatticeSidebarProvider } from './sidebar';\n8\timport {\n9\t    DocsTargetSelection,\n10\t    LatticeDocsWorkbench,\n11\t    normalizeDocsTargetSelection,\n12\t} from './docsWorkbench';\n13\t\n14\tlet daemon: DaemonManager | undefined;\n15\tlet lastContextHandle: string | undefined;\n16\tlet lastContextOrigin: string | undefined;\n17\t\n18\tinterface McpToolContentItem {\n19\t    type?: string;\n20\t    text?: string;\n21\t}\n22\t\n23\tinterface McpToolResponse {\n24\t    content?: McpToolContentItem[];\n25\t}\n26\t\n27\tinterface DaemonStatusSnapshot {\n28\t    status?: string;\n29\t    nodes?: number;\n30\t    node_count?: number;\n31\t    files?: number;\n32\t    file_count?: number;\n33\t    edges?: number;\n34\t    edge_count?: number;\n35\t}\n36\t\n37\tinterface GitChangedFiles {\n38\t    files: string[];\n39\t    source: string;\n40\t}\n41\t\n42\texport async function activate(context: vscode.ExtensionContext) {\n43\t    console.log('Lattice extension activating...');\n44\t\n45\t    // Create daemon manager\n46\t    daemon = new DaemonManager(context.extensionPath);\n47\t    context.subscriptions.push(daemon);\n48\t\n49\t    // Create UI providers (before daemon starts so they can receive status updates)\n50\t    const statusBar = new StatusBarProvider(daemon);\n51\t    context.subscriptions.push(statusBar);\n52\t\n53\t    const sidebarProvider = new LatticeSidebarProvider(daemon);\n54\t    const sidebarRegistration = vscode.window.registerWebviewViewProvider(\n55\t        LatticeSidebarProvider.viewType,\n56\t        sidebarProvider\n57\t    );\n58\t    context.subscriptions.push(sidebarProvider, sidebarRegistration);\n59\t\n60\t    const docsWorkbench = new LatticeDocsWorkbench(daemon);\n61\t    context.subscriptions.push(docsWorkbench);\n62\t\n63\t    let statsPollTimer: ReturnType<typeof setInterval> | undefined;\n64\t    const applyStatsSnapshot = (result: DaemonStatusSnapshot): void => {\n65\t        const nodes = result.nodes ?? result.node_count ?? 0;\n66\t        const files = result.files ?? result.file_count ?? 0;\n67\t        const edges = result.edges ?? result.edge_count ?? 0;\n68\t        sidebarProvider.updateStats({ nodes, files, edges });\n69\t        statusBar.updateNodeCount(nodes);\n70\t    };\n71\t    const syncStatsFromDaemon = async (shouldLog = false): Promise<void> => {\n72\t        if (!daemon || daemon.getStatus() !== 'running') {\n73\t            return;\n74\t        }\n75\t\n76\t        try {\n77\t            const result = await daemon.sendRequest('lattice/status') as DaemonStatusSnapshot;\n78\t            applyStatsSnapshot(result);\n79\t            if (shouldLog) {\n80\t                const nodes = result.nodes ?? result.node_count ?? 0;\n81\t                const files = result.files ?? result.file_count ?? 0;\n82\t                const edges = result.edges ?? result.edge_count ?? 0;\n83\t                console.log(`[lattice] indexed: ${nodes} nodes, ${files} files, ${edges} edges`);\n84\t            }\n85\t        } catch (err) {\n86\t            console.error('[lattice] failed to fetch stats:', err);\n87\t        }\n88\t    };\n89\t    const startStatsPolling = (): void => {\n90\t        if (statsPollTimer) {\n91\t            return;\n92\t        }\n93\t        statsPollTimer = setInterval(() => {\n94\t            void syncStatsFromDaemon();\n95\t        }, 3000);\n96\t    };\n97\t    const stopStatsPolling = (): void => {\n98\t        if (statsPollTimer) {\n99\t            clearInterval(statsPollTimer);\n100\t            statsPollTimer = undefined;\n101\t        }\n102\t    };\n103\t    context.subscriptions.push(new vscode.Disposable(() => stopStatsPolling()));\n104\t\n105\t    // When daemon becomes running, fetch stats and update UI\n106\t    daemon.onStatusChange(async (status) => {\n107\t        console.log(`[lattice] daemon status: ${status}`);\n108\t        if (status === 'running') {\n109\t            await syncStatsFromDaemon(true);\n110\t            startStatsPolling();\n111\t        } else {\n112\t            stopStatsPolling();\n113\t        }\n114\t    });\n115\t\n116\t    // Start daemon (non-blocking)\n117\t    daemon.start().catch((err) => {\n118\t        console.error(`[lattice] failed to start daemon: ${err.message}`);\n119\t        vscode.window.showErrorMessage(`Lattice: Failed to start daemon — ${err.message}`);\n120\t    });\n121\t\n122\t    // Register commands\n123\t    const reindexCmd = vscode.commands.registerCommand('lattice.reindex', async () => {\n124\t        if (!daemon || daemon.getStatus() !== 'running') {\n125\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n126\t            return;\n127\t        }\n128\t        try {\n129\t            vscode.window.showInformationMessage('Lattice: Re-indexing workspace...');\n130\t            await daemon.sendRequest('lattice/reindex', undefined, 300_000);\n131\t            // Poll status until indexing stabilizes\n132\t            let lastNodes = -1;\n133\t            let stableCount = 0;\n134\t            for (let i = 0; i < 60; i++) {\n135\t                await new Promise(r => setTimeout(r, 2000));\n136\t                const result = await daemon.sendRequest('lattice/status') as DaemonStatusSnapshot;\n137\t                if (result && typeof result === 'object') {\n138\t                    applyStatsSnapshot(result);\n139\t                    const nodes = result.nodes ?? result.node_count ?? 0;\n140\t                    if (nodes === lastNodes && nodes > 0) {\n141\t                        stableCount++;\n142\t                        if (stableCount >= 2) { break; }\n143\t                    } else {\n144\t                        stableCount = 0;\n145\t                    }\n146\t                    lastNodes = nodes;\n147\t                }\n148\t            }\n149\t            vscode.window.showInformationMessage('Lattice: Re-index complete');\n150\t        } catch (err) {\n151\t            const msg = err instanceof Error ? err.message : String(err);\n152\t            vscode.window.showErrorMessage(`Lattice: Re-index failed — ${msg}`);\n153\t        }\n154\t    });\n155\t\n156\t    const statusCmd = vscode.commands.registerCommand('lattice.showStatus', async () => {\n157\t        if (!daemon || daemon.getStatus() !== 'running') {\n158\t            vscode.window.showInformationMessage(`Lattice: Daemon status — ${daemon?.getStatus() ?? 'unknown'}`);\n159\t            return;\n160\t        }\n161\t        try {\n162\t            const result = await daemon.sendRequest('lattice/status');\n163\t            const info = typeof result === 'object' && result !== null ? JSON.stringify(result, null, 2) : String(result);\n164\t            vscode.window.showInformationMessage(`Lattice Status:\\n${info}`);\n165\t        } catch (err) {\n166\t            const msg = err instanceof Error ? err.message : String(err);\n167\t            vscode.window.showErrorMessage(`Lattice: Status request failed — ${msg}`);\n168\t        }\n169\t    });\n170\t\n171\t    // CodeLens provider\n172\t    const codeLensProvider = new LatticeCodeLensProvider(daemon);\n173\t    const codeLensRegistration = vscode.languages.registerCodeLensProvider(\n174\t        { scheme: 'file' },\n175\t        codeLensProvider\n176\t    );\n177\t    context.subscriptions.push(codeLensProvider, codeLensRegistration);\n178\t\n179\t    // Output channel for dependent results\n180\t    const outputChannel = vscode.window.createOutputChannel('Lattice');\n181\t    context.subscriptions.push(outputChannel);\n182\t\n183\t    const showDependentsCmd = vscode.commands.registerCommand(\n184\t        'lattice.showDependents',\n185\t        async (filePath: string, symbolName: string) => {\n186\t            if (!daemon || daemon.getStatus() !== 'running') {\n187\t                vscode.window.showWarningMessage('Lattice: Daemon is not running');\n188\t                return;\n189\t            }\n190\t            try {\n191\t                const result = await daemon.sendRequest('lattice/dependents', {\n192\t                    file: filePath,\n193\t                    name: symbolName,\n194\t                });\n195\t                const dependents = result as { dependents?: Array<{ file: string; line: number; name: string }> };\n196\t                outputChannel.clear();\n197\t                outputChannel.appendLine(`Dependents of \"${symbolName}\" (${filePath}):`);\n198\t                outputChannel.appendLine('---');\n199\t                if (dependents?.dependents && dependents.dependents.length > 0) {\n200\t                    for (const dep of dependents.dependents) {\n201\t                        outputChannel.appendLine(`  ${dep.file}:${dep.line} — ${dep.name}`);\n202\t                    }\n203\t                } else {\n204\t                    outputChannel.appendLine('  No dependents found.');\n205\t                }\n206\t                outputChannel.show(true);\n207\t            } catch (err) {\n208\t                const msg = err instanceof Error ? err.message : String(err);\n209\t                vscode.window.showErrorMessage(`Lattice: Failed to get dependents — ${msg}`);\n210\t            }\n211\t        }\n212\t    );\n213\t\n214\t    const prepareChangeCmd = vscode.commands.registerCommand('lattice.prepareChange', async () => {\n215\t        if (!daemon || daemon.getStatus() !== 'running') {\n216\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n217\t            return;\n218\t        }\n219\t\n220\t        const query = await vscode.window.showInputBox({\n221\t            prompt: 'Describe the change you want Lattice to prepare',\n222\t            placeHolder: 'e.g. fix memory recall timeout on new session',\n223\t            ignoreFocusOut: true,\n224\t        });\n225\t        if (!query || !query.trim()) {\n226\t            return;\n227\t        }\n228\t\n229\t        const activeFile = getActiveEditorFile();\n230\t        const focusedSymbol = getFocusedEditorSymbol(vscode.window.activeTextEditor);\n231\t        const args: Record<string, unknown> = {\n232\t            query: query.trim(),\n233\t            mode: 'compact',\n234\t        };\n235\t        if (activeFile) {\n236\t            args.entry_files = [activeFile];\n237\t        }\n238\t        if (focusedSymbol) {\n239\t            args.entry_symbols = [focusedSymbol];\n240\t        }\n241\t\n242\t        try {\n243\t            const result = await callTool(daemon, 'prepare_change', args);\n244\t            showToolResult(outputChannel, `Lattice prepare_change: ${query.trim()}`, result);\n245\t        } catch (err) {\n246\t            const msg = err instanceof Error ? err.message : String(err);\n247\t            vscode.window.showErrorMessage(`Lattice: Prepare change failed — ${msg}`);\n248\t        }\n249\t    });\n250\t\n251\t    const impactFromDiffCmd = vscode.commands.registerCommand('lattice.impactFromDiff', async () => {\n252\t        if (!daemon || daemon.getStatus() !== 'running') {\n253\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n254\t            return;\n255\t        }\n256\t\n257\t        const workspaceRoot = getWorkspaceRoot(vscode.window.activeTextEditor);\n258\t        if (!workspaceRoot) {\n259\t            vscode.window.showWarningMessage('Lattice: Open a workspace folder to analyze git diff impact');\n260\t            return;\n261\t        }\n262\t\n263\t        try {\n264\t            const diffInfo = await getPreferredGitDiff(workspaceRoot);\n265\t            const result = await callTool(daemon, 'impact_from_diff', {\n266\t                diff: diffInfo.diff,\n267\t                mode: 'compact',\n268\t                hops: 2,\n269\t            });\n270\t            showToolResult(outputChannel, `Lattice impact_from_diff: ${diffInfo.source}`, result);\n271\t        } catch (err) {\n272\t            const msg = err instanceof Error ? err.message : String(err);\n273\t            vscode.window.showErrorMessage(`Lattice: Diff impact failed — ${msg}`);\n274\t        }\n275\t    });\n276\t\n277\t    const workingSetCmd = vscode.commands.registerCommand('lattice.getWorkingSetContext', async () => {\n278\t        if (!daemon || daemon.getStatus() !== 'running') {\n279\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n280\t            return;\n281\t        }\n282\t\n283\t        const query = await vscode.window.showInputBox({\n284\t            prompt: 'Optional task hint for the current working set',\n285\t            placeHolder: 'Leave empty to just use the visible editors',\n286\t            ignoreFocusOut: true,\n287\t        });\n288\t        if (query === undefined) {\n289\t            return;\n290\t        }\n291\t\n292\t        const args: Record<string, unknown> = {\n293\t            mode: 'compact',\n294\t        };\n295\t        const files = collectVisibleEditorFiles();\n296\t        const focusedSymbol = getFocusedEditorSymbol(vscode.window.activeTextEditor);\n297\t        if (query.trim()) {\n298\t            args.query = query.trim();\n299\t        }\n300\t        if (files.length > 0) {\n301\t            args.files = files;\n302\t        }\n303\t        if (focusedSymbol) {\n304\t            args.symbols = [focusedSymbol];\n305\t        }\n306\t\n307\t        try {\n308\t            const result = await callTool(daemon, 'get_working_set_context', args);\n309\t            const title = query.trim()\n310\t                ? `Lattice working set: ${query.trim()}`\n311\t                : 'Lattice working set context';\n312\t            showToolResult(outputChannel, title, result);\n313\t        } catch (err) {\n314\t            const msg = err instanceof Error ? err.message : String(err);\n315\t            vscode.window.showErrorMessage(`Lattice: Working set request failed — ${msg}`);\n316\t        }\n317\t    });\n318\t\n319\t    const diagnoseFailureCmd = vscode.commands.registerCommand('lattice.diagnoseFailure', async () => {\n320\t        if (!daemon || daemon.getStatus() !== 'running') {\n321\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n322\t            return;\n323\t        }\n324\t\n325\t        let input = getSelectedEditorText(vscode.window.activeTextEditor);\n326\t        if (!input) {\n327\t            input = await vscode.window.showInputBox({\n328\t                prompt: 'Paste an error line, failing test output, or stack trace excerpt',\n329\t                placeHolder: \"e.g. thread 'main' panicked at src/rpc/mcp.rs:101\",\n330\t                ignoreFocusOut: true,\n331\t            });\n332\t        }\n333\t        if (!input || !input.trim()) {\n334\t            return;\n335\t        }\n336\t\n337\t        try {\n338\t            const result = await callTool(daemon, 'diagnose_failure', {\n339\t                input: input.trim(),\n340\t                mode: 'compact',\n341\t            });\n342\t            showToolResult(outputChannel, 'Lattice diagnose_failure', result);\n343\t        } catch (err) {\n344\t            const msg = err instanceof Error ? err.message : String(err);\n345\t            vscode.window.showErrorMessage(`Lattice: Failure diagnosis failed — ${msg}`);\n346\t        }\n347\t    });\n348\t\n349\t    const expandContextCmd = vscode.commands.registerCommand('lattice.expandContext', async () => {\n350\t        if (!daemon || daemon.getStatus() !== 'running') {\n351\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n352\t            return;\n353\t        }\n354\t        if (!lastContextHandle) {\n355\t            vscode.window.showInformationMessage(\n356\t                'Lattice: Run prepare change, diff impact, working set, or diagnose failure first to capture a context handle'\n357\t            );\n358\t            return;\n359\t        }\n360\t\n361\t        const focus = await vscode.window.showInputBox({\n362\t            prompt: `Expand context from ${lastContextOrigin ?? 'the last workflow result'}`,\n363\t            placeHolder: 'symbol:search_across_sessions or file:daemon/crates/lattice-core/src/memory/store.rs',\n364\t            ignoreFocusOut: true,\n365\t        });\n366\t        if (!focus || !focus.trim()) {\n367\t            return;\n368\t        }\n369\t\n370\t        try {\n371\t            const result = await callTool(daemon, 'expand_context', {\n372\t                handle: lastContextHandle,\n373\t                focus: focus.trim(),\n374\t                max_tokens: 1200,\n375\t            });\n376\t            showToolResult(outputChannel, `Lattice expand_context: ${focus.trim()}`, result);\n377\t        } catch (err) {\n378\t            const msg = err instanceof Error ? err.message : String(err);\n379\t            vscode.window.showErrorMessage(`Lattice: Context expansion failed — ${msg}`);\n380\t        }\n381\t    });\n382\t\n383\t    const docsCapsuleCmd = vscode.commands.registerCommand('lattice.getDocsCapsule', async () => {\n384\t        if (!daemon || daemon.getStatus() !== 'running') {\n385\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n386\t            return;\n387\t        }\n388\t\n389\t        const query = await vscode.window.showInputBox({\n390\t            prompt: 'Ask for engineering docs, runbooks, or decisions',\n391\t            placeHolder: 'e.g. auth login flow and operational checklist',\n392\t            ignoreFocusOut: true,\n393\t        });\n394\t        if (!query || !query.trim()) {\n395\t            return;\n396\t        }\n397\t\n398\t        const files = collectVisibleEditorFiles();\n399\t        const focusedSymbol = getFocusedEditorSymbol(vscode.window.activeTextEditor);\n400\t        const args: Record<string, unknown> = {\n401\t            query: query.trim(),\n402\t            limit: 6,\n403\t        };\n404\t        if (files.length > 0) {\n405\t            args.files = files;\n406\t        }\n407\t        if (focusedSymbol) {\n408\t            args.symbols = [focusedSymbol];\n409\t        }\n410\t\n411\t        try {\n412\t            const result = await callTool(daemon, 'get_docs_capsule', args);\n413\t            showToolResult(outputChannel, `Lattice docs capsule: ${query.trim()}`, result);\n414\t        } catch (err) {\n415\t            const msg = err instanceof Error ? err.message : String(err);\n416\t            vscode.window.showErrorMessage(`Lattice: Docs capsule failed — ${msg}`);\n417\t        }\n418\t    });\n419\t\n420\t    const backlinksCmd = vscode.commands.registerCommand('lattice.showBacklinks', async (input?: unknown) => {\n421\t        if (!daemon || daemon.getStatus() !== 'running') {\n422\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n423\t            return;\n424\t        }\n425\t\n426\t        const selection = normalizeDocsTargetSelection(input)\n427\t            ?? inferDocsTargetFromEditor(vscode.window.activeTextEditor)\n428\t            ?? await promptForDocsTarget('Show backlinks for a symbol, file, or docs section');\n429\t        if (!selection) {\n430\t            return;\n431\t        }\n432\t\n433\t        try {\n434\t            const result = await callTool(daemon, 'get_backlinks', {\n435\t                target: selection.target,\n436\t                kind: selection.kind,\n437\t                limit: 20,\n438\t            });\n439\t            showToolResult(outputChannel, `Lattice backlinks: ${selection.label}`, result);\n440\t        } catch (err) {\n441\t            const msg = err instanceof Error ? err.message : String(err);\n442\t            vscode.window.showErrorMessage(`Lattice: Backlinks lookup failed — ${msg}`);\n443\t        }\n444\t    });\n445\t\n446\t    const outgoingLinksCmd = vscode.commands.registerCommand('lattice.showOutgoingLinks', async (input?: unknown) => {\n447\t        if (!daemon || daemon.getStatus() !== 'running') {\n448\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n449\t            return;\n450\t        }\n451\t\n452\t        const selection = normalizeDocsTargetSelection(input)\n453\t            ?? inferDocsFileOrSectionTarget(vscode.window.activeTextEditor)\n454\t            ?? await promptForDocsTarget('Show outgoing links for a docs file or section');\n455\t        if (!selection) {\n456\t            return;\n457\t        }\n458\t\n459\t        try {\n460\t            const result = await callTool(daemon, 'get_outgoing_links', {\n461\t                target: selection.target,\n462\t                kind: selection.kind,\n463\t                limit: 20,\n464\t            });\n465\t            showToolResult(outputChannel, `Lattice outgoing links: ${selection.label}`, result);\n466\t        } catch (err) {\n467\t            const msg = err instanceof Error ? err.message : String(err);\n468\t            vscode.window.showErrorMessage(`Lattice: Outgoing links lookup failed — ${msg}`);\n469\t        }\n470\t    });\n471\t\n472\t    const findStaleDocsCmd = vscode.commands.registerCommand('lattice.findStaleDocs', async () => {\n473\t        if (!daemon || daemon.getStatus() !== 'running') {\n474\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n475\t            return;\n476\t        }\n477\t\n478\t        const staleInputs = await collectStaleDocInputs(vscode.window.activeTextEditor);\n479\t        if (staleInputs.files.length === 0 && staleInputs.symbols.length === 0) {\n480\t            vscode.window.showInformationMessage(\n481\t                'Lattice: No git diff or active editor context available to check stale docs'\n482\t            );\n483\t            return;\n484\t        }\n485\t\n486\t        try {\n487\t            const result = await callTool(daemon, 'find_stale_docs', {\n488\t                files: staleInputs.files,\n489\t                symbols: staleInputs.symbols,\n490\t                limit: 12,\n491\t            });\n492\t            showToolResult(outputChannel, `Lattice stale docs: ${staleInputs.source}`, result);\n493\t        } catch (err) {\n494\t            const msg = err instanceof Error ? err.message : String(err);\n495\t            vscode.window.showErrorMessage(`Lattice: Stale-doc check failed — ${msg}`);\n496\t        }\n497\t    });\n498\t\n499\t    const openDocsWorkbenchCmd = vscode.commands.registerCommand('lattice.openDocsWorkbench', async (input?: unknown) => {\n500\t        if (!daemon || daemon.getStatus() !== 'running') {\n501\t            vscode.window.showWarningMessage('Lattice: Daemon is not running');\n502\t            return;\n503\t        }\n504\t\n505\t        try {\n506\t            await docsWorkbench.createOrShow(normalizeDocsTargetSelection(input));\n507\t        } catch (err) {\n508\t            const msg = err instanceof Error ? err.message : String(err);\n509\t            vscode.window.showErrorMessage(`Lattice: Docs graph failed — ${msg}`);\n510\t        }\n511\t    });\n512\t\n513\t    // Hover provider\n514\t    const hoverProvider = new LatticeHoverProvider(daemon);\n515\t    const hoverRegistration = vscode.languages.registerHoverProvider(\n516\t        { scheme: 'file' },\n517\t        hoverProvider\n518\t    );\n519\t    context.subscriptions.push(hoverRegistration);\n520\t\n521\t    context.subscriptions.push(\n522\t        reindexCmd,\n523\t        statusCmd,\n524\t        showDependentsCmd,\n525\t        prepareChangeCmd,\n526\t        impactFromDiffCmd,\n527\t        workingSetCmd,\n528\t        diagnoseFailureCmd,\n529\t        expandContextCmd,\n530\t        docsCapsuleCmd,\n531\t        backlinksCmd,\n532\t        outgoingLinksCmd,\n533\t        findStaleDocsCmd,\n534\t        openDocsWorkbenchCmd\n535\t    );\n536\t}\n537\t\n538\texport function deactivate() {\n539\t    console.log('Lattice extension deactivating...');\n540\t    if (daemon) {\n541\t        daemon.dispose();\n542\t        daemon = undefined;\n543\t    }\n544\t}\n545\t\n546\tasync function callTool(\n547\t    daemonManager: DaemonManager,\n548\t    name: string,\n549\t    args: Record<string, unknown>,\n550\t    timeoutMs = 120_000\n551\t): Promise<unknown> {\n552\t    const response = await daemonManager.sendRequest('tools/call', {\n553\t        name,\n554\t        arguments: args,\n555\t    }, timeoutMs) as McpToolResponse;\n556\t\n557\t    const text = response.content?.find((item) => item.type === 'text')?.text;\n558\t    if (typeof text !== 'string') {\n559\t        throw new Error(`Unexpected response payload from ${name}`);\n560\t    }\n561\t\n562\t    try {\n563\t        return JSON.parse(text) as unknown;\n564\t    } catch {\n565\t        return text;\n566\t    }\n567\t}\n568\t\n569\tfunction showToolResult(\n570\t    outputChannel: vscode.OutputChannel,\n571\t    title: string,\n572\t    result: unknown\n573\t): void {\n574\t    rememberContextHandle(result);\n575\t\n576\t    outputChannel.clear();\n577\t    outputChannel.appendLine(title);\n578\t    outputChannel.appendLine('='.repeat(title.length));\n579\t    outputChannel.appendLine('');\n580\t    if (lastContextHandle && hasContextHandle(result)) {\n581\t        outputChannel.appendLine(`Context handle: ${lastContextHandle}`);\n582\t        if (lastContextOrigin) {\n583\t            outputChannel.appendLine(`Context origin: ${lastContextOrigin}`);\n584\t        }\n585\t        outputChannel.appendLine('');\n586\t    }\n587\t    outputChannel.appendLine(\n588\t        typeof result === 'string' ? result : JSON.stringify(result, null, 2)\n589\t    );\n590\t    outputChannel.show(true);\n591\t}\n592\t\n593\tfunction getActiveEditorFile(): string | undefined {\n594\t    const editor = vscode.window.activeTextEditor;\n595\t    if (!editor || editor.document.uri.scheme !== 'file') {\n596\t        return undefined;\n597\t    }\n598\t\n599\t    return toRelativeWorkspacePath(editor.document.uri);\n600\t}\n601\t\n602\tfunction collectVisibleEditorFiles(): string[] {\n603\t    const files = new Set<string>();\n604\t    for (const editor of vscode.window.visibleTextEditors) {\n605\t        if (editor.document.uri.scheme !== 'file') {\n606\t            continue;\n607\t        }\n608\t        files.add(toRelativeWorkspacePath(editor.document.uri));\n609\t    }\n610\t    return Array.from(files);\n611\t}\n612\t\n613\tfunction getFocusedEditorSymbol(editor: vscode.TextEditor | undefined): string | undefined {\n614\t    if (!editor) {\n615\t        return undefined;\n616\t    }\n617\t\n618\t    const selectionText = editor.document.getText(editor.selection).trim();\n619\t    if (selectionText && isCompactSymbol(selectionText)) {\n620\t        return selectionText;\n621\t    }\n622\t\n623\t    const wordRange = editor.document.getWordRangeAtPosition(editor.selection.active);\n624\t    if (!wordRange) {\n625\t        return undefined;\n626\t    }\n627\t\n628\t    const word = editor.document.getText(wordRange).trim();\n629\t    return isCompactSymbol(word) ? word : undefined;\n630\t}\n631\t\n632\tfunction getSelectedEditorText(editor: vscode.TextEditor | undefined): string | undefined {\n633\t    if (!editor || editor.selection.isEmpty) {\n634\t        return undefined;\n635\t    }\n636\t\n637\t    const text = editor.document.getText(editor.selection).trim();\n638\t    return text || undefined;\n639\t}\n640\t\n641\tfunction isCompactSymbol(value: string): boolean {\n642\t    return value.length >= 2 && value.length <= 120 && /^[A-Za-z_][\\w.$:-]*$/.test(value);\n643\t}\n644\t\n645\tfunction hasContextHandle(result: unknown): result is { context_handle: string } {\n646\t    if (!result || typeof result !== 'object') {\n647\t        return false;\n648\t    }\n649\t\n650\t    return typeof (result as { context_handle?: unknown }).context_handle === 'string';\n651\t}\n652\t\n653\tfunction rememberContextHandle(result: unknown): void {\n654\t    if (!result || typeof result !== 'object') {\n655\t        return;\n656\t    }\n657\t\n658\t    const contextHandle = (result as { context_handle?: unknown }).context_handle;\n659\t    if (typeof contextHandle !== 'string') {\n660\t        return;\n661\t    }\n662\t\n663\t    lastContextHandle = contextHandle;\n664\t    const contextOrigin = (result as { context_origin?: unknown }).context_origin;\n665\t    lastContextOrigin = typeof contextOrigin === 'string' ? contextOrigin : undefined;\n666\t}\n667\t\n668\tfunction getWorkspaceRoot(editor: vscode.TextEditor | undefined): string | undefined {\n669\t    const folder = editor ? vscode.workspace.getWorkspaceFolder(editor.document.uri) : undefined;\n670\t    return folder?.uri.fsPath ?? vscode.workspace.workspaceFolders?.[0]?.uri.fsPath;\n671\t}\n672\t\n673\tfunction toRelativeWorkspacePath(uri: vscode.Uri): string {\n674\t    return vscode.workspace.asRelativePath(uri, false).replace(/\\\\/g, '/');\n675\t}\n676\t\n677\tfunction inferDocsTargetFromEditor(editor: vscode.TextEditor | undefined): DocsTargetSelection | undefined {\n678\t    const focusedSymbol = getFocusedEditorSymbol(editor);\n679\t    if (focusedSymbol) {\n680\t        return {\n681\t            target: focusedSymbol,\n682\t            kind: 'symbol',\n683\t            label: focusedSymbol,\n684\t        };\n685\t    }\n686\t\n687\t    const docsTarget = inferDocsFileOrSectionTarget(editor);\n688\t    if (docsTarget) {\n689\t        return docsTarget;\n690\t    }\n691\t\n692\t    const activeFile = getActiveEditorFile();\n693\t    if (!activeFile) {\n694\t        return undefined;\n695\t    }\n696\t\n697\t    return {\n698\t        target: activeFile,\n699\t        kind: 'file',\n700\t        label: activeFile,\n701\t    };\n702\t}\n703\t\n704\tfunction inferDocsFileOrSectionTarget(editor: vscode.TextEditor | undefined): DocsTargetSelection | undefined {\n705\t    if (!editor || editor.document.uri.scheme !== 'file') {\n706\t        return undefined;\n707\t    }\n708\t\n709\t    const file = toRelativeWorkspacePath(editor.document.uri);\n710\t    const isMarkdown = editor.document.languageId === 'markdown' || file.endsWith('.md');\n711\t    if (!isMarkdown) {\n712\t        return {\n713\t            target: file,\n714\t            kind: 'file',\n715\t            label: file,\n716\t        };\n717\t    }\n718\t\n719\t    const sectionTitle = getCurrentMarkdownHeading(editor);\n720\t    if (sectionTitle) {\n721\t        return {\n722\t            target: `${file}#${sectionTitle}`,\n723\t            kind: 'section',\n724\t            label: `${file}#${sectionTitle}`,\n725\t        };\n726\t    }\n727\t\n728\t    return {\n729\t        target: file,\n730\t        kind: 'file',\n731\t        label: file,\n732\t    };\n733\t}\n734\t\n735\tfunction getCurrentMarkdownHeading(editor: vscode.TextEditor): string | undefined {\n736\t    for (let line = editor.selection.active.line; line >= 0; line--) {\n737\t        const text = editor.document.lineAt(line).text.trim();\n738\t        const match = text.match(/^#{1,6}\\s+(.+?)\\s*#*$/);\n739\t        if (match?.[1]) {\n740\t            return match[1].trim();\n741\t        }\n742\t    }\n743\t\n744\t    return undefined;\n745\t}\n746\t\n747\tasync function promptForDocsTarget(prompt: string): Promise<DocsTargetSelection | undefined> {\n748\t    const target = await vscode.window.showInputBox({\n749\t        prompt,\n750\t        placeHolder: 'e.g. loginUser or docs/auth-guide.md#Login Flow',\n751\t        ignoreFocusOut: true,\n752\t    });\n753\t    if (!target || !target.trim()) {\n754\t        return undefined;\n755\t    }\n756\t\n757\t    return {\n758\t        target: target.trim(),\n759\t        kind: 'auto',\n760\t        label: target.trim(),\n761\t    };\n762\t}\n763\t\n764\tasync function collectStaleDocInputs(\n765\t    editor: vscode.TextEditor | undefined\n766\t): Promise<{ files: string[]; symbols: string[]; source: string }> {\n767\t    const workspaceRoot = getWorkspaceRoot(editor);\n768\t    const focusedSymbol = getFocusedEditorSymbol(editor);\n769\t    const activeFile = editor && editor.document.uri.scheme === 'file'\n770\t        ? toRelativeWorkspacePath(editor.document.uri)\n771\t        : undefined;\n772\t\n773\t    if (workspaceRoot) {\n774\t        const gitChanged = await getPreferredGitChangedFiles(workspaceRoot).catch(() => undefined);\n775\t        if (gitChanged && gitChanged.files.length > 0) {\n776\t            return {\n777\t                files: gitChanged.files,\n778\t                symbols: focusedSymbol ? [focusedSymbol] : [],\n779\t                source: gitChanged.source,\n780\t            };\n781\t        }\n782\t    }\n783\t\n784\t    return {\n785\t        files: activeFile ? [activeFile] : [],\n786\t        symbols: focusedSymbol ? [focusedSymbol] : [],\n787\t        source: activeFile ? `active file ${activeFile}` : 'current editor context',\n788\t    };\n789\t}\n790\t\n791\tasync function getPreferredGitDiff(cwd: string): Promise<{ diff: string; source: string }> {\n792\t    const stagedDiff = await runExecFile('git', ['diff', '--cached', '--no-ext-diff', '--unified=3'], cwd)\n793\t        .catch(() => '');\n794\t    if (stagedDiff.trim()) {\n795\t        return { diff: stagedDiff, source: 'staged diff' };\n796\t    }\n797\t\n798\t    const workingDiff = await runExecFile('git', ['diff', '--no-ext-diff', '--unified=3'], cwd)\n799\t        .catch(() => '');\n800\t    if (workingDiff.trim()) {\n801\t        return { diff: workingDiff, source: 'working tree diff' };\n802\t    }\n803\t\n804\t    throw new Error('No staged or working tree diff found');\n805\t}\n806\t\n807\tasync function getPreferredGitChangedFiles(cwd: string): Promise<GitChangedFiles> {\n808\t    const stagedFiles = await runExecFile('git', ['diff', '--cached', '--name-only'], cwd)\n809\t        .catch(() => '');\n810\t    const parsedStaged = parseGitChangedFiles(stagedFiles);\n811\t    if (parsedStaged.length > 0) {\n812\t        return { files: parsedStaged, source: 'staged diff' };\n813\t    }\n814\t\n815\t    const workingFiles = await runExecFile('git', ['diff', '--name-only'], cwd)\n816\t        .catch(() => '');\n817\t    const parsedWorking = parseGitChangedFiles(workingFiles);\n818\t    if (parsedWorking.length > 0) {\n819\t        return { files: parsedWorking, source: 'working tree diff' };\n820\t    }\n821\t\n822\t    throw new Error('No staged or working tree diff found');\n823\t}\n824\t\n825\tfunction parseGitChangedFiles(stdout: string): string[] {\n826\t    const seen = new Set<string>();\n827\t    const files: string[] = [];\n828\t\n829\t    for (const line of stdout.split(/\\r?\\n/)) {\n830\t        const trimmed = line.trim().replace(/\\\\/g, '/');\n831\t        if (!trimmed || seen.has(trimmed)) {\n832\t            continue;\n833\t        }\n834\t        seen.add(trimmed);\n835\t        files.push(trimmed);\n836\t    }\n837\t\n838\t    return files;\n839\t}\n840\t\n841\tfunction runExecFile(command: string, args: string[], cwd: string): Promise<string> {\n842\t    return new Promise((resolve, reject) => {\n843\t        cp.execFile(\n844\t            command,\n845\t            args,\n846\t            {\n847\t                cwd,\n848\t                encoding: 'utf8',\n849\t                maxBuffer: 5 * 1024 * 1024,\n850\t            },\n851\t            (error, stdout, stderr) => {\n852\t                if (error) {\n853\t                    reject(new Error(stderr.trim() || error.message));\n854\t                    return;\n855\t                }\n856\t                resolve(stdout);\n857\t            }\n858\t        );\n859\t    });\n860\t}\n861\t"}]},"parent_tool_use_id":"toolu_01BbdQyD8DbWiNRxRFHe822D","session_id":"88204e0b-a61b-4ed7-ba98-4fcc53be0768","uuid":"af00f314-2ad9-4d18-ab66-f8d23b6a4bd7","timestamp":"2026-05-17T02:18:21.791Z","subagent_type":"Explore","task_description":"Explore extension + MCP surface"}
