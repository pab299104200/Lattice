{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011hN2zAncQKYspPEjou6hRu","type":"tool_result","content":"1\t//! Event hooks for working-memory state mutations.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## 3. Event Log` requires `MemoryRetrieved` and `MemoryExpanded` events,\n5\t//! and `## Phase 5: Working Memory` requires included and excluded context to\n6\t//! be observable without feeding the full event stream back into prompts.\n7\t\n8\tuse rusqlite::ErrorCode;\n9\t\n10\tuse crate::events::{\n11\t    Actor, BranchRef, CompactSummary, EventKind, EventPayload, EventWriteError, EventWriter,\n12\t    ExcludedContextDelta, FlushPolicy, IncludedContextDelta, MemoryExpandedPayload,\n13\t    MemoryRetrievedPayload, PartialEnvelope, SessionId, StableRef, TaskId,\n14\t};\n15\tuse crate::identity::{EventId, Identity, MemoryId, WorkspaceId};\n16\t\n17\tuse super::state::WorkingMemoryState;\n18\t\n19\tconst HOT_PATH_FLUSH: FlushPolicy = FlushPolicy::Batched { interval_ms: 250 };\n20\t\n21\t#[derive(Debug, Clone, PartialEq, Eq)]\n22\tpub struct MutationEventSummary {\n23\t    pub op_name: String,\n24\t    pub summary: String,\n25\t}\n26\t\n27\t#[derive(Debug, Clone, PartialEq, Eq)]\n28\tpub struct WorkingMemoryEventContext {\n29\t    pub workspace_id: WorkspaceId,\n30\t    pub branch: BranchRef,\n31\t    pub session_id: SessionId,\n32\t    pub task_id: TaskId,\n33\t    pub actor: Actor,\n34\t}\n35\t\n36\tpub trait WorkingMemoryEventAppender {\n37\t    fn append(\n38\t        &self,\n39\t        envelope: PartialEnvelope,\n40\t        flush_policy: FlushPolicy,\n41\t    ) -> Result<EventId, EventWriteError>;\n42\t}\n43\t\n44\timpl WorkingMemoryEventAppender for EventWriter {\n45\t    fn append(\n46\t        &self,\n47\t        envelope: PartialEnvelope,\n48\t        flush_policy: FlushPolicy,\n49\t    ) -> Result<EventId, EventWriteError> {\n50\t        self.append_with_flush_policy(envelope, flush_policy)\n51\t    }\n52\t}\n53\t\n54\tpub fn emit_memory_retrieved(\n55\t    state_before: &WorkingMemoryState,\n56\t    state_after: &WorkingMemoryState,\n57\t    op_summary: &MutationEventSummary,\n58\t    ctx: &WorkingMemoryEventContext,\n59\t    writer: &dyn WorkingMemoryEventAppender,\n60\t) -> Result<Option<EventId>, EventWriteError> {\n61\t    let included = diff_selected_memories(state_before, state_after);\n62\t    let excluded = diff_excluded_memories(state_before, state_after);\n63\t    if included.is_empty() && excluded.is_empty() {\n64\t        return Ok(None);\n65\t    }\n66\t    let payload = EventPayload::MemoryRetrieved(MemoryRetrievedPayload {\n67\t        retrieval_query: op_summary.summary.clone(),\n68\t        context_handle_id: None,\n69\t        memory_ids: collect_memory_ids(&included),\n70\t        supporting_event_ids: Vec::new(),\n71\t        included_context: included.clone(),\n72\t        excluded_context: excluded.clone(),\n73\t    });\n74\t    let references = build_references(&included, &excluded);\n75\t    let summary = compact_summary(\n76\t        \"Working memory retrieved\",\n77\t        &op_summary.op_name,\n78\t        included.len(),\n79\t        excluded.len(),\n80\t    )?;\n81\t    writer\n82\t        .append(\n83\t            PartialEnvelope {\n84\t                workspace_id: Some(ctx.workspace_id.clone()),\n85\t                branch: ctx.branch.clone(),\n86\t                session_id: ctx.session_id.clone(),\n87\t                task_id: Some(ctx.task_id.clone()),\n88\t                actor: ctx.actor.clone(),\n89\t                kind: EventKind::MemoryRetrieved,\n90\t                references,\n91\t                summary,\n92\t                payload,\n93\t            },\n94\t            HOT_PATH_FLUSH,\n95\t        )\n96\t        .map(Some)\n97\t}\n98\t\n99\tpub fn emit_memory_expanded(\n100\t    state_before: &WorkingMemoryState,\n101\t    state_after: &WorkingMemoryState,\n102\t    op_summary: &MutationEventSummary,\n103\t    ctx: &WorkingMemoryEventContext,\n104\t    writer: &dyn WorkingMemoryEventAppender,\n105\t) -> Result<Option<EventId>, EventWriteError> {\n106\t    let included = diff_selected_memories(state_before, state_after);\n107\t    let excluded = diff_excluded_memories(state_before, state_after);\n108\t    if included.is_empty() && excluded.is_empty() {\n109\t        return Ok(None);\n110\t    }\n111\t    let memory_id = included\n112\t        .iter()\n113\t        .find_map(|item| memory_id_from_identity(&item.identity))\n114\t        .or_else(|| first_memory_id(state_after));\n115\t    let payload = EventPayload::MemoryExpanded(MemoryExpandedPayload {\n116\t        memory_id,\n117\t        source_event_id: None,\n118\t        linked_memory_ids: collect_memory_ids(&included),\n119\t        linked_symbol_ids: Vec::new(),\n120\t        linked_doc_section_ids: Vec::new(),\n121\t        expansion_identity: included\n122\t            .first()\n123\t            .map(|item| item.identity.clone())\n124\t            .or_else(|| first_selected_identity(state_after)),\n125\t        included_context: included.clone(),\n126\t        excluded_context: excluded.clone(),\n127\t    });\n128\t    let references = build_references(&included, &excluded);\n129\t    let summary = compact_summary(\n130\t        \"Working memory expanded\",\n131\t        &op_summary.op_name,\n132\t        included.len(),\n133\t        excluded.len(),\n134\t    )?;\n135\t    writer\n136\t        .append(\n137\t            PartialEnvelope {\n138\t                workspace_id: Some(ctx.workspace_id.clone()),\n139\t                branch: ctx.branch.clone(),\n140\t                session_id: ctx.session_id.clone(),\n141\t                task_id: Some(ctx.task_id.clone()),\n142\t                actor: ctx.actor.clone(),\n143\t                kind: EventKind::MemoryExpanded,\n144\t                references,\n145\t                summary,\n146\t                payload,\n147\t            },\n148\t            HOT_PATH_FLUSH,\n149\t        )\n150\t        .map(Some)\n151\t}\n152\t\n153\tpub fn is_backpressure_error(error: &EventWriteError) -> bool {\n154\t    match error {\n155\t        EventWriteError::Storage(crate::events::EventStoreError::Sqlite(\n156\t            rusqlite::Error::SqliteFailure(sqlite_error, _),\n157\t        )) => matches!(\n158\t            sqlite_error.code,\n159\t            ErrorCode::DatabaseBusy | ErrorCode::DatabaseLocked\n160\t        ),\n161\t        EventWriteError::Storage(crate::events::EventStoreError::Sqlite(error)) => {\n162\t            let text = error.to_string();\n163\t            text.contains(\"database is locked\") || text.contains(\"database is busy\")\n164\t        }\n165\t        _ => false,\n166\t    }\n167\t}\n168\t\n169\tfn diff_selected_memories(\n170\t    state_before: &WorkingMemoryState,\n171\t    state_after: &WorkingMemoryState,\n172\t) -> Vec<IncludedContextDelta> {\n173\t    state_after\n174\t        .selected_memories\n175\t        .iter()\n176\t        .filter(|candidate| {\n177\t            !state_before\n178\t                .selected_memories\n179\t                .iter()\n180\t                .any(|previous| previous.identity == candidate.identity)\n181\t        })\n182\t        .map(|result| IncludedContextDelta {\n183\t            identity: result.identity.clone(),\n184\t            headline: result.headline.clone(),\n185\t            inclusion_reason: result.inclusion_reason.clone(),\n186\t        })\n187\t        .collect()\n188\t}\n189\t\n190\tfn diff_excluded_memories(\n191\t    state_before: &WorkingMemoryState,\n192\t    state_after: &WorkingMemoryState,\n193\t) -> Vec<ExcludedContextDelta> {\n194\t    state_after\n195\t        .excluded_memories\n196\t        .iter()\n197\t        .filter(|candidate| {\n198\t            !state_before.excluded_memories.iter().any(|previous| {\n199\t                previous.result.identity == candidate.result.identity\n200\t                    && previous.exclusion_reason == candidate.exclusion_reason\n201\t            })\n202\t        })\n203\t        .map(|excluded| ExcludedContextDelta {\n204\t            identity: excluded.result.identity.clone(),\n205\t            headline: excluded.result.headline.clone(),\n206\t            exclusion_reason: excluded.exclusion_reason.clone(),\n207\t        })\n208\t        .collect()\n209\t}\n210\t\n211\tfn collect_memory_ids(included: &[IncludedContextDelta]) -> Vec<MemoryId> {\n212\t    included\n213\t        .iter()\n214\t        .filter_map(|item| memory_id_from_identity(&item.identity))\n215\t        .collect()\n216\t}\n217\t\n218\tfn build_references(\n219\t    included: &[IncludedContextDelta],\n220\t    excluded: &[ExcludedContextDelta],\n221\t) -> Vec<StableRef> {\n222\t    let mut references = Vec::with_capacity(included.len() + excluded.len());\n223\t    for item in included {\n224\t        if let Some(reference) = stable_ref_from_identity(&item.identity) {\n225\t            references.push(reference);\n226\t        }\n227\t    }\n228\t    for item in excluded {\n229\t        if let Some(reference) = stable_ref_from_identity(&item.identity) {\n230\t            references.push(reference);\n231\t        }\n232\t    }\n233\t    references\n234\t}\n235\t\n236\tfn stable_ref_from_identity(identity: &Identity) -> Option<StableRef> {\n237\t    Some(match identity {\n238\t        Identity::File(file) => StableRef::FileRef(file.clone()),\n239\t        Identity::Symbol(symbol) => StableRef::SymbolRef(symbol.clone()),\n240\t        Identity::Doc(_) => return None,\n241\t        Identity::Section(section) => StableRef::DocSectionRef(section.clone()),\n242\t        Identity::Event(event) => StableRef::EventRef(event.clone()),\n243\t        Identity::Memory(memory) => StableRef::MemoryRef(memory.clone()),\n244\t        Identity::ContextHandle(handle) => StableRef::ContextHandleRef(handle.clone()),\n245\t    })\n246\t}\n247\t\n248\tfn memory_id_from_identity(identity: &Identity) -> Option<MemoryId> {\n249\t    match identity {\n250\t        Identity::Memory(memory) => Some(memory.clone()),\n251\t        _ => None,\n252\t    }\n253\t}\n254\t\n255\tfn first_memory_id(state: &WorkingMemoryState) -> Option<MemoryId> {\n256\t    state\n257\t        .selected_memories\n258\t        .iter()\n259\t        .find_map(|result| memory_id_from_identity(&result.identity))\n260\t}\n261\t\n262\tfn first_selected_identity(state: &WorkingMemoryState) -> Option<Identity> {\n263\t    state\n264\t        .selected_memories\n265\t        .first()\n266\t        .map(|result| result.identity.clone())\n267\t}\n268\t\n269\tfn compact_summary(\n270\t    prefix: &str,\n271\t    op_name: &str,\n272\t    included: usize,\n273\t    excluded: usize,\n274\t) -> Result<CompactSummary, EventWriteError> {\n275\t    CompactSummary::new(format!(\n276\t        \"{prefix}: op={op_name} included={included} excluded={excluded}\"\n277\t    ))\n278\t    .map_err(|error| {\n279\t        crate::events::EventStoreError::EnvelopeInvalid {\n280\t            reason: error.to_string(),\n281\t        }\n282\t        .into()\n283\t    })\n284\t}\n285\t"}]},"parent_tool_use_id":null,"session_id":"1b2121c5-8450-4d0d-9f66-0986877cae23","uuid":"942ce4d3-3d80-4733-bdd8-81dda11250d0","timestamp":"2026-05-17T10:13:51.537Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/working_memory/event_hooks.rs","content":"//! Event hooks for working-memory state mutations.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 3. Event Log` requires `MemoryRetrieved` and `MemoryExpanded` events,\n//! and `## Phase 5: Working Memory` requires included and excluded context to\n//! be observable without feeding the full event stream back into prompts.\n\nuse rusqlite::ErrorCode;\n\nuse crate::events::{\n    Actor, BranchRef, CompactSummary, EventKind, EventPayload, EventWriteError, EventWriter,\n    ExcludedContextDelta, FlushPolicy, IncludedContextDelta, MemoryExpandedPayload,\n    MemoryRetrievedPayload, PartialEnvelope, SessionId, StableRef, TaskId,\n};\nuse crate::identity::{EventId, Identity, MemoryId, WorkspaceId};\n\nuse super::state::WorkingMemoryState;\n\nconst HOT_PATH_FLUSH: FlushPolicy = FlushPolicy::Batched { interval_ms: 250 };\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct MutationEventSummary {\n    pub op_name: String,\n    pub summary: String,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct WorkingMemoryEventContext {\n    pub workspace_id: WorkspaceId,\n    pub branch: BranchRef,\n    pub session_id: SessionId,\n    pub task_id: TaskId,\n    pub actor: Actor,\n}\n\npub trait WorkingMemoryEventAppender {\n    fn append(\n        &self,\n        envelope: PartialEnvelope,\n        flush_policy: FlushPolicy,\n    ) -> Result<EventId, EventWriteError>;\n}\n\nimpl WorkingMemoryEventAppender for EventWriter {\n    fn append(\n        &self,\n        envelope: PartialEnvelope,\n        flush_policy: FlushPolicy,\n    ) -> Result<EventId, EventWriteError> {\n        self.append_with_flush_policy(envelope, flush_policy)\n    }\n}\n\npub fn emit_memory_retrieved(\n    state_before: &WorkingMemoryState,\n    state_after: &WorkingMemoryState,\n    op_summary: &MutationEventSummary,\n    ctx: &WorkingMemoryEventContext,\n    writer: &dyn WorkingMemoryEventAppender,\n) -> Result<Option<EventId>, EventWriteError> {\n    let included = diff_selected_memories(state_before, state_after);\n    let excluded = diff_excluded_memories(state_before, state_after);\n    if included.is_empty() && excluded.is_empty() {\n        return Ok(None);\n    }\n    let payload = EventPayload::MemoryRetrieved(MemoryRetrievedPayload {\n        retrieval_query: op_summary.summary.clone(),\n        context_handle_id: None,\n        memory_ids: collect_memory_ids(&included),\n        supporting_event_ids: Vec::new(),\n        included_context: included.clone(),\n        excluded_context: excluded.clone(),\n    });\n    let references = build_references(&included, &excluded);\n    let summary = compact_summary(\n        \"Working memory retrieved\",\n        &op_summary.op_name,\n        included.len(),\n        excluded.len(),\n    )?;\n    writer\n        .append(\n            PartialEnvelope {\n                workspace_id: Some(ctx.workspace_id.clone()),\n                branch: ctx.branch.clone(),\n                session_id: ctx.session_id.clone(),\n                task_id: Some(ctx.task_id.clone()),\n                actor: ctx.actor.clone(),\n                kind: EventKind::MemoryRetrieved,\n                references,\n                summary,\n                payload,\n            },\n            HOT_PATH_FLUSH,\n        )\n        .map(Some)\n}\n\npub fn emit_memory_expanded(\n    state_before: &WorkingMemoryState,\n    state_after: &WorkingMemoryState,\n    op_summary: &MutationEventSummary,\n    ctx: &WorkingMemoryEventContext,\n    writer: &dyn WorkingMemoryEventAppender,\n) -> Result<Option<EventId>, EventWriteError> {\n    let included = diff_selected_memories(state_before, state_after);\n    let excluded = diff_excluded_memories(state_before, state_after);\n    if included.is_empty() && excluded.is_empty() {\n        return Ok(None);\n    }\n    let memory_id = included\n        .iter()\n        .find_map(|item| memory_id_from_identity(&item.identity))\n        .or_else(|| first_memory_id(state_after));\n    let payload = EventPayload::MemoryExpanded(MemoryExpandedPayload {\n        memory_id,\n        source_event_id: None,\n        linked_memory_ids: collect_memory_ids(&included),\n        linked_symbol_ids: Vec::new(),\n        linked_doc_section_ids: Vec::new(),\n        expansion_identity: included\n            .first()\n            .map(|item| item.identity.clone())\n            .or_else(|| first_selected_identity(state_after)),\n        included_context: included.clone(),\n        excluded_context: excluded.clone(),\n    });\n    let references = build_references(&included, &excluded);\n    let summary = compact_summary(\n        \"Working memory expanded\",\n        &op_summary.op_name,\n        included.len(),\n        excluded.len(),\n    )?;\n    writer\n        .append(\n            PartialEnvelope {\n                workspace_id: Some(ctx.workspace_id.clone()),\n                branch: ctx.branch.clone(),\n                session_id: ctx.session_id.clone(),\n                task_id: Some(ctx.task_id.clone()),\n                actor: ctx.actor.clone(),\n                kind: EventKind::MemoryExpanded,\n                references,\n                summary,\n                payload,\n            },\n            HOT_PATH_FLUSH,\n        )\n        .map(Some)\n}\n\npub fn is_backpressure_error(error: &EventWriteError) -> bool {\n    match error {\n        EventWriteError::Storage(crate::events::EventStoreError::Sqlite(\n            rusqlite::Error::SqliteFailure(sqlite_error, _),\n        )) => matches!(\n            sqlite_error.code,\n            ErrorCode::DatabaseBusy | ErrorCode::DatabaseLocked\n        ),\n        EventWriteError::Storage(crate::events::EventStoreError::Sqlite(error)) => {\n            let text = error.to_string();\n            text.contains(\"database is locked\") || text.contains(\"database is busy\")\n        }\n        _ => false,\n    }\n}\n\nfn diff_selected_memories(\n    state_before: &WorkingMemoryState,\n    state_after: &WorkingMemoryState,\n) -> Vec<IncludedContextDelta> {\n    state_after\n        .selected_memories\n        .iter()\n        .filter(|candidate| {\n            !state_before\n                .selected_memories\n                .iter()\n                .any(|previous| previous.identity == candidate.identity)\n        })\n        .map(|result| IncludedContextDelta {\n            identity: result.identity.clone(),\n            headline: result.headline.clone(),\n            inclusion_reason: result.inclusion_reason.clone(),\n        })\n        .collect()\n}\n\nfn diff_excluded_memories(\n    state_before: &WorkingMemoryState,\n    state_after: &WorkingMemoryState,\n) -> Vec<ExcludedContextDelta> {\n    state_after\n        .excluded_memories\n        .iter()\n        .filter(|candidate| {\n            !state_before.excluded_memories.iter().any(|previous| {\n                previous.result.identity == candidate.result.identity\n                    && previous.exclusion_reason == candidate.exclusion_reason\n            })\n        })\n        .map(|excluded| ExcludedContextDelta {\n            identity: excluded.result.identity.clone(),\n            headline: excluded.result.headline.clone(),\n            exclusion_reason: excluded.exclusion_reason.clone(),\n        })\n        .collect()\n}\n\nfn collect_memory_ids(included: &[IncludedContextDelta]) -> Vec<MemoryId> {\n    included\n        .iter()\n        .filter_map(|item| memory_id_from_identity(&item.identity))\n        .collect()\n}\n\nfn build_references(\n    included: &[IncludedContextDelta],\n    excluded: &[ExcludedContextDelta],\n) -> Vec<StableRef> {\n    let mut references = Vec::with_capacity(included.len() + excluded.len());\n    for item in included {\n        if let Some(reference) = stable_ref_from_identity(&item.identity) {\n            references.push(reference);\n        }\n    }\n    for item in excluded {\n        if let Some(reference) = stable_ref_from_identity(&item.identity) {\n            references.push(reference);\n        }\n    }\n    references\n}\n\nfn stable_ref_from_identity(identity: &Identity) -> Option<StableRef> {\n    Some(match identity {\n        Identity::File(file) => StableRef::FileRef(file.clone()),\n        Identity::Symbol(symbol) => StableRef::SymbolRef(symbol.clone()),\n        Identity::Doc(_) => return None,\n        Identity::Section(section) => StableRef::DocSectionRef(section.clone()),\n        Identity::Event(event) => StableRef::EventRef(event.clone()),\n        Identity::Memory(memory) => StableRef::MemoryRef(memory.clone()),\n        Identity::ContextHandle(handle) => StableRef::ContextHandleRef(handle.clone()),\n    })\n}\n\nfn memory_id_from_identity(identity: &Identity) -> Option<MemoryId> {\n    match identity {\n        Identity::Memory(memory) => Some(memory.clone()),\n        _ => None,\n    }\n}\n\nfn first_memory_id(state: &WorkingMemoryState) -> Option<MemoryId> {\n    state\n        .selected_memories\n        .iter()\n        .find_map(|result| memory_id_from_identity(&result.identity))\n}\n\nfn first_selected_identity(state: &WorkingMemoryState) -> Option<Identity> {\n    state\n        .selected_memories\n        .first()\n        .map(|result| result.identity.clone())\n}\n\nfn compact_summary(\n    prefix: &str,\n    op_name: &str,\n    included: usize,\n    excluded: usize,\n) -> Result<CompactSummary, EventWriteError> {\n    CompactSummary::new(format!(\n        \"{prefix}: op={op_name} included={included} excluded={excluded}\"\n    ))\n    .map_err(|error| {\n        crate::events::EventStoreError::EnvelopeInvalid {\n            reason: error.to_string(),\n        }\n        .into()\n    })\n}\n","numLines":285,"startLine":1,"totalLines":285}}}
{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_01JizqbGGn679TwyPagzXEqL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HbhU2XmLUYE2cW6vAJja9z","name":"Read","input":{"file_path":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/working_memory/state_tests.rs"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":4444,"cache_read_input_tokens":123268,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4444},"output_tokens":40,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1b2121c5-8450-4d0d-9f66-0986877cae23","uuid":"e277f1ab-3e24-4f65-a3fc-d4ace0fee1d8","request_id":"req_011Cb7xshmkEEsaNyW4HTtHr"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HbhU2XmLUYE2cW6vAJja9z","type":"tool_result","content":"1\tuse std::collections::{BTreeMap, BTreeSet};\n2\t\n3\tuse rusqlite::{params, Connection};\n4\t\n5\tuse super::state::{\n6\t    canonical_state_json, initialize_schema, load_checkpoint, save_checkpoint,\n7\t    save_checkpoint_for_scope, state_hash, BudgetDecisions, CheckpointScope, ExcludedMemory,\n8\t    FailureRecord, Hypothesis, PlanRef, WorkingMemoryState, WorkingMemoryVerification,\n9\t    WORKING_MEMORY_STATE_VERSION,\n10\t};\n11\tuse crate::identity::{FileId, Identity, IdentityKind, MemoryId, SymbolId};\n12\tuse crate::memory::MemoryVerificationStatus;\n13\tuse crate::retrieval_v1::{\n14\t    schema::BundleResult, IntentClassification, IntentFeature, IntentFeatureKind, IntentLabel,\n15\t};\n16\t\n17\t#[test]\n18\tfn default_constructed_state_has_required_fields() {\n19\t    let state = WorkingMemoryState::default();\n20\t\n21\t    assert_eq!(state.task_statement, \"\");\n22\t    assert_eq!(state.interpreted_intent.primary_label, IntentLabel::Unknown);\n23\t    assert!(state.active_files.is_empty());\n24\t    assert!(state.active_symbols.is_empty());\n25\t    assert!(state.active_hypotheses.is_empty());\n26\t    assert!(state.active_failures.is_empty());\n27\t    assert!(state.current_plan.is_none());\n28\t    assert!(state.selected_memories.is_empty());\n29\t    assert!(state.excluded_memories.is_empty());\n30\t    assert_eq!(state.budget_decisions, BudgetDecisions::default());\n31\t    assert!(state.unresolved_questions.is_empty());\n32\t    assert_eq!(\n33\t        state.verification_status,\n34\t        WorkingMemoryVerification::default()\n35\t    );\n36\t}\n37\t\n38\t#[test]\n39\tfn serde_round_trips_state_without_data_loss() {\n40\t    let state = sample_state();\n41\t    let encoded = serde_json::to_string(&state).expect(\"state serializes\");\n42\t    let decoded: WorkingMemoryState = serde_json::from_str(&encoded).expect(\"state deserializes\");\n43\t\n44\t    assert_eq!(decoded, state);\n45\t}\n46\t\n47\t#[test]\n48\tfn save_then_load_checkpoint_returns_byte_identical_state() {\n49\t    let conn = initialized_connection();\n50\t    let state = sample_state();\n51\t    let scope = CheckpointScope::new(\"workspace-a\", \"session-a\", \"task-a\");\n52\t\n53\t    let id = save_checkpoint_for_scope(&state, \"before-compress\", &scope, &conn).expect(\"save\");\n54\t    let loaded = load_checkpoint(id, &conn).expect(\"load\");\n55\t\n56\t    assert_eq!(\n57\t        canonical_state_json(&loaded).unwrap(),\n58\t        canonical_state_json(&state).unwrap()\n59\t    );\n60\t    assert_eq!(loaded, state);\n61\t}\n62\t\n63\t#[test]\n64\tfn state_hash_matches_between_save_and_load() {\n65\t    let conn = initialized_connection();\n66\t    let state = sample_state();\n67\t    let id = save_checkpoint(&state, \"hash-check\", &conn).expect(\"save\");\n68\t    let stored_hash: String = conn\n69\t        .query_row(\n70\t            \"SELECT state_hash FROM working_memory_checkpoints WHERE checkpoint_id = ?1\",\n71\t            [id],\n72\t            |row| row.get(0),\n73\t        )\n74\t        .expect(\"stored hash\");\n75\t\n76\t    let loaded = load_checkpoint(id, &conn).expect(\"load\");\n77\t\n78\t    assert_eq!(stored_hash, state_hash(&state).expect(\"state hash\"));\n79\t    assert_eq!(stored_hash, state_hash(&loaded).expect(\"loaded state hash\"));\n80\t}\n81\t\n82\t#[test]\n83\tfn loading_checkpoint_with_unknown_state_version_is_rejected() {\n84\t    let conn = initialized_connection();\n85\t    let state = sample_state();\n86\t    let state_json = canonical_state_json(&state).expect(\"json\");\n87\t    let state_hash = state_hash(&state).expect(\"hash\");\n88\t    conn.execute(\n89\t        \"INSERT INTO working_memory_checkpoints\n90\t            (workspace_id, session_id, task_id, checkpoint_name, created_at,\n91\t             state_version, state_json, state_hash)\n92\t         VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)\",\n93\t        params![\n94\t            \"workspace-a\",\n95\t            \"session-a\",\n96\t            \"task-a\",\n97\t            \"future\",\n98\t            1_u64,\n99\t            WORKING_MEMORY_STATE_VERSION + 1,\n100\t            state_json,\n101\t            state_hash,\n102\t        ],\n103\t    )\n104\t    .expect(\"insert future checkpoint\");\n105\t\n106\t    let error = load_checkpoint(conn.last_insert_rowid(), &conn).expect_err(\"version rejected\");\n107\t\n108\t    assert!(error\n109\t        .to_string()\n110\t        .contains(\"Unknown working memory state_version\"));\n111\t}\n112\t\n113\t#[test]\n114\tfn excluded_memories_require_exclusion_reason() {\n115\t    let excluded = ExcludedMemory {\n116\t        result: sample_bundle_result(),\n117\t        exclusion_reason: \"stale after current retrieval\".to_string(),\n118\t    };\n119\t\n120\t    assert_eq!(excluded.exclusion_reason, \"stale after current retrieval\");\n121\t}\n122\t\n123\tfn initialized_connection() -> Connection {\n124\t    let conn = Connection::open_in_memory().expect(\"in-memory db opens\");\n125\t    initialize_schema(&conn).expect(\"schema initializes\");\n126\t    conn\n127\t}\n128\t\n129\tfn sample_state() -> WorkingMemoryState {\n130\t    let file = sample_file();\n131\t    let symbol = SymbolId {\n132\t        file: file.clone(),\n133\t        qualified_name: \"working_memory::state::WorkingMemoryState\".to_string(),\n134\t        byte_offset: 128,\n135\t        kind: \"struct\".to_string(),\n136\t    };\n137\t    let mut active_files = BTreeSet::new();\n138\t    active_files.insert(file.clone());\n139\t    let mut active_symbols = BTreeSet::new();\n140\t    active_symbols.insert(symbol.clone());\n141\t    let mut pinned_identities = BTreeSet::new();\n142\t    pinned_identities.insert(Identity::File(file));\n143\t    pinned_identities.insert(Identity::Symbol(symbol));\n144\t\n145\t    WorkingMemoryState {\n146\t        task_statement: \"Add working memory checkpoints\".to_string(),\n147\t        interpreted_intent: sample_intent(),\n148\t        active_files,\n149\t        active_symbols,\n150\t        active_hypotheses: vec![Hypothesis {\n151\t            text: \"Memory checkpoints need deterministic hashes\".to_string(),\n152\t            evidence_refs: vec![\"docs/plans/spec.md#5-working-memory\".to_string()],\n153\t            confidence: 0.92,\n154\t        }],\n155\t        active_failures: vec![FailureRecord {\n156\t            kind: \"test\".to_string(),\n157\t            message: \"checkpoint restore failed before schema existed\".to_string(),\n158\t            observed_at: 42,\n159\t            evidence_refs: vec![\"cargo test\".to_string()],\n160\t        }],\n161\t        current_plan: Some(PlanRef {\n162\t            plan_id: \"T34\".to_string(),\n163\t            version: 1,\n164\t        }),\n165\t        selected_memories: vec![sample_bundle_result()],\n166\t        excluded_memories: vec![ExcludedMemory {\n167\t            result: sample_bundle_result(),\n168\t            exclusion_reason: \"outside the task scope\".to_string(),\n169\t        }],\n170\t        budget_decisions: BudgetDecisions {\n171\t            token_cap: 4096,\n172\t            dropped_count: 2,\n173\t            truncated_results: 1,\n174\t            pinned_identities,\n175\t        },\n176\t        unresolved_questions: vec![\"Should restore expose checkpoint names?\".to_string()],\n177\t        verification_status: WorkingMemoryVerification {\n178\t            last_verified_at: Some(123),\n179\t            status: MemoryVerificationStatus::InReview,\n180\t            notes: vec![\"Round-trip verified\".to_string()],\n181\t        },\n182\t    }\n183\t}\n184\t\n185\tfn sample_intent() -> IntentClassification {\n186\t    let feature = IntentFeature {\n187\t        kind: IntentFeatureKind::ImperativeVerb,\n188\t        value: \"add\".to_string(),\n189\t    };\n190\t    let mut feature_scores = BTreeMap::