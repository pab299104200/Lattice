{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01895Zeq4ystVdqFMFfEwead","type":"tool_result","content":"1\t//! Working-memory checkpoint restore regressions.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## Phase 5: Working Memory` and `## 5. Working Memory` require\n5\t//! checkpoint save/load tests, including coherent restore and version checks.\n6\t\n7\tuse rusqlite::params;\n8\t\n9\tuse super::state::{\n10\t    canonical_state_json, load_checkpoint, save_checkpoint, state_hash, BudgetDecisions,\n11\t    WORKING_MEMORY_STATE_VERSION,\n12\t};\n13\tuse super::tests_common::{sample_bundle_result, sample_identity, sample_state, Harness, WORKSPACE};\n14\tuse crate::error::LatticeError;\n15\t\n16\t#[test]\n17\tfn checkpoint_round_trip_is_byte_identical() {\n18\t    let harness = Harness::new(Default::default());\n19\t    let state = sample_state();\n20\t\n21\t    let checkpoint_id = save_checkpoint(&state, \"before-compress\", &harness.conn).expect(\"save\");\n22\t    let loaded = load_checkpoint(checkpoint_id, &harness.conn).expect(\"load\");\n23\t\n24\t    assert_eq!(canonical_state_json(&loaded).unwrap(), canonical_state_json(&state).unwrap());\n25\t    assert_eq!(state_hash(&loaded).unwrap(), state_hash(&state).unwrap());\n26\t}\n27\t\n28\t#[test]\n29\tfn checkpoints_with_same_name_get_distinct_ids_and_round_trip() {\n30\t    let harness = Harness::new(Default::default());\n31\t    let state = sample_state();\n32\t\n33\t    let first = save_checkpoint(&state, \"same-name\", &harness.conn).expect(\"first\");\n34\t    let second = save_checkpoint(&state, \"same-name\", &harness.conn).expect(\"second\");\n35\t\n36\t    assert!(second > first);\n37\t    assert_eq!(load_checkpoint(first, &harness.conn).unwrap(), state);\n38\t    assert_eq!(load_checkpoint(second, &harness.conn).unwrap(), state);\n39\t}\n40\t\n41\t#[test]\n42\tfn loading_unknown_checkpoint_id_returns_storage_error() {\n43\t    let harness = Harness::new(Default::default());\n44\t\n45\t    let error = load_checkpoint(999_999, &harness.conn).expect_err(\"unknown checkpoint\");\n46\t\n47\t    assert!(matches!(error, LatticeError::Storage(_)));\n48\t    assert!(error.to_string().contains(\"was not found\"));\n49\t}\n50\t\n51\t#[test]\n52\tfn loading_newer_state_version_is_rejected_clearly() {\n53\t    let harness = Harness::new(Default::default());\n54\t    let state = sample_state();\n55\t    let state_json = canonical_state_json(&state).expect(\"json\");\n56\t    let state_hash = state_hash(&state).expect(\"hash\");\n57\t    harness.conn.execute(\n58\t        \"INSERT INTO working_memory_checkpoints\n59\t            (workspace_id, session_id, task_id, checkpoint_name, created_at,\n60\t             state_version, state_json, state_hash)\n61\t         VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)\",\n62\t        params![WORKSPACE, \"session-a\", \"task-a\", \"future\", 1_u64, WORKING_MEMORY_STATE_VERSION + 1, state_json, state_hash],\n63\t    ).expect(\"insert\");\n64\t\n65\t    let error = load_checkpoint(harness.conn.last_insert_rowid(), &harness.conn).expect_err(\"future version\");\n66\t\n67\t    assert!(matches!(error, LatticeError::Storage(_)));\n68\t    assert!(error.to_string().contains(\"Unknown working memory state_version\"));\n69\t}\n70\t\n71\t#[test]\n72\tfn loading_checkpoint_restores_selected_excluded_and_budget_together() {\n73\t    let harness = Harness::new(Default::default());\n74\t    let mut original = sample_state();\n75\t    original.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.9)];\n76\t    original.excluded_memories = vec![super::state::ExcludedMemory {\n77\t        result: sample_bundle_result(\"memory-b\", 0.4),\n78\t        exclusion_reason: \"compressed: budget=80 tokens\".to_string(),\n79\t    }];\n80\t    original.budget_decisions = BudgetDecisions {\n81\t        token_cap: 80,\n82\t        dropped_count: 1,\n83\t        truncated_results: 1,\n84\t        pinned_identities: [sample_identity(\"memory-a\")].into_iter().collect(),\n85\t    };\n86\t    let checkpoint_id = save_checkpoint(&original, \"coherent\", &harness.conn).expect(\"save\");\n87\t    let mut mutated = original.clone();\n88\t    mutated.selected_memories.clear();\n89\t    mutated.excluded_memories.clear();\n90\t    mutated.budget_decisions = BudgetDecisions::default();\n91\t\n92\t    let restored = load_checkpoint(checkpoint_id, &harness.conn).expect(\"restore\");\n93\t\n94\t    assert_ne!(restored.selected_memories, mutated.selected_memories);\n95\t    assert_ne!(restored.excluded_memories, mutated.excluded_memories);\n96\t    assert_ne!(restored.budget_decisions, mutated.budget_decisions);\n97\t    assert_eq!(restored, original);\n98\t}\n99\t"}]},"parent_tool_use_id":null,"session_id":"1b2121c5-8450-4d0d-9f66-0986877cae23","uuid":"a5daae9f-8034-49af-89c2-a0abbe7015e1","timestamp":"2026-05-17T10:14:07.020Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/working_memory/checkpoint_tests.rs","content":"//! Working-memory checkpoint restore regressions.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 5: Working Memory` and `## 5. Working Memory` require\n//! checkpoint save/load tests, including coherent restore and version checks.\n\nuse rusqlite::params;\n\nuse super::state::{\n    canonical_state_json, load_checkpoint, save_checkpoint, state_hash, BudgetDecisions,\n    WORKING_MEMORY_STATE_VERSION,\n};\nuse super::tests_common::{sample_bundle_result, sample_identity, sample_state, Harness, WORKSPACE};\nuse crate::error::LatticeError;\n\n#[test]\nfn checkpoint_round_trip_is_byte_identical() {\n    let harness = Harness::new(Default::default());\n    let state = sample_state();\n\n    let checkpoint_id = save_checkpoint(&state, \"before-compress\", &harness.conn).expect(\"save\");\n    let loaded = load_checkpoint(checkpoint_id, &harness.conn).expect(\"load\");\n\n    assert_eq!(canonical_state_json(&loaded).unwrap(), canonical_state_json(&state).unwrap());\n    assert_eq!(state_hash(&loaded).unwrap(), state_hash(&state).unwrap());\n}\n\n#[test]\nfn checkpoints_with_same_name_get_distinct_ids_and_round_trip() {\n    let harness = Harness::new(Default::default());\n    let state = sample_state();\n\n    let first = save_checkpoint(&state, \"same-name\", &harness.conn).expect(\"first\");\n    let second = save_checkpoint(&state, \"same-name\", &harness.conn).expect(\"second\");\n\n    assert!(second > first);\n    assert_eq!(load_checkpoint(first, &harness.conn).unwrap(), state);\n    assert_eq!(load_checkpoint(second, &harness.conn).unwrap(), state);\n}\n\n#[test]\nfn loading_unknown_checkpoint_id_returns_storage_error() {\n    let harness = Harness::new(Default::default());\n\n    let error = load_checkpoint(999_999, &harness.conn).expect_err(\"unknown checkpoint\");\n\n    assert!(matches!(error, LatticeError::Storage(_)));\n    assert!(error.to_string().contains(\"was not found\"));\n}\n\n#[test]\nfn loading_newer_state_version_is_rejected_clearly() {\n    let harness = Harness::new(Default::default());\n    let state = sample_state();\n    let state_json = canonical_state_json(&state).expect(\"json\");\n    let state_hash = state_hash(&state).expect(\"hash\");\n    harness.conn.execute(\n        \"INSERT INTO working_memory_checkpoints\n            (workspace_id, session_id, task_id, checkpoint_name, created_at,\n             state_version, state_json, state_hash)\n         VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)\",\n        params![WORKSPACE, \"session-a\", \"task-a\", \"future\", 1_u64, WORKING_MEMORY_STATE_VERSION + 1, state_json, state_hash],\n    ).expect(\"insert\");\n\n    let error = load_checkpoint(harness.conn.last_insert_rowid(), &harness.conn).expect_err(\"future version\");\n\n    assert!(matches!(error, LatticeError::Storage(_)));\n    assert!(error.to_string().contains(\"Unknown working memory state_version\"));\n}\n\n#[test]\nfn loading_checkpoint_restores_selected_excluded_and_budget_together() {\n    let harness = Harness::new(Default::default());\n    let mut original = sample_state();\n    original.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.9)];\n    original.excluded_memories = vec![super::state::ExcludedMemory {\n        result: sample_bundle_result(\"memory-b\", 0.4),\n        exclusion_reason: \"compressed: budget=80 tokens\".to_string(),\n    }];\n    original.budget_decisions = BudgetDecisions {\n        token_cap: 80,\n        dropped_count: 1,\n        truncated_results: 1,\n        pinned_identities: [sample_identity(\"memory-a\")].into_iter().collect(),\n    };\n    let checkpoint_id = save_checkpoint(&original, \"coherent\", &harness.conn).expect(\"save\");\n    let mut mutated = original.clone();\n    mutated.selected_memories.clear();\n    mutated.excluded_memories.clear();\n    mutated.budget_decisions = BudgetDecisions::default();\n\n    let restored = load_checkpoint(checkpoint_id, &harness.conn).expect(\"restore\");\n\n    assert_ne!(restored.selected_memories, mutated.selected_memories);\n    assert_ne!(restored.excluded_memories, mutated.excluded_memories);\n    assert_ne!(restored.budget_decisions, mutated.budget_decisions);\n    assert_eq!(restored, original);\n}\n","numLines":99,"startLine":1,"totalLines":99}}}
