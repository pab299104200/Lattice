{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ERfPmGMxsqV5RwDUWDeh79","type":"tool_result","content":"1\tuse lattice_core::working_memory::{CheckpointId, WorkingMemoryState, WorkingMemorySummary};\n2\tuse serde::{Deserialize, Serialize};\n3\tuse serde_json::{json, Value};\n4\t\n5\t#[derive(Debug, Clone, PartialEq, Eq, Deserialize)]\n6\tpub struct InspectWorkingMemoryArgs {\n7\t    pub task_id: String,\n8\t    #[serde(default)]\n9\t    pub mode: InspectWorkingMemoryMode,\n10\t    #[serde(default)]\n11\t    pub include_excluded: bool,\n12\t}\n13\t\n14\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize)]\n15\t#[serde(rename_all = \"snake_case\")]\n16\tpub enum InspectWorkingMemoryMode {\n17\t    #[default]\n18\t    Compact,\n19\t    Diagnostic,\n20\t}\n21\t\n22\t#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\n23\tpub struct InspectWorkingMemoryCompactResponse {\n24\t    pub task_id: String,\n25\t    pub mode: &'static str,\n26\t    pub checkpoint_id: Option<CheckpointId>,\n27\t    pub expansion_handle: String,\n28\t    pub summary: WorkingMemorySummary,\n29\t}\n30\t\n31\t#[derive(Debug, Clone, PartialEq, Serialize)]\n32\tpub struct InspectWorkingMemoryDiagnosticResponse {\n33\t    pub task_id: String,\n34\t    pub mode: &'static str,\n35\t    pub checkpoint_id: Option<CheckpointId>,\n36\t    pub expansion_handle: String,\n37\t    pub state: WorkingMemoryState,\n38\t}\n39\t\n40\tpub fn tool_definition() -> Value {\n41\t    json!({\n42\t        \"name\": \"inspect_working_memory\",\n43\t        \"description\": \"Inspect the current working-memory state for a task, including compact summary and diagnostic state views with an expansion handle.\",\n44\t        \"inputSchema\": {\n45\t            \"type\": \"object\",\n46\t            \"properties\": {\n47\t                \"task_id\": {\n48\t                    \"type\": \"string\",\n49\t                    \"description\": \"Task id whose working memory should be inspected\"\n50\t                },\n51\t                \"mode\": {\n52\t                    \"type\": \"string\",\n53\t                    \"description\": \"Response mode: 'compact' (default) returns a summary; 'diagnostic' returns the full state snapshot\",\n54\t                    \"enum\": [\"compact\", \"diagnostic\"],\n55\t                    \"default\": \"compact\"\n56\t                },\n57\t                \"include_excluded\": {\n58\t                    \"type\": \"boolean\",\n59\t                    \"description\": \"When true, include excluded memories and reasons in diagnostic output\",\n60\t                    \"default\": false\n61\t                }\n62\t            },\n63\t            \"required\": [\"task_id\"]\n64\t        }\n65\t    })\n66\t}\n67\t\n68\tpub fn parse_args(args: &Value) -> Result<InspectWorkingMemoryArgs, String> {\n69\t    serde_json::from_value(args.clone())\n70\t        .map_err(|error| format!(\"Invalid inspect_working_memory arguments: {error}\"))\n71\t}\n72\t\n73\tpub fn compact_response_value(\n74\t    task_id: String,\n75\t    checkpoint_id: Option<CheckpointId>,\n76\t    expansion_handle: String,\n77\t    summary: WorkingMemorySummary,\n78\t) -> Result<Value, String> {\n79\t    serde_json::to_value(InspectWorkingMemoryCompactResponse {\n80\t        task_id,\n81\t        mode: \"compact\",\n82\t        checkpoint_id,\n83\t        expansion_handle,\n84\t        summary,\n85\t    })\n86\t    .map_err(|error| format!(\"Failed to serialize compact working memory response: {error}\"))\n87\t}\n88\t\n89\tpub fn diagnostic_response_value(\n90\t    task_id: String,\n91\t    checkpoint_id: Option<CheckpointId>,\n92\t    expansion_handle: String,\n93\t    state: WorkingMemoryState,\n94\t) -> Result<Value, String> {\n95\t    serde_json::to_value(InspectWorkingMemoryDiagnosticResponse {\n96\t        task_id,\n97\t        mode: \"diagnostic\",\n98\t        checkpoint_id,\n99\t        expansion_handle,\n100\t        state,\n101\t    })\n102\t    .map_err(|error| format!(\"Failed to serialize diagnostic working memory response: {error}\"))\n103\t}\n104\t"}]},"parent_tool_use_id":null,"session_id":"1b2121c5-8450-4d0d-9f66-0986877cae23","uuid":"46cd8857-62c9-4115-97fd-8544085135be","timestamp":"2026-05-17T10:14:14.888Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/working_memory_tool.rs","content":"use lattice_core::working_memory::{CheckpointId, WorkingMemoryState, WorkingMemorySummary};\nuse serde::{Deserialize, Serialize};\nuse serde_json::{json, Value};\n\n#[derive(Debug, Clone, PartialEq, Eq, Deserialize)]\npub struct InspectWorkingMemoryArgs {\n    pub task_id: String,\n    #[serde(default)]\n    pub mode: InspectWorkingMemoryMode,\n    #[serde(default)]\n    pub include_excluded: bool,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum InspectWorkingMemoryMode {\n    #[default]\n    Compact,\n    Diagnostic,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\npub struct InspectWorkingMemoryCompactResponse {\n    pub task_id: String,\n    pub mode: &'static str,\n    pub checkpoint_id: Option<CheckpointId>,\n    pub expansion_handle: String,\n    pub summary: WorkingMemorySummary,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize)]\npub struct InspectWorkingMemoryDiagnosticResponse {\n    pub task_id: String,\n    pub mode: &'static str,\n    pub checkpoint_id: Option<CheckpointId>,\n    pub expansion_handle: String,\n    pub state: WorkingMemoryState,\n}\n\npub fn tool_definition() -> Value {\n    json!({\n        \"name\": \"inspect_working_memory\",\n        \"description\": \"Inspect the current working-memory state for a task, including compact summary and diagnostic state views with an expansion handle.\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"task_id\": {\n                    \"type\": \"string\",\n                    \"description\": \"Task id whose working memory should be inspected\"\n                },\n                \"mode\": {\n                    \"type\": \"string\",\n                    \"description\": \"Response mode: 'compact' (default) returns a summary; 'diagnostic' returns the full state snapshot\",\n                    \"enum\": [\"compact\", \"diagnostic\"],\n                    \"default\": \"compact\"\n                },\n                \"include_excluded\": {\n                    \"type\": \"boolean\",\n                    \"description\": \"When true, include excluded memories and reasons in diagnostic output\",\n                    \"default\": false\n                }\n            },\n            \"required\": [\"task_id\"]\n        }\n    })\n}\n\npub fn parse_args(args: &Value) -> Result<InspectWorkingMemoryArgs, String> {\n    serde_json::from_value(args.clone())\n        .map_err(|error| format!(\"Invalid inspect_working_memory arguments: {error}\"))\n}\n\npub fn compact_response_value(\n    task_id: String,\n    checkpoint_id: Option<CheckpointId>,\n    expansion_handle: String,\n    summary: WorkingMemorySummary,\n) -> Result<Value, String> {\n    serde_json::to_value(InspectWorkingMemoryCompactResponse {\n        task_id,\n        mode: \"compact\",\n        checkpoint_id,\n        expansion_handle,\n        summary,\n    })\n    .map_err(|error| format!(\"Failed to serialize compact working memory response: {error}\"))\n}\n\npub fn diagnostic_response_value(\n    task_id: String,\n    checkpoint_id: Option<CheckpointId>,\n    expansion_handle: String,\n    state: WorkingMemoryState,\n) -> Result<Value, String> {\n    serde_json::to_value(InspectWorkingMemoryDiagnosticResponse {\n        task_id,\n        mode: \"diagnostic\",\n        checkpoint_id,\n        expansion_handle,\n        state,\n    })\n    .map_err(|error| format!(\"Failed to serialize diagnostic working memory response: {error}\"))\n}\n","numLines":104,"startLine":1,"totalLines":104}}}
