{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QbhQGsn242ePEdMadd34Cd","type":"tool_result","content":"1\t//! Working-memory budget, pin, and eviction regressions.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## Phase 5: Working Memory` and `## 5. Working Memory` require explicit\n5\t//! tests for token budgets, pinned context, eviction, and excluded-context\n6\t//! tracking.\n7\t\n8\tuse std::cell::RefCell;\n9\t\n10\tuse super::event_hooks::{emit_memory_retrieved, MutationEventSummary, WorkingMemoryEventAppender, WorkingMemoryEventContext};\n11\tuse super::operations::{\n12\t    compress, evict, pin, retrieve, CompressArgs, EvictArgs, PinArgs, RetrievalExecution,\n13\t};\n14\tuse super::tests_common::{\n15\t    file_identity, huge_bundle_result, long_bundle_result, retrieval_args, sample_bundle,\n16\t    sample_bundle_result, sample_identity, sample_state, FakeRetriever, Harness,\n17\t};\n18\tuse crate::events::{Actor, BranchRef, EventWriteError, FlushPolicy, PartialEnvelope, SessionId, TaskId};\n19\t\n20\t#[test]\n21\tfn compress_honors_token_budget_and_updates_budget_decisions() {\n22\t    let harness = Harness::new(FakeRetriever::default());\n23\t    let mut state = sample_state();\n24\t    state.selected_memories = vec![\n25\t        huge_bundle_result(\"memory-a\", 0.9),\n26\t        huge_bundle_result(\"memory-b\", 0.8),\n27\t        huge_bundle_result(\"memory-c\", 0.7),\n28\t    ];\n29\t\n30\t    let outcome = compress(&mut state, CompressArgs { token_budget: 120 }, &harness.ctx()).expect(\"compress\");\n31\t\n32\t    assert!(outcome.budget_report.estimated_tokens <= 120);\n33\t    assert_eq!(state.budget_decisions.token_cap, 120);\n34\t    assert!(outcome.budget_report.truncated);\n35\t}\n36\t\n37\t#[test]\n38\tfn retrieve_over_budget_bundle_keeps_truncated_report() {\n39\t    let execution = RetrievalExecution {\n40\t        bundle: sample_bundle(vec![sample_bundle_result(\"memory-a\", 0.9)], 96, true, 1, 0),\n41\t        excluded_memories: Vec::new(),\n42\t    };\n43\t    let harness = Harness::new(FakeRetriever::with_retrieve_execution(execution));\n44\t    let mut state = sample_state();\n45\t\n46\t    let outcome = retrieve(&mut state, retrieval_args(), &harness.ctx()).expect(\"retrieve\");\n47\t\n48\t    assert!(outcome.bundle.budget_report.truncated);\n49\t    assert_eq!(state.budget_decisions.token_cap, 96);\n50\t    assert_eq!(state.budget_decisions.truncated_results, 1);\n51\t}\n52\t\n53\t#[test]\n54\tfn retrieve_moves_truncated_results_to_excluded_with_budget_reason() {\n55\t    let execution = RetrievalExecution {\n56\t        bundle: sample_bundle(vec![sample_bundle_result(\"memory-a\", 0.9)], 64, true, 0, 1),\n57\t        excluded_memories: vec![super::state::ExcludedMemory {\n58\t            result: sample_bundle_result(\"memory-b\", 0.5),\n59\t            exclusion_reason: \"compressed: budget=64 tokens\".to_string(),\n60\t        }],\n61\t    };\n62\t    let harness = Harness::new(FakeRetriever::with_retrieve_execution(execution));\n63\t    let mut state = sample_state();\n64\t\n65\t    let outcome = retrieve(&mut state, retrieval_args(), &harness.ctx()).expect(\"retrieve\");\n66\t\n67\t    assert_eq!(outcome.excluded_count, 1);\n68\t    assert_eq!(state.excluded_memories[0].exclusion_reason, \"compressed: budget=64 tokens\");\n69\t}\n70\t\n71\t#[test]\n72\tfn budget_changes_only_affect_subsequent_operations() {\n73\t    let mut state = sample_state();\n74\t    retrieve(&mut state, retrieval_args(), &Harness::new(FakeRetriever::default()).ctx()).expect(\"first retrieve\");\n75\t    let second = RetrievalExecution {\n76\t        bundle: sample_bundle(vec![sample_bundle_result(\"memory-d\", 0.9)], 80, true, 0, 1),\n77\t        excluded_memories: vec![super::state::ExcludedMemory {\n78\t            result: sample_bundle_result(\"memory-e\", 0.4),\n79\t            exclusion_reason: \"compressed: budget=80 tokens\".to_string(),\n80\t        }],\n81\t    };\n82\t    retrieve(&mut state, retrieval_args(), &Harness::new(FakeRetriever::with_retrieve_execution(second)).ctx()).expect(\"second retrieve\");\n83\t\n84\t    let reasons = state.excluded_memories.iter().map(|item| item.exclusion_reason.as_str()).collect::<Vec<_>>();\n85\t    assert!(reasons.contains(&\"compressed: budget=240 tokens\"));\n86\t    assert!(reasons.contains(&\"compressed: budget=80 tokens\"));\n87\t}\n88\t\n89\t#[test]\n90\tfn huge_candidate_set_is_bounded_by_compress() {\n91\t    let harness = Harness::new(FakeRetriever::default());\n92\t    let mut state = sample_state();\n93\t    state.selected_memories = (0..12)\n94\t        .map(|index| huge_bundle_result(&format!(\"memory-{index}\"), 1.0 - (index as f32 * 0.01)))\n95\t        .collect();\n96\t\n97\t    let outcome = compress(&mut state, CompressArgs { token_budget: 160 }, &harness.ctx()).expect(\"compress\");\n98\t\n99\t    assert!(outcome.removed_count > 0);\n100\t    assert!(outcome.budget_report.estimated_tokens <= 160);\n101\t}\n102\t\n103\t#[test]\n104\tfn pin_survives_compress() {\n105\t    let harness = Harness::new(FakeRetriever::default());\n106\t    let mut state = sample_state();\n107\t    let pinned = file_identity(\"src/pinned.rs\");\n108\t    state.selected_memories = vec![\n109\t        long_bundle_result(pinned.clone(), \"Pinned\", 0.9),\n110\t        long_bundle_result(file_identity(\"src/other-a.rs\"), \"Other A\", 0.8),\n111\t        long_bundle_result(file_identity(\"src/other-b.rs\"), \"Other B\", 0.7),\n112\t    ];\n113\t    pin(&mut state, PinArgs { identities: vec![pinned.clone()] }, &harness.ctx()).expect(\"pin\");\n114\t\n115\t    compress(&mut state, CompressArgs { token_budget: 70 }, &harness.ctx()).expect(\"compress\");\n116\t\n117\t    assert!(state.selected_memories.iter().any(|result| result.identity == pinned));\n118\t}\n119\t\n120\t#[test]\n121\tfn pin_twice_is_idempotent() {\n122\t    let harness = Harness::new(FakeRetriever::default());\n123\t    let mut state = sample_state();\n124\t    let pinned = sample_identity(\"memory-a\");\n125\t\n126\t    let first = pin(&mut state, PinArgs { identities: vec![pinned.clone()] }, &harness.ctx()).expect(\"first pin\");\n127\t    let second = pin(&mut state, PinArgs { identities: vec![pinned] }, &harness.ctx()).expect(\"second pin\");\n128\t\n129\t    assert_eq!(first.added_count, 1);\n130\t    assert_eq!(second.added_count, 0);\n131\t}\n132\t\n133\t#[test]\n134\tfn evict_refuses_pinned_identity_without_force() {\n135\t    let harness = Harness::new(FakeRetriever::default());\n136\t    let mut state = sample_state();\n137\t    let pinned = sample_identity(\"memory-a\");\n138\t    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n139\t    state.budget_decisions.pinned_identities.insert(pinned.clone());\n140\t\n141\t    let error = evict(&mut state, EvictArgs { identities: vec![pinned], reason: \"manual trim\".to_string(), force: false }, &harness.ctx()).expect_err(\"pinned eviction should fail\");\n142\t\n143\t    assert!(error.to_string().contains(\"Cannot evict pinned identity\"));\n144\t}\n145\t\n146\t#[test]\n147\tfn forced_evict_records_force_in_exclusion_reason() {\n148\t    let harness = Harness::new(FakeRetriever::default());\n149\t    let mut state = sample_state();\n150\t    let pinned = sample_identity(\"memory-a\");\n151\t    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n152\t    state.budget_decisions.pinned_identities.insert(pinned.clone());\n153\t\n154\t    evict(&mut state, EvictArgs { identities: vec![pinned], reason: \"manual trim\".to_string(), force: true }, &harness.ctx()).expect(\"forced evict\");\n155\t\n156\t    assert_eq!(state.excluded_memories[0].exclusion_reason, \"evicted: force=true; manual trim\");\n157\t}\n158\t\n159\t#[test]\n160\tfn pin_survives_checkpoint_round_trip() {\n161\t    let harness = Harness::new(FakeRetriever::default());\n162\t    let mut state = sample_state();\n163\t    let pinned = file_identity(\"src/pinned.rs\");\n164\t    state.budget_decisions.pinned_identities.insert(pinned.clone());\n165\t\n166\t    let checkpoint = super::operations::checkpoint(&mut state, super::operations::CheckpointArgs { name: \"pins\".to_string() }, &harness.ctx()).expect(\"checkpoint\");\n167\t    let loaded = super::state::load_checkpoint(checkpoint.checkpoint_id, &harness.conn).expect(\"load checkpoint\");\n168\t\n169\t    assert!(loaded.budget_decisions.pinned_identities.contains(&pinned));\n170\t}\n171\t\n172\t#[test]\n173\tfn evict_present_identity_moves_it_to_excluded_with_reason() {\n174\t    let harness = Harness::new(FakeRetriever::default());\n175\t    let mut state = sample_state();\n176\t    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n177\t\n178\t    evict(&mut state, EvictArgs { identities: vec![sample_identity(\"memory-a\")], reason: \"operator request\".to_string(), force: false }, &harness.ctx()).expect(\"evict\");\n179\t\n180\t    assert_eq!(state.excluded_memories[0].exclusion_reason, \"evicted: operator request\");\n181\t}\n182\t\n183\t#[test]\n184\tfn evict_absent_identity_is_a_documented_no_op() {\n185\t    let harness = Harness::new(FakeRetriever::default());\n186\t    let mut state = sample_state();\n187\t\n188\t    let outcome = evict(&mut state, EvictArgs { identities: vec![sample_identity(\"missing\")], reason: \"operator request\".to_string(), force: false }, &harness.ctx()).expect(\"evict\");\n189\t\n190\t    assert_eq!(outcome.evicted_count, 0);\n191\t    assert_eq!(outcome.skipped_absent_count, 1);\n192\t}\n193\t\n194\t#[test]\n195\tfn evict_no_op_emits_no_mutation_or_event() {\n196\t    let harness = Harness::new(FakeRetriever::default());\n197\t    let mut state = sample_state();\n198\t    let before = state.clone();\n199\t    evict(&mut state, EvictArgs { identities: vec![sample_identity(\"missing\")], reason: \"operator request\".to_string(), force: false }, &harness.ctx()).expect(\"evict\");\n200\t    let writer = NoopWriter::default();\n201\t    let summary = MutationEventSummary { op_name: \"evict\".to_string(), summary: \"evicted=0 requested=1\".to_string() };\n202\t\n203\t    let event = emit_memory_retrieved(&before, &state, &summary, &event_context(), &writer).expect(\"emit\");\n204\t\n205\t    assert!(harness.observer.records.borrow().is_empty());\n206\t    assert!(event.is_none());\n207\t}\n208\t\n209\t#[test]\n210\tfn evicted_identity_can_be_retrieved_again_in_same_session() {\n211\t    let mut state = sample_state();\n212\t    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n213\t    evict(&mut state, EvictArgs { identities: vec![sample_identity(\"memory-a\")], reason: \"operator request\".to_string(), force: false }, &Harness::new(FakeRetriever::default()).ctx()).expect(\"evict\");\n214\t    let retrieval = RetrievalExecution {\n215\t        bundle: sample_bundle(vec![sample_bundle_result(\"memory-a\", 0.9)], 96, false, 0, 0),\n216\t        excluded_memories: Vec::new(),\n217\t    };\n218\t    retrieve(&mut state, retrieval_args(), &Harness::new(FakeRetriever::with_retrieve_execution(retrieval)).ctx()).expect(\"retrieve\");\n219\t\n220\t    assert!(state.selected_memories.iter().any(|result| result.identity == sample_identity(\"memory-a\")));\n221\t}\n222\t\n223\t#[derive(Default)]\n224\tstruct NoopWriter {\n225\t    appended: RefCell<usize>,\n226\t}\n227\t\n228\timpl WorkingMemoryEventAppender for NoopWriter {\n229\t    fn append(\n230\t        &self,\n231\t        _envelope: PartialEnvelope,\n232\t        _flush_policy: FlushPolicy,\n233\t    ) -> Result<crate::identity::EventId, EventWriteError> {\n234\t        *self.appended.borrow_mut() += 1;\n235\t        panic!(\"no event should be appended for a no-op mutation\");\n236\t    }\n237\t}\n238\t\n239\tfn event_context() -> WorkingMemoryEventContext {\n240\t    WorkingMemoryEventContext {\n241\t        workspace_id: \"workspace-test\".to_string(),\n242\t        branch: BranchRef { name: \"test\".to_string() },\n243\t        session_id: SessionId { value: \"session-test\".to_string() },\n244\t        task_id: TaskId { value: \"task-working-memory\".to_string() },\n245\t        actor: Actor::Daemon,\n246\t    }\n247\t}\n248\t"}]},"parent_tool_use_id":null,"session_id":"1b2121c5-8450-4d0d-9f66-0986877cae23","uuid":"78db9b85-6b46-4cba-a9be-e41def709cd8","timestamp":"2026-05-17T10:14:04.046Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/working_memory/budget_tests.rs","content":"//! Working-memory budget, pin, and eviction regressions.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 5: Working Memory` and `## 5. Working Memory` require explicit\n//! tests for token budgets, pinned context, eviction, and excluded-context\n//! tracking.\n\nuse std::cell::RefCell;\n\nuse super::event_hooks::{emit_memory_retrieved, MutationEventSummary, WorkingMemoryEventAppender, WorkingMemoryEventContext};\nuse super::operations::{\n    compress, evict, pin, retrieve, CompressArgs, EvictArgs, PinArgs, RetrievalExecution,\n};\nuse super::tests_common::{\n    file_identity, huge_bundle_result, long_bundle_result, retrieval_args, sample_bundle,\n    sample_bundle_result, sample_identity, sample_state, FakeRetriever, Harness,\n};\nuse crate::events::{Actor, BranchRef, EventWriteError, FlushPolicy, PartialEnvelope, SessionId, TaskId};\n\n#[test]\nfn compress_honors_token_budget_and_updates_budget_decisions() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    state.selected_memories = vec![\n        huge_bundle_result(\"memory-a\", 0.9),\n        huge_bundle_result(\"memory-b\", 0.8),\n        huge_bundle_result(\"memory-c\", 0.7),\n    ];\n\n    let outcome = compress(&mut state, CompressArgs { token_budget: 120 }, &harness.ctx()).expect(\"compress\");\n\n    assert!(outcome.budget_report.estimated_tokens <= 120);\n    assert_eq!(state.budget_decisions.token_cap, 120);\n    assert!(outcome.budget_report.truncated);\n}\n\n#[test]\nfn retrieve_over_budget_bundle_keeps_truncated_report() {\n    let execution = RetrievalExecution {\n        bundle: sample_bundle(vec![sample_bundle_result(\"memory-a\", 0.9)], 96, true, 1, 0),\n        excluded_memories: Vec::new(),\n    };\n    let harness = Harness::new(FakeRetriever::with_retrieve_execution(execution));\n    let mut state = sample_state();\n\n    let outcome = retrieve(&mut state, retrieval_args(), &harness.ctx()).expect(\"retrieve\");\n\n    assert!(outcome.bundle.budget_report.truncated);\n    assert_eq!(state.budget_decisions.token_cap, 96);\n    assert_eq!(state.budget_decisions.truncated_results, 1);\n}\n\n#[test]\nfn retrieve_moves_truncated_results_to_excluded_with_budget_reason() {\n    let execution = RetrievalExecution {\n        bundle: sample_bundle(vec![sample_bundle_result(\"memory-a\", 0.9)], 64, true, 0, 1),\n        excluded_memories: vec![super::state::ExcludedMemory {\n            result: sample_bundle_result(\"memory-b\", 0.5),\n            exclusion_reason: \"compressed: budget=64 tokens\".to_string(),\n        }],\n    };\n    let harness = Harness::new(FakeRetriever::with_retrieve_execution(execution));\n    let mut state = sample_state();\n\n    let outcome = retrieve(&mut state, retrieval_args(), &harness.ctx()).expect(\"retrieve\");\n\n    assert_eq!(outcome.excluded_count, 1);\n    assert_eq!(state.excluded_memories[0].exclusion_reason, \"compressed: budget=64 tokens\");\n}\n\n#[test]\nfn budget_changes_only_affect_subsequent_operations() {\n    let mut state = sample_state();\n    retrieve(&mut state, retrieval_args(), &Harness::new(FakeRetriever::default()).ctx()).expect(\"first retrieve\");\n    let second = RetrievalExecution {\n        bundle: sample_bundle(vec![sample_bundle_result(\"memory-d\", 0.9)], 80, true, 0, 1),\n        excluded_memories: vec![super::state::ExcludedMemory {\n            result: sample_bundle_result(\"memory-e\", 0.4),\n            exclusion_reason: \"compressed: budget=80 tokens\".to_string(),\n        }],\n    };\n    retrieve(&mut state, retrieval_args(), &Harness::new(FakeRetriever::with_retrieve_execution(second)).ctx()).expect(\"second retrieve\");\n\n    let reasons = state.excluded_memories.iter().map(|item| item.exclusion_reason.as_str()).collect::<Vec<_>>();\n    assert!(reasons.contains(&\"compressed: budget=240 tokens\"));\n    assert!(reasons.contains(&\"compressed: budget=80 tokens\"));\n}\n\n#[test]\nfn huge_candidate_set_is_bounded_by_compress() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    state.selected_memories = (0..12)\n        .map(|index| huge_bundle_result(&format!(\"memory-{index}\"), 1.0 - (index as f32 * 0.01)))\n        .collect();\n\n    let outcome = compress(&mut state, CompressArgs { token_budget: 160 }, &harness.ctx()).expect(\"compress\");\n\n    assert!(outcome.removed_count > 0);\n    assert!(outcome.budget_report.estimated_tokens <= 160);\n}\n\n#[test]\nfn pin_survives_compress() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    let pinned = file_identity(\"src/pinned.rs\");\n    state.selected_memories = vec![\n        long_bundle_result(pinned.clone(), \"Pinned\", 0.9),\n        long_bundle_result(file_identity(\"src/other-a.rs\"), \"Other A\", 0.8),\n        long_bundle_result(file_identity(\"src/other-b.rs\"), \"Other B\", 0.7),\n    ];\n    pin(&mut state, PinArgs { identities: vec![pinned.clone()] }, &harness.ctx()).expect(\"pin\");\n\n    compress(&mut state, CompressArgs { token_budget: 70 }, &harness.ctx()).expect(\"compress\");\n\n    assert!(state.selected_memories.iter().any(|result| result.identity == pinned));\n}\n\n#[test]\nfn pin_twice_is_idempotent() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    let pinned = sample_identity(\"memory-a\");\n\n    let first = pin(&mut state, PinArgs { identities: vec![pinned.clone()] }, &harness.ctx()).expect(\"first pin\");\n    let second = pin(&mut state, PinArgs { identities: vec![pinned] }, &harness.ctx()).expect(\"second pin\");\n\n    assert_eq!(first.added_count, 1);\n    assert_eq!(second.added_count, 0);\n}\n\n#[test]\nfn evict_refuses_pinned_identity_without_force() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    let pinned = sample_identity(\"memory-a\");\n    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n    state.budget_decisions.pinned_identities.insert(pinned.clone());\n\n    let error = evict(&mut state, EvictArgs { identities: vec![pinned], reason: \"manual trim\".to_string(), force: false }, &harness.ctx()).expect_err(\"pinned eviction should fail\");\n\n    assert!(error.to_string().contains(\"Cannot evict pinned identity\"));\n}\n\n#[test]\nfn forced_evict_records_force_in_exclusion_reason() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    let pinned = sample_identity(\"memory-a\");\n    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n    state.budget_decisions.pinned_identities.insert(pinned.clone());\n\n    evict(&mut state, EvictArgs { identities: vec![pinned], reason: \"manual trim\".to_string(), force: true }, &harness.ctx()).expect(\"forced evict\");\n\n    assert_eq!(state.excluded_memories[0].exclusion_reason, \"evicted: force=true; manual trim\");\n}\n\n#[test]\nfn pin_survives_checkpoint_round_trip() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    let pinned = file_identity(\"src/pinned.rs\");\n    state.budget_decisions.pinned_identities.insert(pinned.clone());\n\n    let checkpoint = super::operations::checkpoint(&mut state, super::operations::CheckpointArgs { name: \"pins\".to_string() }, &harness.ctx()).expect(\"checkpoint\");\n    let loaded = super::state::load_checkpoint(checkpoint.checkpoint_id, &harness.conn).expect(\"load checkpoint\");\n\n    assert!(loaded.budget_decisions.pinned_identities.contains(&pinned));\n}\n\n#[test]\nfn evict_present_identity_moves_it_to_excluded_with_reason() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n\n    evict(&mut state, EvictArgs { identities: vec![sample_identity(\"memory-a\")], reason: \"operator request\".to_string(), force: false }, &harness.ctx()).expect(\"evict\");\n\n    assert_eq!(state.excluded_memories[0].exclusion_reason, \"evicted: operator request\");\n}\n\n#[test]\nfn evict_absent_identity_is_a_documented_no_op() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n\n    let outcome = evict(&mut state, EvictArgs { identities: vec![sample_identity(\"missing\")], reason: \"operator request\".to_string(), force: false }, &harness.ctx()).expect(\"evict\");\n\n    assert_eq!(outcome.evicted_count, 0);\n    assert_eq!(outcome.skipped_absent_count, 1);\n}\n\n#[test]\nfn evict_no_op_emits_no_mutation_or_event() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    let before = state.clone();\n    evict(&mut state, EvictArgs { identities: vec![sample_identity(\"missing\")], reason: \"operator request\".to_string(), force: false }, &harness.ctx()).expect(\"evict\");\n    let writer = NoopWriter::default();\n    let summary = MutationEventSummary { op_name: \"evict\".to_string(), summary: \"evicted=0 requested=1\".to_string() };\n\n    let event = emit_memory_retrieved(&before, &state, &summary, &event_context(), &writer).expect(\"emit\");\n\n    assert!(harness.observer.records.borrow().is_empty());\n    assert!(event.is_none());\n}\n\n#[test]\nfn evicted_identity_can_be_retrieved_again_in_same_session() {\n    let mut state = sample_state();\n    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n    evict(&mut state, EvictArgs { identities: vec![sample_identity(\"memory-a\")], reason: \"operator request\".to_string(), force: false }, &Harness::new(FakeRetriever::default()).ctx()).expect(\"evict\");\n    let retrieval = RetrievalExecution {\n        bundle: sample_bundle(vec![sample_bundle_result(\"memory-a\", 0.9)], 96, false, 0, 0),\n        excluded_memories: Vec::new(),\n    };\n    retrieve(&mut state, retrieval_args(), &Harness::new(FakeRetriever::with_retrieve_execution(retrieval)).ctx()).expect(\"retrieve\");\n\n    assert!(state.selected_memories.iter().any(|result| result.identity == sample_identity(\"memory-a\")));\n}\n\n#[derive(Default)]\nstruct NoopWriter {\n    appended: RefCell<usize>,\n}\n\nimpl WorkingMemoryEventAppender for NoopWriter {\n    fn append(\n        &self,\n        _envelope: PartialEnvelope,\n        _flush_policy: FlushPolicy,\n    ) -> Result<crate::identity::EventId, EventWriteError> {\n        *self.appended.borrow_mut() += 1;\n        panic!(\"no event should be appended for a no-op mutation\");\n    }\n}\n\nfn event_context() -> WorkingMemoryEventContext {\n    WorkingMemoryEventContext {\n        workspace_id: \"workspace-test\".to_string(),\n        branch: BranchRef { name: \"test\".to_string() },\n        session_id: SessionId { value: \"session-test\".to_string() },\n        task_id: TaskId { value: \"task-working-memory\".to_string() },\n        actor: Actor::Daemon,\n    }\n}\n","numLines":248,"startLine":1,"totalLines":248}}}
