{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WiAm5HzT4bJJyeBzgd5Mzh","type":"tool_result","content":"1\t//! Working-memory operations for the cognitive workspace.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## 5. Working Memory` requires explicit `retrieve`, `summarize`,\n5\t//! `filter`, `pin`, `evict`, `expand`, `compress`, and `checkpoint`\n6\t//! operations with auditable excluded-memory tracking.\n7\t\n8\tuse std::collections::{BTreeSet, HashMap};\n9\t\n10\tuse rusqlite::Connection;\n11\tuse serde::Serialize;\n12\tuse tokio::runtime::Runtime;\n13\t\n14\tuse crate::error::LatticeError;\n15\tuse crate::events::EventEnvelope;\n16\tuse crate::graph::CodeGraph;\n17\tuse crate::identity::{decode_identity, Identity, IdentityResolver};\n18\tuse crate::memory::MemoryStore;\n19\tuse crate::retrieval_v1::shaper::{compress_bundle_results, shape_retrieval_bundle_detailed};\n20\tuse crate::retrieval_v1::{\n21\t    classify_intent, extract_anchors, resolve_anchors, retrieve_candidates, schema::BudgetReport,\n22\t    schema::BundleResult, schema::RetrievalBundle, score_candidates, DiagnosticMode,\n23\t    RankingDiagnostics, RetrievalBudget, RetrievalContext, RetrievalProfile, ScoringContext,\n24\t    ScoringWeights, ShaperBudget, ShaperContext,\n25\t};\n26\tuse crate::storage::vector_index::VectorIndex;\n27\t\n28\tuse super::state::{\n29\t    save_checkpoint, state_hash, BudgetDecisions, CheckpointId, ExcludedMemory, FileIdentity,\n30\t    SymbolIdentity, WorkingMemoryState,\n31\t};\n32\t\n33\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n34\tpub enum WorkingMemoryOp {\n35\t    Retrieve,\n36\t    Summarize,\n37\t    Filter,\n38\t    Pin,\n39\t    Evict,\n40\t    Expand,\n41\t    Compress,\n42\t    Checkpoint,\n43\t}\n44\t\n45\timpl WorkingMemoryOp {\n46\t    pub fn as_str(self) -> &'static str {\n47\t        match self {\n48\t            Self::Retrieve => \"retrieve\",\n49\t            Self::Summarize => \"summarize\",\n50\t            Self::Filter => \"filter\",\n51\t            Self::Pin => \"pin\",\n52\t            Self::Evict => \"evict\",\n53\t            Self::Expand => \"expand\",\n54\t            Self::Compress => \"compress\",\n55\t            Self::Checkpoint => \"checkpoint\",\n56\t        }\n57\t    }\n58\t}\n59\t\n60\tpub trait FilterPredicate {\n61\t    fn description(&self) -> &str;\n62\t    fn matches(&self, result: &BundleResult) -> bool;\n63\t}\n64\t\n65\tpub trait StateMutationObserver {\n66\t    fn record(&self, mutation: StateMutationRecord) -> Result<(), LatticeError>;\n67\t}\n68\t\n69\tpub trait WorkingMemoryRetriever {\n70\t    fn retrieve(\n71\t        &self,\n72\t        state: &WorkingMemoryState,\n73\t        args: &RetrieveArgs,\n74\t        ctx: &OpContext<'_>,\n75\t    ) -> Result<RetrievalExecution, LatticeError>;\n76\t\n77\t    fn expand(\n78\t        &self,\n79\t        state: &WorkingMemoryState,\n80\t        target: &BundleResult,\n81\t        args: &ExpandArgs,\n82\t        ctx: &OpContext<'_>,\n83\t    ) -> Result<RetrievalExecution, LatticeError>;\n84\t}\n85\t\n86\t#[derive(Debug, Clone, PartialEq)]\n87\tpub struct StateMutationRecord {\n88\t    pub op: WorkingMemoryOp,\n89\t    pub op_name: String,\n90\t    pub before_hash: String,\n91\t    pub after_hash: String,\n92\t    pub summary: String,\n93\t    pub state_before: WorkingMemoryState,\n94\t    pub state_after: WorkingMemoryState,\n95\t}\n96\t\n97\tpub struct OpContext<'a> {\n98\t    pub conn: &'a Connection,\n99\t    pub retrieval_profile: RetrievalProfile,\n100\t    pub identity_resolver: &'a IdentityResolver<'a>,\n101\t    pub shaper: ShaperContext,\n102\t    pub retriever: &'a dyn WorkingMemoryRetriever,\n103\t    pub mutation_observer: Option<&'a dyn StateMutationObserver>,\n104\t}\n105\t\n106\t#[derive(Debug, Clone, PartialEq)]\n107\tpub struct RetrieveArgs {\n108\t    pub task_id: String,\n109\t    pub query_text: Option<String>,\n110\t    pub budget: RetrievalBudget,\n111\t    pub diagnostic_mode: DiagnosticMode,\n112\t    pub query_embedding: Option<Vec<f32>>,\n113\t}\n114\t\n115\timpl Default for RetrieveArgs {\n116\t    fn default() -> Self {\n117\t        Self {\n118\t            task_id: \"working-memory-retrieve\".to_string(),\n119\t            query_text: None,\n120\t            budget: RetrievalBudget::default(),\n121\t            diagnostic_mode: DiagnosticMode::Compact,\n122\t            query_embedding: None,\n123\t        }\n124\t    }\n125\t}\n126\t\n127\t#[derive(Debug, Clone, PartialEq)]\n128\tpub struct RetrieveOutcome {\n129\t    pub bundle: RetrievalBundle,\n130\t    pub added_identities: Vec<Identity>,\n131\t    pub excluded_count: usize,\n132\t}\n133\t\n134\t#[derive(Debug, Clone, PartialEq, Eq)]\n135\tpub struct SummarizeArgs;\n136\t\n137\t#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\n138\tpub struct WorkingMemorySummary {\n139\t    pub task_statement: String,\n140\t    pub intent_label: String,\n141\t    pub active_file_count: usize,\n142\t    pub active_symbol_count: usize,\n143\t    pub selected_count: usize,\n144\t    pub excluded_count: usize,\n145\t    pub token_cap: usize,\n146\t    pub dropped_count: usize,\n147\t    pub truncated_results: usize,\n148\t    pub pinned_count: usize,\n149\t    pub top_hypotheses: Vec<String>,\n150\t}\n151\t\n152\t#[derive(Debug, Clone, PartialEq, Eq)]\n153\tpub struct PinArgs {\n154\t    pub identities: Vec<Identity>,\n155\t}\n156\t\n157\t#[derive(Debug, Clone, PartialEq, Eq)]\n158\tpub struct PinOutcome {\n159\t    pub added_count: usize,\n160\t    pub pinned_count: usize,\n161\t}\n162\t\n163\t#[derive(Debug, Clone, PartialEq, Eq)]\n164\tpub struct EvictArgs {\n165\t    pub identities: Vec<Identity>,\n166\t    pub reason: String,\n167\t    pub force: bool,\n168\t}\n169\t\n170\t#[derive(Debug, Clone, PartialEq, Eq)]\n171\tpub struct EvictOutcome {\n172\t    pub evicted_count: usize,\n173\t    pub skipped_absent_count: usize,\n174\t}\n175\t\n176\t#[derive(Debug, Clone, PartialEq)]\n177\tpub struct ExpandArgs {\n178\t    pub task_id: String,\n179\t    pub expansion_handle: String,\n180\t    pub budget: RetrievalBudget,\n181\t    pub diagnostic_mode: DiagnosticMode,\n182\t    pub query_embedding: Option<Vec<f32>>,\n183\t}\n184\t\n185\t#[derive(Debug, Clone, PartialEq)]\n186\tpub struct ExpandOutcome {\n187\t    pub bundle: RetrievalBundle,\n188\t    pub added_count: usize,\n189\t    pub excluded_count: usize,\n190\t}\n191\t\n192\t#[derive(Debug, Clone, PartialEq, Eq)]\n193\tpub struct CompressArgs {\n194\t    pub token_budget: usize,\n195\t}\n196\t\n197\t#[derive(Debug, Clone, PartialEq)]\n198\tpub struct CompressOutcome {\n199\t    pub removed_count: usize,\n200\t    pub retained_count: usize,\n201\t    pub budget_report: BudgetReport,\n202\t}\n203\t\n204\t#[derive(Debug, Clone, PartialEq, Eq)]\n205\tpub struct CheckpointArgs {\n206\t    pub name: String,\n207\t}\n208\t\n209\t#[derive(Debug, Clone, PartialEq, Eq)]\n210\tpub struct CheckpointOutcome {\n211\t    pub checkpoint_id: CheckpointId,\n212\t}\n213\t\n214\t#[derive(Debug, Clone, PartialEq)]\n215\tpub struct RetrievalExecution {\n216\t    pub bundle: RetrievalBundle,\n217\t    pub excluded_memories: Vec<ExcludedMemory>,\n218\t}\n219\t\n220\tpub struct PhaseFourRetriever<'a> {\n221\t    pub runtime: &'a Runtime,\n222\t    pub resources: PhaseFourResources<'a>,\n223\t    pub scoring_context: &'a ScoringContext,\n224\t}\n225\t\n226\tpub struct PhaseFourResources<'a> {\n227\t    pub workspace_id: &'a str,\n228\t    pub graph: Option<&'a CodeGraph>,\n229\t    pub memory_store: Option<&'a MemoryStore>,\n230\t    pub vector_index: Option<&'a dyn VectorIndex>,\n231\t    pub event_candidates: &'a [EventEnvelope],\n232\t}\n233\t\n234\timpl WorkingMemoryRetriever for PhaseFourRetriever<'_> {\n235\t    fn retrieve(\n236\t        &self,\n237\t        state: &WorkingMemoryState,\n238\t        args: &RetrieveArgs,\n239\t        ctx: &OpContext<'_>,\n240\t    ) -> Result<RetrievalExecution, LatticeError> {\n241\t        let task_text = args\n242\t            .query_text\n243\t            .as_deref()\n244\t            .unwrap_or(state.task_statement.as_str());\n245\t        self.run_pipeline(\n246\t            task_text,\n247\t            &args.task_id,\n248\t            &args.budget,\n249\t            args.diagnostic_mode,\n250\t            args.query_embedding.as_deref(),\n251\t            selected_identities(state),\n252\t            state,\n253\t            ctx,\n254\t        )\n255\t    }\n256\t\n257\t    fn expand(\n258\t        &self,\n259\t        state: &WorkingMemoryState,\n260\t        target: &BundleResult,\n261\t        args: &ExpandArgs,\n262\t        ctx: &OpContext<'_>,\n263\t    ) -> Result<RetrievalExecution, LatticeError> {\n264\t        let anchor = expansion_anchor_text(target)?;\n265\t        let query = format!(\"{}\\n{}\", state.task_statement, anchor);\n266\t        self.run_pipeline(\n267\t            &query,\n268\t            &args.task_id,\n269\t            &widen_budget(&args.budget),\n270\t            args.diagnostic_mode,\n271\t            args.query_embedding.as_deref(),\n272\t            expand_recent_identities(state, &target.identity),\n273\t            state,\n274\t            ctx,\n275\t        )\n276\t    }\n277\t}\n278\t\n279\timpl PhaseFourRetriever<'_> {\n280\t    fn run_pipeline(\n281\t        &self,\n282\t        task_text: &str,\n283\t        task_id: &str,\n284\t        budget: &RetrievalBudget,\n285\t        diagnostic_mode: DiagnosticMode,\n286\t        query_embedding: Option<&[f32]>,\n287\t        recent_working_memory: Vec<Identity>,\n288\t        state: &WorkingMemoryState,\n289\t        ctx: &OpContext<'_>,\n290\t    ) -> Result<RetrievalExecution, LatticeError> {\n291\t        let intent = classify_intent(task_text);\n292\t        let anchors = resolve_anchors(extract_anchors(task_text, &intent), ctx.identity_resolver);\n293\t        let retrieval_ctx = RetrievalContext {\n294\t            workspace_id: self.resources.workspace_id,\n295\t            graph: self.resources.graph,\n296\t            memory_store: self.resources.memory_store,\n297\t            vector_index: self.resources.vector_index,\n298\t            query_embedding,\n299\t            event_candidates: self.resources.event_candidates,\n300\t            recent_working_memory: recent_working_memory.as_slice(),\n301\t        };\n302\t        let candidates = self.runtime.block_on(retrieve_candidates(\n303\t            &intent,\n304\t            &anchors,\n305\t            budget,\n306\t            &retrieval_ctx,\n307\t        ));\n308\t        let weights = ScoringWeights::for_profile(ctx.retrieval_profile);\n309\t        let ranked = score_candidates(\n310\t            candidates,\n311\t            &intent,\n312\t            &anchors,\n313\t            &weights,\n314\t            diagnostic_mode,\n315\t            self.scoring_context,\n316\t        );\n317\t        let diagnostics = build_diagnostics(diagnostic_mode, &intent, &anchors, &ranked, &weights);\n318\t        let shaper = shaper_with_state_pins(\n319\t            &ctx.shaper,\n320\t            &state.budget_decisions,\n321\t            budget.max_candidates_per_source,\n322\t        );\n323\t        let shaped = shape_retrieval_bundle_detailed(\n324\t            task_id,\n325\t            format!(\"{:?}\", intent.primary_label),\n326\t            summarize_anchor_texts(&anchors),\n327\t            ranked,\n328\t            diagnostic_mode,\n329\t            diagnostics,\n330\t            &shaper,\n331\t        );\n332\t        Ok(RetrievalExecution {\n333\t            excluded_memories: to_excluded_memories(\n334\t                shaped.dropped_results,\n335\t                format!(\"compressed: budget={} tokens\", shaper.budget.max_tokens),\n336\t            ),\n337\t            bundle: shaped.bundle,\n338\t        })\n339\t    }\n340\t}\n341\t\n342\t/// `## 5. Working Memory` requires retrieval to populate active and excluded\n343\t/// context through the Phase 4 retrieval pipeline.\n344\tpub fn retrieve(\n345\t    state: &mut WorkingMemoryState,\n346\t    args: RetrieveArgs,\n347\t    ctx: &OpContext<'_>,\n348\t) -> Result<RetrieveOutcome, LatticeError> {\n349\t    let state_before = state.clone();\n350\t    maybe_replace_task(state, args.query_text.as_deref());\n351\t    let execution = ctx.retriever.retrieve(state, &args, ctx)?;\n352\t    let added = merge_selected_memories(\n353\t        &mut state.selected_memories,\n354\t        execution.bundle.results.clone(),\n355\t    );\n356\t    state\n357\t        .excluded_memories\n358\t        .extend(execution.excluded_memories.clone());\n359\t    state.interpreted_intent = classify_intent(&state.task_statement);\n360\t    apply_budget_report(&mut state.budget_decisions, &execution.bundle.budget_report);\n361\t    refresh_active_context(state);\n362\t    let summary = format!(\n363\t        \"selected={} excluded={} added={}\",\n364\t        state.selected_memories.len(),\n365\t        state.excluded_memories.len(),\n366\t        added.len()\n367\t    );\n368\t    record_if_changed(\n369\t        &state_before,\n370\t        state,\n371\t        WorkingMemoryOp::Retrieve,\n372\t        summary,\n373\t        ctx,\n374\t    )?;\n375\t    Ok(RetrieveOutcome {\n376\t        bundle: execution.bundle,\n377\t        added_identities: added,\n378\t        excluded_count: execution.excluded_memories.len(),\n379\t    })\n380\t}\n381\t\n382\t/// `## 5. Working Memory` requires summarize to expose the active context and\n383\t/// budget state without mutating durable storage.\n384\tpub fn summarize(\n385\t    state: &mut WorkingMemoryState,\n386\t    _args: SummarizeArgs,\n387\t    _ctx: &OpContext<'_>,\n388\t) -> Result<WorkingMemorySummary, LatticeError> {\n389\t    Ok(summarize_state(state))\n390\t}\n391\t\n392\tpub fn summarize_state(state: &WorkingMemoryState) -> WorkingMemorySummary {\n393\t    WorkingMemorySummary {\n394\t        task_statement: state.task_statement.clone(),\n395\t        intent_label: format!(\"{:?}\", state.interpreted_intent.primary_label),\n396\t        active_file_count: state.active_files.len(),\n397\t        active_symbol_count: state.active_symbols.len(),\n398\t        selected_count: state.selected_memories.len(),\n399\t        excluded_count: state.excluded_memories.len(),\n400\t        token_cap: state.budget_decisions.token_cap,\n401\t        dropped_count: state.budget_decisions.dropped_count,\n402\t        truncated_results: state.budget_decisions.truncated_results,\n403\t        pinned_count: state.budget_decisions.pinned_identities.len(),\n404\t        top_hypotheses: state\n405\t            .active_hypotheses\n406\t            .iter()\n407\t            .take(3)\n408\t            .map(|hypothesis| hypothesis.text.clone())\n409\t            .collect(),\n410\t    }\n411\t}\n412\t\n413\t/// `## 5. Working Memory` requires filter to move removed context into\n414\t/// `excluded_memories` with an auditable predicate reason.\n415\tpub fn filter(\n416\t    state: &mut WorkingMemoryState,\n417\t    predicate: &dyn FilterPredicate,\n418\t    ctx: &OpContext<'_>,\n419\t) -> Result<usize, LatticeError> {\n420\t    let state_before = state.clone();\n421\t    let removed = filter_selected_memories(state, predicate);\n422\t    refresh_active_context(state);\n423\t    let summary = format!(\"removed={} predicate={}\", removed, predicate.description());\n424\t    record_if_changed(&state_before, state, WorkingMemoryOp::Filter, summary, ctx)?;\n425\t    Ok(removed)\n426\t}\n427\t\n428\t/// `## 5. Working Memory` requires pin to define identities the shaper must\n429\t/// preserve across compression.\n430\tpub fn pin(\n431\t    state: &mut WorkingMemoryState,\n432\t    args: PinArgs,\n433\t    ctx: &OpContext<'_>,\n434\t) -> Result<PinOutcome, LatticeError> {\n435\t    let state_before = state.clone();\n436\t    let added_count = args\n437\t        .identities\n438\t        .into_iter()\n439\t        .filter(|identity| {\n440\t            state\n441\t                .budget_decisions\n442\t                .pinned_identities\n443\t                .insert(identity.clone())\n444\t        })\n445\t        .count();\n446\t    let summary = format!(\n447\t        \"added={} pinned={}\",\n448\t        added_count,\n449\t        state.budget_decisions.pinned_identities.len()\n450\t    );\n451\t    record_if_changed(&state_before, state, WorkingMemoryOp::Pin, summary, ctx)?;\n452\t    Ok(PinOutcome {\n453\t        added_count,\n454\t        pinned_count: state.budget_decisions.pinned_identities.len(),\n455\t    })\n456\t}\n457\t\n458\t/// `## 5. Working Memory` requires evict to remove selected context while\n459\t/// recording the operator-supplied reason.\n460\tpub fn evict(\n461\t    state: &mut WorkingMemoryState,\n462\t    args: EvictArgs,\n463\t    ctx: &OpContext<'_>,\n464\t) -> Result<EvictOutcome, LatticeError> {\n465\t    reject_pinned_eviction(state, &args)?;\n466\t    let state_before = state.clone();\n467\t    let reason = eviction_reason(&args);\n468\t    let identities = args.identities.into_iter().collect::<BTreeSet<_>>();\n469\t    let evicted = evict_selected_memories(state, &identities, &reason);\n470\t    state\n471\t        .budget_decisions\n472\t        .pinned_identities\n473\t        .retain(|identity| !identities.contains(identity));\n474\t    refresh_active_context(state);\n475\t    let summary = format!(\"evicted={} requested={}\", evicted, identities.len());\n476\t    record_if_changed(&state_before, state, WorkingMemoryOp::Evict, summary, ctx)?;\n477\t    Ok(EvictOutcome {\n478\t        evicted_count: evicted,\n479\t        skipped_absent_count: identities.len().saturating_sub(evicted),\n480\t    })\n481\t}\n482\t\n483\t/// `## 5. Working Memory` requires expand to widen retrieval around an existing\n484\t/// selected result using its expansion handle.\n485\tpub fn expand(\n486\t    state: &mut WorkingMemoryState,\n487\t    args: ExpandArgs,\n488\t    ctx: &OpContext<'_>,\n489\t) -> Result<ExpandOutcome, LatticeError> {\n490\t    let state_before = state.clone();\n491\t    let target = selected_target(state, &args.expansion_handle)?;\n492\t    let execution = ctx.retriever.expand(state, &target, &args, ctx)?;\n493\t    let added = merge_selected_memories(\n494\t        &mut state.selected_memories,\n495\t        execution.bundle.results.clone(),\n496\t    );\n497\t    state\n498\t        .excluded_memories\n499\t        .extend(execution.excluded_memories.clone());\n500\t    apply_budget_report(&mut state.budget_decisions, &execution.bundle.budget_report);\n501\t    refresh_active_context(state);\n502\t    let summary = format!(\n503\t        \"added={} selected={}\",\n504\t        added.len(),\n505\t        state.selected_memories.len()\n506\t    );\n507\t    record_if_changed(&state_before, state, WorkingMemoryOp::Expand, summary, ctx)?;\n508\t    Ok(ExpandOutcome {\n509\t        bundle: execution.bundle,\n510\t        added_count: added.len(),\n511\t        excluded_count: execution.excluded_memories.len(),\n512\t    })\n513\t}\n514\t\n515\t/// `## 5. Working Memory` requires compress to reuse the Retrieval V1 shaper\n516\t/// policy while honoring pinned identities.\n517\tpub fn compress(\n518\t    state: &mut WorkingMemoryState,\n519\t    args: CompressArgs,\n520\t    ctx: &OpContext<'_>,\n521\t) -> Result<CompressOutcome, LatticeError> {\n522\t    let state_before = state.clone();\n523\t    let shaper = shaper_with_state_pins(&ctx.shaper, &state.budget_decisions, args.token_budget);\n524\t    let compression = compress_bundle_results(state.selected_memories.clone(), &shaper);\n525\t    let removed_count = compression.dropped_results.len();\n526\t    state.selected_memories = compression.results;\n527\t    state.excluded_memories.extend(to_excluded_memories(\n528\t        compression.dropped_results,\n529\t        format!(\"compressed: budget={} tokens\", args.token_budget),\n530\t    ));\n531\t    apply_budget_report(&mut state.budget_decisions, &compression.budget_report);\n532\t    refresh_active_context(state);\n533\t    let summary = format!(\n534\t        \"removed={} retained={}\",\n535\t        removed_count,\n536\t        state.selected_memories.len()\n537\t    );\n538\t    record_if_changed(\n539\t        &state_before,\n540\t        state,\n541\t        WorkingMemoryOp::Compress,\n542\t        summary,\n543\t        ctx,\n544\t    )?;\n545\t    Ok(CompressOutcome {\n546\t        removed_count,\n547\t        retained_count: state.selected_memories.len(),\n548\t        budget_report: compression.budget_report,\n549\t    })\n550\t}\n551\t\n552\t/// `## 5. Working Memory` requires checkpoint to persist the current state\n553\t/// through the T34 checkpoint path without a parallel write path.\n554\tpub fn checkpoint(\n555\t    state: &mut WorkingMemoryState,\n556\t    args: CheckpointArgs,\n557\t    ctx: &OpContext<'_>,\n558\t) -> Result<CheckpointOutcome, LatticeError> {\n559\t    Ok(CheckpointOutcome {\n560\t        checkpoint_id: save_checkpoint(state, &args.name, ctx.conn)?,\n561\t    })\n562\t}\n563\t\n564\tfn build_diagnostics(\n565\t    diagnostic_mode: DiagnosticMode,\n566\t    intent: &crate::retrieval_v1::IntentClassification,\n567\t    anchors: &[crate::retrieval_v1::ResolvedAnchor],\n568\t    ranked: &[crate::retrieval_v1::RankedCandidate],\n569\t    weights: &ScoringWeights,\n570\t) -> Option<RankingDiagnostics> {\n571\t    matches!(diagnostic_mode, DiagnosticMode::Diagnostic).then(|| {\n572\t        RankingDiagnostics::new(\n573\t            intent.clone(),\n574\t            anchors.to_vec(),\n575\t            ranked.to_vec(),\n576\t            weights.clone(),\n577\t        )\n578\t    })\n579\t}\n580\t\n581\tfn maybe_replace_task(state: &mut WorkingMemoryState, query_text: Option<&str>) {\n582\t    if let Some(query_text) = query_text {\n583\t        state.task_statement = query_text.to_string();\n584\t    }\n585\t}\n586\t\n587\tfn merge_selected_memories(\n588\t    selected: &mut Vec<BundleResult>,\n589\t    incoming: Vec<BundleResult>,\n590\t) -> Vec<Identity> {\n591\t    let mut index_by_identity = selected\n592\t        .iter()\n593\t        .enumerate()\n594\t        .map(|(index, result)| (result.identity.clone(), index))\n595\t        .collect::<HashMap<_, _>>();\n596\t    let mut added = Vec::new();\n597\t    for result in incoming {\n598\t        if let Some(index) = index_by_identity.get(&result.identity).copied() {\n599\t            selected[index] = result;\n600\t        } else {\n601\t            index_by_identity.insert(result.identity.clone(), selected.len());\n602\t            added.push(result.identity.clone());\n603\t            selected.push(result);\n604\t        }\n605\t    }\n606\t    added\n607\t}\n608\t\n609\tfn filter_selected_memories(\n610\t    state: &mut WorkingMemoryState,\n611\t    predicate: &dyn FilterPredicate,\n612\t) -> usize {\n613\t    let mut retained = Vec::with_capacity(state.selected_memories.len());\n614\t    let mut removed = 0usize;\n615\t    for result in state.selected_memories.drain(..) {\n616\t        if predicate.matches(&result) {\n617\t            retained.push(result);\n618\t        } else {\n619\t            state.excluded_memories.push(ExcludedMemory {\n620\t                result,\n621\t                exclusion_reason: format!(\"filtered: {}\", predicate.description()),\n622\t            });\n623\t            removed += 1;\n624\t        }\n625\t    }\n626\t    state.selected_memories = retained;\n627\t    removed\n628\t}\n629\t\n630\tfn reject_pinned_eviction(\n631\t    state: &WorkingMemoryState,\n632\t    args: &EvictArgs,\n633\t) -> Result<(), LatticeError> {\n634\t    if args.force {\n635\t        return Ok(());\n636\t    }\n637\t    let pinned = args\n638\t        .identities\n639\t        .iter()\n640\t        .find(|identity| state.budget_decisions.pinned_identities.contains(*identity));\n641\t    match pinned {\n642\t        Some(identity) => Err(LatticeError::Query(format!(\n643\t            \"Cannot evict pinned identity `{}` without force=true\",\n644\t            identity\n645\t        ))),\n646\t        None => Ok(()),\n647\t    }\n648\t}\n649\t\n650\tfn evict_selected_memories(\n651\t    state: &mut WorkingMemoryState,\n652\t    identities: &BTreeSet<Identity>,\n653\t    reason: &str,\n654\t) -> usize {\n655\t    let mut retained = Vec::with_capacity(state.selected_memories.len());\n656\t    let mut evicted = 0usize;\n657\t    for result in state.selected_memories.drain(..) {\n658\t        if identities.contains(&result.identity) {\n659\t            state.excluded_memories.push(ExcludedMemory {\n660\t                result,\n661\t                exclusion_reason: reason.to_string(),\n662\t            });\n663\t            evicted += 1;\n664\t        } else {\n665\t            retained.push(result);\n666\t        }\n667\t    }\n668\t    state.selected_memories = retained;\n669\t    evicted\n670\t}\n671\t\n672\tfn eviction_reason(args: &EvictArgs) -> String {\n673\t    if args.force {\n674\t        format!(\"evicted: force=true; {}\", args.reason)\n675\t    } else {\n676\t        format!(\"evicted: {}\", args.reason)\n677\t    }\n678\t}\n679\t\n680\tfn selected_target(\n681\t    state: &WorkingMemoryState,\n682\t    expansion_handle: &str,\n683\t) -> Result<BundleResult, LatticeError> {\n684\t    state\n685\t        .selected_memories\n686\t        .iter()\n687\t        .find(|result| result.expansion_handle == expansion_handle)\n688\t        .cloned()\n689\t        .ok_or_else(|| {\n690\t            LatticeError::Query(format!(\n691\t                \"No selected memory matches expansion handle `{expansion_handle}`\"\n692\t            ))\n693\t        })\n694\t}\n695\t\n696\tfn apply_budget_report(decisions: &mut BudgetDecisions, report: &BudgetReport) {\n697\t    decisions.token_cap = report.token_budget;\n698\t    decisions.dropped_count = report.dropped_results;\n699\t    decisions.truncated_results = report.trimmed_snippets;\n700\t}\n701\t\n702\tfn refresh_active_context(state: &mut WorkingMemoryState) {\n703\t    state.active_files = state\n704\t        .selected_memories\n705\t        .iter()\n706\t        .filter_map(|result| match &result.identity {\n707\t            Identity::File(file) => Some(file.clone()),\n708\t            Identity::Symbol(symbol) => Some(symbol.file.clone()),\n709\t            _ => None,\n710\t        })\n711\t        .collect::<BTreeSet<FileIdentity>>();\n712\t    state.active_symbols = state\n713\t        .selected_memories\n714\t        .iter()\n715\t        .filter_map(|result| match &result.identity {\n716\t            Identity::Symbol(symbol) => Some(symbol.clone()),\n717\t            _ => None,\n718\t        })\n719\t        .collect::<BTreeSet<SymbolIdentity>>();\n720\t}\n721\t\n722\tfn record_if_changed(\n723\t    state_before: &WorkingMemoryState,\n724\t    state: &WorkingMemoryState,\n725\t    op: WorkingMemoryOp,\n726\t    summary: String,\n727\t    ctx: &OpContext<'_>,\n728\t) -> Result<(), LatticeError> {\n729\t    let before_hash = state_hash(state_before)?;\n730\t    let after_hash = state_hash(state)?;\n731\t    if before_hash == after_hash {\n732\t        return Ok(());\n733\t    }\n734\t    record_state_mutation(\n735\t        state_before,\n736\t        state,\n737\t        op,\n738\t        before_hash,\n739\t        after_hash,\n740\t        summary,\n741\t        ctx,\n742\t    )\n743\t}\n744\t\n745\tfn record_state_mutation(\n746\t    state_before: &WorkingMemoryState,\n747\t    state_after: &WorkingMemoryState,\n748\t    op: WorkingMemoryOp,\n749\t    before_hash: String,\n750\t    after_hash: String,\n751\t    summary: String,\n752\t    ctx: &OpContext<'_>,\n753\t) -> Result<(), LatticeError> {\n754\t    match ctx.mutation_observer {\n755\t        Some(observer) => observer.record(StateMutationRecord {\n756\t            op,\n757\t            op_name: op.as_str().to_string(),\n758\t            before_hash,\n759\t            after_hash,\n760\t            summary,\n761\t            state_before: state_before.clone(),\n762\t            state_after: state_after.clone(),\n763\t        }),\n764\t        None => Ok(()),\n765\t    }\n766\t}\n767\t\n768\tfn selected_identities(state: &WorkingMemoryState) -> Vec<Identity> {\n769\t    state\n770\t        .selected_memories\n771\t        .iter()\n772\t        .map(|result| result.identity.clone())\n773\t        .collect()\n774\t}\n775\t\n776\tfn expand_recent_identities(state: &WorkingMemoryState, target: &Identity) -> Vec<Identity> {\n777\t    let mut identities = selected_identities(state);\n778\t    if !identities.contains(target) {\n779\t        identities.push(target.clone());\n780\t    }\n781\t    identities\n782\t}\n783\t\n784\tfn summarize_anchor_texts(anchors: &[crate::retrieval_v1::ResolvedAnchor]) -> String {\n785\t    anchors\n786\t        .iter()\n787\t        .map(|anchor| anchor.anchor_text.as_str())\n788\t        .collect::<Vec<_>>()\n789\t        .join(\", \")\n790\t}\n791\t\n792\tfn shaper_with_state_pins(\n793\t    base: &ShaperContext,\n794\t    decisions: &BudgetDecisions,\n795\t    token_budget: usize,\n796\t) -> ShaperContext {\n797\t    let mut pins = base.pins.clone();\n798\t    pins.extend(decisions.pinned_identities.iter().cloned());\n799\t    ShaperContext {\n800\t        pins,\n801\t        budget: ShaperBudget {\n802\t            max_tokens: token_budget,\n803\t        },\n804\t    }\n805\t}\n806\t\n807\tfn to_excluded_memories(results: Vec<BundleResult>, reason: String) -> Vec<ExcludedMemory> {\n808\t    results\n809\t        .into_iter()\n810\t        .map(|result| ExcludedMemory {\n811\t            result,\n812\t            exclusion_reason: reason.clone(),\n813\t        })\n814\t        .collect()\n815\t}\n816\t\n817\tfn expansion_anchor_text(target: &BundleResult) -> Result<String, LatticeError> {\n818\t    let identity = decode_identity(&target.expansion_handle).map_err(|error| {\n819\t        LatticeError::Query(format!(\n820\t            \"Invalid expansion handle `{}`: {}\",\n821\t            target.expansion_handle, error\n822\t        ))\n823\t    })?;\n824\t    Ok(match identity {\n825\t        Identity::File(file) => file.repo_relative_path,\n826\t        Identity::Symbol(symbol) => symbol.qualified_name,\n827\t        Identity::Doc(doc) => doc.repo_relative_path,\n828\t        Identity::Section(section) => format!(\n829\t            \"{}#{}\",\n830\t            section.doc.repo_relative_path,\n831\t            section.heading_path.join(\" > \")\n832\t        ),\n833\t        Identity::Event(event) => format!(\"event {}\", event.ulid),\n834\t        Identity::Memory(memory) => format!(\"memory {}\", memory.ulid),\n835\t        Identity::ContextHandle(handle) => format!(\"handle {}\", handle.ulid),\n836\t    })\n837\t}\n838\t\n839\tfn widen_budget(budget: &RetrievalBudget) -> RetrievalBudget {\n840\t    RetrievalBudget {\n841\t        max_candidates_per_source: budget.max_candidates_per_source.saturating_mul(2).max(1),\n842\t        max_graph_hops: budget.max_graph_hops.saturating_add(1),\n843\t        max_fts_rows: budget.max_fts_rows.saturating_mul(2).max(1),\n844\t        embedding_k: budget.embedding_k.saturating_mul(2).max(1),\n845\t        event_window: budget.event_window.saturating_mul(2).max(1),\n846\t        working_memory_window: budget.working_memory_window.saturating_mul(2).max(1),\n847\t    }\n848\t}\n849\t"}]},"parent_tool_use_id":null,"session_id":"1b2121c5-8450-4d0d-9f66-0986877cae23","uuid":"9ca2e54d-61ef-48f7-bb1a-38fb228cf636","timestamp":"2026-05-17T10:13:48.262Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/working_memory/operations.rs","content":"//! Working-memory operations for the cognitive workspace.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 5. Working Memory` requires explicit `retrieve`, `summarize`,\n//! `filter`, `pin`, `evict`, `expand`, `compress`, and `checkpoint`\n//! operations with auditable excluded-memory tracking.\n\nuse std::collections::{BTreeSet, HashMap};\n\nuse rusqlite::Connection;\nuse serde::Serialize;\nuse tokio::runtime::Runtime;\n\nuse crate::error::LatticeError;\nuse crate::events::EventEnvelope;\nuse crate::graph::CodeGraph;\nuse crate::identity::{decode_identity, Identity, IdentityResolver};\nuse crate::memory::MemoryStore;\nuse crate::retrieval_v1::shaper::{compress_bundle_results, shape_retrieval_bundle_detailed};\nuse crate::retrieval_v1::{\n    classify_intent, extract_anchors, resolve_anchors, retrieve_candidates, schema::BudgetReport,\n    schema::BundleResult, schema::RetrievalBundle, score_candidates, DiagnosticMode,\n    RankingDiagnostics, RetrievalBudget, RetrievalContext, RetrievalProfile, ScoringContext,\n    ScoringWeights, ShaperBudget, ShaperContext,\n};\nuse crate::storage::vector_index::VectorIndex;\n\nuse super::state::{\n    save_checkpoint, state_hash, BudgetDecisions, CheckpointId, ExcludedMemory, FileIdentity,\n    SymbolIdentity, WorkingMemoryState,\n};\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum WorkingMemoryOp {\n    Retrieve,\n    Summarize,\n    Filter,\n    Pin,\n    Evict,\n    Expand,\n    Compress,\n    Checkpoint,\n}\n\nimpl WorkingMemoryOp {\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::Retrieve => \"retrieve\",\n            Self::Summarize => \"summarize\",\n            Self::Filter => \"filter\",\n            Self::Pin => \"pin\",\n            Self::Evict => \"evict\",\n            Self::Expand => \"expand\",\n            Self::Compress => \"compress\",\n            Self::Checkpoint => \"checkpoint\",\n        }\n    }\n}\n\npub trait FilterPredicate {\n    fn description(&self) -> &str;\n    fn matches(&self, result: &BundleResult) -> bool;\n}\n\npub trait StateMutationObserver {\n    fn record(&self, mutation: StateMutationRecord) -> Result<(), LatticeError>;\n}\n\npub trait WorkingMemoryRetriever {\n    fn retrieve(\n        &self,\n        state: &WorkingMemoryState,\n        args: &RetrieveArgs,\n        ctx: &OpContext<'_>,\n    ) -> Result<RetrievalExecution, LatticeError>;\n\n    fn expand(\n        &self,\n        state: &WorkingMemoryState,\n        target: &BundleResult,\n        args: &ExpandArgs,\n        ctx: &OpContext<'_>,\n    ) -> Result<RetrievalExecution, LatticeError>;\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct StateMutationRecord {\n    pub op: WorkingMemoryOp,\n    pub op_name: String,\n    pub before_hash: String,\n    pub after_hash: String,\n    pub summary: String,\n    pub state_before: WorkingMemoryState,\n    pub state_after: WorkingMemoryState,\n}\n\npub struct OpContext<'a> {\n    pub conn: &'a Connection,\n    pub retrieval_profile: RetrievalProfile,\n    pub identity_resolver: &'a IdentityResolver<'a>,\n    pub shaper: ShaperContext,\n    pub retriever: &'a dyn WorkingMemoryRetriever,\n    pub mutation_observer: Option<&'a dyn StateMutationObserver>,\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct RetrieveArgs {\n    pub task_id: String,\n    pub query_text: Option<String>,\n    pub budget: RetrievalBudget,\n    pub diagnostic_mode: DiagnosticMode,\n    pub query_embedding: Option<Vec<f32>>,\n}\n\nimpl Default for RetrieveArgs {\n    fn default() -> Self {\n        Self {\n            task_id: \"working-memory-retrieve\".to_string(),\n            query_text: None,\n            budget: RetrievalBudget::default(),\n            diagnostic_mode: DiagnosticMode::Compact,\n            query_embedding: None,\n        }\n    }\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct RetrieveOutcome {\n    pub bundle: RetrievalBundle,\n    pub added_identities: Vec<Identity>,\n    pub excluded_count: usize,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct SummarizeArgs;\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\npub struct WorkingMemorySummary {\n    pub task_statement: String,\n    pub intent_label: String,\n    pub active_file_count: usize,\n    pub active_symbol_count: usize,\n    pub selected_count: usize,\n    pub excluded_count: usize,\n    pub token_cap: usize,\n    pub dropped_count: usize,\n    pub truncated_results: usize,\n    pub pinned_count: usize,\n    pub top_hypotheses: Vec<String>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct PinArgs {\n    pub identities: Vec<Identity>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct PinOutcome {\n    pub added_count: usize,\n    pub pinned_count: usize,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct EvictArgs {\n    pub identities: Vec<Identity>,\n    pub reason: String,\n    pub force: bool,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct EvictOutcome {\n    pub evicted_count: usize,\n    pub skipped_absent_count: usize,\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct ExpandArgs {\n    pub task_id: String,\n    pub expansion_handle: String,\n    pub budget: RetrievalBudget,\n    pub diagnostic_mode: DiagnosticMode,\n    pub query_embedding: Option<Vec<f32>>,\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct ExpandOutcome {\n    pub bundle: RetrievalBundle,\n    pub added_count: usize,\n    pub excluded_count: usize,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct CompressArgs {\n    pub token_budget: usize,\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct CompressOutcome {\n    pub removed_count: usize,\n    pub retained_count: usize,\n    pub budget_report: BudgetReport,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct CheckpointArgs {\n    pub name: String,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct CheckpointOutcome {\n    pub checkpoint_id: CheckpointId,\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct RetrievalExecution {\n    pub bundle: RetrievalBundle,\n    pub excluded_memories: Vec<ExcludedMemory>,\n}\n\npub struct PhaseFourRetriever<'a> {\n    pub runtime: &'a Runtime,\n    pub resources: PhaseFourResources<'a>,\n    pub scoring_context: &'a ScoringContext,\n}\n\npub struct PhaseFourResources<'a> {\n    pub workspace_id: &'a str,\n    pub graph: Option<&'a CodeGraph>,\n    pub memory_store: Option<&'a MemoryStore>,\n    pub vector_index: Option<&'a dyn VectorIndex>,\n    pub event_candidates: &'a [EventEnvelope],\n}\n\nimpl WorkingMemoryRetriever for PhaseFourRetriever<'_> {\n    fn retrieve(\n        &self,\n        state: &WorkingMemoryState,\n        args: &RetrieveArgs,\n        ctx: &OpContext<'_>,\n    ) -> Result<RetrievalExecution, LatticeError> {\n        let task_text = args\n            .query_text\n            .as_deref()\n            .unwrap_or(state.task_statement.as_str());\n        self.run_pipeline(\n            task_text,\n            &args.task_id,\n            &args.budget,\n            args.diagnostic_mode,\n            args.query_embedding.as_deref(),\n            selected_identities(state),\n            state,\n            ctx,\n        )\n    }\n\n    fn expand(\n        &self,\n        state: &WorkingMemoryState,\n        target: &BundleResult,\n        args: &ExpandArgs,\n        ctx: &OpContext<'_>,\n    ) -> Result<RetrievalExecution, LatticeError> {\n        let anchor = expansion_anchor_text(target)?;\n        let query = format!(\"{}\\n{}\", state.task_statement, anchor);\n        self.run_pipeline(\n            &query,\n            &args.task_id,\n            &widen_budget(&args.budget),\n            args.diagnostic_mode,\n            args.query_embedding.as_deref(),\n            expand_recent_identities(state, &target.identity),\n            state,\n            ctx,\n        )\n    }\n}\n\nimpl PhaseFourRetriever<'_> {\n    fn run_pipeline(\n        &self,\n        task_text: &str,\n        task_id: &str,\n        budget: &RetrievalBudget,\n        diagnostic_mode: DiagnosticMode,\n        query_embedding: Option<&[f32]>,\n        recent_working_memory: Vec<Identity>,\n        state: &WorkingMemoryState,\n        ctx: &OpContext<'_>,\n    ) -> Result<RetrievalExecution, LatticeError> {\n        let intent = classify_intent(task_text);\n        let anchors = resolve_anchors(extract_anchors(task_text, &intent), ctx.identity_resolver);\n        let retrieval_ctx = RetrievalContext {\n            workspace_id: self.resources.workspace_id,\n            graph: self.resources.graph,\n            memory_store: self.resources.memory_store,\n            vector_index: self.resources.vector_index,\n            query_embedding,\n            event_candidates: self.resources.event_candidates,\n            recent_working_memory: recent_working_memory.as_slice(),\n        };\n        let candidates = self.runtime.block_on(retrieve_candidates(\n            &intent,\n            &anchors,\n            budget,\n            &retrieval_ctx,\n        ));\n        let weights = ScoringWeights::for_profile(ctx.retrieval_profile);\n        let ranked = score_candidates(\n            candidates,\n            &intent,\n            &anchors,\n            &weights,\n            diagnostic_mode,\n            self.scoring_context,\n        );\n        let diagnostics = build_diagnostics(diagnostic_mode, &intent, &anchors, &ranked, &weights);\n        let shaper = shaper_with_state_pins(\n            &ctx.shaper,\n            &state.budget_decisions,\n            budget.max_candidates_per_source,\n        );\n        let shaped = shape_retrieval_bundle_detailed(\n            task_id,\n            format!(\"{:?}\", intent.primary_label),\n            summarize_anchor_texts(&anchors),\n            ranked,\n            diagnostic_mode,\n            diagnostics,\n            &shaper,\n        );\n        Ok(RetrievalExecution {\n            excluded_memories: to_excluded_memories(\n                shaped.dropped_results,\n                format!(\"compressed: budget={} tokens\", shaper.budget.max_tokens),\n            ),\n            bundle: shaped.bundle,\n        })\n    }\n}\n\n/// `## 5. Working Memory` requires retrieval to populate active and excluded\n/// context through the Phase 4 retrieval pipeline.\npub fn retrieve(\n    state: &mut WorkingMemoryState,\n    args: RetrieveArgs,\n    ctx: &OpContext<'_>,\n) -> Result<RetrieveOutcome, LatticeError> {\n    let state_before = state.clone();\n    maybe_replace_task(state, args.query_text.as_deref());\n    let execution = ctx.retriever.retrieve(state, &args, ctx)?;\n    let added = merge_selected_memories(\n        &mut state.selected_memories,\n        execution.bundle.results.clone(),\n    );\n    state\n        .excluded_memories\n        .extend(execution.excluded_memories.clone());\n    state.interpreted_intent = classify_intent(&state.task_statement);\n    apply_budget_report(&mut state.budget_decisions, &execution.bundle.budget_report);\n    refresh_active_context(state);\n    let summary = format!(\n        \"selected={} excluded={} added={}\",\n        state.selected_memories.len(),\n        state.excluded_memories.len(),\n        added.len()\n    );\n    record_if_changed(\n        &state_before,\n        state,\n        WorkingMemoryOp::Retrieve,\n        summary,\n        ctx,\n    )?;\n    Ok(RetrieveOutcome {\n        bundle: execution.bundle,\n        added_identities: added,\n        excluded_count: execution.excluded_memories.len(),\n    })\n}\n\n/// `## 5. Working Memory` requires summarize to expose the active context and\n/// budget state without mutating durable storage.\npub fn summarize(\n    state: &mut WorkingMemoryState,\n    _args: SummarizeArgs,\n    _ctx: &OpContext<'_>,\n) -> Result<WorkingMemorySummary, LatticeError> {\n    Ok(summarize_state(state))\n}\n\npub fn summarize_state(state: &WorkingMemoryState) -> WorkingMemorySummary {\n    WorkingMemorySummary {\n        task_statement: state.task_statement.clone(),\n        intent_label: format!(\"{:?}\", state.interpreted_intent.primary_label),\n        active_file_count: state.active_files.len(),\n        active_symbol_count: state.active_symbols.len(),\n        selected_count: state.selected_memories.len(),\n        excluded_count: state.excluded_memories.len(),\n        token_cap: state.budget_decisions.token_cap,\n        dropped_count: state.budget_decisions.dropped_count,\n        truncated_results: state.budget_decisions.truncated_results,\n        pinned_count: state.budget_decisions.pinned_identities.len(),\n        top_hypotheses: state\n            .active_hypotheses\n            .iter()\n            .take(3)\n            .map(|hypothesis| hypothesis.text.clone())\n            .collect(),\n    }\n}\n\n/// `## 5. Working Memory` requires filter to move removed context into\n/// `excluded_memories` with an auditable predicate reason.\npub fn filter(\n    state: &mut WorkingMemoryState,\n    predicate: &dyn FilterPredicate,\n    ctx: &OpContext<'_>,\n) -> Result<usize, LatticeError> {\n    let state_before = state.clone();\n    let removed = filter_selected_memories(state, predicate);\n    refresh_active_context(state);\n    let summary = format!(\"removed={} predicate={}\", removed, predicate.description());\n    record_if_changed(&state_before, state, WorkingMemoryOp::Filter, summary, ctx)?;\n    Ok(removed)\n}\n\n/// `## 5. Working Memory` requires pin to define identities the shaper must\n/// preserve across compression.\npub fn pin(\n    state: &mut WorkingMemoryState,\n    args: PinArgs,\n    ctx: &OpContext<'_>,\n) -> Result<PinOutcome, LatticeError> {\n    let state_before = state.clone();\n    let added_count = args\n        .identities\n        .into_iter()\n        .filter(|identity| {\n            state\n                .budget_decisions\n                .pinned_identities\n                .insert(identity.clone())\n        })\n        .count();\n    let summary = format!(\n        \"added={} pinned={}\",\n        added_count,\n        state.budget_decisions.pinned_identities.len()\n    );\n    record_if_changed(&state_before, state, WorkingMemoryOp::Pin, summary, ctx)?;\n    Ok(PinOutcome {\n        added_count,\n        pinned_count: state.budget_decisions.pinned_identities.len(),\n    })\n}\n\n/// `## 5. Working Memory` requires evict to remove selected context while\n/// recording the operator-supplied reason.\npub fn evict(\n    state: &mut WorkingMemoryState,\n    args: EvictArgs,\n    ctx: &OpContext<'_>,\n) -> Result<EvictOutcome, LatticeError> {\n    reject_pinned_eviction(state, &args)?;\n    let state_before = state.clone();\n    let reason = eviction_reason(&args);\n    let identities = args.identities.into_iter().collect::<BTreeSet<_>>();\n    let evicted = evict_selected_memories(state, &identities, &reason);\n    state\n        .budget_decisions\n        .pinned_identities\n        .retain(|identity| !identities.contains(identity));\n    refresh_active_context(state);\n    let summary = format!(\"evicted={} requested={}\", evicted, identities.len());\n    record_if_changed(&state_before, state, WorkingMemoryOp::Evict, summary, ctx)?;\n    Ok(EvictOutcome {\n        evicted_count: evicted,\n        skipped_absent_count: identities.len().saturating_sub(evicted),\n    })\n}\n\n/// `## 5. Working Memory` requires expand to widen retrieval around an existing\n/// selected result using its expansion handle.\npub fn expand(\n    state: &mut WorkingMemoryState,\n    args: ExpandArgs,\n    ctx: &OpContext<'_>,\n) -> Result<ExpandOutcome, LatticeError> {\n    let state_before = state.clone();\n    let target = selected_target(state, &args.expansion_handle)?;\n    let execution = ctx.retriever.expand(state, &target, &args, ctx)?;\n    let added = merge_selected_memories(\n        &mut state.selected_memories,\n        execution.bundle.results.clone(),\n    );\n    state\n        .excluded_memories\n        .extend(execution.excluded_memories.clone());\n    apply_budget_report(&mut state.budget_decisions, &execution.bundle.budget_report);\n    refresh_active_context(state);\n    let summary = format!(\n        \"added={} selected={}\",\n        added.len(),\n        state.selected_memories.len()\n    );\n    record_if_changed(&state_before, state, WorkingMemoryOp::Expand, summary, ctx)?;\n    Ok(ExpandOutcome {\n        bundle: execution.bundle,\n        added_count: added.len(),\n        excluded_count: execution.excluded_memories.len(),\n    })\n}\n\n/// `## 5. Working Memory` requires compress to reuse the Retrieval V1 shaper\n/// policy while honoring pinned identities.\npub fn compress(\n    state: &mut WorkingMemoryState,\n    args: CompressArgs,\n    ctx: &OpContext<'_>,\n) -> Result<CompressOutcome, LatticeError> {\n    let state_before = state.clone();\n    let shaper = shaper_with_state_pins(&ctx.shaper, &state.budget_decisions, args.token_budget);\n    let compression = compress_bundle_results(state.selected_memories.clone(), &shaper);\n    let removed_count = compression.dropped_results.len();\n    state.selected_memories = compression.results;\n    state.excluded_memories.extend(to_excluded_memories(\n        compression.dropped_results,\n        format!(\"compressed: budget={} tokens\", args.token_budget),\n    ));\n    apply_budget_report(&mut state.budget_decisions, &compression.budget_report);\n    refresh_active_context(state);\n    let summary = format!(\n        \"removed={} retained={}\",\n        removed_count,\n        state.selected_memories.len()\n    );\n    record_if_changed(\n        &state_before,\n        state,\n        WorkingMemoryOp::Compress,\n        summary,\n        ctx,\n    )?;\n    Ok(CompressOutcome {\n        removed_count,\n        retained_count: state.selected_memories.len(),\n        budget_report: compression.budget_report,\n    })\n}\n\n/// `## 5. Working Memory` requires checkpoint to persist the current state\n/// through the T34 checkpoint path without a parallel write path.\npub fn checkpoint(\n    state: &mut WorkingMemoryState,\n    args: CheckpointArgs,\n    ctx: &OpContext<'_>,\n) -> Result<CheckpointOutcome, LatticeError> {\n    Ok(CheckpointOutcome {\n        checkpoint_id: save_checkpoint(state, &args.name, ctx.conn)?,\n    })\n}\n\nfn build_diagnostics(\n    diagnostic_mode: DiagnosticMode,\n    intent: &crate::retrieval_v1::IntentClassification,\n    anchors: &[crate::retrieval_v1::ResolvedAnchor],\n    ranked: &[crate::retrieval_v1::RankedCandidate],\n    weights: &ScoringWeights,\n) -> Option<RankingDiagnostics> {\n    matches!(diagnostic_mode, DiagnosticMode::Diagnostic).then(|| {\n        RankingDiagnostics::new(\n            intent.clone(),\n            anchors.to_vec(),\n            ranked.to_vec(),\n            weights.clone(),\n        )\n    })\n}\n\nfn maybe_replace_task(state: &mut WorkingMemoryState, query_text: Option<&str>) {\n    if let Some(query_text) = query_text {\n        state.task_statement = query_text.to_string();\n    }\n}\n\nfn merge_selected_memories(\n    selected: &mut Vec<BundleResult>,\n    incoming: Vec<BundleResult>,\n) -> Vec<Identity> {\n    let mut index_by_identity = selected\n        .iter()\n        .enumerate()\n        .map(|(index, result)| (result.identity.clone(), index))\n        .collect::<HashMap<_, _>>();\n    let mut added = Vec::new();\n    for result in incoming {\n        if let Some(index) = index_by_identity.get(&result.identity).copied() {\n            selected[index] = result;\n        } else {\n            index_by_identity.insert(result.identity.clone(), selected.len());\n            added.push(result.identity.clone());\n            selected.push(result);\n        }\n    }\n    added\n}\n\nfn filter_selected_memories(\n    state: &mut WorkingMemoryState,\n    predicate: &dyn FilterPredicate,\n) -> usize {\n    let mut retained = Vec::with_capacity(state.selected_memories.len());\n    let mut removed = 0usize;\n    for result in state.selected_memories.drain(..) {\n        if predicate.matches(&result) {\n            retained.push(result);\n        } else {\n            state.excluded_memories.push(ExcludedMemory {\n                result,\n                exclusion_reason: format!(\"filtered: {}\", predicate.description()),\n            });\n            removed += 1;\n        }\n    }\n    state.selected_memories = retained;\n    removed\n}\n\nfn reject_pinned_eviction(\n    state: &WorkingMemoryState,\n    args: &EvictArgs,\n) -> Result<(), LatticeError> {\n    if args.force {\n        return Ok(());\n    }\n    let pinned = args\n        .identities\n        .iter()\n        .find(|identity| state.budget_decisions.pinned_identities.contains(*identity));\n    match pinned {\n        Some(identity) => Err(LatticeError::Query(format!(\n            \"Cannot evict pinned identity `{}` without force=true\",\n            identity\n        ))),\n        None => Ok(()),\n    }\n}\n\nfn evict_selected_memories(\n    state: &mut WorkingMemoryState,\n    identities: &BTreeSet<Identity>,\n    reason: &str,\n) -> usize {\n    let mut retained = Vec::with_capacity(state.selected_memories.len());\n    let mut evicted = 0usize;\n    for result in state.selected_memories.drain(..) {\n        if identities.contains(&result.identity) {\n            state.excluded_memories.push(ExcludedMemory {\n                result,\n                exclusion_reason: reason.to_string(),\n            });\n            evicted += 1;\n        } else {\n            retained.push(result);\n        }\n    }\n    state.selected_memories = retained;\n    evicted\n}\n\nfn eviction_reason(args: &EvictArgs) -> String {\n    if args.force {\n        format!(\"evicted: force=true; {}\", args.reason)\n    } else {\n        format!(\"evicted: {}\", args.reason)\n    }\n}\n\nfn selected_target(\n    state: &WorkingMemoryState,\n    expansion_handle: &str,\n) -> Result<BundleResult, LatticeError> {\n    state\n        .selected_memories\n        .iter()\n        .find(|result| result.expansion_handle == expansion_handle)\n        .cloned()\n        .ok_or_else(|| {\n            LatticeError::Query(format!(\n                \"No selected memory matches expansion handle `{expansion_handle}`\"\n            ))\n        })\n}\n\nfn apply_budget_report(decisions: &mut BudgetDecisions, report: &BudgetReport) {\n    decisions.token_cap = report.token_budget;\n    decisions.dropped_count = report.dropped_results;\n    decisions.truncated_results = report.trimmed_snippets;\n}\n\nfn refresh_active_context(state: &mut WorkingMemoryState) {\n    state.active_files = state\n        .selected_memories\n        .iter()\n        .filter_map(|result| match &result.identity {\n            Identity::File(file) => Some(file.clone()),\n            Identity::Symbol(symbol) => Some(symbol.file.clone()),\n            _ => None,\n        })\n        .collect::<BTreeSet<FileIdentity>>();\n    state.active_symbols = state\n        .selected_memories\n        .iter()\n        .filter_map(|result| match &result.identity {\n            Identity::Symbol(symbol) => Some(symbol.clone()),\n            _ => None,\n        })\n        .collect::<BTreeSet<SymbolIdentity>>();\n}\n\nfn record_if_changed(\n    state_before: &WorkingMemoryState,\n    state: &WorkingMemoryState,\n    op: WorkingMemoryOp,\n    summary: String,\n    ctx: &OpContext<'_>,\n) -> Result<(), LatticeError> {\n    let before_hash = state_hash(state_before)?;\n    let after_hash = state_hash(state)?;\n    if before_hash == after_hash {\n        return Ok(());\n    }\n    record_state_mutation(\n        state_before,\n        state,\n        op,\n        before_hash,\n        after_hash,\n        summary,\n        ctx,\n    )\n}\n\nfn record_state_mutation(\n    state_before: &WorkingMemoryState,\n    state_after: &WorkingMemoryState,\n    op: WorkingMemoryOp,\n    before_hash: String,\n    after_hash: String,\n    summary: String,\n    ctx: &OpContext<'_>,\n) -> Result<(), LatticeError> {\n    match ctx.mutation_observer {\n        Some(observer) => observer.record(StateMutationRecord {\n            op,\n            op_name: op.as_str().to_string(),\n            before_hash,\n            after_hash,\n            summary,\n            state_before: state_before.clone(),\n            state_after: state_after.clone(),\n        }),\n        None => Ok(()),\n    }\n}\n\nfn selected_identities(state: &WorkingMemoryState) -> Vec<Identity> {\n    state\n        .selected_memories\n        .iter()\n        .map(|result| result.identity.clone())\n        .collect()\n}\n\nfn expand_recent_identities(state: &WorkingMemoryState, target: &Identity) -> Vec<Identity> {\n    let mut identities = selected_identities(state);\n    if !identities.contains(target) {\n        identities.push(target.clone());\n    }\n    identities\n}\n\nfn summarize_anchor_texts(anchors: &[crate::retrieval_v1::ResolvedAnchor]) -> String {\n    anchors\n        .iter()\n        .map(|anchor| anchor.anchor_text.as_str())\n        .collect::<Vec<_>>()\n        .join(\", \")\n}\n\nfn shaper_with_state_pins(\n    base: &ShaperContext,\n    decisions: &BudgetDecisions,\n    token_budget: usize,\n) -> ShaperContext {\n    let mut pins = base.pins.clone();\n    pins.extend(decisions.pinned_identities.iter().cloned());\n    ShaperContext {\n        pins,\n        budget: ShaperBudget {\n            max_tokens: token_budget,\n        },\n    }\n}\n\nfn to_excluded_memories(results: Vec<BundleResult>, reason: String) -> Vec<ExcludedMemory> {\n    results\n        .into_iter()\n        .map(|result| ExcludedMemory {\n            result,\n            exclusion_reason: reason.clone(),\n        })\n        .collect()\n}\n\nfn expansion_anchor_text(target: &BundleResult) -> Result<String, LatticeError> {\n    let identity = decode_identity(&target.expansion_handle).map_err(|error| {\n        LatticeError::Query(format!(\n            \"Invalid expansion handle `{}`: {}\",\n            target.expansion_handle, error\n        ))\n    })?;\n    Ok(match identity {\n        Identity::File(file) => file.repo_relative_path,\n        Identity::Symbol(symbol) => symbol.qualified_name,\n        Identity::Doc(doc) => doc.repo_relative_path,\n        Identity::Section(section) => format!(\n            \"{}#{}\",\n            section.doc.repo_relative_path,\n            section.heading_path.join(\" > \")\n        ),\n        Identity::Event(event) => format!(\"event {}\", event.ulid),\n        Identity::Memory(memory) => format!(\"memory {}\", memory.ulid),\n        Identity::ContextHandle(handle) => format!(\"handle {}\", handle.ulid),\n    })\n}\n\nfn widen_budget(budget: &RetrievalBudget) -> RetrievalBudget {\n    RetrievalBudget {\n        max_candidates_per_source: budget.max_candidates_per_source.saturating_mul(2).max(1),\n        max_graph_hops: budget.max_graph_hops.saturating_add(1),\n        max_fts_rows: budget.max_fts_rows.saturating_mul(2).max(1),\n        embedding_k: budget.embedding_k.saturating_mul(2).max(1),\n        event_window: budget.event_window.saturating_mul(2).max(1),\n        working_memory_window: budget.working_memory_window.saturating_mul(2).max(1),\n    }\n}\n","numLines":849,"startLine":1,"totalLines":849}}}
