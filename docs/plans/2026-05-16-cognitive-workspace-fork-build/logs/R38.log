{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AyvznrspxDsg2FPWTpPRYq","type":"tool_result","content":"1\tuse std::cell::RefCell;\n2\tuse std::collections::HashSet;\n3\t\n4\tuse rusqlite::Connection;\n5\t\n6\tuse super::operations::{\n7\t    checkpoint, compress, evict, expand, filter, pin, retrieve, summarize, CheckpointArgs,\n8\t    CompressArgs, EvictArgs, ExpandArgs, FilterPredicate, OpContext, PinArgs, RetrievalExecution,\n9\t    RetrieveArgs, StateMutationObserver, StateMutationRecord, SummarizeArgs,\n10\t    WorkingMemoryRetriever,\n11\t};\n12\tuse super::state::{\n13\t    initialize_schema, load_checkpoint, BudgetDecisions, Hypothesis, WorkingMemoryState,\n14\t};\n15\tuse crate::graph::CodeGraph;\n16\tuse crate::identity::IdentityResolver;\n17\tuse crate::identity::{FileId, Identity, IdentityKind, MemoryId};\n18\tuse crate::memory::MemoryVerificationStatus;\n19\tuse crate::retrieval_v1::{\n20\t    schema::{BudgetReport, BundleResult, RetrievalBundle},\n21\t    DiagnosticMode, RetrievalBudget, RetrievalProfile, ShaperBudget, ShaperContext,\n22\t};\n23\t\n24\tconst WORKSPACE: &str = \"workspace-main\";\n25\t\n26\t#[test]\n27\tfn retrieve_populates_selected_and_excluded_memories() {\n28\t    let harness = Harness::new(FakeRetriever::default());\n29\t    let mut state = sample_state();\n30\t\n31\t    let outcome = retrieve(&mut state, RetrieveArgs::default(), &harness.ctx()).expect(\"retrieve\");\n32\t\n33\t    assert_eq!(outcome.added_identities.len(), 2);\n34\t    assert_eq!(state.selected_memories.len(), 2);\n35\t    assert_eq!(state.excluded_memories.len(), 1);\n36\t    assert!(state.excluded_memories[0]\n37\t        .exclusion_reason\n38\t        .contains(\"compressed\"));\n39\t    assert_eq!(harness.observer.records.borrow().len(), 1);\n40\t}\n41\t\n42\t#[test]\n43\tfn summarize_returns_expected_fields() {\n44\t    let harness = Harness::new(FakeRetriever::default());\n45\t    let mut state = sample_state();\n46\t    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n47\t    state.active_hypotheses = vec![Hypothesis {\n48\t        text: \"Top hypothesis\".to_string(),\n49\t        evidence_refs: vec![\"docs/spec.md#5\".to_string()],\n50\t        confidence: 0.9,\n51\t    }];\n52\t\n53\t    let summary = summarize(&mut state, SummarizeArgs, &harness.ctx()).expect(\"summary\");\n54\t\n55\t    assert_eq!(summary.task_statement, state.task_statement);\n56\t    assert_eq!(summary.selected_count, 1);\n57\t    assert_eq!(summary.top_hypotheses, vec![\"Top hypothesis\".to_string()]);\n58\t}\n59\t\n60\t#[test]\n61\tfn filter_records_predicate_description() {\n62\t    let harness = Harness::new(FakeRetriever::default());\n63\t    let mut state = sample_state();\n64\t    state.selected_memories = vec![\n65\t        sample_bundle_result(\"keep-me\", 0.8),\n66\t        sample_bundle_result(\"drop-me\", 0.7),\n67\t    ];\n68\t\n69\t    let removed = filter(&mut state, &HeadlineFilter(\"keep\"), &harness.ctx()).expect(\"filter\");\n70\t\n71\t    assert_eq!(removed, 1);\n72\t    assert_eq!(state.selected_memories.len(), 1);\n73\t    assert_eq!(\n74\t        state.excluded_memories[0].exclusion_reason,\n75\t        \"filtered: headline contains `keep`\"\n76\t    );\n77\t}\n78\t\n79\t#[test]\n80\tfn pin_is_idempotent_and_compress_preserves_pinned_identity() {\n81\t    let harness = Harness::new(FakeRetriever::default());\n82\t    let mut state = sample_state();\n83\t    let pinned = file_identity(\"src/pinned.rs\");\n84\t    state.selected_memories = vec![\n85\t        long_bundle_result(pinned.clone(), \"Pinned\", 0.9),\n86\t        long_bundle_result(file_identity(\"src/other-a.rs\"), \"Other A\", 0.8),\n87\t        long_bundle_result(file_identity(\"src/other-b.rs\"), \"Other B\", 0.7),\n88\t    ];\n89\t\n90\t    let first = pin(\n91\t        &mut state,\n92\t        PinArgs {\n93\t            identities: vec![pinned.clone()],\n94\t        },\n95\t        &harness.ctx(),\n96\t    )\n97\t    .expect(\"first pin\");\n98\t    let second = pin(\n99\t        &mut state,\n100\t        PinArgs {\n101\t            identities: vec![pinned.clone()],\n102\t        },\n103\t        &harness.ctx(),\n104\t    )\n105\t    .expect(\"second pin\");\n106\t    let compressed = compress(\n107\t        &mut state,\n108\t        CompressArgs { token_budget: 70 },\n109\t        &harness.ctx(),\n110\t    )\n111\t    .expect(\"compress\");\n112\t\n113\t    assert_eq!(first.added_count, 1);\n114\t    assert_eq!(second.added_count, 0);\n115\t    assert!(state\n116\t        .selected_memories\n117\t        .iter()\n118\t        .any(|result| result.identity == pinned));\n119\t    assert!(compressed.removed_count >= 1);\n120\t}\n121\t\n122\t#[test]\n123\tfn evict_of_pinned_identity_without_force_is_refused() {\n124\t    let harness = Harness::new(FakeRetriever::default());\n125\t    let mut state = sample_state();\n126\t    let pinned = sample_identity(\"memory-a\");\n127\t    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n128\t    state\n129\t        .budget_decisions\n130\t        .pinned_identities\n131\t        .insert(pinned.clone());\n132\t\n133\t    let error = evict(\n134\t        &mut state,\n135\t        EvictArgs {\n136\t            identities: vec![pinned],\n137\t            reason: \"manual trim\".to_string(),\n138\t            force: false,\n139\t        },\n140\t        &harness.ctx(),\n141\t    )\n142\t    .expect_err(\"pinned eviction should fail\");\n143\t\n144\t    assert!(error.to_string().contains(\"Cannot evict pinned identity\"));\n145\t}\n146\t\n147\t#[test]\n148\tfn evict_forced_identity_records_reason_and_absent_count() {\n149\t    let harness = Harness::new(FakeRetriever::default());\n150\t    let mut state = sample_state();\n151\t    let present = sample_identity(\"memory-a\");\n152\t    let absent = sample_identity(\"missing\");\n153\t    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n154\t\n155\t    let outcome = evict(\n156\t        &mut state,\n157\t        EvictArgs {\n158\t            identities: vec![present, absent],\n159\t            reason: \"manual trim\".to_string(),\n160\t            force: true,\n161\t        },\n162\t        &harness.ctx(),\n163\t    )\n164\t    .expect(\"forced evict\");\n165\t\n166\t    assert_eq!(outcome.evicted_count, 1);\n167\t    assert_eq!(outcome.skipped_absent_count, 1);\n168\t    assert_eq!(\n169\t        state.excluded_memories[0].exclusion_reason,\n170\t        \"evicted: force=true; manual trim\"\n171\t    );\n172\t}\n173\t\n174\t#[test]\n175\tfn expand_appends_new_high_ranked_candidates() {\n176\t    let harness = Harness::new(FakeRetriever::with_expand_result());\n177\t    let mut state = sample_state();\n178\t    let target = sample_bundle_result(\"memory-a\", 0.8);\n179\t    state.selected_memories = vec![target.clone()];\n180\t\n181\t    let outcome = expand(\n182\t        &mut state,\n183\t        ExpandArgs {\n184\t            task_id: \"expand-case\".to_string(),\n185\t            expansion_handle: target.expansion_handle.clone(),\n186\t            budget: RetrievalBudget::default(),\n187\t            diagnostic_mode: DiagnosticMode::Compact,\n188\t            query_embedding: None,\n189\t        },\n190\t        &harness.ctx(),\n191\t    )\n192\t    .expect(\"expand\");\n193\t\n194\t    assert_eq!(outcome.added_count, 1);\n195\t    assert_eq!(state.selected_memories.len(), 2);\n196\t}\n197\t\n198\t#[test]\n199\tfn checkpoint_round_trips_state_bytes() {\n200\t    let harness = Harness::new(FakeRetriever::default());\n201\t    let mut state = sample_state();\n202\t    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n203\t\n204\t    let outcome = checkpoint(\n205\t        &mut state,\n206\t        CheckpointArgs {\n207\t            name: \"before-compress\".to_string(),\n208\t        },\n209\t        &harness.ctx(),\n210\t    )\n211\t    .expect(\"checkpoint\");\n212\t    let loaded = load_checkpoint(outcome.checkpoint_id, &harness.conn).expect(\"load checkpoint\");\n213\t\n214\t    assert_eq!(loaded, state);\n215\t}\n216\t\n217\t#[test]\n218\tfn checkpoint_name_versions_instead_of_overwriting() {\n219\t    let harness = Harness::new(FakeRetriever::default());\n220\t    let mut state = sample_state();\n221\t\n222\t    let first = checkpoint(\n223\t        &mut state,\n224\t        CheckpointArgs {\n225\t            name: \"same-name\".to_string(),\n226\t        },\n227\t        &harness.ctx(),\n228\t    )\n229\t    .expect(\"first checkpoint\");\n230\t    let second = checkpoint(\n231\t        &mut state,\n232\t        CheckpointArgs {\n233\t            name: \"same-name\".to_string(),\n234\t        },\n235\t        &harness.ctx(),\n236\t    )\n237\t    .expect(\"second checkpoint\");\n238\t\n239\t    assert!(second.checkpoint_id > first.checkpoint_id);\n240\t}\n241\t\n242\tstruct HeadlineFilter(&'static str);\n243\t\n244\timpl FilterPredicate for HeadlineFilter {\n245\t    fn description(&self) -> &str {\n246\t        \"headline contains `keep`\"\n247\t    }\n248\t\n249\t    fn matches(&self, result: &BundleResult) -> bool {\n250\t        result.headline.contains(self.0)\n251\t    }\n252\t}\n253\t\n254\t#[derive(Clone)]\n255\tstruct FakeRetriever {\n256\t    retrieve_execution: RetrievalExecution,\n257\t    expand_execution: RetrievalExecution,\n258\t}\n259\t\n260\timpl Default for FakeRetriever {\n261\t    fn default() -> Self {\n262\t        Self {\n263\t            retrieve_execution: RetrievalExecution {\n264\t                bundle: sample_bundle(\n265\t                    vec![\n266\t                        sample_bundle_result(\"memory-a\", 0.8),\n267\t                        sample_bundle_result(\"memory-b\", 0.7),\n268\t                    ],\n269\t                    240,\n270\t                ),\n271\t                excluded_memories: vec![super::state::ExcludedMemory {\n272\t                    result: sample_bundle_result(\"memory-c\", 0.6),\n273\t                    exclusion_reason: \"compressed: budget=240 tokens\".to_string(),\n274\t                }],\n275\t            },\n276\t            expand_execution: RetrievalExecution {\n277\t                bundle: sample_bundle(vec![sample_bundle_result(\"memory-a\", 0.8)], 240),\n278\t                excluded_memories: Vec::new(),\n279\t            },\n280\t        }\n281\t    }\n282\t}\n283\t\n284\timpl FakeRetriever {\n285\t    fn with_expand_result() -> Self {\n286\t        Self {\n287\t            expand_execution: RetrievalExecution {\n288\t                bundle: sample_bundle(\n289\t                    vec![\n290\t                        sample_bundle_result(\"memory-a\", 0.8),\n291\t                        sample_bundle_result(\"memory-expanded\", 0.75),\n292\t                    ],\n293\t                    320,\n294\t                ),\n295\t                excluded_memories: Vec::new(),\n296\t            },\n297\t            ..Self::default()\n298\t        }\n299\t    }\n300\t}\n301\t\n302\timpl WorkingMemoryRetriever for FakeRetriever {\n303\t    fn retrieve(\n304\t        &self,\n305\t        _state: &WorkingMemoryState,\n306\t        _args: &RetrieveArgs,\n307\t        _ctx: &OpContext<'_>,\n308\t    ) -> Result<RetrievalExecution, crate::error::LatticeError> {\n309\t        Ok(self.retrieve_execution.clone())\n310\t    }\n311\t\n312\t    fn expand(\n313\t        &self,\n314\t        _state: &WorkingMemoryState,\n315\t        _target: &BundleResult,\n316\t        _args: &ExpandArgs,\n317\t        _ctx: &OpContext<'_>,\n318\t    ) -> Result<RetrievalExecution, crate::error::LatticeError> {\n319\t        Ok(self.expand_execution.clone())\n320\t    }\n321\t}\n322\t\n323\tstruct Observer {\n324\t    records: RefCell<Vec<StateMutationRecord>>,\n325\t}\n326\t\n327\timpl StateMutationObserver for Observer {\n328\t    fn record(&self, mutation: StateMutationRecord) -> Result<(), crate::error::LatticeError> {\n329\t        self.records.borrow_mut().push(mutation);\n330\t        Ok(())\n331\t    }\n332\t}\n333\t\n334\tstruct Harness {\n335\t    conn: Connection,\n336\t    resolver: &'static IdentityResolver<'static>,\n337\t    retriever: FakeRetriever,\n338\t    observer: Observer,\n339\t}\n340\t\n341\timpl Harness {\n342\t    fn new(retriever: FakeRetriever) -> Self {\n343\t        let conn = Connection::open_in_memory().expect(\"in-memory connection\");\n344\t        initialize_schema(&conn).expect(\"schema\");\n345\t        let graph = Box::leak(Box::new(CodeGraph::default()));\n346\t        let file_index = Box::leak(Box::new(Default::default()));\n347\t        let parsed_files = Box::leak(Box::new(Default::default()));\n348\t        let resolver = Box::leak(Box::new(IdentityResolver::new(\n349\t            graph,\n350\t            file_index,\n351\t            parsed_files,\n352\t            WORKSPACE.to_string(),\n353\t            Vec::new(),\n354\t        )));\n355\t        Self {\n356\t            conn,\n357\t            resolver,\n358\t            retriever,\n359\t            observer: Observer {\n360\t                records: RefCell::new(Vec::new()),\n361\t            },\n362\t        }\n363\t    }\n364\t\n365\t    fn ctx(&self) -> OpContext<'_> {\n366\t        OpContext {\n367\t            conn: &self.conn,\n368\t            retrieval_profile: RetrievalProfile::Balanced,\n369\t            identity_resolver: self.resolver,\n370\t            shaper: ShaperContext {\n371\t                pins: HashSet::new(),\n372\t                budget: ShaperBudget { max_tokens: 320 },\n373\t            },\n374\t            retriever: &self.retriever,\n375\t            mutation_observer: Some(&self.observer),\n376\t        }\n377\t    }\n378\t}\n379\t\n380\tfn sample_state() -> WorkingMemoryState {\n381\t    WorkingMemoryState {\n382\t        task_statement: \"Investigate working memory operations\".to_string(),\n383\t        interpreted_intent: crate::retrieval_v1::classify_intent(\n384\t            \"Investigate working memory operations\",\n385\t        ),\n386\t        active_files: Default::default(),\n387\t        active_symbols: Default::default(),\n388\t        active_hypotheses: Vec::new(),\n389\t        active_failures: Vec::new(),\n390\t        current_plan: None,\n391\t        selected_memories: Vec::new(),\n392\t        excluded_memories: Vec::new(),\n393\t        budget_decisions: BudgetDecisions {\n394\t            token_cap: 0,\n395\t            dropped_count: 0,\n396\t            truncated_results: 0,\n397\t            pinned_identities: Default::default(),\n398\t        },\n399\t        unresolved_questions: Vec::new(),\n400\t        verification_status: super::state::WorkingMemoryVerification {\n401\t            last_verified_at: None,\n402\t            status: MemoryVerificationStatus::Unverified,\n403\t            notes: Vec::new(),\n404\t        },\n405\t    }\n406\t}\n407\t\n408\tfn sample_bundle(results: Vec<BundleResult>, token_budget: usize) -> RetrievalBundle {\n409\t    RetrievalBundle {\n410\t        task_id: \"task\".to_string(),\n411\t        intent_summary: \"Debug\".to_string(),\n412\t        anchors_summary: \"memory\".to_string(),\n413\t        results,\n414\t        diagnostics: None,\n415\t        budget_report: BudgetReport {\n416\t            token_budget,\n417\t            estimated_tokens: token_budget / 2,\n418\t            trimmed_snippets: 0,\n419\t            dropped_results: 0,\n420\t            truncated: false,\n421\t        },\n422\t    }\n423\t}\n424\t\n425\tfn sample_bundle_result(ulid: &str, score: f32) -> BundleResult {\n426\t    BundleResult {\n427\t        identity: sample_identity(ulid),\n428\t        kind: IdentityKind::Memory,\n429\t        headline: format!(\"Memory {ulid}\"),\n430\t        snippet: format!(\"Snippet for {ulid}\"),\n431\t        inclusion_reason: \"selected memory\".to_string(),\n432\t        expansion_handle: crate::identity::encode_identity(&sample_identity(ulid)),\n433\t        source: Vec::new(),\n434\t        score,\n435\t    }\n436\t}\n437\t\n438\tfn long_bundle_result(identity: Identity, headline: &str, score: f32) -> BundleResult {\n439\t    BundleResult {\n440\t        identity: identity.clone(),\n441\t        kind: identity.kind(),\n442\t        headline: headline.to_string(),\n443\t        snippet: \"This snippet is intentionally long so compression has to trim and evict results from working memory.\"\n444\t            .repeat(4),\n445\t        inclusion_reason: \"selected memory\".to_string(),\n446\t        expansion_handle: crate::identity::encode_identity(&identity),\n447\t        source: Vec::new(),\n448\t        score,\n449\t    }\n450\t}\n451\t\n452\tfn sample_identity(ulid: &str) -> Identity {\n453\t    Identity::Memory(MemoryId {\n454\t        workspace_id: WORKSPACE.to_string(),\n455\t        ulid: ulid.to_string(),\n456\t    })\n457\t}\n458\t\n459\tfn file_identity(path: &str) -> Identity {\n460\t    Identity::File(FileId {\n461\t        workspace_id: WORKSPACE.to_string(),\n462\t        repo_relative_path: path.to_string(),\n463\t        content_hash: \"hash\".to_string(),\n464\t    })\n465\t}\n466\t"}]},"parent_tool_use_id":null,"session_id":"1b2121c5-8450-4d0d-9f66-0986877cae23","uuid":"50293c4b-a302-4310-b24c-6769dbaaa34d","timestamp":"2026-05-17T10:13:58.194Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/working_memory/operations_tests.rs","content":"use std::cell::RefCell;\nuse std::collections::HashSet;\n\nuse rusqlite::Connection;\n\nuse super::operations::{\n    checkpoint, compress, evict, expand, filter, pin, retrieve, summarize, CheckpointArgs,\n    CompressArgs, EvictArgs, ExpandArgs, FilterPredicate, OpContext, PinArgs, RetrievalExecution,\n    RetrieveArgs, StateMutationObserver, StateMutationRecord, SummarizeArgs,\n    WorkingMemoryRetriever,\n};\nuse super::state::{\n    initialize_schema, load_checkpoint, BudgetDecisions, Hypothesis, WorkingMemoryState,\n};\nuse crate::graph::CodeGraph;\nuse crate::identity::IdentityResolver;\nuse crate::identity::{FileId, Identity, IdentityKind, MemoryId};\nuse crate::memory::MemoryVerificationStatus;\nuse crate::retrieval_v1::{\n    schema::{BudgetReport, BundleResult, RetrievalBundle},\n    DiagnosticMode, RetrievalBudget, RetrievalProfile, ShaperBudget, ShaperContext,\n};\n\nconst WORKSPACE: &str = \"workspace-main\";\n\n#[test]\nfn retrieve_populates_selected_and_excluded_memories() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n\n    let outcome = retrieve(&mut state, RetrieveArgs::default(), &harness.ctx()).expect(\"retrieve\");\n\n    assert_eq!(outcome.added_identities.len(), 2);\n    assert_eq!(state.selected_memories.len(), 2);\n    assert_eq!(state.excluded_memories.len(), 1);\n    assert!(state.excluded_memories[0]\n        .exclusion_reason\n        .contains(\"compressed\"));\n    assert_eq!(harness.observer.records.borrow().len(), 1);\n}\n\n#[test]\nfn summarize_returns_expected_fields() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n    state.active_hypotheses = vec![Hypothesis {\n        text: \"Top hypothesis\".to_string(),\n        evidence_refs: vec![\"docs/spec.md#5\".to_string()],\n        confidence: 0.9,\n    }];\n\n    let summary = summarize(&mut state, SummarizeArgs, &harness.ctx()).expect(\"summary\");\n\n    assert_eq!(summary.task_statement, state.task_statement);\n    assert_eq!(summary.selected_count, 1);\n    assert_eq!(summary.top_hypotheses, vec![\"Top hypothesis\".to_string()]);\n}\n\n#[test]\nfn filter_records_predicate_description() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    state.selected_memories = vec![\n        sample_bundle_result(\"keep-me\", 0.8),\n        sample_bundle_result(\"drop-me\", 0.7),\n    ];\n\n    let removed = filter(&mut state, &HeadlineFilter(\"keep\"), &harness.ctx()).expect(\"filter\");\n\n    assert_eq!(removed, 1);\n    assert_eq!(state.selected_memories.len(), 1);\n    assert_eq!(\n        state.excluded_memories[0].exclusion_reason,\n        \"filtered: headline contains `keep`\"\n    );\n}\n\n#[test]\nfn pin_is_idempotent_and_compress_preserves_pinned_identity() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    let pinned = file_identity(\"src/pinned.rs\");\n    state.selected_memories = vec![\n        long_bundle_result(pinned.clone(), \"Pinned\", 0.9),\n        long_bundle_result(file_identity(\"src/other-a.rs\"), \"Other A\", 0.8),\n        long_bundle_result(file_identity(\"src/other-b.rs\"), \"Other B\", 0.7),\n    ];\n\n    let first = pin(\n        &mut state,\n        PinArgs {\n            identities: vec![pinned.clone()],\n        },\n        &harness.ctx(),\n    )\n    .expect(\"first pin\");\n    let second = pin(\n        &mut state,\n        PinArgs {\n            identities: vec![pinned.clone()],\n        },\n        &harness.ctx(),\n    )\n    .expect(\"second pin\");\n    let compressed = compress(\n        &mut state,\n        CompressArgs { token_budget: 70 },\n        &harness.ctx(),\n    )\n    .expect(\"compress\");\n\n    assert_eq!(first.added_count, 1);\n    assert_eq!(second.added_count, 0);\n    assert!(state\n        .selected_memories\n        .iter()\n        .any(|result| result.identity == pinned));\n    assert!(compressed.removed_count >= 1);\n}\n\n#[test]\nfn evict_of_pinned_identity_without_force_is_refused() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    let pinned = sample_identity(\"memory-a\");\n    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n    state\n        .budget_decisions\n        .pinned_identities\n        .insert(pinned.clone());\n\n    let error = evict(\n        &mut state,\n        EvictArgs {\n            identities: vec![pinned],\n            reason: \"manual trim\".to_string(),\n            force: false,\n        },\n        &harness.ctx(),\n    )\n    .expect_err(\"pinned eviction should fail\");\n\n    assert!(error.to_string().contains(\"Cannot evict pinned identity\"));\n}\n\n#[test]\nfn evict_forced_identity_records_reason_and_absent_count() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    let present = sample_identity(\"memory-a\");\n    let absent = sample_identity(\"missing\");\n    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n\n    let outcome = evict(\n        &mut state,\n        EvictArgs {\n            identities: vec![present, absent],\n            reason: \"manual trim\".to_string(),\n            force: true,\n        },\n        &harness.ctx(),\n    )\n    .expect(\"forced evict\");\n\n    assert_eq!(outcome.evicted_count, 1);\n    assert_eq!(outcome.skipped_absent_count, 1);\n    assert_eq!(\n        state.excluded_memories[0].exclusion_reason,\n        \"evicted: force=true; manual trim\"\n    );\n}\n\n#[test]\nfn expand_appends_new_high_ranked_candidates() {\n    let harness = Harness::new(FakeRetriever::with_expand_result());\n    let mut state = sample_state();\n    let target = sample_bundle_result(\"memory-a\", 0.8);\n    state.selected_memories = vec![target.clone()];\n\n    let outcome = expand(\n        &mut state,\n        ExpandArgs {\n            task_id: \"expand-case\".to_string(),\n            expansion_handle: target.expansion_handle.clone(),\n            budget: RetrievalBudget::default(),\n            diagnostic_mode: DiagnosticMode::Compact,\n            query_embedding: None,\n        },\n        &harness.ctx(),\n    )\n    .expect(\"expand\");\n\n    assert_eq!(outcome.added_count, 1);\n    assert_eq!(state.selected_memories.len(), 2);\n}\n\n#[test]\nfn checkpoint_round_trips_state_bytes() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n    state.selected_memories = vec![sample_bundle_result(\"memory-a\", 0.8)];\n\n    let outcome = checkpoint(\n        &mut state,\n        CheckpointArgs {\n            name: \"before-compress\".to_string(),\n        },\n        &harness.ctx(),\n    )\n    .expect(\"checkpoint\");\n    let loaded = load_checkpoint(outcome.checkpoint_id, &harness.conn).expect(\"load checkpoint\");\n\n    assert_eq!(loaded, state);\n}\n\n#[test]\nfn checkpoint_name_versions_instead_of_overwriting() {\n    let harness = Harness::new(FakeRetriever::default());\n    let mut state = sample_state();\n\n    let first = checkpoint(\n        &mut state,\n        CheckpointArgs {\n            name: \"same-name\".to_string(),\n        },\n        &harness.ctx(),\n    )\n    .expect(\"first checkpoint\");\n    let second = checkpoint(\n        &mut state,\n        CheckpointArgs {\n            name: \"same-name\".to_string(),\n        },\n        &harness.ctx(),\n    )\n    .expect(\"second checkpoint\");\n\n    assert!(second.checkpoint_id > first.checkpoint_id);\n}\n\nstruct HeadlineFilter(&'static str);\n\nimpl FilterPredicate for HeadlineFilter {\n    fn description(&self) -> &str {\n        \"headline contains `keep`\"\n    }\n\n    fn matches(&self, result: &BundleResult) -> bool {\n        result.headline.contains(self.0)\n    }\n}\n\n#[derive(Clone)]\nstruct FakeRetriever {\n    retrieve_execution: RetrievalExecution,\n    expand_execution: RetrievalExecution,\n}\n\nimpl Default for FakeRetriever {\n    fn default() -> Self {\n        Self {\n            retrieve_execution: RetrievalExecution {\n                bundle: sample_bundle(\n                    vec![\n                        sample_bundle_result(\"memory-a\", 0.8),\n                        sample_bundle_result(\"memory-b\", 0.7),\n                    ],\n                    240,\n                ),\n                excluded_memories: vec![super::state::ExcludedMemory {\n                    result: sample_bundle_result(\"memory-c\", 0.6),\n                    exclusion_reason: \"compressed: budget=240 tokens\".to_string(),\n                }],\n            },\n            expand_execution: RetrievalExecution {\n                bundle: sample_bundle(vec![sample_bundle_result(\"memory-a\", 0.8)], 240),\n                excluded_memories: Vec::new(),\n            },\n        }\n    }\n}\n\nimpl FakeRetriever {\n    fn with_expand_result() -> Self {\n        Self {\n            expand_execution: RetrievalExecution {\n                bundle: sample_bundle(\n                    vec![\n                        sample_bundle_result(\"memory-a\", 0.8),\n                        sample_bundle_result(\"memory-expanded\", 0.75),\n                    ],\n                    320,\n                ),\n                excluded_memories: Vec::new(),\n            },\n            ..Self::default()\n        }\n    }\n}\n\nimpl WorkingMemoryRetriever for FakeRetriever {\n    fn retrieve(\n        &self,\n        _state: &WorkingMemoryState,\n        _args: &RetrieveArgs,\n        _ctx: &OpContext<'_>,\n    ) -> Result<RetrievalExecution, crate::error::LatticeError> {\n        Ok(self.retrieve_execution.clone())\n    }\n\n    fn expand(\n        &self,\n        _state: &WorkingMemoryState,\n        _target: &BundleResult,\n        _args: &ExpandArgs,\n        _ctx: &OpContext<'_>,\n    ) -> Result<RetrievalExecution, crate::error::LatticeError> {\n        Ok(self.expand_execution.clone())\n    }\n}\n\nstruct Observer {\n    records: RefCell<Vec<StateMutationRecord>>,\n}\n\nimpl StateMutationObserver for Observer {\n    fn record(&self, mutation: StateMutationRecord) -> Result<(), crate::error::LatticeError> {\n        self.records.borrow_mut().push(mutation);\n        Ok(())\n    }\n}\n\nstruct Harness {\n    conn: Connection,\n    resolver: &'static IdentityResolver<'static>,\n    retriever: FakeRetriever,\n    observer: Observer,\n}\n\nimpl Harness {\n    fn new(retriever: FakeRetriever) -> Self {\n        let conn = Connection::open_in_memory().expect(\"in-memory connection\");\n        initialize_schema(&conn).expect(\"schema\");\n        let graph = Box::leak(Box::new(CodeGraph::default()));\n        let file_index = Box::leak(Box::new(Default::default()));\n        let parsed_files = Box::leak(Box::new(Default::default()));\n        let resolver = Box::leak(Box::new(IdentityResolver::new(\n            graph,\n            file_index,\n            parsed_files,\n            WORKSPACE.to_string(),\n            Vec::new(),\n        )));\n        Self {\n            conn,\n            resolver,\n            retriever,\n            observer: Observer {\n                records: RefCell::new(Vec::new()),\n            },\n        }\n    }\n\n    fn ctx(&self) -> OpContext<'_> {\n        OpContext {\n            conn: &self.conn,\n            retrieval_profile: RetrievalProfile::Balanced,\n            identity_resolver: self.resolver,\n            shaper: ShaperContext {\n                pins: HashSet::new(),\n                budget: ShaperBudget { max_tokens: 320 },\n            },\n            retriever: &self.retriever,\n            mutation_observer: Some(&self.observer),\n        }\n    }\n}\n\nfn sample_state() -> WorkingMemoryState {\n    WorkingMemoryState {\n        task_statement: \"Investigate working memory operations\".to_string(),\n        interpreted_intent: crate::retrieval_v1::classify_intent(\n            \"Investigate working memory operations\",\n        ),\n        active_files: Default::default(),\n        active_symbols: Default::default(),\n        active_hypotheses: Vec::new(),\n        active_failures: Vec::new(),\n        current_plan: None,\n        selected_memories: Vec::new(),\n        excluded_memories: Vec::new(),\n        budget_decisions: BudgetDecisions {\n            token_cap: 0,\n            dropped_count: 0,\n            truncated_results: 0,\n            pinned_identities: Default::default(),\n        },\n        unresolved_questions: Vec::new(),\n        verification_status: super::state::WorkingMemoryVerification {\n            last_verified_at: None,\n            status: MemoryVerificationStatus::Unverified,\n            notes: Vec::new(),\n        },\n    }\n}\n\nfn sample_bundle(results: Vec<BundleResult>, token_budget: usize) -> RetrievalBundle {\n    RetrievalBundle {\n        task_id: \"task\".to_string(),\n        intent_summary: \"Debug\".to_string(),\n        anchors_summary: \"memory\".to_string(),\n        results,\n        diagnostics: None,\n        budget_report: BudgetReport {\n            token_budget,\n            estimated_tokens: token_budget / 2,\n            trimmed_snippets: 0,\n            dropped_results: 0,\n            truncated: false,\n        },\n    }\n}\n\nfn sample_bundle_result(ulid: &str, score: f32) -> BundleResult {\n    BundleResult {\n        identity: sample_identity(ulid),\n        kind: IdentityKind::Memory,\n        headline: format!(\"Memory {ulid}\"),\n        snippet: format!(\"Snippet for {ulid}\"),\n        inclusion_reason: \"selected memory\".to_string(),\n        expansion_handle: crate::identity::encode_identity(&sample_identity(ulid)),\n        source: Vec::new(),\n        score,\n    }\n}\n\nfn long_bundle_result(identity: Identity, headline: &str, score: f32) -> BundleResult {\n    BundleResult {\n        identity: identity.clone(),\n        kind: identity.kind(),\n        headline: headline.to_string(),\n        snippet: \"This snippet is intentionally long so compression has to trim and evict results from working memory.\"\n            .repeat(4),\n        inclusion_reason: \"selected memory\".to_string(),\n        expansion_handle: crate::identity::encode_identity(&identity),\n        source: Vec::new(),\n        score,\n    }\n}\n\nfn sample_identity(ulid: &str) -> Identity {\n    Identity::Memory(MemoryId {\n        workspace_id: WORKSPACE.to_string(),\n        ulid: ulid.to_string(),\n    })\n}\n\nfn file_identity(path: &str) -> Identity {\n    Identity::File(FileId {\n        workspace_id: WORKSPACE.to_string(),\n        repo_relative_path: path.to_string(),\n        content_hash: \"hash\".to_string(),\n    })\n}\n","numLines":466,"startLine":1,"totalLines":466}}}
