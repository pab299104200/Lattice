{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C8bz1HCrx4YbtgYNJWqPxq","type":"tool_result","content":"1\tuse std::collections::HashSet;\n2\tuse std::path::PathBuf;\n3\tuse std::sync::atomic::AtomicBool;\n4\tuse std::sync::Arc;\n5\tuse std::time::{SystemTime, UNIX_EPOCH};\n6\t\n7\tuse lattice_core::events::{\n8\t    Actor, BranchRef, EventPayload, EventQuery, EventReader, EventStore, EventWriter, FlushPolicy,\n9\t    QueryOrder, SessionId, TaskId,\n10\t};\n11\tuse lattice_core::graph::CodeGraph;\n12\tuse lattice_core::identity::{Identity, IdentityResolver, MemoryId};\n13\tuse lattice_core::indexer::Indexer;\n14\tuse lattice_core::memory::{MemoryStore, MemoryVerificationStatus};\n15\tuse lattice_core::query::QueryEngine;\n16\tuse lattice_core::retrieval_v1::{\n17\t    schema::{BudgetReport, BundleResult, RetrievalBundle},\n18\t    DiagnosticMode, RetrievalBudget, RetrievalProfile, ShaperBudget, ShaperContext,\n19\t};\n20\tuse lattice_core::storage::GraphStore;\n21\tuse lattice_core::working_memory::operations::RetrievalExecution;\n22\tuse lattice_core::working_memory::{\n23\t    emit_memory_expanded, emit_memory_retrieved, expand, retrieve, CheckpointScope, ExcludedMemory,\n24\t    ExpandArgs, MutationEventSummary, OpContext, RetrieveArgs, StateMutationObserver,\n25\t    StateMutationRecord, WorkingMemoryEventContext, WorkingMemoryOp, WorkingMemoryRetriever,\n26\t    WorkingMemoryState,\n27\t};\n28\tuse serde_json::{json, Value};\n29\tuse tokio::sync::Mutex;\n30\t\n31\tuse super::mcp::McpHandler;\n32\tuse super::server::RequestHandler;\n33\t\n34\tconst WORKSPACE_ID: &str = \"workspace-test\";\n35\tconst TASK_ID: &str = \"task-working-memory\";\n36\t\n37\t#[test]\n38\tfn tools_list_registers_inspect_working_memory_schema() {\n39\t    let runtime = tokio::runtime::Runtime::new().expect(\"runtime\");\n40\t    runtime.block_on(async {\n41\t        let (handler, _memory_store, workspace_root, context_cache_path) =\n42\t            build_handler(\"tools-list\");\n43\t        let response = handler\n44\t            .handle(\"tools/list\", json!({}))\n45\t            .await\n46\t            .expect(\"tools/list succeeds\");\n47\t        let tools = response[\"tools\"].as_array().expect(\"tool array\");\n48\t        let tool = tools\n49\t            .iter()\n50\t            .find(|item| item[\"name\"].as_str() == Some(\"inspect_working_memory\"))\n51\t            .expect(\"inspect_working_memory registered\");\n52\t        assert_eq!(\n53\t            tool[\"inputSchema\"][\"required\"].as_array(),\n54\t            Some(&vec![json!(\"task_id\")])\n55\t        );\n56\t        assert_eq!(\n57\t            tool[\"inputSchema\"][\"properties\"][\"mode\"][\"enum\"].as_array(),\n58\t            Some(&vec![json!(\"compact\"), json!(\"diagnostic\")])\n59\t        );\n60\t        assert_eq!(\n61\t            tool[\"inputSchema\"][\"properties\"][\"include_excluded\"][\"type\"].as_str(),\n62\t            Some(\"boolean\")\n63\t        );\n64\t        cleanup_paths(&workspace_root, &context_cache_path);\n65\t    });\n66\t}\n67\t\n68\t#[tokio::test]\n69\tasync fn compact_mode_returns_summary_and_snapshot_handle() {\n70\t    let (handler, _memory_store, workspace_root, context_cache_path) = build_handler(\"compact\");\n71\t    let state = sample_state();\n72\t    handler\n73\t        .remember_working_memory_state_for_test(TASK_ID, state.clone())\n74\t        .await;\n75\t\n76\t    let response = handler\n77\t        .handle(\n78\t            \"tools/call\",\n79\t            json!({\n80\t                \"name\": \"inspect_working_memory\",\n81\t                \"arguments\": {\n82\t                    \"task_id\": TASK_ID\n83\t                }\n84\t            }),\n85\t        )\n86\t        .await\n87\t        .expect(\"inspect_working_memory compact succeeds\");\n88\t    let payload = parse_tool_payload(&response);\n89\t    assert_eq!(payload[\"task_id\"].as_str(), Some(TASK_ID));\n90\t    assert_eq!(payload[\"mode\"].as_str(), Some(\"compact\"));\n91\t    assert_eq!(\n92\t        payload[\"summary\"][\"selected_count\"].as_u64(),\n93\t        Some(state.selected_memories.len() as u64)\n94\t    );\n95\t    assert_eq!(\n96\t        payload[\"summary\"][\"excluded_count\"].as_u64(),\n97\t        Some(state.excluded_memories.len() as u64)\n98\t    );\n99\t    let expansion_handle = payload[\"expansion_handle\"]\n100\t        .as_str()\n101\t        .expect(\"expansion handle\");\n102\t    let round_tripped = handler\n103\t        .resolve_working_memory_snapshot_for_test(expansion_handle)\n104\t        .await\n105\t        .expect(\"snapshot resolves\");\n106\t    assert_eq!(round_tripped, state);\n107\t\n108\t    cleanup_paths(&workspace_root, &context_cache_path);\n109\t}\n110\t\n111\t#[tokio::test]\n112\tasync fn diagnostic_mode_returns_full_state_and_include_excluded_controls_visibility() {\n113\t    let (handler, _memory_store, workspace_root, context_cache_path) = build_handler(\"diagnostic\");\n114\t    let state = sample_state();\n115\t    handler\n116\t        .remember_working_memory_state_for_test(TASK_ID, state.clone())\n117\t        .await;\n118\t\n119\t    let without_excluded = handler\n120\t        .handle(\n121\t            \"tools/call\",\n122\t            json!({\n123\t                \"name\": \"inspect_working_memory\",\n124\t                \"arguments\": {\n125\t                    \"task_id\": TASK_ID,\n126\t                    \"mode\": \"diagnostic\"\n127\t                }\n128\t            }),\n129\t        )\n130\t        .await\n131\t        .expect(\"diagnostic succeeds\");\n132\t    let without_payload = parse_tool_payload(&without_excluded);\n133\t    assert_eq!(without_payload[\"mode\"].as_str(), Some(\"diagnostic\"));\n134\t    assert_eq!(\n135\t        without_payload[\"state\"][\"selected_memories\"]\n136\t            .as_array()\n137\t            .map(Vec::len),\n138\t        Some(state.selected_memories.len())\n139\t    );\n140\t    assert_eq!(\n141\t        without_payload[\"state\"][\"excluded_memories\"]\n142\t            .as_array()\n143\t            .map(Vec::len),\n144\t        Some(0)\n145\t    );\n146\t\n147\t    let with_excluded = handler\n148\t        .handle(\n149\t            \"tools/call\",\n150\t            json!({\n151\t                \"name\": \"inspect_working_memory\",\n152\t                \"arguments\": {\n153\t                    \"task_id\": TASK_ID,\n154\t                    \"mode\": \"diagnostic\",\n155\t                    \"include_excluded\": true\n156\t                }\n157\t            }),\n158\t        )\n159\t        .await\n160\t        .expect(\"diagnostic include_excluded succeeds\");\n161\t    let with_payload = parse_tool_payload(&with_excluded);\n162\t    let excluded = with_payload[\"state\"][\"excluded_memories\"]\n163\t        .as_array()\n164\t        .expect(\"excluded memories\");\n165\t    assert_eq!(excluded.len(), state.excluded_memories.len());\n166\t    assert_eq!(\n167\t        excluded[0][\"exclusion_reason\"].as_str(),\n168\t        Some(\"compressed: budget=120 tokens\")\n169\t    );\n170\t\n171\t    cleanup_paths(&workspace_root, &context_cache_path);\n172\t}\n173\t\n174\t#[tokio::test]\n175\tasync fn tool_falls_back_to_latest_checkpoint_when_session_cache_is_empty() {\n176\t    let (handler, memory_store, workspace_root, context_cache_path) = build_handler(\"checkpoint\");\n177\t    let state = sample_state();\n178\t    let checkpoint_id = memory_store\n179\t        .lock()\n180\t        .await\n181\t        .save_working_memory_checkpoint_for_scope(\n182\t            &state,\n183\t            \"latest\",\n184\t            &CheckpointScope::new(\n185\t                workspace_root.to_string_lossy().to_string(),\n186\t                \"session-test-checkpoint\".to_string(),\n187\t                TASK_ID.to_string(),\n188\t            ),\n189\t        )\n190\t        .expect(\"checkpoint saved\");\n191\t\n192\t    let response = handler\n193\t        .handle(\n194\t            \"tools/call\",\n195\t            json!({\n196\t                \"name\": \"inspect_working_memory\",\n197\t                \"arguments\": {\n198\t                    \"task_id\": TASK_ID,\n199\t                    \"mode\": \"diagnostic\",\n200\t                    \"include_excluded\": true\n201\t                }\n202\t            }),\n203\t        )\n204\t        .await\n205\t        .expect(\"inspect_working_memory checkpoint fallback succeeds\");\n206\t    let payload = parse_tool_payload(&response);\n207\t    assert_eq!(payload[\"checkpoint_id\"].as_i64(), Some(checkpoint_id));\n208\t    assert_eq!(\n209\t        payload[\"state\"][\"task_statement\"].as_str(),\n210\t        Some(state.task_statement.as_str())\n211\t    );\n212\t\n213\t    cleanup_paths(&workspace_root, &context_cache_path);\n214\t}\n215\t\n216\t#[test]\n217\tfn retrieve_and_expand_emit_event_diffs_through_single_mutation_observer() {\n218\t    let store = Arc::new(EventStore::open_in_memory().expect(\"event store\"));\n219\t    let writer = Arc::new(\n220\t        EventWriter::new(store.clone(), WORKSPACE_ID.to_string(), 4096)\n221\t            .with_flush_policy(FlushPolicy::Sync),\n222\t    );\n223\t    let observer = EventHookObserver::new(writer.clone());\n224\t    let harness = WorkingMemoryHarness::new(FakeRetriever::with_event_results(), &observer);\n225\t    let mut state = sample_state();\n226\t\n227\t    let retrieve_outcome = retrieve(\n228\t        &mut state,\n229\t        RetrieveArgs {\n230\t            task_id: TASK_ID.to_string(),\n231\t            query_text: Some(\"retrieve active context\".to_string()),\n232\t            budget: RetrievalBudget::default(),\n233\t            diagnostic_mode: DiagnosticMode::Compact,\n234\t            query_embedding: None,\n235\t        },\n236\t        &harness.ctx(),\n237\t    )\n238\t    .expect(\"retrieve succeeds\");\n239\t    assert_eq!(retrieve_outcome.added_identities.len(), 1);\n240\t\n241\t    let expansion_handle = state.selected_memories[0].expansion_handle.clone();\n242\t    let expand_outcome = expand(\n243\t        &mut state,\n244\t        ExpandArgs {\n245\t            task_id: TASK_ID.to_string(),\n246\t            expansion_handle,\n247\t            budget: RetrievalBudget::default(),\n248\t            diagnostic_mode: DiagnosticMode::Compact,\n249\t            query_embedding: None,\n250\t        },\n251\t        &harness.ctx(),\n252\t    )\n253\t    .expect(\"expand succeeds\");\n254\t    assert_eq!(expand_outcome.added_count, 1);\n255\t\n256\t    let reader = EventReader::new(store.clone());\n257\t    let events = reader\n258\t        .execute(\n259\t            EventQuery::new()\n260\t                .task(TASK_ID)\n261\t                .order(QueryOrder::OldestFirst)\n262\t                .limit(10),\n263\t        )\n264\t        .expect(\"event query succeeds\");\n265\t    assert_eq!(events.len(), 2);\n266\t    assert_eq!(events[0].kind.as_str(), \"memory_retrieved\");\n267\t    assert_eq!(events[1].kind.as_str(), \"memory_expanded\");\n268\t\n269\t    let EventPayload::MemoryRetrieved(retrieved) = &events[0].payload else {\n270\t        panic!(\"expected memory_retrieved payload\");\n271\t    };\n272\t    assert_eq!(retrieved.included_context.len(), 1);\n273\t    assert_eq!(retrieved.excluded_context.len(), 1);\n274\t    assert_eq!(\n275\t        retrieved.excluded_context[0].exclusion_reason,\n276\t        \"compressed: budget=64 tokens\"\n277\t    );\n278\t\n279\t    let EventPayload::MemoryExpanded(expanded) = &events[1].payload else {\n280\t        panic!(\"expected memory_expanded payload\");\n281\t    };\n282\t    assert_eq!(expanded.included_context.len(), 1);\n283\t    assert_eq!(expanded.excluded_context.len(), 1);\n284\t    assert_eq!(\n285\t        expanded.excluded_context[0].exclusion_reason,\n286\t        \"filtered: low confidence\"\n287\t    );\n288\t    assert!(\n289\t        expanded.memory_id.is_some(),\n290\t        \"expand should carry memory id\"\n291\t    );\n292\t}\n293\t\n294\tfn build_handler(suffix: &str) -> (McpHandler, Arc<Mutex<MemoryStore>>, PathBuf, PathBuf) {\n295\t    let workspace_root = unique_test_path(&format!(\"lattice-working-memory-{suffix}\"));\n296\t    std::fs::create_dir_all(&workspace_root).expect(\"workspace dir\");\n297\t    let context_cache_path = workspace_root.join(\"context_handles.json\");\n298\t    let memory_store = Arc::new(Mutex::new(\n299\t        MemoryStore::open_in_memory().expect(\"memory store\"),\n300\t    ));\n301\t    let handler = McpHandler::new(\n302\t        Arc::new(Mutex::new(QueryEngine::new(CodeGraph::new(), None, None))),\n303\t        Arc::new(Mutex::new(Indexer::new(workspace_root.clone()))),\n304\t        memory_store.clone(),\n305\t        Arc::new(Mutex::new(\n306\t            GraphStore::open_in_memory().expect(\"graph store\"),\n307\t        )),\n308\t        Arc::new(std::sync::OnceLock::new()),\n309\t        None,\n310\t        workspace_root.clone(),\n311\t        context_cache_path.clone(),\n312\t        format!(\"session-test-{suffix}\"),\n313\t        None,\n314\t        vec![workspace_root.clone()],\n315\t        Arc::new(AtomicBool::new(false)),\n316\t        None,\n317\t    );\n318\t    (handler, memory_store, workspace_root, context_cache_path)\n319\t}\n320\t\n321\tfn cleanup_paths(workspace_root: &PathBuf, context_cache_path: &PathBuf) {\n322\t    let _ = std::fs::remove_file(context_cache_path);\n323\t    let _ = std::fs::remove_dir_all(workspace_root);\n324\t}\n325\t\n326\tfn unique_test_path(prefix: &str) -> PathBuf {\n327\t    let nanos = SystemTime::now()\n328\t        .duration_since(UNIX_EPOCH)\n329\t        .unwrap_or_default()\n330\t        .as_nanos();\n331\t    std::env::temp_dir().join(format!(\"{prefix}-{nanos}\"))\n332\t}\n333\t\n334\tfn parse_tool_payload(response: &Value) -> Value {\n335\t    let text = response[\"content\"][0][\"text\"].as_str().expect(\"tool text\");\n336\t    serde_json::from_str(text).expect(\"tool payload json\")\n337\t}\n338\t\n339\tfn sample_state() -> WorkingMemoryState {\n340\t    let selected = sample_bundle_result(\"memory-selected\", 0.91, \"selected memory\");\n341\t    WorkingMemoryState {\n342\t        task_statement: \"Inspect working memory state\".to_string(),\n343\t        interpreted_intent: lattice_core::retrieval_v1::classify_intent(\n344\t            \"Inspect working memory state\",\n345\t        ),\n346\t        active_files: Default::default(),\n347\t        active_symbols: Default::default(),\n348\t        active_hypotheses: vec![lattice_core::working_memory::Hypothesis {\n349\t            text: \"The active context should be inspectable\".to_string(),\n350\t            evidence_refs: vec![\"memory-selected\".to_string()],\n351\t            confidence: 0.8,\n352\t        }],\n353\t        active_failures: Vec::new(),\n354\t        current_plan: None,\n355\t        selected_memories: vec![selected],\n356\t        excluded_memories: vec![ExcludedMemory {\n357\t            result: sample_bundle_result(\"memory-excluded\", 0.44, \"compressed memory\"),\n358\t            exclusion_reason: \"compressed: budget=120 tokens\".to_string(),\n359\t        }],\n360\t        budget_decisions: Default::default(),\n361\t        unresolved_questions: vec![\"Should excluded memories be visible?\".to_string()],\n362\t        verification_status: lattice_core::working_memory::WorkingMemoryVerification {\n363\t            last_verified_at: None,\n364\t            status: MemoryVerificationStatus::Unverified,\n365\t            notes: Vec::new(),\n366\t        },\n367\t    }\n368\t}\n369\t\n370\tfn sample_bundle_result(ulid: &str, score: f32, reason: &str) -> BundleResult {\n371\t    BundleResult {\n372\t        identity: Identity::Memory(MemoryId {\n373\t            workspace_id: WORKSPACE_ID.to_string(),\n374\t            ulid: ulid.to_string(),\n375\t        }),\n376\t        kind: lattice_core::identity::IdentityKind::Memory,\n377\t        headline: format!(\"Memory {ulid}\"),\n378\t        snippet: format!(\"Snippet for {ulid}\"),\n379\t        inclusion_reason: reason.to_string(),\n380\t        expansion_handle: lattice_core::identity::encode_identity(&Identity::Memory(MemoryId {\n381\t            workspace_id: WORKSPACE_ID.to_string(),\n382\t            ulid: ulid.to_string(),\n383\t        })),\n384\t        source: Vec::new(),\n385\t        score,\n386\t    }\n387\t}\n388\t\n389\t#[derive(Clone)]\n390\tstruct FakeRetriever {\n391\t    retrieve_execution: RetrievalExecution,\n392\t    expand_execution: RetrievalExecution,\n393\t}\n394\t\n395\timpl FakeRetriever {\n396\t    fn with_event_results() -> Self {\n397\t        Self {\n398\t            retrieve_execution: RetrievalExecution {\n399\t                bundle: sample_bundle(vec![sample_bundle_result(\n400\t                    \"memory-retrieved\",\n401\t                    0.88,\n402\t                    \"retrieved from query\",\n403\t                )]),\n404\t                excluded_memories: vec![ExcludedMemory {\n405\t                    result: sample_bundle_result(\"memory-dropped\", 0.31, \"dropped\"),\n406\t                    exclusion_reason: \"compressed: budget=64 tokens\".to_string(),\n407\t                }],\n408\t            },\n409\t            expand_execution: RetrievalExecution {\n410\t                bundle: sample_bundle(vec![sample_bundle_result(\n411\t                    \"memory-expanded\",\n412\t                    0.77,\n413\t                    \"expanded around anchor\",\n414\t                )]),\n415\t                excluded_memories: vec![ExcludedMemory {\n416\t                    result: sample_bundle_result(\"memory-filtered\", 0.22, \"filtered\"),\n417\t                    exclusion_reason: \"filtered: low confidence\".to_string(),\n418\t                }],\n419\t            },\n420\t        }\n421\t    }\n422\t}\n423\t\n424\timpl WorkingMemoryRetriever for FakeRetriever {\n425\t    fn retrieve(\n426\t        &self,\n427\t        _state: &WorkingMemoryState,\n428\t        _args: &RetrieveArgs,\n429\t        _ctx: &OpContext<'_>,\n430\t    ) -> Result<RetrievalExecution, lattice_core::error::LatticeError> {\n431\t        Ok(self.retrieve_execution.clone())\n432\t    }\n433\t\n434\t    fn expand(\n435\t        &self,\n436\t        _state: &WorkingMemoryState,\n437\t        _target: &BundleResult,\n438\t        _args: &ExpandArgs,\n439\t        _ctx: &OpContext<'_>,\n440\t    ) -> Result<RetrievalExecution, lattice_core::error::LatticeError> {\n441\t        Ok(self.expand_execution.clone())\n442\t    }\n443\t}\n444\t\n445\tstruct EventHookObserver {\n446\t    writer: Arc<EventWriter>,\n447\t    context: WorkingMemoryEventContext,\n448\t}\n449\t\n450\timpl EventHookObserver {\n451\t    fn new(writer: Arc<EventWriter>) -> Self {\n452\t        Self {\n453\t            writer,\n454\t            context: WorkingMemoryEventContext {\n455\t                workspace_id: WORKSPACE_ID.to_string(),\n456\t                branch: BranchRef {\n457\t                    name: \"test\".to_string(),\n458\t                },\n459\t                session_id: SessionId {\n460\t                    value: \"session-events\".to_string(),\n461\t                },\n462\t                task_id: TaskId {\n463\t                    value: TASK_ID.to_string(),\n464\t                },\n465\t                actor: Actor::Daemon,\n466\t            },\n467\t        }\n468\t    }\n469\t}\n470\t\n471\timpl StateMutationObserver for EventHookObserver {\n472\t    fn record(\n473\t        &self,\n474\t        mutation: StateMutationRecord,\n475\t    ) -> Result<(), lattice_core::error::LatticeError> {\n476\t        let summary = MutationEventSummary {\n477\t            op_name: mutation.op_name.clone(),\n478\t            summary: mutation.summary.clone(),\n479\t        };\n480\t        let result = match mutation.op {\n481\t            WorkingMemoryOp::Expand => emit_memory_expanded(\n482\t                &mutation.state_before,\n483\t                &mutation.state_after,\n484\t                &summary,\n485\t                &self.context,\n486\t                self.writer.as_ref(),\n487\t            ),\n488\t            WorkingMemoryOp::Summarize => Ok(None),\n489\t            _ => emit_memory_retrieved(\n490\t                &mutation.state_before,\n491\t                &mutation.state_after,\n492\t                &summary,\n493\t                &self.context,\n494\t                self.writer.as_ref(),\n495\t            ),\n496\t        };\n497\t        result\n498\t            .map(|_| ())\n499\t            .map_err(|error| lattice_core::error::LatticeError::Storage(error.to_string()))\n500\t    }\n501\t}\n502\t\n503\tstruct WorkingMemoryHarness<'a> {\n504\t    conn: rusqlite::Connection,\n505\t    resolver: &'static IdentityResolver<'static>,\n506\t    retriever: FakeRetriever,\n507\t    observer: &'a EventHookObserver,\n508\t}\n509\t\n510\timpl<'a> WorkingMemoryHarness<'a> {\n511\t    fn new(retriever: FakeRetriever, observer: &'a EventHookObserver) -> Self {\n512\t        let conn = rusqlite::Connection::open_in_memory().expect(\"memory db\");\n513\t        lattice_core::working_memory::initialize_schema(&conn).expect(\"working memory schema\");\n514\t        let graph = Box::leak(Box::new(CodeGraph::default()));\n515\t        let file_index = Box::leak(Box::new(Default::default()));\n516\t        let parsed_files = Box::leak(Box::new(Default::default()));\n517\t        let resolver = Box::leak(Box::new(IdentityResolver::new(\n518\t            graph,\n519\t            file_index,\n520\t            parsed_files,\n521\t            WORKSPACE_ID.to_string(),\n522\t            Vec::new(),\n523\t        )));\n524\t        Self {\n525\t            conn,\n526\t            resolver,\n527\t            retriever,\n528\t            observer,\n529\t        }\n530\t    }\n531\t\n532\t    fn ctx(&self) -> OpContext<'_> {\n533\t        OpContext {\n534\t            conn: &self.conn,\n535\t            retrieval_profile: RetrievalProfile::Balanced,\n536\t            identity_resolver: self.resolver,\n537\t            shaper: ShaperContext {\n538\t                pins: HashSet::new(),\n539\t                budget: ShaperBudget { max_tokens: 128 },\n540\t            },\n541\t            retriever: &self.retriever,\n542\t            mutation_observer: Some(self.observer),\n543\t        }\n544\t    }\n545\t}\n546\t\n547\tfn sample_bundle(results: Vec<BundleResult>) -> RetrievalBundle {\n548\t    RetrievalBundle {\n549\t        task_id: TASK_ID.to_string(),\n550\t        intent_summary: \"Inspect\".to_string(),\n551\t        anchors_summary: \"working memory\".to_string(),\n552\t        results,\n553\t        diagnostics: None,\n554\t        budget_report: BudgetReport {\n555\t            token_budget: 128,\n556\t            estimated_tokens: 64,\n557\t            trimmed_snippets: 0,\n558\t            dropped_results: 0,\n559\t            truncated: false,\n560\t        },\n561\t    }\n562\t}\n563\t"}]},"parent_tool_use_id":null,"session_id":"1b2121c5-8450-4d0d-9f66-0986877cae23","uuid":"4eb8b08c-6791-46a2-a723-cc0f38f8064b","timestamp":"2026-05-17T10:14:19.324Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/working_memory_tool_tests.rs","content":"use std::collections::HashSet;\nuse std::path::PathBuf;\nuse std::sync::atomic::AtomicBool;\nuse std::sync::Arc;\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse lattice_core::events::{\n    Actor, BranchRef, EventPayload, EventQuery, EventReader, EventStore, EventWriter, FlushPolicy,\n    QueryOrder, SessionId, TaskId,\n};\nuse lattice_core::graph::CodeGraph;\nuse lattice_core::identity::{Identity, IdentityResolver, MemoryId};\nuse lattice_core::indexer::Indexer;\nuse lattice_core::memory::{MemoryStore, MemoryVerificationStatus};\nuse lattice_core::query::QueryEngine;\nuse lattice_core::retrieval_v1::{\n    schema::{BudgetReport, BundleResult, RetrievalBundle},\n    DiagnosticMode, RetrievalBudget, RetrievalProfile, ShaperBudget, ShaperContext,\n};\nuse lattice_core::storage::GraphStore;\nuse lattice_core::working_memory::operations::RetrievalExecution;\nuse lattice_core::working_memory::{\n    emit_memory_expanded, emit_memory_retrieved, expand, retrieve, CheckpointScope, ExcludedMemory,\n    ExpandArgs, MutationEventSummary, OpContext, RetrieveArgs, StateMutationObserver,\n    StateMutationRecord, WorkingMemoryEventContext, WorkingMemoryOp, WorkingMemoryRetriever,\n    WorkingMemoryState,\n};\nuse serde_json::{json, Value};\nuse tokio::sync::Mutex;\n\nuse super::mcp::McpHandler;\nuse super::server::RequestHandler;\n\nconst WORKSPACE_ID: &str = \"workspace-test\";\nconst TASK_ID: &str = \"task-working-memory\";\n\n#[test]\nfn tools_list_registers_inspect_working_memory_schema() {\n    let runtime = tokio::runtime::Runtime::new().expect(\"runtime\");\n    runtime.block_on(async {\n        let (handler, _memory_store, workspace_root, context_cache_path) =\n            build_handler(\"tools-list\");\n        let response = handler\n            .handle(\"tools/list\", json!({}))\n            .await\n            .expect(\"tools/list succeeds\");\n        let tools = response[\"tools\"].as_array().expect(\"tool array\");\n        let tool = tools\n            .iter()\n            .find(|item| item[\"name\"].as_str() == Some(\"inspect_working_memory\"))\n            .expect(\"inspect_working_memory registered\");\n        assert_eq!(\n            tool[\"inputSchema\"][\"required\"].as_array(),\n            Some(&vec![json!(\"task_id\")])\n        );\n        assert_eq!(\n            tool[\"inputSchema\"][\"properties\"][\"mode\"][\"enum\"].as_array(),\n            Some(&vec![json!(\"compact\"), json!(\"diagnostic\")])\n        );\n        assert_eq!(\n            tool[\"inputSchema\"][\"properties\"][\"include_excluded\"][\"type\"].as_str(),\n            Some(\"boolean\")\n        );\n        cleanup_paths(&workspace_root, &context_cache_path);\n    });\n}\n\n#[tokio::test]\nasync fn compact_mode_returns_summary_and_snapshot_handle() {\n    let (handler, _memory_store, workspace_root, context_cache_path) = build_handler(\"compact\");\n    let state = sample_state();\n    handler\n        .remember_working_memory_state_for_test(TASK_ID, state.clone())\n        .await;\n\n    let response = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"inspect_working_memory\",\n                \"arguments\": {\n                    \"task_id\": TASK_ID\n                }\n            }),\n        )\n        .await\n        .expect(\"inspect_working_memory compact succeeds\");\n    let payload = parse_tool_payload(&response);\n    assert_eq!(payload[\"task_id\"].as_str(), Some(TASK_ID));\n    assert_eq!(payload[\"mode\"].as_str(), Some(\"compact\"));\n    assert_eq!(\n        payload[\"summary\"][\"selected_count\"].as_u64(),\n        Some(state.selected_memories.len() as u64)\n    );\n    assert_eq!(\n        payload[\"summary\"][\"excluded_count\"].as_u64(),\n        Some(state.excluded_memories.len() as u64)\n    );\n    let expansion_handle = payload[\"expansion_handle\"]\n        .as_str()\n        .expect(\"expansion handle\");\n    let round_tripped = handler\n        .resolve_working_memory_snapshot_for_test(expansion_handle)\n        .await\n        .expect(\"snapshot resolves\");\n    assert_eq!(round_tripped, state);\n\n    cleanup_paths(&workspace_root, &context_cache_path);\n}\n\n#[tokio::test]\nasync fn diagnostic_mode_returns_full_state_and_include_excluded_controls_visibility() {\n    let (handler, _memory_store, workspace_root, context_cache_path) = build_handler(\"diagnostic\");\n    let state = sample_state();\n    handler\n        .remember_working_memory_state_for_test(TASK_ID, state.clone())\n        .await;\n\n    let without_excluded = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"inspect_working_memory\",\n                \"arguments\": {\n                    \"task_id\": TASK_ID,\n                    \"mode\": \"diagnostic\"\n                }\n            }),\n        )\n        .await\n        .expect(\"diagnostic succeeds\");\n    let without_payload = parse_tool_payload(&without_excluded);\n    assert_eq!(without_payload[\"mode\"].as_str(), Some(\"diagnostic\"));\n    assert_eq!(\n        without_payload[\"state\"][\"selected_memories\"]\n            .as_array()\n            .map(Vec::len),\n        Some(state.selected_memories.len())\n    );\n    assert_eq!(\n        without_payload[\"state\"][\"excluded_memories\"]\n            .as_array()\n            .map(Vec::len),\n        Some(0)\n    );\n\n    let with_excluded = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"inspect_working_memory\",\n                \"arguments\": {\n                    \"task_id\": TASK_ID,\n                    \"mode\": \"diagnostic\",\n                    \"include_excluded\": true\n                }\n            }),\n        )\n        .await\n        .expect(\"diagnostic include_excluded succeeds\");\n    let with_payload = parse_tool_payload(&with_excluded);\n    let excluded = with_payload[\"state\"][\"excluded_memories\"]\n        .as_array()\n        .expect(\"excluded memories\");\n    assert_eq!(excluded.len(), state.excluded_memories.len());\n    assert_eq!(\n        excluded[0][\"exclusion_reason\"].as_str(),\n        Some(\"compressed: budget=120 tokens\")\n    );\n\n    cleanup_paths(&workspace_root, &context_cache_path);\n}\n\n#[tokio::test]\nasync fn tool_falls_back_to_latest_checkpoint_when_session_cache_is_empty() {\n    let (handler, memory_store, workspace_root, context_cache_path) = build_handler(\"checkpoint\");\n    let state = sample_state();\n    let checkpoint_id = memory_store\n        .lock()\n        .await\n        .save_working_memory_checkpoint_for_scope(\n            &state,\n            \"latest\",\n            &CheckpointScope::new(\n                workspace_root.to_string_lossy().to_string(),\n                \"session-test-checkpoint\".to_string(),\n                TASK_ID.to_string(),\n            ),\n        )\n        .expect(\"checkpoint saved\");\n\n    let response = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"inspect_working_memory\",\n                \"arguments\": {\n                    \"task_id\": TASK_ID,\n                    \"mode\": \"diagnostic\",\n                    \"include_excluded\": true\n                }\n            }),\n        )\n        .await\n        .expect(\"inspect_working_memory checkpoint fallback succeeds\");\n    let payload = parse_tool_payload(&response);\n    assert_eq!(payload[\"checkpoint_id\"].as_i64(), Some(checkpoint_id));\n    assert_eq!(\n        payload[\"state\"][\"task_statement\"].as_str(),\n        Some(state.task_statement.as_str())\n    );\n\n    cleanup_paths(&workspace_root, &context_cache_path);\n}\n\n#[test]\nfn retrieve_and_expand_emit_event_diffs_through_single_mutation_observer() {\n    let store = Arc::new(EventStore::open_in_memory().expect(\"event store\"));\n    let writer = Arc::new(\n        EventWriter::new(store.clone(), WORKSPACE_ID.to_string(), 4096)\n            .with_flush_policy(FlushPolicy::Sync),\n    );\n    let observer = EventHookObserver::new(writer.clone());\n    let harness = WorkingMemoryHarness::new(FakeRetriever::with_event_results(), &observer);\n    let mut state = sample_state();\n\n    let retrieve_outcome = retrieve(\n        &mut state,\n        RetrieveArgs {\n            task_id: TASK_ID.to_string(),\n            query_text: Some(\"retrieve active context\".to_string()),\n            budget: RetrievalBudget::default(),\n            diagnostic_mode: DiagnosticMode::Compact,\n            query_embedding: None,\n        },\n        &harness.ctx(),\n    )\n    .expect(\"retrieve succeeds\");\n    assert_eq!(retrieve_outcome.added_identities.len(), 1);\n\n    let expansion_handle = state.selected_memories[0].expansion_handle.clone();\n    let expand_outcome = expand(\n        &mut state,\n        ExpandArgs {\n            task_id: TASK_ID.to_string(),\n            expansion_handle,\n            budget: RetrievalBudget::default(),\n            diagnostic_mode: DiagnosticMode::Compact,\n            query_embedding: None,\n        },\n        &harness.ctx(),\n    )\n    .expect(\"expand succeeds\");\n    assert_eq!(expand_outcome.added_count, 1);\n\n    let reader = EventReader::new(store.clone());\n    let events = reader\n        .execute(\n            EventQuery::new()\n                .task(TASK_ID)\n                .order(QueryOrder::OldestFirst)\n                .limit(10),\n        )\n        .expect(\"event query succeeds\");\n    assert_eq!(events.len(), 2);\n    assert_eq!(events[0].kind.as_str(), \"memory_retrieved\");\n    assert_eq!(events[1].kind.as_str(), \"memory_expanded\");\n\n    let EventPayload::MemoryRetrieved(retrieved) = &events[0].payload else {\n        panic!(\"expected memory_retrieved payload\");\n    };\n    assert_eq!(retrieved.included_context.len(), 1);\n    assert_eq!(retrieved.excluded_context.len(), 1);\n    assert_eq!(\n        retrieved.excluded_context[0].exclusion_reason,\n        \"compressed: budget=64 tokens\"\n    );\n\n    let EventPayload::MemoryExpanded(expanded) = &events[1].payload else {\n        panic!(\"expected memory_expanded payload\");\n    };\n    assert_eq!(expanded.included_context.len(), 1);\n    assert_eq!(expanded.excluded_context.len(), 1);\n    assert_eq!(\n        expanded.excluded_context[0].exclusion_reason,\n        \"filtered: low confidence\"\n    );\n    assert!(\n        expanded.memory_id.is_some(),\n        \"expand should carry memory id\"\n    );\n}\n\nfn build_handler(suffix: &str) -> (McpHandler, Arc<Mutex<MemoryStore>>, PathBuf, PathBuf) {\n    let workspace_root = unique_test_path(&format!(\"lattice-working-memory-{suffix}\"));\n    std::fs::create_dir_all(&workspace_root).expect(\"workspace dir\");\n    let context_cache_path = workspace_root.join(\"context_handles.json\");\n    let memory_store = Arc::new(Mutex::new(\n        MemoryStore::open_in_memory().expect(\"memory store\"),\n    ));\n    let handler = McpHandler::new(\n        Arc::new(Mutex::new(QueryEngine::new(CodeGraph::new(), None, None))),\n        Arc::new(Mutex::new(Indexer::new(workspace_root.clone()))),\n        memory_store.clone(),\n        Arc::new(Mutex::new(\n            GraphStore::open_in_memory().expect(\"graph store\"),\n        )),\n        Arc::new(std::sync::OnceLock::new()),\n        None,\n        workspace_root.clone(),\n        context_cache_path.clone(),\n        format!(\"session-test-{suffix}\"),\n        None,\n        vec![workspace_root.clone()],\n        Arc::new(AtomicBool::new(false)),\n        None,\n    );\n    (handler, memory_store, workspace_root, context_cache_path)\n}\n\nfn cleanup_paths(workspace_root: &PathBuf, context_cache_path: &PathBuf) {\n    let _ = std::fs::remove_file(context_cache_path);\n    let _ = std::fs::remove_dir_all(workspace_root);\n}\n\nfn unique_test_path(prefix: &str) -> PathBuf {\n    let nanos = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_nanos();\n    std::env::temp_dir().join(format!(\"{prefix}-{nanos}\"))\n}\n\nfn parse_tool_payload(response: &Value) -> Value {\n    let text = response[\"content\"][0][\"text\"].as_str().expect(\"tool text\");\n    serde_json::from_str(text).expect(\"tool payload json\")\n}\n\nfn sample_state() -> WorkingMemoryState {\n    let selected = sample_bundle_result(\"memory-selected\", 0.91, \"selected memory\");\n    WorkingMemoryState {\n        task_statement: \"Inspect working memory state\".to_string(),\n        interpreted_intent: lattice_core::retrieval_v1::classify_intent(\n            \"Inspect working memory state\",\n        ),\n        active_files: Default::default(),\n        active_symbols: Default::default(),\n        active_hypotheses: vec![lattice_core::working_memory::Hypothesis {\n            text: \"The active context should be inspectable\".to_string(),\n            evidence_refs: vec![\"memory-selected\".to_string()],\n            confidence: 0.8,\n        }],\n        active_failures: Vec::new(),\n        current_plan: None,\n        selected_memories: vec![selected],\n        excluded_memories: vec![ExcludedMemory {\n            result: sample_bundle_result(\"memory-excluded\", 0.44, \"compressed memory\"),\n            exclusion_reason: \"compressed: budget=120 tokens\".to_string(),\n        }],\n        budget_decisions: Default::default(),\n        unresolved_questions: vec![\"Should excluded memories be visible?\".to_string()],\n        verification_status: lattice_core::working_memory::WorkingMemoryVerification {\n            last_verified_at: None,\n            status: MemoryVerificationStatus::Unverified,\n            notes: Vec::new(),\n        },\n    }\n}\n\nfn sample_bundle_result(ulid: &str, score: f32, reason: &str) -> BundleResult {\n    BundleResult {\n        identity: Identity::Memory(MemoryId {\n            workspace_id: WORKSPACE_ID.to_string(),\n            ulid: ulid.to_string(),\n        }),\n        kind: lattice_core::identity::IdentityKind::Memory,\n        headline: format!(\"Memory {ulid}\"),\n        snippet: format!(\"Snippet for {ulid}\"),\n        inclusion_reason: reason.to_string(),\n        expansion_handle: lattice_core::identity::encode_identity(&Identity::Memory(MemoryId {\n            workspace_id: WORKSPACE_ID.to_string(),\n            ulid: ulid.to_string(),\n        })),\n        source: Vec::new(),\n        score,\n    }\n}\n\n#[derive(Clone)]\nstruct FakeRetriever {\n    retrieve_execution: RetrievalExecution,\n    expand_execution: RetrievalExecution,\n}\n\nimpl FakeRetriever {\n    fn with_event_results() -> Self {\n        Self {\n            retrieve_execution: RetrievalExecution {\n                bundle: sample_bundle(vec![sample_bundle_result(\n                    \"memory-retrieved\",\n                    0.88,\n                    \"retrieved from query\",\n                )]),\n                excluded_memories: vec![ExcludedMemory {\n                    result: sample_bundle_result(\"memory-dropped\", 0.31, \"dropped\"),\n                    exclusion_reason: \"compressed: budget=64 tokens\".to_string(),\n                }],\n            },\n            expand_execution: RetrievalExecution {\n                bundle: sample_bundle(vec![sample_bundle_result(\n                    \"memory-expanded\",\n                    0.77,\n                    \"expanded around anchor\",\n                )]),\n                excluded_memories: vec![ExcludedMemory {\n                    result: sample_bundle_result(\"memory-filtered\", 0.22, \"filtered\"),\n                    exclusion_reason: \"filtered: low confidence\".to_string(),\n                }],\n            },\n        }\n    }\n}\n\nimpl WorkingMemoryRetriever for FakeRetriever {\n    fn retrieve(\n        &self,\n        _state: &WorkingMemoryState,\n        _args: &RetrieveArgs,\n        _ctx: &OpContext<'_>,\n    ) -> Result<RetrievalExecution, lattice_core::error::LatticeError> {\n        Ok(self.retrieve_execution.clone())\n    }\n\n    fn expand(\n        &self,\n        _state: &WorkingMemoryState,\n        _target: &BundleResult,\n        _args: &ExpandArgs,\n        _ctx: &OpContext<'_>,\n    ) -> Result<RetrievalExecution, lattice_core::error::LatticeError> {\n        Ok(self.expand_execution.clone())\n    }\n}\n\nstruct EventHookObserver {\n    writer: Arc<EventWriter>,\n    context: WorkingMemoryEventContext,\n}\n\nimpl EventHookObserver {\n    fn new(writer: Arc<EventWriter>) -> Self {\n        Self {\n            writer,\n            context: WorkingMemoryEventContext {\n                workspace_id: WORKSPACE_ID.to_string(),\n                branch: BranchRef {\n                    name: \"test\".to_string(),\n                },\n                session_id: SessionId {\n                    value: \"session-events\".to_string(),\n                },\n                task_id: TaskId {\n                    value: TASK_ID.to_string(),\n                },\n                actor: Actor::Daemon,\n            },\n        }\n    }\n}\n\nimpl StateMutationObserver for EventHookObserver {\n    fn record(\n        &self,\n        mutation: StateMutationRecord,\n    ) -> Result<(), lattice_core::error::LatticeError> {\n        let summary = MutationEventSummary {\n            op_name: mutation.op_name.clone(),\n            summary: mutation.summary.clone(),\n        };\n        let result = match mutation.op {\n            WorkingMemoryOp::Expand => emit_memory_expanded(\n                &mutation.state_before,\n                &mutation.state_after,\n                &summary,\n                &self.context,\n                self.writer.as_ref(),\n            ),\n            WorkingMemoryOp::Summarize => Ok(None),\n            _ => emit_memory_retrieved(\n                &mutation.state_before,\n                &mutation.state_after,\n                &summary,\n                &self.context,\n                self.writer.as_ref(),\n            ),\n        };\n        result\n            .map(|_| ())\n            .map_err(|error| lattice_core::error::LatticeError::Storage(error.to_string()))\n    }\n}\n\nstruct WorkingMemoryHarness<'a> {\n    conn: rusqlite::Connection,\n    resolver: &'static IdentityResolver<'static>,\n    retriever: FakeRetriever,\n    observer: &'a EventHookObserver,\n}\n\nimpl<'a> WorkingMemoryHarness<'a> {\n    fn new(retriever: FakeRetriever, observer: &'a EventHookObserver) -> Self {\n        let conn = rusqlite::Connection::open_in_memory().expect(\"memory db\");\n        lattice_core::working_memory::initialize_schema(&conn).expect(\"working memory schema\");\n        let graph = Box::leak(Box::new(CodeGraph::default()));\n        let file_index = Box::leak(Box::new(Default::default()));\n        let parsed_files = Box::leak(Box::new(Default::default()));\n        let resolver = Box::leak(Box::new(IdentityResolver::new(\n            graph,\n            file_index,\n            parsed_files,\n            WORKSPACE_ID.to_string(),\n            Vec::new(),\n        )));\n        Self {\n            conn,\n            resolver,\n            retriever,\n            observer,\n        }\n    }\n\n    fn ctx(&self) -> OpContext<'_> {\n        OpContext {\n            conn: &self.conn,\n            retrieval_profile: RetrievalProfile::Balanced,\n            identity_resolver: self.resolver,\n            shaper: ShaperContext {\n                pins: HashSet::new(),\n                budget: ShaperBudget { max_tokens: 128 },\n            },\n            retriever: &self.retriever,\n            mutation_observer: Some(self.observer),\n        }\n    }\n}\n\nfn sample_bundle(results: Vec<BundleResult>) -> RetrievalBundle {\n    RetrievalBundle {\n        task_id: TASK_ID.to_string(),\n        intent_summary: \"Inspect\".to_string(),\n        anchors_summary: \"working memory\".to_string(),\n        results,\n        diagnostics: None,\n        budget_report: BudgetReport {\n            token_budget: 128,\n            estimated_tokens: 64,\n            trimmed_snippets: 0,\n            dropped_results: 0,\n            truncated: false,\n        },\n    }\n}\n","numLines":563,"startLine":1,"totalLines":563}}}
