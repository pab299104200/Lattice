{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XCroahpuw3r2P2Smsm8etS","type":"tool_result","content":"1\t//! Working memory state model.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## 5. Working Memory` says working memory contains:\n5\t//!\n6\t//! - task statement\n7\t//! - interpreted intent\n8\t//! - active files and symbols\n9\t//! - active hypotheses\n10\t//! - active failures\n11\t//! - current plan\n12\t//! - selected memories\n13\t//! - excluded memories and reasons\n14\t//! - budget decisions\n15\t//! - unresolved questions\n16\t//! - verification status\n17\t\n18\tuse std::collections::BTreeSet;\n19\tuse std::time::{SystemTime, UNIX_EPOCH};\n20\t\n21\tuse rusqlite::{params, Connection, OptionalExtension};\n22\tuse serde::{Deserialize, Serialize};\n23\tuse sha2::{Digest, Sha256};\n24\t\n25\tuse crate::error::LatticeError;\n26\tuse crate::identity::{FileId, Identity, SymbolId};\n27\tuse crate::memory::MemoryVerificationStatus;\n28\tuse crate::retrieval_v1::{classify_intent, schema::BundleResult, IntentClassification};\n29\t\n30\tpub const WORKING_MEMORY_STATE_VERSION: i64 = 1;\n31\tconst DEFAULT_SESSION_ID: &str = \"unspecified-session\";\n32\t\n33\tpub type CheckpointId = i64;\n34\tpub type FileIdentity = FileId;\n35\tpub type SymbolIdentity = SymbolId;\n36\t\n37\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n38\tpub struct WorkingMemoryState {\n39\t    pub task_statement: String,\n40\t    pub interpreted_intent: IntentClassification,\n41\t    pub active_files: BTreeSet<FileIdentity>,\n42\t    pub active_symbols: BTreeSet<SymbolIdentity>,\n43\t    pub active_hypotheses: Vec<Hypothesis>,\n44\t    pub active_failures: Vec<FailureRecord>,\n45\t    pub current_plan: Option<PlanRef>,\n46\t    pub selected_memories: Vec<BundleResult>,\n47\t    pub excluded_memories: Vec<ExcludedMemory>,\n48\t    pub budget_decisions: BudgetDecisions,\n49\t    pub unresolved_questions: Vec<String>,\n50\t    pub verification_status: WorkingMemoryVerification,\n51\t}\n52\t\n53\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n54\tpub struct Hypothesis {\n55\t    pub text: String,\n56\t    pub evidence_refs: Vec<String>,\n57\t    pub confidence: f32,\n58\t}\n59\t\n60\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n61\tpub struct FailureRecord {\n62\t    pub kind: String,\n63\t    pub message: String,\n64\t    pub observed_at: u64,\n65\t    pub evidence_refs: Vec<String>,\n66\t}\n67\t\n68\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n69\tpub struct PlanRef {\n70\t    pub plan_id: String,\n71\t    pub version: u64,\n72\t}\n73\t\n74\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n75\tpub struct ExcludedMemory {\n76\t    pub result: BundleResult,\n77\t    pub exclusion_reason: String,\n78\t}\n79\t\n80\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n81\tpub struct BudgetDecisions {\n82\t    pub token_cap: usize,\n83\t    pub dropped_count: usize,\n84\t    pub truncated_results: usize,\n85\t    pub pinned_identities: BTreeSet<Identity>,\n86\t}\n87\t\n88\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n89\tpub struct WorkingMemoryVerification {\n90\t    pub last_verified_at: Option<u64>,\n91\t    pub status: MemoryVerificationStatus,\n92\t    pub notes: Vec<String>,\n93\t}\n94\t\n95\t#[derive(Debug, Clone, PartialEq, Eq)]\n96\tpub struct CheckpointScope {\n97\t    pub workspace_id: String,\n98\t    pub session_id: String,\n99\t    pub task_id: String,\n100\t}\n101\t\n102\timpl WorkingMemoryState {\n103\t    pub fn new(task_statement: impl Into<String>) -> Self {\n104\t        let task_statement = task_statement.into();\n105\t        let interpreted_intent = classify_intent(&task_statement);\n106\t        Self {\n107\t            task_statement,\n108\t            interpreted_intent,\n109\t            active_files: BTreeSet::new(),\n110\t            active_symbols: BTreeSet::new(),\n111\t            active_hypotheses: Vec::new(),\n112\t            active_failures: Vec::new(),\n113\t            current_plan: None,\n114\t            selected_memories: Vec::new(),\n115\t            excluded_memories: Vec::new(),\n116\t            budget_decisions: BudgetDecisions::default(),\n117\t            unresolved_questions: Vec::new(),\n118\t            verification_status: WorkingMemoryVerification::default(),\n119\t        }\n120\t    }\n121\t}\n122\t\n123\timpl Default for WorkingMemoryState {\n124\t    fn default() -> Self {\n125\t        Self::new(\"\")\n126\t    }\n127\t}\n128\t\n129\timpl Default for BudgetDecisions {\n130\t    fn default() -> Self {\n131\t        Self {\n132\t            token_cap: 0,\n133\t            dropped_count: 0,\n134\t            truncated_results: 0,\n135\t            pinned_identities: BTreeSet::new(),\n136\t        }\n137\t    }\n138\t}\n139\t\n140\timpl Default for WorkingMemoryVerification {\n141\t    fn default() -> Self {\n142\t        Self {\n143\t            last_verified_at: None,\n144\t            status: MemoryVerificationStatus::Unverified,\n145\t            notes: Vec::new(),\n146\t        }\n147\t    }\n148\t}\n149\t\n150\timpl CheckpointScope {\n151\t    pub fn new(\n152\t        workspace_id: impl Into<String>,\n153\t        session_id: impl Into<String>,\n154\t        task_id: impl Into<String>,\n155\t    ) -> Self {\n156\t        Self {\n157\t            workspace_id: workspace_id.into(),\n158\t            session_id: session_id.into(),\n159\t            task_id: task_id.into(),\n160\t        }\n161\t    }\n162\t\n163\t    pub fn from_state(state: &WorkingMemoryState) -> Self {\n164\t        Self {\n165\t            workspace_id: infer_workspace_id(state),\n166\t            session_id: DEFAULT_SESSION_ID.to_string(),\n167\t            task_id: task_hash(&state.task_statement),\n168\t        }\n169\t    }\n170\t}\n171\t\n172\tpub fn initialize_schema(conn: &Connection) -> Result<(), rusqlite::Error> {\n173\t    conn.execute_batch(include_str!(\"schema.sql\"))\n174\t}\n175\t\n176\tpub fn save_checkpoint(\n177\t    state: &WorkingMemoryState,\n178\t    name: &str,\n179\t    conn: &Connection,\n180\t) -> Result<CheckpointId, LatticeError> {\n181\t    let scope = CheckpointScope::from_state(state);\n182\t    save_checkpoint_for_scope(state, name, &scope, conn)\n183\t}\n184\t\n185\tpub fn save_checkpoint_for_scope(\n186\t    state: &WorkingMemoryState,\n187\t    name: &str,\n188\t    scope: &CheckpointScope,\n189\t    conn: &Connection,\n190\t) -> Result<CheckpointId, LatticeError> {\n191\t    initialize_schema(conn).map_err(schema_error)?;\n192\t    let state_json = canonical_state_json(state)?;\n193\t    let state_hash = hash_text(&state_json);\n194\t    conn.execute(\n195\t        \"INSERT INTO working_memory_checkpoints\n196\t            (workspace_id, session_id, task_id, checkpoint_name, created_at,\n197\t             state_version, state_json, state_hash)\n198\t         VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)\",\n199\t        params![\n200\t            scope.workspace_id,\n201\t            scope.session_id,\n202\t            scope.task_id,\n203\t            name,\n204\t            now_epoch_secs()?,\n205\t            WORKING_MEMORY_STATE_VERSION,\n206\t            state_json,\n207\t            state_hash,\n208\t        ],\n209\t    )\n210\t    .map_err(|e| {\n211\t        LatticeError::Storage(format!(\"Failed to save working memory checkpoint: {}\", e))\n212\t    })?;\n213\t    Ok(conn.last_insert_rowid())\n214\t}\n215\t\n216\tpub fn load_checkpoint(\n217\t    id: CheckpointId,\n218\t    conn: &Connection,\n219\t) -> Result<WorkingMemoryState, LatticeError> {\n220\t    initialize_schema(conn).map_err(schema_error)?;\n221\t    let row = conn\n222\t        .query_row(\n223\t            \"SELECT state_version, state_json, state_hash\n224\t             FROM working_memory_checkpoints\n225\t             WHERE checkpoint_id = ?1\",\n226\t            [id],\n227\t            |row| {\n228\t                Ok((\n229\t                    row.get::<_, i64>(0)?,\n230\t                    row.get::<_, String>(1)?,\n231\t                    row.get::<_, String>(2)?,\n232\t                ))\n233\t            },\n234\t        )\n235\t        .optional()\n236\t        .map_err(|e| {\n237\t            LatticeError::Storage(format!(\"Failed to load working memory checkpoint: {}\", e))\n238\t        })?;\n239\t    let (state_version, state_json, state_hash) = row.ok_or_else(|| {\n240\t        LatticeError::Storage(format!(\"Working memory checkpoint {} was not found\", id))\n241\t    })?;\n242\t\n243\t    reject_unknown_state_version(state_version)?;\n244\t    verify_state_hash(&state_json, &state_hash)?;\n245\t    serde_json::from_str(&state_json).map_err(|e| {\n246\t        LatticeError::Storage(format!(\n247\t            \"Failed to deserialize working memory checkpoint {}: {}\",\n248\t            id, e\n249\t        ))\n250\t    })\n251\t}\n252\t\n253\tpub fn load_latest_checkpoint_for_scope(\n254\t    scope: &CheckpointScope,\n255\t    conn: &Connection,\n256\t) -> Result<Option<(CheckpointId, WorkingMemoryState)>, LatticeError> {\n257\t    initialize_schema(conn).map_err(schema_error)?;\n258\t    let checkpoint_id = conn\n259\t        .query_row(\n260\t            \"SELECT checkpoint_id\n261\t             FROM working_memory_checkpoints\n262\t             WHERE workspace_id = ?1 AND session_id = ?2 AND task_id = ?3\n263\t             ORDER BY created_at DESC, checkpoint_id DESC\n264\t             LIMIT 1\",\n265\t            params![scope.workspace_id, scope.session_id, scope.task_id],\n266\t            |row| row.get::<_, CheckpointId>(0),\n267\t        )\n268\t        .optional()\n269\t        .map_err(|e| {\n270\t            LatticeError::Storage(format!(\n271\t                \"Failed to load latest working memory checkpoint for task {}: {}\",\n272\t                scope.task_id, e\n273\t            ))\n274\t        })?;\n275\t    checkpoint_id\n276\t        .map(|id| load_checkpoint(id, conn).map(|state| (id, state)))\n277\t        .transpose()\n278\t}\n279\t\n280\tpub fn canonical_state_json(state: &WorkingMemoryState) -> Result<String, LatticeError> {\n281\t    serde_json::to_string(state).map_err(|e| {\n282\t        LatticeError::Storage(format!(\"Failed to serialize working memory state: {}\", e))\n283\t    })\n284\t}\n285\t\n286\tpub fn state_hash(state: &WorkingMemoryState) -> Result<String, LatticeError> {\n287\t    canonical_state_json(state).map(|json| hash_text(&json))\n288\t}\n289\t\n290\tfn reject_unknown_state_version(state_version: i64) -> Result<(), LatticeError> {\n291\t    if state_version == WORKING_MEMORY_STATE_VERSION {\n292\t        return Ok(());\n293\t    }\n294\t    Err(LatticeError::Storage(format!(\n295\t        \"Unknown working memory state_version {}; supported version is {}\",\n296\t        state_version, WORKING_MEMORY_STATE_VERSION\n297\t    )))\n298\t}\n299\t\n300\tfn verify_state_hash(state_json: &str, expected_hash: &str) -> Result<(), LatticeError> {\n301\t    let actual_hash = hash_text(state_json);\n302\t    if actual_hash == expected_hash {\n303\t        return Ok(());\n304\t    }\n305\t    Err(LatticeError::Storage(format!(\n306\t        \"Working memory checkpoint hash mismatch: expected {}, got {}\",\n307\t        expected_hash, actual_hash\n308\t    )))\n309\t}\n310\t\n311\tfn infer_workspace_id(state: &WorkingMemoryState) -> String {\n312\t    if let Some(file) = state.active_files.iter().next() {\n313\t        return file.workspace_id.clone();\n314\t    }\n315\t    if let Some(symbol) = state.active_symbols.iter().next() {\n316\t        return symbol.file.workspace_id.clone();\n317\t    }\n318\t    \"unspecified-workspace\".to_string()\n319\t}\n320\t\n321\tfn task_hash(task_statement: &str) -> String {\n322\t    format!(\"task-{}\", hash_text(task_statement))\n323\t}\n324\t\n325\tfn hash_text(text: &str) -> String {\n326\t    let digest = Sha256::digest(text.as_bytes());\n327\t    digest.iter().map(|byte| format!(\"{:02x}\", byte)).collect()\n328\t}\n329\t\n330\tfn now_epoch_secs() -> Result<u64, LatticeError> {\n331\t    SystemTime::now()\n332\t        .duration_since(UNIX_EPOCH)\n333\t        .map(|duration| duration.as_secs())\n334\t        .map_err(|e| LatticeError::Storage(format!(\"System clock is before UNIX_EPOCH: {}\", e)))\n335\t}\n336\t\n337\tfn schema_error(error: rusqlite::Error) -> LatticeError {\n338\t    LatticeError::Storage(format!(\n339\t        \"Failed to initialize working memory checkpoint schema: {}\",\n340\t        error\n341\t    ))\n342\t}\n343\t"}]},"parent_tool_use_id":null,"session_id":"1b2121c5-8450-4d0d-9f66-0986877cae23","uuid":"506499d1-13c5-42a0-9fd6-091842ce4050","timestamp":"2026-05-17T10:13:44.277Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/working_memory/state.rs","content":"//! Working memory state model.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 5. Working Memory` says working memory contains:\n//!\n//! - task statement\n//! - interpreted intent\n//! - active files and symbols\n//! - active hypotheses\n//! - active failures\n//! - current plan\n//! - selected memories\n//! - excluded memories and reasons\n//! - budget decisions\n//! - unresolved questions\n//! - verification status\n\nuse std::collections::BTreeSet;\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse rusqlite::{params, Connection, OptionalExtension};\nuse serde::{Deserialize, Serialize};\nuse sha2::{Digest, Sha256};\n\nuse crate::error::LatticeError;\nuse crate::identity::{FileId, Identity, SymbolId};\nuse crate::memory::MemoryVerificationStatus;\nuse crate::retrieval_v1::{classify_intent, schema::BundleResult, IntentClassification};\n\npub const WORKING_MEMORY_STATE_VERSION: i64 = 1;\nconst DEFAULT_SESSION_ID: &str = \"unspecified-session\";\n\npub type CheckpointId = i64;\npub type FileIdentity = FileId;\npub type SymbolIdentity = SymbolId;\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct WorkingMemoryState {\n    pub task_statement: String,\n    pub interpreted_intent: IntentClassification,\n    pub active_files: BTreeSet<FileIdentity>,\n    pub active_symbols: BTreeSet<SymbolIdentity>,\n    pub active_hypotheses: Vec<Hypothesis>,\n    pub active_failures: Vec<FailureRecord>,\n    pub current_plan: Option<PlanRef>,\n    pub selected_memories: Vec<BundleResult>,\n    pub excluded_memories: Vec<ExcludedMemory>,\n    pub budget_decisions: BudgetDecisions,\n    pub unresolved_questions: Vec<String>,\n    pub verification_status: WorkingMemoryVerification,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct Hypothesis {\n    pub text: String,\n    pub evidence_refs: Vec<String>,\n    pub confidence: f32,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct FailureRecord {\n    pub kind: String,\n    pub message: String,\n    pub observed_at: u64,\n    pub evidence_refs: Vec<String>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct PlanRef {\n    pub plan_id: String,\n    pub version: u64,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct ExcludedMemory {\n    pub result: BundleResult,\n    pub exclusion_reason: String,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct BudgetDecisions {\n    pub token_cap: usize,\n    pub dropped_count: usize,\n    pub truncated_results: usize,\n    pub pinned_identities: BTreeSet<Identity>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct WorkingMemoryVerification {\n    pub last_verified_at: Option<u64>,\n    pub status: MemoryVerificationStatus,\n    pub notes: Vec<String>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct CheckpointScope {\n    pub workspace_id: String,\n    pub session_id: String,\n    pub task_id: String,\n}\n\nimpl WorkingMemoryState {\n    pub fn new(task_statement: impl Into<String>) -> Self {\n        let task_statement = task_statement.into();\n        let interpreted_intent = classify_intent(&task_statement);\n        Self {\n            task_statement,\n            interpreted_intent,\n            active_files: BTreeSet::new(),\n            active_symbols: BTreeSet::new(),\n            active_hypotheses: Vec::new(),\n            active_failures: Vec::new(),\n            current_plan: None,\n            selected_memories: Vec::new(),\n            excluded_memories: Vec::new(),\n            budget_decisions: BudgetDecisions::default(),\n            unresolved_questions: Vec::new(),\n            verification_status: WorkingMemoryVerification::default(),\n        }\n    }\n}\n\nimpl Default for WorkingMemoryState {\n    fn default() -> Self {\n        Self::new(\"\")\n    }\n}\n\nimpl Default for BudgetDecisions {\n    fn default() -> Self {\n        Self {\n            token_cap: 0,\n            dropped_count: 0,\n            truncated_results: 0,\n            pinned_identities: BTreeSet::new(),\n        }\n    }\n}\n\nimpl Default for WorkingMemoryVerification {\n    fn default() -> Self {\n        Self {\n            last_verified_at: None,\n            status: MemoryVerificationStatus::Unverified,\n            notes: Vec::new(),\n        }\n    }\n}\n\nimpl CheckpointScope {\n    pub fn new(\n        workspace_id: impl Into<String>,\n        session_id: impl Into<String>,\n        task_id: impl Into<String>,\n    ) -> Self {\n        Self {\n            workspace_id: workspace_id.into(),\n            session_id: session_id.into(),\n            task_id: task_id.into(),\n        }\n    }\n\n    pub fn from_state(state: &WorkingMemoryState) -> Self {\n        Self {\n            workspace_id: infer_workspace_id(state),\n            session_id: DEFAULT_SESSION_ID.to_string(),\n            task_id: task_hash(&state.task_statement),\n        }\n    }\n}\n\npub fn initialize_schema(conn: &Connection) -> Result<(), rusqlite::Error> {\n    conn.execute_batch(include_str!(\"schema.sql\"))\n}\n\npub fn save_checkpoint(\n    state: &WorkingMemoryState,\n    name: &str,\n    conn: &Connection,\n) -> Result<CheckpointId, LatticeError> {\n    let scope = CheckpointScope::from_state(state);\n    save_checkpoint_for_scope(state, name, &scope, conn)\n}\n\npub fn save_checkpoint_for_scope(\n    state: &WorkingMemoryState,\n    name: &str,\n    scope: &CheckpointScope,\n    conn: &Connection,\n) -> Result<CheckpointId, LatticeError> {\n    initialize_schema(conn).map_err(schema_error)?;\n    let state_json = canonical_state_json(state)?;\n    let state_hash = hash_text(&state_json);\n    conn.execute(\n        \"INSERT INTO working_memory_checkpoints\n            (workspace_id, session_id, task_id, checkpoint_name, created_at,\n             state_version, state_json, state_hash)\n         VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)\",\n        params![\n            scope.workspace_id,\n            scope.session_id,\n            scope.task_id,\n            name,\n            now_epoch_secs()?,\n            WORKING_MEMORY_STATE_VERSION,\n            state_json,\n            state_hash,\n        ],\n    )\n    .map_err(|e| {\n        LatticeError::Storage(format!(\"Failed to save working memory checkpoint: {}\", e))\n    })?;\n    Ok(conn.last_insert_rowid())\n}\n\npub fn load_checkpoint(\n    id: CheckpointId,\n    conn: &Connection,\n) -> Result<WorkingMemoryState, LatticeError> {\n    initialize_schema(conn).map_err(schema_error)?;\n    let row = conn\n        .query_row(\n            \"SELECT state_version, state_json, state_hash\n             FROM working_memory_checkpoints\n             WHERE checkpoint_id = ?1\",\n            [id],\n            |row| {\n                Ok((\n                    row.get::<_, i64>(0)?,\n                    row.get::<_, String>(1)?,\n                    row.get::<_, String>(2)?,\n                ))\n            },\n        )\n        .optional()\n        .map_err(|e| {\n            LatticeError::Storage(format!(\"Failed to load working memory checkpoint: {}\", e))\n        })?;\n    let (state_version, state_json, state_hash) = row.ok_or_else(|| {\n        LatticeError::Storage(format!(\"Working memory checkpoint {} was not found\", id))\n    })?;\n\n    reject_unknown_state_version(state_version)?;\n    verify_state_hash(&state_json, &state_hash)?;\n    serde_json::from_str(&state_json).map_err(|e| {\n        LatticeError::Storage(format!(\n            \"Failed to deserialize working memory checkpoint {}: {}\",\n            id, e\n        ))\n    })\n}\n\npub fn load_latest_checkpoint_for_scope(\n    scope: &CheckpointScope,\n    conn: &Connection,\n) -> Result<Option<(CheckpointId, WorkingMemoryState)>, LatticeError> {\n    initialize_schema(conn).map_err(schema_error)?;\n    let checkpoint_id = conn\n        .query_row(\n            \"SELECT checkpoint_id\n             FROM working_memory_checkpoints\n             WHERE workspace_id = ?1 AND session_id = ?2 AND task_id = ?3\n             ORDER BY created_at DESC, checkpoint_id DESC\n             LIMIT 1\",\n            params![scope.workspace_id, scope.session_id, scope.task_id],\n            |row| row.get::<_, CheckpointId>(0),\n        )\n        .optional()\n        .map_err(|e| {\n            LatticeError::Storage(format!(\n                \"Failed to load latest working memory checkpoint for task {}: {}\",\n                scope.task_id, e\n            ))\n        })?;\n    checkpoint_id\n        .map(|id| load_checkpoint(id, conn).map(|state| (id, state)))\n        .transpose()\n}\n\npub fn canonical_state_json(state: &WorkingMemoryState) -> Result<String, LatticeError> {\n    serde_json::to_string(state).map_err(|e| {\n        LatticeError::Storage(format!(\"Failed to serialize working memory state: {}\", e))\n    })\n}\n\npub fn state_hash(state: &WorkingMemoryState) -> Result<String, LatticeError> {\n    canonical_state_json(state).map(|json| hash_text(&json))\n}\n\nfn reject_unknown_state_version(state_version: i64) -> Result<(), LatticeError> {\n    if state_version == WORKING_MEMORY_STATE_VERSION {\n        return Ok(());\n    }\n    Err(LatticeError::Storage(format!(\n        \"Unknown working memory state_version {}; supported version is {}\",\n        state_version, WORKING_MEMORY_STATE_VERSION\n    )))\n}\n\nfn verify_state_hash(state_json: &str, expected_hash: &str) -> Result<(), LatticeError> {\n    let actual_hash = hash_text(state_json);\n    if actual_hash == expected_hash {\n        return Ok(());\n    }\n    Err(LatticeError::Storage(format!(\n        \"Working memory checkpoint hash mismatch: expected {}, got {}\",\n        expected_hash, actual_hash\n    )))\n}\n\nfn infer_workspace_id(state: &WorkingMemoryState) -> String {\n    if let Some(file) = state.active_files.iter().next() {\n        return file.workspace_id.clone();\n    }\n    if let Some(symbol) = state.active_symbols.iter().next() {\n        return symbol.file.workspace_id.clone();\n    }\n    \"unspecified-workspace\".to_string()\n}\n\nfn task_hash(task_statement: &str) -> String {\n    format!(\"task-{}\", hash_text(task_statement))\n}\n\nfn hash_text(text: &str) -> String {\n    let digest = Sha256::digest(text.as_bytes());\n    digest.iter().map(|byte| format!(\"{:02x}\", byte)).collect()\n}\n\nfn now_epoch_secs() -> Result<u64, LatticeError> {\n    SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .map(|duration| duration.as_secs())\n        .map_err(|e| LatticeError::Storage(format!(\"System clock is before UNIX_EPOCH: {}\", e)))\n}\n\nfn schema_error(error: rusqlite::Error) -> LatticeError {\n    LatticeError::Storage(format!(\n        \"Failed to initialize working memory checkpoint schema: {}\",\n        error\n    ))\n}\n","numLines":343,"startLine":1,"totalLines":343}}}
