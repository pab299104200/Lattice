{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012QrQQaQXSfu7G6qgffJzYC","type":"tool_result","content":"1\tuse std::collections::HashMap;\n2\tuse std::sync::atomic::{AtomicU64, Ordering};\n3\tuse std::sync::{Arc, Mutex};\n4\t\n5\tuse lattice_core::events::{\n6\t    Actor, AssistantTaskStartedPayload, BranchRef, ContextBundleReturnedPayload,\n7\t    DiagnosticObservedPayload, EventPayload, EventWriteError, EventWriter, FileReadPayload,\n8\t    FlushPolicy, MemoryConsolidatedPayload, MemoryCreatedPayload, MemoryExpandedPayload,\n9\t    MemoryInvalidatedPayload, MemoryRetrievedPayload, MemoryUpdatedPayload, PartialEnvelope,\n10\t    PatchAppliedPayload, PlanCreatedPayload, SessionId, StableRef, TaskId, TestRunCompletedPayload,\n11\t    TestRunStartedPayload, ToolCalledPayload, ToolResultPayload, UserCorrectionPayload,\n12\t    UserPreferenceObservedPayload, WorkflowFailedPayload, WorkflowSucceededPayload,\n13\t};\n14\tuse lattice_core::identity::{ContextHandleId, EventId, FileId, MemoryId};\n15\tuse serde_json::Value;\n16\t\n17\tuse super::event_capture_support::{\n18\t    call_id_from_parent, compact_summary, compact_text, context_handle_id_from_value,\n19\t    created_memory_ids, doc_section_refs, file_refs, lock_error, memory_ids_from_value,\n20\t    memory_refs, outcome_summary, output_context_handle_id, parse_tool_payload, status_label,\n21\t    symbol_refs, tool_result_status, workflow_summary,\n22\t};\n23\t\n24\tpub use super::event_capture_support::{\n25\t    DiagnosticRecord, EventCaptureError, PatchId, PlanId, PreferenceScope, PreferenceValue,\n26\t    TestRunPair, ToolOutcome,\n27\t};\n28\t\n29\tconst HOT_PATH_FLUSH: FlushPolicy = FlushPolicy::Batched { interval_ms: 250 };\n30\tconst TERMINAL_FLUSH: FlushPolicy = FlushPolicy::Sync;\n31\t\n32\tpub struct EventCapture {\n33\t    writer: Arc<EventWriter>,\n34\t    workspace_id: String,\n35\t    branch: BranchRef,\n36\t    session_id: SessionId,\n37\t    current_task: Mutex<Option<TaskId>>,\n38\t    active_calls: Mutex<HashMap<String, String>>,\n39\t    call_sequence: AtomicU64,\n40\t}\n41\t\n42\timpl std::fmt::Debug for EventCapture {\n43\t    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n44\t        formatter\n45\t            .debug_struct(\"EventCapture\")\n46\t            .field(\"workspace_id\", &self.workspace_id)\n47\t            .field(\"branch\", &self.branch)\n48\t            .field(\"session_id\", &self.session_id)\n49\t            .finish_non_exhaustive()\n50\t    }\n51\t}\n52\t\n53\timpl EventCapture {\n54\t    pub fn new(\n55\t        writer: Arc<EventWriter>,\n56\t        workspace_id: String,\n57\t        branch: String,\n58\t        session_id: SessionId,\n59\t    ) -> Result<Self, EventCaptureError> {\n60\t        if writer.workspace_id() != &workspace_id {\n61\t            return Err(EventCaptureError::WorkspaceMismatch {\n62\t                expected: writer.workspace_id().clone(),\n63\t                actual: workspace_id,\n64\t            });\n65\t        }\n66\t\n67\t        Ok(Self {\n68\t            writer,\n69\t            workspace_id,\n70\t            branch: BranchRef { name: branch },\n71\t            session_id,\n72\t            current_task: Mutex::new(None),\n73\t            active_calls: Mutex::new(HashMap::new()),\n74\t            call_sequence: AtomicU64::new(0),\n75\t        })\n76\t    }\n77\t\n78\t    pub fn begin_task(&self, task_id: TaskId, statement: &str) -> Result<EventId, EventWriteError> {\n79\t        {\n80\t            let mut current = self.current_task.lock().map_err(lock_error)?;\n81\t            *current = Some(task_id);\n82\t        }\n83\t        let payload = EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n84\t            context_handle_id: None,\n85\t            seed_event_ids: Vec::new(),\n86\t            initial_memory_ids: Vec::new(),\n87\t            objective: compact_text(statement, 240),\n88\t        });\n89\t        self.append(\n90\t            Actor::Assistant {\n91\t                model: \"mcp-client\".to_string(),\n92\t            },\n93\t            payload,\n94\t            Vec::new(),\n95\t            format!(\"Assistant task started: {}\", compact_text(statement, 160)),\n96\t            HOT_PATH_FLUSH,\n97\t        )\n98\t    }\n99\t\n100\t    pub fn ensure_task_started(&self, statement: &str) -> Result<Option<EventId>, EventWriteError> {\n101\t        let task_id = TaskId {\n102\t            value: format!(\"{}:default\", self.session_id.value),\n103\t        };\n104\t        if self.current_task.lock().map_err(lock_error)?.is_some() {\n105\t            return Ok(None);\n106\t        }\n107\t        self.begin_task(task_id, statement).map(Some)\n108\t    }\n109\t\n110\t    pub fn record_tool_called(\n111\t        &self,\n112\t        tool: &str,\n113\t        inputs: &Value,\n114\t    ) -> Result<EventId, EventWriteError> {\n115\t        let call_id = self.next_call_id(tool);\n116\t        let payload = EventPayload::ToolCalled(ToolCalledPayload {\n117\t            call_id: call_id.clone(),\n118\t            tool_name: tool.to_string(),\n119\t            context_handle_id: context_handle_id_from_value(inputs),\n120\t            source_event_id: None,\n121\t            input_summary: compact_text(&inputs.to_string(), 300),\n122\t        });\n123\t        let event_id = self.append(\n124\t            Actor::Tool {\n125\t                name: tool.to_string(),\n126\t            },\n127\t            payload,\n128\t            Vec::new(),\n129\t            format!(\"Tool called: {tool}\"),\n130\t            HOT_PATH_FLUSH,\n131\t        )?;\n132\t        self.active_calls\n133\t            .lock()\n134\t            .map_err(lock_error)?\n135\t            .insert(event_id.ulid.clone(), call_id);\n136\t        Ok(event_id)\n137\t    }\n138\t\n139\t    pub fn record_tool_result(\n140\t        &self,\n141\t        tool: &str,\n142\t        result: &ToolOutcome,\n143\t        parent: EventId,\n144\t    ) -> Result<EventId, EventWriteError> {\n145\t        let payload = EventPayload::ToolResult(ToolResultPayload {\n146\t            call_id: self.call_id_for_parent(tool, &parent)?,\n147\t            tool_name: tool.to_string(),\n148\t            status: tool_result_status(result),\n149\t            tool_call_event_id: Some(parent.clone()),\n150\t            output_context_handle_id: output_context_handle_id(result),\n151\t            created_memory_ids: created_memory_ids(result, &self.workspace_id),\n152\t            output_summary: outcome_summary(result),\n153\t        });\n154\t        self.append(\n155\t            Actor::Tool {\n156\t                name: tool.to_string(),\n157\t            },\n158\t            payload,\n159\t            vec![StableRef::EventRef(parent)],\n160\t            format!(\"Tool result: {tool} {}\", status_label(result)),\n161\t            HOT_PATH_FLUSH,\n162\t        )\n163\t    }\n164\t\n165\t    pub fn record_workflow_events(\n166\t        &self,\n167\t        tool: &str,\n168\t        outcome: &ToolOutcome,\n169\t        terminal_event: EventId,\n170\t    ) -> Result<Vec<EventId>, EventWriteError> {\n171\t        match outcome {\n172\t            ToolOutcome::Success(value) => self.record_success_events(tool, value, terminal_event),\n173\t            ToolOutcome::Error { message, .. } => {\n174\t                let event =\n175\t                    self.record_workflow_outcome(false, tool, message, &[terminal_event])?;\n176\t                Ok(vec![event])\n177\t            }\n178\t        }\n179\t    }\n180\t\n181\t    pub fn record_context_bundle(\n182\t        &self,\n183\t        handle: ContextHandleId,\n184\t        anchors: &[StableRef],\n185\t        _inclusion_reasons: &[String],\n186\t    ) -> Result<EventId, EventWriteError> {\n187\t        let payload = EventPayload::ContextBundleReturned(ContextBundleReturnedPayload {\n188\t            context_handle_id: handle.clone(),\n189\t            source_event_id: None,\n190\t            file_ids: file_refs(anchors),\n191\t            symbol_ids: symbol_refs(anchors),\n192\t            doc_section_ids: doc_section_refs(anchors),\n193\t            memory_ids: memory_refs(anchors),\n194\t            token_estimate: 0,\n195\t        });\n196\t        self.append(\n197\t            Actor::Daemon,\n198\t            payload,\n199\t            vec![StableRef::ContextHandleRef(handle)],\n200\t            \"Context bundle returned\".to_string(),\n201\t            HOT_PATH_FLUSH,\n202\t        )\n203\t    }\n204\t\n205\t    pub fn record_memory_retrieved(\n206\t        &self,\n207\t        memory_ids: &[MemoryId],\n208\t        reasons: &[String],\n209\t    ) -> Result<EventId, EventWriteError> {\n210\t        let payload = EventPayload::MemoryRetrieved(MemoryRetrievedPayload {\n211\t            retrieval_query: compact_text(&reasons.join(\"; \"), 240),\n212\t            context_handle_id: None,\n213\t            memory_ids: memory_ids.to_vec(),\n214\t            supporting_event_ids: Vec::new(),\n215\t        });\n216\t        self.append(\n217\t            Actor::Daemon,\n218\t            payload,\n219\t            memory_ids\n220\t                .iter()\n221\t                .cloned()\n222\t                .map(StableRef::MemoryRef)\n223\t                .collect(),\n224\t            format!(\"Retrieved {} memories\", memory_ids.len()),\n225\t            HOT_PATH_FLUSH,\n226\t        )\n227\t    }\n228\t\n229\t    // T15 defines helper contracts before all future call sites exist.\n230\t    #[allow(dead_code)]\n231\t    pub fn record_memory_expanded(\n232\t        &self,\n233\t        memory_id: MemoryId,\n234\t        _depth: u8,\n235\t    ) -> Result<EventId, EventWriteError> {\n236\t        let payload = EventPayload::MemoryExpanded(MemoryExpandedPayload {\n237\t            memory_id: memory_id.clone(),\n238\t            source_event_id: None,\n239\t            linked_memory_ids: Vec::new(),\n240\t            linked_symbol_ids: Vec::new(),\n241\t            linked_doc_section_ids: Vec::new(),\n242\t        });\n243\t        self.append(\n244\t            Actor::Daemon,\n245\t            payload,\n246\t            vec![StableRef::MemoryRef(memory_id)],\n247\t            \"Memory expanded\".to_string(),\n248\t            HOT_PATH_FLUSH,\n249\t        )\n250\t    }\n251\t\n252\t    pub fn record_plan_created(\n253\t        &self,\n254\t        plan_id: PlanId,\n255\t        target_files: &[FileId],\n256\t    ) -> Result<EventId, EventWriteError> {\n257\t        let payload = EventPayload::PlanCreated(PlanCreatedPayload {\n258\t            context_handle_id: None,\n259\t            source_event_id: None,\n260\t            memory_ids: Vec::new(),\n261\t            step_count: 0,\n262\t            plan_summary: plan_id,\n263\t        });\n264\t        self.append(\n265\t            Actor::Daemon,\n266\t            payload,\n267\t            target_files\n268\t                .iter()\n269\t                .cloned()\n270\t                .map(StableRef::FileRef)\n271\t                .collect(),\n272\t            \"Plan created\".to_string(),\n273\t            HOT_PATH_FLUSH,\n274\t        )\n275\t    }\n276\t\n277\t    // T15 defines helper contracts before all future call sites exist.\n278\t    #[allow(dead_code)]\n279\t    pub fn record_file_read(\n280\t        &self,\n281\t        file_id: FileId,\n282\t        byte_range: Option<(u64, u64)>,\n283\t    ) -> Result<EventId, EventWriteError> {\n284\t        let (byte_start, byte_end) = byte_range\n285\t            .map(|(start, end)| (u32::try_from(start).ok(), u32::try_from(end).ok()))\n286\t            .unwrap_or((None, None));\n287\t        let payload = EventPayload::FileRead(FileReadPayload {\n288\t            file_id: file_id.clone(),\n289\t            source_event_id: None,\n290\t            byte_start,\n291\t            byte_end,\n292\t            reason: \"MCP workflow context read\".to_string(),\n293\t        });\n294\t        self.append(\n295\t            Actor::Daemon,\n296\t            payload,\n297\t            vec![StableRef::FileRef(file_id)],\n298\t            \"File read\".to_string(),\n299\t            HOT_PATH_FLUSH,\n300\t        )\n301\t    }\n302\t\n303\t    // T15 defines helper contracts before all future call sites exist.\n304\t    #[allow(dead_code)]\n305\t    pub fn record_patch_applied(\n306\t        &self,\n307\t        patch_id: PatchId,\n308\t        files: &[FileId],\n309\t    ) -> Result<EventId, EventWriteError> {\n310\t        let payload = EventPayload::PatchApplied(PatchAppliedPayload {\n311\t            patch_id,\n312\t            source_event_id: None,\n313\t            file_ids: files.to_vec(),\n314\t            symbol_ids: Vec::new(),\n315\t            lines_added: 0,\n316\t            lines_removed: 0,\n317\t        });\n318\t        self.append(\n319\t            Actor::Daemon,\n320\t            payload,\n321\t            files.iter().cloned().map(StableRef::FileRef).collect(),\n322\t            \"Patch applied\".to_string(),\n323\t            TERMINAL_FLUSH,\n324\t        )\n325\t    }\n326\t\n327\t    // T15 defines helper contracts before all future call sites exist.\n328\t    #[allow(dead_code)]\n329\t    pub fn record_test_run(\n330\t        &self,\n331\t        events: TestRunPair,\n332\t    ) -> Result<(EventId, EventId), EventWriteError> {\n333\t        let started = self.append(\n334\t            Actor::Daemon,\n335\t            EventPayload::TestRunStarted(TestRunStartedPayload {\n336\t                run_id: events.run_id.clone(),\n337\t                source_event_id: None,\n338\t                file_ids: events.file_ids.clone(),\n339\t                symbol_ids: events.symbol_ids,\n340\t                command: events.command,\n341\t            }),\n342\t            events\n343\t                .file_ids\n344\t                .iter()\n345\t                .cloned()\n346\t                .map(StableRef::FileRef)\n347\t                .collect(),\n348\t            \"Test run started\".to_string(),\n349\t            HOT_PATH_FLUSH,\n350\t        )?;\n351\t        let completed = self.append(\n352\t            Actor::Daemon,\n353\t            EventPayload::TestRunCompleted(TestRunCompletedPayload {\n354\t                run_id: events.run_id,\n355\t                started_event_id: Some(started.clone()),\n356\t                status: events.status,\n357\t                passed: events.passed,\n358\t                failed: events.failed,\n359\t                skipped: events.skipped,\n360\t                diagnostic_event_ids: Vec::new(),\n361\t            }),\n362\t            vec![StableRef::EventRef(started.clone())],\n363\t            \"Test run completed\".to_string(),\n364\t            TERMINAL_FLUSH,\n365\t        )?;\n366\t        Ok((started, completed))\n367\t    }\n368\t\n369\t    // T15 defines helper contracts before all future call sites exist.\n370\t    #[allow(dead_code)]\n371\t    pub fn record_diagnostic(&self, diag: DiagnosticRecord) -> Result<EventId, EventWriteError> {\n372\t        let payload = EventPayload::DiagnosticObserved(DiagnosticObservedPayload {\n373\t            diagnostic_id: diag.diagnostic_id,\n374\t            source_event_id: None,\n375\t            file_id: diag.file_id.clone(),\n376\t            symbol_id: diag.symbol_id,\n377\t            severity: diag.severity,\n378\t            message: diag.message,\n379\t        });\n380\t        self.append(\n381\t            Actor::Daemon,\n382\t            payload,\n383\t            vec![StableRef::FileRef(diag.file_id)],\n384\t            \"Diagnostic observed\".to_string(),\n385\t            HOT_PATH_FLUSH,\n386\t        )\n387\t    }\n388\t\n389\t    // T15 defines helper contracts before all future call sites exist.\n390\t    #[allow(dead_code)]\n391\t    pub fn record_user_correction(\n392\t        &self,\n393\t        prior_event: EventId,\n394\t        correction: &str,\n395\t    ) -> Result<EventId, EventWriteError> {\n396\t        let payload = EventPayload::UserCorrection(UserCorrectionPayload {\n397\t            corrected_event_id: prior_event.clone(),\n398\t            file_ids: Vec::new(),\n399\t            superseded_memory_ids: Vec::new(),\n400\t            correction_summary: compact_text(correction, 240),\n401\t        });\n402\t        self.append(\n403\t            Actor::User,\n404\t            payload,\n405\t            vec![StableRef::EventRef(prior_event)],\n406\t            \"User correction observed\".to_string(),\n407\t            TERMINAL_FLUSH,\n408\t        )\n409\t    }\n410\t\n411\t    // T15 defines helper contracts before all future call sites exist.\n412\t    #[allow(dead_code)]\n413\t    pub fn record_user_preference(\n414\t        &self,\n415\t        scope: PreferenceScope,\n416\t        value: PreferenceValue,\n417\t    ) -> Result<EventId, EventWriteError> {\n418\t        let payload = EventPayload::UserPreferenceObserved(UserPreferenceObservedPayload {\n419\t            preference_key: format!(\"{:?}:{}\", scope, value.key),\n420\t            preference_value: value.value,\n421\t            observed_from_event_id: None,\n422\t            memory_id: None,\n423\t        });\n424\t        self.append(\n425\t            Actor::Daemon,\n426\t            payload,\n427\t            Vec::new(),\n428\t            \"User preference observed\".to_string(),\n429\t            TERMINAL_FLUSH,\n430\t        )\n431\t    }\n432\t\n433\t    pub fn record_workflow_outcome(\n434\t        &self,\n435\t        success: bool,\n436\t        workflow_name: &str,\n437\t        summary: &str,\n438\t        evidence: &[EventId],\n439\t    ) -> Result<EventId, EventWriteError> {\n440\t        let payload = if success {\n441\t            EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n442\t                workflow_name: workflow_name.to_string(),\n443\t                terminal_event_id: evidence.last().cloned(),\n444\t                output_context_handle_id: None,\n445\t                memory_ids: Vec::new(),\n446\t                result_summary: compact_text(summary, 240),\n447\t            })\n448\t        } else {\n449\t            EventPayload::WorkflowFailed(WorkflowFailedPayload {\n450\t                workflow_name: workflow_name.to_string(),\n451\t                terminal_event_id: evidence.last().cloned(),\n452\t                diagnostic_event_ids: Vec::new(),\n453\t                retryable: false,\n454\t                failure_summary: compact_text(summary, 240),\n455\t            })\n456\t        };\n457\t        self.append(\n458\t            Actor::Daemon,\n459\t            payload,\n460\t            evidence.iter().cloned().map(StableRef::EventRef).collect(),\n461\t            workflow_summary(success, workflow_name),\n462\t            TERMINAL_FLUSH,\n463\t        )\n464\t    }\n465\t\n466\t    // T15 defines helper contracts before all future call sites exist.\n467\t    #[allow(dead_code)]\n468\t    pub fn record_memory_created(\n469\t        &self,\n470\t        memory_id: MemoryId,\n471\t        evidence: &[EventId],\n472\t    ) -> Result<EventId, EventWriteError> {\n473\t        let payload = EventPayload::MemoryCreated(MemoryCreatedPayload {\n474\t            memory_id: memory_id.clone(),\n475\t            source_event_id: evidence.last().cloned(),\n476\t            evidence_event_ids: evidence.to_vec(),\n477\t            symbol_ids: Vec::new(),\n478\t            doc_section_ids: Vec::new(),\n479\t        });\n480\t        self.append(\n481\t            Actor::Daemon,\n482\t            payload,\n483\t            vec![StableRef::MemoryRef(memory_id)],\n484\t            \"Memory created\".to_string(),\n485\t            TERMINAL_FLUSH,\n486\t        )\n487\t    }\n488\t\n489\t    // T15 defines helper contracts before all future call sites exist.\n490\t    #[allow(dead_code)]\n491\t    pub fn record_memory_updated(\n492\t        &self,\n493\t        memory_id: MemoryId,\n494\t        summary: &str,\n495\t    ) -> Result<EventId, EventWriteError> {\n496\t        let payload = EventPayload::MemoryUpdated(MemoryUpdatedPayload {\n497\t            memory_id: memory_id.clone(),\n498\t            previous_event_id: None,\n499\t            evidence_event_ids: Vec::new(),\n500\t            superseded_memory_id: None,\n501\t            update_summary: compact_text(summary, 240),\n502\t        });\n503\t        self.append(\n504\t            Actor::Daemon,\n505\t            payload,\n506\t            vec![StableRef::MemoryRef(memory_id)],\n507\t            \"Memory updated\".to_string(),\n508\t            TERMINAL_FLUSH,\n509\t        )\n510\t    }\n511\t\n512\t    // T15 defines helper contracts before all future call sites exist.\n513\t    #[allow(dead_code)]\n514\t    pub fn record_memory_invalidated(\n515\t        &self,\n516\t        memory_id: MemoryId,\n517\t        reason: &str,\n518\t    ) -> Result<EventId, EventWriteError> {\n519\t        let payload = EventPayload::MemoryInvalidated(MemoryInvalidatedPayload {\n520\t            memory_id: memory_id.clone(),\n521\t            invalidated_by_event_id: None,\n522\t            contradicting_memory_ids: Vec::new(),\n523\t            reason: compact_text(reason, 240),\n524\t        });\n525\t        self.append(\n526\t            Actor::Daemon,\n527\t            payload,\n528\t            vec![StableRef::MemoryRef(memory_id)],\n529\t            \"Memory invalidated\".to_string(),\n530\t            TERMINAL_FLUSH,\n531\t        )\n532\t    }\n533\t\n534\t    // T15 defines helper contracts before all future call sites exist.\n535\t    #[allow(dead_code)]\n536\t    pub fn record_memory_consolidated(\n537\t        &self,\n538\t        source_memory_ids: &[MemoryId],\n539\t        consolidated_memory_id: MemoryId,\n540\t        source_event_ids: &[EventId],\n541\t        summary: &str,\n542\t    ) -> Result<EventId, EventWriteError> {\n543\t        let payload = EventPayload::MemoryConsolidated(MemoryConsolidatedPayload {\n544\t            source_memory_ids: source_memory_ids.to_vec(),\n545\t            consolidated_memory_id: consolidated_memory_id.clone(),\n546\t            source_event_ids: source_event_ids.to_vec(),\n547\t            consolidation_summary: compact_text(summary, 240),\n548\t        });\n549\t        self.append(\n550\t            Actor::Daemon,\n551\t            payload,\n552\t            vec![StableRef::MemoryRef(consolidated_memory_id)],\n553\t            \"Memory consolidated\".to_string(),\n554\t            TERMINAL_FLUSH,\n555\t        )\n556\t    }\n557\t\n558\t    fn record_success_events(\n559\t        &self,\n560\t        tool: &str,\n561\t        value: &Value,\n562\t        terminal_event: EventId,\n563\t    ) -> Result<Vec<EventId>, EventWriteError> {\n564\t        let mut events = Vec::new();\n565\t        let parsed = parse_tool_payload(value);\n566\t        if let Some(handle) = parsed.as_ref().and_then(context_handle_id_from_value) {\n567\t            events.push(self.record_context_bundle(handle, &[], &[])?);\n568\t        }\n569\t        if let Some(memory_ids) = parsed\n570\t            .as_ref()\n571\t            .map(|item| memory_ids_from_value(item, &self.workspace_id))\n572\t        {\n573\t            if !memory_ids.is_empty() {\n574\t                events.push(self.record_memory_retrieved(&memory_ids, &[tool.to_string()])?);\n575\t            }\n576\t        }\n577\t        if tool == \"plan_edit\" {\n578\t            events.push(self.record_plan_created(tool.to_string(), &[])?);\n579\t        }\n580\t        events.push(self.record_workflow_outcome(\n581\t            true,\n582\t            tool,\n583\t            &outcome_summary(&ToolOutcome::Success(value.clone())),\n584\t            &[terminal_event],\n585\t        )?);\n586\t        Ok(events)\n587\t    }\n588\t\n589\t    fn next_call_id(&self, tool: &str) -> String {\n590\t        let sequence = self.call_sequence.fetch_add(1, Ordering::Relaxed) + 1;\n591\t        format!(\"{}:{}:{sequence}\", self.session_id.value, tool)\n592\t    }\n593\t\n594\t    fn call_id_for_parent(&self, tool: &str, parent: &EventId) -> Result<String, EventWriteError> {\n595\t        Ok(self\n596\t            .active_calls\n597\t            .lock()\n598\t            .map_err(lock_error)?\n599\t            .remove(&parent.ulid)\n600\t            .unwrap_or_else(|| call_id_from_parent(tool, parent)))\n601\t    }\n602\t\n603\t    fn append(\n604\t        &self,\n605\t        actor: Actor,\n606\t        payload: EventPayload,\n607\t        references: Vec<StableRef>,\n608\t        summary: String,\n609\t        flush_policy: FlushPolicy,\n610\t    ) -> Result<EventId, EventWriteError> {\n611\t        let kind = payload.kind();\n612\t        let envelope = PartialEnvelope {\n613\t            workspace_id: Some(self.workspace_id.clone()),\n614\t            branch: self.branch.clone(),\n615\t            session_id: self.session_id.clone(),\n616\t            task_id: self.current_task.lock().map_err(lock_error)?.clone(),\n617\t            actor,\n618\t            kind,\n619\t            references,\n620\t            summary: compact_summary(summary)?,\n621\t            payload,\n622\t        };\n623\t        self.writer.append_with_flush_policy(envelope, flush_policy)\n624\t    }\n625\t}\n626\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"b3efd393-44d1-44f0-a757-fe5ca441bc47","timestamp":"2026-05-17T05:58:51.380Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/event_capture.rs","content":"use std::collections::HashMap;\nuse std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::{Arc, Mutex};\n\nuse lattice_core::events::{\n    Actor, AssistantTaskStartedPayload, BranchRef, ContextBundleReturnedPayload,\n    DiagnosticObservedPayload, EventPayload, EventWriteError, EventWriter, FileReadPayload,\n    FlushPolicy, MemoryConsolidatedPayload, MemoryCreatedPayload, MemoryExpandedPayload,\n    MemoryInvalidatedPayload, MemoryRetrievedPayload, MemoryUpdatedPayload, PartialEnvelope,\n    PatchAppliedPayload, PlanCreatedPayload, SessionId, StableRef, TaskId, TestRunCompletedPayload,\n    TestRunStartedPayload, ToolCalledPayload, ToolResultPayload, UserCorrectionPayload,\n    UserPreferenceObservedPayload, WorkflowFailedPayload, WorkflowSucceededPayload,\n};\nuse lattice_core::identity::{ContextHandleId, EventId, FileId, MemoryId};\nuse serde_json::Value;\n\nuse super::event_capture_support::{\n    call_id_from_parent, compact_summary, compact_text, context_handle_id_from_value,\n    created_memory_ids, doc_section_refs, file_refs, lock_error, memory_ids_from_value,\n    memory_refs, outcome_summary, output_context_handle_id, parse_tool_payload, status_label,\n    symbol_refs, tool_result_status, workflow_summary,\n};\n\npub use super::event_capture_support::{\n    DiagnosticRecord, EventCaptureError, PatchId, PlanId, PreferenceScope, PreferenceValue,\n    TestRunPair, ToolOutcome,\n};\n\nconst HOT_PATH_FLUSH: FlushPolicy = FlushPolicy::Batched { interval_ms: 250 };\nconst TERMINAL_FLUSH: FlushPolicy = FlushPolicy::Sync;\n\npub struct EventCapture {\n    writer: Arc<EventWriter>,\n    workspace_id: String,\n    branch: BranchRef,\n    session_id: SessionId,\n    current_task: Mutex<Option<TaskId>>,\n    active_calls: Mutex<HashMap<String, String>>,\n    call_sequence: AtomicU64,\n}\n\nimpl std::fmt::Debug for EventCapture {\n    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        formatter\n            .debug_struct(\"EventCapture\")\n            .field(\"workspace_id\", &self.workspace_id)\n            .field(\"branch\", &self.branch)\n            .field(\"session_id\", &self.session_id)\n            .finish_non_exhaustive()\n    }\n}\n\nimpl EventCapture {\n    pub fn new(\n        writer: Arc<EventWriter>,\n        workspace_id: String,\n        branch: String,\n        session_id: SessionId,\n    ) -> Result<Self, EventCaptureError> {\n        if writer.workspace_id() != &workspace_id {\n            return Err(EventCaptureError::WorkspaceMismatch {\n                expected: writer.workspace_id().clone(),\n                actual: workspace_id,\n            });\n        }\n\n        Ok(Self {\n            writer,\n            workspace_id,\n            branch: BranchRef { name: branch },\n            session_id,\n            current_task: Mutex::new(None),\n            active_calls: Mutex::new(HashMap::new()),\n            call_sequence: AtomicU64::new(0),\n        })\n    }\n\n    pub fn begin_task(&self, task_id: TaskId, statement: &str) -> Result<EventId, EventWriteError> {\n        {\n            let mut current = self.current_task.lock().map_err(lock_error)?;\n            *current = Some(task_id);\n        }\n        let payload = EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n            context_handle_id: None,\n            seed_event_ids: Vec::new(),\n            initial_memory_ids: Vec::new(),\n            objective: compact_text(statement, 240),\n        });\n        self.append(\n            Actor::Assistant {\n                model: \"mcp-client\".to_string(),\n            },\n            payload,\n            Vec::new(),\n            format!(\"Assistant task started: {}\", compact_text(statement, 160)),\n            HOT_PATH_FLUSH,\n        )\n    }\n\n    pub fn ensure_task_started(&self, statement: &str) -> Result<Option<EventId>, EventWriteError> {\n        let task_id = TaskId {\n            value: format!(\"{}:default\", self.session_id.value),\n        };\n        if self.current_task.lock().map_err(lock_error)?.is_some() {\n            return Ok(None);\n        }\n        self.begin_task(task_id, statement).map(Some)\n    }\n\n    pub fn record_tool_called(\n        &self,\n        tool: &str,\n        inputs: &Value,\n    ) -> Result<EventId, EventWriteError> {\n        let call_id = self.next_call_id(tool);\n        let payload = EventPayload::ToolCalled(ToolCalledPayload {\n            call_id: call_id.clone(),\n            tool_name: tool.to_string(),\n            context_handle_id: context_handle_id_from_value(inputs),\n            source_event_id: None,\n            input_summary: compact_text(&inputs.to_string(), 300),\n        });\n        let event_id = self.append(\n            Actor::Tool {\n                name: tool.to_string(),\n            },\n            payload,\n            Vec::new(),\n            format!(\"Tool called: {tool}\"),\n            HOT_PATH_FLUSH,\n        )?;\n        self.active_calls\n            .lock()\n            .map_err(lock_error)?\n            .insert(event_id.ulid.clone(), call_id);\n        Ok(event_id)\n    }\n\n    pub fn record_tool_result(\n        &self,\n        tool: &str,\n        result: &ToolOutcome,\n        parent: EventId,\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::ToolResult(ToolResultPayload {\n            call_id: self.call_id_for_parent(tool, &parent)?,\n            tool_name: tool.to_string(),\n            status: tool_result_status(result),\n            tool_call_event_id: Some(parent.clone()),\n            output_context_handle_id: output_context_handle_id(result),\n            created_memory_ids: created_memory_ids(result, &self.workspace_id),\n            output_summary: outcome_summary(result),\n        });\n        self.append(\n            Actor::Tool {\n                name: tool.to_string(),\n            },\n            payload,\n            vec![StableRef::EventRef(parent)],\n            format!(\"Tool result: {tool} {}\", status_label(result)),\n            HOT_PATH_FLUSH,\n        )\n    }\n\n    pub fn record_workflow_events(\n        &self,\n        tool: &str,\n        outcome: &ToolOutcome,\n        terminal_event: EventId,\n    ) -> Result<Vec<EventId>, EventWriteError> {\n        match outcome {\n            ToolOutcome::Success(value) => self.record_success_events(tool, value, terminal_event),\n            ToolOutcome::Error { message, .. } => {\n                let event =\n                    self.record_workflow_outcome(false, tool, message, &[terminal_event])?;\n                Ok(vec![event])\n            }\n        }\n    }\n\n    pub fn record_context_bundle(\n        &self,\n        handle: ContextHandleId,\n        anchors: &[StableRef],\n        _inclusion_reasons: &[String],\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::ContextBundleReturned(ContextBundleReturnedPayload {\n            context_handle_id: handle.clone(),\n            source_event_id: None,\n            file_ids: file_refs(anchors),\n            symbol_ids: symbol_refs(anchors),\n            doc_section_ids: doc_section_refs(anchors),\n            memory_ids: memory_refs(anchors),\n            token_estimate: 0,\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            vec![StableRef::ContextHandleRef(handle)],\n            \"Context bundle returned\".to_string(),\n            HOT_PATH_FLUSH,\n        )\n    }\n\n    pub fn record_memory_retrieved(\n        &self,\n        memory_ids: &[MemoryId],\n        reasons: &[String],\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::MemoryRetrieved(MemoryRetrievedPayload {\n            retrieval_query: compact_text(&reasons.join(\"; \"), 240),\n            context_handle_id: None,\n            memory_ids: memory_ids.to_vec(),\n            supporting_event_ids: Vec::new(),\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            memory_ids\n                .iter()\n                .cloned()\n                .map(StableRef::MemoryRef)\n                .collect(),\n            format!(\"Retrieved {} memories\", memory_ids.len()),\n            HOT_PATH_FLUSH,\n        )\n    }\n\n    // T15 defines helper contracts before all future call sites exist.\n    #[allow(dead_code)]\n    pub fn record_memory_expanded(\n        &self,\n        memory_id: MemoryId,\n        _depth: u8,\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::MemoryExpanded(MemoryExpandedPayload {\n            memory_id: memory_id.clone(),\n            source_event_id: None,\n            linked_memory_ids: Vec::new(),\n            linked_symbol_ids: Vec::new(),\n            linked_doc_section_ids: Vec::new(),\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            vec![StableRef::MemoryRef(memory_id)],\n            \"Memory expanded\".to_string(),\n            HOT_PATH_FLUSH,\n        )\n    }\n\n    pub fn record_plan_created(\n        &self,\n        plan_id: PlanId,\n        target_files: &[FileId],\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::PlanCreated(PlanCreatedPayload {\n            context_handle_id: None,\n            source_event_id: None,\n            memory_ids: Vec::new(),\n            step_count: 0,\n            plan_summary: plan_id,\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            target_files\n                .iter()\n                .cloned()\n                .map(StableRef::FileRef)\n                .collect(),\n            \"Plan created\".to_string(),\n            HOT_PATH_FLUSH,\n        )\n    }\n\n    // T15 defines helper contracts before all future call sites exist.\n    #[allow(dead_code)]\n    pub fn record_file_read(\n        &self,\n        file_id: FileId,\n        byte_range: Option<(u64, u64)>,\n    ) -> Result<EventId, EventWriteError> {\n        let (byte_start, byte_end) = byte_range\n            .map(|(start, end)| (u32::try_from(start).ok(), u32::try_from(end).ok()))\n            .unwrap_or((None, None));\n        let payload = EventPayload::FileRead(FileReadPayload {\n            file_id: file_id.clone(),\n            source_event_id: None,\n            byte_start,\n            byte_end,\n            reason: \"MCP workflow context read\".to_string(),\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            vec![StableRef::FileRef(file_id)],\n            \"File read\".to_string(),\n            HOT_PATH_FLUSH,\n        )\n    }\n\n    // T15 defines helper contracts before all future call sites exist.\n    #[allow(dead_code)]\n    pub fn record_patch_applied(\n        &self,\n        patch_id: PatchId,\n        files: &[FileId],\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::PatchApplied(PatchAppliedPayload {\n            patch_id,\n            source_event_id: None,\n            file_ids: files.to_vec(),\n            symbol_ids: Vec::new(),\n            lines_added: 0,\n            lines_removed: 0,\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            files.iter().cloned().map(StableRef::FileRef).collect(),\n            \"Patch applied\".to_string(),\n            TERMINAL_FLUSH,\n        )\n    }\n\n    // T15 defines helper contracts before all future call sites exist.\n    #[allow(dead_code)]\n    pub fn record_test_run(\n        &self,\n        events: TestRunPair,\n    ) -> Result<(EventId, EventId), EventWriteError> {\n        let started = self.append(\n            Actor::Daemon,\n            EventPayload::TestRunStarted(TestRunStartedPayload {\n                run_id: events.run_id.clone(),\n                source_event_id: None,\n                file_ids: events.file_ids.clone(),\n                symbol_ids: events.symbol_ids,\n                command: events.command,\n            }),\n            events\n                .file_ids\n                .iter()\n                .cloned()\n                .map(StableRef::FileRef)\n                .collect(),\n            \"Test run started\".to_string(),\n            HOT_PATH_FLUSH,\n        )?;\n        let completed = self.append(\n            Actor::Daemon,\n            EventPayload::TestRunCompleted(TestRunCompletedPayload {\n                run_id: events.run_id,\n                started_event_id: Some(started.clone()),\n                status: events.status,\n                passed: events.passed,\n                failed: events.failed,\n                skipped: events.skipped,\n                diagnostic_event_ids: Vec::new(),\n            }),\n            vec![StableRef::EventRef(started.clone())],\n            \"Test run completed\".to_string(),\n            TERMINAL_FLUSH,\n        )?;\n        Ok((started, completed))\n    }\n\n    // T15 defines helper contracts before all future call sites exist.\n    #[allow(dead_code)]\n    pub fn record_diagnostic(&self, diag: DiagnosticRecord) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::DiagnosticObserved(DiagnosticObservedPayload {\n            diagnostic_id: diag.diagnostic_id,\n            source_event_id: None,\n            file_id: diag.file_id.clone(),\n            symbol_id: diag.symbol_id,\n            severity: diag.severity,\n            message: diag.message,\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            vec![StableRef::FileRef(diag.file_id)],\n            \"Diagnostic observed\".to_string(),\n            HOT_PATH_FLUSH,\n        )\n    }\n\n    // T15 defines helper contracts before all future call sites exist.\n    #[allow(dead_code)]\n    pub fn record_user_correction(\n        &self,\n        prior_event: EventId,\n        correction: &str,\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::UserCorrection(UserCorrectionPayload {\n            corrected_event_id: prior_event.clone(),\n            file_ids: Vec::new(),\n            superseded_memory_ids: Vec::new(),\n            correction_summary: compact_text(correction, 240),\n        });\n        self.append(\n            Actor::User,\n            payload,\n            vec![StableRef::EventRef(prior_event)],\n            \"User correction observed\".to_string(),\n            TERMINAL_FLUSH,\n        )\n    }\n\n    // T15 defines helper contracts before all future call sites exist.\n    #[allow(dead_code)]\n    pub fn record_user_preference(\n        &self,\n        scope: PreferenceScope,\n        value: PreferenceValue,\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::UserPreferenceObserved(UserPreferenceObservedPayload {\n            preference_key: format!(\"{:?}:{}\", scope, value.key),\n            preference_value: value.value,\n            observed_from_event_id: None,\n            memory_id: None,\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            Vec::new(),\n            \"User preference observed\".to_string(),\n            TERMINAL_FLUSH,\n        )\n    }\n\n    pub fn record_workflow_outcome(\n        &self,\n        success: bool,\n        workflow_name: &str,\n        summary: &str,\n        evidence: &[EventId],\n    ) -> Result<EventId, EventWriteError> {\n        let payload = if success {\n            EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n                workflow_name: workflow_name.to_string(),\n                terminal_event_id: evidence.last().cloned(),\n                output_context_handle_id: None,\n                memory_ids: Vec::new(),\n                result_summary: compact_text(summary, 240),\n            })\n        } else {\n            EventPayload::WorkflowFailed(WorkflowFailedPayload {\n                workflow_name: workflow_name.to_string(),\n                terminal_event_id: evidence.last().cloned(),\n                diagnostic_event_ids: Vec::new(),\n                retryable: false,\n                failure_summary: compact_text(summary, 240),\n            })\n        };\n        self.append(\n            Actor::Daemon,\n            payload,\n            evidence.iter().cloned().map(StableRef::EventRef).collect(),\n            workflow_summary(success, workflow_name),\n            TERMINAL_FLUSH,\n        )\n    }\n\n    // T15 defines helper contracts before all future call sites exist.\n    #[allow(dead_code)]\n    pub fn record_memory_created(\n        &self,\n        memory_id: MemoryId,\n        evidence: &[EventId],\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::MemoryCreated(MemoryCreatedPayload {\n            memory_id: memory_id.clone(),\n            source_event_id: evidence.last().cloned(),\n            evidence_event_ids: evidence.to_vec(),\n            symbol_ids: Vec::new(),\n            doc_section_ids: Vec::new(),\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            vec![StableRef::MemoryRef(memory_id)],\n            \"Memory created\".to_string(),\n            TERMINAL_FLUSH,\n        )\n    }\n\n    // T15 defines helper contracts before all future call sites exist.\n    #[allow(dead_code)]\n    pub fn record_memory_updated(\n        &self,\n        memory_id: MemoryId,\n        summary: &str,\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::MemoryUpdated(MemoryUpdatedPayload {\n            memory_id: memory_id.clone(),\n            previous_event_id: None,\n            evidence_event_ids: Vec::new(),\n            superseded_memory_id: None,\n            update_summary: compact_text(summary, 240),\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            vec![StableRef::MemoryRef(memory_id)],\n            \"Memory updated\".to_string(),\n            TERMINAL_FLUSH,\n        )\n    }\n\n    // T15 defines helper contracts before all future call sites exist.\n    #[allow(dead_code)]\n    pub fn record_memory_invalidated(\n        &self,\n        memory_id: MemoryId,\n        reason: &str,\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::MemoryInvalidated(MemoryInvalidatedPayload {\n            memory_id: memory_id.clone(),\n            invalidated_by_event_id: None,\n            contradicting_memory_ids: Vec::new(),\n            reason: compact_text(reason, 240),\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            vec![StableRef::MemoryRef(memory_id)],\n            \"Memory invalidated\".to_string(),\n            TERMINAL_FLUSH,\n        )\n    }\n\n    // T15 defines helper contracts before all future call sites exist.\n    #[allow(dead_code)]\n    pub fn record_memory_consolidated(\n        &self,\n        source_memory_ids: &[MemoryId],\n        consolidated_memory_id: MemoryId,\n        source_event_ids: &[EventId],\n        summary: &str,\n    ) -> Result<EventId, EventWriteError> {\n        let payload = EventPayload::MemoryConsolidated(MemoryConsolidatedPayload {\n            source_memory_ids: source_memory_ids.to_vec(),\n            consolidated_memory_id: consolidated_memory_id.clone(),\n            source_event_ids: source_event_ids.to_vec(),\n            consolidation_summary: compact_text(summary, 240),\n        });\n        self.append(\n            Actor::Daemon,\n            payload,\n            vec![StableRef::MemoryRef(consolidated_memory_id)],\n            \"Memory consolidated\".to_string(),\n            TERMINAL_FLUSH,\n        )\n    }\n\n    fn record_success_events(\n        &self,\n        tool: &str,\n        value: &Value,\n        terminal_event: EventId,\n    ) -> Result<Vec<EventId>, EventWriteError> {\n        let mut events = Vec::new();\n        let parsed = parse_tool_payload(value);\n        if let Some(handle) = parsed.as_ref().and_then(context_handle_id_from_value) {\n            events.push(self.record_context_bundle(handle, &[], &[])?);\n        }\n        if let Some(memory_ids) = parsed\n            .as_ref()\n            .map(|item| memory_ids_from_value(item, &self.workspace_id))\n        {\n            if !memory_ids.is_empty() {\n                events.push(self.record_memory_retrieved(&memory_ids, &[tool.to_string()])?);\n            }\n        }\n        if tool == \"plan_edit\" {\n            events.push(self.record_plan_created(tool.to_string(), &[])?);\n        }\n        events.push(self.record_workflow_outcome(\n            true,\n            tool,\n            &outcome_summary(&ToolOutcome::Success(value.clone())),\n            &[terminal_event],\n        )?);\n        Ok(events)\n    }\n\n    fn next_call_id(&self, tool: &str) -> String {\n        let sequence = self.call_sequence.fetch_add(1, Ordering::Relaxed) + 1;\n        format!(\"{}:{}:{sequence}\", self.session_id.value, tool)\n    }\n\n    fn call_id_for_parent(&self, tool: &str, parent: &EventId) -> Result<String, EventWriteError> {\n        Ok(self\n            .active_calls\n            .lock()\n            .map_err(lock_error)?\n            .remove(&parent.ulid)\n            .unwrap_or_else(|| call_id_from_parent(tool, parent)))\n    }\n\n    fn append(\n        &self,\n        actor: Actor,\n        payload: EventPayload,\n        references: Vec<StableRef>,\n        summary: String,\n        flush_policy: FlushPolicy,\n    ) -> Result<EventId, EventWriteError> {\n        let kind = payload.kind();\n        let envelope = PartialEnvelope {\n            workspace_id: Some(self.workspace_id.clone()),\n            branch: self.branch.clone(),\n            session_id: self.session_id.clone(),\n            task_id: self.current_task.lock().map_err(lock_error)?.clone(),\n            actor,\n            kind,\n            references,\n            summary: compact_summary(summary)?,\n            payload,\n        };\n        self.writer.append_with_flush_policy(envelope, flush_policy)\n    }\n}\n","numLines":626,"startLine":1,"totalLines":626}}}
