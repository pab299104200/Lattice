{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014khwVPq8dEVueiVPQwzVVQ","type":"tool_result","content":"1\tuse std::time::{SystemTime, UNIX_EPOCH};\n2\t\n3\tuse rusqlite::{params, Connection};\n4\tuse tracing::{debug, warn};\n5\t\n6\tuse super::store::EventStoreError;\n7\t\n8\tpub const EVENT_SCHEMA_MIGRATION_ID: &str = \"p2_001_events\";\n9\tpub const EVENT_SCHEMA_TARGET_VERSION: i64 = 2;\n10\t\n11\tconst EVENT_SCHEMA_SQL: &str = include_str!(\"schema.sql\");\n12\t\n13\tpub fn run_migrations(conn: &mut Connection) -> Result<(), EventStoreError> {\n14\t    debug!(\n15\t        migration_id = EVENT_SCHEMA_MIGRATION_ID,\n16\t        target_version = EVENT_SCHEMA_TARGET_VERSION,\n17\t        \"checking event store migrations\"\n18\t    );\n19\t\n20\t    create_version_table(conn)?;\n21\t    let current_version = current_schema_version(conn)?;\n22\t    if current_version > EVENT_SCHEMA_TARGET_VERSION {\n23\t        warn!(\n24\t            migration_id = EVENT_SCHEMA_MIGRATION_ID,\n25\t            current_version,\n26\t            target_version = EVENT_SCHEMA_TARGET_VERSION,\n27\t            \"event store schema is newer than this binary\"\n28\t        );\n29\t        return Err(EventStoreError::MigrationFailed {\n30\t            migration_id: EVENT_SCHEMA_MIGRATION_ID,\n31\t            reason: \"database schema is newer than this binary\".to_string(),\n32\t        });\n33\t    }\n34\t    if current_version == EVENT_SCHEMA_TARGET_VERSION {\n35\t        debug!(\n36\t            migration_id = EVENT_SCHEMA_MIGRATION_ID,\n37\t            current_version, \"event store schema is current\"\n38\t        );\n39\t        return Ok(());\n40\t    }\n41\t\n42\t    if current_version == 0 {\n43\t        return apply_schema(conn);\n44\t    }\n45\t\n46\t    if current_version < 2 {\n47\t        apply_compaction_control_migration(conn)?;\n48\t    }\n49\t    Ok(())\n50\t}\n51\t\n52\tfn create_version_table(conn: &Connection) -> Result<(), EventStoreError> {\n53\t    conn.execute(\n54\t        \"CREATE TABLE IF NOT EXISTS event_schema_version (\n55\t            version INTEGER PRIMARY KEY,\n56\t            applied_ts_unix_micros INTEGER NOT NULL\n57\t        )\",\n58\t        params![],\n59\t    )?;\n60\t    Ok(())\n61\t}\n62\t\n63\tfn current_schema_version(conn: &Connection) -> Result<i64, EventStoreError> {\n64\t    let version = conn.query_row(\n65\t        \"SELECT COALESCE(MAX(version), 0) FROM event_schema_version\",\n66\t        params![],\n67\t        |row| row.get(0),\n68\t    )?;\n69\t    Ok(version)\n70\t}\n71\t\n72\tfn apply_schema(conn: &mut Connection) -> Result<(), EventStoreError> {\n73\t    let tx = conn.transaction()?;\n74\t    tx.execute_batch(EVENT_SCHEMA_SQL)\n75\t        .map_err(|error| EventStoreError::MigrationFailed {\n76\t            migration_id: EVENT_SCHEMA_MIGRATION_ID,\n77\t            reason: error.to_string(),\n78\t        })?;\n79\t    tx.execute(\n80\t        \"INSERT OR IGNORE INTO event_schema_version (version, applied_ts_unix_micros)\n81\t         VALUES (?1, ?2)\",\n82\t        params![EVENT_SCHEMA_TARGET_VERSION, now_unix_micros()],\n83\t    )?;\n84\t    tx.commit()?;\n85\t    debug!(\n86\t        migration_id = EVENT_SCHEMA_MIGRATION_ID,\n87\t        target_version = EVENT_SCHEMA_TARGET_VERSION,\n88\t        \"applied event store schema\"\n89\t    );\n90\t    Ok(())\n91\t}\n92\t\n93\tfn apply_compaction_control_migration(conn: &mut Connection) -> Result<(), EventStoreError> {\n94\t    let tx = conn.transaction()?;\n95\t    tx.execute_batch(\n96\t        \"CREATE TABLE IF NOT EXISTS event_compaction_control (\n97\t            id INTEGER PRIMARY KEY CHECK (id = 1),\n98\t            allow_delete INTEGER NOT NULL DEFAULT 0 CHECK (allow_delete IN (0, 1))\n99\t        );\n100\t        INSERT OR IGNORE INTO event_compaction_control (id, allow_delete)\n101\t        VALUES (1, 0);\n102\t        DROP TRIGGER IF EXISTS events_no_delete;\n103\t        CREATE TRIGGER events_no_delete\n104\t        BEFORE DELETE ON events\n105\t        WHEN (SELECT allow_delete FROM event_compaction_control WHERE id = 1) != 1\n106\t        BEGIN\n107\t            SELECT RAISE(ABORT, 'events table is append-only');\n108\t        END;\",\n109\t    )\n110\t    .map_err(|error| EventStoreError::MigrationFailed {\n111\t        migration_id: EVENT_SCHEMA_MIGRATION_ID,\n112\t        reason: error.to_string(),\n113\t    })?;\n114\t    tx.execute(\n115\t        \"INSERT OR IGNORE INTO event_schema_version (version, applied_ts_unix_micros)\n116\t         VALUES (?1, ?2)\",\n117\t        params![2, now_unix_micros()],\n118\t    )?;\n119\t    tx.commit()?;\n120\t    debug!(\n121\t        migration_id = EVENT_SCHEMA_MIGRATION_ID,\n122\t        target_version = 2,\n123\t        \"applied event compaction control schema\"\n124\t    );\n125\t    Ok(())\n126\t}\n127\t\n128\tfn now_unix_micros() -> i64 {\n129\t    SystemTime::now()\n130\t        .duration_since(UNIX_EPOCH)\n131\t        .unwrap_or_default()\n132\t        .as_micros()\n133\t        .min(i64::MAX as u128) as i64\n134\t}\n135\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"0dc4e9ac-f2af-4e32-b5f2-d1e812965448","timestamp":"2026-05-17T05:57:57.042Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/migrations.rs","content":"use std::time::{SystemTime, UNIX_EPOCH};\n\nuse rusqlite::{params, Connection};\nuse tracing::{debug, warn};\n\nuse super::store::EventStoreError;\n\npub const EVENT_SCHEMA_MIGRATION_ID: &str = \"p2_001_events\";\npub const EVENT_SCHEMA_TARGET_VERSION: i64 = 2;\n\nconst EVENT_SCHEMA_SQL: &str = include_str!(\"schema.sql\");\n\npub fn run_migrations(conn: &mut Connection) -> Result<(), EventStoreError> {\n    debug!(\n        migration_id = EVENT_SCHEMA_MIGRATION_ID,\n        target_version = EVENT_SCHEMA_TARGET_VERSION,\n        \"checking event store migrations\"\n    );\n\n    create_version_table(conn)?;\n    let current_version = current_schema_version(conn)?;\n    if current_version > EVENT_SCHEMA_TARGET_VERSION {\n        warn!(\n            migration_id = EVENT_SCHEMA_MIGRATION_ID,\n            current_version,\n            target_version = EVENT_SCHEMA_TARGET_VERSION,\n            \"event store schema is newer than this binary\"\n        );\n        return Err(EventStoreError::MigrationFailed {\n            migration_id: EVENT_SCHEMA_MIGRATION_ID,\n            reason: \"database schema is newer than this binary\".to_string(),\n        });\n    }\n    if current_version == EVENT_SCHEMA_TARGET_VERSION {\n        debug!(\n            migration_id = EVENT_SCHEMA_MIGRATION_ID,\n            current_version, \"event store schema is current\"\n        );\n        return Ok(());\n    }\n\n    if current_version == 0 {\n        return apply_schema(conn);\n    }\n\n    if current_version < 2 {\n        apply_compaction_control_migration(conn)?;\n    }\n    Ok(())\n}\n\nfn create_version_table(conn: &Connection) -> Result<(), EventStoreError> {\n    conn.execute(\n        \"CREATE TABLE IF NOT EXISTS event_schema_version (\n            version INTEGER PRIMARY KEY,\n            applied_ts_unix_micros INTEGER NOT NULL\n        )\",\n        params![],\n    )?;\n    Ok(())\n}\n\nfn current_schema_version(conn: &Connection) -> Result<i64, EventStoreError> {\n    let version = conn.query_row(\n        \"SELECT COALESCE(MAX(version), 0) FROM event_schema_version\",\n        params![],\n        |row| row.get(0),\n    )?;\n    Ok(version)\n}\n\nfn apply_schema(conn: &mut Connection) -> Result<(), EventStoreError> {\n    let tx = conn.transaction()?;\n    tx.execute_batch(EVENT_SCHEMA_SQL)\n        .map_err(|error| EventStoreError::MigrationFailed {\n            migration_id: EVENT_SCHEMA_MIGRATION_ID,\n            reason: error.to_string(),\n        })?;\n    tx.execute(\n        \"INSERT OR IGNORE INTO event_schema_version (version, applied_ts_unix_micros)\n         VALUES (?1, ?2)\",\n        params![EVENT_SCHEMA_TARGET_VERSION, now_unix_micros()],\n    )?;\n    tx.commit()?;\n    debug!(\n        migration_id = EVENT_SCHEMA_MIGRATION_ID,\n        target_version = EVENT_SCHEMA_TARGET_VERSION,\n        \"applied event store schema\"\n    );\n    Ok(())\n}\n\nfn apply_compaction_control_migration(conn: &mut Connection) -> Result<(), EventStoreError> {\n    let tx = conn.transaction()?;\n    tx.execute_batch(\n        \"CREATE TABLE IF NOT EXISTS event_compaction_control (\n            id INTEGER PRIMARY KEY CHECK (id = 1),\n            allow_delete INTEGER NOT NULL DEFAULT 0 CHECK (allow_delete IN (0, 1))\n        );\n        INSERT OR IGNORE INTO event_compaction_control (id, allow_delete)\n        VALUES (1, 0);\n        DROP TRIGGER IF EXISTS events_no_delete;\n        CREATE TRIGGER events_no_delete\n        BEFORE DELETE ON events\n        WHEN (SELECT allow_delete FROM event_compaction_control WHERE id = 1) != 1\n        BEGIN\n            SELECT RAISE(ABORT, 'events table is append-only');\n        END;\",\n    )\n    .map_err(|error| EventStoreError::MigrationFailed {\n        migration_id: EVENT_SCHEMA_MIGRATION_ID,\n        reason: error.to_string(),\n    })?;\n    tx.execute(\n        \"INSERT OR IGNORE INTO event_schema_version (version, applied_ts_unix_micros)\n         VALUES (?1, ?2)\",\n        params![2, now_unix_micros()],\n    )?;\n    tx.commit()?;\n    debug!(\n        migration_id = EVENT_SCHEMA_MIGRATION_ID,\n        target_version = 2,\n        \"applied event compaction control schema\"\n    );\n    Ok(())\n}\n\nfn now_unix_micros() -> i64 {\n    SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_micros()\n        .min(i64::MAX as u128) as i64\n}\n","numLines":135,"startLine":1,"totalLines":135}}}
