{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015RvgHngT3CTcCwuSE791bu","type":"tool_result","content":"1\tuse std::fmt;\n2\t\n3\tuse serde::de::{self, Visitor};\n4\tuse serde::{Deserialize, Deserializer, Serialize, Serializer};\n5\tuse serde_json::{Map, Value};\n6\tuse sha2::{Digest, Sha256};\n7\t\n8\tuse crate::events::kinds::EventPayload;\n9\t\n10\tpub const HASH_ALGORITHM: &str = \"sha256\";\n11\tconst HASH_PREFIX: &str = \"sha256:\";\n12\t\n13\t/// Stable 32-byte payload hash encoded as `sha256:<hex>` on the wire.\n14\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n15\tpub struct PayloadHash([u8; 32]);\n16\t\n17\timpl PayloadHash {\n18\t    pub fn new(bytes: [u8; 32]) -> Self {\n19\t        Self(bytes)\n20\t    }\n21\t\n22\t    pub fn as_bytes(&self) -> &[u8; 32] {\n23\t        &self.0\n24\t    }\n25\t\n26\t    pub fn to_hex(self) -> String {\n27\t        let mut output = String::with_capacity(64);\n28\t        for byte in self.0 {\n29\t            use std::fmt::Write as _;\n30\t            let _ = write!(&mut output, \"{byte:02x}\");\n31\t        }\n32\t        output\n33\t    }\n34\t}\n35\t\n36\timpl fmt::Display for PayloadHash {\n37\t    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n38\t        write!(formatter, \"{HASH_PREFIX}{}\", self.to_hex())\n39\t    }\n40\t}\n41\t\n42\timpl Serialize for PayloadHash {\n43\t    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>\n44\t    where\n45\t        S: Serializer,\n46\t    {\n47\t        serializer.serialize_str(&self.to_string())\n48\t    }\n49\t}\n50\t\n51\timpl<'de> Deserialize<'de> for PayloadHash {\n52\t    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n53\t    where\n54\t        D: Deserializer<'de>,\n55\t    {\n56\t        struct PayloadHashVisitor;\n57\t\n58\t        impl<'de> Visitor<'de> for PayloadHashVisitor {\n59\t            type Value = PayloadHash;\n60\t\n61\t            fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n62\t                formatter.write_str(\"a sha256 payload hash in sha256:<hex> form\")\n63\t            }\n64\t\n65\t            fn visit_str<E>(self, value: &str) -> Result<Self::Value, E>\n66\t            where\n67\t                E: de::Error,\n68\t            {\n69\t                parse_payload_hash(value).map_err(E::custom)\n70\t            }\n71\t\n72\t            fn visit_string<E>(self, value: String) -> Result<Self::Value, E>\n73\t            where\n74\t                E: de::Error,\n75\t            {\n76\t                parse_payload_hash(&value).map_err(E::custom)\n77\t            }\n78\t        }\n79\t\n80\t        deserializer.deserialize_str(PayloadHashVisitor)\n81\t    }\n82\t}\n83\t\n84\tpub fn hash_payload(payload: &EventPayload) -> Result<PayloadHash, serde_json::Error> {\n85\t    let bytes = canonical_json_bytes(payload)?;\n86\t    Ok(hash_canonical_payload_bytes(&bytes))\n87\t}\n88\t\n89\tpub fn hash_canonical_payload_bytes(bytes: &[u8]) -> PayloadHash {\n90\t    let digest = Sha256::digest(bytes);\n91\t    let mut hash = [0_u8; 32];\n92\t    hash.copy_from_slice(&digest);\n93\t    PayloadHash::new(hash)\n94\t}\n95\t\n96\tpub fn canonical_json_bytes<T>(value: &T) -> Result<Vec<u8>, serde_json::Error>\n97\twhere\n98\t    T: Serialize,\n99\t{\n100\t    let value = serde_json::to_value(value)?;\n101\t    let canonical = canonicalize_json_value(value);\n102\t    serde_json::to_vec(&canonical)\n103\t}\n104\t\n105\tpub fn canonicalize_json_value(value: Value) -> Value {\n106\t    match value {\n107\t        Value::Array(items) => Value::Array(\n108\t            items\n109\t                .into_iter()\n110\t                .map(canonicalize_json_value)\n111\t                .collect::<Vec<_>>(),\n112\t        ),\n113\t        Value::Object(map) => Value::Object(canonicalize_json_map(map)),\n114\t        other => other,\n115\t    }\n116\t}\n117\t\n118\tfn canonicalize_json_map(map: Map<String, Value>) -> Map<String, Value> {\n119\t    let mut entries = map.into_iter().collect::<Vec<_>>();\n120\t    entries.sort_by(|left, right| left.0.cmp(&right.0));\n121\t    let mut canonical = Map::with_capacity(entries.len());\n122\t    for (key, value) in entries {\n123\t        canonical.insert(key, canonicalize_json_value(value));\n124\t    }\n125\t    canonical\n126\t}\n127\t\n128\tfn parse_payload_hash(value: &str) -> Result<PayloadHash, String> {\n129\t    let hex = value\n130\t        .strip_prefix(HASH_PREFIX)\n131\t        .ok_or_else(|| \"payload hash must start with `sha256:`\".to_string())?;\n132\t    if hex.len() != 64 {\n133\t        return Err(\"payload hash must contain 64 lowercase hex characters\".to_string());\n134\t    }\n135\t\n136\t    let mut bytes = [0_u8; 32];\n137\t    for (index, chunk) in hex.as_bytes().chunks_exact(2).enumerate() {\n138\t        let pair = std::str::from_utf8(chunk)\n139\t            .map_err(|_| \"payload hash must contain valid UTF-8 hex\".to_string())?;\n140\t        bytes[index] = u8::from_str_radix(pair, 16)\n141\t            .map_err(|_| \"payload hash must contain lowercase hex characters\".to_string())?;\n142\t    }\n143\t    Ok(PayloadHash::new(bytes))\n144\t}\n145\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"25612864-255e-4c04-b7ce-b25e5dd7a7c9","timestamp":"2026-05-17T05:58:10.522Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/hashing.rs","content":"use std::fmt;\n\nuse serde::de::{self, Visitor};\nuse serde::{Deserialize, Deserializer, Serialize, Serializer};\nuse serde_json::{Map, Value};\nuse sha2::{Digest, Sha256};\n\nuse crate::events::kinds::EventPayload;\n\npub const HASH_ALGORITHM: &str = \"sha256\";\nconst HASH_PREFIX: &str = \"sha256:\";\n\n/// Stable 32-byte payload hash encoded as `sha256:<hex>` on the wire.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub struct PayloadHash([u8; 32]);\n\nimpl PayloadHash {\n    pub fn new(bytes: [u8; 32]) -> Self {\n        Self(bytes)\n    }\n\n    pub fn as_bytes(&self) -> &[u8; 32] {\n        &self.0\n    }\n\n    pub fn to_hex(self) -> String {\n        let mut output = String::with_capacity(64);\n        for byte in self.0 {\n            use std::fmt::Write as _;\n            let _ = write!(&mut output, \"{byte:02x}\");\n        }\n        output\n    }\n}\n\nimpl fmt::Display for PayloadHash {\n    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n        write!(formatter, \"{HASH_PREFIX}{}\", self.to_hex())\n    }\n}\n\nimpl Serialize for PayloadHash {\n    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>\n    where\n        S: Serializer,\n    {\n        serializer.serialize_str(&self.to_string())\n    }\n}\n\nimpl<'de> Deserialize<'de> for PayloadHash {\n    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n    where\n        D: Deserializer<'de>,\n    {\n        struct PayloadHashVisitor;\n\n        impl<'de> Visitor<'de> for PayloadHashVisitor {\n            type Value = PayloadHash;\n\n            fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n                formatter.write_str(\"a sha256 payload hash in sha256:<hex> form\")\n            }\n\n            fn visit_str<E>(self, value: &str) -> Result<Self::Value, E>\n            where\n                E: de::Error,\n            {\n                parse_payload_hash(value).map_err(E::custom)\n            }\n\n            fn visit_string<E>(self, value: String) -> Result<Self::Value, E>\n            where\n                E: de::Error,\n            {\n                parse_payload_hash(&value).map_err(E::custom)\n            }\n        }\n\n        deserializer.deserialize_str(PayloadHashVisitor)\n    }\n}\n\npub fn hash_payload(payload: &EventPayload) -> Result<PayloadHash, serde_json::Error> {\n    let bytes = canonical_json_bytes(payload)?;\n    Ok(hash_canonical_payload_bytes(&bytes))\n}\n\npub fn hash_canonical_payload_bytes(bytes: &[u8]) -> PayloadHash {\n    let digest = Sha256::digest(bytes);\n    let mut hash = [0_u8; 32];\n    hash.copy_from_slice(&digest);\n    PayloadHash::new(hash)\n}\n\npub fn canonical_json_bytes<T>(value: &T) -> Result<Vec<u8>, serde_json::Error>\nwhere\n    T: Serialize,\n{\n    let value = serde_json::to_value(value)?;\n    let canonical = canonicalize_json_value(value);\n    serde_json::to_vec(&canonical)\n}\n\npub fn canonicalize_json_value(value: Value) -> Value {\n    match value {\n        Value::Array(items) => Value::Array(\n            items\n                .into_iter()\n                .map(canonicalize_json_value)\n                .collect::<Vec<_>>(),\n        ),\n        Value::Object(map) => Value::Object(canonicalize_json_map(map)),\n        other => other,\n    }\n}\n\nfn canonicalize_json_map(map: Map<String, Value>) -> Map<String, Value> {\n    let mut entries = map.into_iter().collect::<Vec<_>>();\n    entries.sort_by(|left, right| left.0.cmp(&right.0));\n    let mut canonical = Map::with_capacity(entries.len());\n    for (key, value) in entries {\n        canonical.insert(key, canonicalize_json_value(value));\n    }\n    canonical\n}\n\nfn parse_payload_hash(value: &str) -> Result<PayloadHash, String> {\n    let hex = value\n        .strip_prefix(HASH_PREFIX)\n        .ok_or_else(|| \"payload hash must start with `sha256:`\".to_string())?;\n    if hex.len() != 64 {\n        return Err(\"payload hash must contain 64 lowercase hex characters\".to_string());\n    }\n\n    let mut bytes = [0_u8; 32];\n    for (index, chunk) in hex.as_bytes().chunks_exact(2).enumerate() {\n        let pair = std::str::from_utf8(chunk)\n            .map_err(|_| \"payload hash must contain valid UTF-8 hex\".to_string())?;\n        bytes[index] = u8::from_str_radix(pair, 16)\n            .map_err(|_| \"payload hash must contain lowercase hex characters\".to_string())?;\n    }\n    Ok(PayloadHash::new(bytes))\n}\n","numLines":145,"startLine":1,"totalLines":145}}}
