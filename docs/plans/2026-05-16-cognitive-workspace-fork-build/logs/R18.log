{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MnZJSCkVvStgcLpvQB5yQg","type":"tool_result","content":"1\t//! Public append-only writer for event envelopes.\n2\t//!\n3\t//! The writer defaults to a 4096-byte inline ceiling so hot-path workflow events\n4\t//! stay in the main `events` table while larger payloads spill into\n5\t//! `event_payloads` without bloating primary-row reads.\n6\t\n7\tuse std::collections::HashMap;\n8\tuse std::sync::atomic::{AtomicU64, Ordering};\n9\tuse std::sync::{Arc, Mutex};\n10\tuse std::time::{SystemTime, UNIX_EPOCH};\n11\t\n12\tuse serde_json::to_string;\n13\tuse thiserror::Error;\n14\tuse tracing::{debug, trace_span, warn};\n15\t\n16\tuse crate::events::kinds::EventKind;\n17\tuse crate::events::store::MAX_EVENT_PAYLOAD_BYTES;\n18\tuse crate::events::{\n19\t    Actor, BranchRef, CompactSummary, EventPayload, EventStore, EventStoreError, InsertEnvelopeRow,\n20\t    PayloadLocation, SessionId, StableRef, TaskId,\n21\t};\n22\tuse crate::identity::{EventId, WorkspaceId};\n23\tuse crate::{DateTime, Utc};\n24\t\n25\tconst DEFAULT_INLINE_CEILING_BYTES: usize = 4096;\n26\tconst EVENT_SCHEMA_VERSION: i64 = 1;\n27\tconst ULID_ALPHABET: &[u8; 32] = b\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\n28\tstatic ULID_COUNTER: AtomicU64 = AtomicU64::new(0);\n29\t\n30\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n31\tpub enum FlushPolicy {\n32\t    Sync,\n33\t    Batched { interval_ms: u64 },\n34\t}\n35\t\n36\t#[derive(Clone, Debug)]\n37\tpub struct PartialEnvelope {\n38\t    pub workspace_id: Option<WorkspaceId>,\n39\t    pub branch: BranchRef,\n40\t    pub session_id: SessionId,\n41\t    pub task_id: Option<TaskId>,\n42\t    pub actor: Actor,\n43\t    pub kind: EventKind,\n44\t    pub references: Vec<StableRef>,\n45\t    pub summary: CompactSummary,\n46\t    pub payload: EventPayload,\n47\t}\n48\t\n49\t#[derive(Debug, Error, PartialEq, Eq)]\n50\tpub enum IdentityError {\n51\t    #[error(\"{field} must not be empty\")]\n52\t    EmptyField { field: &'static str },\n53\t}\n54\t\n55\t#[derive(Debug, Error)]\n56\tpub enum EventWriteError {\n57\t    #[error(\"event workspace `{actual}` does not match writer workspace `{expected}`\")]\n58\t    WorkspaceMismatch {\n59\t        expected: WorkspaceId,\n60\t        actual: WorkspaceId,\n61\t    },\n62\t    #[error(\"event payload is too large: {actual} bytes exceeds {ceiling} bytes\")]\n63\t    PayloadTooLarge { ceiling: usize, actual: usize },\n64\t    #[error(\"event store write failed: {0}\")]\n65\t    Storage(#[from] EventStoreError),\n66\t    #[error(\"event payload serialization failed: {0}\")]\n67\t    Serde(#[from] serde_json::Error),\n68\t    #[error(\"event identity is invalid: {0}\")]\n69\t    Identity(#[from] IdentityError),\n70\t}\n71\t\n72\tpub struct EventWriter {\n73\t    store: Arc<EventStore>,\n74\t    workspace_id: WorkspaceId,\n75\t    inline_ceiling_bytes: usize,\n76\t    flush_policy: FlushPolicy,\n77\t    monotonic_state: Mutex<MonotonicState>,\n78\t    payload_spill_cache: Mutex<HashMap<crate::events::PayloadHash, i64>>,\n79\t}\n80\t\n81\t#[derive(Default)]\n82\tstruct MonotonicState {\n83\t    last_session_micros: HashMap<String, i64>,\n84\t}\n85\t\n86\timpl EventWriter {\n87\t    pub fn new(\n88\t        store: Arc<EventStore>,\n89\t        workspace_id: WorkspaceId,\n90\t        inline_ceiling_bytes: usize,\n91\t    ) -> Self {\n92\t        Self {\n93\t            store,\n94\t            workspace_id,\n95\t            inline_ceiling_bytes: if inline_ceiling_bytes == 0 {\n96\t                DEFAULT_INLINE_CEILING_BYTES\n97\t            } else {\n98\t                inline_ceiling_bytes\n99\t            },\n100\t            flush_policy: default_flush_policy(),\n101\t            monotonic_state: Mutex::new(MonotonicState::default()),\n102\t            payload_spill_cache: Mutex::new(HashMap::new()),\n103\t        }\n104\t    }\n105\t\n106\t    pub fn with_flush_policy(mut self, flush_policy: FlushPolicy) -> Self {\n107\t        self.flush_policy = flush_policy;\n108\t        self\n109\t    }\n110\t\n111\t    pub fn inline_ceiling_bytes(&self) -> usize {\n112\t        self.inline_ceiling_bytes\n113\t    }\n114\t\n115\t    pub fn workspace_id(&self) -> &WorkspaceId {\n116\t        &self.workspace_id\n117\t    }\n118\t\n119\t    pub fn append(&self, envelope: PartialEnvelope) -> Result<EventId, EventWriteError> {\n120\t        self.append_with_flush_policy(envelope, self.flush_policy)\n121\t    }\n122\t\n123\t    pub fn append_with_flush_policy(\n124\t        &self,\n125\t        envelope: PartialEnvelope,\n126\t        flush_policy: FlushPolicy,\n127\t    ) -> Result<EventId, EventWriteError> {\n128\t        let _span = trace_span!(\"event_writer.append\", kind = envelope.kind.as_str()).entered();\n129\t        let workspace_id = self.resolve_workspace(&envelope.workspace_id)?;\n130\t        let payload_bytes = serde_json::to_vec(&envelope.payload)?;\n131\t        if payload_bytes.len() > MAX_EVENT_PAYLOAD_BYTES {\n132\t            return Err(EventWriteError::PayloadTooLarge {\n133\t                ceiling: MAX_EVENT_PAYLOAD_BYTES,\n134\t                actual: payload_bytes.len(),\n135\t            });\n136\t        }\n137\t\n138\t        let payload_hash = crate::events::hash_canonical_payload_bytes(&payload_bytes);\n139\t        let (timestamp, ts_unix_micros) = self.next_timestamp(&envelope.session_id)?;\n140\t        let event_id = EventId {\n141\t            workspace_id: workspace_id.clone(),\n142\t            ulid: next_ulid(ts_unix_micros),\n143\t        };\n144\t        let payload_location =\n145\t            self.persist_payload(&payload_hash, &payload_bytes, ts_unix_micros)?;\n146\t        let row = build_insert_row(\n147\t            &event_id,\n148\t            &workspace_id,\n149\t            &envelope,\n150\t            payload_hash.as_bytes().to_vec(),\n151\t            payload_location,\n152\t            payload_bytes,\n153\t            ts_unix_micros,\n154\t        )?;\n155\t\n156\t        self.store.insert_envelope_row_cached(&row)?;\n157\t        self.flush_if_needed(flush_policy)?;\n158\t        let _ = timestamp;\n159\t        Ok(event_id)\n160\t    }\n161\t\n162\t    fn resolve_workspace(\n163\t        &self,\n164\t        workspace_id: &Option<WorkspaceId>,\n165\t    ) -> Result<WorkspaceId, EventWriteError> {\n166\t        match workspace_id {\n167\t            Some(value) if value != &self.workspace_id => {\n168\t                warn!(\n169\t                    writer_workspace_id = self.workspace_id.as_str(),\n170\t                    event_workspace_id = value.as_str(),\n171\t                    \"event writer rejected workspace mismatch\"\n172\t                );\n173\t                Err(EventWriteError::WorkspaceMismatch {\n174\t                    expected: self.workspace_id.clone(),\n175\t                    actual: value.clone(),\n176\t                })\n177\t            }\n178\t            Some(value) => Ok(value.clone()),\n179\t            None => Ok(self.workspace_id.clone()),\n180\t        }\n181\t    }\n182\t\n183\t    fn next_timestamp(\n184\t        &self,\n185\t        session_id: &SessionId,\n186\t    ) -> Result<(DateTime<Utc>, i64), EventWriteError> {\n187\t        if session_id.value.is_empty() {\n188\t            return Err(IdentityError::EmptyField {\n189\t                field: \"session_id\",\n190\t            }\n191\t            .into());\n192\t        }\n193\t\n194\t        let mut state =\n195\t            self.monotonic_state\n196\t                .lock()\n197\t                .map_err(|_| EventStoreError::EnvelopeInvalid {\n198\t                    reason: \"event writer monotonic state lock was poisoned\".to_string(),\n199\t                })?;\n200\t        let now_micros = current_unix_micros()?;\n201\t        let entry = state\n202\t            .last_session_micros\n203\t            .entry(session_id.value.clone())\n204\t            .or_insert(now_micros);\n205\t        let next_micros = if now_micros > *entry {\n206\t            now_micros\n207\t        } else {\n208\t            *entry + 1\n209\t        };\n210\t        *entry = next_micros;\n211\t        Ok((\n212\t            DateTime::from_unix_seconds(next_micros / 1_000_000),\n213\t            next_micros,\n214\t        ))\n215\t    }\n216\t\n217\t    fn persist_payload(\n218\t        &self,\n219\t        payload_hash: &crate::events::PayloadHash,\n220\t        payload_bytes: &[u8],\n221\t        ts_unix_micros: i64,\n222\t    ) -> Result<PayloadLocation, EventWriteError> {\n223\t        if payload_bytes.len() <= self.inline_ceiling_bytes {\n224\t            let bytes_len = u32::try_from(payload_bytes.len()).map_err(|_| {\n225\t                EventWriteError::PayloadTooLarge {\n226\t                    ceiling: u32::MAX as usize,\n227\t                    actual: payload_bytes.len(),\n228\t                }\n229\t            })?;\n230\t            return Ok(PayloadLocation::Inline { bytes_len });\n231\t        }\n232\t\n233\t        if let Some(row_id) = self.cached_payload_row_id(payload_hash)? {\n234\t            return Ok(PayloadLocation::Spilled { row_id });\n235\t        }\n236\t\n237\t        let row_id = self.store.insert_or_get_payload(\n238\t            payload_hash.as_bytes(),\n239\t            payload_bytes,\n240\t            ts_unix_micros,\n241\t        )?;\n242\t        self.payload_spill_cache\n243\t            .lock()\n244\t            .map_err(|_| EventStoreError::EnvelopeInvalid {\n245\t                reason: \"event writer payload cache lock was poisoned\".to_string(),\n246\t            })?\n247\t            .insert(*payload_hash, row_id);\n248\t        debug!(\n249\t            bytes_len = payload_bytes.len(),\n250\t            inline_ceiling_bytes = self.inline_ceiling_bytes,\n251\t            payload_row_id = row_id,\n252\t            \"event payload spilled to side table\"\n253\t        );\n254\t        Ok(PayloadLocation::Spilled { row_id })\n255\t    }\n256\t\n257\t    fn cached_payload_row_id(\n258\t        &self,\n259\t        payload_hash: &crate::events::PayloadHash,\n260\t    ) -> Result<Option<i64>, EventWriteError> {\n261\t        Ok(self\n262\t            .payload_spill_cache\n263\t            .lock()\n264\t            .map_err(|_| EventStoreError::EnvelopeInvalid {\n265\t                reason: \"event writer payload cache lock was poisoned\".to_string(),\n266\t            })?\n267\t            .get(payload_hash)\n268\t            .copied())\n269\t    }\n270\t\n271\t    fn flush_if_needed(&self, flush_policy: FlushPolicy) -> Result<(), EventWriteError> {\n272\t        match flush_policy {\n273\t            FlushPolicy::Sync => self.store.checkpoint_wal().map_err(EventWriteError::from),\n274\t            FlushPolicy::Batched { interval_ms: _ } => Ok(()),\n275\t        }\n276\t    }\n277\t}\n278\t\n279\tfn build_insert_row(\n280\t    event_id: &EventId,\n281\t    workspace_id: &str,\n282\t    envelope: &PartialEnvelope,\n283\t    payload_hash: Vec<u8>,\n284\t    payload_location: PayloadLocation,\n285\t    payload_bytes: Vec<u8>,\n286\t    ts_unix_micros: i64,\n287\t) -> Result<InsertEnvelopeRow, EventWriteError> {\n288\t    let (actor_kind, actor_detail) = actor_parts(&envelope.actor);\n289\t    validate_identity_fields(\n290\t        workspace_id,\n291\t        &envelope.branch,\n292\t        &envelope.session_id,\n293\t        &envelope.task_id,\n294\t    )?;\n295\t    let references_json = to_string(&envelope.references)?;\n296\t    let (payload_inline, payload_spill_id) = match payload_location {\n297\t        PayloadLocation::Inline { .. } => (Some(payload_bytes), None),\n298\t        PayloadLocation::Spilled { row_id } => (None, Some(row_id)),\n299\t    };\n300\t\n301\t    Ok(InsertEnvelopeRow {\n302\t        event_uuid: event_id.ulid.clone(),\n303\t        workspace_id: workspace_id.to_string(),\n304\t        branch: envelope.branch.name.clone(),\n305\t        session_id: envelope.session_id.value.clone(),\n306\t        task_id: envelope\n307\t            .task_id\n308\t            .as_ref()\n309\t            .map(|task_id| task_id.value.clone()),\n310\t        actor_kind,\n311\t        actor_detail,\n312\t        kind: envelope.kind.as_str().to_string(),\n313\t        ts_unix_micros,\n314\t        payload_hash,\n315\t        summary: envelope.summary.as_str().to_string(),\n316\t        payload_inline,\n317\t        payload_spill_id,\n318\t        references_json,\n319\t        schema_version: EVENT_SCHEMA_VERSION,\n320\t    })\n321\t}\n322\t\n323\tfn actor_parts(actor: &Actor) -> (String, Option<String>) {\n324\t    match actor {\n325\t        Actor::Assistant { model } => (\"assistant\".to_string(), Some(model.clone())),\n326\t        Actor::User => (\"user\".to_string(), None),\n327\t        Actor::Tool { name } => (\"tool\".to_string(), Some(name.clone())),\n328\t        Actor::Daemon => (\"daemon\".to_string(), None),\n329\t    }\n330\t}\n331\t\n332\tfn validate_identity_fields(\n333\t    workspace_id: &str,\n334\t    branch: &BranchRef,\n335\t    session_id: &SessionId,\n336\t    task_id: &Option<TaskId>,\n337\t) -> Result<(), IdentityError> {\n338\t    if workspace_id.is_empty() {\n339\t        return Err(IdentityError::EmptyField {\n340\t            field: \"workspace_id\",\n341\t        });\n342\t    }\n343\t    if branch.name.is_empty() {\n344\t        return Err(IdentityError::EmptyField { field: \"branch\" });\n345\t    }\n346\t    if session_id.value.is_empty() {\n347\t        return Err(IdentityError::EmptyField {\n348\t            field: \"session_id\",\n349\t        });\n350\t    }\n351\t    if let Some(task_id) = task_id {\n352\t        if task_id.value.is_empty() {\n353\t            return Err(IdentityError::EmptyField { field: \"task_id\" });\n354\t        }\n355\t    }\n356\t    Ok(())\n357\t}\n358\t\n359\tfn current_unix_micros() -> Result<i64, EventStoreError> {\n360\t    let duration = SystemTime::now()\n361\t        .duration_since(UNIX_EPOCH)\n362\t        .map_err(|error| EventStoreError::EnvelopeInvalid {\n363\t            reason: format!(\"system clock precedes Unix epoch: {error}\"),\n364\t        })?;\n365\t    i64::try_from(duration.as_micros()).map_err(|_| EventStoreError::EnvelopeInvalid {\n366\t        reason: \"current Unix timestamp exceeds i64 microsecond range\".to_string(),\n367\t    })\n368\t}\n369\t\n370\tfn default_flush_policy() -> FlushPolicy {\n371\t    if cfg!(test) {\n372\t        FlushPolicy::Sync\n373\t    } else {\n374\t        FlushPolicy::Batched { interval_ms: 50 }\n375\t    }\n376\t}\n377\t\n378\tfn next_ulid(ts_unix_micros: i64) -> String {\n379\t    let millis = ts_unix_micros.div_euclid(1_000) as u128;\n380\t    let sequence = u128::from(ULID_COUNTER.fetch_add(1, Ordering::SeqCst));\n381\t    encode_ulid((millis << 80) | sequence)\n382\t}\n383\t\n384\tfn encode_ulid(mut value: u128) -> String {\n385\t    let mut output = [b'0'; 26];\n386\t    for slot in (0..26).rev() {\n387\t        let index = (value & 0x1f) as usize;\n388\t        output[slot] = ULID_ALPHABET[index];\n389\t        value >>= 5;\n390\t    }\n391\t    String::from_utf8(output.to_vec()).expect(\"ULID alphabet is valid UTF-8\")\n392\t}\n393\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"65c799a7-2146-4ba3-aab3-d0746e66e89a","timestamp":"2026-05-17T05:58:06.768Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/writer.rs","content":"//! Public append-only writer for event envelopes.\n//!\n//! The writer defaults to a 4096-byte inline ceiling so hot-path workflow events\n//! stay in the main `events` table while larger payloads spill into\n//! `event_payloads` without bloating primary-row reads.\n\nuse std::collections::HashMap;\nuse std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::{Arc, Mutex};\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse serde_json::to_string;\nuse thiserror::Error;\nuse tracing::{debug, trace_span, warn};\n\nuse crate::events::kinds::EventKind;\nuse crate::events::store::MAX_EVENT_PAYLOAD_BYTES;\nuse crate::events::{\n    Actor, BranchRef, CompactSummary, EventPayload, EventStore, EventStoreError, InsertEnvelopeRow,\n    PayloadLocation, SessionId, StableRef, TaskId,\n};\nuse crate::identity::{EventId, WorkspaceId};\nuse crate::{DateTime, Utc};\n\nconst DEFAULT_INLINE_CEILING_BYTES: usize = 4096;\nconst EVENT_SCHEMA_VERSION: i64 = 1;\nconst ULID_ALPHABET: &[u8; 32] = b\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\nstatic ULID_COUNTER: AtomicU64 = AtomicU64::new(0);\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum FlushPolicy {\n    Sync,\n    Batched { interval_ms: u64 },\n}\n\n#[derive(Clone, Debug)]\npub struct PartialEnvelope {\n    pub workspace_id: Option<WorkspaceId>,\n    pub branch: BranchRef,\n    pub session_id: SessionId,\n    pub task_id: Option<TaskId>,\n    pub actor: Actor,\n    pub kind: EventKind,\n    pub references: Vec<StableRef>,\n    pub summary: CompactSummary,\n    pub payload: EventPayload,\n}\n\n#[derive(Debug, Error, PartialEq, Eq)]\npub enum IdentityError {\n    #[error(\"{field} must not be empty\")]\n    EmptyField { field: &'static str },\n}\n\n#[derive(Debug, Error)]\npub enum EventWriteError {\n    #[error(\"event workspace `{actual}` does not match writer workspace `{expected}`\")]\n    WorkspaceMismatch {\n        expected: WorkspaceId,\n        actual: WorkspaceId,\n    },\n    #[error(\"event payload is too large: {actual} bytes exceeds {ceiling} bytes\")]\n    PayloadTooLarge { ceiling: usize, actual: usize },\n    #[error(\"event store write failed: {0}\")]\n    Storage(#[from] EventStoreError),\n    #[error(\"event payload serialization failed: {0}\")]\n    Serde(#[from] serde_json::Error),\n    #[error(\"event identity is invalid: {0}\")]\n    Identity(#[from] IdentityError),\n}\n\npub struct EventWriter {\n    store: Arc<EventStore>,\n    workspace_id: WorkspaceId,\n    inline_ceiling_bytes: usize,\n    flush_policy: FlushPolicy,\n    monotonic_state: Mutex<MonotonicState>,\n    payload_spill_cache: Mutex<HashMap<crate::events::PayloadHash, i64>>,\n}\n\n#[derive(Default)]\nstruct MonotonicState {\n    last_session_micros: HashMap<String, i64>,\n}\n\nimpl EventWriter {\n    pub fn new(\n        store: Arc<EventStore>,\n        workspace_id: WorkspaceId,\n        inline_ceiling_bytes: usize,\n    ) -> Self {\n        Self {\n            store,\n            workspace_id,\n            inline_ceiling_bytes: if inline_ceiling_bytes == 0 {\n                DEFAULT_INLINE_CEILING_BYTES\n            } else {\n                inline_ceiling_bytes\n            },\n            flush_policy: default_flush_policy(),\n            monotonic_state: Mutex::new(MonotonicState::default()),\n            payload_spill_cache: Mutex::new(HashMap::new()),\n        }\n    }\n\n    pub fn with_flush_policy(mut self, flush_policy: FlushPolicy) -> Self {\n        self.flush_policy = flush_policy;\n        self\n    }\n\n    pub fn inline_ceiling_bytes(&self) -> usize {\n        self.inline_ceiling_bytes\n    }\n\n    pub fn workspace_id(&self) -> &WorkspaceId {\n        &self.workspace_id\n    }\n\n    pub fn append(&self, envelope: PartialEnvelope) -> Result<EventId, EventWriteError> {\n        self.append_with_flush_policy(envelope, self.flush_policy)\n    }\n\n    pub fn append_with_flush_policy(\n        &self,\n        envelope: PartialEnvelope,\n        flush_policy: FlushPolicy,\n    ) -> Result<EventId, EventWriteError> {\n        let _span = trace_span!(\"event_writer.append\", kind = envelope.kind.as_str()).entered();\n        let workspace_id = self.resolve_workspace(&envelope.workspace_id)?;\n        let payload_bytes = serde_json::to_vec(&envelope.payload)?;\n        if payload_bytes.len() > MAX_EVENT_PAYLOAD_BYTES {\n            return Err(EventWriteError::PayloadTooLarge {\n                ceiling: MAX_EVENT_PAYLOAD_BYTES,\n                actual: payload_bytes.len(),\n            });\n        }\n\n        let payload_hash = crate::events::hash_canonical_payload_bytes(&payload_bytes);\n        let (timestamp, ts_unix_micros) = self.next_timestamp(&envelope.session_id)?;\n        let event_id = EventId {\n            workspace_id: workspace_id.clone(),\n            ulid: next_ulid(ts_unix_micros),\n        };\n        let payload_location =\n            self.persist_payload(&payload_hash, &payload_bytes, ts_unix_micros)?;\n        let row = build_insert_row(\n            &event_id,\n            &workspace_id,\n            &envelope,\n            payload_hash.as_bytes().to_vec(),\n            payload_location,\n            payload_bytes,\n            ts_unix_micros,\n        )?;\n\n        self.store.insert_envelope_row_cached(&row)?;\n        self.flush_if_needed(flush_policy)?;\n        let _ = timestamp;\n        Ok(event_id)\n    }\n\n    fn resolve_workspace(\n        &self,\n        workspace_id: &Option<WorkspaceId>,\n    ) -> Result<WorkspaceId, EventWriteError> {\n        match workspace_id {\n            Some(value) if value != &self.workspace_id => {\n                warn!(\n                    writer_workspace_id = self.workspace_id.as_str(),\n                    event_workspace_id = value.as_str(),\n                    \"event writer rejected workspace mismatch\"\n                );\n                Err(EventWriteError::WorkspaceMismatch {\n                    expected: self.workspace_id.clone(),\n                    actual: value.clone(),\n                })\n            }\n            Some(value) => Ok(value.clone()),\n            None => Ok(self.workspace_id.clone()),\n        }\n    }\n\n    fn next_timestamp(\n        &self,\n        session_id: &SessionId,\n    ) -> Result<(DateTime<Utc>, i64), EventWriteError> {\n        if session_id.value.is_empty() {\n            return Err(IdentityError::EmptyField {\n                field: \"session_id\",\n            }\n            .into());\n        }\n\n        let mut state =\n            self.monotonic_state\n                .lock()\n                .map_err(|_| EventStoreError::EnvelopeInvalid {\n                    reason: \"event writer monotonic state lock was poisoned\".to_string(),\n                })?;\n        let now_micros = current_unix_micros()?;\n        let entry = state\n            .last_session_micros\n            .entry(session_id.value.clone())\n            .or_insert(now_micros);\n        let next_micros = if now_micros > *entry {\n            now_micros\n        } else {\n            *entry + 1\n        };\n        *entry = next_micros;\n        Ok((\n            DateTime::from_unix_seconds(next_micros / 1_000_000),\n            next_micros,\n        ))\n    }\n\n    fn persist_payload(\n        &self,\n        payload_hash: &crate::events::PayloadHash,\n        payload_bytes: &[u8],\n        ts_unix_micros: i64,\n    ) -> Result<PayloadLocation, EventWriteError> {\n        if payload_bytes.len() <= self.inline_ceiling_bytes {\n            let bytes_len = u32::try_from(payload_bytes.len()).map_err(|_| {\n                EventWriteError::PayloadTooLarge {\n                    ceiling: u32::MAX as usize,\n                    actual: payload_bytes.len(),\n                }\n            })?;\n            return Ok(PayloadLocation::Inline { bytes_len });\n        }\n\n        if let Some(row_id) = self.cached_payload_row_id(payload_hash)? {\n            return Ok(PayloadLocation::Spilled { row_id });\n        }\n\n        let row_id = self.store.insert_or_get_payload(\n            payload_hash.as_bytes(),\n            payload_bytes,\n            ts_unix_micros,\n        )?;\n        self.payload_spill_cache\n            .lock()\n            .map_err(|_| EventStoreError::EnvelopeInvalid {\n                reason: \"event writer payload cache lock was poisoned\".to_string(),\n            })?\n            .insert(*payload_hash, row_id);\n        debug!(\n            bytes_len = payload_bytes.len(),\n            inline_ceiling_bytes = self.inline_ceiling_bytes,\n            payload_row_id = row_id,\n            \"event payload spilled to side table\"\n        );\n        Ok(PayloadLocation::Spilled { row_id })\n    }\n\n    fn cached_payload_row_id(\n        &self,\n        payload_hash: &crate::events::PayloadHash,\n    ) -> Result<Option<i64>, EventWriteError> {\n        Ok(self\n            .payload_spill_cache\n            .lock()\n            .map_err(|_| EventStoreError::EnvelopeInvalid {\n                reason: \"event writer payload cache lock was poisoned\".to_string(),\n            })?\n            .get(payload_hash)\n            .copied())\n    }\n\n    fn flush_if_needed(&self, flush_policy: FlushPolicy) -> Result<(), EventWriteError> {\n        match flush_policy {\n            FlushPolicy::Sync => self.store.checkpoint_wal().map_err(EventWriteError::from),\n            FlushPolicy::Batched { interval_ms: _ } => Ok(()),\n        }\n    }\n}\n\nfn build_insert_row(\n    event_id: &EventId,\n    workspace_id: &str,\n    envelope: &PartialEnvelope,\n    payload_hash: Vec<u8>,\n    payload_location: PayloadLocation,\n    payload_bytes: Vec<u8>,\n    ts_unix_micros: i64,\n) -> Result<InsertEnvelopeRow, EventWriteError> {\n    let (actor_kind, actor_detail) = actor_parts(&envelope.actor);\n    validate_identity_fields(\n        workspace_id,\n        &envelope.branch,\n        &envelope.session_id,\n        &envelope.task_id,\n    )?;\n    let references_json = to_string(&envelope.references)?;\n    let (payload_inline, payload_spill_id) = match payload_location {\n        PayloadLocation::Inline { .. } => (Some(payload_bytes), None),\n        PayloadLocation::Spilled { row_id } => (None, Some(row_id)),\n    };\n\n    Ok(InsertEnvelopeRow {\n        event_uuid: event_id.ulid.clone(),\n        workspace_id: workspace_id.to_string(),\n        branch: envelope.branch.name.clone(),\n        session_id: envelope.session_id.value.clone(),\n        task_id: envelope\n            .task_id\n            .as_ref()\n            .map(|task_id| task_id.value.clone()),\n        actor_kind,\n        actor_detail,\n        kind: envelope.kind.as_str().to_string(),\n        ts_unix_micros,\n        payload_hash,\n        summary: envelope.summary.as_str().to_string(),\n        payload_inline,\n        payload_spill_id,\n        references_json,\n        schema_version: EVENT_SCHEMA_VERSION,\n    })\n}\n\nfn actor_parts(actor: &Actor) -> (String, Option<String>) {\n    match actor {\n        Actor::Assistant { model } => (\"assistant\".to_string(), Some(model.clone())),\n        Actor::User => (\"user\".to_string(), None),\n        Actor::Tool { name } => (\"tool\".to_string(), Some(name.clone())),\n        Actor::Daemon => (\"daemon\".to_string(), None),\n    }\n}\n\nfn validate_identity_fields(\n    workspace_id: &str,\n    branch: &BranchRef,\n    session_id: &SessionId,\n    task_id: &Option<TaskId>,\n) -> Result<(), IdentityError> {\n    if workspace_id.is_empty() {\n        return Err(IdentityError::EmptyField {\n            field: \"workspace_id\",\n        });\n    }\n    if branch.name.is_empty() {\n        return Err(IdentityError::EmptyField { field: \"branch\" });\n    }\n    if session_id.value.is_empty() {\n        return Err(IdentityError::EmptyField {\n            field: \"session_id\",\n        });\n    }\n    if let Some(task_id) = task_id {\n        if task_id.value.is_empty() {\n            return Err(IdentityError::EmptyField { field: \"task_id\" });\n        }\n    }\n    Ok(())\n}\n\nfn current_unix_micros() -> Result<i64, EventStoreError> {\n    let duration = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .map_err(|error| EventStoreError::EnvelopeInvalid {\n            reason: format!(\"system clock precedes Unix epoch: {error}\"),\n        })?;\n    i64::try_from(duration.as_micros()).map_err(|_| EventStoreError::EnvelopeInvalid {\n        reason: \"current Unix timestamp exceeds i64 microsecond range\".to_string(),\n    })\n}\n\nfn default_flush_policy() -> FlushPolicy {\n    if cfg!(test) {\n        FlushPolicy::Sync\n    } else {\n        FlushPolicy::Batched { interval_ms: 50 }\n    }\n}\n\nfn next_ulid(ts_unix_micros: i64) -> String {\n    let millis = ts_unix_micros.div_euclid(1_000) as u128;\n    let sequence = u128::from(ULID_COUNTER.fetch_add(1, Ordering::SeqCst));\n    encode_ulid((millis << 80) | sequence)\n}\n\nfn encode_ulid(mut value: u128) -> String {\n    let mut output = [b'0'; 26];\n    for slot in (0..26).rev() {\n        let index = (value & 0x1f) as usize;\n        output[slot] = ULID_ALPHABET[index];\n        value >>= 5;\n    }\n    String::from_utf8(output.to_vec()).expect(\"ULID alphabet is valid UTF-8\")\n}\n","numLines":393,"startLine":1,"totalLines":393}}}
