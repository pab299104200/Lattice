{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013kck8Pg72jc77imnTRoWsN","type":"tool_result","content":"1\t//! Daemon-managed event-log compaction and snapshot bootstrap.\n2\t//!\n3\t//! Schedule, retention, bootstrap, and observability semantics are documented in\n4\t//! `docs/architecture/2026-05-16-event-log-compaction.md`\n5\t//! `## Compaction schedule`, `## Bootstrap procedure`, and `## Observability`.\n6\t\n7\tuse std::collections::HashSet;\n8\tuse std::path::{Path, PathBuf};\n9\tuse std::sync::atomic::{AtomicBool, Ordering};\n10\tuse std::sync::{Arc, Mutex};\n11\tuse std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};\n12\t\n13\tuse thiserror::Error;\n14\tuse tokio::sync::oneshot;\n15\tuse tokio::task::JoinHandle;\n16\tuse tracing::{error, info, info_span, warn};\n17\t\n18\tuse crate::events::{\n19\t    Actor, BranchRef, CompactSummary, EventPayload, EventStore, EventStoreError, EventWriter,\n20\t    MemoryConsolidatedPayload, PartialEnvelope, SessionId, Snapshot, SnapshotError,\n21\t};\n22\tuse crate::graph::CodeGraph;\n23\tuse crate::identity::{EventId, MemoryId};\n24\tuse crate::memory::MemoryStore;\n25\t\n26\tpub type GraphHandle = Mutex<CodeGraph>;\n27\tpub type MemoryHandle = Mutex<MemoryStore>;\n28\t\n29\t#[derive(Clone, Debug)]\n30\tpub struct CompactionConfig {\n31\t    pub interval: Duration,\n32\t    pub min_events_since_last: u64,\n33\t    pub snapshot_dir: PathBuf,\n34\t    pub retain_snapshots: usize,\n35\t}\n36\t\n37\t#[derive(Clone, Debug, PartialEq, Eq)]\n38\tpub struct CompactionReport {\n39\t    pub snapshot_path: Option<PathBuf>,\n40\t    pub bytes_written: u64,\n41\t    pub events_truncated: u64,\n42\t    pub duration: Duration,\n43\t    pub skipped: bool,\n44\t}\n45\t\n46\tpub struct Compactor {\n47\t    pub store: Arc<EventStore>,\n48\t    pub writer: Arc<EventWriter>,\n49\t    pub graph: Arc<GraphHandle>,\n50\t    pub memory: Arc<MemoryHandle>,\n51\t    pub config: CompactionConfig,\n52\t    lock: Arc<AtomicBool>,\n53\t}\n54\t\n55\tpub struct SchedulerHandle {\n56\t    shutdown: Option<oneshot::Sender<()>>,\n57\t    task: JoinHandle<()>,\n58\t}\n59\t\n60\t#[derive(Clone, Debug, PartialEq)]\n61\tpub struct BootstrappedState {\n62\t    pub snapshot: Snapshot,\n63\t    pub replayed_event_rows: usize,\n64\t}\n65\t\n66\tpub struct Bootstrap;\n67\t\n68\t#[derive(Debug, Error)]\n69\tpub enum CompactionError {\n70\t    #[error(\"event compaction is already running\")]\n71\t    LockHeld,\n72\t    #[error(\"snapshot failed: {0}\")]\n73\t    SnapshotFailed(#[from] SnapshotError),\n74\t    #[error(\"event truncation failed: {0}\")]\n75\t    TruncateFailed(#[from] EventStoreError),\n76\t    #[error(\"snapshot verification failed: {0}\")]\n77\t    VerifyFailed(String),\n78\t    #[error(\"event write failed: {0}\")]\n79\t    EventWriteFailed(String),\n80\t}\n81\t\n82\t#[derive(Debug, Error)]\n83\tpub enum BootstrapError {\n84\t    #[error(\"snapshot is missing at {path}\")]\n85\t    SnapshotMissing { path: PathBuf },\n86\t    #[error(\"snapshot format version {found} is unsupported; max supported is {max}\")]\n87\t    FormatVersionUnsupported { found: u16, max: u16 },\n88\t    #[error(\"snapshot content hash mismatch at {path}\")]\n89\t    ContentHashMismatch { path: PathBuf },\n90\t    #[error(\"post-snapshot event {event_id} references missing state `{missing_ref}`\")]\n91\t    ReferenceUnresolved { event_id: i64, missing_ref: String },\n92\t    #[error(\"snapshot load failed: {0}\")]\n93\t    Snapshot(#[from] SnapshotError),\n94\t    #[error(\"event replay failed: {0}\")]\n95\t    EventStore(#[from] EventStoreError),\n96\t}\n97\t\n98\timpl CompactionConfig {\n99\t    pub fn new(snapshot_dir: PathBuf) -> Self {\n100\t        Self {\n101\t            interval: Duration::from_secs(900),\n102\t            min_events_since_last: 1_000,\n103\t            snapshot_dir,\n104\t            retain_snapshots: 5,\n105\t        }\n106\t    }\n107\t}\n108\t\n109\timpl Compactor {\n110\t    pub fn new(\n111\t        store: Arc<EventStore>,\n112\t        writer: Arc<EventWriter>,\n113\t        graph: Arc<GraphHandle>,\n114\t        memory: Arc<MemoryHandle>,\n115\t        config: CompactionConfig,\n116\t    ) -> Self {\n117\t        Self {\n118\t            store,\n119\t            writer,\n120\t            graph,\n121\t            memory,\n122\t            config,\n123\t            lock: Arc::new(AtomicBool::new(false)),\n124\t        }\n125\t    }\n126\t\n127\t    pub fn run_once(&self) -> Result<CompactionReport, CompactionError> {\n128\t        let guard = self.acquire_lock()?;\n129\t        let _guard = guard;\n130\t        let started = Instant::now();\n131\t        let _span = info_span!(\"compaction\", interval = ?self.config.interval).entered();\n132\t        let latest = match self.store.latest_cursor()? {\n133\t            Some(cursor) => cursor,\n134\t            None => return Ok(skipped_report(started)),\n135\t        };\n136\t        let last_snapshot = latest_snapshot(&self.config.snapshot_dir)?;\n137\t        let baseline = last_snapshot\n138\t            .as_ref()\n139\t            .map_or(0, |snapshot| snapshot.up_to_event_id);\n140\t        let events_since_last = self.store.compactable_event_count_after(baseline)?;\n141\t        if events_since_last < self.config.min_events_since_last {\n142\t            return Ok(skipped_report(started));\n143\t        }\n144\t\n145\t        let snapshot_path = snapshot_path(&self.config.snapshot_dir, latest.row_id);\n146\t        let handle = {\n147\t            let graph = self.graph.lock().map_err(lock_error)?;\n148\t            let memory = self.memory.lock().map_err(lock_error)?;\n149\t            Snapshot::write(&snapshot_path, &graph, &memory, latest.row_id)?\n150\t        };\n151\t        let verified = Snapshot::read(&handle.path)?;\n152\t        if verified.up_to_event_id != latest.row_id {\n153\t            return Err(CompactionError::VerifyFailed(\n154\t                \"snapshot cursor changed during verification\".to_string(),\n155\t            ));\n156\t        }\n157\t\n158\t        let events_truncated = self.store.truncate_through(latest.row_id)?;\n159\t        self.emit_snapshot_event(&verified, &latest)?;\n160\t        self.rotate_snapshots()?;\n161\t        info!(\n162\t            snapshot_path = %handle.path.display(),\n163\t            bytes_written = handle.bytes_written,\n164\t            events_truncated,\n165\t            \"event log compaction completed\"\n166\t        );\n167\t        Ok(CompactionReport {\n168\t            snapshot_path: Some(handle.path),\n169\t            bytes_written: handle.bytes_written,\n170\t            events_truncated,\n171\t            duration: started.elapsed(),\n172\t            skipped: false,\n173\t        })\n174\t    }\n175\t\n176\t    pub fn spawn_scheduler(self) -> SchedulerHandle {\n177\t        let (shutdown_tx, mut shutdown_rx) = oneshot::channel();\n178\t        let task = tokio::spawn(async move {\n179\t            let mut interval = tokio::time::interval(self.config.interval);\n180\t            loop {\n181\t                tokio::select! {\n182\t                    _ = interval.tick() => {\n183\t                        if let Err(err) = self.run_once() {\n184\t                            error!(error = %err, \"event log compaction failed\");\n185\t                        }\n186\t                    }\n187\t                    _ = &mut shutdown_rx => {\n188\t                        info!(\"event log compaction scheduler shutting down\");\n189\t                        break;\n190\t                    }\n191\t                }\n192\t            }\n193\t        });\n194\t        SchedulerHandle {\n195\t            shutdown: Some(shutdown_tx),\n196\t            task,\n197\t        }\n198\t    }\n199\t\n200\t    fn acquire_lock(&self) -> Result<CompactionLock, CompactionError> {\n201\t        if self.lock.swap(true, Ordering::Acquire) {\n202\t            return Err(CompactionError::LockHeld);\n203\t        }\n204\t        Ok(CompactionLock {\n205\t            lock: Arc::clone(&self.lock),\n206\t        })\n207\t    }\n208\t\n209\t    fn emit_snapshot_event(\n210\t        &self,\n211\t        snapshot: &Snapshot,\n212\t        latest: &crate::events::EventCursor,\n213\t    ) -> Result<(), CompactionError> {\n214\t        let summary = CompactSummary::new(format!(\n215\t            \"event log snapshot: up_to_event_row={} graph_nodes={} memories={}\",\n216\t            snapshot.up_to_event_id,\n217\t            snapshot.graph_state.nodes.len(),\n218\t            snapshot.memory_state.memories.len()\n219\t        ))\n220\t        .map_err(|err| CompactionError::EventWriteFailed(err.to_string()))?;\n221\t        let payload = EventPayload::MemoryConsolidated(MemoryConsolidatedPayload {\n222\t            source_memory_ids: Vec::new(),\n223\t            consolidated_memory_id: MemoryId {\n224\t                workspace_id: latest.workspace_id.clone(),\n225\t                ulid: format!(\"snapshot-{}\", snapshot.up_to_event_id),\n226\t            },\n227\t            source_event_ids: vec![EventId {\n228\t                workspace_id: latest.workspace_id.clone(),\n229\t                ulid: latest.event_uuid.clone(),\n230\t            }],\n231\t            consolidation_summary: \"event log snapshot compaction marker\".to_string(),\n232\t        });\n233\t        self.writer\n234\t            .append(PartialEnvelope {\n235\t                workspace_id: Some(latest.workspace_id.clone()),\n236\t                branch: BranchRef {\n237\t                    name: latest.branch.clone(),\n238\t                },\n239\t                session_id: SessionId {\n240\t                    value: \"daemon-compaction\".to_string(),\n241\t                },\n242\t                task_id: None,\n243\t                actor: Actor::Daemon,\n244\t                kind: payload.kind(),\n245\t                references: Vec::new(),\n246\t                summary,\n247\t                payload,\n248\t            })\n249\t            .map_err(|err| CompactionError::EventWriteFailed(err.to_string()))?;\n250\t        Ok(())\n251\t    }\n252\t\n253\t    fn rotate_snapshots(&self) -> Result<(), CompactionError> {\n254\t        let retain = self.config.retain_snapshots.max(1);\n255\t        let mut snapshots = snapshot_files(&self.config.snapshot_dir)?;\n256\t        snapshots.sort_by(|left, right| right.cmp(left));\n257\t        for stale in snapshots.into_iter().skip(retain) {\n258\t            match std::fs::remove_file(&stale) {\n259\t                Ok(()) => {\n260\t                    warn!(snapshot_path = %stale.display(), \"removed old compaction snapshot\")\n261\t                }\n262\t                Err(err) => warn!(\n263\t                    snapshot_path = %stale.display(),\n264\t                    error = %err,\n265\t                    \"failed to remove old compaction snapshot\"\n266\t                ),\n267\t            }\n268\t        }\n269\t        Ok(())\n270\t    }\n271\t}\n272\t\n273\timpl SchedulerHandle {\n274\t    pub async fn shutdown(mut self) {\n275\t        if let Some(shutdown) = self.shutdown.take() {\n276\t            let _ = shutdown.send(());\n277\t        }\n278\t        if let Err(err) = self.task.await {\n279\t            warn!(error = %err, \"event log compaction scheduler join failed\");\n280\t        }\n281\t    }\n282\t}\n283\t\n284\timpl Bootstrap {\n285\t    pub fn load(\n286\t        snapshot_path: &Path,\n287\t        event_store: &EventStore,\n288\t    ) -> Result<BootstrappedState, BootstrapError> {\n289\t        if !snapshot_path.exists() {\n290\t            return Err(BootstrapError::SnapshotMissing {\n291\t                path: snapshot_path.to_path_buf(),\n292\t            });\n293\t        }\n294\t        let Some(snapshot) = newest_valid_snapshot(snapshot_path)? else {\n295\t            return Err(BootstrapError::ContentHashMismatch {\n296\t                path: snapshot_path.to_path_buf(),\n297\t            });\n298\t        };\n299\t        let rows = event_store.query_events_after_row_id(snapshot.up_to_event_id, 10_000)?;\n300\t        validate_tail_references(&snapshot, &rows)?;\n301\t        Ok(BootstrappedState {\n302\t            snapshot,\n303\t            replayed_event_rows: rows.len(),\n304\t        })\n305\t    }\n306\t}\n307\t\n308\tstruct CompactionLock {\n309\t    lock: Arc<AtomicBool>,\n310\t}\n311\t\n312\timpl Drop for CompactionLock {\n313\t    fn drop(&mut self) {\n314\t        self.lock.store(false, Ordering::Release);\n315\t    }\n316\t}\n317\t\n318\tfn skipped_report(started: Instant) -> CompactionReport {\n319\t    CompactionReport {\n320\t        snapshot_path: None,\n321\t        bytes_written: 0,\n322\t        events_truncated: 0,\n323\t        duration: started.elapsed(),\n324\t        skipped: true,\n325\t    }\n326\t}\n327\t\n328\tfn latest_snapshot(snapshot_dir: &Path) -> Result<Option<Snapshot>, SnapshotError> {\n329\t    let Some(path) = snapshot_files(snapshot_dir)?.into_iter().max() else {\n330\t        return Ok(None);\n331\t    };\n332\t    Snapshot::read(&path).map(Some)\n333\t}\n334\t\n335\tfn newest_valid_snapshot(requested_path: &Path) -> Result<Option<Snapshot>, BootstrapError> {\n336\t    let requested = requested_path.to_path_buf();\n337\t    let mut candidates = vec![requested.clone()];\n338\t    if let Some(parent) = requested.parent() {\n339\t        let mut siblings = snapshot_files(parent).map_err(BootstrapError::Snapshot)?;\n340\t        siblings.sort_by(|left, right| right.cmp(left));\n341\t        candidates.extend(siblings.into_iter().filter(|path| path != &requested));\n342\t    }\n343\t\n344\t    let mut saw_corruption = false;\n345\t    for candidate in candidates {\n346\t        match load_snapshot_candidate(&candidate) {\n347\t            Ok(snapshot) => return Ok(Some(snapshot)),\n348\t            Err(BootstrapError::ContentHashMismatch { .. }) => {\n349\t                saw_corruption = true;\n350\t            }\n351\t            Err(error) => return Err(error),\n352\t        }\n353\t    }\n354\t    if saw_corruption {\n355\t        return Ok(None);\n356\t    }\n357\t    Err(BootstrapError::SnapshotMissing {\n358\t        path: requested_path.to_path_buf(),\n359\t    })\n360\t}\n361\t\n362\tfn load_snapshot_candidate(path: &Path) -> Result<Snapshot, BootstrapError> {\n363\t    let header = Snapshot::read_header(path).map_err(|error| map_snapshot_error(path, error))?;\n364\t    if header.format_version > crate::events::snapshot::SNAPSHOT_FORMAT_VERSION {\n365\t        return Err(BootstrapError::FormatVersionUnsupported {\n366\t            found: header.format_version,\n367\t            max: crate::events::snapshot::SNAPSHOT_FORMAT_VERSION,\n368\t        });\n369\t    }\n370\t    Snapshot::read(path).map_err(|error| map_snapshot_error(path, error))\n371\t}\n372\t\n373\tfn map_snapshot_error(path: &Path, error: SnapshotError) -> BootstrapError {\n374\t    match error {\n375\t        SnapshotError::ContentHashMismatch => BootstrapError::ContentHashMismatch {\n376\t            path: path.to_path_buf(),\n377\t        },\n378\t        other => BootstrapError::Snapshot(other),\n379\t    }\n380\t}\n381\t\n382\tfn snapshot_files(snapshot_dir: &Path) -> Result<Vec<PathBuf>, SnapshotError> {\n383\t    if !snapshot_dir.exists() {\n384\t        return Ok(Vec::new());\n385\t    }\n386\t    let entries = std::fs::read_dir(snapshot_dir).map_err(|source| SnapshotError::IoFailed {\n387\t        path: snapshot_dir.to_path_buf(),\n388\t        source,\n389\t    })?;\n390\t    let mut files = Vec::new();\n391\t    for entry in entries {\n392\t        let path = entry\n393\t            .map_err(|source| SnapshotError::IoFailed {\n394\t                path: snapshot_dir.to_path_buf(),\n395\t                source,\n396\t            })?\n397\t            .path();\n398\t        if is_snapshot_file(&path) {\n399\t            files.push(path);\n400\t        }\n401\t    }\n402\t    Ok(files)\n403\t}\n404\t\n405\tfn is_snapshot_file(path: &Path) -> bool {\n406\t    path.file_name()\n407\t        .and_then(|name| name.to_str())\n408\t        .is_some_and(|name| name.starts_with(\"snapshot-\") && name.ends_with(\".bin\"))\n409\t}\n410\t\n411\tfn snapshot_path(snapshot_dir: &Path, event_row_id: i64) -> PathBuf {\n412\t    let micros = SystemTime::now()\n413\t        .duration_since(UNIX_EPOCH)\n414\t        .unwrap_or_default()\n415\t        .as_micros();\n416\t    snapshot_dir.join(format!(\"snapshot-{event_row_id}-{micros}.bin\"))\n417\t}\n418\t\n419\tfn validate_tail_references(\n420\t    snapshot: &Snapshot,\n421\t    rows: &[crate::events::EventEnvelopeRow],\n422\t) -> Result<(), BootstrapError> {\n423\t    let mut memory_ids: HashSet<String> = snapshot\n424\t        .memory_state\n425\t        .memories\n426\t        .iter()\n427\t        .map(|entry| entry.memory.id.clone())\n428\t        .collect();\n429\t    let symbol_ids: HashSet<String> = snapshot\n430\t        .graph_state\n431\t        .nodes\n432\t        .iter()\n433\t        .map(|node| format!(\"{}:{}\", node.id.file, node.id.name))\n434\t        .collect();\n435\t    for row in rows {\n436\t        validate_row_references(row, &memory_ids, &symbol_ids)?;\n437\t        collect_created_memory_ids(row, &mut memory_ids);\n438\t    }\n439\t    Ok(())\n440\t}\n441\t\n442\tfn validate_row_references(\n443\t    row: &crate::events::EventEnvelopeRow,\n444\t    memory_ids: &HashSet<String>,\n445\t    symbol_ids: &HashSet<String>,\n446\t) -> Result<(), BootstrapError> {\n447\t    let refs: Vec<crate::events::StableRef> =\n448\t        serde_json::from_str(&row.references_json).unwrap_or_default();\n449\t    for reference in refs {\n450\t        match reference {\n451\t            crate::events::StableRef::MemoryRef(memory_id) => {\n452\t                let id = memory_id.ulid;\n453\t                if !memory_ids.contains(&id) {\n454\t                    return unresolved(row.event_id, id);\n455\t                }\n456\t            }\n457\t            crate::events::StableRef::SymbolRef(symbol_id) => {\n458\t                let id = format!(\n459\t                    \"{}:{}\",\n460\t                    symbol_id.file.repo_relative_path, symbol_id.qualified_name\n461\t                );\n462\t                if !symbol_ids.contains(&id) {\n463\t                    return unresolved(row.event_id, id);\n464\t                }\n465\t            }\n466\t            _ => {}\n467\t        }\n468\t    }\n469\t    Ok(())\n470\t}\n471\t\n472\tfn collect_created_memory_ids(\n473\t    row: &crate::events::EventEnvelopeRow,\n474\t    memory_ids: &mut HashSet<String>,\n475\t) {\n476\t    if row.kind != \"memory_created\" {\n477\t        return;\n478\t    }\n479\t    let Some(bytes) = &row.payload_inline else {\n480\t        return;\n481\t    };\n482\t    if let Ok(EventPayload::MemoryCreated(payload)) = serde_json::from_slice::<EventPayload>(bytes)\n483\t    {\n484\t        memory_ids.insert(payload.memory_id.ulid);\n485\t    }\n486\t}\n487\t\n488\tfn unresolved<T>(event_id: i64, missing_ref: String) -> Result<T, BootstrapError> {\n489\t    Err(BootstrapError::ReferenceUnresolved {\n490\t        event_id,\n491\t        missing_ref,\n492\t    })\n493\t}\n494\t\n495\tfn lock_error<T>(_: std::sync::PoisonError<T>) -> CompactionError {\n496\t    CompactionError::VerifyFailed(\"snapshot source lock was poisoned\".to_string())\n497\t}\n498\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"bed9fa25-2b4b-4cc3-927b-038551c8266f","timestamp":"2026-05-17T05:59:34.340Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/compaction.rs","content":"//! Daemon-managed event-log compaction and snapshot bootstrap.\n//!\n//! Schedule, retention, bootstrap, and observability semantics are documented in\n//! `docs/architecture/2026-05-16-event-log-compaction.md`\n//! `## Compaction schedule`, `## Bootstrap procedure`, and `## Observability`.\n\nuse std::collections::HashSet;\nuse std::path::{Path, PathBuf};\nuse std::sync::atomic::{AtomicBool, Ordering};\nuse std::sync::{Arc, Mutex};\nuse std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};\n\nuse thiserror::Error;\nuse tokio::sync::oneshot;\nuse tokio::task::JoinHandle;\nuse tracing::{error, info, info_span, warn};\n\nuse crate::events::{\n    Actor, BranchRef, CompactSummary, EventPayload, EventStore, EventStoreError, EventWriter,\n    MemoryConsolidatedPayload, PartialEnvelope, SessionId, Snapshot, SnapshotError,\n};\nuse crate::graph::CodeGraph;\nuse crate::identity::{EventId, MemoryId};\nuse crate::memory::MemoryStore;\n\npub type GraphHandle = Mutex<CodeGraph>;\npub type MemoryHandle = Mutex<MemoryStore>;\n\n#[derive(Clone, Debug)]\npub struct CompactionConfig {\n    pub interval: Duration,\n    pub min_events_since_last: u64,\n    pub snapshot_dir: PathBuf,\n    pub retain_snapshots: usize,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct CompactionReport {\n    pub snapshot_path: Option<PathBuf>,\n    pub bytes_written: u64,\n    pub events_truncated: u64,\n    pub duration: Duration,\n    pub skipped: bool,\n}\n\npub struct Compactor {\n    pub store: Arc<EventStore>,\n    pub writer: Arc<EventWriter>,\n    pub graph: Arc<GraphHandle>,\n    pub memory: Arc<MemoryHandle>,\n    pub config: CompactionConfig,\n    lock: Arc<AtomicBool>,\n}\n\npub struct SchedulerHandle {\n    shutdown: Option<oneshot::Sender<()>>,\n    task: JoinHandle<()>,\n}\n\n#[derive(Clone, Debug, PartialEq)]\npub struct BootstrappedState {\n    pub snapshot: Snapshot,\n    pub replayed_event_rows: usize,\n}\n\npub struct Bootstrap;\n\n#[derive(Debug, Error)]\npub enum CompactionError {\n    #[error(\"event compaction is already running\")]\n    LockHeld,\n    #[error(\"snapshot failed: {0}\")]\n    SnapshotFailed(#[from] SnapshotError),\n    #[error(\"event truncation failed: {0}\")]\n    TruncateFailed(#[from] EventStoreError),\n    #[error(\"snapshot verification failed: {0}\")]\n    VerifyFailed(String),\n    #[error(\"event write failed: {0}\")]\n    EventWriteFailed(String),\n}\n\n#[derive(Debug, Error)]\npub enum BootstrapError {\n    #[error(\"snapshot is missing at {path}\")]\n    SnapshotMissing { path: PathBuf },\n    #[error(\"snapshot format version {found} is unsupported; max supported is {max}\")]\n    FormatVersionUnsupported { found: u16, max: u16 },\n    #[error(\"snapshot content hash mismatch at {path}\")]\n    ContentHashMismatch { path: PathBuf },\n    #[error(\"post-snapshot event {event_id} references missing state `{missing_ref}`\")]\n    ReferenceUnresolved { event_id: i64, missing_ref: String },\n    #[error(\"snapshot load failed: {0}\")]\n    Snapshot(#[from] SnapshotError),\n    #[error(\"event replay failed: {0}\")]\n    EventStore(#[from] EventStoreError),\n}\n\nimpl CompactionConfig {\n    pub fn new(snapshot_dir: PathBuf) -> Self {\n        Self {\n            interval: Duration::from_secs(900),\n            min_events_since_last: 1_000,\n            snapshot_dir,\n            retain_snapshots: 5,\n        }\n    }\n}\n\nimpl Compactor {\n    pub fn new(\n        store: Arc<EventStore>,\n        writer: Arc<EventWriter>,\n        graph: Arc<GraphHandle>,\n        memory: Arc<MemoryHandle>,\n        config: CompactionConfig,\n    ) -> Self {\n        Self {\n            store,\n            writer,\n            graph,\n            memory,\n            config,\n            lock: Arc::new(AtomicBool::new(false)),\n        }\n    }\n\n    pub fn run_once(&self) -> Result<CompactionReport, CompactionError> {\n        let guard = self.acquire_lock()?;\n        let _guard = guard;\n        let started = Instant::now();\n        let _span = info_span!(\"compaction\", interval = ?self.config.interval).entered();\n        let latest = match self.store.latest_cursor()? {\n            Some(cursor) => cursor,\n            None => return Ok(skipped_report(started)),\n        };\n        let last_snapshot = latest_snapshot(&self.config.snapshot_dir)?;\n        let baseline = last_snapshot\n            .as_ref()\n            .map_or(0, |snapshot| snapshot.up_to_event_id);\n        let events_since_last = self.store.compactable_event_count_after(baseline)?;\n        if events_since_last < self.config.min_events_since_last {\n            return Ok(skipped_report(started));\n        }\n\n        let snapshot_path = snapshot_path(&self.config.snapshot_dir, latest.row_id);\n        let handle = {\n            let graph = self.graph.lock().map_err(lock_error)?;\n            let memory = self.memory.lock().map_err(lock_error)?;\n            Snapshot::write(&snapshot_path, &graph, &memory, latest.row_id)?\n        };\n        let verified = Snapshot::read(&handle.path)?;\n        if verified.up_to_event_id != latest.row_id {\n            return Err(CompactionError::VerifyFailed(\n                \"snapshot cursor changed during verification\".to_string(),\n            ));\n        }\n\n        let events_truncated = self.store.truncate_through(latest.row_id)?;\n        self.emit_snapshot_event(&verified, &latest)?;\n        self.rotate_snapshots()?;\n        info!(\n            snapshot_path = %handle.path.display(),\n            bytes_written = handle.bytes_written,\n            events_truncated,\n            \"event log compaction completed\"\n        );\n        Ok(CompactionReport {\n            snapshot_path: Some(handle.path),\n            bytes_written: handle.bytes_written,\n            events_truncated,\n            duration: started.elapsed(),\n            skipped: false,\n        })\n    }\n\n    pub fn spawn_scheduler(self) -> SchedulerHandle {\n        let (shutdown_tx, mut shutdown_rx) = oneshot::channel();\n        let task = tokio::spawn(async move {\n            let mut interval = tokio::time::interval(self.config.interval);\n            loop {\n                tokio::select! {\n                    _ = interval.tick() => {\n                        if let Err(err) = self.run_once() {\n                            error!(error = %err, \"event log compaction failed\");\n                        }\n                    }\n                    _ = &mut shutdown_rx => {\n                        info!(\"event log compaction scheduler shutting down\");\n                        break;\n                    }\n                }\n            }\n        });\n        SchedulerHandle {\n            shutdown: Some(shutdown_tx),\n            task,\n        }\n    }\n\n    fn acquire_lock(&self) -> Result<CompactionLock, CompactionError> {\n        if self.lock.swap(true, Ordering::Acquire) {\n            return Err(CompactionError::LockHeld);\n        }\n        Ok(CompactionLock {\n            lock: Arc::clone(&self.lock),\n        })\n    }\n\n    fn emit_snapshot_event(\n        &self,\n        snapshot: &Snapshot,\n        latest: &crate::events::EventCursor,\n    ) -> Result<(), CompactionError> {\n        let summary = CompactSummary::new(format!(\n            \"event log snapshot: up_to_event_row={} graph_nodes={} memories={}\",\n            snapshot.up_to_event_id,\n            snapshot.graph_state.nodes.len(),\n            snapshot.memory_state.memories.len()\n        ))\n        .map_err(|err| CompactionError::EventWriteFailed(err.to_string()))?;\n        let payload = EventPayload::MemoryConsolidated(MemoryConsolidatedPayload {\n            source_memory_ids: Vec::new(),\n            consolidated_memory_id: MemoryId {\n                workspace_id: latest.workspace_id.clone(),\n                ulid: format!(\"snapshot-{}\", snapshot.up_to_event_id),\n            },\n            source_event_ids: vec![EventId {\n                workspace_id: latest.workspace_id.clone(),\n                ulid: latest.event_uuid.clone(),\n            }],\n            consolidation_summary: \"event log snapshot compaction marker\".to_string(),\n        });\n        self.writer\n            .append(PartialEnvelope {\n                workspace_id: Some(latest.workspace_id.clone()),\n                branch: BranchRef {\n                    name: latest.branch.clone(),\n                },\n                session_id: SessionId {\n                    value: \"daemon-compaction\".to_string(),\n                },\n                task_id: None,\n                actor: Actor::Daemon,\n                kind: payload.kind(),\n                references: Vec::new(),\n                summary,\n                payload,\n            })\n            .map_err(|err| CompactionError::EventWriteFailed(err.to_string()))?;\n        Ok(())\n    }\n\n    fn rotate_snapshots(&self) -> Result<(), CompactionError> {\n        let retain = self.config.retain_snapshots.max(1);\n        let mut snapshots = snapshot_files(&self.config.snapshot_dir)?;\n        snapshots.sort_by(|left, right| right.cmp(left));\n        for stale in snapshots.into_iter().skip(retain) {\n            match std::fs::remove_file(&stale) {\n                Ok(()) => {\n                    warn!(snapshot_path = %stale.display(), \"removed old compaction snapshot\")\n                }\n                Err(err) => warn!(\n                    snapshot_path = %stale.display(),\n                    error = %err,\n                    \"failed to remove old compaction snapshot\"\n                ),\n            }\n        }\n        Ok(())\n    }\n}\n\nimpl SchedulerHandle {\n    pub async fn shutdown(mut self) {\n        if let Some(shutdown) = self.shutdown.take() {\n            let _ = shutdown.send(());\n        }\n        if let Err(err) = self.task.await {\n            warn!(error = %err, \"event log compaction scheduler join failed\");\n        }\n    }\n}\n\nimpl Bootstrap {\n    pub fn load(\n        snapshot_path: &Path,\n        event_store: &EventStore,\n    ) -> Result<BootstrappedState, BootstrapError> {\n        if !snapshot_path.exists() {\n            return Err(BootstrapError::SnapshotMissing {\n                path: snapshot_path.to_path_buf(),\n            });\n        }\n        let Some(snapshot) = newest_valid_snapshot(snapshot_path)? else {\n            return Err(BootstrapError::ContentHashMismatch {\n                path: snapshot_path.to_path_buf(),\n            });\n        };\n        let rows = event_store.query_events_after_row_id(snapshot.up_to_event_id, 10_000)?;\n        validate_tail_references(&snapshot, &rows)?;\n        Ok(BootstrappedState {\n            snapshot,\n            replayed_event_rows: rows.len(),\n        })\n    }\n}\n\nstruct CompactionLock {\n    lock: Arc<AtomicBool>,\n}\n\nimpl Drop for CompactionLock {\n    fn drop(&mut self) {\n        self.lock.store(false, Ordering::Release);\n    }\n}\n\nfn skipped_report(started: Instant) -> CompactionReport {\n    CompactionReport {\n        snapshot_path: None,\n        bytes_written: 0,\n        events_truncated: 0,\n        duration: started.elapsed(),\n        skipped: true,\n    }\n}\n\nfn latest_snapshot(snapshot_dir: &Path) -> Result<Option<Snapshot>, SnapshotError> {\n    let Some(path) = snapshot_files(snapshot_dir)?.into_iter().max() else {\n        return Ok(None);\n    };\n    Snapshot::read(&path).map(Some)\n}\n\nfn newest_valid_snapshot(requested_path: &Path) -> Result<Option<Snapshot>, BootstrapError> {\n    let requested = requested_path.to_path_buf();\n    let mut candidates = vec![requested.clone()];\n    if let Some(parent) = requested.parent() {\n        let mut siblings = snapshot_files(parent).map_err(BootstrapError::Snapshot)?;\n        siblings.sort_by(|left, right| right.cmp(left));\n        candidates.extend(siblings.into_iter().filter(|path| path != &requested));\n    }\n\n    let mut saw_corruption = false;\n    for candidate in candidates {\n        match load_snapshot_candidate(&candidate) {\n            Ok(snapshot) => return Ok(Some(snapshot)),\n            Err(BootstrapError::ContentHashMismatch { .. }) => {\n                saw_corruption = true;\n            }\n            Err(error) => return Err(error),\n        }\n    }\n    if saw_corruption {\n        return Ok(None);\n    }\n    Err(BootstrapError::SnapshotMissing {\n        path: requested_path.to_path_buf(),\n    })\n}\n\nfn load_snapshot_candidate(path: &Path) -> Result<Snapshot, BootstrapError> {\n    let header = Snapshot::read_header(path).map_err(|error| map_snapshot_error(path, error))?;\n    if header.format_version > crate::events::snapshot::SNAPSHOT_FORMAT_VERSION {\n        return Err(BootstrapError::FormatVersionUnsupported {\n            found: header.format_version,\n            max: crate::events::snapshot::SNAPSHOT_FORMAT_VERSION,\n        });\n    }\n    Snapshot::read(path).map_err(|error| map_snapshot_error(path, error))\n}\n\nfn map_snapshot_error(path: &Path, error: SnapshotError) -> BootstrapError {\n    match error {\n        SnapshotError::ContentHashMismatch => BootstrapError::ContentHashMismatch {\n            path: path.to_path_buf(),\n        },\n        other => BootstrapError::Snapshot(other),\n    }\n}\n\nfn snapshot_files(snapshot_dir: &Path) -> Result<Vec<PathBuf>, SnapshotError> {\n    if !snapshot_dir.exists() {\n        return Ok(Vec::new());\n    }\n    let entries = std::fs::read_dir(snapshot_dir).map_err(|source| SnapshotError::IoFailed {\n        path: snapshot_dir.to_path_buf(),\n        source,\n    })?;\n    let mut files = Vec::new();\n    for entry in entries {\n        let path = entry\n            .map_err(|source| SnapshotError::IoFailed {\n                path: snapshot_dir.to_path_buf(),\n                source,\n            })?\n            .path();\n        if is_snapshot_file(&path) {\n            files.push(path);\n        }\n    }\n    Ok(files)\n}\n\nfn is_snapshot_file(path: &Path) -> bool {\n    path.file_name()\n        .and_then(|name| name.to_str())\n        .is_some_and(|name| name.starts_with(\"snapshot-\") && name.ends_with(\".bin\"))\n}\n\nfn snapshot_path(snapshot_dir: &Path, event_row_id: i64) -> PathBuf {\n    let micros = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_micros();\n    snapshot_dir.join(format!(\"snapshot-{event_row_id}-{micros}.bin\"))\n}\n\nfn validate_tail_references(\n    snapshot: &Snapshot,\n    rows: &[crate::events::EventEnvelopeRow],\n) -> Result<(), BootstrapError> {\n    let mut memory_ids: HashSet<String> = snapshot\n        .memory_state\n        .memories\n        .iter()\n        .map(|entry| entry.memory.id.clone())\n        .collect();\n    let symbol_ids: HashSet<String> = snapshot\n        .graph_state\n        .nodes\n        .iter()\n        .map(|node| format!(\"{}:{}\", node.id.file, node.id.name))\n        .collect();\n    for row in rows {\n        validate_row_references(row, &memory_ids, &symbol_ids)?;\n        collect_created_memory_ids(row, &mut memory_ids);\n    }\n    Ok(())\n}\n\nfn validate_row_references(\n    row: &crate::events::EventEnvelopeRow,\n    memory_ids: &HashSet<String>,\n    symbol_ids: &HashSet<String>,\n) -> Result<(), BootstrapError> {\n    let refs: Vec<crate::events::StableRef> =\n        serde_json::from_str(&row.references_json).unwrap_or_default();\n    for reference in refs {\n        match reference {\n            crate::events::StableRef::MemoryRef(memory_id) => {\n                let id = memory_id.ulid;\n                if !memory_ids.contains(&id) {\n                    return unresolved(row.event_id, id);\n                }\n            }\n            crate::events::StableRef::SymbolRef(symbol_id) => {\n                let id = format!(\n                    \"{}:{}\",\n                    symbol_id.file.repo_relative_path, symbol_id.qualified_name\n                );\n                if !symbol_ids.contains(&id) {\n                    return unresolved(row.event_id, id);\n                }\n            }\n            _ => {}\n        }\n    }\n    Ok(())\n}\n\nfn collect_created_memory_ids(\n    row: &crate::events::EventEnvelopeRow,\n    memory_ids: &mut HashSet<String>,\n) {\n    if row.kind != \"memory_created\" {\n        return;\n    }\n    let Some(bytes) = &row.payload_inline else {\n        return;\n    };\n    if let Ok(EventPayload::MemoryCreated(payload)) = serde_json::from_slice::<EventPayload>(bytes)\n    {\n        memory_ids.insert(payload.memory_id.ulid);\n    }\n}\n\nfn unresolved<T>(event_id: i64, missing_ref: String) -> Result<T, BootstrapError> {\n    Err(BootstrapError::ReferenceUnresolved {\n        event_id,\n        missing_ref,\n    })\n}\n\nfn lock_error<T>(_: std::sync::PoisonError<T>) -> CompactionError {\n    CompactionError::VerifyFailed(\"snapshot source lock was poisoned\".to_string())\n}\n","numLines":498,"startLine":1,"totalLines":498}}}
