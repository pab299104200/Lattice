{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X1CDFnMZpmLd7Wi8EyVqrR","type":"tool_result","content":"1\tuse std::path::PathBuf;\n2\tuse std::sync::atomic::AtomicBool;\n3\tuse std::sync::{Arc, OnceLock};\n4\t\n5\tuse lattice_core::events::{\n6\t    EventKind, EventPayload, EventQuery, EventReader, EventStore, EventWriter, FlushPolicy,\n7\t    QueryOrder, SessionId, SessionScope,\n8\t};\n9\tuse lattice_core::graph::CodeGraph;\n10\tuse lattice_core::indexer::Indexer;\n11\tuse lattice_core::memory::MemoryStore;\n12\tuse lattice_core::query::QueryEngine;\n13\tuse lattice_core::storage::GraphStore;\n14\tuse serde_json::json;\n15\tuse tokio::sync::Mutex;\n16\t\n17\tuse super::event_capture::{EventCapture, ToolOutcome};\n18\tuse super::mcp::McpHandler;\n19\tuse super::server::RequestHandler;\n20\t\n21\t#[tokio::test]\n22\tasync fn dispatch_success_records_task_tool_result_and_workflow_events() {\n23\t    let fixture = CaptureFixture::new(\"success\");\n24\t    let response = RequestHandler::handle(\n25\t        &fixture.handler,\n26\t        \"tools/call\",\n27\t        json!({\"name\": \"index_status\", \"arguments\": {}}),\n28\t    )\n29\t    .await\n30\t    .expect(\"index_status succeeds\");\n31\t\n32\t    assert!(response[\"content\"].is_array());\n33\t    let events = fixture.events();\n34\t    assert_event_kinds(\n35\t        &events,\n36\t        &[\n37\t            EventKind::AssistantTaskStarted,\n38\t            EventKind::ToolCalled,\n39\t            EventKind::ToolResult,\n40\t            EventKind::WorkflowSucceeded,\n41\t        ],\n42\t    );\n43\t}\n44\t\n45\t#[tokio::test]\n46\tasync fn dispatch_error_records_tool_result_and_preserves_json_rpc_error() {\n47\t    let fixture = CaptureFixture::new(\"error\");\n48\t    let error = RequestHandler::handle(\n49\t        &fixture.handler,\n50\t        \"tools/call\",\n51\t        json!({\"name\": \"prepare_change\", \"arguments\": {}}),\n52\t    )\n53\t    .await\n54\t    .expect_err(\"missing query still returns JSON-RPC error\");\n55\t\n56\t    assert_eq!(error.0, -32602);\n57\t    assert!(error.1.contains(\"Missing required parameter: query\"));\n58\t    let events = fixture.events();\n59\t    assert_event_kinds(\n60\t        &events,\n61\t        &[\n62\t            EventKind::AssistantTaskStarted,\n63\t            EventKind::ToolCalled,\n64\t            EventKind::ToolResult,\n65\t            EventKind::WorkflowFailed,\n66\t        ],\n67\t    );\n68\t    assert_failed_tool_result(&events);\n69\t}\n70\t\n71\t#[tokio::test]\n72\tasync fn dispatch_error_tail_includes_tool_called_and_failed_result_events() {\n73\t    let fixture = CaptureFixture::new(\"error-tail\");\n74\t    let _ = RequestHandler::handle(\n75\t        &fixture.handler,\n76\t        \"tools/call\",\n77\t        json!({\"name\": \"prepare_change\", \"arguments\": {}}),\n78\t    )\n79\t    .await\n80\t    .expect_err(\"missing query still returns JSON-RPC error\");\n81\t\n82\t    let tail = fixture\n83\t        .reader\n84\t        .tail(\n85\t            SessionScope {\n86\t                session_id: SessionId {\n87\t                    value: fixture.session_id.clone(),\n88\t                },\n89\t            },\n90\t            3,\n91\t        )\n92\t        .expect(\"session tail loads\");\n93\t\n94\t    let kinds = tail.iter().map(|event| event.kind).collect::<Vec<_>>();\n95\t    assert_eq!(\n96\t        kinds,\n97\t        vec![\n98\t            EventKind::WorkflowFailed,\n99\t            EventKind::ToolResult,\n100\t            EventKind::ToolCalled\n101\t        ]\n102\t    );\n103\t    assert_failed_tool_result(&tail);\n104\t}\n105\t\n106\t#[tokio::test]\n107\tasync fn all_dispatched_workflow_tools_emit_call_and_result_events() {\n108\t    let fixture = CaptureFixture::new(\"all-tools\");\n109\t    for tool_name in instrumented_tool_names() {\n110\t        let _ = RequestHandler::handle(\n111\t            &fixture.handler,\n112\t            \"tools/call\",\n113\t            json!({\"name\": tool_name, \"arguments\": {}}),\n114\t        )\n115\t        .await;\n116\t    }\n117\t\n118\t    let events = fixture.events();\n119\t    let called = events\n120\t        .iter()\n121\t        .filter(|event| event.kind == EventKind::ToolCalled)\n122\t        .count();\n123\t    let results = events\n124\t        .iter()\n125\t        .filter(|event| event.kind == EventKind::ToolResult)\n126\t        .count();\n127\t    assert_eq!(called, instrumented_tool_names().len());\n128\t    assert_eq!(results, instrumented_tool_names().len());\n129\t}\n130\t\n131\t#[test]\n132\tfn event_capture_new_rejects_workspace_mismatch() {\n133\t    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n134\t    let writer = Arc::new(EventWriter::new(store, \"workspace-a\".to_string(), 4096));\n135\t    let error = EventCapture::new(\n136\t        writer,\n137\t        \"workspace-b\".to_string(),\n138\t        \"main\".to_string(),\n139\t        SessionId {\n140\t            value: \"session-a\".to_string(),\n141\t        },\n142\t    )\n143\t    .expect_err(\"workspace mismatch is rejected\");\n144\t\n145\t    assert_eq!(\n146\t        error.to_string(),\n147\t        \"event capture workspace `workspace-b` does not match writer workspace `workspace-a`\"\n148\t    );\n149\t}\n150\t\n151\t#[test]\n152\tfn batched_flush_writer_records_multiple_tool_calls_for_same_session() {\n153\t    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n154\t    let writer = Arc::new(\n155\t        EventWriter::new(store.clone(), \"workspace-a\".to_string(), 4096)\n156\t            .with_flush_policy(FlushPolicy::Batched { interval_ms: 250 }),\n157\t    );\n158\t    let capture = EventCapture::new(\n159\t        writer,\n160\t        \"workspace-a\".to_string(),\n161\t        \"main\".to_string(),\n162\t        SessionId {\n163\t            value: \"session-batched\".to_string(),\n164\t        },\n165\t    )\n166\t    .expect(\"capture creates\");\n167\t\n168\t    let first = capture\n169\t        .record_tool_called(\"prepare_change\", &json!({\"query\": \"alpha\"}))\n170\t        .expect(\"first tool call captured\");\n171\t    let second = capture\n172\t        .record_tool_called(\"get_context_capsule\", &json!({\"query\": \"beta\"}))\n173\t        .expect(\"second tool call captured\");\n174\t    capture\n175\t        .record_tool_result(\"prepare_change\", &ToolOutcome::Success(json!({})), first)\n176\t        .expect(\"first result captured\");\n177\t    capture\n178\t        .record_tool_result(\n179\t            \"get_context_capsule\",\n180\t            &ToolOutcome::Success(json!({})),\n181\t            second,\n182\t        )\n183\t        .expect(\"second result captured\");\n184\t\n185\t    let reader = EventReader::new(store);\n186\t    let events = EventQuery::new()\n187\t        .session(\"session-batched\")\n188\t        .order(QueryOrder::OldestFirst)\n189\t        .execute(&reader)\n190\t        .expect(\"events read\");\n191\t    assert_eq!(\n192\t        events\n193\t            .iter()\n194\t            .filter(|event| event.kind == EventKind::ToolCalled)\n195\t            .count(),\n196\t        2\n197\t    );\n198\t}\n199\t\n200\tstruct CaptureFixture {\n201\t    handler: McpHandler,\n202\t    reader: EventReader,\n203\t    session_id: String,\n204\t    _workspace_root: PathBuf,\n205\t}\n206\t\n207\timpl CaptureFixture {\n208\t    fn new(name: &str) -> Self {\n209\t        let session_id = format!(\"session-{name}\");\n210\t        let workspace_root = unique_test_path(name);\n211\t        std::fs::create_dir_all(&workspace_root).expect(\"workspace creates\");\n212\t        let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n213\t        let writer = Arc::new(\n214\t            EventWriter::new(\n215\t                store.clone(),\n216\t                workspace_root.to_string_lossy().to_string(),\n217\t                4096,\n218\t            )\n219\t            .with_flush_policy(FlushPolicy::Batched { interval_ms: 250 }),\n220\t        );\n221\t        let handler = McpHandler::new(\n222\t            Arc::new(Mutex::new(QueryEngine::new(CodeGraph::new(), None, None))),\n223\t            Arc::new(Mutex::new(Indexer::new(workspace_root.clone()))),\n224\t            Arc::new(Mutex::new(\n225\t                MemoryStore::open_in_memory().expect(\"memory store\"),\n226\t            )),\n227\t            Arc::new(Mutex::new(\n228\t                GraphStore::open_in_memory().expect(\"graph store\"),\n229\t            )),\n230\t            Arc::new(OnceLock::new()),\n231\t            None,\n232\t            workspace_root.clone(),\n233\t            workspace_root.join(\"context_handles.json\"),\n234\t            session_id.clone(),\n235\t            None,\n236\t            vec![workspace_root.clone()],\n237\t            Arc::new(AtomicBool::new(false)),\n238\t            Some(writer),\n239\t        );\n240\t        Self {\n241\t            handler,\n242\t            reader: EventReader::new(store),\n243\t            session_id,\n244\t            _workspace_root: workspace_root,\n245\t        }\n246\t    }\n247\t\n248\t    fn events(&self) -> Vec<lattice_core::events::EventEnvelope> {\n249\t        EventQuery::new()\n250\t            .session(self.session_id.clone())\n251\t            .order(QueryOrder::OldestFirst)\n252\t            .execute(&self.reader)\n253\t            .expect(\"events read\")\n254\t    }\n255\t}\n256\t\n257\tfn assert_event_kinds(events: &[lattice_core::events::EventEnvelope], expected: &[EventKind]) {\n258\t    let actual = events.iter().map(|event| event.kind).collect::<Vec<_>>();\n259\t    assert_eq!(actual, expected);\n260\t}\n261\t\n262\tfn assert_failed_tool_result(events: &[lattice_core::events::EventEnvelope]) {\n263\t    let result = events\n264\t        .iter()\n265\t        .find(|event| event.kind == EventKind::ToolResult)\n266\t        .expect(\"tool result exists\");\n267\t    let EventPayload::ToolResult(payload) = &result.payload else {\n268\t        panic!(\"expected tool result payload\");\n269\t    };\n270\t    assert_eq!(\n271\t        payload.status,\n272\t        lattice_core::events::ToolResultStatus::Failed\n273\t    );\n274\t}\n275\t\n276\tfn instrumented_tool_names() -> &'static [&'static str] {\n277\t    &[\n278\t        \"get_context_capsule\",\n279\t        \"prepare_change\",\n280\t        \"plan_edit\",\n281\t        \"trace_scenario\",\n282\t        \"find_relevant_tests\",\n283\t        \"impact_from_diff\",\n284\t        \"get_working_set_context\",\n285\t        \"summarize_subsystem\",\n286\t        \"get_repo_playbook\",\n287\t        \"get_docs_capsule\",\n288\t        \"get_backlinks\",\n289\t        \"get_outgoing_links\",\n290\t        \"find_stale_docs\",\n291\t        \"diagnose_failure\",\n292\t        \"record_workflow_outcome\",\n293\t        \"expand_context\",\n294\t        \"get_symbol\",\n295\t        \"get_dependents\",\n296\t        \"get_dependencies\",\n297\t        \"get_impact_graph\",\n298\t        \"search_symbols\",\n299\t        \"get_skeleton\",\n300\t        \"save_observation\",\n301\t        \"get_session_context\",\n302\t        \"search_memory\",\n303\t        \"list_observations\",\n304\t        \"list_stale_memories\",\n305\t        \"promote_observation\",\n306\t        \"refresh_memory\",\n307\t        \"delete_observation\",\n308\t        \"update_observation\",\n309\t        \"search_logic_flow\",\n310\t        \"submit_lsp_edges\",\n311\t        \"workspace_setup\",\n312\t        \"index_status\",\n313\t        \"get_session_metrics\",\n314\t        \"get_project_rules\",\n315\t    ]\n316\t}\n317\t\n318\tfn unique_test_path(name: &str) -> PathBuf {\n319\t    let micros = std::time::SystemTime::now()\n320\t        .duration_since(std::time::UNIX_EPOCH)\n321\t        .expect(\"system clock after epoch\")\n322\t        .as_micros();\n323\t    std::env::temp_dir().join(format!(\"lattice-event-capture-{name}-{micros}\"))\n324\t}\n325\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"579dfddd-e157-4659-8dc3-828c1cbfe77e","timestamp":"2026-05-17T05:58:54.554Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/event_capture_tests.rs","content":"use std::path::PathBuf;\nuse std::sync::atomic::AtomicBool;\nuse std::sync::{Arc, OnceLock};\n\nuse lattice_core::events::{\n    EventKind, EventPayload, EventQuery, EventReader, EventStore, EventWriter, FlushPolicy,\n    QueryOrder, SessionId, SessionScope,\n};\nuse lattice_core::graph::CodeGraph;\nuse lattice_core::indexer::Indexer;\nuse lattice_core::memory::MemoryStore;\nuse lattice_core::query::QueryEngine;\nuse lattice_core::storage::GraphStore;\nuse serde_json::json;\nuse tokio::sync::Mutex;\n\nuse super::event_capture::{EventCapture, ToolOutcome};\nuse super::mcp::McpHandler;\nuse super::server::RequestHandler;\n\n#[tokio::test]\nasync fn dispatch_success_records_task_tool_result_and_workflow_events() {\n    let fixture = CaptureFixture::new(\"success\");\n    let response = RequestHandler::handle(\n        &fixture.handler,\n        \"tools/call\",\n        json!({\"name\": \"index_status\", \"arguments\": {}}),\n    )\n    .await\n    .expect(\"index_status succeeds\");\n\n    assert!(response[\"content\"].is_array());\n    let events = fixture.events();\n    assert_event_kinds(\n        &events,\n        &[\n            EventKind::AssistantTaskStarted,\n            EventKind::ToolCalled,\n            EventKind::ToolResult,\n            EventKind::WorkflowSucceeded,\n        ],\n    );\n}\n\n#[tokio::test]\nasync fn dispatch_error_records_tool_result_and_preserves_json_rpc_error() {\n    let fixture = CaptureFixture::new(\"error\");\n    let error = RequestHandler::handle(\n        &fixture.handler,\n        \"tools/call\",\n        json!({\"name\": \"prepare_change\", \"arguments\": {}}),\n    )\n    .await\n    .expect_err(\"missing query still returns JSON-RPC error\");\n\n    assert_eq!(error.0, -32602);\n    assert!(error.1.contains(\"Missing required parameter: query\"));\n    let events = fixture.events();\n    assert_event_kinds(\n        &events,\n        &[\n            EventKind::AssistantTaskStarted,\n            EventKind::ToolCalled,\n            EventKind::ToolResult,\n            EventKind::WorkflowFailed,\n        ],\n    );\n    assert_failed_tool_result(&events);\n}\n\n#[tokio::test]\nasync fn dispatch_error_tail_includes_tool_called_and_failed_result_events() {\n    let fixture = CaptureFixture::new(\"error-tail\");\n    let _ = RequestHandler::handle(\n        &fixture.handler,\n        \"tools/call\",\n        json!({\"name\": \"prepare_change\", \"arguments\": {}}),\n    )\n    .await\n    .expect_err(\"missing query still returns JSON-RPC error\");\n\n    let tail = fixture\n        .reader\n        .tail(\n            SessionScope {\n                session_id: SessionId {\n                    value: fixture.session_id.clone(),\n                },\n            },\n            3,\n        )\n        .expect(\"session tail loads\");\n\n    let kinds = tail.iter().map(|event| event.kind).collect::<Vec<_>>();\n    assert_eq!(\n        kinds,\n        vec![\n            EventKind::WorkflowFailed,\n            EventKind::ToolResult,\n            EventKind::ToolCalled\n        ]\n    );\n    assert_failed_tool_result(&tail);\n}\n\n#[tokio::test]\nasync fn all_dispatched_workflow_tools_emit_call_and_result_events() {\n    let fixture = CaptureFixture::new(\"all-tools\");\n    for tool_name in instrumented_tool_names() {\n        let _ = RequestHandler::handle(\n            &fixture.handler,\n            \"tools/call\",\n            json!({\"name\": tool_name, \"arguments\": {}}),\n        )\n        .await;\n    }\n\n    let events = fixture.events();\n    let called = events\n        .iter()\n        .filter(|event| event.kind == EventKind::ToolCalled)\n        .count();\n    let results = events\n        .iter()\n        .filter(|event| event.kind == EventKind::ToolResult)\n        .count();\n    assert_eq!(called, instrumented_tool_names().len());\n    assert_eq!(results, instrumented_tool_names().len());\n}\n\n#[test]\nfn event_capture_new_rejects_workspace_mismatch() {\n    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n    let writer = Arc::new(EventWriter::new(store, \"workspace-a\".to_string(), 4096));\n    let error = EventCapture::new(\n        writer,\n        \"workspace-b\".to_string(),\n        \"main\".to_string(),\n        SessionId {\n            value: \"session-a\".to_string(),\n        },\n    )\n    .expect_err(\"workspace mismatch is rejected\");\n\n    assert_eq!(\n        error.to_string(),\n        \"event capture workspace `workspace-b` does not match writer workspace `workspace-a`\"\n    );\n}\n\n#[test]\nfn batched_flush_writer_records_multiple_tool_calls_for_same_session() {\n    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n    let writer = Arc::new(\n        EventWriter::new(store.clone(), \"workspace-a\".to_string(), 4096)\n            .with_flush_policy(FlushPolicy::Batched { interval_ms: 250 }),\n    );\n    let capture = EventCapture::new(\n        writer,\n        \"workspace-a\".to_string(),\n        \"main\".to_string(),\n        SessionId {\n            value: \"session-batched\".to_string(),\n        },\n    )\n    .expect(\"capture creates\");\n\n    let first = capture\n        .record_tool_called(\"prepare_change\", &json!({\"query\": \"alpha\"}))\n        .expect(\"first tool call captured\");\n    let second = capture\n        .record_tool_called(\"get_context_capsule\", &json!({\"query\": \"beta\"}))\n        .expect(\"second tool call captured\");\n    capture\n        .record_tool_result(\"prepare_change\", &ToolOutcome::Success(json!({})), first)\n        .expect(\"first result captured\");\n    capture\n        .record_tool_result(\n            \"get_context_capsule\",\n            &ToolOutcome::Success(json!({})),\n            second,\n        )\n        .expect(\"second result captured\");\n\n    let reader = EventReader::new(store);\n    let events = EventQuery::new()\n        .session(\"session-batched\")\n        .order(QueryOrder::OldestFirst)\n        .execute(&reader)\n        .expect(\"events read\");\n    assert_eq!(\n        events\n            .iter()\n            .filter(|event| event.kind == EventKind::ToolCalled)\n            .count(),\n        2\n    );\n}\n\nstruct CaptureFixture {\n    handler: McpHandler,\n    reader: EventReader,\n    session_id: String,\n    _workspace_root: PathBuf,\n}\n\nimpl CaptureFixture {\n    fn new(name: &str) -> Self {\n        let session_id = format!(\"session-{name}\");\n        let workspace_root = unique_test_path(name);\n        std::fs::create_dir_all(&workspace_root).expect(\"workspace creates\");\n        let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n        let writer = Arc::new(\n            EventWriter::new(\n                store.clone(),\n                workspace_root.to_string_lossy().to_string(),\n                4096,\n            )\n            .with_flush_policy(FlushPolicy::Batched { interval_ms: 250 }),\n        );\n        let handler = McpHandler::new(\n            Arc::new(Mutex::new(QueryEngine::new(CodeGraph::new(), None, None))),\n            Arc::new(Mutex::new(Indexer::new(workspace_root.clone()))),\n            Arc::new(Mutex::new(\n                MemoryStore::open_in_memory().expect(\"memory store\"),\n            )),\n            Arc::new(Mutex::new(\n                GraphStore::open_in_memory().expect(\"graph store\"),\n            )),\n            Arc::new(OnceLock::new()),\n            None,\n            workspace_root.clone(),\n            workspace_root.join(\"context_handles.json\"),\n            session_id.clone(),\n            None,\n            vec![workspace_root.clone()],\n            Arc::new(AtomicBool::new(false)),\n            Some(writer),\n        );\n        Self {\n            handler,\n            reader: EventReader::new(store),\n            session_id,\n            _workspace_root: workspace_root,\n        }\n    }\n\n    fn events(&self) -> Vec<lattice_core::events::EventEnvelope> {\n        EventQuery::new()\n            .session(self.session_id.clone())\n            .order(QueryOrder::OldestFirst)\n            .execute(&self.reader)\n            .expect(\"events read\")\n    }\n}\n\nfn assert_event_kinds(events: &[lattice_core::events::EventEnvelope], expected: &[EventKind]) {\n    let actual = events.iter().map(|event| event.kind).collect::<Vec<_>>();\n    assert_eq!(actual, expected);\n}\n\nfn assert_failed_tool_result(events: &[lattice_core::events::EventEnvelope]) {\n    let result = events\n        .iter()\n        .find(|event| event.kind == EventKind::ToolResult)\n        .expect(\"tool result exists\");\n    let EventPayload::ToolResult(payload) = &result.payload else {\n        panic!(\"expected tool result payload\");\n    };\n    assert_eq!(\n        payload.status,\n        lattice_core::events::ToolResultStatus::Failed\n    );\n}\n\nfn instrumented_tool_names() -> &'static [&'static str] {\n    &[\n        \"get_context_capsule\",\n        \"prepare_change\",\n        \"plan_edit\",\n        \"trace_scenario\",\n        \"find_relevant_tests\",\n        \"impact_from_diff\",\n        \"get_working_set_context\",\n        \"summarize_subsystem\",\n        \"get_repo_playbook\",\n        \"get_docs_capsule\",\n        \"get_backlinks\",\n        \"get_outgoing_links\",\n        \"find_stale_docs\",\n        \"diagnose_failure\",\n        \"record_workflow_outcome\",\n        \"expand_context\",\n        \"get_symbol\",\n        \"get_dependents\",\n        \"get_dependencies\",\n        \"get_impact_graph\",\n        \"search_symbols\",\n        \"get_skeleton\",\n        \"save_observation\",\n        \"get_session_context\",\n        \"search_memory\",\n        \"list_observations\",\n        \"list_stale_memories\",\n        \"promote_observation\",\n        \"refresh_memory\",\n        \"delete_observation\",\n        \"update_observation\",\n        \"search_logic_flow\",\n        \"submit_lsp_edges\",\n        \"workspace_setup\",\n        \"index_status\",\n        \"get_session_metrics\",\n        \"get_project_rules\",\n    ]\n}\n\nfn unique_test_path(name: &str) -> PathBuf {\n    let micros = std::time::SystemTime::now()\n        .duration_since(std::time::UNIX_EPOCH)\n        .expect(\"system clock after epoch\")\n        .as_micros();\n    std::env::temp_dir().join(format!(\"lattice-event-capture-{name}-{micros}\"))\n}\n","numLines":325,"startLine":1,"totalLines":325}}}
