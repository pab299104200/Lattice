{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014C8ttmmSymYcYEA7rPu2mW","type":"tool_result","content":"1\tuse std::fs;\n2\tuse std::path::PathBuf;\n3\tuse std::sync::Arc;\n4\tuse std::thread;\n5\tuse std::time::{SystemTime, UNIX_EPOCH};\n6\t\n7\tuse rusqlite::Connection;\n8\tuse serde_json::json;\n9\t\n10\tuse super::{\n11\t    canonical_json_bytes, canonicalize_json_value, hash_payload, Actor,\n12\t    AssistantTaskStartedPayload, BranchRef, CompactSummary, EventPayload, EventStore,\n13\t    EventWriteError, EventWriter, FlushPolicy, PartialEnvelope, SessionId,\n14\t};\n15\t\n16\t#[test]\n17\tfn canonical_hash_is_stable_for_equivalent_key_order_variations() {\n18\t    let left = json!({\n19\t        \"payload\": {\n20\t            \"zeta\": 1,\n21\t            \"alpha\": {\"k2\": \"v2\", \"k1\": \"v1\"}\n22\t        },\n23\t        \"kind\": \"assistant_task_started\"\n24\t    });\n25\t    let right = json!({\n26\t        \"kind\": \"assistant_task_started\",\n27\t        \"payload\": {\n28\t            \"alpha\": {\"k1\": \"v1\", \"k2\": \"v2\"},\n29\t            \"zeta\": 1\n30\t        }\n31\t    });\n32\t\n33\t    let left_bytes = canonical_json_bytes(&canonicalize_json_value(left)).unwrap();\n34\t    let right_bytes = canonical_json_bytes(&canonicalize_json_value(right)).unwrap();\n35\t\n36\t    assert_eq!(left_bytes, right_bytes);\n37\t}\n38\t\n39\t#[test]\n40\tfn spilled_payloads_dedupe_by_hash() {\n41\t    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n42\t    let writer = EventWriter::new(store.clone(), \"workspace-main\".to_string(), 1)\n43\t        .with_flush_policy(FlushPolicy::Sync);\n44\t\n45\t    writer.append(large_payload_envelope(\"session-a\")).unwrap();\n46\t    writer.append(large_payload_envelope(\"session-b\")).unwrap();\n47\t\n48\t    let payload_rows = store.with_connection(|conn| payload_row_count(conn));\n49\t    assert_eq!(payload_rows, 1);\n50\t}\n51\t\n52\t#[test]\n53\tfn inline_ceiling_boundary_is_honored_exactly() {\n54\t    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n55\t    let payload = assistant_task_payload();\n56\t    let inline_len = canonical_json_bytes(&payload).unwrap().len();\n57\t    let writer = EventWriter::new(store.clone(), \"workspace-main\".to_string(), inline_len)\n58\t        .with_flush_policy(FlushPolicy::Sync);\n59\t\n60\t    writer.append(base_envelope(payload)).unwrap();\n61\t\n62\t    let rows = store.query_events_by_session(\"session-main\", 10).unwrap();\n63\t    assert!(rows[0].payload_inline.is_some());\n64\t    assert!(rows[0].payload_spill_id.is_none());\n65\t\n66\t    let spill_writer =\n67\t        EventWriter::new(store.clone(), \"workspace-main\".to_string(), inline_len - 1)\n68\t            .with_flush_policy(FlushPolicy::Sync);\n69\t    spill_writer\n70\t        .append(base_envelope(assistant_task_payload()))\n71\t        .unwrap();\n72\t\n73\t    let rows = store.query_events_by_session(\"session-main\", 10).unwrap();\n74\t    assert!(rows[1].payload_inline.is_none());\n75\t    assert!(rows[1].payload_spill_id.is_some());\n76\t}\n77\t\n78\t#[test]\n79\tfn workspace_mismatch_is_rejected() {\n80\t    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n81\t    let writer = EventWriter::new(store, \"workspace-main\".to_string(), 4096);\n82\t    let mut envelope = base_envelope(assistant_task_payload());\n83\t    envelope.workspace_id = Some(\"workspace-other\".to_string());\n84\t\n85\t    let error = writer\n86\t        .append(envelope)\n87\t        .expect_err(\"workspace mismatch should fail\");\n88\t\n89\t    match error {\n90\t        EventWriteError::WorkspaceMismatch { expected, actual } => {\n91\t            assert_eq!(expected, \"workspace-main\");\n92\t            assert_eq!(actual, \"workspace-other\");\n93\t        }\n94\t        other => panic!(\"expected workspace mismatch, got {other:?}\"),\n95\t    }\n96\t}\n97\t\n98\t#[test]\n99\tfn concurrent_appends_preserve_monotonic_row_ids() {\n100\t    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n101\t    let writer = Arc::new(\n102\t        EventWriter::new(store.clone(), \"workspace-main\".to_string(), 4096)\n103\t            .with_flush_policy(FlushPolicy::Sync),\n104\t    );\n105\t\n106\t    let first = {\n107\t        let writer = writer.clone();\n108\t        thread::spawn(move || {\n109\t            for index in 0..10 {\n110\t                let mut envelope = base_envelope(assistant_task_payload());\n111\t                envelope.session_id = SessionId {\n112\t                    value: format!(\"thread-a-{index}\"),\n113\t                };\n114\t                writer.append(envelope).unwrap();\n115\t            }\n116\t        })\n117\t    };\n118\t    let second = {\n119\t        let writer = writer.clone();\n120\t        thread::spawn(move || {\n121\t            for index in 0..10 {\n122\t                let mut envelope = base_envelope(assistant_task_payload());\n123\t                envelope.session_id = SessionId {\n124\t                    value: format!(\"thread-b-{index}\"),\n125\t                };\n126\t                writer.append(envelope).unwrap();\n127\t            }\n128\t        })\n129\t    };\n130\t\n131\t    first.join().unwrap();\n132\t    second.join().unwrap();\n133\t\n134\t    let rows = store.with_connection(|conn| {\n135\t        let mut statement = conn\n136\t            .prepare(\"SELECT event_id FROM events ORDER BY event_id ASC\")\n137\t            .unwrap();\n138\t        statement\n139\t            .query_map([], |row| row.get::<_, i64>(0))\n140\t            .unwrap()\n141\t            .map(|row| row.unwrap())\n142\t            .collect::<Vec<_>>()\n143\t    });\n144\t\n145\t    assert_eq!(rows.len(), 20);\n146\t    assert!(rows.windows(2).all(|window| window[0] < window[1]));\n147\t}\n148\t\n149\t#[test]\n150\tfn sync_flush_makes_rows_visible_to_new_connection() {\n151\t    let path = temp_db_path(\"sync-flush\");\n152\t    let store = Arc::new(EventStore::open(&path).expect(\"event store opens\"));\n153\t    let writer = EventWriter::new(store, \"workspace-main\".to_string(), 4096)\n154\t        .with_flush_policy(FlushPolicy::Sync);\n155\t\n156\t    let event_id = writer\n157\t        .append(base_envelope(assistant_task_payload()))\n158\t        .unwrap();\n159\t    let conn = Connection::open(&path).expect(\"second connection opens\");\n160\t    let count: i64 = conn\n161\t        .query_row(\n162\t            \"SELECT COUNT(*) FROM events WHERE event_uuid = ?1\",\n163\t            [event_id.ulid.as_str()],\n164\t            |row| row.get(0),\n165\t        )\n166\t        .expect(\"query succeeds\");\n167\t\n168\t    assert_eq!(count, 1);\n169\t    cleanup_db_files(&path);\n170\t}\n171\t\n172\t#[test]\n173\tfn hash_payload_is_deterministic_for_typed_payloads() {\n174\t    let payload = assistant_task_payload();\n175\t\n176\t    let left = hash_payload(&payload).unwrap();\n177\t    let right = hash_payload(&payload).unwrap();\n178\t\n179\t    assert_eq!(left, right);\n180\t    assert!(left.to_string().starts_with(\"sha256:\"));\n181\t}\n182\t\n183\tfn base_envelope(payload: EventPayload) -> PartialEnvelope {\n184\t    PartialEnvelope {\n185\t        workspace_id: None,\n186\t        branch: BranchRef {\n187\t            name: \"main\".to_string(),\n188\t        },\n189\t        session_id: SessionId {\n190\t            value: \"session-main\".to_string(),\n191\t        },\n192\t        task_id: None,\n193\t        actor: Actor::Assistant {\n194\t            model: \"gpt-5.5\".to_string(),\n195\t        },\n196\t        kind: payload.kind(),\n197\t        references: Vec::new(),\n198\t        summary: CompactSummary::new(\"event summary\").unwrap(),\n199\t        payload,\n200\t    }\n201\t}\n202\t\n203\tfn assistant_task_payload() -> EventPayload {\n204\t    EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n205\t        context_handle_id: None,\n206\t        seed_event_ids: Vec::new(),\n207\t        initial_memory_ids: Vec::new(),\n208\t        objective: \"measure writer\".to_string(),\n209\t    })\n210\t}\n211\t\n212\tfn large_payload_envelope(session_id: &str) -> PartialEnvelope {\n213\t    let mut envelope = base_envelope(EventPayload::AssistantTaskStarted(\n214\t        AssistantTaskStartedPayload {\n215\t            context_handle_id: None,\n216\t            seed_event_ids: Vec::new(),\n217\t            initial_memory_ids: Vec::new(),\n218\t            objective: \"x\".repeat(5000),\n219\t        },\n220\t    ));\n221\t    envelope.session_id = SessionId {\n222\t        value: session_id.to_string(),\n223\t    };\n224\t    envelope\n225\t}\n226\t\n227\tfn payload_row_count(conn: &Connection) -> i64 {\n228\t    conn.query_row(\"SELECT COUNT(*) FROM event_payloads\", [], |row| row.get(0))\n229\t        .unwrap()\n230\t}\n231\t\n232\tfn temp_db_path(test_name: &str) -> PathBuf {\n233\t    let micros = SystemTime::now()\n234\t        .duration_since(UNIX_EPOCH)\n235\t        .unwrap_or_default()\n236\t        .as_micros();\n237\t    std::env::temp_dir().join(format!(\n238\t        \"lattice-event-writer-{test_name}-{}-{micros}.db\",\n239\t        std::process::id()\n240\t    ))\n241\t}\n242\t\n243\tfn cleanup_db_files(path: &PathBuf) {\n244\t    let _ = fs::remove_file(path);\n245\t    let _ = fs::remove_file(path.with_extension(\"db-wal\"));\n246\t    let _ = fs::remove_file(path.with_extension(\"db-shm\"));\n247\t}\n248\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"0b506df2-fc41-4fa2-b3b7-74b3b29ce43d","timestamp":"2026-05-17T05:58:22.929Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/writer_tests.rs","content":"use std::fs;\nuse std::path::PathBuf;\nuse std::sync::Arc;\nuse std::thread;\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse rusqlite::Connection;\nuse serde_json::json;\n\nuse super::{\n    canonical_json_bytes, canonicalize_json_value, hash_payload, Actor,\n    AssistantTaskStartedPayload, BranchRef, CompactSummary, EventPayload, EventStore,\n    EventWriteError, EventWriter, FlushPolicy, PartialEnvelope, SessionId,\n};\n\n#[test]\nfn canonical_hash_is_stable_for_equivalent_key_order_variations() {\n    let left = json!({\n        \"payload\": {\n            \"zeta\": 1,\n            \"alpha\": {\"k2\": \"v2\", \"k1\": \"v1\"}\n        },\n        \"kind\": \"assistant_task_started\"\n    });\n    let right = json!({\n        \"kind\": \"assistant_task_started\",\n        \"payload\": {\n            \"alpha\": {\"k1\": \"v1\", \"k2\": \"v2\"},\n            \"zeta\": 1\n        }\n    });\n\n    let left_bytes = canonical_json_bytes(&canonicalize_json_value(left)).unwrap();\n    let right_bytes = canonical_json_bytes(&canonicalize_json_value(right)).unwrap();\n\n    assert_eq!(left_bytes, right_bytes);\n}\n\n#[test]\nfn spilled_payloads_dedupe_by_hash() {\n    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n    let writer = EventWriter::new(store.clone(), \"workspace-main\".to_string(), 1)\n        .with_flush_policy(FlushPolicy::Sync);\n\n    writer.append(large_payload_envelope(\"session-a\")).unwrap();\n    writer.append(large_payload_envelope(\"session-b\")).unwrap();\n\n    let payload_rows = store.with_connection(|conn| payload_row_count(conn));\n    assert_eq!(payload_rows, 1);\n}\n\n#[test]\nfn inline_ceiling_boundary_is_honored_exactly() {\n    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n    let payload = assistant_task_payload();\n    let inline_len = canonical_json_bytes(&payload).unwrap().len();\n    let writer = EventWriter::new(store.clone(), \"workspace-main\".to_string(), inline_len)\n        .with_flush_policy(FlushPolicy::Sync);\n\n    writer.append(base_envelope(payload)).unwrap();\n\n    let rows = store.query_events_by_session(\"session-main\", 10).unwrap();\n    assert!(rows[0].payload_inline.is_some());\n    assert!(rows[0].payload_spill_id.is_none());\n\n    let spill_writer =\n        EventWriter::new(store.clone(), \"workspace-main\".to_string(), inline_len - 1)\n            .with_flush_policy(FlushPolicy::Sync);\n    spill_writer\n        .append(base_envelope(assistant_task_payload()))\n        .unwrap();\n\n    let rows = store.query_events_by_session(\"session-main\", 10).unwrap();\n    assert!(rows[1].payload_inline.is_none());\n    assert!(rows[1].payload_spill_id.is_some());\n}\n\n#[test]\nfn workspace_mismatch_is_rejected() {\n    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n    let writer = EventWriter::new(store, \"workspace-main\".to_string(), 4096);\n    let mut envelope = base_envelope(assistant_task_payload());\n    envelope.workspace_id = Some(\"workspace-other\".to_string());\n\n    let error = writer\n        .append(envelope)\n        .expect_err(\"workspace mismatch should fail\");\n\n    match error {\n        EventWriteError::WorkspaceMismatch { expected, actual } => {\n            assert_eq!(expected, \"workspace-main\");\n            assert_eq!(actual, \"workspace-other\");\n        }\n        other => panic!(\"expected workspace mismatch, got {other:?}\"),\n    }\n}\n\n#[test]\nfn concurrent_appends_preserve_monotonic_row_ids() {\n    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n    let writer = Arc::new(\n        EventWriter::new(store.clone(), \"workspace-main\".to_string(), 4096)\n            .with_flush_policy(FlushPolicy::Sync),\n    );\n\n    let first = {\n        let writer = writer.clone();\n        thread::spawn(move || {\n            for index in 0..10 {\n                let mut envelope = base_envelope(assistant_task_payload());\n                envelope.session_id = SessionId {\n                    value: format!(\"thread-a-{index}\"),\n                };\n                writer.append(envelope).unwrap();\n            }\n        })\n    };\n    let second = {\n        let writer = writer.clone();\n        thread::spawn(move || {\n            for index in 0..10 {\n                let mut envelope = base_envelope(assistant_task_payload());\n                envelope.session_id = SessionId {\n                    value: format!(\"thread-b-{index}\"),\n                };\n                writer.append(envelope).unwrap();\n            }\n        })\n    };\n\n    first.join().unwrap();\n    second.join().unwrap();\n\n    let rows = store.with_connection(|conn| {\n        let mut statement = conn\n            .prepare(\"SELECT event_id FROM events ORDER BY event_id ASC\")\n            .unwrap();\n        statement\n            .query_map([], |row| row.get::<_, i64>(0))\n            .unwrap()\n            .map(|row| row.unwrap())\n            .collect::<Vec<_>>()\n    });\n\n    assert_eq!(rows.len(), 20);\n    assert!(rows.windows(2).all(|window| window[0] < window[1]));\n}\n\n#[test]\nfn sync_flush_makes_rows_visible_to_new_connection() {\n    let path = temp_db_path(\"sync-flush\");\n    let store = Arc::new(EventStore::open(&path).expect(\"event store opens\"));\n    let writer = EventWriter::new(store, \"workspace-main\".to_string(), 4096)\n        .with_flush_policy(FlushPolicy::Sync);\n\n    let event_id = writer\n        .append(base_envelope(assistant_task_payload()))\n        .unwrap();\n    let conn = Connection::open(&path).expect(\"second connection opens\");\n    let count: i64 = conn\n        .query_row(\n            \"SELECT COUNT(*) FROM events WHERE event_uuid = ?1\",\n            [event_id.ulid.as_str()],\n            |row| row.get(0),\n        )\n        .expect(\"query succeeds\");\n\n    assert_eq!(count, 1);\n    cleanup_db_files(&path);\n}\n\n#[test]\nfn hash_payload_is_deterministic_for_typed_payloads() {\n    let payload = assistant_task_payload();\n\n    let left = hash_payload(&payload).unwrap();\n    let right = hash_payload(&payload).unwrap();\n\n    assert_eq!(left, right);\n    assert!(left.to_string().starts_with(\"sha256:\"));\n}\n\nfn base_envelope(payload: EventPayload) -> PartialEnvelope {\n    PartialEnvelope {\n        workspace_id: None,\n        branch: BranchRef {\n            name: \"main\".to_string(),\n        },\n        session_id: SessionId {\n            value: \"session-main\".to_string(),\n        },\n        task_id: None,\n        actor: Actor::Assistant {\n            model: \"gpt-5.5\".to_string(),\n        },\n        kind: payload.kind(),\n        references: Vec::new(),\n        summary: CompactSummary::new(\"event summary\").unwrap(),\n        payload,\n    }\n}\n\nfn assistant_task_payload() -> EventPayload {\n    EventPayload::AssistantTaskStarted(AssistantTaskStartedPayload {\n        context_handle_id: None,\n        seed_event_ids: Vec::new(),\n        initial_memory_ids: Vec::new(),\n        objective: \"measure writer\".to_string(),\n    })\n}\n\nfn large_payload_envelope(session_id: &str) -> PartialEnvelope {\n    let mut envelope = base_envelope(EventPayload::AssistantTaskStarted(\n        AssistantTaskStartedPayload {\n            context_handle_id: None,\n            seed_event_ids: Vec::new(),\n            initial_memory_ids: Vec::new(),\n            objective: \"x\".repeat(5000),\n        },\n    ));\n    envelope.session_id = SessionId {\n        value: session_id.to_string(),\n    };\n    envelope\n}\n\nfn payload_row_count(conn: &Connection) -> i64 {\n    conn.query_row(\"SELECT COUNT(*) FROM event_payloads\", [], |row| row.get(0))\n        .unwrap()\n}\n\nfn temp_db_path(test_name: &str) -> PathBuf {\n    let micros = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_micros();\n    std::env::temp_dir().join(format!(\n        \"lattice-event-writer-{test_name}-{}-{micros}.db\",\n        std::process::id()\n    ))\n}\n\nfn cleanup_db_files(path: &PathBuf) {\n    let _ = fs::remove_file(path);\n    let _ = fs::remove_file(path.with_extension(\"db-wal\"));\n    let _ = fs::remove_file(path.with_extension(\"db-shm\"));\n}\n","numLines":248,"startLine":1,"totalLines":248}}}
