{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SaPQsE5su3U1gaKRcMQX3M","type":"tool_result","content":"1\tuse std::collections::VecDeque;\n2\tuse std::sync::Arc;\n3\t\n4\tuse rusqlite::types::Value;\n5\tuse rusqlite::{params_from_iter, Connection};\n6\tuse sha2::{Digest, Sha256};\n7\tuse tracing::{debug_span, warn};\n8\t\n9\tuse crate::events::hashing::PayloadHash;\n10\tuse crate::events::kinds::{EventKind, EventPayload};\n11\tuse crate::events::query::{\n12\t    branch_ref, event_id, session_id, task_id, workspace_id, EventQuery, EventQueryError,\n13\t    QueryOrder, TailScope,\n14\t};\n15\tuse crate::events::{Actor, CompactSummary, EventEnvelope, EventModelError, EventStore, StableRef};\n16\tuse crate::{DateTime, Utc};\n17\t\n18\tpub struct EventReader {\n19\t    store: Arc<EventStore>,\n20\t}\n21\t\n22\t#[derive(Clone, Debug)]\n23\tstruct QueryPlan {\n24\t    query: EventQuery,\n25\t    limit: usize,\n26\t}\n27\t\n28\t#[derive(Clone, Copy, Debug)]\n29\tstruct Cursor {\n30\t    row_id: i64,\n31\t}\n32\t\n33\tstruct EventRowData {\n34\t    row_id: i64,\n35\t    event_uuid: String,\n36\t    workspace_id: String,\n37\t    branch: String,\n38\t    session_id: String,\n39\t    task_id: Option<String>,\n40\t    actor_kind: String,\n41\t    actor_detail: Option<String>,\n42\t    kind: String,\n43\t    ts_unix_micros: i64,\n44\t    payload_hash: Vec<u8>,\n45\t    summary: String,\n46\t    payload_inline: Option<Vec<u8>>,\n47\t    payload_spill_id: Option<i64>,\n48\t    references_json: String,\n49\t    schema_version: i64,\n50\t    spilled_payload_hash: Option<Vec<u8>>,\n51\t    spilled_payload_bytes: Option<Vec<u8>>,\n52\t}\n53\t\n54\tpub struct EventStream {\n55\t    store: Arc<EventStore>,\n56\t    plan: QueryPlan,\n57\t    cursor: Option<Cursor>,\n58\t    buffer: VecDeque<Result<EventEnvelope, EventQueryError>>,\n59\t    exhausted: bool,\n60\t}\n61\t\n62\timpl EventReader {\n63\t    pub fn new(store: Arc<EventStore>) -> Self {\n64\t        Self { store }\n65\t    }\n66\t\n67\t    pub fn execute(&self, query: EventQuery) -> Result<Vec<EventEnvelope>, EventQueryError> {\n68\t        let plan = QueryPlan::new(query)?;\n69\t        let _span =\n70\t            debug_span!(\"event_reader.execute\", scope = %plan.query.trace_scope()).entered();\n71\t        self.fetch_page(&plan, None)\n72\t    }\n73\t\n74\t    pub fn stream(&self, query: EventQuery) -> EventStream {\n75\t        let stream_plan = QueryPlan::new(query);\n76\t        match stream_plan {\n77\t            Ok(plan) => EventStream {\n78\t                store: self.store.clone(),\n79\t                plan,\n80\t                cursor: None,\n81\t                buffer: VecDeque::new(),\n82\t                exhausted: false,\n83\t            },\n84\t            Err(error) => EventStream {\n85\t                store: self.store.clone(),\n86\t                plan: QueryPlan::fallback(),\n87\t                cursor: None,\n88\t                buffer: VecDeque::from([Err(error)]),\n89\t                exhausted: true,\n90\t            },\n91\t        }\n92\t    }\n93\t\n94\t    pub fn tail<S>(&self, scope: S, n: usize) -> Result<Vec<EventEnvelope>, EventQueryError>\n95\t    where\n96\t        S: Into<TailScope>,\n97\t    {\n98\t        let limit = n.max(1);\n99\t        let query = match scope.into() {\n100\t            TailScope::Task(scope) => EventQuery::new().task(scope.task_id.value),\n101\t            TailScope::Session(scope) => EventQuery::new().session(scope.session_id.value),\n102\t        }\n103\t        .limit(limit)\n104\t        .order(QueryOrder::NewestFirst);\n105\t        self.execute(query)\n106\t    }\n107\t\n108\t    fn fetch_page(\n109\t        &self,\n110\t        plan: &QueryPlan,\n111\t        cursor: Option<Cursor>,\n112\t    ) -> Result<Vec<EventEnvelope>, EventQueryError> {\n113\t        let conn = self.store.lock_conn()?;\n114\t        query_rows(&conn, plan, cursor)?\n115\t            .into_iter()\n116\t            .map(to_envelope)\n117\t            .collect()\n118\t    }\n119\t}\n120\t\n121\timpl Iterator for EventStream {\n122\t    type Item = Result<EventEnvelope, EventQueryError>;\n123\t\n124\t    fn next(&mut self) -> Option<Self::Item> {\n125\t        if let Some(item) = self.buffer.pop_front() {\n126\t            return Some(item);\n127\t        }\n128\t        if self.exhausted {\n129\t            return None;\n130\t        }\n131\t\n132\t        let conn = match self.store.lock_conn() {\n133\t            Ok(conn) => conn,\n134\t            Err(error) => {\n135\t                self.exhausted = true;\n136\t                return Some(Err(EventQueryError::Storage(error)));\n137\t            }\n138\t        };\n139\t        let rows = match query_rows(&conn, &self.plan, self.cursor) {\n140\t            Ok(rows) => rows,\n141\t            Err(error) => {\n142\t                self.exhausted = true;\n143\t                return Some(Err(error));\n144\t            }\n145\t        };\n146\t        if rows.is_empty() {\n147\t            self.exhausted = true;\n148\t            return None;\n149\t        }\n150\t\n151\t        self.cursor = rows.last().map(cursor_from_row);\n152\t        self.exhausted = rows.len() < self.plan.limit;\n153\t        self.buffer = rows.into_iter().map(to_envelope).collect();\n154\t        self.buffer.pop_front()\n155\t    }\n156\t}\n157\t\n158\timpl QueryPlan {\n159\t    fn new(query: EventQuery) -> Result<Self, EventQueryError> {\n160\t        query.validate()?;\n161\t        Ok(Self {\n162\t            limit: query.limit_or_default(),\n163\t            query,\n164\t        })\n165\t    }\n166\t\n167\t    fn fallback() -> Self {\n168\t        Self {\n169\t            query: EventQuery::new().task(\"__invalid__\"),\n170\t            limit: 1,\n171\t        }\n172\t    }\n173\t}\n174\t\n175\tfn query_rows(\n176\t    conn: &Connection,\n177\t    plan: &QueryPlan,\n178\t    cursor: Option<Cursor>,\n179\t) -> Result<Vec<EventRowData>, EventQueryError> {\n180\t    let (sql, params) = build_sql(plan, cursor);\n181\t    let mut statement = conn.prepare(&sql).map_err(sqlite_error)?;\n182\t    let rows = statement\n183\t        .query_map(params_from_iter(params), read_row)\n184\t        .map_err(sqlite_error)?;\n185\t    let mut events = Vec::new();\n186\t    for row in rows {\n187\t        events.push(row.map_err(sqlite_error)?);\n188\t    }\n189\t    Ok(events)\n190\t}\n191\t\n192\tfn build_sql(plan: &QueryPlan, cursor: Option<Cursor>) -> (String, Vec<Value>) {\n193\t    let mut sql = String::from(\n194\t        \"SELECT e.event_id, e.event_uuid, e.workspace_id, e.branch, e.session_id, e.task_id, \\\n195\t         e.actor_kind, e.actor_detail, e.kind, e.ts_unix_micros, e.payload_hash, e.summary, \\\n196\t         e.payload_inline, e.payload_spill_id, e.references_json, e.schema_version, \\\n197\t         p.payload_hash, p.bytes \\\n198\t         FROM events e \\\n199\t         LEFT JOIN event_payloads p ON p.row_id = e.payload_spill_id \\\n200\t         WHERE \",\n201\t    );\n202\t    let mut params = Vec::new();\n203\t    push_scope_clause(&mut sql, &mut params, &plan.query);\n204\t    push_kind_clause(&mut sql, &mut params, &plan.query.kinds);\n205\t    push_time_clause(\n206\t        &mut sql,\n207\t        &mut params,\n208\t        \"e.ts_unix_micros > ?\",\n209\t        plan.query.after,\n210\t    );\n211\t    push_time_clause(\n212\t        &mut sql,\n213\t        &mut params,\n214\t        \"e.ts_unix_micros < ?\",\n215\t        plan.query.before,\n216\t    );\n217\t    push_cursor_clause(&mut sql, &mut params, plan.query.order_or_default(), cursor);\n218\t    push_order_clause(&mut sql, plan.query.order_or_default());\n219\t    sql.push_str(\" LIMIT ?\");\n220\t    params.push(Value::Integer(plan.limit as i64));\n221\t    (sql, params)\n222\t}\n223\t\n224\tfn push_scope_clause(sql: &mut String, params: &mut Vec<Value>, query: &EventQuery) {\n225\t    if let Some(task_id) = &query.task_id {\n226\t        sql.push_str(\"e.task_id = ?\");\n227\t        params.push(Value::Text(task_id.clone()));\n228\t        if let Some(session_id) = &query.session_id {\n229\t            sql.push_str(\" AND e.session_id = ?\");\n230\t            params.push(Value::Text(session_id.clone()));\n231\t        }\n232\t        if let Some(workspace_id) = &query.workspace_id {\n233\t            sql.push_str(\" AND e.workspace_id = ?\");\n234\t            params.push(Value::Text(workspace_id.clone()));\n235\t        }\n236\t        if let Some(branch) = &query.branch {\n237\t            sql.push_str(\" AND e.branch = ?\");\n238\t            params.push(Value::Text(branch.clone()));\n239\t        }\n240\t    } else if let Some(session_id) = &query.session_id {\n241\t        sql.push_str(\"e.session_id = ?\");\n242\t        params.push(Value::Text(session_id.clone()));\n243\t        if let Some(workspace_id) = &query.workspace_id {\n244\t            sql.push_str(\" AND e.workspace_id = ?\");\n245\t            params.push(Value::Text(workspace_id.clone()));\n246\t        }\n247\t        if let Some(branch) = &query.branch {\n248\t            sql.push_str(\" AND e.branch = ?\");\n249\t            params.push(Value::Text(branch.clone()));\n250\t        }\n251\t    } else {\n252\t        sql.push_str(\"e.workspace_id = ? AND e.branch = ?\");\n253\t        params.push(Value::Text(query.workspace_id.clone().unwrap_or_default()));\n254\t        params.push(Value::Text(query.branch.clone().unwrap_or_default()));\n255\t    }\n256\t}\n257\t\n258\tfn push_kind_clause(sql: &mut String, params: &mut Vec<Value>, kinds: &[EventKind]) {\n259\t    if kinds.is_empty() {\n260\t        return;\n261\t    }\n262\t    sql.push_str(\" AND e.kind IN (\");\n263\t    for (index, kind) in kinds.iter().enumerate() {\n264\t        if index > 0 {\n265\t            sql.push_str(\", \");\n266\t        }\n267\t        sql.push('?');\n268\t        params.push(Value::Text(kind.as_str().to_string()));\n269\t    }\n270\t    sql.push(')');\n271\t}\n272\t\n273\tfn push_time_clause(\n274\t    sql: &mut String,\n275\t    params: &mut Vec<Value>,\n276\t    clause: &str,\n277\t    timestamp: Option<DateTime<Utc>>,\n278\t) {\n279\t    if let Some(timestamp) = timestamp {\n280\t        sql.push_str(\" AND \");\n281\t        sql.push_str(clause);\n282\t        params.push(Value::Integer(timestamp.unix_seconds() * 1_000_000));\n283\t    }\n284\t}\n285\t\n286\tfn push_cursor_clause(\n287\t    sql: &mut String,\n288\t    params: &mut Vec<Value>,\n289\t    order: QueryOrder,\n290\t    cursor: Option<Cursor>,\n291\t) {\n292\t    let Some(cursor) = cursor else {\n293\t        return;\n294\t    };\n295\t    let comparator = match order {\n296\t        QueryOrder::OldestFirst => \">\",\n297\t        QueryOrder::NewestFirst => \"<\",\n298\t    };\n299\t    sql.push_str(\" AND e.event_id \");\n300\t    sql.push_str(comparator);\n301\t    sql.push_str(\" ?\");\n302\t    params.push(Value::Integer(cursor.row_id));\n303\t}\n304\t\n305\tfn push_order_clause(sql: &mut String, order: QueryOrder) {\n306\t    match order {\n307\t        QueryOrder::OldestFirst => {\n308\t            sql.push_str(\" ORDER BY e.event_id ASC\");\n309\t        }\n310\t        QueryOrder::NewestFirst => {\n311\t            sql.push_str(\" ORDER BY e.event_id DESC\");\n312\t        }\n313\t    }\n314\t}\n315\t\n316\tfn read_row(row: &rusqlite::Row<'_>) -> rusqlite::Result<EventRowData> {\n317\t    Ok(EventRowData {\n318\t        row_id: row.get(0)?,\n319\t        event_uuid: row.get(1)?,\n320\t        workspace_id: row.get(2)?,\n321\t        branch: row.get(3)?,\n322\t        session_id: row.get(4)?,\n323\t        task_id: row.get(5)?,\n324\t        actor_kind: row.get(6)?,\n325\t        actor_detail: row.get(7)?,\n326\t        kind: row.get(8)?,\n327\t        ts_unix_micros: row.get(9)?,\n328\t        payload_hash: row.get(10)?,\n329\t        summary: row.get(11)?,\n330\t        payload_inline: row.get(12)?,\n331\t        payload_spill_id: row.get(13)?,\n332\t        references_json: row.get(14)?,\n333\t        schema_version: row.get(15)?,\n334\t        spilled_payload_hash: row.get(16)?,\n335\t        spilled_payload_bytes: row.get(17)?,\n336\t    })\n337\t}\n338\t\n339\tfn to_envelope(row: EventRowData) -> Result<EventEnvelope, EventQueryError> {\n340\t    let expected = payload_hash_from_db(&row.payload_hash)?;\n341\t    validate_row_metadata(&row, expected)?;\n342\t    let payload_bytes = payload_bytes(&row)?;\n343\t    let actual = hash_bytes(payload_bytes);\n344\t    if expected != actual {\n345\t        let stable_event_id = event_id(&row.workspace_id, &row.event_uuid);\n346\t        warn!(\n347\t            event_id = ?stable_event_id,\n348\t            expected = %expected,\n349\t            actual = %actual,\n350\t            \"event payload hash mismatch while reading event log\"\n351\t        );\n352\t        return Err(EventQueryError::PayloadCorruption {\n353\t            event_id: stable_event_id,\n354\t            expected,\n355\t            actual,\n356\t        });\n357\t    }\n358\t\n359\t    let payload: EventPayload = serde_json::from_slice(payload_bytes)?;\n360\t    let references: Vec<StableRef> = serde_json::from_str(&row.references_json)?;\n361\t    let actor = parse_actor(&row.actor_kind, row.actor_detail.as_deref())?;\n362\t    let kind = row.kind.parse::<EventKind>().map_err(storage_invalid)?;\n363\t    let payload_location = payload_location(&row);\n364\t    let summary = CompactSummary::new(row.summary).map_err(model_invalid)?;\n365\t    EventEnvelope::new(\n366\t        event_id(&row.workspace_id, &row.event_uuid),\n367\t        workspace_id(&row.workspace_id),\n368\t        branch_ref(&row.branch),\n369\t        session_id(&row.session_id),\n370\t        row.task_id.as_deref().map(task_id),\n371\t        actor,\n372\t        DateTime::from_unix_seconds(row.ts_unix_micros / 1_000_000),\n373\t        kind,\n374\t        references,\n375\t        expected,\n376\t        summary,\n377\t        payload_location,\n378\t        payload,\n379\t    )\n380\t    .map_err(model_invalid)\n381\t}\n382\t\n383\tfn payload_bytes(row: &EventRowData) -> Result<&[u8], EventQueryError> {\n384\t    if let Some(bytes) = row.payload_inline.as_deref() {\n385\t        return Ok(bytes);\n386\t    }\n387\t    if let Some(bytes) = row.spilled_payload_bytes.as_deref() {\n388\t        return Ok(bytes);\n389\t    }\n390\t    Err(storage_invalid(format!(\n391\t        \"spilled payload for event `{}` row {} is missing\",\n392\t        row.event_uuid,\n393\t        row.payload_spill_id.unwrap_or_default()\n394\t    )))\n395\t}\n396\t\n397\tfn payload_location(row: &EventRowData) -> crate::events::PayloadLocation {\n398\t    if let Some(bytes) = &row.payload_inline {\n399\t        return crate::events::PayloadLocation::Inline {\n400\t            bytes_len: bytes.len() as u32,\n401\t        };\n402\t    }\n403\t    crate::events::PayloadLocation::Spilled {\n404\t        row_id: row.payload_spill_id.unwrap_or_default(),\n405\t    }\n406\t}\n407\t\n408\tfn payload_hash_from_db(bytes: &[u8]) -> Result<PayloadHash, EventQueryError> {\n409\t    let array: [u8; 32] = bytes.try_into().map_err(|_| {\n410\t        storage_invalid(format!(\n411\t            \"payload_hash stored {} bytes; expected 32 bytes\",\n412\t            bytes.len()\n413\t        ))\n414\t    })?;\n415\t    Ok(PayloadHash::new(array))\n416\t}\n417\t\n418\tfn hash_bytes(bytes: &[u8]) -> PayloadHash {\n419\t    let digest = Sha256::digest(bytes);\n420\t    let mut hash = [0_u8; 32];\n421\t    hash.copy_from_slice(&digest);\n422\t    PayloadHash::new(hash)\n423\t}\n424\t\n425\tfn parse_actor(kind: &str, detail: Option<&str>) -> Result<Actor, EventQueryError> {\n426\t    match (kind, detail) {\n427\t        (\"assistant\", Some(model)) => Ok(Actor::Assistant {\n428\t            model: model.to_string(),\n429\t        }),\n430\t        (\"assistant\", None) => Err(storage_invalid(\"assistant actor is missing model detail\")),\n431\t        (\"user\", _) => Ok(Actor::User),\n432\t        (\"tool\", Some(name)) => Ok(Actor::Tool {\n433\t            name: name.to_string(),\n434\t        }),\n435\t        (\"tool\", None) => Err(storage_invalid(\"tool actor is missing name detail\")),\n436\t        (\"daemon\", _) => Ok(Actor::Daemon),\n437\t        (other, _) => Err(storage_invalid(format!(\"unknown actor kind `{other}`\"))),\n438\t    }\n439\t}\n440\t\n441\tfn cursor_from_row(row: &EventRowData) -> Cursor {\n442\t    Cursor {\n443\t        row_id: row.row_id,\n444\t    }\n445\t}\n446\t\n447\tfn storage_invalid(reason: impl Into<String>) -> EventQueryError {\n448\t    EventQueryError::Storage(crate::events::EventStoreError::EnvelopeInvalid {\n449\t        reason: reason.into(),\n450\t    })\n451\t}\n452\t\n453\tfn validate_row_metadata(row: &EventRowData, expected: PayloadHash) -> Result<(), EventQueryError> {\n454\t    if row.schema_version <= 0 {\n455\t        return Err(storage_invalid(format!(\n456\t            \"event `{}` has invalid schema_version {}\",\n457\t            row.event_uuid, row.schema_version\n458\t        )));\n459\t    }\n460\t    if let Some(bytes) = row.spilled_payload_hash.as_deref() {\n461\t        let spilled_hash = payload_hash_from_db(bytes)?;\n462\t        if spilled_hash != expected {\n463\t            return Err(storage_invalid(format!(\n464\t                \"spill row hash for event `{}` does not match envelope hash\",\n465\t                row.event_uuid\n466\t            )));\n467\t        }\n468\t    }\n469\t    Ok(())\n470\t}\n471\t\n472\tfn model_invalid(error: EventModelError) -> EventQueryError {\n473\t    storage_invalid(error.to_string())\n474\t}\n475\t\n476\tfn sqlite_error(error: rusqlite::Error) -> EventQueryError {\n477\t    EventQueryError::Storage(crate::events::EventStoreError::Sqlite(error))\n478\t}\n479\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"ca2c1f68-b333-49c1-a599-5ae531052ee5","timestamp":"2026-05-17T05:58:35.612Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/reader.rs","content":"use std::collections::VecDeque;\nuse std::sync::Arc;\n\nuse rusqlite::types::Value;\nuse rusqlite::{params_from_iter, Connection};\nuse sha2::{Digest, Sha256};\nuse tracing::{debug_span, warn};\n\nuse crate::events::hashing::PayloadHash;\nuse crate::events::kinds::{EventKind, EventPayload};\nuse crate::events::query::{\n    branch_ref, event_id, session_id, task_id, workspace_id, EventQuery, EventQueryError,\n    QueryOrder, TailScope,\n};\nuse crate::events::{Actor, CompactSummary, EventEnvelope, EventModelError, EventStore, StableRef};\nuse crate::{DateTime, Utc};\n\npub struct EventReader {\n    store: Arc<EventStore>,\n}\n\n#[derive(Clone, Debug)]\nstruct QueryPlan {\n    query: EventQuery,\n    limit: usize,\n}\n\n#[derive(Clone, Copy, Debug)]\nstruct Cursor {\n    row_id: i64,\n}\n\nstruct EventRowData {\n    row_id: i64,\n    event_uuid: String,\n    workspace_id: String,\n    branch: String,\n    session_id: String,\n    task_id: Option<String>,\n    actor_kind: String,\n    actor_detail: Option<String>,\n    kind: String,\n    ts_unix_micros: i64,\n    payload_hash: Vec<u8>,\n    summary: String,\n    payload_inline: Option<Vec<u8>>,\n    payload_spill_id: Option<i64>,\n    references_json: String,\n    schema_version: i64,\n    spilled_payload_hash: Option<Vec<u8>>,\n    spilled_payload_bytes: Option<Vec<u8>>,\n}\n\npub struct EventStream {\n    store: Arc<EventStore>,\n    plan: QueryPlan,\n    cursor: Option<Cursor>,\n    buffer: VecDeque<Result<EventEnvelope, EventQueryError>>,\n    exhausted: bool,\n}\n\nimpl EventReader {\n    pub fn new(store: Arc<EventStore>) -> Self {\n        Self { store }\n    }\n\n    pub fn execute(&self, query: EventQuery) -> Result<Vec<EventEnvelope>, EventQueryError> {\n        let plan = QueryPlan::new(query)?;\n        let _span =\n            debug_span!(\"event_reader.execute\", scope = %plan.query.trace_scope()).entered();\n        self.fetch_page(&plan, None)\n    }\n\n    pub fn stream(&self, query: EventQuery) -> EventStream {\n        let stream_plan = QueryPlan::new(query);\n        match stream_plan {\n            Ok(plan) => EventStream {\n                store: self.store.clone(),\n                plan,\n                cursor: None,\n                buffer: VecDeque::new(),\n                exhausted: false,\n            },\n            Err(error) => EventStream {\n                store: self.store.clone(),\n                plan: QueryPlan::fallback(),\n                cursor: None,\n                buffer: VecDeque::from([Err(error)]),\n                exhausted: true,\n            },\n        }\n    }\n\n    pub fn tail<S>(&self, scope: S, n: usize) -> Result<Vec<EventEnvelope>, EventQueryError>\n    where\n        S: Into<TailScope>,\n    {\n        let limit = n.max(1);\n        let query = match scope.into() {\n            TailScope::Task(scope) => EventQuery::new().task(scope.task_id.value),\n            TailScope::Session(scope) => EventQuery::new().session(scope.session_id.value),\n        }\n        .limit(limit)\n        .order(QueryOrder::NewestFirst);\n        self.execute(query)\n    }\n\n    fn fetch_page(\n        &self,\n        plan: &QueryPlan,\n        cursor: Option<Cursor>,\n    ) -> Result<Vec<EventEnvelope>, EventQueryError> {\n        let conn = self.store.lock_conn()?;\n        query_rows(&conn, plan, cursor)?\n            .into_iter()\n            .map(to_envelope)\n            .collect()\n    }\n}\n\nimpl Iterator for EventStream {\n    type Item = Result<EventEnvelope, EventQueryError>;\n\n    fn next(&mut self) -> Option<Self::Item> {\n        if let Some(item) = self.buffer.pop_front() {\n            return Some(item);\n        }\n        if self.exhausted {\n            return None;\n        }\n\n        let conn = match self.store.lock_conn() {\n            Ok(conn) => conn,\n            Err(error) => {\n                self.exhausted = true;\n                return Some(Err(EventQueryError::Storage(error)));\n            }\n        };\n        let rows = match query_rows(&conn, &self.plan, self.cursor) {\n            Ok(rows) => rows,\n            Err(error) => {\n                self.exhausted = true;\n                return Some(Err(error));\n            }\n        };\n        if rows.is_empty() {\n            self.exhausted = true;\n            return None;\n        }\n\n        self.cursor = rows.last().map(cursor_from_row);\n        self.exhausted = rows.len() < self.plan.limit;\n        self.buffer = rows.into_iter().map(to_envelope).collect();\n        self.buffer.pop_front()\n    }\n}\n\nimpl QueryPlan {\n    fn new(query: EventQuery) -> Result<Self, EventQueryError> {\n        query.validate()?;\n        Ok(Self {\n            limit: query.limit_or_default(),\n            query,\n        })\n    }\n\n    fn fallback() -> Self {\n        Self {\n            query: EventQuery::new().task(\"__invalid__\"),\n            limit: 1,\n        }\n    }\n}\n\nfn query_rows(\n    conn: &Connection,\n    plan: &QueryPlan,\n    cursor: Option<Cursor>,\n) -> Result<Vec<EventRowData>, EventQueryError> {\n    let (sql, params) = build_sql(plan, cursor);\n    let mut statement = conn.prepare(&sql).map_err(sqlite_error)?;\n    let rows = statement\n        .query_map(params_from_iter(params), read_row)\n        .map_err(sqlite_error)?;\n    let mut events = Vec::new();\n    for row in rows {\n        events.push(row.map_err(sqlite_error)?);\n    }\n    Ok(events)\n}\n\nfn build_sql(plan: &QueryPlan, cursor: Option<Cursor>) -> (String, Vec<Value>) {\n    let mut sql = String::from(\n        \"SELECT e.event_id, e.event_uuid, e.workspace_id, e.branch, e.session_id, e.task_id, \\\n         e.actor_kind, e.actor_detail, e.kind, e.ts_unix_micros, e.payload_hash, e.summary, \\\n         e.payload_inline, e.payload_spill_id, e.references_json, e.schema_version, \\\n         p.payload_hash, p.bytes \\\n         FROM events e \\\n         LEFT JOIN event_payloads p ON p.row_id = e.payload_spill_id \\\n         WHERE \",\n    );\n    let mut params = Vec::new();\n    push_scope_clause(&mut sql, &mut params, &plan.query);\n    push_kind_clause(&mut sql, &mut params, &plan.query.kinds);\n    push_time_clause(\n        &mut sql,\n        &mut params,\n        \"e.ts_unix_micros > ?\",\n        plan.query.after,\n    );\n    push_time_clause(\n        &mut sql,\n        &mut params,\n        \"e.ts_unix_micros < ?\",\n        plan.query.before,\n    );\n    push_cursor_clause(&mut sql, &mut params, plan.query.order_or_default(), cursor);\n    push_order_clause(&mut sql, plan.query.order_or_default());\n    sql.push_str(\" LIMIT ?\");\n    params.push(Value::Integer(plan.limit as i64));\n    (sql, params)\n}\n\nfn push_scope_clause(sql: &mut String, params: &mut Vec<Value>, query: &EventQuery) {\n    if let Some(task_id) = &query.task_id {\n        sql.push_str(\"e.task_id = ?\");\n        params.push(Value::Text(task_id.clone()));\n        if let Some(session_id) = &query.session_id {\n            sql.push_str(\" AND e.session_id = ?\");\n            params.push(Value::Text(session_id.clone()));\n        }\n        if let Some(workspace_id) = &query.workspace_id {\n            sql.push_str(\" AND e.workspace_id = ?\");\n            params.push(Value::Text(workspace_id.clone()));\n        }\n        if let Some(branch) = &query.branch {\n            sql.push_str(\" AND e.branch = ?\");\n            params.push(Value::Text(branch.clone()));\n        }\n    } else if let Some(session_id) = &query.session_id {\n        sql.push_str(\"e.session_id = ?\");\n        params.push(Value::Text(session_id.clone()));\n        if let Some(workspace_id) = &query.workspace_id {\n            sql.push_str(\" AND e.workspace_id = ?\");\n            params.push(Value::Text(workspace_id.clone()));\n        }\n        if let Some(branch) = &query.branch {\n            sql.push_str(\" AND e.branch = ?\");\n            params.push(Value::Text(branch.clone()));\n        }\n    } else {\n        sql.push_str(\"e.workspace_id = ? AND e.branch = ?\");\n        params.push(Value::Text(query.workspace_id.clone().unwrap_or_default()));\n        params.push(Value::Text(query.branch.clone().unwrap_or_default()));\n    }\n}\n\nfn push_kind_clause(sql: &mut String, params: &mut Vec<Value>, kinds: &[EventKind]) {\n    if kinds.is_empty() {\n        return;\n    }\n    sql.push_str(\" AND e.kind IN (\");\n    for (index, kind) in kinds.iter().enumerate() {\n        if index > 0 {\n            sql.push_str(\", \");\n        }\n        sql.push('?');\n        params.push(Value::Text(kind.as_str().to_string()));\n    }\n    sql.push(')');\n}\n\nfn push_time_clause(\n    sql: &mut String,\n    params: &mut Vec<Value>,\n    clause: &str,\n    timestamp: Option<DateTime<Utc>>,\n) {\n    if let Some(timestamp) = timestamp {\n        sql.push_str(\" AND \");\n        sql.push_str(clause);\n        params.push(Value::Integer(timestamp.unix_seconds() * 1_000_000));\n    }\n}\n\nfn push_cursor_clause(\n    sql: &mut String,\n    params: &mut Vec<Value>,\n    order: QueryOrder,\n    cursor: Option<Cursor>,\n) {\n    let Some(cursor) = cursor else {\n        return;\n    };\n    let comparator = match order {\n        QueryOrder::OldestFirst => \">\",\n        QueryOrder::NewestFirst => \"<\",\n    };\n    sql.push_str(\" AND e.event_id \");\n    sql.push_str(comparator);\n    sql.push_str(\" ?\");\n    params.push(Value::Integer(cursor.row_id));\n}\n\nfn push_order_clause(sql: &mut String, order: QueryOrder) {\n    match order {\n        QueryOrder::OldestFirst => {\n            sql.push_str(\" ORDER BY e.event_id ASC\");\n        }\n        QueryOrder::NewestFirst => {\n            sql.push_str(\" ORDER BY e.event_id DESC\");\n        }\n    }\n}\n\nfn read_row(row: &rusqlite::Row<'_>) -> rusqlite::Result<EventRowData> {\n    Ok(EventRowData {\n        row_id: row.get(0)?,\n        event_uuid: row.get(1)?,\n        workspace_id: row.get(2)?,\n        branch: row.get(3)?,\n        session_id: row.get(4)?,\n        task_id: row.get(5)?,\n        actor_kind: row.get(6)?,\n        actor_detail: row.get(7)?,\n        kind: row.get(8)?,\n        ts_unix_micros: row.get(9)?,\n        payload_hash: row.get(10)?,\n        summary: row.get(11)?,\n        payload_inline: row.get(12)?,\n        payload_spill_id: row.get(13)?,\n        references_json: row.get(14)?,\n        schema_version: row.get(15)?,\n        spilled_payload_hash: row.get(16)?,\n        spilled_payload_bytes: row.get(17)?,\n    })\n}\n\nfn to_envelope(row: EventRowData) -> Result<EventEnvelope, EventQueryError> {\n    let expected = payload_hash_from_db(&row.payload_hash)?;\n    validate_row_metadata(&row, expected)?;\n    let payload_bytes = payload_bytes(&row)?;\n    let actual = hash_bytes(payload_bytes);\n    if expected != actual {\n        let stable_event_id = event_id(&row.workspace_id, &row.event_uuid);\n        warn!(\n            event_id = ?stable_event_id,\n            expected = %expected,\n            actual = %actual,\n            \"event payload hash mismatch while reading event log\"\n        );\n        return Err(EventQueryError::PayloadCorruption {\n            event_id: stable_event_id,\n            expected,\n            actual,\n        });\n    }\n\n    let payload: EventPayload = serde_json::from_slice(payload_bytes)?;\n    let references: Vec<StableRef> = serde_json::from_str(&row.references_json)?;\n    let actor = parse_actor(&row.actor_kind, row.actor_detail.as_deref())?;\n    let kind = row.kind.parse::<EventKind>().map_err(storage_invalid)?;\n    let payload_location = payload_location(&row);\n    let summary = CompactSummary::new(row.summary).map_err(model_invalid)?;\n    EventEnvelope::new(\n        event_id(&row.workspace_id, &row.event_uuid),\n        workspace_id(&row.workspace_id),\n        branch_ref(&row.branch),\n        session_id(&row.session_id),\n        row.task_id.as_deref().map(task_id),\n        actor,\n        DateTime::from_unix_seconds(row.ts_unix_micros / 1_000_000),\n        kind,\n        references,\n        expected,\n        summary,\n        payload_location,\n        payload,\n    )\n    .map_err(model_invalid)\n}\n\nfn payload_bytes(row: &EventRowData) -> Result<&[u8], EventQueryError> {\n    if let Some(bytes) = row.payload_inline.as_deref() {\n        return Ok(bytes);\n    }\n    if let Some(bytes) = row.spilled_payload_bytes.as_deref() {\n        return Ok(bytes);\n    }\n    Err(storage_invalid(format!(\n        \"spilled payload for event `{}` row {} is missing\",\n        row.event_uuid,\n        row.payload_spill_id.unwrap_or_default()\n    )))\n}\n\nfn payload_location(row: &EventRowData) -> crate::events::PayloadLocation {\n    if let Some(bytes) = &row.payload_inline {\n        return crate::events::PayloadLocation::Inline {\n            bytes_len: bytes.len() as u32,\n        };\n    }\n    crate::events::PayloadLocation::Spilled {\n        row_id: row.payload_spill_id.unwrap_or_default(),\n    }\n}\n\nfn payload_hash_from_db(bytes: &[u8]) -> Result<PayloadHash, EventQueryError> {\n    let array: [u8; 32] = bytes.try_into().map_err(|_| {\n        storage_invalid(format!(\n            \"payload_hash stored {} bytes; expected 32 bytes\",\n            bytes.len()\n        ))\n    })?;\n    Ok(PayloadHash::new(array))\n}\n\nfn hash_bytes(bytes: &[u8]) -> PayloadHash {\n    let digest = Sha256::digest(bytes);\n    let mut hash = [0_u8; 32];\n    hash.copy_from_slice(&digest);\n    PayloadHash::new(hash)\n}\n\nfn parse_actor(kind: &str, detail: Option<&str>) -> Result<Actor, EventQueryError> {\n    match (kind, detail) {\n        (\"assistant\", Some(model)) => Ok(Actor::Assistant {\n            model: model.to_string(),\n        }),\n        (\"assistant\", None) => Err(storage_invalid(\"assistant actor is missing model detail\")),\n        (\"user\", _) => Ok(Actor::User),\n        (\"tool\", Some(name)) => Ok(Actor::Tool {\n            name: name.to_string(),\n        }),\n        (\"tool\", None) => Err(storage_invalid(\"tool actor is missing name detail\")),\n        (\"daemon\", _) => Ok(Actor::Daemon),\n        (other, _) => Err(storage_invalid(format!(\"unknown actor kind `{other}`\"))),\n    }\n}\n\nfn cursor_from_row(row: &EventRowData) -> Cursor {\n    Cursor {\n        row_id: row.row_id,\n    }\n}\n\nfn storage_invalid(reason: impl Into<String>) -> EventQueryError {\n    EventQueryError::Storage(crate::events::EventStoreError::EnvelopeInvalid {\n        reason: reason.into(),\n    })\n}\n\nfn validate_row_metadata(row: &EventRowData, expected: PayloadHash) -> Result<(), EventQueryError> {\n    if row.schema_version <= 0 {\n        return Err(storage_invalid(format!(\n            \"event `{}` has invalid schema_version {}\",\n            row.event_uuid, row.schema_version\n        )));\n    }\n    if let Some(bytes) = row.spilled_payload_hash.as_deref() {\n        let spilled_hash = payload_hash_from_db(bytes)?;\n        if spilled_hash != expected {\n            return Err(storage_invalid(format!(\n                \"spill row hash for event `{}` does not match envelope hash\",\n                row.event_uuid\n            )));\n        }\n    }\n    Ok(())\n}\n\nfn model_invalid(error: EventModelError) -> EventQueryError {\n    storage_invalid(error.to_string())\n}\n\nfn sqlite_error(error: rusqlite::Error) -> EventQueryError {\n    EventQueryError::Storage(crate::events::EventStoreError::Sqlite(error))\n}\n","numLines":479,"startLine":1,"totalLines":479}}}
