{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SkqVH6RYAa7TRZVKYBQ6MV","type":"tool_result","content":"1\tCREATE TABLE IF NOT EXISTS event_schema_version (\n2\t    version INTEGER PRIMARY KEY,\n3\t    applied_ts_unix_micros INTEGER NOT NULL\n4\t);\n5\t\n6\tCREATE TABLE IF NOT EXISTS event_payloads (\n7\t    row_id INTEGER PRIMARY KEY AUTOINCREMENT,\n8\t    payload_hash BLOB NOT NULL UNIQUE,\n9\t    bytes BLOB NOT NULL,\n10\t    bytes_len INTEGER NOT NULL,\n11\t    created_ts_unix_micros INTEGER NOT NULL,\n12\t    CHECK (length(payload_hash) > 0),\n13\t    CHECK (bytes_len = length(bytes)),\n14\t    CHECK (created_ts_unix_micros >= 0)\n15\t);\n16\t\n17\tCREATE TABLE IF NOT EXISTS events (\n18\t    event_id INTEGER PRIMARY KEY AUTOINCREMENT,\n19\t    event_uuid TEXT NOT NULL UNIQUE,\n20\t    workspace_id TEXT NOT NULL,\n21\t    branch TEXT NOT NULL,\n22\t    session_id TEXT NOT NULL,\n23\t    task_id TEXT NULL,\n24\t    actor_kind TEXT NOT NULL,\n25\t    actor_detail TEXT NULL,\n26\t    kind TEXT NOT NULL,\n27\t    ts_unix_micros INTEGER NOT NULL,\n28\t    payload_hash BLOB NOT NULL,\n29\t    summary TEXT NOT NULL,\n30\t    payload_inline BLOB NULL,\n31\t    payload_spill_id INTEGER NULL,\n32\t    references_json TEXT NOT NULL,\n33\t    schema_version INTEGER NOT NULL,\n34\t    FOREIGN KEY (payload_spill_id) REFERENCES event_payloads(row_id),\n35\t    CHECK (event_uuid <> ''),\n36\t    CHECK (workspace_id <> ''),\n37\t    CHECK (branch <> ''),\n38\t    CHECK (session_id <> ''),\n39\t    CHECK (actor_kind <> ''),\n40\t    CHECK (kind <> ''),\n41\t    CHECK (ts_unix_micros >= 0),\n42\t    CHECK (length(payload_hash) > 0),\n43\t    CHECK (length(CAST(summary AS BLOB)) <= 512),\n44\t    CHECK (references_json <> ''),\n45\t    CHECK (schema_version > 0),\n46\t    CHECK (\n47\t        (payload_inline IS NOT NULL AND payload_spill_id IS NULL)\n48\t        OR (payload_inline IS NULL AND payload_spill_id IS NOT NULL)\n49\t    )\n50\t);\n51\t\n52\tCREATE TABLE IF NOT EXISTS event_compaction_control (\n53\t    id INTEGER PRIMARY KEY CHECK (id = 1),\n54\t    allow_delete INTEGER NOT NULL DEFAULT 0 CHECK (allow_delete IN (0, 1))\n55\t);\n56\t\n57\tINSERT OR IGNORE INTO event_compaction_control (id, allow_delete)\n58\tVALUES (1, 0);\n59\t\n60\tCREATE TRIGGER IF NOT EXISTS events_no_update\n61\tBEFORE UPDATE ON events\n62\tBEGIN\n63\t    SELECT RAISE(ABORT, 'events table is append-only');\n64\tEND;\n65\t\n66\tCREATE TRIGGER IF NOT EXISTS events_no_delete\n67\tBEFORE DELETE ON events\n68\tWHEN (SELECT allow_delete FROM event_compaction_control WHERE id = 1) != 1\n69\tBEGIN\n70\t    SELECT RAISE(ABORT, 'events table is append-only');\n71\tEND;\n72\t\n73\tCREATE INDEX IF NOT EXISTS idx_events_task\n74\t    ON events(task_id, ts_unix_micros);\n75\tCREATE INDEX IF NOT EXISTS idx_events_session\n76\t    ON events(session_id, ts_unix_micros);\n77\tCREATE INDEX IF NOT EXISTS idx_events_workspace_branch\n78\t    ON events(workspace_id, branch, ts_unix_micros);\n79\tCREATE INDEX IF NOT EXISTS idx_events_kind_ts\n80\t    ON events(kind, ts_unix_micros);\n81\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"c2cdf22d-ecd2-41c8-b512-7dff26b14e80","timestamp":"2026-05-17T05:57:47.168Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/schema.sql","content":"CREATE TABLE IF NOT EXISTS event_schema_version (\n    version INTEGER PRIMARY KEY,\n    applied_ts_unix_micros INTEGER NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS event_payloads (\n    row_id INTEGER PRIMARY KEY AUTOINCREMENT,\n    payload_hash BLOB NOT NULL UNIQUE,\n    bytes BLOB NOT NULL,\n    bytes_len INTEGER NOT NULL,\n    created_ts_unix_micros INTEGER NOT NULL,\n    CHECK (length(payload_hash) > 0),\n    CHECK (bytes_len = length(bytes)),\n    CHECK (created_ts_unix_micros >= 0)\n);\n\nCREATE TABLE IF NOT EXISTS events (\n    event_id INTEGER PRIMARY KEY AUTOINCREMENT,\n    event_uuid TEXT NOT NULL UNIQUE,\n    workspace_id TEXT NOT NULL,\n    branch TEXT NOT NULL,\n    session_id TEXT NOT NULL,\n    task_id TEXT NULL,\n    actor_kind TEXT NOT NULL,\n    actor_detail TEXT NULL,\n    kind TEXT NOT NULL,\n    ts_unix_micros INTEGER NOT NULL,\n    payload_hash BLOB NOT NULL,\n    summary TEXT NOT NULL,\n    payload_inline BLOB NULL,\n    payload_spill_id INTEGER NULL,\n    references_json TEXT NOT NULL,\n    schema_version INTEGER NOT NULL,\n    FOREIGN KEY (payload_spill_id) REFERENCES event_payloads(row_id),\n    CHECK (event_uuid <> ''),\n    CHECK (workspace_id <> ''),\n    CHECK (branch <> ''),\n    CHECK (session_id <> ''),\n    CHECK (actor_kind <> ''),\n    CHECK (kind <> ''),\n    CHECK (ts_unix_micros >= 0),\n    CHECK (length(payload_hash) > 0),\n    CHECK (length(CAST(summary AS BLOB)) <= 512),\n    CHECK (references_json <> ''),\n    CHECK (schema_version > 0),\n    CHECK (\n        (payload_inline IS NOT NULL AND payload_spill_id IS NULL)\n        OR (payload_inline IS NULL AND payload_spill_id IS NOT NULL)\n    )\n);\n\nCREATE TABLE IF NOT EXISTS event_compaction_control (\n    id INTEGER PRIMARY KEY CHECK (id = 1),\n    allow_delete INTEGER NOT NULL DEFAULT 0 CHECK (allow_delete IN (0, 1))\n);\n\nINSERT OR IGNORE INTO event_compaction_control (id, allow_delete)\nVALUES (1, 0);\n\nCREATE TRIGGER IF NOT EXISTS events_no_update\nBEFORE UPDATE ON events\nBEGIN\n    SELECT RAISE(ABORT, 'events table is append-only');\nEND;\n\nCREATE TRIGGER IF NOT EXISTS events_no_delete\nBEFORE DELETE ON events\nWHEN (SELECT allow_delete FROM event_compaction_control WHERE id = 1) != 1\nBEGIN\n    SELECT RAISE(ABORT, 'events table is append-only');\nEND;\n\nCREATE INDEX IF NOT EXISTS idx_events_task\n    ON events(task_id, ts_unix_micros);\nCREATE INDEX IF NOT EXISTS idx_events_session\n    ON events(session_id, ts_unix_micros);\nCREATE INDEX IF NOT EXISTS idx_events_workspace_branch\n    ON events(workspace_id, branch, ts_unix_micros);\nCREATE INDEX IF NOT EXISTS idx_events_kind_ts\n    ON events(kind, ts_unix_micros);\n","numLines":81,"startLine":1,"totalLines":81}}}
