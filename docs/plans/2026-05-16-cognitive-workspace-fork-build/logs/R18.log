{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Je9CJhx7RpwdFSazCUKtkk","type":"tool_result","content":"1\t//! Latency-budget tests for hot-path event capture.\n2\t//!\n3\t//! These ignored tests measure the in-process append path for `EventWriter::append`\n4\t//! without host-filesystem jitter dominating the result. The exact CPU model is\n5\t//! captured into the emitted JSON artifact under `daemon/target/event_budget/`,\n6\t//! while the writer semantics are stable here in code: SQLite, append-only rows,\n7\t//! and batched flush (`FlushPolicy::Batched`) so no per-call fsync should land on\n8\t//! `prepare_change` or `get_context_capsule`.\n9\t\n10\tuse std::fs;\n11\tuse std::path::PathBuf;\n12\tuse std::sync::Arc;\n13\tuse std::sync::{Mutex, OnceLock};\n14\tuse std::time::Instant;\n15\t\n16\tuse serde::Serialize;\n17\tuse serde_json::json;\n18\tuse super::{\n19\t    Actor, BranchRef, CompactSummary, EventPayload, EventStore, EventWriter, FlushPolicy,\n20\t    PartialEnvelope, SessionId, ToolCalledPayload,\n21\t};\n22\t\n23\tconst HOT_PATH_P99_BUDGET_MICROS: u128 = 5_000;\n24\tconst WARMUP_ITERATIONS: usize = 200;\n25\tstatic BUDGET_TEST_LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n26\t\n27\t#[test]\n28\t#[ignore]\n29\tfn prepare_change_payload_p99_stays_within_budget() {\n30\t    init_tracing();\n31\t    let report = measure_case(\n32\t        \"prepare_change\",\n33\t        10_000,\n34\t        4_096,\n35\t        || tool_call_envelope(\"prepare_change\", &prepare_change_input_summary(false)),\n36\t    );\n37\t    assert!(\n38\t        report.p99_micros <= HOT_PATH_P99_BUDGET_MICROS,\n39\t        \"prepare_change P99 {}us exceeded budget {}us\",\n40\t        report.p99_micros,\n41\t        HOT_PATH_P99_BUDGET_MICROS\n42\t    );\n43\t}\n44\t\n45\t#[test]\n46\t#[ignore]\n47\tfn get_context_capsule_payload_p99_stays_within_budget() {\n48\t    init_tracing();\n49\t    let report = measure_case(\n50\t        \"get_context_capsule\",\n51\t        10_000,\n52\t        4_096,\n53\t        || tool_call_envelope(\"get_context_capsule\", &get_context_capsule_input_summary(false)),\n54\t    );\n55\t    assert!(\n56\t        report.p99_micros <= HOT_PATH_P99_BUDGET_MICROS,\n57\t        \"get_context_capsule P99 {}us exceeded budget {}us\",\n58\t        report.p99_micros,\n59\t        HOT_PATH_P99_BUDGET_MICROS\n60\t    );\n61\t}\n62\t\n63\t#[test]\n64\t#[ignore]\n65\tfn spilled_payload_p99_stays_within_budget() {\n66\t    init_tracing();\n67\t    let report = measure_case(\"prepare_change_spill\", 2_000, 256, || {\n68\t        tool_call_envelope(\"prepare_change\", &prepare_change_input_summary(true))\n69\t    });\n70\t    assert!(\n71\t        report.p99_micros <= HOT_PATH_P99_BUDGET_MICROS,\n72\t        \"spill P99 {}us exceeded budget {}us\",\n73\t        report.p99_micros,\n74\t        HOT_PATH_P99_BUDGET_MICROS\n75\t    );\n76\t}\n77\t\n78\t#[derive(Serialize)]\n79\tstruct BudgetReport {\n80\t    case_name: String,\n81\t    iterations: usize,\n82\t    inline_ceiling_bytes: usize,\n83\t    payload_bytes: usize,\n84\t    p50_micros: u128,\n85\t    p95_micros: u128,\n86\t    p99_micros: u128,\n87\t    max_micros: u128,\n88\t    cpu_model: String,\n89\t    filesystem: String,\n90\t    sqlite_mode: serde_json::Value,\n91\t}\n92\t\n93\tfn measure_case(\n94\t    case_name: &str,\n95\t    iterations: usize,\n96\t    inline_ceiling_bytes: usize,\n97\t    make_envelope: impl Fn() -> PartialEnvelope,\n98\t) -> BudgetReport {\n99\t    let _guard = BUDGET_TEST_LOCK\n100\t        .get_or_init(|| Mutex::new(()))\n101\t        .lock()\n102\t        .expect(\"budget lock acquires\");\n103\t    let store = Arc::new(EventStore::open_in_memory().expect(\"event store opens\"));\n104\t    let writer = EventWriter::new(store.clone(), \"workspace-main\".to_string(), inline_ceiling_bytes)\n105\t        .with_flush_policy(FlushPolicy::Batched { interval_ms: 250 });\n106\t    let payload_bytes = serde_json::to_vec(&make_envelop