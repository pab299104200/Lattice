{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RQEzaRztfXE4z5fgUAqq34","type":"tool_result","content":"1\t//! Versioned event-log compaction snapshots.\n2\t//!\n3\t//! Format and recovery rules are documented in\n4\t//! `docs/architecture/2026-05-16-event-log-compaction.md`\n5\t//! `## Snapshot format` and\n6\t//! `## Recovery from corrupt snapshot`.\n7\t\n8\tuse std::fs;\n9\tuse std::io::{Read, Write};\n10\tuse std::path::{Path, PathBuf};\n11\tuse std::time::{SystemTime, UNIX_EPOCH};\n12\t\n13\tuse serde::{Deserialize, Serialize};\n14\tuse sha2::{Digest, Sha256};\n15\tuse thiserror::Error;\n16\t\n17\tuse crate::graph::model::{CodeGraph, EdgeKind, GraphNode};\n18\tuse crate::memory::{Memory, MemoryStore};\n19\tuse crate::{DateTime, LatticeError, Utc};\n20\t\n21\tpub const SNAPSHOT_FORMAT_VERSION: u16 = 1;\n22\tpub const SNAPSHOT_HEADER_LEN: usize = 64;\n23\tpub const SNAPSHOT_MAGIC: [u8; 8] = *b\"LATTSNP1\";\n24\t\n25\tpub type SnapshotHash = [u8; 32];\n26\t\n27\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n28\tpub struct Snapshot {\n29\t    pub format_version: u16,\n30\t    pub taken_at: DateTime<Utc>,\n31\t    pub up_to_event_id: i64,\n32\t    pub graph_state: GraphSnapshot,\n33\t    pub memory_state: MemorySnapshot,\n34\t    pub content_hash: SnapshotHash,\n35\t}\n36\t\n37\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n38\tpub struct GraphSnapshot {\n39\t    pub nodes: Vec<GraphNode>,\n40\t    pub edges: Vec<GraphSnapshotEdge>,\n41\t}\n42\t\n43\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n44\tpub struct GraphSnapshotEdge {\n45\t    pub from: crate::symbols::SymbolId,\n46\t    pub to: crate::symbols::SymbolId,\n47\t    pub kind: EdgeKind,\n48\t}\n49\t\n50\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n51\tpub struct MemorySnapshot {\n52\t    pub memories: Vec<MemorySnapshotEntry>,\n53\t}\n54\t\n55\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n56\tpub struct MemorySnapshotEntry {\n57\t    pub memory: Memory,\n58\t    pub structured_fields: crate::memory::MemoryStructuredFields,\n59\t}\n60\t\n61\t#[derive(Clone, Debug, PartialEq, Eq)]\n62\tpub struct SnapshotHandle {\n63\t    pub path: PathBuf,\n64\t    pub format_version: u16,\n65\t    pub up_to_event_id: i64,\n66\t    pub taken_at: DateTime<Utc>,\n67\t    pub content_hash: SnapshotHash,\n68\t    pub bytes_written: u64,\n69\t}\n70\t\n71\t#[derive(Clone, Debug, PartialEq, Eq)]\n72\tpub struct SnapshotHeader {\n73\t    pub format_version: u16,\n74\t    pub flags: u16,\n75\t    pub header_len: u32,\n76\t    pub content_offset: u64,\n77\t    pub content_len: u64,\n78\t    pub content_hash: SnapshotHash,\n79\t}\n80\t\n81\t#[derive(Debug, Error)]\n82\tpub enum SnapshotError {\n83\t    #[error(\"snapshot I/O failed for {path}: {source}\")]\n84\t    IoFailed {\n85\t        path: PathBuf,\n86\t        source: std::io::Error,\n87\t    },\n88\t    #[error(\"snapshot header magic is unrecognized: {magic:?}\")]\n89\t    HeaderUnrecognized { magic: [u8; 8] },\n90\t    #[error(\"snapshot format version {found} is unsupported; max supported is {max}\")]\n91\t    FormatVersionUnsupported { found: u16, max: u16 },\n92\t    #[error(\"snapshot content hash mismatch\")]\n93\t    ContentHashMismatch,\n94\t    #[error(\"snapshot serialization failed: {0}\")]\n95\t    Serde(String),\n96\t    #[error(\"snapshot memory capture failed: {0}\")]\n97\t    Memory(String),\n98\t}\n99\t\n100\timpl Snapshot {\n101\t    pub fn capture(\n102\t        graph: &CodeGraph,\n103\t        memory: &MemoryStore,\n104\t        up_to_event_id: i64,\n105\t    ) -> Result<Self, SnapshotError> {\n106\t        let graph_state = GraphSnapshot::from_graph(graph);\n107\t        let memory_state = MemorySnapshot::from_store(memory)?;\n108\t        let taken_at = DateTime::from_unix_seconds(now_unix_seconds());\n109\t        Ok(Self::with_hash(\n110\t            taken_at,\n111\t            up_to_event_id,\n112\t            graph_state,\n113\t            memory_state,\n114\t        )?)\n115\t    }\n116\t\n117\t    pub fn write(\n118\t        path: &Path,\n119\t        graph: &CodeGraph,\n120\t        memory: &MemoryStore,\n121\t        up_to_event_id: i64,\n122\t    ) -> Result<SnapshotHandle, SnapshotError> {\n123\t        let snapshot = Self::capture(graph, memory, up_to_event_id)?;\n124\t        snapshot.write_to(path)\n125\t    }\n126\t\n127\t    pub fn write_to(&self, path: &Path) -> Result<SnapshotHandle, SnapshotError> {\n128\t        let body = encode_body(self)?;\n129\t        let header = SnapshotHeader::new(self.format_version, body.len(), self.content_hash);\n130\t        let tmp_path = temp_path(path);\n131\t        write_snapshot_file(&tmp_path, &header, &body)?;\n132\t        fs::rename(&tmp_path, path).map_err(|source| SnapshotError::IoFailed {\n133\t            path: path.to_path_buf(),\n134\t            source,\n135\t        })?;\n136\t        let bytes_written = (SNAPSHOT_HEADER_LEN + body.len()) as u64;\n137\t        Ok(SnapshotHandle {\n138\t            path: path.to_path_buf(),\n139\t            format_version: self.format_version,\n140\t            up_to_event_id: self.up_to_event_id,\n141\t            taken_at: self.taken_at,\n142\t            content_hash: self.content_hash,\n143\t            bytes_written,\n144\t        })\n145\t    }\n146\t\n147\t    pub fn read(path: &Path) -> Result<Self, SnapshotError> {\n148\t        let mut file = fs::File::open(path).map_err(|source| SnapshotError::IoFailed {\n149\t            path: path.to_path_buf(),\n150\t            source,\n151\t        })?;\n152\t        let header = read_header_from(&mut file, path)?;\n153\t        validate_header(&header)?;\n154\t        let body = read_body_from(&mut file, path, &header)?;\n155\t        verify_hash(&body, &header.content_hash)?;\n156\t        let snapshot: Snapshot =\n157\t            ciborium::from_reader(body.as_slice()).map_err(cbor_decode_error)?;\n158\t        validate_decoded_snapshot(snapshot, &header)\n159\t    }\n160\t\n161\t    pub fn read_header(path: &Path) -> Result<SnapshotHeader, SnapshotError> {\n162\t        let mut file = fs::File::open(path).map_err(|source| SnapshotError::IoFailed {\n163\t            path: path.to_path_buf(),\n164\t            source,\n165\t        })?;\n166\t        let header = read_header_from(&mut file, path)?;\n167\t        validate_header(&header)?;\n168\t        Ok(header)\n169\t    }\n170\t\n171\t    fn with_hash(\n172\t        taken_at: DateTime<Utc>,\n173\t        up_to_event_id: i64,\n174\t        graph_state: GraphSnapshot,\n175\t        memory_state: MemorySnapshot,\n176\t    ) -> Result<Self, SnapshotError> {\n177\t        let mut snapshot = Self {\n178\t            format_version: SNAPSHOT_FORMAT_VERSION,\n179\t            taken_at,\n180\t            up_to_event_id,\n181\t            graph_state,\n182\t            memory_state,\n183\t            content_hash: [0; 32],\n184\t        };\n185\t        snapshot.content_hash = hash_bytes(&encode_cbor(&snapshot)?);\n186\t        Ok(snapshot)\n187\t    }\n188\t}\n189\t\n190\timpl GraphSnapshot {\n191\t    pub fn from_graph(graph: &CodeGraph) -> Self {\n192\t        let mut nodes: Vec<GraphNode> = graph.all_nodes().into_iter().cloned().collect();\n193\t        nodes.sort_by(|left, right| {\n194\t            left.id\n195\t                .name\n196\t                .cmp(&right.id.name)\n197\t                .then(left.file.cmp(&right.file))\n198\t        });\n199\t        let mut edges = graph\n200\t            .all_edges()\n201\t            .into_iter()\n202\t            .map(|(from, to, kind)| GraphSnapshotEdge {\n203\t                from: from.id.clone(),\n204\t                to: to.id.clone(),\n205\t                kind,\n206\t            })\n207\t            .collect::<Vec<_>>();\n208\t        edges.sort_by(|left, right| {\n209\t            left.from\n210\t                .name\n211\t                .cmp(&right.from.name)\n212\t                .then(left.to.name.cmp(&right.to.name))\n213\t                .then(format!(\"{:?}\", left.kind).cmp(&format!(\"{:?}\", right.kind)))\n214\t        });\n215\t        Self { nodes, edges }\n216\t    }\n217\t\n218\t    pub fn into_graph(self) -> CodeGraph {\n219\t        let mut graph = CodeGraph::new();\n220\t        for node in self.nodes {\n221\t            graph.add_node(\n222\t                node.id,\n223\t                node.kind,\n224\t                node.name,\n225\t                node.signature,\n226\t                node.body,\n227\t                node.file,\n228\t                node.line,\n229\t                node.end_line,\n230\t                node.is_exported,\n231\t                node.language,\n232\t            );\n233\t        }\n234\t        for edge in self.edges {\n235\t            graph.add_edge(&edge.from, &edge.to, edge.kind);\n236\t        }\n237\t        graph\n238\t    }\n239\t}\n240\t\n241\timpl MemorySnapshot {\n242\t    pub fn from_store(store: &MemoryStore) -> Result<Self, SnapshotError> {\n243\t        let mut entries = Vec::new();\n244\t        for memory in store.list_all().map_err(memory_error)? {\n245\t            let structured_fields = store\n246\t                .get_structured_fields(&memory.id)\n247\t                .map_err(memory_error)?\n248\t                .unwrap_or_default();\n249\t            entries.push(MemorySnapshotEntry {\n250\t                memory,\n251\t                structured_fields,\n252\t            });\n253\t        }\n254\t        entries.sort_by(|left, right| left.memory.id.cmp(&right.memory.id));\n255\t        Ok(Self { memories: entries })\n256\t    }\n257\t}\n258\t\n259\timpl SnapshotHeader {\n260\t    fn new(format_version: u16, content_len: usize, content_hash: SnapshotHash) -> Self {\n261\t        Self {\n262\t            format_version,\n263\t            flags: 0,\n264\t            header_len: SNAPSHOT_HEADER_LEN as u32,\n265\t            content_offset: SNAPSHOT_HEADER_LEN as u64,\n266\t            content_len: content_len as u64,\n267\t            content_hash,\n268\t        }\n269\t    }\n270\t\n271\t    fn encode(&self) -> [u8; SNAPSHOT_HEADER_LEN] {\n272\t        let mut bytes = [0; SNAPSHOT_HEADER_LEN];\n273\t        bytes[0..8].copy_from_slice(&SNAPSHOT_MAGIC);\n274\t        bytes[8..10].copy_from_slice(&self.format_version.to_le_bytes());\n275\t        bytes[10..12].copy_from_slice(&self.flags.to_le_bytes());\n276\t        bytes[12..16].copy_from_slice(&self.header_len.to_le_bytes());\n277\t        bytes[16..24].copy_from_slice(&self.content_offset.to_le_bytes());\n278\t        bytes[24..32].copy_from_slice(&self.content_len.to_le_bytes());\n279\t        bytes[32..64].copy_from_slice(&self.content_hash);\n280\t        bytes\n281\t    }\n282\t\n283\t    fn decode(bytes: [u8; SNAPSHOT_HEADER_LEN]) -> Result<Self, SnapshotError> {\n284\t        let mut magic = [0; 8];\n285\t        magic.copy_from_slice(&bytes[0..8]);\n286\t        if magic != SNAPSHOT_MAGIC {\n287\t            return Err(SnapshotError::HeaderUnrecognized { magic });\n288\t        }\n289\t        let mut content_hash = [0; 32];\n290\t        content_hash.copy_from_slice(&bytes[32..64]);\n291\t        Ok(Self {\n292\t            format_version: u16::from_le_bytes([bytes[8], bytes[9]]),\n293\t            flags: u16::from_le_bytes([bytes[10], bytes[11]]),\n294\t            header_len: u32::from_le_bytes([bytes[12], bytes[13], bytes[14], bytes[15]]),\n295\t            content_offset: u64::from_le_bytes(bytes[16..24].try_into().expect(\"slice len\")),\n296\t            content_len: u64::from_le_bytes(bytes[24..32].try_into().expect(\"slice len\")),\n297\t            content_hash,\n298\t        })\n299\t    }\n300\t}\n301\t\n302\tfn encode_body(snapshot: &Snapshot) -> Result<Vec<u8>, SnapshotError> {\n303\t    let mut body_snapshot = snapshot.clone();\n304\t    body_snapshot.content_hash = [0; 32];\n305\t    let body = encode_cbor(&body_snapshot)?;\n306\t    let actual_hash = hash_bytes(&body);\n307\t    if actual_hash != snapshot.content_hash {\n308\t        return Err(SnapshotError::ContentHashMismatch);\n309\t    }\n310\t    Ok(body)\n311\t}\n312\t\n313\tfn write_snapshot_file(\n314\t    path: &Path,\n315\t    header: &SnapshotHeader,\n316\t    body: &[u8],\n317\t) -> Result<(), SnapshotError> {\n318\t    if let Some(parent) = path.parent() {\n319\t        fs::create_dir_all(parent).map_err(|source| SnapshotError::IoFailed {\n320\t            path: parent.to_path_buf(),\n321\t            source,\n322\t        })?;\n323\t    }\n324\t    let mut file = fs::File::create(path).map_err(|source| SnapshotError::IoFailed {\n325\t        path: path.to_path_buf(),\n326\t        source,\n327\t    })?;\n328\t    file.write_all(&header.encode())\n329\t        .and_then(|_| file.write_all(body))\n330\t        .and_then(|_| file.sync_all())\n331\t        .map_err(|source| SnapshotError::IoFailed {\n332\t            path: path.to_path_buf(),\n333\t            source,\n334\t        })\n335\t}\n336\t\n337\tfn read_header_from(file: &mut fs::File, path: &Path) -> Result<SnapshotHeader, SnapshotError> {\n338\t    let mut header = [0; SNAPSHOT_HEADER_LEN];\n339\t    file.read_exact(&mut header)\n340\t        .map_err(|source| SnapshotError::IoFailed {\n341\t            path: path.to_path_buf(),\n342\t            source,\n343\t        })?;\n344\t    SnapshotHeader::decode(header)\n345\t}\n346\t\n347\tfn read_body_from(\n348\t    file: &mut fs::File,\n349\t    path: &Path,\n350\t    header: &SnapshotHeader,\n351\t) -> Result<Vec<u8>, SnapshotError> {\n352\t    let mut body = vec![0; header.content_len as usize];\n353\t    if let Err(source) = file.read_exact(&mut body) {\n354\t        if source.kind() == std::io::ErrorKind::UnexpectedEof {\n355\t            return Err(SnapshotError::ContentHashMismatch);\n356\t        }\n357\t        return Err(SnapshotError::IoFailed {\n358\t            path: path.to_path_buf(),\n359\t            source,\n360\t        });\n361\t    }\n362\t    Ok(body)\n363\t}\n364\t\n365\tfn validate_header(header: &SnapshotHeader) -> Result<(), SnapshotError> {\n366\t    if header.format_version > SNAPSHOT_FORMAT_VERSION {\n367\t        return Err(SnapshotError::FormatVersionUnsupported {\n368\t            found: header.format_version,\n369\t            max: SNAPSHOT_FORMAT_VERSION,\n370\t        });\n371\t    }\n372\t    if header.header_len != SNAPSHOT_HEADER_LEN as u32\n373\t        || header.content_offset != SNAPSHOT_HEADER_LEN as u64\n374\t    {\n375\t        return Err(SnapshotError::HeaderUnrecognized {\n376\t            magic: SNAPSHOT_MAGIC,\n377\t        });\n378\t    }\n379\t    Ok(())\n380\t}\n381\t\n382\tfn validate_decoded_snapshot(\n383\t    mut snapshot: Snapshot,\n384\t    header: &SnapshotHeader,\n385\t) -> Result<Snapshot, SnapshotError> {\n386\t    if snapshot.format_version != header.format_version {\n387\t        return Err(SnapshotError::FormatVersionUnsupported {\n388\t            found: snapshot.format_version,\n389\t            max: SNAPSHOT_FORMAT_VERSION,\n390\t        });\n391\t    }\n392\t    snapshot.content_hash = hash_bytes(&encode_cbor(&snapshot)?);\n393\t    if snapshot.content_hash != header.content_hash {\n394\t        return Err(SnapshotError::ContentHashMismatch);\n395\t    }\n396\t    Ok(snapshot)\n397\t}\n398\t\n399\tfn verify_hash(body: &[u8], expected: &SnapshotHash) -> Result<(), SnapshotError> {\n400\t    if &hash_bytes(body) == expected {\n401\t        Ok(())\n402\t    } else {\n403\t        Err(SnapshotError::ContentHashMismatch)\n404\t    }\n405\t}\n406\t\n407\tfn encode_cbor(snapshot: &Snapshot) -> Result<Vec<u8>, SnapshotError> {\n408\t    let mut bytes = Vec::new();\n409\t    ciborium::into_writer(snapshot, &mut bytes).map_err(cbor_encode_error)?;\n410\t    Ok(bytes)\n411\t}\n412\t\n413\tfn cbor_encode_error(error: ciborium::ser::Error<std::io::Error>) -> SnapshotError {\n414\t    SnapshotError::Serde(error.to_string())\n415\t}\n416\t\n417\tfn cbor_decode_error(error: ciborium::de::Error<std::io::Error>) -> SnapshotError {\n418\t    SnapshotError::Serde(error.to_string())\n419\t}\n420\t\n421\tfn hash_bytes(bytes: &[u8]) -> SnapshotHash {\n422\t    let digest = Sha256::digest(bytes);\n423\t    let mut hash = [0; 32];\n424\t    hash.copy_from_slice(&digest);\n425\t    hash\n426\t}\n427\t\n428\tfn temp_path(path: &Path) -> PathBuf {\n429\t    let suffix = SystemTime::now()\n430\t        .duration_since(UNIX_EPOCH)\n431\t        .unwrap_or_default()\n432\t        .as_nanos();\n433\t    path.with_extension(format!(\"tmp-{suffix}\"))\n434\t}\n435\t\n436\tfn now_unix_seconds() -> i64 {\n437\t    SystemTime::now()\n438\t        .duration_since(UNIX_EPOCH)\n439\t        .unwrap_or_default()\n440\t        .as_secs()\n441\t        .min(i64::MAX as u64) as i64\n442\t}\n443\t\n444\tfn memory_error(error: LatticeError) -> SnapshotError {\n445\t    SnapshotError::Memory(error.to_string())\n446\t}\n447\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"3daf05bf-2f35-40bf-86e0-605bc0cb6501","timestamp":"2026-05-17T05:59:31.214Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/snapshot.rs","content":"//! Versioned event-log compaction snapshots.\n//!\n//! Format and recovery rules are documented in\n//! `docs/architecture/2026-05-16-event-log-compaction.md`\n//! `## Snapshot format` and\n//! `## Recovery from corrupt snapshot`.\n\nuse std::fs;\nuse std::io::{Read, Write};\nuse std::path::{Path, PathBuf};\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse serde::{Deserialize, Serialize};\nuse sha2::{Digest, Sha256};\nuse thiserror::Error;\n\nuse crate::graph::model::{CodeGraph, EdgeKind, GraphNode};\nuse crate::memory::{Memory, MemoryStore};\nuse crate::{DateTime, LatticeError, Utc};\n\npub const SNAPSHOT_FORMAT_VERSION: u16 = 1;\npub const SNAPSHOT_HEADER_LEN: usize = 64;\npub const SNAPSHOT_MAGIC: [u8; 8] = *b\"LATTSNP1\";\n\npub type SnapshotHash = [u8; 32];\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\npub struct Snapshot {\n    pub format_version: u16,\n    pub taken_at: DateTime<Utc>,\n    pub up_to_event_id: i64,\n    pub graph_state: GraphSnapshot,\n    pub memory_state: MemorySnapshot,\n    pub content_hash: SnapshotHash,\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\npub struct GraphSnapshot {\n    pub nodes: Vec<GraphNode>,\n    pub edges: Vec<GraphSnapshotEdge>,\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\npub struct GraphSnapshotEdge {\n    pub from: crate::symbols::SymbolId,\n    pub to: crate::symbols::SymbolId,\n    pub kind: EdgeKind,\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\npub struct MemorySnapshot {\n    pub memories: Vec<MemorySnapshotEntry>,\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\npub struct MemorySnapshotEntry {\n    pub memory: Memory,\n    pub structured_fields: crate::memory::MemoryStructuredFields,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct SnapshotHandle {\n    pub path: PathBuf,\n    pub format_version: u16,\n    pub up_to_event_id: i64,\n    pub taken_at: DateTime<Utc>,\n    pub content_hash: SnapshotHash,\n    pub bytes_written: u64,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct SnapshotHeader {\n    pub format_version: u16,\n    pub flags: u16,\n    pub header_len: u32,\n    pub content_offset: u64,\n    pub content_len: u64,\n    pub content_hash: SnapshotHash,\n}\n\n#[derive(Debug, Error)]\npub enum SnapshotError {\n    #[error(\"snapshot I/O failed for {path}: {source}\")]\n    IoFailed {\n        path: PathBuf,\n        source: std::io::Error,\n    },\n    #[error(\"snapshot header magic is unrecognized: {magic:?}\")]\n    HeaderUnrecognized { magic: [u8; 8] },\n    #[error(\"snapshot format version {found} is unsupported; max supported is {max}\")]\n    FormatVersionUnsupported { found: u16, max: u16 },\n    #[error(\"snapshot content hash mismatch\")]\n    ContentHashMismatch,\n    #[error(\"snapshot serialization failed: {0}\")]\n    Serde(String),\n    #[error(\"snapshot memory capture failed: {0}\")]\n    Memory(String),\n}\n\nimpl Snapshot {\n    pub fn capture(\n        graph: &CodeGraph,\n        memory: &MemoryStore,\n        up_to_event_id: i64,\n    ) -> Result<Self, SnapshotError> {\n        let graph_state = GraphSnapshot::from_graph(graph);\n        let memory_state = MemorySnapshot::from_store(memory)?;\n        let taken_at = DateTime::from_unix_seconds(now_unix_seconds());\n        Ok(Self::with_hash(\n            taken_at,\n            up_to_event_id,\n            graph_state,\n            memory_state,\n        )?)\n    }\n\n    pub fn write(\n        path: &Path,\n        graph: &CodeGraph,\n        memory: &MemoryStore,\n        up_to_event_id: i64,\n    ) -> Result<SnapshotHandle, SnapshotError> {\n        let snapshot = Self::capture(graph, memory, up_to_event_id)?;\n        snapshot.write_to(path)\n    }\n\n    pub fn write_to(&self, path: &Path) -> Result<SnapshotHandle, SnapshotError> {\n        let body = encode_body(self)?;\n        let header = SnapshotHeader::new(self.format_version, body.len(), self.content_hash);\n        let tmp_path = temp_path(path);\n        write_snapshot_file(&tmp_path, &header, &body)?;\n        fs::rename(&tmp_path, path).map_err(|source| SnapshotError::IoFailed {\n            path: path.to_path_buf(),\n            source,\n        })?;\n        let bytes_written = (SNAPSHOT_HEADER_LEN + body.len()) as u64;\n        Ok(SnapshotHandle {\n            path: path.to_path_buf(),\n            format_version: self.format_version,\n            up_to_event_id: self.up_to_event_id,\n            taken_at: self.taken_at,\n            content_hash: self.content_hash,\n            bytes_written,\n        })\n    }\n\n    pub fn read(path: &Path) -> Result<Self, SnapshotError> {\n        let mut file = fs::File::open(path).map_err(|source| SnapshotError::IoFailed {\n            path: path.to_path_buf(),\n            source,\n        })?;\n        let header = read_header_from(&mut file, path)?;\n        validate_header(&header)?;\n        let body = read_body_from(&mut file, path, &header)?;\n        verify_hash(&body, &header.content_hash)?;\n        let snapshot: Snapshot =\n            ciborium::from_reader(body.as_slice()).map_err(cbor_decode_error)?;\n        validate_decoded_snapshot(snapshot, &header)\n    }\n\n    pub fn read_header(path: &Path) -> Result<SnapshotHeader, SnapshotError> {\n        let mut file = fs::File::open(path).map_err(|source| SnapshotError::IoFailed {\n            path: path.to_path_buf(),\n            source,\n        })?;\n        let header = read_header_from(&mut file, path)?;\n        validate_header(&header)?;\n        Ok(header)\n    }\n\n    fn with_hash(\n        taken_at: DateTime<Utc>,\n        up_to_event_id: i64,\n        graph_state: GraphSnapshot,\n        memory_state: MemorySnapshot,\n    ) -> Result<Self, SnapshotError> {\n        let mut snapshot = Self {\n            format_version: SNAPSHOT_FORMAT_VERSION,\n            taken_at,\n            up_to_event_id,\n            graph_state,\n            memory_state,\n            content_hash: [0; 32],\n        };\n        snapshot.content_hash = hash_bytes(&encode_cbor(&snapshot)?);\n        Ok(snapshot)\n    }\n}\n\nimpl GraphSnapshot {\n    pub fn from_graph(graph: &CodeGraph) -> Self {\n        let mut nodes: Vec<GraphNode> = graph.all_nodes().into_iter().cloned().collect();\n        nodes.sort_by(|left, right| {\n            left.id\n                .name\n                .cmp(&right.id.name)\n                .then(left.file.cmp(&right.file))\n        });\n        let mut edges = graph\n            .all_edges()\n            .into_iter()\n            .map(|(from, to, kind)| GraphSnapshotEdge {\n                from: from.id.clone(),\n                to: to.id.clone(),\n                kind,\n            })\n            .collect::<Vec<_>>();\n        edges.sort_by(|left, right| {\n            left.from\n                .name\n                .cmp(&right.from.name)\n                .then(left.to.name.cmp(&right.to.name))\n                .then(format!(\"{:?}\", left.kind).cmp(&format!(\"{:?}\", right.kind)))\n        });\n        Self { nodes, edges }\n    }\n\n    pub fn into_graph(self) -> CodeGraph {\n        let mut graph = CodeGraph::new();\n        for node in self.nodes {\n            graph.add_node(\n                node.id,\n                node.kind,\n                node.name,\n                node.signature,\n                node.body,\n                node.file,\n                node.line,\n                node.end_line,\n                node.is_exported,\n                node.language,\n            );\n        }\n        for edge in self.edges {\n            graph.add_edge(&edge.from, &edge.to, edge.kind);\n        }\n        graph\n    }\n}\n\nimpl MemorySnapshot {\n    pub fn from_store(store: &MemoryStore) -> Result<Self, SnapshotError> {\n        let mut entries = Vec::new();\n        for memory in store.list_all().map_err(memory_error)? {\n            let structured_fields = store\n                .get_structured_fields(&memory.id)\n                .map_err(memory_error)?\n                .unwrap_or_default();\n            entries.push(MemorySnapshotEntry {\n                memory,\n                structured_fields,\n            });\n        }\n        entries.sort_by(|left, right| left.memory.id.cmp(&right.memory.id));\n        Ok(Self { memories: entries })\n    }\n}\n\nimpl SnapshotHeader {\n    fn new(format_version: u16, content_len: usize, content_hash: SnapshotHash) -> Self {\n        Self {\n            format_version,\n            flags: 0,\n            header_len: SNAPSHOT_HEADER_LEN as u32,\n            content_offset: SNAPSHOT_HEADER_LEN as u64,\n            content_len: content_len as u64,\n            content_hash,\n        }\n    }\n\n    fn encode(&self) -> [u8; SNAPSHOT_HEADER_LEN] {\n        let mut bytes = [0; SNAPSHOT_HEADER_LEN];\n        bytes[0..8].copy_from_slice(&SNAPSHOT_MAGIC);\n        bytes[8..10].copy_from_slice(&self.format_version.to_le_bytes());\n        bytes[10..12].copy_from_slice(&self.flags.to_le_bytes());\n        bytes[12..16].copy_from_slice(&self.header_len.to_le_bytes());\n        bytes[16..24].copy_from_slice(&self.content_offset.to_le_bytes());\n        bytes[24..32].copy_from_slice(&self.content_len.to_le_bytes());\n        bytes[32..64].copy_from_slice(&self.content_hash);\n        bytes\n    }\n\n    fn decode(bytes: [u8; SNAPSHOT_HEADER_LEN]) -> Result<Self, SnapshotError> {\n        let mut magic = [0; 8];\n        magic.copy_from_slice(&bytes[0..8]);\n        if magic != SNAPSHOT_MAGIC {\n            return Err(SnapshotError::HeaderUnrecognized { magic });\n        }\n        let mut content_hash = [0; 32];\n        content_hash.copy_from_slice(&bytes[32..64]);\n        Ok(Self {\n            format_version: u16::from_le_bytes([bytes[8], bytes[9]]),\n            flags: u16::from_le_bytes([bytes[10], bytes[11]]),\n            header_len: u32::from_le_bytes([bytes[12], bytes[13], bytes[14], bytes[15]]),\n            content_offset: u64::from_le_bytes(bytes[16..24].try_into().expect(\"slice len\")),\n            content_len: u64::from_le_bytes(bytes[24..32].try_into().expect(\"slice len\")),\n            content_hash,\n        })\n    }\n}\n\nfn encode_body(snapshot: &Snapshot) -> Result<Vec<u8>, SnapshotError> {\n    let mut body_snapshot = snapshot.clone();\n    body_snapshot.content_hash = [0; 32];\n    let body = encode_cbor(&body_snapshot)?;\n    let actual_hash = hash_bytes(&body);\n    if actual_hash != snapshot.content_hash {\n        return Err(SnapshotError::ContentHashMismatch);\n    }\n    Ok(body)\n}\n\nfn write_snapshot_file(\n    path: &Path,\n    header: &SnapshotHeader,\n    body: &[u8],\n) -> Result<(), SnapshotError> {\n    if let Some(parent) = path.parent() {\n        fs::create_dir_all(parent).map_err(|source| SnapshotError::IoFailed {\n            path: parent.to_path_buf(),\n            source,\n        })?;\n    }\n    let mut file = fs::File::create(path).map_err(|source| SnapshotError::IoFailed {\n        path: path.to_path_buf(),\n        source,\n    })?;\n    file.write_all(&header.encode())\n        .and_then(|_| file.write_all(body))\n        .and_then(|_| file.sync_all())\n        .map_err(|source| SnapshotError::IoFailed {\n            path: path.to_path_buf(),\n            source,\n        })\n}\n\nfn read_header_from(file: &mut fs::File, path: &Path) -> Result<SnapshotHeader, SnapshotError> {\n    let mut header = [0; SNAPSHOT_HEADER_LEN];\n    file.read_exact(&mut header)\n        .map_err(|source| SnapshotError::IoFailed {\n            path: path.to_path_buf(),\n            source,\n        })?;\n    SnapshotHeader::decode(header)\n}\n\nfn read_body_from(\n    file: &mut fs::File,\n    path: &Path,\n    header: &SnapshotHeader,\n) -> Result<Vec<u8>, SnapshotError> {\n    let mut body = vec![0; header.content_len as usize];\n    if let Err(source) = file.read_exact(&mut body) {\n        if source.kind() == std::io::ErrorKind::UnexpectedEof {\n            return Err(SnapshotError::ContentHashMismatch);\n        }\n        return Err(SnapshotError::IoFailed {\n            path: path.to_path_buf(),\n            source,\n        });\n    }\n    Ok(body)\n}\n\nfn validate_header(header: &SnapshotHeader) -> Result<(), SnapshotError> {\n    if header.format_version > SNAPSHOT_FORMAT_VERSION {\n        return Err(SnapshotError::FormatVersionUnsupported {\n            found: header.format_version,\n            max: SNAPSHOT_FORMAT_VERSION,\n        });\n    }\n    if header.header_len != SNAPSHOT_HEADER_LEN as u32\n        || header.content_offset != SNAPSHOT_HEADER_LEN as u64\n    {\n        return Err(SnapshotError::HeaderUnrecognized {\n            magic: SNAPSHOT_MAGIC,\n        });\n    }\n    Ok(())\n}\n\nfn validate_decoded_snapshot(\n    mut snapshot: Snapshot,\n    header: &SnapshotHeader,\n) -> Result<Snapshot, SnapshotError> {\n    if snapshot.format_version != header.format_version {\n        return Err(SnapshotError::FormatVersionUnsupported {\n            found: snapshot.format_version,\n            max: SNAPSHOT_FORMAT_VERSION,\n        });\n    }\n    snapshot.content_hash = hash_bytes(&encode_cbor(&snapshot)?);\n    if snapshot.content_hash != header.content_hash {\n        return Err(SnapshotError::ContentHashMismatch);\n    }\n    Ok(snapshot)\n}\n\nfn verify_hash(body: &[u8], expected: &SnapshotHash) -> Result<(), SnapshotError> {\n    if &hash_bytes(body) == expected {\n        Ok(())\n    } else {\n        Err(SnapshotError::ContentHashMismatch)\n    }\n}\n\nfn encode_cbor(snapshot: &Snapshot) -> Result<Vec<u8>, SnapshotError> {\n    let mut bytes = Vec::new();\n    ciborium::into_writer(snapshot, &mut bytes).map_err(cbor_encode_error)?;\n    Ok(bytes)\n}\n\nfn cbor_encode_error(error: ciborium::ser::Error<std::io::Error>) -> SnapshotError {\n    SnapshotError::Serde(error.to_string())\n}\n\nfn cbor_decode_error(error: ciborium::de::Error<std::io::Error>) -> SnapshotError {\n    SnapshotError::Serde(error.to_string())\n}\n\nfn hash_bytes(bytes: &[u8]) -> SnapshotHash {\n    let digest = Sha256::digest(bytes);\n    let mut hash = [0; 32];\n    hash.copy_from_slice(&digest);\n    hash\n}\n\nfn temp_path(path: &Path) -> PathBuf {\n    let suffix = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_nanos();\n    path.with_extension(format!(\"tmp-{suffix}\"))\n}\n\nfn now_unix_seconds() -> i64 {\n    SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_secs()\n        .min(i64::MAX as u64) as i64\n}\n\nfn memory_error(error: LatticeError) -> SnapshotError {\n    SnapshotError::Memory(error.to_string())\n}\n","numLines":447,"startLine":1,"totalLines":447}}}
