{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NSqVJ1FbAeBbj4BtgnGypv","type":"tool_result","content":"1\t//! Typed query builder for bounded event-log reads.\n2\t//!\n3\t//! The reader defaults to a 1000-row limit and rejects requests above 10_000 rows.\n4\t//! That ceiling keeps event-log reads bounded on hot paths: callers can page or use\n5\t//! the streaming reader for larger replays, but no single query may degenerate into\n6\t//! a full-log scan or unbounded in-memory buffer.\n7\t\n8\tuse thiserror::Error;\n9\t\n10\tuse crate::events::reader::EventReader;\n11\tuse crate::events::{\n12\t    BranchRef, EventEnvelope, EventKind, EventStoreError, PayloadHash, SessionId, TaskId,\n13\t};\n14\tuse crate::identity::{EventId, WorkspaceId};\n15\tuse crate::{DateTime, Utc};\n16\t\n17\tpub const DEFAULT_EVENT_QUERY_LIMIT: usize = 1_000;\n18\tpub const EVENT_QUERY_LIMIT_CEILING: usize = 10_000;\n19\t\n20\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n21\tpub enum QueryOrder {\n22\t    OldestFirst,\n23\t    NewestFirst,\n24\t}\n25\t\n26\t#[derive(Clone, Debug, PartialEq, Eq)]\n27\tpub struct TaskScope {\n28\t    pub task_id: TaskId,\n29\t}\n30\t\n31\t#[derive(Clone, Debug, PartialEq, Eq)]\n32\tpub struct SessionScope {\n33\t    pub session_id: SessionId,\n34\t}\n35\t\n36\t#[derive(Clone, Debug, PartialEq, Eq)]\n37\tpub enum TailScope {\n38\t    Task(TaskScope),\n39\t    Session(SessionScope),\n40\t}\n41\t\n42\timpl From<TaskScope> for TailScope {\n43\t    fn from(value: TaskScope) -> Self {\n44\t        Self::Task(value)\n45\t    }\n46\t}\n47\t\n48\timpl From<SessionScope> for TailScope {\n49\t    fn from(value: SessionScope) -> Self {\n50\t        Self::Session(value)\n51\t    }\n52\t}\n53\t\n54\t#[derive(Debug, Error)]\n55\tpub enum EventQueryError {\n56\t    #[error(\"event queries require task, session, or workspace+branch scope\")]\n57\t    Unscoped,\n58\t    #[error(\"event query limit {requested} exceeds ceiling {ceiling}\")]\n59\t    LimitTooLarge { requested: usize, ceiling: usize },\n60\t    #[error(\"event store read failed: {0}\")]\n61\t    Storage(#[from] EventStoreError),\n62\t    #[error(\"event payload deserialization failed: {0}\")]\n63\t    Serde(#[from] serde_json::Error),\n64\t    #[error(\n65\t        \"event payload corruption detected for `{event_id:?}`: expected {expected}, actual {actual}\"\n66\t    )]\n67\t    PayloadCorruption {\n68\t        event_id: EventId,\n69\t        expected: PayloadHash,\n70\t        actual: PayloadHash,\n71\t    },\n72\t}\n73\t\n74\t#[derive(Clone, Debug, Default, PartialEq, Eq)]\n75\tpub struct EventQuery {\n76\t    pub(crate) task_id: Option<String>,\n77\t    pub(crate) session_id: Option<String>,\n78\t    pub(crate) workspace_id: Option<String>,\n79\t    pub(crate) branch: Option<String>,\n80\t    pub(crate) kinds: Vec<EventKind>,\n81\t    pub(crate) after: Option<DateTime<Utc>>,\n82\t    pub(crate) before: Option<DateTime<Utc>>,\n83\t    pub(crate) limit: Option<usize>,\n84\t    pub(crate) order: Option<QueryOrder>,\n85\t}\n86\t\n87\timpl EventQuery {\n88\t    pub fn new() -> Self {\n89\t        Self::default()\n90\t    }\n91\t\n92\t    pub fn task(mut self, task_id: impl Into<String>) -> Self {\n93\t        self.task_id = Some(task_id.into());\n94\t        self\n95\t    }\n96\t\n97\t    pub fn session(mut self, session_id: impl Into<String>) -> Self {\n98\t        self.session_id = Some(session_id.into());\n99\t        self\n100\t    }\n101\t\n102\t    pub fn workspace(mut self, workspace_id: impl Into<String>) -> Self {\n103\t        self.workspace_id = Some(workspace_id.into());\n104\t        self\n105\t    }\n106\t\n107\t    pub fn branch(mut self, branch_ref: impl Into<String>) -> Self {\n108\t        self.branch = Some(branch_ref.into());\n109\t        self\n110\t    }\n111\t\n112\t    pub fn kind(mut self, kind: EventKind) -> Self {\n113\t        self.kinds = vec![kind];\n114\t        self\n115\t    }\n116\t\n117\t    pub fn kinds(mut self, kinds: &[EventKind]) -> Self {\n118\t        self.kinds = kinds.to_vec();\n119\t        self\n120\t    }\n121\t\n122\t    pub fn after(mut self, timestamp: DateTime<Utc>) -> Self {\n123\t        self.after = Some(timestamp);\n124\t        self\n125\t    }\n126\t\n127\t    pub fn before(mut self, timestamp: DateTime<Utc>) -> Self {\n128\t        self.before = Some(timestamp);\n129\t        self\n130\t    }\n131\t\n132\t    pub fn limit(mut self, limit: usize) -> Self {\n133\t        self.limit = Some(limit);\n134\t        self\n135\t    }\n136\t\n137\t    pub fn order(mut self, order: QueryOrder) -> Self {\n138\t        self.order = Some(order);\n139\t        self\n140\t    }\n141\t\n142\t    pub fn execute(self, reader: &EventReader) -> Result<Vec<EventEnvelope>, EventQueryError> {\n143\t        reader.execute(self)\n144\t    }\n145\t\n146\t    pub(crate) fn order_or_default(&self) -> QueryOrder {\n147\t        self.order.unwrap_or(QueryOrder::OldestFirst)\n148\t    }\n149\t\n150\t    pub(crate) fn limit_or_default(&self) -> usize {\n151\t        self.limit.unwrap_or(DEFAULT_EVENT_QUERY_LIMIT).max(1)\n152\t    }\n153\t\n154\t    pub(crate) fn validate(&self) -> Result<(), EventQueryError> {\n155\t        let has_scope = self.task_id.is_some()\n156\t            || self.session_id.is_some()\n157\t            || (self.workspace_id.is_some() && self.branch.is_some());\n158\t        if !has_scope {\n159\t            return Err(EventQueryError::Unscoped);\n160\t        }\n161\t\n162\t        let limit = self.limit_or_default();\n163\t        if limit > EVENT_QUERY_LIMIT_CEILING {\n164\t            return Err(EventQueryError::LimitTooLarge {\n165\t                requested: limit,\n166\t                ceiling: EVENT_QUERY_LIMIT_CEILING,\n167\t            });\n168\t        }\n169\t        Ok(())\n170\t    }\n171\t\n172\t    pub(crate) fn trace_scope(&self) -> String {\n173\t        if let Some(task_id) = &self.task_id {\n174\t            return format!(\"task:{task_id}\");\n175\t        }\n176\t        if let Some(session_id) = &self.session_id {\n177\t            return format!(\"session:{session_id}\");\n178\t        }\n179\t        if let (Some(workspace_id), Some(branch)) = (&self.workspace_id, &self.branch) {\n180\t            return format!(\"workspace:{workspace_id}@{branch}\");\n181\t        }\n182\t        \"unscoped\".to_string()\n183\t    }\n184\t}\n185\t\n186\tpub(crate) fn event_id(workspace_id: &str, ulid: &str) -> EventId {\n187\t    EventId {\n188\t        workspace_id: workspace_id.to_string(),\n189\t        ulid: ulid.to_string(),\n190\t    }\n191\t}\n192\t\n193\tpub(crate) fn branch_ref(name: &str) -> BranchRef {\n194\t    BranchRef {\n195\t        name: name.to_string(),\n196\t    }\n197\t}\n198\t\n199\tpub(crate) fn session_id(value: &str) -> SessionId {\n200\t    SessionId {\n201\t        value: value.to_string(),\n202\t    }\n203\t}\n204\t\n205\tpub(crate) fn task_id(value: &str) -> TaskId {\n206\t    TaskId {\n207\t        value: value.to_string(),\n208\t    }\n209\t}\n210\t\n211\tpub(crate) fn workspace_id(value: &str) -> WorkspaceId {\n212\t    value.to_string()\n213\t}\n214\t"}]},"parent_tool_use_id":null,"session_id":"2b8088fa-bb22-4ad9-a735-7b2a3a41ef4e","uuid":"295fc89d-d478-4a61-896f-ca5461ced6be","timestamp":"2026-05-17T05:58:38.580Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/events/query.rs","content":"//! Typed query builder for bounded event-log reads.\n//!\n//! The reader defaults to a 1000-row limit and rejects requests above 10_000 rows.\n//! That ceiling keeps event-log reads bounded on hot paths: callers can page or use\n//! the streaming reader for larger replays, but no single query may degenerate into\n//! a full-log scan or unbounded in-memory buffer.\n\nuse thiserror::Error;\n\nuse crate::events::reader::EventReader;\nuse crate::events::{\n    BranchRef, EventEnvelope, EventKind, EventStoreError, PayloadHash, SessionId, TaskId,\n};\nuse crate::identity::{EventId, WorkspaceId};\nuse crate::{DateTime, Utc};\n\npub const DEFAULT_EVENT_QUERY_LIMIT: usize = 1_000;\npub const EVENT_QUERY_LIMIT_CEILING: usize = 10_000;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum QueryOrder {\n    OldestFirst,\n    NewestFirst,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct TaskScope {\n    pub task_id: TaskId,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct SessionScope {\n    pub session_id: SessionId,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum TailScope {\n    Task(TaskScope),\n    Session(SessionScope),\n}\n\nimpl From<TaskScope> for TailScope {\n    fn from(value: TaskScope) -> Self {\n        Self::Task(value)\n    }\n}\n\nimpl From<SessionScope> for TailScope {\n    fn from(value: SessionScope) -> Self {\n        Self::Session(value)\n    }\n}\n\n#[derive(Debug, Error)]\npub enum EventQueryError {\n    #[error(\"event queries require task, session, or workspace+branch scope\")]\n    Unscoped,\n    #[error(\"event query limit {requested} exceeds ceiling {ceiling}\")]\n    LimitTooLarge { requested: usize, ceiling: usize },\n    #[error(\"event store read failed: {0}\")]\n    Storage(#[from] EventStoreError),\n    #[error(\"event payload deserialization failed: {0}\")]\n    Serde(#[from] serde_json::Error),\n    #[error(\n        \"event payload corruption detected for `{event_id:?}`: expected {expected}, actual {actual}\"\n    )]\n    PayloadCorruption {\n        event_id: EventId,\n        expected: PayloadHash,\n        actual: PayloadHash,\n    },\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\npub struct EventQuery {\n    pub(crate) task_id: Option<String>,\n    pub(crate) session_id: Option<String>,\n    pub(crate) workspace_id: Option<String>,\n    pub(crate) branch: Option<String>,\n    pub(crate) kinds: Vec<EventKind>,\n    pub(crate) after: Option<DateTime<Utc>>,\n    pub(crate) before: Option<DateTime<Utc>>,\n    pub(crate) limit: Option<usize>,\n    pub(crate) order: Option<QueryOrder>,\n}\n\nimpl EventQuery {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    pub fn task(mut self, task_id: impl Into<String>) -> Self {\n        self.task_id = Some(task_id.into());\n        self\n    }\n\n    pub fn session(mut self, session_id: impl Into<String>) -> Self {\n        self.session_id = Some(session_id.into());\n        self\n    }\n\n    pub fn workspace(mut self, workspace_id: impl Into<String>) -> Self {\n        self.workspace_id = Some(workspace_id.into());\n        self\n    }\n\n    pub fn branch(mut self, branch_ref: impl Into<String>) -> Self {\n        self.branch = Some(branch_ref.into());\n        self\n    }\n\n    pub fn kind(mut self, kind: EventKind) -> Self {\n        self.kinds = vec![kind];\n        self\n    }\n\n    pub fn kinds(mut self, kinds: &[EventKind]) -> Self {\n        self.kinds = kinds.to_vec();\n        self\n    }\n\n    pub fn after(mut self, timestamp: DateTime<Utc>) -> Self {\n        self.after = Some(timestamp);\n        self\n    }\n\n    pub fn before(mut self, timestamp: DateTime<Utc>) -> Self {\n        self.before = Some(timestamp);\n        self\n    }\n\n    pub fn limit(mut self, limit: usize) -> Self {\n        self.limit = Some(limit);\n        self\n    }\n\n    pub fn order(mut self, order: QueryOrder) -> Self {\n        self.order = Some(order);\n        self\n    }\n\n    pub fn execute(self, reader: &EventReader) -> Result<Vec<EventEnvelope>, EventQueryError> {\n        reader.execute(self)\n    }\n\n    pub(crate) fn order_or_default(&self) -> QueryOrder {\n        self.order.unwrap_or(QueryOrder::OldestFirst)\n    }\n\n    pub(crate) fn limit_or_default(&self) -> usize {\n        self.limit.unwrap_or(DEFAULT_EVENT_QUERY_LIMIT).max(1)\n    }\n\n    pub(crate) fn validate(&self) -> Result<(), EventQueryError> {\n        let has_scope = self.task_id.is_some()\n            || self.session_id.is_some()\n            || (self.workspace_id.is_some() && self.branch.is_some());\n        if !has_scope {\n            return Err(EventQueryError::Unscoped);\n        }\n\n        let limit = self.limit_or_default();\n        if limit > EVENT_QUERY_LIMIT_CEILING {\n            return Err(EventQueryError::LimitTooLarge {\n                requested: limit,\n                ceiling: EVENT_QUERY_LIMIT_CEILING,\n            });\n        }\n        Ok(())\n    }\n\n    pub(crate) fn trace_scope(&self) -> String {\n        if let Some(task_id) = &self.task_id {\n            return format!(\"task:{task_id}\");\n        }\n        if let Some(session_id) = &self.session_id {\n            return format!(\"session:{session_id}\");\n        }\n        if let (Some(workspace_id), Some(branch)) = (&self.workspace_id, &self.branch) {\n            return format!(\"workspace:{workspace_id}@{branch}\");\n        }\n        \"unscoped\".to_string()\n    }\n}\n\npub(crate) fn event_id(workspace_id: &str, ulid: &str) -> EventId {\n    EventId {\n        workspace_id: workspace_id.to_string(),\n        ulid: ulid.to_string(),\n    }\n}\n\npub(crate) fn branch_ref(name: &str) -> BranchRef {\n    BranchRef {\n        name: name.to_string(),\n    }\n}\n\npub(crate) fn session_id(value: &str) -> SessionId {\n    SessionId {\n        value: value.to_string(),\n    }\n}\n\npub(crate) fn task_id(value: &str) -> TaskId {\n    TaskId {\n        value: value.to_string(),\n    }\n}\n\npub(crate) fn workspace_id(value: &str) -> WorkspaceId {\n    value.to_string()\n}\n","numLines":214,"startLine":1,"totalLines":214}}}
