the event payload body.\n108\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n109\tpub enum PayloadLocation {\n110\t    /// Payload bytes were stored inline with the event row.\n111\t    Inline {\n112\t        /// Serialized payload size in bytes.\n113\t        bytes_len: u32,\n114\t    },\n115\t    /// Payload bytes were spilled into a secondary storage row.\n116\t    Spilled {\n117\t        /// Row id of the spilled payload body.\n118\t        row_id: i64,\n119\t    },\n120\t}\n121\t\n122\t/// Compact human-readable summary with a hard byte ceiling.\n123\t#[derive(Clone, Debug, PartialEq, Eq, Hash)]\n124\tpub struct CompactSummary(String);\n125\t\n126\timpl CompactSummary {\n127\t    /// Construct a validated compact summary with a 512-byte ceiling.\n128\t    pub fn new(value: impl Into<String>) -> Result<Self, EventModelError> {\n129\t        let value = value.into();\n130\t        let actual_bytes = value.as_bytes().len();\n131\t        if actual_bytes > COMPACT_SUMMARY_MAX_BYTES {\n132\t            return Err(EventModelError::SummaryTooLong {\n133\t                actual_bytes,\n134\t                max_bytes: COMPACT_SUMMARY_MAX_BYTES,\n135\t            });\n136\t        }\n137\t\n138\t        Ok(Self(value))\n139\t    }\n140\t\n141\t    /// Return the summary as a borrowed string slice.\n142\t    pub fn as_str(&self) -> &str {\n143\t        self.0.as_str()\n144\t    }\n145\t}\n146\t\n147\timpl Serialize for CompactSummary {\n148\t    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>\n149\t    where\n150\t        S: Serializer,\n151\t    {\n152\t        serializer.serialize_str(self.as_str())\n153\t    }\n154\t}\n155\t\n156\timpl<'de> Deserialize<'de> for CompactSummary {\n157\t    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n158\t    where\n159\t        D: Deserializer<'de>,\n160\t    {\n161\t        struct CompactSummaryVisitor;\n162\t\n163\t        impl<'de> Visitor<'de> for CompactSummaryVisitor {\n164\t     