{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F8CVjvKMsXX9deDVnj5Vba","type":"tool_result","content":"1\tuse std::fmt;\n2\t\n3\tuse chrono::{DateTime, Utc};\n4\tuse serde::de::{self, Visitor};\n5\tuse serde::{Deserialize, Deserializer, Serialize, Serializer};\n6\t\n7\tuse crate::events::hashing::PayloadHash;\n8\tuse crate::events::kinds::{EventKind, EventPayload};\n9\tuse crate::events::DocSectionId;\n10\tuse crate::identity::{ContextHandleId, EventId, FileId, MemoryId, SymbolId, WorkspaceId};\n11\t\n12\tconst COMPACT_SUMMARY_MAX_BYTES: usize = 512;\n13\t\n14\t/// Validation error returned when event model invariants are violated.\n15\t#[derive(Clone, Debug, PartialEq, Eq)]\n16\tpub enum EventModelError {\n17\t    SummaryTooLong {\n18\t        actual_bytes: usize,\n19\t        max_bytes: usize,\n20\t    },\n21\t    KindPayloadMismatch {\n22\t        expected: EventKind,\n23\t        actual: EventKind,\n24\t    },\n25\t}\n26\t\n27\timpl fmt::Display for EventModelError {\n28\t    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n29\t        match self {\n30\t            EventModelError::SummaryTooLong {\n31\t                actual_bytes,\n32\t                max_bytes,\n33\t            } => write!(\n34\t                formatter,\n35\t                \"compact summary exceeds {} bytes (got {})\",\n36\t                max_bytes, actual_bytes\n37\t            ),\n38\t            EventModelError::KindPayloadMismatch { expected, actual } => write!(\n39\t                formatter,\n40\t                \"event payload kind mismatch: envelope kind `{}` does not match payload kind `{}`\",\n41\t                expected.as_str(),\n42\t                actual.as_str()\n43\t            ),\n44\t        }\n45\t    }\n46\t}\n47\t\n48\timpl std::error::Error for EventModelError {}\n49\t\n50\t/// Stable branch reference for an event stream.\n51\t#[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]\n52\tpub struct BranchRef