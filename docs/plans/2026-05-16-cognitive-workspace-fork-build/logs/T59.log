\t            ulid: \"stale-memory\".to_string(),\n51\t        },\n52\t        section: BundleSection::Stale,\n53\t        label_reason: \"stale verifier label\".to_string(),\n54\t        content: \"stale guidance\".to_string(),\n55\t    }];\n56\t\n57\t    SurfacingPipeline::enforce_trusted_invariant_for_test(&mut trusted, module_path!());\n58\t}\n59\t\n60\t#[test]\n61\tfn label_reason_is_non_empty_and_uses_verifier_reason_scope_file_and_expiry() {\n62\t    let memory = memory_for_status(\n63\t        MemoryVerificationStatus::Expired,\n64\t        \"file `src/foo.rs` line 42 changed; expiry 2026-04-01\",\n65\t    );\n66\t\n67\t    let bundle = SurfacingPipeline::partition(vec![memory]);\n68\t    let reason = &bundle.advisory[0].label_reason;\n69\t\n70\t    assert!(reason.contains(\"file `src/foo.rs` line 42 changed\"));\n71\t    assert!(reason.contains(\"expiry 2026-04-01\"));\n72\t    assert!(reason.contains(\"scope branch `main`\"));\n73\t    assert!(reason.contains(\"file `src/foo.rs`\"));\n74\t}\n75\t\n76\t#[test]\n77\tfn ranker_top_n_excludes_every_non_verified_memory_regardless_of_score() {\n78\t    let verified = ranked_memory(\"verified\", 1.0);\n79\t    let stale = ranked_memory(\"stale\", 100.0);\n80\t    let contradicted = ranked_memory(\"contradicted\", 90.0);\n81\t    let ctx = scoring_context([\n82\t        (\"verified\", MemoryVerificationStatus::Verified),\n83\t        (\"stale\", MemoryVerificationStatus::Stale),\n84\t        (\"contradicted\", MemoryVerificationStatus::Contradicted),\n85\t    ]);\n86\t\n87\t    let trusted =\n88\t        SurfacingPipeline::trusted_ranked_top_n(vec![stale, contradicted, verified], &ctx, 10);\n89\t\n90\t    assert_eq!(trusted.len(), 1);\n91\t    assert_eq!(trusted[0].candidate.identity, memory_identity(\"verified\"));\n92\t}\n93\t\n94\t#[test]\n95\tfn classify_covers_all_verification_status_variants() {\n96\t    let sections = all_statuses()\n97\t        .into_iter()\n98\t        .map(|status| classify_status(&status))\n99\t        .collect::<Vec<_>>();\n100\t\n101\t    assert_eq!(\n102\t        sections,\n103\t        vec![\n104\t            BundleSection::Trusted,\n105\t            BundleSection::Unverified,\n106\t            BundleSection::InReview,\n107\t            BundleSection::Stale,\n108\t            BundleSection::Contradicted,\n109\t            BundleSection::Superseded,\n110\t            BundleSection::Expired,\n111\t            BundleSection::Invalidated,\n112\t        ]\n113\t    );\n114\t}\n115\t\n116\tfn all_statuses() -> Vec<MemoryVerificationStatus> {\n117\t    vec![\n118\t        MemoryVerificationStatus::Verified,\n119\t        MemoryVerificationStatus::Unverified,\n120\t        MemoryVerificationStatus::InReview,\n121\t        MemoryVerificationStatus::Stale,\n122\t        MemoryVerificationStatus::Contradicted,\n123\t        MemoryVerificationStatus::Superseded,\n124\t        MemoryVerificationStatus::Expired,\n125\t        MemoryVerificationStatus::Invalidated,\n126\t    ]\n127\t}\n128\t\n129\tfn memory_for_status(status: MemoryVerificationStatus, reason: &str) -> Memory {\n130\t    Memory {\n131\t        id: status.as_str().to_string(),\n132\t        session_id: \"session\".to_string(),\n133\t        content: format!(\"{} guidance\", status.as_str()),\n134\t        memory_type: MemoryType::Observation,\n135\t        scope: MemoryScope::Branch,\n136\t        confidence: 0.9,\n137\t        linked_symbols: Vec::new(),\n138\t        linked_files: vec![\"src/foo.rs\".to_string()],\n139\t        workspace_id: Some(\"workspace\".to_string()),\n140\t        branch: Some(\"main\".to_string()),\n141\t        scope_organization_id: None,\n142\t        refresh_key: None,\n143\t        source_query: None,\n144\t        created_at: 1,\n145\t        last_accessed: 2,\n146\t        access_count: 0,\n147\t        is_stale: status != MemoryVerificationStatus::Verified,\n148\t        stale_reason: Some(reason.to_string()),\n149\t        verification_status: status,\n150\t    }\n151\t}\n152\t\n153\tfn ranked_memory(id: &str, score: f32) -> RankedCandidate {\n154\t    RankedCandidate {\n155\t        candidate: Candidate {\n156\t            identity: memory_identity(id),\n157\t            source: CandidateSource::MemoryLinks,\n158\t            seed_anchor: None,\n159\t            raw_score: score as f64,\n160\t            preliminary_inclusion_reason: format!(\"memory {id}\"),\n161\t            expansion_handle_hint: None,\n162\t            traversal_path: Vec::new(),\n163\t            budget_exhausted: false,\n164\t        },\n165\t        total_score: score,\n166\t        signal_scores: Vec::new(),\n167\t        inclusion_reason: format!(\"ranked memory {id}\"),\n168\t    }\n169\t}\n170\t\n171\tfn scoring_context(\n172\t    statuses: impl IntoIterator<Item = (&'static str, MemoryVerificationStatus)>,\n173\t) -> ScoringContext {\n174\t    let mut memory_metadata = BTreeMap::new();\n175\t    for (id, status) in statuses {\n176\t        memory_metadata.insert(\n177\t            memory_identity(id).to_string(),\n178\t            MemoryScoringMetadata {\n179\t                verification_status: status,\n180\t                scope: MemoryScope::Repo,\n181\t                confidence: 1.0,\n182\t                evidence_count: 1,\n183\t                created_at: Some(1),\n184\t                last_accessed: Some(2),\n185\t                access_count: 0,\n186\t                is_stale: status != MemoryVerificationStatus::Verified,\n187\t                superseded_by_memory_id: None,\n188\t                contradicted_by_memory_ids: Vec::new(),\n189\t            },\n190\t        );\n191\t    }\n192\t    ScoringContext {\n193\t        memory_metadata,\n194\t        ..ScoringContext::default()\n195\t    }\n196\t}\n197\t\n198\tfn memory_identity(id: &str) -> Identity {\n199\t    Identity::Memory(MemoryId {\n200\t        workspace_id: \"workspace\".to_string(),\n201\t        ulid: id.to_string(),\n202\t    })\n203\t}\n204\t"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"d931beba-4ad1-413e-ab6a-962ca5fe60e3","timestamp":"2026-05-17T13:11:25.647Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/surfacing_tests.rs","content":"use std::collections::BTreeMap;\n\nuse crate::identity::{Identity, MemoryId};\nuse crate::memory::{Memory, MemoryScope, MemoryType, MemoryVerificationStatus};\nuse crate::retrieval_v1::{\n    Candidate, CandidateSource, MemoryScoringMetadata, RankedCandidate, ScoringContext,\n};\nuse crate::verification::surfacing::{\n    classify_status, BundleSection, LabeledMemory, SurfacingPipeline,\n};\n\n#[test]\nfn verified_memories_land_in_trusted_and_all_other_states_are_advisory() {\n    let memories = all_statuses()\n        .into_iter()\n        .map(|status| memory_for_status(status, status.as_str()))\n        .collect::<Vec<_>>();\n\n    let bundle = SurfacingPipeline::partition(memories);\n\n    assert_eq!(bundle.trusted.len(), 1);\n    assert_eq!(bundle.trusted[0].section, BundleSection::Trusted);\n\n    let advisory_sections = bundle\n        .advisory\n        .iter()\n        .map(|memory| memory.section)\n        .collect::<Vec<_>>();\n    assert_eq!(\n        advisory_sections,\n        vec![\n            BundleSection::Unverified,\n            BundleSection::InReview,\n            BundleSection::Stale,\n            BundleSection::Contradicted,\n            BundleSection::Superseded,\n            BundleSection::Expired,\n            BundleSection::Invalidated,\n        ]\n    );\n}\n\n#[cfg(debug_assertions)]\n#[test]\n#[should_panic(expected = \"stale_in_trusted_bundle\")]\nfn debug_assertion_fires_when_non_trusted_memory_is_injected_into_trusted() {\n    let mut trusted = vec![LabeledMemory {\n        memory_id: MemoryId {\n            workspace_id: \"workspace\".to_string(),\n            ulid: \"stale-memory\".to_string(),\n        },\n        section: BundleSection::Stale,\n        label_reason: \"stale verifier label\".to_string(),\n        content: \"stale guidance\".to_string(),\n    }];\n\n    SurfacingPipeline::enforce_trusted_invariant_for_test(&mut trusted, module_path!());\n}\n\n#[test]\nfn label_reason_is_non_empty_and_uses_verifier_reason_scope_file_and_expiry() {\n    let memory = memory_for_status(\n        MemoryVerificationStatus::Expired,\n        \"file `src/foo.rs` line 42 changed; expiry 2026-04-01\",\n    );\n\n    let bundle = SurfacingPipeline::partition(vec![memory]);\n    let reason = &bundle.advisory[0].label_reason;\n\n    assert!(reason.contains(\"file `src/foo.rs` line 42 changed\"));\n    assert!(reason.contains(\"expiry 2026-04-01\"));\n    assert!(reason.contains(\"scope branch `main`\"));\n    assert!(reason.contains(\"file `src/foo.rs`\"));\n}\n\n#[test]\nfn ranker_top_n_excludes_every_non_verified_memory_regardless_of_score() {\n    let verified = ranked_memory(\"verified\", 1.0);\n    let stale = ranked_memory(\"stale\", 100.0);\n    let contradicted = ranked_memory(\"contradicted\", 90.0);\n    let ctx = scoring_context([\n        (\"verified\", MemoryVerificationStatus::Verified),\n        (\"stale\", MemoryVerificationStatus::Stale),\n        (\"contradicted\", MemoryVerificationStatus::Contradicted),\n    ]);\n\n    let trusted =\n        SurfacingPipeline::trusted_ranked_top_n(vec![stale, contradicted, verified], &ctx, 10);\n\n    assert_eq!(trusted.len(), 1);\n    assert_eq!(trusted[0].candidate.identity, memory_identity(\"verified\"));\n}\n\n#[test]\nfn classify_covers_all_verification_status_variants() {\n    let sections = all_statuses()\n        .into_iter()\n        .map(|status| classify_status(&status))\n        .collect::<Vec<_>>();\n\n    assert_eq!(\n        sections,\n        vec![\n            BundleSection::Trusted,\n            BundleSection::Unverified,\n            BundleSection::InReview,\n            BundleSection::Stale,\n            BundleSection::Contradicted,\n            BundleSection::Superseded,\n            BundleSection::Expired,\n            BundleSection::Invalidated,\n        ]\n    );\n}\n\nfn all_statuses() -> Vec<MemoryVerificationStatus> {\n    vec![\n        MemoryVerificationStatus::Verified,\n        MemoryVerificationStatus::Unverified,\n        MemoryVerificationStatus::InReview,\n        MemoryVerificationStatus::Stale,\n        MemoryVerificationStatus::Contradicted,\n        MemoryVerificationStatus::Superseded,\n        MemoryVerificationStatus::Expired,\n        MemoryVerificationStatus::Invalidated,\n    ]\n}\n\nfn memory_for_status(status: MemoryVerificationStatus, reason: &str) -> Memory {\n    Memory {\n        id: status.as_str().to_string(),\n        session_id: \"session\".to_string(),\n        content: format!(\"{} guidance\", status.as_str()),\n        memory_type: MemoryType::Observation,\n        scope: MemoryScope::Branch,\n        confidence: 0.9,\n        linked_symbols: Vec::new(),\n        linked_files: vec![\"src/foo.rs\".to_string()],\n        workspace_id: Some(\"workspace\".to_string()),\n        branch: Some(\"main\".to_string()),\n        scope_organization_id: None,\n        refresh_key: None,\n        source_query: None,\n        created_at: 1,\n        last_accessed: 2,\n        access_count: 0,\n        is_stale: status != MemoryVerificationStatus::Verified,\n        stale_reason: Some(reason.to_string()),\n        verification_status: status,\n    }\n}\n\nfn ranked_memory(id: &str, score: f32) -> RankedCandidate {\n    RankedCandidate {\n        candidate: Candidate {\n            identity: memory_identity(id),\n            source: CandidateSource::MemoryLinks,\n            seed_anchor: None,\n            raw_score: score as f64,\n            preliminary_inclusion_reason: format!(\"memory {id}\"),\n            expansion_handle_hint: None,\n            traversal_path: Vec::new(),\n            budget_exhausted: false,\n        },\n        total_score: score,\n        signal_scores: Vec::new(),\n        inclusion_reason: format!(\"ranked memory {id}\"),\n    }\n}\n\nfn scoring_context(\n    statuses: impl IntoIterator<Item = (&'static str, MemoryVerificationStatus)>,\n) -> ScoringContext {\n    let mut memory_metadata = BTreeMap::new();\n    for (id, status) in statuses {\n        memory_metadata.insert(\n            memory_identity(id).to_string(),\n            MemoryScoringMetadata {\n                verification_status: status,\n                scope: MemoryScope::Repo,\n                confidence: 1.0,\n                evidence_count: 1,\n                created_at: Some(1),\n                last_accessed: Some(2),\n                access_count: 0,\n                is_stale: status != MemoryVerificationStatus::Verified,\n                superseded_by_memory_id: None,\n                contradicted_by_memory_ids: Vec::new(),\n            },\n        );\n    }\n    ScoringContext {\n        memory_metadata,\n        ..ScoringContext::default()\n    }\n}\n\nfn memory_identity(id: &str) -> Identity {\n    Identity::Memory(MemoryId {\n        workspace_id: \"workspace\".to_string(),\n        ulid: id.to_string(),\n    })\n}\n","numLines":204,"startLine":1,"totalLines":204}}}
docs/plans/2026-05-16-cognitive-workspace-fork-build/logs/R55.log:115:{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01We7MV52Y7EQg3zKHVeEQUJ","type":"tool_result","content":"1\tuse std::panic::{catch_unwind, AssertUnwindSafe};\n2\t\n3\tuse super::{ScopeEnforcement, ScopeFilter, VerificationStatus};\n4\tuse crate::events::BranchRef;\n5\tuse crate::memory::{Memory, MemoryScope, MemoryStore, MemoryType};\n6\t\n7\t#[test]\n8\tfn branch_scope_memory_does_not_list_for_unrelated_branch() {\n9\t    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n10\t    let memory_id = store\n11\t        .store(scoped_memory(\n12\t            \"branch-memory\",\n13\t            MemoryScope::Branch,\n14\t            \"session-a\",\n15\t            Some(\"workspace-a\"),\n16\t            Some(\"feat/foo\"),\n17\t            None,\n18\t        ))\n19\t        .expect(\"branch memory stores\");\n20\t\n21\t    let visible = store\n22\t        .list_all_scoped(&filter(\"workspace-a\", Some(\"feat/bar\"), None, None))\n23\t        .expect(\"scoped list succeeds\");\n24\t\n25\t    assert!(visible.iter().all(|memory| memory.id != memory_id));\n26\t}\n27\t\n28\t#[test]\n29\tfn repo_scope_memory_does_not_list_for_unrelated_workspace() {\n30\t    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n31\t    let memory_id = store\n32\t        .store(scoped_memory(\n33\t            \"repo-memory\",\n34\t            MemoryScope::Repo,\n35\t            \"session-a\",\n36\t            Some(\"workspace-a\"),\n37\t            None,\n38\t            None,\n39\t        ))\n40\t        .expect(\"repo memory stores\");\n41\t\n42\t    let visible = store\n43\t        .list_all_scoped(&filter(\"workspace-b\", Some(\"main\"), None, None))\n44\t        .expect(\"scoped list succeeds\");\n45\t\n46\t    assert!(visible.iter().all(|memory| memory.id != memory_id));\n47\t}\n48\t\n49\t#[test]\n50\tfn organization_scope_requires_matching_organization() {\n51\t    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n52\t    let memory_id = store\n53\t        .store(scoped_memory(\n54\t            \"organization-memory\",\n55\t            MemoryScope::Organization,\n56\t            \"session-a\",\n57\t            None,\n58\t            None,\n59\t            Some(\"org-a\"),\n60\t        ))\n61\t        .expect(\"organization memory stores\");\n62\t\n63\t    let missing_org = store\n64\t        .list_all_scoped(&filter(\"workspace-a\", Some(\"main\"), None, None))\n65\t        .expect(\"missing organization filter succeeds\");\n66\t    let different_org = store\n67\t        .list_all_scoped(&filter(\"workspace-a\", Some(\"main\"), Some(\"org-b\"), None))\n68\t        .expect(\"different organization filter succeeds\");\n69\t\n70\t    assert!(missing_org.iter().all(|memory| memory.id != memory_id));\n71\t    assert!(different_org.iter().all(|memory| memory.id != memory_id));\n72\t}\n73\t\n74\t#[test]\n75\tfn session_scope_memory_does_not_list_for_different_session() {\n76\t    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n77\t    let memory_id = store\n78\t        .store(scoped_memory(\n79\t            \"session-memory\",\n80\t            MemoryScope::Session,\n81\t            \"session-a\",\n82\t            Some(\"workspace-a\"),\n83\t            Some(\"main\"),\n84\t            None,\n85\t        ))\n86\t        .expect(\"session memory stores\");\n87\t\n88\t    let visible = store\n89\t        .list_all_scoped(&filter(\n90\t            \"workspace-a\",\n91\t            Some(\"main\"),\n92\t            None,\n93\t            Some(\"session-b\"),\n94\t        ))\n95\t        .expect(\"scoped list succeeds\");\n96\t\n97\t    assert!(visible.iter().all(|memory| memory.id != memory_id));\n98\t}\n99\t\n100\t#[test]\n101\tfn audit_memory_invalidates_leaked_memory() {\n102\t    let memory = scoped_memory(\n103\t        \"leaked-branch-memory\",\n104\t        MemoryScope::Branch,\n105\t        \"session-a\",\n106\t        Some(\"workspace-a\"),\n107\t        Some(\"feat/foo\"),\n108\t        None,\n109\t    );\n110\t\n111\t    let verdict = ScopeEnforcement::audit_memory(\n112\t        &memory,\n113\t        &filter(\"workspace-a\", Some(\"feat/bar\"), None, None),\n114\t    );\n115\t\n116\t    assert_eq!(verdict.status, VerificationStatus::Invalidated);\n117\t    assert_eq!(verdict.reason, \"ScopeLeak\");\n118\t}\n119\t\n120\t#[cfg(debug_assertions)]\n121\t#[test]\n122\tfn debug_guard_panics_when_leaked_row_reaches_boundary() {\n123\t    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n124\t    let leaked = scoped_memory(\n125\t        \"leaked-repo-memory\",\n126\t        MemoryScope::Repo,\n127\t        \"session-a\",\n128\t        Some(\"workspace-a\"),\n129\t        None,\n130\t        None,\n131\t    );\n132\t\n133\t    let result = catch_unwind(AssertUnwindSafe(|| {\n134\t        store\n135\t            .enforce_scope_boundary(\n136\t                vec![leaked],\n137\t                &filter(\"workspace-b\", Some(\"main\"), None, None),\n138\t                \"test bypass\",\n139\t            )\n140\t            .expect(\"scope boundary should panic before returning\");\n141\t    }));\n142\t\n143\t    assert!(result.is_err());\n144\t}\n145\t\n146\t#[test]\n147\tfn scope_filter_event_is_emitted_for_each_store_boundary_drop() {\n148\t    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n149\t    store\n150\t        .store(scoped_memory(\n151\t            \"branch-memory\",\n152\t            MemoryScope::Branch,\n153\t            \"session-a\",\n154\t            Some(\"workspace-a\"),\n155\t            Some(\"feat/foo\"),\n156\t            None,\n157\t        ))\n158\t        .expect(\"branch memory stores\");\n159\t    store\n160\t        .store(scoped_memory(\n161\t            \"repo-memory\",\n162\t            MemoryScope::Repo,\n163\t            \"session-a\",\n164\t            Some(\"workspace-b\"),\n165\t            None,\n166\t            None,\n167\t        ))\n168\t        .expect(\"repo memory stores\");\n169\t\n170\t    let visible = store\n171\t        .list_all_scoped(&filter(\"workspace-a\", Some(\"feat/bar\"), None, None))\n172\t        .expect(\"scoped list succeeds\");\n173\t    let events = store\n174\t        .scope_filter_events()\n175\t        .expect(\"scope filter events load\");\n176\t\n177\t    assert!(visible.is_empty());\n178\t    assert_eq!(events.len(), 2);\n179\t    assert!(events\n180\t        .iter()\n181\t        .all(|event| event.attempted_workspace_id == \"workspace-a\"));\n182\t}\n183\t\n184\tfn filter(\n185\t    workspace_id: &str,\n186\t    branch: Option<&str>,\n187\t    organization_id: Option<&str>,\n188\t    session_id: Option<&str>,\n189\t) -> ScopeFilter {\n190\t    let branch = branch.map(|name| BranchRef {\n191\t        name: name.to_string(),\n192\t    });\n193\t    let filter = ScopeFilter::new(workspace_id, branch, organization_id.map(str::to_string));\n194\t    if let Some(session_id) = session_id {\n195\t        return filter.for_session(session_id);\n196\t    }\n197\t    filter\n198\t}\n199\t\n200\tfn scoped_memory(\n201\t    id: &str,\n202\t    scope: MemoryScope,\n203\t    session_id: &str,\n204\t    workspace_id: Option<&str>,\n205\t    branch: Option<&str>,\n206\t    organization_id: Option<&str>,\n207\t) -> Memory {\n208\t    Memory {\n209\t        id: id.to_string(),\n210\t        session_id: session_id.to_string(),\n211\t        content: format!(\"{id} content\"),\n212\t        memory_type: MemoryType::Observation,\n213\t        scope,\n214\t        confidence: 1.0,\n215\t        linked_symbols: Vec::new(),\n216\t        linked_files: Vec::new(),\n217\t        workspace_id: workspace_id.map(str::to_string),\n218\t        branch: branch.map(str::to_string),\n219\t        scope_organization_id: organization_id.map(str::to_string),\n220\t        refresh_key: None,\n221\t        source_query: None,\n222\t        created_at: 1,\n223\t        last_accessed: 1,\n224\t        access_count: 0,\n225\t        is_stale: false,\n226\t        stale_reason: None,\n227\t        verification_status: crate::memory::MemoryVerificationStatus::Unverified,\n228\t    }\n229\t}\n230\t"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"1af2a4b4-b474-44ce-970a-3caa047a4cc2","timestamp":"2026-05-17T13:11:28.768Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/scope_leak_tests.rs","content":"use std::panic::{catch_unwind, AssertUnwindSafe};\n\nuse super::{ScopeEnforcement, ScopeFilter, VerificationStatus};\nuse crate::events::BranchRef;\nuse crate::memory::{Memory, MemoryScope, MemoryStore, MemoryType};\n\n#[test]\nfn branch_scope_memory_does_not_list_for_unrelated_branch() {\n    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n    let memory_id = store\n        .store(scoped_memory(\n            \"branch-memory\",\n            MemoryScope::Branch,\n            \"session-a\",\n            Some(\"workspace-a\"),\n            Some(\"feat/foo\"),\n            None,\n        ))\n        .expect(\"branch memory stores\");\n\n    let visible = store\n        .list_all_scoped(&filter(\"workspace-a\", Some(\"feat/bar\"), None, None))\n        .expect(\"scoped list succeeds\");\n\n    assert!(visible.iter().all(|memory| memory.id != memory_id));\n}\n\n#[test]\nfn repo_scope_memory_does_not_list_for_unrelated_workspace() {\n    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n    let memory_id = store\n        .store(scoped_memory(\n            \"repo-memory\",\n            MemoryScope::Repo,\n            \"session-a\",\n            Some(\"workspace-a\"),\n            None,\n            None,\n        ))\n        .expect(\"repo memory stores\");\n\n    let visible = store\n        .list_all_scoped(&filter(\"workspace-b\", Some(\"main\"), None, None))\n        .expect(\"scoped list succeeds\");\n\n    assert!(visible.iter().all(|memory| memory.id != memory_id));\n}\n\n#[test]\nfn organization_scope_requires_matching_organization() {\n    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n    let memory_id = store\n        .store(scoped_memory(\n            \"organization-memory\",\n            MemoryScope::Organization,\n            \"session-a\",\n            None,\n            None,\n            Some(\"org-a\"),\n        ))\n        .expect(\"organization memory stores\");\n\n    let missing_org = store\n        .list_all_scoped(&filter(\"workspace-a\", Some(\"main\"), None, None))\n        .expect(\"missing organization filter succeeds\");\n    let different_org = store\n        .list_all_scoped(&filter(\"workspace-a\", Some(\"main\"), Some(\"org-b\"), None))\n        .expect(\"different organization filter succeeds\");\n\n    assert!(missing_org.iter().all(|memory| memory.id != memory_id));\n    assert!(different_org.iter().all(|memory| memory.id != memory_id));\n}\n\n#[test]\nfn session_scope_memory_does_not_list_for_different_session() {\n    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n    let memory_id = store\n        .store(scoped_memory(\n            \"session-memory\",\n            MemoryScope::Session,\n            \"session-a\",\n            Some(\"workspace-a\"),\n            Some(\"main\"),\n            None,\n        ))\n        .expect(\"session memory stores\");\n\n    let visible = store\n        .list_all_scoped(&filter(\n            \"workspace-a\",\n            Some(\"main\"),\n            None,\n            Some(\"session-b\"),\n        ))\n        .expect(\"scoped list succeeds\");\n\n    assert!(visible.iter().all(|memory| memory.id != memory_id));\n}\n\n#[test]\nfn audit_memory_invalidates_leaked_memory() {\n    let memory = scoped_memory(\n        \"leaked-branch-memory\",\n        MemoryScope::Branch,\n        \"session-a\",\n        Some(\"workspace-a\"),\n        Some(\"feat/foo\"),\n        None,\n    );\n\n    let verdict = ScopeEnforcement::audit_memory(\n        &memory,\n        &filter(\"workspace-a\", Some(\"feat/bar\"), None, None),\n    );\n\n    assert_eq!(verdict.status, VerificationStatus::Invalidated);\n    assert_eq!(verdict.reason, \"ScopeLeak\");\n}\n\n#[cfg(debug_assertions)]\n#[test]\nfn debug_guard_panics_when_leaked_row_reaches_boundary() {\n    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n    let leaked = scoped_memory(\n        \"leaked-repo-memory\",\n        MemoryScope::Repo,\n        \"session-a\",\n        Some(\"workspace-a\"),\n        None,\n        None,\n    );\n\n    let result = catch_unwind(AssertUnwindSafe(|| {\n        store\n            .enforce_scope_boundary(\n                vec![leaked],\n                &filter(\"workspace-b\", Some(\"main\"), None, None),\n                \"test bypass\",\n            )\n            .expect(\"scope boundary should panic before returning\");\n    }));\n\n    assert!(result.is_err());\n}\n\n#[test]\nfn scope_filter_event_is_emitted_for_each_store_boundary_drop() {\n    let store = MemoryStore::open_in_memory().expect(\"memory store opens\");\n    store\n        .store(scoped_memory(\n            \"branch-memory\",\n            MemoryScope::Branch,\n            \"session-a\",\n            Some(\"workspace-a\"),\n            Some(\"feat/foo\"),\n            None,\n        ))\n        .expect(\"branch memory stores\");\n    store\n        .store(scoped_memory(\n            \"repo-memory\",\n            MemoryScope::Repo,\n            \"session-a\",\n            Some(\"workspace-b\"),\n            None,\n            None,\n        ))\n        .expect(\"repo memory stores\");\n\n    let visible = store\n        .list_all_scoped(&filter(\"workspace-a\", Some(\"feat/bar\"), None, None))\n        .expect(\"scoped list succeeds\");\n    let events = store\n        .scope_filter_events()\n        .expect(\"scope filter events load\");\n\n    assert!(visible.is_empty());\n    assert_eq!(events.len(), 2);\n    assert!(events\n        .iter()\n        .all(|event| event.attempted_workspace_id == \"workspace-a\"));\n}\n\nfn filter(\n    workspace_id: &str,\n    branch: Option<&str>,\n    organization_id: Option<&str>,\n    session_id: Option<&str>,\n) -> ScopeFilter {\n    let branch = branch.map(|name| BranchRef {\n        name: name.to_string(),\n    });\n    let filter = ScopeFilter::new(workspace_id, branch, organization_id.map(str::to_string));\n    if let Some(session_id) = session_id {\n        return filter.for_session(session_id);\n    }\n    filter\n}\n\nfn scoped_memory(\n    id: &str,\n    scope: MemoryScope,\n    session_id: &str,\n    workspace_id: Option<&str>,\n    branch: Option<&str>,\n    organization_id: Option<&str>,\n) -> Memory {\n    Memory {\n        id: id.to_string(),\n        session_id: session_id.to_string(),\n        content: format!(\"{id} content\"),\n        memory_type: MemoryType::Observation,\n        scope,\n        confidence: 1.0,\n        linked_symbols: Vec::new(),\n        linked_files: Vec::new(),\n        workspace_id: workspace_id.map(str::to_string),\n        branch: branch.map(str::to_string),\n        scope_organization_id: organization_id.map(str::to_string),\n        refresh_key: None,\n        source_query: None,\n        created_at: 1,\n        last_accessed: 1,\n        access_count: 0,\n        is_stale: false,\n        stale_reason: None,\n        verification_status: crate::memory::MemoryVerificationStatus::Unverified,\n    }\n}\n","numLines":230,"startLine":1,"totalLines":230}}}
