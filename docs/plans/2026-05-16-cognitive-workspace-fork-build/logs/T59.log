+                    ulid: memory.id.clone(),
+                })
+                .collect();
+            let reasons: Vec<String> = bundle
+                .memories
+                .iter()
+                .map(|memory| memory.inclusion_reason.clone())
+                .collect();
+            if let Err(error) = capture.record_memory_retrieved(&ids, &reasons) {
