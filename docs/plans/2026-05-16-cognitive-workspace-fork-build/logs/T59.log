+            &self.workspace_root,
+            &scope_filter,
+            &mut reports,
+            parsed.clone(),
+        )
+        .map_err(|message| (-32603, message))?;
+        drop(reports);
+        drop(graph_store);
+        drop(indexer);
+        drop(store);
