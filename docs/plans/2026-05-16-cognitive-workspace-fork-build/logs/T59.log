}

impl<'a> VerifierCore<'a> {
    pub fn new(
        store: &'a MemoryStore,
        runtime: &'a mut ConsolidationJobRuntime,
        graph: &'a CodeGraph,
        file_index: &'a HashMap<String, FileIndexEntry>,
        parsed_files: &'a HashMap<String, ParsedFile>,
        span_reader: &'a dyn SpanReader,
