   \"mem-superseded-reason\",\n405\t                MemoryVerificationStatus::Superseded,\n406\t                Some(\"superseded by mem-newer\"),\n407\t                vec![\"src/superseded.rs\"],\n408\t            ),\n409\t            self.store_with_status(\n410\t                \"mem-expired-reason\",\n411\t                MemoryVerificationStatus::Expired,\n412\t                Some(\"expiry 2026-05-17T00:00:00Z\"),\n413\t                vec![\"src/expired.rs\"],\n414\t            ),\n415\t            self.store_with_status(\n416\t                \"mem-invalidated-reason\",\n417\t                MemoryVerificationStatus::Invalidated,\n418\t                Some(\"file id src/deleted.rs removed\"),\n419\t                vec![\"src/deleted.rs\"],\n420\t            ),\n421\t        ]\n422\t    }\n423\t\n424\t    fn store_with_status(\n425\t        &self,\n426\t        id: &str,\n427\t        status: MemoryVerificationStatus,\n428\t        stale_reason: Option<&str>,\n429\t        linked_files: Vec<&str>,\n430\t    ) -> String {\n431\t        let is_stale = matches!(status, MemoryVerificationStatus::Stale);\n432\t        let memory_id = self.store_memory(Memory {\n433\t            stale_reason: stale_reason.map(str::to_string),\n434\t            is_stale,\n435\t            verification_status: status,\n436\t            linked_files: linked_files.into_iter().map(str::to_string).collect(),\n437\t            ..base_memory(id, &format!(\"memory {id}\"), MemoryScope::Branch, vec![])\n438\t        });\n439\t        let mut fields = self\n440\t            .memory_store\n441\t            .get_structured_fields(&memory_id)\n442\t            .expect(\"fields load\")\n443\t            .expect(\"fields exist\");\n444\t        fields.verification_status = status;\n445\t        self.set_fields(&memory_id, fields);\n446\t        memory_id\n447\t    }\n448\t\n449\t    fn store_memory(&self, memory: Memory) -> String {\n450\t        self.memory_store.store(memory).expect(\"memory st