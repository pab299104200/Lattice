+                LatticeError::Storage(format!("Failed to execute inbound memory link query: {}", e))
+            })?;
+        rows.collect::<Result<Vec<_>, _>>().map_err(|e| {
+            LatticeError::Storage(format!("Failed to read inbound memory link row: {}", e))
+        })
