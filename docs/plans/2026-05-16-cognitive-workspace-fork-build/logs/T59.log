+        let response = memory_v2::save_memory::build_response(
+            &store,
+            &workspace_id,
+            &memory_id,
+            verification_job_id,
+        )
+        .map_err(|error| (-32603, error))?;
+        if let Some(capture) = &self.event_capture {
+            let memory_identity = MemoryId {
