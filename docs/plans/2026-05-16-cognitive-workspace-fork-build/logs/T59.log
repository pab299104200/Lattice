S_VERIFIED: &str = \"01ARZ3NDEKTSV4RRFFQ69G5FAE\";\n35\tpub(super) const MEMORY_CONFIG_VERIFIED: &str = \"01ARZ3NDEKTSV4RRFFQ69G5FAF\";\n36\t\n37\t#[derive(Clone, Debug, PartialEq, Eq)]\n38\tpub(super) enum ExpectedIdentity {\n39\t    File(&'static str),\n40\t    Symbol {\n41\t        file: &'static str,\n42\t        qualified_name: &'static str,\n43\t    },\n44\t    Section {\n45\t        path: &'static str,\n46\t        heading: &'static str,\n47\t    },\n48\t    Memory(&'static str),\n49\t}\n50\t\n51\timpl ExpectedIdentity {\n52\t    pub(super) fn matches(&self, identity: &Identity) -> bool {\n53\t        match (self, identity) {\n54\t            (Self::File(path), Identity::File(file)) => file.repo_relative_path == *path,\n55\t            (\n56\t                Self::Symbol {\n57\t                    file,\n58\t                    qualified_name,\n59\t                },\n60\t                Identity::Symbol(symbol),\n61\t            ) => {\n62\t                symbol.file.repo_relative_path == *file && symbol.qualified_name == *qualified_name\n63\t            }\n64\t            (Self::Section { path, heading }, Identity::Section(section)) => {\n65\t                section.doc.repo_relative_path == *path\n66\t                    && section.heading_path.last().map(String::as_str) == Some(*heading)\n67\t            }\n68\t            (Self::Memory(ulid), Identity::Memory(memory)) => memory.ulid == *ulid,\n69\t            _ => false,\n70\t        }\n71\t    }\n72\t\n73\t    pub(super) fn label(&self) -> String {\n74\t        match self {\n75\t            Self::File(path) => (*path).to_string(),\n76\t            Self::Symbol {\n77\t                file,\n78\t                qualified_name,\n79\t            } => format!(\"{file}::{qualified_name}\"),\n80\t            Self::Section { path, heading } => format!(\"{path}#{heading}\"),\n81\t            Self::Memory(ulid) => format!(\"memory {ulid}\"),\n82\t        }\n83\t    }\n84\t}\n85\t\n86\t#[derive(Clone, Debug)]\n87\tpub(super) struct GoldenCase {\n88\t    pub name: &'static str,\n89\t    pub task: &'static str,\n90\t    pub anchor_kind: AnchorKind,\n91\t    pub expected_anchor_text: &'static str,\n92\t    pub expected_resolved_identity: ExpectedIdentity,\n93\t    pub expected_top_identity: ExpectedIdentity,\n94\t    pub dominant_signal: &'static str,\n95\t    pub shaper_token_budget: usize,\n96\t    pub query_embedding: [f32; 3],\n97\t}\n98\t\n99\tpub(super) struct GoldenFixture {\n100\t    pub resolver: IdentityResolver<'static>,\n101\t    pub graph: &'static CodeGraph,\n102\t    pub memory_store: MemoryStore,\n103\t    pub vector_store: VectorStore,\n104\t    pub events: Vec<EventEnvelope>,\n105\t    pub working_memory: Vec<Identity>,\n106\t    pub scoring_context: ScoringContext,\n107\t}\n108\t\n109\tpub(super) struct GoldenRun {\n110\t    pub anchors: Vec<ResolvedAnchor>,\n111\t    pub ranked: Vec<RankedCandidate>,\n112\t    pub diagnostics: RankingDiagnostics,\n113\t    pub bundle: crate::retrieval_v1::schema::RetrievalBundle,\n114\t    pub latency_ms: f64,\n115\t}\n116\t\n117\tpub(super) fn golden_case(name: &str) -> GoldenCase {\n118\t    golden_cases()\n119\t        .into_iter()\n120\t        .find(|case| case.name == name)\n121\t        .unwrap_or_else(|| panic!(\"missing golden case `{name}`\"))\n122\t}\n123\t\n124\tpub(super) fn golden_cases() -> Vec<GoldenCase> {\n125\t    vec![\n126\t        case(\n127\t            \"path_auth_file_anchor_returns_auth_file\",\n128\t            \"Review `src/auth.rs` before changing the login flow\",\n129\t            AnchorKind::Path,\n130\t            \"src/auth.rs\",\n131\t            ExpectedIdentity::File(\"src/auth.rs\"),\n132\t            ExpectedIdentity::File(\"src/auth.rs\"),\n133\t            [1.0, 0.0, 0.0],\n134\t            110,\n135\t        ),\n136\t        case(\n137\t            \"path_session_file_anchor_returns_session_file\",\n138\t            \"Trace `src/session.rs` because the session cache broke\",\n139\t 