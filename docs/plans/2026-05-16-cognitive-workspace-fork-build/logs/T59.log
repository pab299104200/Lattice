+            .map_err(|message| (-32602, message))?;
+        self.tool_verify_explain_memory(
+            &serde_json::to_value(&parsed).map_err(|error| {
+                (-32603, format!("Failed to serialize explain shim arguments: {error}"))
+            })?,
+            deprecation_warning,
