                        &entry.content_hash,
                        entry.mtime_ns,
                        entry.size_bytes,
                        entry.parser_version,
                        entry.schema_version,
                        entry.last_indexed_at,
                    ])
                    .map_err(|e| {
                        LatticeError::Storage(format!("Failed to insert file index row: {}", e))
                    })?;
            }
        }
        tx.commit()
            .map_err(|e| LatticeError::Storage(format!("Failed to commit file index: {}", e)))?;
        Ok(())
    }

