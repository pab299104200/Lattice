\n            VerificationStatus::Expired => \"expired\",\n            VerificationStatus::Invalidated => \"invalidated\",\n        }\n    }\n}\n\nimpl fmt::Display for VerificationStatus {\n    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n        formatter.write_str(self.as_str())\n    }\n}\n\nimpl FromStr for VerificationStatus {\n    type Err = MemoryGraphParseError;\n\n    fn from_str(value: &str) -> Result<Self, Self::Err> {\n        match value {\n            \"unverified\" => Ok(VerificationStatus::Unverified),\n            \"in_review\" => Ok(VerificationStatus::InReview),\n            \"verified\" => Ok(VerificationStatus::Verified),\n            \"stale\" => Ok(VerificationStatus::Stale),\n            \"contradicted\" => Ok(VerificationStatus::Contradicted),\n            \"superseded\" => Ok(VerificationStatus::Superseded),\n            \"expired\" => Ok(VerificationStatus::Expired),\n            \"invalidated\" => Ok(VerificationStatus::Invalidated),\n            other => Err(MemoryGraphParseError::UnknownVerificationStatus(\n                other.to_string(),\n            )),\n        }\n    }\n}\n\n#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[serde(rename_all = \"snake_case\")]\npub enum FreshnessKind {\n    SessionScoped,\n    BranchScoped,\n    RepoScoped,\n    TimeBound,\n    EventTriggered,\n}\n\n#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq, Hash)]\npub struct FreshnessPolicy {\n    pub kind: FreshnessKind,\n    pub ttl: Option<Duration>,\n    pub recheck_interval: Option<Duration>,\n}\n\n#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq, Hash)]\npub struct ValidityCondition {","numLines":100,"startLine":200,"totalLines":449}}}
docs/plans/2026-05-16-cognitive-workspace-fork-build/logs/R55.log:167:{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YG29dspPF6BHpfpp2gK7tT","type":"tool_result","content":"1\t//! Phase 7 verification integration tests.\n2\t//!\n3\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## Non-Negotiable Product Properties`:\n5\t//! \"Every stale or contradicted memory is surfaced as such, not hidden behind recency.\"\n6\t//!\n7\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n8\t//! `## Risks — Stale Memory Leakage`:\n9\t//! \"Control: freshness indexes, graph-change-triggered verification, stale labels in all memory surfaces, and tests that stale memory cannot rank as trusted.\"\n10\t//!\n11\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n12\t//! `## Risks — Scope Leakage`:\n13\t//! \"Control: scope-aware queries, enforced filters in store APIs, and negative tests.\"\n14\t//!\n15\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n16\t//! `## Phase 7: Verification And Freshness` DoD:\n17\t//! \"stale or contradicted memory cannot appear as normal trusted guidance\".\n18\t\n19\tuse std::collections::{BTreeMap, HashMap};\n20\tuse std::io::Write;\n21\tuse std::path::PathBuf;\n22\tuse std::sync::{Arc, Mutex};\n23\t\n24\tuse rusqlite::Connection;\n25\tuse serde_json::json;\n26\tuse sha2::{Digest, Sha256};\n27\tuse tempfile::tempdir;\n28\tuse tracing_subscriber::fmt::MakeWriter;\n29\t\n30\tuse super::{\n31\t    BundleSection, ExpiryScanner, IncrementalVerifier, ScopeFilter, SurfacingPipeline,\n32\t    VerificationObserver, WorkspaceFileReader,\n33\t};\n34\tuse crate::consolidation::llm::{\n35\t    BudgetCatalog, ConsolidationMode, ContradictionCandidatePair, ContradictionDetectionJob,\n36\t    LlmDriver, LlmDriverError, LlmJobContext, LlmJobServices, LlmRequest, LlmResponse,\n37\t};\n38\tuse crate::consolidation::{ConsolidationConfig, ConsolidationJobRuntime, ProposalDecision};\n39\tuse crate::events::{BranchRef, EventStore, EventWriter, FlushPolicy};\n40\tuse crate::graph::CodeGraph;\n41\tuse crate::identity::{FileId, Identity, MemoryId, OperatorId};\n42\tuse crate::memory::{\n43\t    EvidenceSpan, Memory, MemoryEvidence, MemoryScope, MemoryStore, MemoryStructuredFields,\n44\t    MemoryType, MemoryVerificationStatus,\n45\t};\n46\tuse crate::retrieval_v1::{\n47\t    Candidate, CandidateSource, MemoryScoringMetadata, RankedCandidate, ScoringContext,\n48\t};\n49\tuse crate::storage::graph_store::{\n50\t    FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n51\t};\n52\tuse crate::symbols::{Language, ParsedFile};\n53\tuse crate::{DateTime, Utc};\n54\t\n55\t#[test]\n56\tfn test_stale_memory_never_appears_in_trusted_bundle() {\n57\t    let harness = VerificationHarness::new();\n58\t    let memory_id = harness.seed_span_memory(\"mem-stale\", \"src/auth.ts\", \"const FLAG = true;\\n\");\n59\t    let changed = harness.file_id(\"src/auth.ts\", \"hash-auth-v2\");\n60\t    let report = harness.reverify_changed_file(\n61\t        &changed,\n62\t        \"const FLAG = false;\\n\",\n63\t        ObservationRecorder::default(),\n64\t    );\n65\t    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n66\t\n67\t    assert_eq!(report.stale, 1);\n68\t    assert_sections(&bundle, &memory_id, BundleSection::Stale);\n69\t}\n70\t\n71\t#[test]\n72\tfn test_contradicted_memory_never_appears_in_trusted_bundle() {\n73\t    let mut harness = VerificationHarness::new();\n74\t    let contradicted_id = harness.seed_plain_memory(\"mem-b\", \"The build never uses cargo check.\");\n75\t    let _contradictor_id =\n76\t        harness.seed_plain_memory(\"mem-a\", \"The build uses cargo check for verification.\");\n77\t\n78\t    harness.apply_contradiction(\"mem-b\", \"mem-a\");\n79\t    let bundle = harness.bundle_for_ids(&[contradicted_id.as_str()]);\n80\t\n81\t    assert_sections(&bundle, &contradicted_id, BundleSection::Contradicted);\n82\t}\n83\t\n84\t#[test]\n85\tfn test_expired_memory_never_appears_in_trusted_bundle() {\n86\t    let harness = VerificationHarness::new();\n87\t    let memory_id = harness.seed_file_memory(\"mem-expired\", \"src/expiry.rs\");\n88\t    harness\n89\t        .memory_store\n90\t        .set_expires_at(&memory_id, DateTime::from_unix_seconds(99))\n91\t        .expect(\"expiry stores\");\n92\t    harness.scan_expiry(DateTime::from_unix_seconds(100));\n93\t    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n94\t\n95\t    assert_sections(&bundle, &memory_id, BundleSection::Expired);\n96\t}\n97\t\n98\t#[test]\n99\tfn test_invalidated_memory_never_appears_in_trusted_bundle() {\n100\t    let harness = VerificationHarness::new();\n101\t    let memory_id = harness.seed_file_memory(\"mem-invalidated\", \"src/delete-me.ts\");\n102\t    harness.write_file(\"src/delete-me.ts\", \"export const alive = true;\\n\");\n103\t    harness.delete_file(\"src/delete-me.ts\");\n104\t    let deleted = harness.file_id(\"src/delete-me.ts\", \"hash-delete-v2\");\n105\t    let report = harness.reverify_deleted_file(&deleted, ObservationRecorder::default());\n106\t    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n107\t\n108\t    assert_eq!(report.invalidated, 1);\n109\t    assert_sections(&bundle, &memory_id, BundleSection::Invalidated);\n110\t}\n111\t\n112\t#[test]\n113\tfn test_scope_leak_blocked_at_store_boundary_for_all_scopes() {\n114\t    let harness = VerificationHarness::new();\n115\t    let logs = Arc::new(Mutex::new(Vec::new()));\n116\t    let subscriber = tracing_subscriber::fmt()\n117\t        .with_writer(BufferWriter(logs.clone()))\n118\t        .with_ansi(false)\n119\t        .finish();\n120\t    let _guard = tracing::subscriber::set_default(subscriber);"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"b0fa3c6d-9fed-4223-a0f0-d9639f079c2e","timestamp":"2026-05-17T13:13:43.261Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/verification/integration_tests.rs","content":"//! Phase 7 verification integration tests.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Non-Negotiable Product Properties`:\n//! \"Every stale or contradicted memory is surfaced as such, not hidden behind recency.\"\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Risks — Stale Memory Leakage`:\n//! \"Control: freshness indexes, graph-change-triggered verification, stale labels in all memory surfaces, and tests that stale memory cannot rank as trusted.\"\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Risks — Scope Leakage`:\n//! \"Control: scope-aware queries, enforced filters in store APIs, and negative tests.\"\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 7: Verification And Freshness` DoD:\n//! \"stale or contradicted memory cannot appear as normal trusted guidance\".\n\nuse std::collections::{BTreeMap, HashMap};\nuse std::io::Write;\nuse std::path::PathBuf;\nuse std::sync::{Arc, Mutex};\n\nuse rusqlite::Connection;\nuse serde_json::json;\nuse sha2::{Digest, Sha256};\nuse tempfile::tempdir;\nuse tracing_subscriber::fmt::MakeWriter;\n\nuse super::{\n    BundleSection, ExpiryScanner, IncrementalVerifier, ScopeFilter, SurfacingPipeline,\n    VerificationObserver, WorkspaceFileReader,\n};\nuse crate::consolidation::llm::{\n    BudgetCatalog, ConsolidationMode, ContradictionCandidatePair, ContradictionDetectionJob,\n    LlmDriver, LlmDriverError, LlmJobContext, LlmJobServices, LlmRequest, LlmResponse,\n};\nuse crate::consolidation::{ConsolidationConfig, ConsolidationJobRuntime, ProposalDecision};\nuse crate::events::{BranchRef, EventStore, EventWriter, FlushPolicy};\nuse crate::graph::CodeGraph;\nuse crate::identity::{FileId, Identity, MemoryId, OperatorId};\nuse crate::memory::{\n    EvidenceSpan, Memory, MemoryEvidence, MemoryScope, MemoryStore, MemoryStructuredFields,\n    MemoryType, MemoryVerificationStatus,\n};\nuse crate::retrieval_v1::{\n    Candidate, CandidateSource, MemoryScoringMetadata, RankedCandidate, ScoringContext,\n};\nuse crate::storage::graph_store::{\n    FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION,\n};\nuse crate::symbols::{Language, ParsedFile};\nuse crate::{DateTime, Utc};\n\n#[test]\nfn test_stale_memory_never_appears_in_trusted_bundle() {\n    let harness = VerificationHarness::new();\n    let memory_id = harness.seed_span_memory(\"mem-stale\", \"src/auth.ts\", \"const FLAG = true;\\n\");\n    let changed = harness.file_id(\"src/auth.ts\", \"hash-auth-v2\");\n    let report = harness.reverify_changed_file(\n        &changed,\n        \"const FLAG = false;\\n\",\n        ObservationRecorder::default(),\n    );\n    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n\n    assert_eq!(report.stale, 1);\n    assert_sections(&bundle, &memory_id, BundleSection::Stale);\n}\n\n#[test]\nfn test_contradicted_memory_never_appears_in_trusted_bundle() {\n    let mut harness = VerificationHarness::new();\n    let contradicted_id = harness.seed_plain_memory(\"mem-b\", \"The build never uses cargo check.\");\n    let _contradictor_id =\n        harness.seed_plain_memory(\"mem-a\", \"The build uses cargo check for verification.\");\n\n    harness.apply_contradiction(\"mem-b\", \"mem-a\");\n    let bundle = harness.bundle_for_ids(&[contradicted_id.as_str()]);\n\n    assert_sections(&bundle, &contradicted_id, BundleSection::Contradicted);\n}\n\n#[test]\nfn test_expired_memory_never_appears_in_trusted_bundle() {\n    let harness = VerificationHarness::new();\n    let memory_id = harness.seed_file_memory(\"mem-expired\", \"src/expiry.rs\");\n    harness\n        .memory_store\n        .set_expires_at(&memory_id, DateTime::from_unix_seconds(99))\n        .expect(\"expiry stores\");\n    harness.scan_expiry(DateTime::from_unix_seconds(100));\n    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n\n    assert_sections(&bundle, &memory_id, BundleSection::Expired);\n}\n\n#[test]\nfn test_invalidated_memory_never_appears_in_trusted_bundle() {\n    let harness = VerificationHarness::new();\n    let memory_id = harness.seed_file_memory(\"mem-invalidated\", \"src/delete-me.ts\");\n    harness.write_file(\"src/delete-me.ts\", \"export const alive = true;\\n\");\n    harness.delete_file(\"src/delete-me.ts\");\n    let deleted = harness.file_id(\"src/delete-me.ts\", \"hash-delete-v2\");\n    let report = harness.reverify_deleted_file(&deleted, ObservationRecorder::default());\n    let bundle = harness.bundle_for_ids(&[memory_id.as_str()]);\n\n    assert_eq!(report.invalidated, 1);\n    assert_sections(&bundle, &memory_id, BundleSection::Invalidated);\n}\n\n#[test]\nfn test_scope_leak_blocked_at_store_boundary_for_all_scopes() {\n    let harness = VerificationHarness::new();\n    let logs = Arc::new(Mutex::new(Vec::new()));\n    let subscriber = tracing_subscriber::fmt()\n        .with_writer(BufferWriter(logs.clone()))\n        .with_ansi(false)\n        .finish();\n    let _guard = tracing::subscriber::set_default(subscriber);","numLines":120,"startLine":1,"totalLines":923}}}
