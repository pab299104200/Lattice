rMatch,\n39\t    SemanticSimilarity,\n40\t    VerificationStatus,\n41\t    Freshness,\n42\t    Scope,\n43\t    EvidenceStrength,\n44\t    ContradictionOrSupersessionState,\n45\t    PastUsefulness,\n46\t    RecentSuccessfulReuse,\n47\t    UserPreferenceCompatibility,\n48\t    TokenCost,\n49\t}\n50\t\n51\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n52\tpub struct SignalScore {\n53\t    pub signal: SignalKind,\n54\t    pub raw: f32,\n55\t    pub weighted: f32,\n56\t    pub reason: String,\n57\t}\n58\t\n59\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n60\tpub struct RankedCandidate {\n61\t    pub candidate: Candidate,\n62\t    pub total_score: f32,\n63\t    pub signal_scores: Vec<SignalScore>,\n64\t    pub inclusion_reason: String,\n65\t}\n66\t\n67\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n68\tpub enum DiagnosticMode {\n69\t    Compact,\n70\t    Diagnostic,\n71\t}\n72\t\n73\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n74\tpub enum RetrievalProfile {\n75\t    Balanced,\n76\t}\n77\t\n78\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n79\tpub struct ScoringWeights {\n80\t    pub task_type_compatibility: f32,\n81\t    pub graph_proximity: f32,\n82\t    pub exact_identifier_match: f32,\n83\t    pub semantic_similarity: f32,\n84\t    pub verification_status: f32,\n85\t    pub freshness: f32,\n86\t    pub scope: f32,\n87\t    pub evidence_strength: f32,\n88\t    pub contradiction_or_supersession_state: f32,\n89\t    pub past_usefulness: f32,\n90\t    pub recent_successful_reuse: f32,\n91\t    pub user_preference_compatibility: f32,\n92\t    pub token_cost: f32,\n93\t    /// Hard demotion required by `## Stale Memory Leakage` so stale,\n94\t    /// contradicted, and superseded memories cannot outrank trusted peers.\n95\t    pub stale_memory_hard_penalty: f32,\n96\t}\n97\t\n98\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n99\tpub struct MemoryScoringMetadata {\n100\t    pub verification_status: MemoryVerificationStatus,\n101\t    pub scope: MemoryScope,\n102\t    pub confidence: f32,\n103\t    pub evidence_count: usize,\n104\t    pub created_at: Option<u64>,\n105\t    pub last_accessed: Option<u64>,\n106\t    pub access_count: u32,\n107\t    pub is_stale: bool,\n108\t    pub superseded_by_memory_id: Option<String>,\n109\t    pub contradicted_by_memory_ids: Vec<String>,\n110\t}\n111\t\n112\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n113\tpub struct EventScoringMetadata {\n114\t    pub past_usefulness_count: u32,\n115\t    pub recent_successful_reuse_count: u32,\n116\t    pub occurred_at: Option<u64>,\n117\t}\n118\t\n119\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n120\tpub struct UserPreferenceSignal {\n121\t    pub preference_key: String,\n122\t    pub preferred_terms: Vec<String>,\n123\t    pub conflicting_terms: Vec<String>,\n124\t}\n125\t\n126\t#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]\n127\tpub struct ScoringContext {\n128\t    pub now_unix_seconds: Option<u64>,\n129\t    pub semantic_similarity: BTreeMap<String, f32>,\n130\t    pub memory_metadata: BTreeMap<String, MemoryScoringMetadata>,"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"62cfb716-f92f-49f7-a930-22e1543a1dce","timestamp":"2026-05-17T13:11:14.198Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/retrieval_v1/scoring.rs","content":"//! Feature-based scoring for Retrieval V1 candidates.\n//!\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## 7. Retrieval Engine` defines the ranking signal contract:\n//!\n//! | Signal | Required input |\n//! | --- | --- |\n//! | task-type compatibility | `IntentClassification` and candidate source/kind |\n//! | graph proximity to anchors | resolved anchors, seed anchor, traversal path |\n//! | exact identifier match | resolved anchors and identity text |\n//! | semantic similarity | embedding or caller-provided similarity score |\n//! | verification status | memory verification metadata |\n//! | freshness | memory/event recency metadata |\n//! | scope | memory scope metadata |\n//! | evidence strength | memory confidence and evidence metadata |\n//! | contradiction/supersession state | structured memory contradiction/supersession metadata |\n//! | past usefulness | memory access or retrieval event history |\n//! | recent successful reuse | workflow success history |\n//! | user preference compatibility | observed preference metadata |\n//! | token cost | token estimate metadata |\n\nuse std::collections::BTreeMap;\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::memory::{MemoryScope, MemoryVerificationStatus};\n\nuse super::scoring_support::*;\nuse super::{Candidate, CandidateSource, IntentClassification, ResolvedAnchor};\n\nconst FRESHNESS_WINDOW_SECONDS: u64 = 60 * 60 * 24 * 30;\nconst HIGH_TOKEN_COST: u32 = 4_000;\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]\npub enum SignalKind {\n    TaskTypeCompatibility,\n    GraphProximity,\n    ExactIdentifierMatch,\n    SemanticSimilarity,\n    VerificationStatus,\n    Freshness,\n    Scope,\n    EvidenceStrength,\n    ContradictionOrSupersessionState,\n    PastUsefulness,\n    RecentSuccessfulReuse,\n    UserPreferenceCompatibility,\n    TokenCost,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct SignalScore {\n    pub signal: SignalKind,\n    pub raw: f32,\n    pub weighted: f32,\n    pub reason: String,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct RankedCandidate {\n    pub candidate: Candidate,\n    pub total_score: f32,\n    pub signal_scores: Vec<SignalScore>,\n    pub inclusion_reason: String,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\npub enum DiagnosticMode {\n    Compact,\n    Diagnostic,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\npub enum RetrievalProfile {\n    Balanced,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct ScoringWeights {\n    pub task_type_compatibility: f32,\n    pub graph_proximity: f32,\n    pub exact_identifier_match: f32,\n    pub semantic_similarity: f32,\n    pub verification_status: f32,\n    pub freshness: f32,\n    pub scope: f32,\n    pub evidence_strength: f32,\n    pub contradiction_or_supersession_state: f32,\n    pub past_usefulness: f32,\n    pub recent_successful_reuse: f32,\n    pub user_preference_compatibility: f32,\n    pub token_cost: f32,\n    /// Hard demotion required by `## Stale Memory Leakage` so stale,\n    /// contradicted, and superseded memories cannot outrank trusted peers.\n    pub stale_memory_hard_penalty: f32,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct MemoryScoringMetadata {\n    pub verification_status: MemoryVerificationStatus,\n    pub scope: MemoryScope,\n    pub confidence: f32,\n    pub evidence_count: usize,\n    pub created_at: Option<u64>,\n    pub last_accessed: Option<u64>,\n    pub access_count: u32,\n    pub is_stale: bool,\n    pub superseded_by_memory_id: Option<String>,\n    pub contradicted_by_memory_ids: Vec<String>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct EventScoringMetadata {\n    pub past_usefulness_count: u32,\n    pub recent_successful_reuse_count: u32,\n    pub occurred_at: Option<u64>,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct UserPreferenceSignal {\n    pub preference_key: String,\n    pub preferred_terms: Vec<String>,\n    pub conflicting_terms: Vec<String>,\n}\n\n#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]\npub struct ScoringContext {\n    pub now_unix_seconds: Option<u64>,\n    pub semantic_similarity: BTreeMap<String, f32>,\n    pub memory_metadata: BTreeMap<String, MemoryScoringMetadata>,","numLines":130,"startLine":1,"totalLines":530}}}
docs/plans/2026-05-16-cognitive-workspace-fork-build/logs/R55.log:109:{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HVDxBhpKAjSpXRvprKKp5X","type":"tool_result","content":"130\t    pub memory_metadata: BTreeMap<String, MemoryScoringMetadata>,\n131\t    pub event_history: BTreeMap<String, EventScoringMetadata>,\n132\t    pub user_preferences: Vec<UserPreferenceSignal>,\n133\t    pub token_estimates: BTreeMap<String, u32>,\n134\t    pub allow_untrusted_memory_in_diagnostics: bool,\n135\t}\n136\t\n137\timpl Default for ScoringWeights {\n138\t    fn default() -> Self {\n139\t        Self::for_profile(RetrievalProfile::Balanced)\n140\t    }\n141\t}\n142\t\n143\timpl ScoringWeights {\n144\t    pub fn for_profile(profile: RetrievalProfile) -> Self {\n145\t        match profile {\n146\t            RetrievalProfile::Balanced => Self {\n147\t                task_type_compatibility: 1.0,\n148\t                graph_proximity: 1.1,\n149\t                exact_identifier_match: 1.4,\n150\t                semantic_similarity: 1.0,\n151\t                verification_status: 1.0,\n152\t                freshness: 0.55,\n153\t                scope: 0.65,\n154\t                evidence_strength: 0.75,\n155\t                contradiction_or_supersession_state: 1.2,\n156\t                past_usefulness: 0.45,\n157\t                recent_successful_reuse: 0.6,\n158\t                user_preference_compatibility: 0.5,\n159\t                token_cost: 0.5,\n160\t                stale_memory_hard_penalty: -10.0,\n161\t            },\n162\t        }\n163\t    }\n164\t\n165\t    pub(super) fn weight_for(&self, signal: SignalKind) -> f32 {\n166\t        match signal {\n167\t            SignalKind::TaskTypeCompatibility => self.task_type_compatibility,\n168\t            SignalKind::GraphProximity => self.graph_proximity,\n169\t            SignalKind::ExactIdentifierMatch => self.exact_identifier_match,\n170\t            SignalKind::SemanticSimilarity => self.semantic_similarity,\n171\t            SignalKind::VerificationStatus => self.verification_status,\n172\t            SignalKind::Freshness => self.freshness,\n173\t            SignalKind::Scope => self.scope,\n174\t            SignalKind::EvidenceStrength => self.evidence_strength,\n175\t            SignalKind::ContradictionOrSupersessionState => {\n176\t                self.contradiction_or_supersession_state\n177\t            }\n178\t            SignalKind::PastUsefulness => self.past_usefulness,\n179\t            SignalKind::RecentSuccessfulReuse => self.recent_successful_reuse,\n180\t            SignalKind::UserPreferenceCompatibility => self.user_preference_compatibility,\n181\t            SignalKind::TokenCost => self.token_cost,\n182\t        }\n183\t    }\n184\t}\n185\t\n186\tpub fn score_candidates(\n187\t    candidates: Vec<Candidate>,\n188\t    intent: &IntentClassification,\n189\t    anchors: &[ResolvedAnchor],\n190\t    weights: &ScoringWeights,\n191\t    mode: DiagnosticMode,\n192\t    ctx: &ScoringContext,\n193\t) -> Vec<RankedCandidate> {\n194\t    let mut ranked = candidates\n195\t        .into_iter()\n196\t        .map(|candidate| score_candidate(candidate, intent, anchors, weights, mode, ctx))\n197\t        .collect::<Vec<_>>();\n198\t    ranked.sort_by(compare_ranked_candidates);\n199\t    ranked\n200\t}\n201\t\n202\tpub fn task_type_compatibility(\n203\t    candidate: &Candidate,\n204\t    intent: &IntentClassification,\n205\t    weights: &ScoringWeights,\n206\t) -> SignalScore {\n207\t    let raw = source_intent_score(candidate.source, intent.primary_label);\n208\t    let reason = if raw > 0.0 {\n209\t        format!(\n210\t            \"{:?} candidate is compatible with {:?} intent\",\n211\t            candidate.source, intent.primary_label\n212\t        )\n213\t    } else {\n214\t        \"no task-type compatibility signal available; signal skipped\".to_string()\n215\t    };\n216\t    signal(SignalKind::TaskTypeCompatibility, raw, weights, reason)\n217\t}\n218\t\n219\tpub fn graph_proximity(\n220\t    candidate: &Candidate,\n221\t    anchors: &[ResolvedAnchor],\n222\t    weights: &ScoringWeights,\n223\t) -> SignalScore {\n224\t    if candidate.seed_anchor.is_none() && candidate.traversal_path.is_empty() {\n225\t        return skipped(SignalKind::GraphProximity, weights, \"graph proximity\");\n226\t    }\n227\t    let resolved = resolved_anchor_identities(anchors);\n228\t    let raw = graph_proximity_raw(candidate, &resolved);\n229\t    let reason = format!(\n230\t        \"graph distance uses {} traversal step(s) from a resolved anchor\",\n231\t        candidate.traversal_path.len()\n232\t    );\n233\t    signal(SignalKind::GraphProximity, raw, weights, reason)\n234\t}\n235\t\n236\tpub fn exact_identifier_match(\n237\t    candidate: &Candidate,\n238\t    anchors: &[ResolvedAnchor],\n239\t    weights: &ScoringWeights,\n240\t) -> SignalScore {\n241\t    let identity_text = candidate.identity.to_string();\n242\t    for anchor in anchors {\n243\t        if anchor_matches_identity(anchor, &candidate.identity, &identity_text) {\n244\t            return signal(\n245\t                SignalKind::ExactIdentifierMatch,\n246\t                1.0,\n247\t                weights,\n248\t                format!(\"candidate identity matches anchor `{}`\", anchor.anchor_text),\n249\t            );\n250\t        }\n251\t    }\n252\t    skipped(\n253\t        SignalKind::ExactIdentifierMatch,\n254\t        weights,\n255\t        \"exact identifier match\",\n256\t    )\n257\t}\n258\t\n259\tpub fn semantic_similarity(\n260\t    candidate: &Candidate,\n261\t    weights: &ScoringWeights,\n262\t    ctx: &ScoringContext,\n263\t) -> SignalScore {\n264\t    let key = candidate.identity.to_string();\n265\t    let raw = ctx.semantic_similarity.get(&key).copied().or_else(|| {\n266\t        (candidate.source == CandidateSource::Embeddings).then_some(candidate.raw_score as f32)\n267\t    });\n268\t    match raw {\n269\t        Some(score) => signal(\n270\t            SignalKind::SemanticSimilarity,\n271\t            score.clamp(0.0, 1.0),\n272\t            weights,\n273\t            format!(\"semantic similarity {:.3} supplied for candidate\", score),\n274\t        ),\n275\t        None => skipped(\n276\t            SignalKind::SemanticSimilarity,\n277\t            weights,\n278\t            \"semantic similarity\",\n279\t        ),\n280\t    }\n281\t}\n282\t\n283\tpub fn verification_status(\n284\t    candidate: &Candidate,\n285\t    weights: &ScoringWeights,\n286\t    mode: DiagnosticMode,\n287\t    ctx: &ScoringContext,\n288\t) -> SignalScore {\n289\t    let Some(metadata) = memory_metadata(candidate, ctx) else {\n290\t        return skipped(\n291\t            SignalKind::VerificationStatus,\n292\t            weights,\n293\t            \"verification status\",\n294\t        );\n295\t    };\n296\t    let raw = verification_raw(metadata);\n297\t    let mut score = signal(\n298\t        SignalKind::VerificationStatus,\n299\t        raw,\n300\t        weights,\n301\t        format!(\n302\t            \"memory verification status is {:?}\",\n303\t            metadata.verification_status\n304\t        ),\n305\t    );\n306\t    apply_untrusted_penalty(&mut score, candidate, metadata, weights, mode, ctx);\n307\t    score\n308\t}\n309\t\n310\tpub fn freshness(\n311\t    candidate: &Candidate,\n312\t    weights: &ScoringWeights,\n313\t    ctx: &ScoringContext,\n314\t) -> SignalScore {\n315\t    let Some(now) = ctx.now_unix_seconds else {\n316\t        return skipped(SignalKind::Freshness, weights, \"freshness timestamp\");\n317\t    };\n318\t    let Some(timestamp) = freshness_timestamp(candidate, ctx) else {\n319\t        return skipped(SignalKind::Freshness, weights, \"freshness timestamp\");\n320\t    };\n321\t    let age = now.saturating_sub(timestamp);\n322\t    let raw = 1.0 - ((age.min(FRESHNESS_WINDOW_SECONDS) as f32) / FRESHNESS_WINDOW_SECONDS as f32);\n323\t    signal(\n324\t        SignalKind::Freshness,\n325\t        raw,\n326\t        weights,\n327\t        format!(\"candidate age is {} second(s)\", age),\n328\t    )\n329\t}"}]},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"63231127-9d27-46ee-855a-72009d336164","timestamp":"2026-05-17T13:11:18.069Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/retrieval_v1/scoring.rs","content":"    pub memory_metadata: BTreeMap<String, MemoryScoringMetadata>,\n    pub event_history: BTreeMap<String, EventScoringMetadata>,\n    pub user_preferences: Vec<UserPreferenceSignal>,\n    pub token_estimates: BTreeMap<String, u32>,\n    pub allow_untrusted_memory_in_diagnostics: bool,\n}\n\nimpl Default for ScoringWeights {\n    fn default() -> Self {\n        Self::for_profile(RetrievalProfile::Balanced)\n    }\n}\n\nimpl ScoringWeights {\n    pub fn for_profile(profile: RetrievalProfile) -> Self {\n        match profile {\n            RetrievalProfile::Balanced => Self {\n                task_type_compatibility: 1.0,\n                graph_proximity: 1.1,\n                exact_identifier_match: 1.4,\n                semantic_similarity: 1.0,\n                verification_status: 1.0,\n                freshness: 0.55,\n                scope: 0.65,\n                evidence_strength: 0.75,\n                contradiction_or_supersession_state: 1.2,\n                past_usefulness: 0.45,\n                recent_successful_reuse: 0.6,\n                user_preference_compatibility: 0.5,\n                token_cost: 0.5,\n                stale_memory_hard_penalty: -10.0,\n            },\n        }\n    }\n\n    pub(super) fn weight_for(&self, signal: SignalKind) -> f32 {\n        match signal {\n            SignalKind::TaskTypeCompatibility => self.task_type_compatibility,\n            SignalKind::GraphProximity => self.graph_proximity,\n            SignalKind::ExactIdentifierMatch => self.exact_identifier_match,\n            SignalKind::SemanticSimilarity => self.semantic_similarity,\n            SignalKind::VerificationStatus => self.verification_status,\n            SignalKind::Freshness => self.freshness,\n            SignalKind::Scope => self.scope,\n            SignalKind::EvidenceStrength => self.evidence_strength,\n            SignalKind::ContradictionOrSupersessionState => {\n                self.contradiction_or_supersession_state\n            }\n            SignalKind::PastUsefulness => self.past_usefulness,\n            SignalKind::RecentSuccessfulReuse => self.recent_successful_reuse,\n            SignalKind::UserPreferenceCompatibility => self.user_preference_compatibility,\n            SignalKind::TokenCost => self.token_cost,\n        }\n    }\n}\n\npub fn score_candidates(\n    candidates: Vec<Candidate>,\n    intent: &IntentClassification,\n    anchors: &[ResolvedAnchor],\n    weights: &ScoringWeights,\n    mode: DiagnosticMode,\n    ctx: &ScoringContext,\n) -> Vec<RankedCandidate> {\n    let mut ranked = candidates\n        .into_iter()\n        .map(|candidate| score_candidate(candidate, intent, anchors, weights, mode, ctx))\n        .collect::<Vec<_>>();\n    ranked.sort_by(compare_ranked_candidates);\n    ranked\n}\n\npub fn task_type_compatibility(\n    candidate: &Candidate,\n    intent: &IntentClassification,\n    weights: &ScoringWeights,\n) -> SignalScore {\n    let raw = source_intent_score(candidate.source, intent.primary_label);\n    let reason = if raw > 0.0 {\n        format!(\n            \"{:?} candidate is compatible with {:?} intent\",\n            candidate.source, intent.primary_label\n        )\n    } else {\n        \"no task-type compatibility signal available; signal skipped\".to_string()\n    };\n    signal(SignalKind::TaskTypeCompatibility, raw, weights, reason)\n}\n\npub fn graph_proximity(\n    candidate: &Candidate,\n    anchors: &[ResolvedAnchor],\n    weights: &ScoringWeights,\n) -> SignalScore {\n    if candidate.seed_anchor.is_none() && candidate.traversal_path.is_empty() {\n        return skipped(SignalKind::GraphProximity, weights, \"graph proximity\");\n    }\n    let resolved = resolved_anchor_identities(anchors);\n    let raw = graph_proximity_raw(candidate, &resolved);\n    let reason = format!(\n        \"graph distance uses {} traversal step(s) from a resolved anchor\",\n        candidate.traversal_path.len()\n    );\n    signal(SignalKind::GraphProximity, raw, weights, reason)\n}\n\npub fn exact_identifier_match(\n    candidate: &Candidate,\n    anchors: &[ResolvedAnchor],\n    weights: &ScoringWeights,\n) -> SignalScore {\n    let identity_text = candidate.identity.to_string();\n    for anchor in anchors {\n        if anchor_matches_identity(anchor, &candidate.identity, &identity_text) {\n            return signal(\n                SignalKind::ExactIdentifierMatch,\n                1.0,\n                weights,\n                format!(\"candidate identity matches anchor `{}`\", anchor.anchor_text),\n            );\n        }\n    }\n    skipped(\n        SignalKind::ExactIdentifierMatch,\n        weights,\n        \"exact identifier match\",\n    )\n}\n\npub fn semantic_similarity(\n    candidate: &Candidate,\n    weights: &ScoringWeights,\n    ctx: &ScoringContext,\n) -> SignalScore {\n    let key = candidate.identity.to_string();\n    let raw = ctx.semantic_similarity.get(&key).copied().or_else(|| {\n        (candidate.source == CandidateSource::Embeddings).then_some(candidate.raw_score as f32)\n    });\n    match raw {\n        Some(score) => signal(\n            SignalKind::SemanticSimilarity,\n            score.clamp(0.0, 1.0),\n            weights,\n            format!(\"semantic similarity {:.3} supplied for candidate\", score),\n        ),\n        None => skipped(\n            SignalKind::SemanticSimilarity,\n            weights,\n            \"semantic similarity\",\n        ),\n    }\n}\n\npub fn verification_status(\n    candidate: &Candidate,\n    weights: &ScoringWeights,\n    mode: DiagnosticMode,\n    ctx: &ScoringContext,\n) -> SignalScore {\n    let Some(metadata) = memory_metadata(candidate, ctx) else {\n        return skipped(\n            SignalKind::VerificationStatus,\n            weights,\n            \"verification status\",\n        );\n    };\n    let raw = verification_raw(metadata);\n    let mut score = signal(\n        SignalKind::VerificationStatus,\n        raw,\n        weights,\n        format!(\n            \"memory verification status is {:?}\",\n            metadata.verification_status\n        ),\n    );\n    apply_untrusted_penalty(&mut score, candidate, metadata, weights, mode, ctx);\n    score\n}\n\npub fn freshness(\n    candidate: &Candidate,\n    weights: &ScoringWeights,\n    ctx: &ScoringContext,\n) -> SignalScore {\n    let Some(now) = ctx.now_unix_seconds else {\n        return skipped(SignalKind::Freshness, weights, \"freshness timestamp\");\n    };\n    let Some(timestamp) = freshness_timestamp(candidate, ctx) else {\n        return skipped(SignalKind::Freshness, weights, \"freshness timestamp\");\n    };\n    let age = now.saturating_sub(timestamp);\n    let raw = 1.0 - ((age.min(FRESHNESS_WINDOW_SECONDS) as f32) / FRESHNESS_WINDOW_SECONDS as f32);\n    signal(\n        SignalKind::Freshness,\n        raw,\n        weights,\n        format!(\"candidate age is {} second(s)\", age),\n    )\n}","numLines":200,"startLine":130,"totalLines":530}}}
