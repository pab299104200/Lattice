anization_id = organization_for_scope(&scope);\n    Memory {\n        id: id.to_string(),\n        session_id: SESSION_ID.to_string(),\n        content: format!(\"contract memory {id}\"),\n        memory_type: MemoryType::Observation,\n        scope,\n        confidence: 0.9,\n        linked_symbols: Vec::new(),\n        linked_files: vec![\"src/contract.rs\".to_string()],\n        workspace_id,\n        branch,\n        scope_organization_id,\n        refresh_key: None,\n        source_query: None,\n        created_at: 100,\n        last_accessed: 100,\n        access_count: 0,\n        is_stale: false,\n        stale_reason: None,\n        verification_status: MemoryVerificationStatus::Unverified,\n    }\n}\n\nfn workspace_id_for_scope(scope: &MemoryScope) -> Option<String> {\n    match scope {\n        MemoryScope::Organization => None,\n        _ => Some(WORKSPACE.to_string()),\n    }\n}\n\nfn branch_for_scope(scope: &MemoryScope) -> Option<String> {\n    match scope {\n        MemoryScope::Organization => None,\n        _ => Some(BRANCH.to_string()),\n    }\n}\n\nfn organization_for_scope(scope: &MemoryScope) -> Option<String> {\n    match scope {\n        MemoryScope::Organization => Some(ORG_ID.to_string()),\n        _ => None,\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1350,"cache_read_input_tokens":272289,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1350},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"623701ab-dc49-4054-96ef-292da32369e2","uuid":"e3376753-8238-4176-b3af-323ff1b06888","request_id":"req_011Cb8D3xm4HPhYcJYRsqKku"}
