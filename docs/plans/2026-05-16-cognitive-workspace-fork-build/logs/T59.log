moryFreshnessPolicy::RepoScoped\n202\t        )\n203\t    }\n204\t}\n205\t\n206\t/// Evidence attached to a structured memory assertion.\n207\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n208\tpub struct EvidenceSpan {\n209\t    pub file_id: FileId,\n210\t    pub byte_start: u32,\n211\t    pub byte_end: u32,\n212\t    pub line_start: u32,\n213\t    pub line_end: u32,\n214\t}\n215\t\n216\t/// Evidence attached to a structured memory assertion.\n217\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n218\tpub struct MemoryEvidence {\n219\t    pub kind: String,\n220\t    pub reference: Option<String>,\n221\t    pub detail: Option<String>,\n222\t    pub captured_at: Option<u64>,\n223\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n224\t    pub span: Option<EvidenceSpan>,\n225\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n226\t    pub evidence_content_hash: Option<[u8; 32]>,\n227\t}\n228\t\n229\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n230\t#[serde(rename_all = \"snake_case\")]\n231\tpub enum MemoryScoreKind {\n232\t    UsefulnessPrior,\n233\t    RecentUsefulness,\n234\t    RetrievalAccuracy,\n235\t    RegressionRisk,\n236\t}\n237\t\n238\timpl MemoryScoreKind {\n239\t    pub fn as_str(self) -> &'static str {\n240\t        match self {\n241\t            Self::UsefulnessPrior => \"usefulness_prior\",\n242\t            Self::RecentUsefulness => \"recent_usefulness\",\n243\t            Self::RetrievalAccuracy => \"retrieval_accuracy\",\n244\t            Self::RegressionRisk => \"regression_risk\",\n245\t        }\n246\t    }\n247\t\n248\t    pub fn from_str(value: &str) -> Self {\n249\t        match value {\n250\t            \"usefulness_prior\" => Self::UsefulnessPrior,\n251\t            \"recent_usefulness\" => Self::RecentUsefulness,\n252\t            \"retrieval_accuracy\" => Self::RetrievalAccuracy,\n253\t            \"regression_risk\" => Self::RegressionRisk,\n254\t   