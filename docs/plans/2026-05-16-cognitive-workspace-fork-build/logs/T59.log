@@ -0,0 +1,582 @@
+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::sync::atomic::AtomicBool;
+use std::sync::Arc;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use lattice_core::events::{
+    EventPayload, EventQuery, EventReader, EventStore, EventWriter, FlushPolicy, QueryOrder,
+};
+use lattice_core::graph::CodeGraph;
+use lattice_core::indexer::Indexer;
+use lattice_core::memory::{
+    Memory, MemoryLinkRecord, MemoryScope, MemoryStore, MemoryStructuredFields,
+    MemoryVerificationStatus, MemoryType,
+};
+use lattice_core::memory::MemoryEvidence;
+use lattice_core::query::QueryEngine;
+use lattice_core::storage::graph_store::{FileIndexEntry, FILE_INDEX_PARSER_VERSION, FILE_INDEX_SCHEMA_VERSION};
+use lattice_core::storage::GraphStore;
+use lattice_core::verification::VerificationStatus;
+use serde_json::{json, Value};
+use tokio::sync::Mutex;
+
+use super::super::mcp::McpHandler;
