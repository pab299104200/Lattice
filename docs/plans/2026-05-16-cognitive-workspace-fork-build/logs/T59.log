+                Ok(MemoryLinkRecord {
+                    link_id: row.get(0)?,
+                    source_memory_id: row.get(1)?,
+                    target_memory_id: row.get(2)?,
+                    link_type: row.get(3)?,
+                    reason: row.get(4)?,
+                    created_at: row.get::<_, i64>(5)?.max(0) as u64,
