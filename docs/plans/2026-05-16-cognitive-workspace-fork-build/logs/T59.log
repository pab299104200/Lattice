+                        is_stale = ?2,
+                        stale_reason = ?3,
+                        last_verified_at = ?4,
+                        last_verified_graph_snapshot_id = ?5
+                 WHERE is_invalidated = 0 AND id = ?6",
+                params![
+                    verification_status.as_str(),
+                    if is_stale { 1 } else { 0 },
+                    stale_reason,
