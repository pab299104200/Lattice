    pub fn from_str(s: &str) -> Self {
        match s {
            "branch" => MemoryScope::Branch,
            "repo" => MemoryScope::Repo,
            "organization" => MemoryScope::Organization,
            _ => MemoryScope::Session,
        }
    }
}

