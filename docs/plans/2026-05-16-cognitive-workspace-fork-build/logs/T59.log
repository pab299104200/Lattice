+            .workspace_id
+            .as_deref()
+            .is_some_and(|value| value != workspace_id)
+        {
+            return Err((
+                -32011,
+                format!(
+                    "Event trace scope `{}` is outside the active workspace",
+                    parsed.workspace_id.unwrap_or_default()
+                ),
+            ));
