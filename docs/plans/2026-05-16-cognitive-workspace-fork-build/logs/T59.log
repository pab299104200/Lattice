+    };
+    round_trip(&verify_args);
+
+    let verify_response = verify_explain_memory::VerifyExplainResponse {
+        status: VerificationStatus::Verified,
+        checks: vec![verify_explain_memory::CheckResult {
+            kind: "linked_file_exists".to_string(),
