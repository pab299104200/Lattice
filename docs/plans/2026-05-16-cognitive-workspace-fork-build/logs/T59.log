+    async fn tool_get_event_trace_v2(&self, args: &Value) -> Result<Value, (i32, String)> {
+        let parsed = memory_v2::get_event_trace::parse_args(args)
+            .map_err(|message| (-32602, message))?;
+        memory_v2::get_event_trace::validate_args(&parsed)
+            .map_err(|message| (-32602, message))?;
