+#[test]
+fn serde_round_trips_verify_and_conflict_requests_and_responses() {
+    let verify_args = verify_explain_memory::VerifyExplainArgs {
+        memory_id: serde_json::from_value(json!({
+            "workspace_id": "workspace-main",
+            "ulid": "mem-1"
+        }))
+        .expect("memory id"),
