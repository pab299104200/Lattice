+use serde_json::Value;
+
+use super::{consolidate_session, get_event_trace, get_memory_metrics};
+
+#[test]
+fn admin_memory_tool_definitions_expose_names_and_schemas() {
+    for definition in [
+        consolidate_session::tool_definition(),
+        get_memory_metrics::tool_definition(),
+        get_event_trace::tool_definition(),
+    ] {
+        assert!(definition["name"].as_str().is_some_and(|value| !value.is_empty()));
+        assert!(definition["inputSchema"].is_object());
+    }
+}
+
+#[test]
+fn admin_memory_tool_argument_parsers_accept_minimal_requests() {
+    let consolidate = consolidate_session::parse_args(&serde_json::json!({
+        "session_id": "session-a"
+    }))
+    .expect("consolidate_session args");
+    assert_eq!(consolidate.session_id, "session-a");
+
+    let metrics = get_memory_metrics::parse_args(&serde_json::json!({}))
+        .expect("get_memory_metrics args");
+    assert!(metrics.signals.is_empty());
+
+    let trace = get_event_trace::parse_args(&serde_json::json!({
+        "session_id": "session-a"
+    }))
+    .expect("get_event_trace args");
+    assert_eq!(trace.session_id.as_deref(), Some("session-a"));
+}
