+        next_cursor: None,
+        render_mode: verify_explain_memory::VerifyExplainRenderMode::Full,
+        summary_lines: vec!["memory:source contradicts memory:target (conflict)".to_string()],
+    };
+    round_trip(&conflict_response);
+}
