+                    last_verified_graph_snapshot_id.map(|value| value as i64),
+                    id,
+                ],
+            )
+            .map_err(|error| {
+                LatticeError::Storage(format!("Failed to update verification state: {error}"))
+            })?;
+        if updated == 0 {
+            return Err(LatticeError::Storage(format!(
+                "Memory '{}' not found or invalidated",
+                id
+            )));
+        }
+        Ok(())
+    }
