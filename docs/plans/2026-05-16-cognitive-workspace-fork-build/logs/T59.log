+                        })?;
+                        match parsed.action {
+                            memory_v2::EvolutionAction::Apply => {
+                                proposal.apply(conn, &store, writer.as_ref(), decided_by, parsed.reason.as_deref())?;
+                            }
+                            memory_v2::EvolutionAction::Reject => {
+                                proposal.reject(conn, writer.as_ref(), decided_by, parsed.reason.as_deref())?;
+                            }
+                            memory_v2::EvolutionAction::Propose => {}
+                        }
