}

impl MemoryScope {
    pub fn as_str(&self) -> &str {
        match self {
            MemoryScope::Session => "session",
            MemoryScope::Branch => "branch",
            MemoryScope::Repo => "repo",
            MemoryScope::Organization => "organization",
        }
