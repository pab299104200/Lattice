+    let payload = parse_tool_payload(&response);
+    let conflicts = payload["conflicts"].as_array().expect("conflicts");
+    assert!(conflicts.iter().any(|conflict| {
+        conflict["link_type"].as_str() == Some("contradicts")
+            && conflict["source"].as_str().is_some_and(|value| value.contains(source_id.as_str()))
+            && conflict["target"].as_str().is_some_and(|value| value.contains(target_id.as_str()))
