+            &parsed,
+            &workspace_id,
+            current_git_branch(&self.workspace_root).as_deref(),
+            limit,
+        );
+        let cursor = parsed
+            .cursor
+            .as_deref()
+            .map(memory_v2::get_event_trace::decode_cursor)
