+                    action: parsed.action,
+                    source_memory_id: parsed.memory_id,
+                    proposal_kind: format!("{:?}", proposal.proposal_kind).to_lowercase(),
+                    decision: "pending".to_string(),
+                    prior_state: proposal.prior_state,
+                    proposed_state: proposal.proposed_state,
