+            .expect("insert supersedes");
+        (target, source)
+    };
+
+    let response = handler
+        .handle(
+            "tools/call",
+            json!({
+                "name": "list_memory_conflicts",
+                "arguments": {
+                    "anchor": {
+                        "workspace_id": workspace_root.to_string_lossy(),
+                        "ulid": target_id
+                    },
+                    "render_mode": "full"
+                }
+            }),
+        )
+        .await
+        .expect("list conflicts succeeds");
