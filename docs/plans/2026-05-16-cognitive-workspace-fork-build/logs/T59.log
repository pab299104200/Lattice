+#[tokio::test]
+async fn verify_and_explain_deprecation_shims_forward_correctly() {
+    let (handler, memory_store, _event_store, indexer, graph_store, workspace_root, context_cache_path) =
+        build_handler("shim-forward");
+    seed_indexed_file(&workspace_root, &indexer, &graph_store, "src/auth.rs", "fn refresh_token() {}\n").await;
+    let memory_id = {
+        let mut store = memory_store.lock().await;
+        let id = store
+            .store(seed_memory("shim target", MemoryScope::Repo))
+            .expect("store memory");
+        let mut fields = MemoryStructuredFields::default();
+        fields.evidence = vec![MemoryEvidence {
+            kind: "file".to_string(),
+            reference: Some("src/auth.rs".to_string()),
+            detail: None,
+            captured_at: Some(1),
+            span: None,
+            evidence_content_hash: None,
+        }];
+        store.update_structured_fields(&id, &fields).expect("fields");
+        id
+    };
+
+    let verify = handler
+        .handle(
+            "tools/call",
+            json!({
+                "name": "verify_memory",
+                "arguments": {
+                    "memory_id": {
+                        "workspace_id": workspace_root.to_string_lossy(),
+                        "ulid": memory_id
+                    }
+                }
+            }),
+        )
+        .await
+        .expect("verify shim succeeds");
+    let verify_payload = parse_tool_payload(&verify);
+    assert!(verify_payload["deprecation_warning"].as_str().is_some());
+
+    let explain = handler
+        .handle(
+            "tools/call",
+            json!({
+                "name": "explain_memory",
+                "arguments": {
