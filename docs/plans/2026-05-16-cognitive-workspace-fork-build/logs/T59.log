+    async fn tool_propose_memory_evolution_v2(&self, args: &Value) -> Result<Value, (i32, String)> {
+        let parsed =
+            memory_v2::propose_memory_evolution::parse_args(args).map_err(|message| (-32602, message))?;
+        memory_v2::propose_memory_evolution::validate_args(&parsed)
+            .map_err(|message| (-32602, message))?;
+        let workspace_id = self.workspace_root.to_string_lossy().to_string();
+        let store = self.memory_store.lock().await;
+        match parsed.action {
+            memory_v2::EvolutionAction::Propose => {
+                let proposal = memory_v2::propose_memory_evolution::build_proposal(
+                    &workspace_id,
+                    &store,
+                    &parsed,
+                )
+                .map_err(|error| (-32603, error))?;
+                store
+                    .with_connection(|conn| proposal.insert_pending(conn))
+                    .map_err(|error| (-32603, format!("Failed to persist proposal: {error}")))?;
+                let response = memory_v2::EvolutionProposal {
+                    proposal_id: proposal.proposal_id,
+                    action: parsed.action,
+                    source_memory_id: parsed.memory_id,
+                    proposal_kind: format!("{:?}", proposal.proposal_kind).to_lowercase(),
+                    decision: "pending".to_string(),
+                    prior_state: proposal.prior_state,
+                    proposed_state: proposal.proposed_state,
+                    deprecation_warning: None,
+                };
+                serde_json::to_value(&response)
+                    .map(wrap_tool_result)
+                    .map_err(|error| (-32603, format!("Serialization error: {error}")))
+            }
+            memory_v2::EvolutionAction::Apply | memory_v2::EvolutionAction::Reject => {
+                let proposal_id = parsed
+                    .proposal_id
+                    .as_deref()
+                    .ok_or((-32602, "Missing proposal_id".to_string()))?;
+                let record = store
+                    .with_connection(|conn| {
+                        lattice_core::consolidation::ConsolidationProposal::load_record(conn, proposal_id)
+                            .map_err(Into::into)
+                            .and_then(|value| {
+                                value.ok_or_else(|| {
+                                    lattice_core::LatticeError::Storage(format!(
+                                        "Proposal `{proposal_id}` was not found"
+                                    ))
+                                })
+                            })
+                    })
+                    .map_err(|error| (-32603, format!("Failed to load proposal: {error}")))?;
+                let mut response = memory_v2::EvolutionProposal {
+                    proposal_id: record.proposal_id.clone(),
+                    action: parsed.action,
+                    source_memory_id: record.target_memory_id.clone(),
+                    proposal_kind: record.proposal_kind.clone(),
+                    decision: if matches!(parsed.action, memory_v2::EvolutionAction::Apply) {
+                        "applied".to_string()
+                    } else {
+                        "rejected".to_string()
+                    },
+                    prior_state: record.prior_state.clone(),
+                    proposed_state: record.proposed_state.clone(),
+                    deprecation_warning: None,
+                };
+                if matches!(parsed.action, memory_v2::EvolutionAction::Apply) {
+                    if let Some(memory_id) = &record.target_memory_id {
+                        if let Some(content) = record.proposed_state["memory"]["content"].as_str() {
+                            store
+                                .with_connection(|conn| {
+                                    conn.execute(
+                                        "UPDATE memories SET content = ?1 WHERE id = ?2",
+                                        rusqlite::params![content, memory_id],
+                                    )
+                                    .map_err(|error| {
+                                        lattice_core::LatticeError::Storage(format!(
+                                            "Failed to apply proposal content: {error}"
+                                        ))
+                                    })?;
+                                    Ok(())
+                                })
+                                .map_err(|error| (-32603, format!("Failed to apply proposal: {error}")))?;
+                        }
+                    }
+                }
+                store
+                    .with_connection(|conn| {
+                        conn.execute(
+                            "UPDATE consolidation_proposals
+                                SET decision = ?1,
+                                    decided_at = strftime('%s','now'),
+                                    decided_by = ?2,
+                                    decision_reason = ?3
+                              WHERE proposal_id = ?4",
+                            rusqlite::params![
+                                response.decision,
+                                parsed.decided_by,
+                                parsed.reason,
+                                proposal_id
+                            ],
+                        )
+                        .map_err(|error| {
+                            lattice_core::LatticeError::Storage(format!(
+                                "Failed to persist proposal decision: {error}"
+                            ))
+                        })?;
+                        Ok(())
+                    })
+                    .map_err(|error| (-32603, format!("Failed to persist proposal decision: {error}")))?;
+                if matches!(parsed.action, memory_v2::EvolutionAction::Apply) {
+                    if let Some(capture) = &self.event_capture {
+                        if let Some(source_memory_id) = &response.source_memory_id {
+                            let memory_identity = MemoryId {
+                                workspace_id: workspace_id.clone(),
+                                ulid: source_memory_id.clone(),
+                            };
+                            if let Err(error) = capture.record_memory_consolidated(&[memory_identity.clone()], memory_identity, &[], "memory evolution applied") {
+                                tracing::warn!(tool = "propose_memory_evolution", %error, "failed to capture consolidation event");
+                            }
+                        }
+                    }
+                }
+                serde_json::to_value(&response)
+                    .map(wrap_tool_result)
+                    .map_err(|error| (-32603, format!("Serialization error: {error}")))
+            }
+        }
+    }
