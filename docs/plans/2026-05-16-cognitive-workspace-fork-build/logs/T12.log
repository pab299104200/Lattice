+        reason: String,
+    },
+    #[error("event payload is too large: {bytes_len} bytes exceeds {max_bytes} bytes")]
+    PayloadTooLarge {
+        bytes_len: usize,
+        max_bytes: usize,
+    },
+    #[error("event envelope row is invalid: {reason}")]
+    EnvelopeInvalid {
+        reason: String,
+    },
+}
