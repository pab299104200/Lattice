impl ReplayFixture {
    fn new() -> Self {
        let tempdir = TempDir::new().expect("tempdir creates");
        let db_path = tempdir.path().join("events.db");
        let store = Arc::new(EventStore::open(&db_path).expect("event store opens"));
        let reader = EventReader::new(store.clone());
        Self {
