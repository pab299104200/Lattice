+        "main".to_string(),
+        "fn main()".to_string(),
+        "fn main() { helper(); }".to_string(),
+        "src/main.rs".to_string(),
+        1,
+        3,
+        true,
+        Language::Rust,
+    );
+    graph.add_node(
+        helper.clone(),
+        SymbolKind::Function,
+        "helper".to_string(),
+        "fn helper()".to_string(),
+        "fn helper() {}".to_string(),
+        "src/lib.rs".to_string(),
+        1,
+        1,
+        false,
+        Language::Rust,
+    );
+    graph.add_edge(&main, &helper, EdgeKind::Calls);
+    graph
+}
