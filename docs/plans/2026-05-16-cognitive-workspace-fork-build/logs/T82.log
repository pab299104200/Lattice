+        SymbolKind::Function,
+        "helper".to_string(),
+        "fn helper()".to_string(),
+        "fn helper() {}".to_string(),
+        "src/lib.rs".to_string(),
+        1,
+        1,
+        false,
+        Language::Rust,
+    );
+    graph.add_edge(&main, &helper, EdgeKind::Calls);
+    graph
+}
