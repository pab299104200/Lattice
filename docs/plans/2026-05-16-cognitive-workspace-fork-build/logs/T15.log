+            Vec::new(),
+            format!("Tool called: {tool}"),
+            HOT_PATH_FLUSH,
+        )?;
+        self.active_calls
+            .lock()
+            .map_err(lock_error)?
+            .insert(event_id.ulid.clone(), call_id);
+        Ok(event_id)
