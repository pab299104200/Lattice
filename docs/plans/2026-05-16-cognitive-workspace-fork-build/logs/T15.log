+        "workspace_setup",
+        "index_status",
+        "get_session_metrics",
+        "get_project_rules",
+    ]
+}
+
+fn unique_test_path(name: &str) -> PathBuf {
+    let micros = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .expect("system clock after epoch")
+        .as_micros();
+    std::env::temp_dir().join(format!("lattice-event-capture-{name}-{micros}"))
+}
