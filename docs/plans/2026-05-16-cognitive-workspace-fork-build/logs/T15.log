+            EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {
+                workflow_name: workflow_name.to_string(),
+                terminal_event_id: evidence.last().cloned(),
+                output_context_handle_id: None,
+                memory_ids: Vec::new(),
+                result_summary: compact_text(summary, 240),
+            })
+        } else {
+            EventPayload::WorkflowFailed(WorkflowFailedPayload {
+                workflow_name: workflow_name.to_string(),
+                terminal_event_id: evidence.last().cloned(),
+                diagnostic_event_ids: Vec::new(),
+                retryable: false,
+                failure_summary: compact_text(summary, 240),
+            })
+        };
+        self.append(
+            Actor::Daemon,
+            payload,
+            evidence.iter().cloned().map(StableRef::EventRef).collect(),
+            workflow_summary(success, workflow_name),
+            TERMINAL_FLUSH,
+        )
+    }
