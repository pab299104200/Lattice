         workspace_manager: Option<Arc<Mutex<WorkspaceManager>>>,
         workspace_roots: Vec<PathBuf>,
         indexing: Arc<AtomicBool>,
+        event_writer: Option<Arc<EventWriter>>,
     ) -> Self {
+        let workspace_id = workspace_root.to_string_lossy().to_string();
