+    fn capture_tool_called(&self, tool_name: &str, arguments: &Value) -> Option<lattice_core::identity::EventId> {
+        let capture = self.event_capture.as_ref()?;
+        if let Err(error) = capture.ensure_task_started("MCP tool-call session") {
