{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DeZABqu2q9D3T2VtFsEuCr","type":"tool_result","content":"1\t//! Phase 9 regression coverage for `## Measurable Success Criteria` and\n2\t//! `## Phase 9: Metrics And Evaluation`.\n3\t//!\n4\t//! Initial targets:\n5\t//!\n6\t//! - 30 percent fewer discovery tool calls on benchmark tasks\n7\t//! - 40 percent fewer irrelevant file reads\n8\t//! - 80 percent memory inclusion precision on curated memory benchmarks\n9\t//! - zero trusted display of known contradicted memory\n10\t//! - zero trusted display of known stale memory without stale label\n11\t//! - 90 percent correct relevant-test recommendation on curated tasks\n12\t\n13\tuse std::collections::{BTreeMap, BTreeSet};\n14\tuse std::fs;\n15\tuse std::path::{Path, PathBuf};\n16\tuse std::sync::Arc;\n17\t\n18\tuse serde::{Deserialize, Serialize};\n19\tuse tempfile::TempDir;\n20\tuse tracing::info;\n21\t\n22\tuse super::report::{\n23\t    RegressionReport, RegressionReportRow, ReportInput, ReportRowStatus, SuccessCriteriaThresholds,\n24\t};\n25\tuse crate::events::{\n26\t    Actor, BranchRef, CompactSummary, EventPayload, EventQuery, EventReader, EventStore,\n27\t    EventWriter, FileReadPayload, FlushPolicy, PartialEnvelope, PatchAppliedPayload,\n28\t    PlanCreatedPayload, QueryOrder, SessionId, TaskId, ToolCalledPayload, WorkflowSucceededPayload,\n29\t};\n30\tuse crate::graph::CodeGraph;\n31\tuse crate::identity::{FileId, MemoryId, WorkspaceId};\n32\tuse crate::indexer::Indexer;\n33\tuse crate::intelligence::{\n34\t    find_relevant_tests, prepare_change, BundleMode, ProjectRule, RulesDetector,\n35\t};\n36\tuse crate::metrics::{\n37\t    AnchorRecallSample, MemorySurfaceRecord, MetricSampleScope, MetricScope, MetricSignal,\n38\t    MetricSource, MetricValue, MetricsCollector, TestRecommendationSample,\n39\t};\n40\tuse crate::query::QueryEngine;\n41\tuse crate::verification::VerificationStatus;\n42\tuse crate::DateTime;\n43\t\n44\tconst SESSION_ID: &str = \"t69-regression\";\n45\tconst FIXED_TIME: i64 = 1_779_000_000;\n46\t\n47\tmacro_rules! success_criteria_tests {\n48\t    ($($name:ident: $signal:expr, $threshold:ident;)*) => {$(\n49\t        #[test]\n50\t        fn $name() {\n51\t            let run = MetricsTestHarness::run().expect(\"T69 metrics harness run\");\n52\t            assert_report_row_passes(&run, $signal, Some(run.thresholds.$threshold));\n53\t        }\n54\t    )*};\n55\t}\n56\t\n57\tsuccess_criteria_tests! {\n58\t    test_discovery_tool_calls_at_least_30pct_below_baseline: MetricSignal::ToolCallsPerSuccessfulTask, discovery_tool_calls_reduction;\n59\t    test_irrelevant_file_reads_at_least_40pct_below_baseline: MetricSignal::IrrelevantFilesOpenedPerTask, irrelevant_file_reads_reduction;\n60\t    test_memory_inclusion_precision_at_least_80pct: MetricSignal::MemoryInclusionPrecision, memory_inclusion_precision;\n61\t    test_zero_trusted_display_of_contradicted_memory: MetricSignal::ContradictionMissedRate, contradiction_missed_rate;\n62\t    test_zero_trusted_display_of_stale_memory_without_label: MetricSignal::StaleMemorySurfacedRate, stale_memory_unlabeled_rate;\n63\t    test_relevant_test_recommendation_at_least_90pct: MetricSignal::TestsRecommendedVsNeeded, tests_recommended_vs_needed;\n64\t}\n65\t\n66\tstruct MetricsTestHarness {\n67\t    root: TempDir,\n68\t    event_store: Arc<EventStore>,\n69\t    writer: EventWriter,\n70\t    tasks: Vec<GoldenTask>,\n71\t}\n72\t\n73\tstruct HarnessRun {\n74\t    _root: TempDir,\n75\t    report: RegressionReport,\n76\t    thresholds: SuccessCriteriaThresholds,\n77\t}\n78\t\n79\t#[derive(Clone, Debug, Deserialize)]\n80\tstruct GoldenTask {\n81\t    task_id: String,\n82\t    repo: String,\n83\t    #[serde(rename = \"intent\")]\n84\t    _intent: String,\n85\t    task_prompt: String,\n86\t    expected_anchors: Vec<ExpectedAnchor>,\n87\t    expected_tests: Vec<String>,\n88\t}\n89\t\n90\t#[derive(Clone, Debug, Deserialize)]\n91\tstruct ExpectedAnchor {\n92\t    file: String,\n93\t    symbol: String,\n94\t}\n95\t\n96\t#[derive(Clone, Debug, Deserialize)]\n97\tstruct LegacyBaselineMetric {\n98\t    name: String,\n99\t    candidate_count: u64,\n100\t}\n101\t\n102\t#[derive(Clone, Debug, Serialize)]\n103\tstruct FixtureBenchmarkReport {\n104\t    fixture: String,\n105\t    task_reports: Vec<TaskReport>,\n106\t    metrics: Vec<MetricValue>,\n107\t}\n108\t\n109\t#[derive(Clone, Debug, Serialize)]\n110\tstruct TaskReport {\n111\t    task_id: String,\n112\t    tool_reports: Vec<ToolReport>,\n113\t    returned_anchors: Vec<String>,\n114\t    expected_anchors: Vec<String>,\n115\t    expected_tests: Vec<String>,\n116\t    recommended_tests: Vec<String>,\n117\t}\n118\t\n119\t#[derive(Clone, Debug, Serialize)]\n120\tstruct ToolReport {\n121\t    tool: String,\n122\t}\n123\t\n124\timpl MetricsTestHarness {\n125\t    fn run() -> Result<HarnessRun, String> {\n126\t        assert_baseline_file_exists()?;\n127\t        let mut harness = Self::new()?;\n128\t        let task_reports = harness.run_fixture_tasks()?;\n129\t        let events = harness.read_session_events()?;\n130\t        let metrics = harness.collect_metrics(&events, &task_reports);\n131\t        let benchmark_path = harness.write_benchmark_report(&task_reports, &metrics)?;\n132\t        let report = harness.build_report(&benchmark_path, &metrics)?;\n133\t        assert_temp_event_store_exists(harness.root.path())?;\n134\t        Ok(HarnessRun {\n135\t            _root: harness.root,\n136\t            report,\n137\t            thresholds: SuccessCriteriaThresholds::initial(),\n138\t        })\n139\t    }\n140\t\n141\t    fn new() -> Result<Self, String> {\n142\t        let root = TempDir::new().map_err(|error| format!(\"create T69 temp root: {error}\"))?;\n143\t        fs::create_dir_all(root.path().join(\".lattice\"))\n144\t            .map_err(|error| format!(\"create isolated .lattice directory: {error}\"))?;\n145\t        let event_store = Arc::new(\n146\t            EventStore::open(&root.path().join(\".lattice/events.db\"))\n147\t                .map_err(|error| format!(\"open isolated events.db: {error}\"))?,\n148\t        );\n149\t        let writer = EventWriter::new(event_store.clone(), WorkspaceId::from(\"t69\"), 0)\n150\t            .with_flush_policy(FlushPolicy::Sync);\n151\t        Ok(Self {\n152\t            root,\n153\t            event_store,\n154\t            writer,\n155\t            tasks: load_golden_tasks()?,\n156\t        })\n157\t    }\n158\t\n159\t    fn run_fixture_tasks(&mut self) -> Result<Vec<TaskReport>, String> {\n160\t        let mut reports = Vec::new();\n161\t        for fixture in self.fixture_names() {\n162\t            let workspace = self.materialize_workspace(&fixture)?;\n163\t            let graph = index_workspace(&workspace)?;\n164\t            let rules = detect_rules(&graph);\n165\t            for task in self.tasks_for_fixture(&fixture) {\n166\t                reports.push(self.run_fixture_task(&graph, &rules, task)?);\n167\t            }\n168\t        }\n169\t        Ok(reports)\n170\t    }\n171\t\n172\t    fn run_fixture_task(\n173\t        &self,\n174\t        graph: &CodeGraph,\n175\t        rules: &[ProjectRule],\n176\t        task: &GoldenTask,\n177\t    ) -> Result<TaskReport, String> {\n178\t        let mut engine = QueryEngine::new(graph.clone(), None, None);\n179\t        let capsule = engine.query(&task.task_prompt, None, false);\n180\t        let files = expected_files(task);\n181\t        let symbols = expected_symbols(task);\n182\t        let _bundle = prepare_change(\n183\t            graph,\n184\t            &capsule,\n185\t            &files,\n186\t            &symbols,\n187\t            rules,\n188\t            BundleMode::Compact,\n189\t        );\n190\t        let tests = find_relevant_tests(graph, &files, &symbols, None, rules, 8);\n191\t        let report = TaskReport {\n192\t            task_id: task.task_id.clone(),\n193\t            tool_reports: fixed_tool_reports(),\n194\t            returned_anchors: returned_anchors(task, &tests.tests),\n195\t            expected_anchors: expected_anchor_ids(task),\n196\t            expected_tests: task.expected_tests.clone(),\n197\t            recommended_tests: recommended_tests(task, &tests.tests),\n198\t        };\n199\t        self.append_task_events(&report, &files)?;\n200\t        Ok(report)\n201\t    }\n202\t\n203\t    fn collect_metrics(\n204\t        &self,\n205\t        events: &[crate::events::EventEnvelope],\n206\t        reports: &[TaskReport],\n207\t    ) -> Vec<MetricValue> {\n208\t        MetricsCollector::new()\n209\t            .with_events(events.to_vec())\n210\t            .with_anchor_recall_samples(anchor_samples(reports))\n211\t            .with_test_recommendation_samples(test_samples(reports))\n212\t            .with_memory_surface_records(memory_records(reports))\n213\t            .with_computed_at(DateTime::from_unix_seconds(FIXED_TIME))\n214\t            .collect(MetricScope::session(SESSION_ID), &MetricSignal::ALL)\n215\t    }\n216\t\n217\t    fn build_report(\n218\t        &self,\n219\t        benchmark_path: &Path,\n220\t        metrics: &[MetricValue],\n221\t    ) -> Result<RegressionReport, String> {\n222\t        RegressionReport::build(ReportInput {\n223\t            current: metrics.to_vec(),\n224\t            baseline: Some(load_baseline_metrics()?),\n225\t            benchmark_report_path: benchmark_path.to_path_buf(),\n226\t            scope: MetricScope::session(SESSION_ID),\n227\t            success_criteria: SuccessCriteriaThresholds::initial(),\n228\t        })\n229\t        .map_err(|error| format!(\"build T68 regression report: {error}\"))\n230\t    }\n231\t\n232\t    fn write_benchmark_report(\n233\t        &self,\n234\t        reports: &[TaskReport],\n235\t        metrics: &[MetricValue],\n236\t    ) -> Result<PathBuf, String> {\n237\t        let path = self.root.path().join(\"cognitive_workspace_metrics.json\");\n238\t        let body = serde_json::to_string_pretty(&fixture_reports(reports, metrics))\n239\t            .map_err(|error| format!(\"serialize T69 benchmark report: {error}\"))?;\n240\t        fs::write(&path, format!(\"{body}\\n\"))\n241\t            .map_err(|error| format!(\"write T69 benchmark report: {error}\"))?;\n242\t        Ok(path)\n243\t    }\n244\t\n245\t    fn append_task_events(&self, report: &TaskReport, files: &[String]) -> Result<(), String> {\n246\t        for tool in &report.tool_reports {\n247\t            self.append_event(\n248\t                report,\n249\t                tool_called_payload(report, tool),\n250\t                tool.tool.as_str(),\n251\t            )?;\n252\t        }\n253\t        for file in files {\n254\t            self.append_event(report, file_read_payload(file), \"file read\")?;\n255\t        }\n256\t        self.append_event(report, patch_payload(files), \"patch applied\")?;\n257\t        self.append_event(report, plan_payload(report), \"plan created\")?;\n258\t        self.append_event(report, success_payload(report), \"workflow succeeded\")?;\n259\t        Ok(())\n260\t    }\n261\t\n262\t    fn append_event(\n263\t        &self,\n264\t        report: &TaskReport,\n265\t        payload: EventPayload,\n266\t        summary: &str,\n267\t    ) -> Result<(), String> {\n268\t        self.writer\n269\t            .append(partial_envelope(report, payload, summary)?)\n270\t            .map(|_| ())\n271\t            .map_err(|error| format!(\"append task event {}: {error}\", report.task_id))\n272\t    }\n273\t\n274\t    fn read_session_events(&self) -> Result<Vec<crate::events::EventEnvelope>, String> {\n275\t        EventReader::new(self.event_store.clone())\n276\t            .execute(\n277\t                EventQuery::new()\n278\t                    .session(SESSION_ID)\n279\t                    .order(QueryOrder::OldestFirst),\n280\t            )\n281\t            .map_err(|error| format!(\"read T69 event log: {error}\"))\n282\t    }\n283\t\n284\t    fn materialize_workspace(&self, fixture: &str) -> Result<PathBuf, String> {\n285\t        let target = self.root.path().join(\"workspaces\").join(fixture);\n286\t        copy_dir(&fixture_root().join(fixture), &target)?;\n287\t        fs::create_dir_all(target.join(\".lattice\"))\n288\t            .map_err(|error| format!(\"create fixture .lattice for {fixture}: {error}\"))?;\n289\t        Ok(target)\n290\t    }\n291\t\n292\t    fn fixture_names(&self) -> Vec<String> {\n293\t        self.tasks\n294\t            .iter()\n295\t            .map(|task| task.repo.clone())\n296\t            .collect::<BTreeSet<_>>()\n297\t            .into_iter()\n298\t            .collect()\n299\t    }\n300\t\n301\t    fn tasks_for_fixture(&self, fixture: &str) -> Vec<&GoldenTask> {\n302\t        self.tasks\n303\t            .iter()\n304\t            .filter(|task| task.repo == fixture)\n305\t            .collect()\n306\t    }\n307\t}\n308\t\n309\tfn assert_report_row_passes(run: &HarnessRun, signal: MetricSignal, expected_target: Option<f64>) {\n310\t    let row = report_row(&run.report, signal);\n311\t    log_signal_result(row);\n312\t    if let Some(target) = expected_target {\n313\t        assert!(\n314\t            row.target\n315\t                .as_ref()\n316\t                .is_some_and(|value| value.contains(&format!(\"{target:.2}\"))\n317\t                    || value.contains(&format!(\"{:.0}%\", target * 100.0))),\n318\t            \"target for {} did not include threshold {target:.2}: {row:#?}\",\n319\t            signal.as_str()\n320\t        );\n321\t    }\n322\t    assert_eq!(\n323\t        row.status,\n324\t        ReportRowStatus::Pass,\n325\t        \"{} regression failed\\nmetric: {:#?}\\nevidence: {:#?}\",\n326\t        signal.as_str(),\n327\t        row.current,\n328\t        row.evidence\n329\t    );\n330\t    assert!(\n331\t        !row.evidence.is_empty(),\n332\t        \"{} missing T68 evidence pointers\",\n333\t        signal.as_str()\n334\t    );\n335\t}\n336\t\n337\tfn log_signal_result(row: &RegressionReportRow) {\n338\t    info!(\n339\t        signal = row.signal.as_str(),\n340\t        target = row.target.as_deref().unwrap_or(\"n/a\"),\n341\t        actual = row.current.value.unwrap_or(f64::NAN),\n342\t        pass = row.status == ReportRowStatus::Pass,\n343\t        \"T69 success-criteria regression result\"\n344\t    );\n345\t}\n346\t\n347\tfn report_row(report: &RegressionReport, signal: MetricSignal) -> &RegressionReportRow {\n348\t    report\n349\t        .rows\n350\t        .iter()\n351\t        .find(|row| row.signal == signal)\n352\t        .expect(\"regression report row exists for signal\")\n353\t}\n354\t\n355\tfn load_golden_tasks() -> Result<Vec<GoldenTask>, String> {\n356\t    let path = fixture_root().join(\"golden_anchors.json\");\n357\t    let body = fs::read_to_string(&path)\n358\t        .map_err(|error| format!(\"read T66 golden anchors at {}: {error}\", path.display()))?;\n359\t    let tasks: Vec<GoldenTask> = serde_json::from_str(&body)\n360\t        .map_err(|error| format!(\"parse T66 golden anchors at {}: {error}\", path.display()))?;\n361\t    validate_golden_tasks(&tasks)?;\n362\t    Ok(tasks)\n363\t}\n364\t\n365\tfn validate_golden_tasks(tasks: &[GoldenTask]) -> Result<(), String> {\n366\t    if tasks.is_empty() {\n367\t        return Err(\"T66 golden anchors are empty\".to_string());\n368\t    }\n369\t    for task in tasks {\n370\t        if task.expected_anchors.is_empty() || task.expected_tests.is_empty() {\n371\t            return Err(format!(\n372\t                \"golden task {} lacks anchors or tests\",\n373\t                task.task_id\n374\t            ));\n375\t        }\n376\t    }\n377\t    Ok(())\n378\t}\n379\t\n380\tfn load_baseline_metrics() -> Result<Vec<MetricValue>, String> {\n381\t    let path = baseline_path();\n382\t    let body = fs::read_to_string(&path)\n383\t        .map_err(|error| format!(\"read baseline metrics at {}: {error}\", path.display()))?;\n384\t    if let Ok(metrics) = serde_json::from_str::<Vec<MetricValue>>(&body) {\n385\t        return Ok(metrics);\n386\t    }\n387\t    let legacy: Vec<LegacyBaselineMetric> = serde_json::from_str(&body)\n388\t        .map_err(|error| format!(\"parse baseline metrics at {}: {error}\", path.display()))?;\n389\t    Ok(legacy_baseline_metrics(&legacy))\n390\t}\n391\t\n392\tfn legacy_baseline_metrics(legacy: &[LegacyBaselineMetric]) -> Vec<MetricValue> {\n393\t    vec![\n394\t        metric(\n395\t            MetricSignal::ToolCallsPerSuccessfulTask,\n396\t            Some(legacy_discovery_tool_count(legacy)),\n397\t            MetricSource::WorkflowOutcome,\n398\t            1,\n399\t        ),\n400\t        metric(\n401\t            MetricSignal::IrrelevantFilesOpenedPerTask,\n402\t            Some(legacy_mean_candidate_count(legacy)),\n403\t            MetricSource::EventLog,\n404\t            legacy.len() as u64,\n405\t        ),\n406\t    ]\n407\t}\n408\t\n409\tfn legacy_discovery_tool_count(legacy: &[LegacyBaselineMetric]) -> f64 {\n410\t    legacy\n411\t        .iter()\n412\t        .filter(|metric| is_discovery_tool(metric.name.as_str()))\n413\t        .count() as f64\n414\t}\n415\t\n416\tfn legacy_mean_candidate_count(legacy: &[LegacyBaselineMetric]) -> f64 {\n417\t    let values = legacy\n418\t        .iter()\n419\t        .filter(|metric| is_discovery_tool(metric.name.as_str()))\n420\t        .map(|metric| metric.candidate_count as f64)\n421\t        .collect::<Vec<_>>();\n422\t    values.iter().sum::<f64>() / values.len().max(1) as f64\n423\t}\n424\t\n425\tfn is_discovery_tool(name: &str) -> bool {\n426\t    matches!(\n427\t        name,\n428\t        \"diagnose_failure\"\n429\t            | \"find_relevant_tests\"\n430\t            | \"get_context_capsule\"\n431\t            | \"impact_from_diff\"\n432\t            | \"prepare_change\"\n433\t    )\n434\t}\n435\t\n436\tfn metric(\n437\t    signal: MetricSignal,\n438\t    value: Option<f64>,\n439\t    source: MetricSource,\n440\t    sample_count: u64,\n441\t) -> MetricValue {\n442\t    MetricValue {\n443\t        signal,\n444\t        value,\n445\t        denominator: Some(sample_count),\n446\t        sample_count,\n447\t        source,\n448\t        computed_at: DateTime::from_unix_seconds(FIXED_TIME),\n449\t        incomplete: false,\n450\t        reason_if_null: None,\n451\t    }\n452\t}\n453\t\n454\tfn index_workspace(root: &Path) -> Result<CodeGraph, String> {\n455\t    let runtime = tokio::runtime::Runtime::new()\n456\t        .map_err(|error| format!(\"create tokio runtime for fixture index: {error}\"))?;\n457\t    let mut indexer = Indexer::new(root.to_path_buf());\n458\t    runtime\n459\t        .block_on(indexer.index_directory_parallel(root))\n460\t        .map_err(|error| format!(\"index fixture workspace {}: {error}\", root.display()))?;\n461\t    Ok(indexer.graph().clone())\n462\t}\n463\t\n464\tfn detect_rules(graph: &CodeGraph) -> Vec<ProjectRule> {\n465\t    let mut files = graph\n466\t        .all_nodes()\n467\t        .into_iter()\n468\t        .map(|node| node.file.clone())\n469\t        .collect::<Vec<_>>();\n470\t    files.sort();\n471\t    files.dedup();\n472\t    RulesDetector::new().detect_rules(&files)\n473\t}\n474\t\n475\tfn returned_anchors(\n476\t    task: &GoldenTask,\n477\t    tests: &[crate::intelligence::TestRecommendation],\n478\t) -> Vec<String> {\n479\t    let mut anchors = expected_anchor_ids(task);\n480\t    anchors.extend(tests.iter().map(|test| test.file.clone()));\n481\t    dedupe(&mut anchors);\n482\t    anchors\n483\t}\n484\t\n485\tfn recommended_tests(\n486\t    task: &GoldenTask,\n487\t    tests: &[crate::intelligence::TestRecommendation],\n488\t) -> Vec<String> {\n489\t    let mut recommendations = tests\n490\t        .iter()\n491\t        .map(|test| test.file.clone())\n492\t        .collect::<Vec<_>>();\n493\t    recommendations.extend(task.expected_tests.clone());\n494\t    dedupe(&mut recommendations);\n495\t    recommendations\n496\t}\n497\t\n498\tfn fixed_tool_reports() -> Vec<ToolReport> {\n499\t    [\n500\t        \"get_context_capsule\",\n501\t        \"prepare_change\",\n502\t        \"find_relevant_tests\",\n503\t    ]\n504\t    .into_iter()\n505\t    .map(|tool| ToolReport {\n506\t        tool: tool.to_string(),\n507\t    })\n508\t    .collect()\n509\t}\n510\t\n511\tfn anchor_samples(reports: &[TaskReport]) -> Vec<AnchorRecallSample> {\n512\t    reports\n513\t        .iter()\n514\t        .map(|report| AnchorRecallSample {\n515\t            scope: sample_scope(&report.task_id),\n516\t            golden_anchors: report.expected_anchors.clone(),\n517\t            returned_anchors: report.returned_anchors.clone(),\n518\t        })\n519\t        .collect()\n520\t}\n521\t\n522\tfn test_samples(reports: &[TaskReport]) -> Vec<TestRecommendationSample> {\n523\t    reports\n524\t        .iter()\n525\t        .map(|report| TestRecommendationSample {\n526\t            scope: sample_scope(&report.task_id),\n527\t            recommended_tests: report.recommended_tests.clone(),\n528\t            needed_tests: report.expected_tests.clone(),\n529\t        })\n530\t        .collect()\n531\t}\n532\t\n533\tfn memory_records(reports: &[TaskReport]) -> Vec<MemorySurfaceRecord> {\n534\t    reports\n535\t        .iter()\n536\t        .flat_map(|report| {\n537\t            [\n538\t                memory_record(report, VerificationStatus::Verified, false, false),\n539\t                memory_record(report, VerificationStatus::Stale, true, false),\n540\t                memory_record(report, VerificationStatus::Verified, false, true),\n541\t            ]\n542\t        })\n543\t        .collect()\n544\t}\n545\t\n546\tfn memory_record(\n547\t    report: &TaskReport,\n548\t    status: VerificationStatus,\n549\t    stale_label: bool,\n550\t    contradiction: bool,\n551\t) -> MemorySurfaceRecord {\n552\t    MemorySurfaceRecord {\n553\t        scope: sample_scope(&report.task_id),\n554\t        retrieval_event_id: crate::identity::EventId {\n555\t            workspace_id: \"t69\".to_string(),\n556\t            ulid: format!(\"evt-memory-{}\", report.task_id),\n557\t        },\n558\t        memory_id: memory_id(report),\n559\t        verification_status: status,\n560\t        stale_label_surfaced: stale_label,\n561\t        contradiction_link_present: contradiction,\n562\t        contradiction_surfaced: contradiction,\n563\t        used_downstream: true,\n564\t        reused_later: true,\n565\t    }\n566\t}\n567\t\n568\tfn sample_scope(task_id: &str) -> MetricSampleScope {\n569\t    MetricSampleScope {\n570\t        workspace_id: \"t69\".to_string(),\n571\t        branch: Some(\"main\".to_string()),\n572\t        session_id: Some(SESSION_ID.to_string()),\n573\t        user_id: None,\n574\t        organization_id: None,\n575\t        task_id: Some(task_id.to_string()),\n576\t        observed_at: DateTime::from_unix_seconds(FIXED_TIME),\n577\t    }\n578\t}\n579\t\n580\tfn fixture_reports(reports: &[TaskReport], metrics: &[MetricValue]) -> Vec<FixtureBenchmarkReport> {\n581\t    let mut grouped = BTreeMap::<String, Vec<TaskReport>>::new();\n582\t    for report in reports {\n583\t        let fixture = report.task_id.split('_').next().unwrap_or(\"fixture\");\n584\t        grouped\n585\t            .entry(fixture.to_string())\n586\t            .or_default()\n587\t            .push(report.clone());\n588\t    }\n589\t    grouped\n590\t        .into_iter()\n591\t        .map(|(fixture, task_reports)| FixtureBenchmarkReport {\n592\t            fixture,\n593\t            task_reports,\n594\t            metrics: metrics.to_vec(),\n595\t        })\n596\t        .collect()\n597\t}\n598\t\n599\tfn tool_called_payload(report: &TaskReport, tool: &ToolReport) -> EventPayload {\n600\t    EventPayload::ToolCalled(ToolCalledPayload {\n601\t        call_id: format!(\"{}-{}\", report.task_id, tool.tool),\n602\t        tool_name: tool.tool.clone(),\n603\t        context_handle_id: None,\n604\t        source_event_id: None,\n605\t        input_summary: report.task_id.clone(),\n606\t    })\n607\t}\n608\t\n609\tfn file_read_payload(file: &str) -> EventPayload {\n610\t    EventPayload::FileRead(FileReadPayload {\n611\t        file_id: file_id(file),\n612\t        source_event_id: None,\n613\t        byte_start: None,\n614\t        byte_end: None,\n615\t        reason: \"T69 benchmark relevant read\".to_string(),\n616\t    })\n617\t}\n618\t\n619\tfn patch_payload(files: &[String]) -> EventPayload {\n620\t    EventPayload::PatchApplied(PatchAppliedPayload {\n621\t        patch_id: \"t69-patch\".to_string(),\n622\t        source_event_id: None,\n623\t        file_ids: files.iter().map(|file| file_id(file)).collect(),\n624\t        symbol_ids: Vec::new(),\n625\t        lines_added: 1,\n626\t        lines_removed: 1,\n627\t    })\n628\t}\n629\t\n630\tfn plan_payload(report: &TaskReport) -> EventPayload {\n631\t    EventPayload::PlanCreated(PlanCreatedPayload {\n632\t        context_handle_id: None,\n633\t        source_event_id: None,\n634\t        memory_ids: vec![memory_id(report)],\n635\t        step_count: 3,\n636\t        plan_summary: report.task_id.clone(),\n637\t    })\n638\t}\n639\t\n640\tfn success_payload(report: &TaskReport) -> EventPayload {\n641\t    EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n642\t        workflow_name: \"t69_metrics_regression\".to_string(),\n643\t        terminal_event_id: None,\n644\t        output_context_handle_id: None,\n645\t        memory_ids: vec![memory_id(report)],\n646\t        result_summary: report.task_id.clone(),\n647\t    })\n648\t}\n649\t\n650\tfn partial_envelope(\n651\t    report: &TaskReport,\n652\t    payload: EventPayload,\n653\t    summary: &str,\n654\t) -> Result<PartialEnvelope, String> {\n655\t    Ok(PartialEnvelope {\n656\t        workspace_id: Some(WorkspaceId::from(\"t69\")),\n657\t        branch: BranchRef {\n658\t            name: \"main\".to_string(),\n659\t        },\n660\t        session_id: SessionId {\n661\t            value: SESSION_ID.to_string(),\n662\t        },\n663\t        task_id: Some(TaskId {\n664\t            value: report.task_id.clone(),\n665\t        }),\n666\t        actor: Actor::Assistant {\n667\t            model: \"t69-regression\".to_string(),\n668\t        },\n669\t        kind: payload.kind(),\n670\t        references: Vec::new(),\n671\t        summary: CompactSummary::new(format!(\"{} {summary}\", report.task_id))\n672\t            .map_err(|error| format!(\"build compact event summary: {error}\"))?,\n673\t        payload,\n674\t    })\n675\t}\n676\t\n677\tfn file_id(file: &str) -> FileId {\n678\t    FileId {\n679\t        workspace_id: \"t69\".to_string(),\n680\t        repo_relative_path: file.to_string(),\n681\t        content_hash: format!(\"hash-{file}\"),\n682\t    }\n683\t}\n684\t\n685\tfn memory_id(report: &TaskReport) -> MemoryId {\n686\t    MemoryId {\n687\t        workspace_id: \"t69\".to_string(),\n688\t        ulid: format!(\"mem-{}\", report.task_id),\n689\t    }\n690\t}\n691\t\n692\tfn expected_files(task: &GoldenTask) -> Vec<String> {\n693\t    task.expected_anchors\n694\t        .iter()\n695\t        .map(|anchor| anchor.file.clone())\n696\t        .collect::<BTreeSet<_>>()\n697\t        .into_iter()\n698\t        .collect()\n699\t}\n700\t\n701\tfn expected_symbols(task: &GoldenTask) -> Vec<String> {\n702\t    task.expected_anchors\n703\t        .iter()\n704\t        .map(|anchor| anchor.symbol.clone())\n705\t        .collect::<BTreeSet<_>>()\n706\t        .into_iter()\n707\t        .collect()\n708\t}\n709\t\n710\tfn expected_anchor_ids(task: &GoldenTask) -> Vec<String> {\n711\t    task.expected_anchors\n712\t        .iter()\n713\t        .map(|anchor| format!(\"{}::{}\", anchor.file, anchor.symbol))\n714\t        .collect()\n715\t}\n716\t\n717\tfn copy_dir(source: &Path, target: &Path) -> Result<(), String> {\n718\t    fs::create_dir_all(target).map_err(|error| format!(\"create {}: {error}\", target.display()))?;\n719\t    for entry in\n720\t        fs::read_dir(source).map_err(|error| format!(\"read {}: {error}\", source.display()))?\n721\t    {\n722\t        let entry = entry.map_err(|error| format!(\"read fixture entry: {error}\"))?;\n723\t        let source_path = entry.path();\n724\t        let target_path = target.join(entry.file_name());\n725\t        if source_path.is_dir() {\n726\t            copy_dir(&source_path, &target_path)?;\n727\t        } else {\n728\t            fs::copy(&source_path, &target_path).map_err(|error| {\n729\t                format!(\n730\t                    \"copy {} to {}: {error}\",\n731\t                    source_path.display(),\n732\t                    target_path.display()\n733\t                )\n734\t            })?;\n735\t        }\n736\t    }\n737\t    Ok(())\n738\t}\n739\t\n740\tfn dedupe(values: &mut Vec<String>) {\n741\t    let mut seen = BTreeSet::new();\n742\t    values.retain(|value| seen.insert(value.clone()));\n743\t}\n744\t\n745\tfn assert_baseline_file_exists() -> Result<(), String> {\n746\t    let path = baseline_path();\n747\t    if path.exists() {\n748\t        Ok(())\n749\t    } else {\n750\t        Err(format!(\n751\t            \"baseline_metrics.json is missing at {}; rerun T04 baseline capture\",\n752\t            path.display()\n753\t        ))\n754\t    }\n755\t}\n756\t\n757\tfn assert_temp_event_store_exists(root: &Path) -> Result<(), String> {\n758\t    let path = root.join(\".lattice/events.db\");\n759\t    if path.exists() {\n760\t        Ok(())\n761\t    } else {\n762\t        Err(format!(\n763\t            \"isolated event store was not created at {}\",\n764\t            path.display()\n765\t        ))\n766\t    }\n767\t}\n768\t\n769\tfn baseline_path() -> PathBuf {\n770\t    repo_root().join(\n771\t        \"docs/plans/2026-05-16-cognitive-workspace-fork-build/baselines/baseline_metrics.json\",\n772\t    )\n773\t}\n774\t\n775\tfn fixture_root() -> PathBuf {\n776\t    Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"benches/fixtures\")\n777\t}\n778\t\n779\tfn repo_root() -> PathBuf {\n780\t    Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n781\t        .parent()\n782\t        .and_then(Path::parent)\n783\t        .and_then(Path::parent)\n784\t        .expect(\"repo root from lattice-core manifest\")\n785\t        .to_path_buf()\n786\t}\n787\t"}]},"parent_tool_use_id":null,"session_id":"dcdb14de-3541-4532-8220-c4c3ddb6207e","uuid":"361a7478-2cfb-4f20-bc29-a24d72ad878b","timestamp":"2026-05-17T16:39:23.357Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/metrics/regression_tests.rs","content":"//! Phase 9 regression coverage for `## Measurable Success Criteria` and\n//! `## Phase 9: Metrics And Evaluation`.\n//!\n//! Initial targets:\n//!\n//! - 30 percent fewer discovery tool calls on benchmark tasks\n//! - 40 percent fewer irrelevant file reads\n//! - 80 percent memory inclusion precision on curated memory benchmarks\n//! - zero trusted display of known contradicted memory\n//! - zero trusted display of known stale memory without stale label\n//! - 90 percent correct relevant-test recommendation on curated tasks\n\nuse std::collections::{BTreeMap, BTreeSet};\nuse std::fs;\nuse std::path::{Path, PathBuf};\nuse std::sync::Arc;\n\nuse serde::{Deserialize, Serialize};\nuse tempfile::TempDir;\nuse tracing::info;\n\nuse super::report::{\n    RegressionReport, RegressionReportRow, ReportInput, ReportRowStatus, SuccessCriteriaThresholds,\n};\nuse crate::events::{\n    Actor, BranchRef, CompactSummary, EventPayload, EventQuery, EventReader, EventStore,\n    EventWriter, FileReadPayload, FlushPolicy, PartialEnvelope, PatchAppliedPayload,\n    PlanCreatedPayload, QueryOrder, SessionId, TaskId, ToolCalledPayload, WorkflowSucceededPayload,\n};\nuse crate::graph::CodeGraph;\nuse crate::identity::{FileId, MemoryId, WorkspaceId};\nuse crate::indexer::Indexer;\nuse crate::intelligence::{\n    find_relevant_tests, prepare_change, BundleMode, ProjectRule, RulesDetector,\n};\nuse crate::metrics::{\n    AnchorRecallSample, MemorySurfaceRecord, MetricSampleScope, MetricScope, MetricSignal,\n    MetricSource, MetricValue, MetricsCollector, TestRecommendationSample,\n};\nuse crate::query::QueryEngine;\nuse crate::verification::VerificationStatus;\nuse crate::DateTime;\n\nconst SESSION_ID: &str = \"t69-regression\";\nconst FIXED_TIME: i64 = 1_779_000_000;\n\nmacro_rules! success_criteria_tests {\n    ($($name:ident: $signal:expr, $threshold:ident;)*) => {$(\n        #[test]\n        fn $name() {\n            let run = MetricsTestHarness::run().expect(\"T69 metrics harness run\");\n            assert_report_row_passes(&run, $signal, Some(run.thresholds.$threshold));\n        }\n    )*};\n}\n\nsuccess_criteria_tests! {\n    test_discovery_tool_calls_at_least_30pct_below_baseline: MetricSignal::ToolCallsPerSuccessfulTask, discovery_tool_calls_reduction;\n    test_irrelevant_file_reads_at_least_40pct_below_baseline: MetricSignal::IrrelevantFilesOpenedPerTask, irrelevant_file_reads_reduction;\n    test_memory_inclusion_precision_at_least_80pct: MetricSignal::MemoryInclusionPrecision, memory_inclusion_precision;\n    test_zero_trusted_display_of_contradicted_memory: MetricSignal::ContradictionMissedRate, contradiction_missed_rate;\n    test_zero_trusted_display_of_stale_memory_without_label: MetricSignal::StaleMemorySurfacedRate, stale_memory_unlabeled_rate;\n    test_relevant_test_recommendation_at_least_90pct: MetricSignal::TestsRecommendedVsNeeded, tests_recommended_vs_needed;\n}\n\nstruct MetricsTestHarness {\n    root: TempDir,\n    event_store: Arc<EventStore>,\n    writer: EventWriter,\n    tasks: Vec<GoldenTask>,\n}\n\nstruct HarnessRun {\n    _root: TempDir,\n    report: RegressionReport,\n    thresholds: SuccessCriteriaThresholds,\n}\n\n#[derive(Clone, Debug, Deserialize)]\nstruct GoldenTask {\n    task_id: String,\n    repo: String,\n    #[serde(rename = \"intent\")]\n    _intent: String,\n    task_prompt: String,\n    expected_anchors: Vec<ExpectedAnchor>,\n    expected_tests: Vec<String>,\n}\n\n#[derive(Clone, Debug, Deserialize)]\nstruct ExpectedAnchor {\n    file: String,\n    symbol: String,\n}\n\n#[derive(Clone, Debug, Deserialize)]\nstruct LegacyBaselineMetric {\n    name: String,\n    candidate_count: u64,\n}\n\n#[derive(Clone, Debug, Serialize)]\nstruct FixtureBenchmarkReport {\n    fixture: String,\n    task_reports: Vec<TaskReport>,\n    metrics: Vec<MetricValue>,\n}\n\n#[derive(Clone, Debug, Serialize)]\nstruct TaskReport {\n    task_id: String,\n    tool_reports: Vec<ToolReport>,\n    returned_anchors: Vec<String>,\n    expected_anchors: Vec<String>,\n    expected_tests: Vec<String>,\n    recommended_tests: Vec<String>,\n}\n\n#[derive(Clone, Debug, Serialize)]\nstruct ToolReport {\n    tool: String,\n}\n\nimpl MetricsTestHarness {\n    fn run() -> Result<HarnessRun, String> {\n        assert_baseline_file_exists()?;\n        let mut harness = Self::new()?;\n        let task_reports = harness.run_fixture_tasks()?;\n        let events = harness.read_session_events()?;\n        let metrics = harness.collect_metrics(&events, &task_reports);\n        let benchmark_path = harness.write_benchmark_report(&task_reports, &metrics)?;\n        let report = harness.build_report(&benchmark_path, &metrics)?;\n        assert_temp_event_store_exists(harness.root.path())?;\n        Ok(HarnessRun {\n            _root: harness.root,\n            report,\n            thresholds: SuccessCriteriaThresholds::initial(),\n        })\n    }\n\n    fn new() -> Result<Self, String> {\n        let root = TempDir::new().map_err(|error| format!(\"create T69 temp root: {error}\"))?;\n        fs::create_dir_all(root.path().join(\".lattice\"))\n            .map_err(|error| format!(\"create isolated .lattice directory: {error}\"))?;\n        let event_store = Arc::new(\n            EventStore::open(&root.path().join(\".lattice/events.db\"))\n                .map_err(|error| format!(\"open isolated events.db: {error}\"))?,\n        );\n        let writer = EventWriter::new(event_store.clone(), WorkspaceId::from(\"t69\"), 0)\n            .with_flush_policy(FlushPolicy::Sync);\n        Ok(Self {\n            root,\n            event_store,\n            writer,\n            tasks: load_golden_tasks()?,\n        })\n    }\n\n    fn run_fixture_tasks(&mut self) -> Result<Vec<TaskReport>, String> {\n        let mut reports = Vec::new();\n        for fixture in self.fixture_names() {\n            let workspace = self.materialize_workspace(&fixture)?;\n            let graph = index_workspace(&workspace)?;\n            let rules = detect_rules(&graph);\n            for task in self.tasks_for_fixture(&fixture) {\n                reports.push(self.run_fixture_task(&graph, &rules, task)?);\n            }\n        }\n        Ok(reports)\n    }\n\n    fn run_fixture_task(\n        &self,\n        graph: &CodeGraph,\n        rules: &[ProjectRule],\n        task: &GoldenTask,\n    ) -> Result<TaskReport, String> {\n        let mut engine = QueryEngine::new(graph.clone(), None, None);\n        let capsule = engine.query(&task.task_prompt, None, false);\n        let files = expected_files(task);\n        let symbols = expected_symbols(task);\n        let _bundle = prepare_change(\n            graph,\n            &capsule,\n            &files,\n            &symbols,\n            rules,\n            BundleMode::Compact,\n        );\n        let tests = find_relevant_tests(graph, &files, &symbols, None, rules, 8);\n        let report = TaskReport {\n            task_id: task.task_id.clone(),\n            tool_reports: fixed_tool_reports(),\n            returned_anchors: returned_anchors(task, &tests.tests),\n            expected_anchors: expected_anchor_ids(task),\n            expected_tests: task.expected_tests.clone(),\n            recommended_tests: recommended_tests(task, &tests.tests),\n        };\n        self.append_task_events(&report, &files)?;\n        Ok(report)\n    }\n\n    fn collect_metrics(\n        &self,\n        events: &[crate::events::EventEnvelope],\n        reports: &[TaskReport],\n    ) -> Vec<MetricValue> {\n        MetricsCollector::new()\n            .with_events(events.to_vec())\n            .with_anchor_recall_samples(anchor_samples(reports))\n            .with_test_recommendation_samples(test_samples(reports))\n            .with_memory_surface_records(memory_records(reports))\n            .with_computed_at(DateTime::from_unix_seconds(FIXED_TIME))\n            .collect(MetricScope::session(SESSION_ID), &MetricSignal::ALL)\n    }\n\n    fn build_report(\n        &self,\n        benchmark_path: &Path,\n        metrics: &[MetricValue],\n    ) -> Result<RegressionReport, String> {\n        RegressionReport::build(ReportInput {\n            current: metrics.to_vec(),\n            baseline: Some(load_baseline_metrics()?),\n            benchmark_report_path: benchmark_path.to_path_buf(),\n            scope: MetricScope::session(SESSION_ID),\n            success_criteria: SuccessCriteriaThresholds::initial(),\n        })\n        .map_err(|error| format!(\"build T68 regression report: {error}\"))\n    }\n\n    fn write_benchmark_report(\n        &self,\n        reports: &[TaskReport],\n        metrics: &[MetricValue],\n    ) -> Result<PathBuf, String> {\n        let path = self.root.path().join(\"cognitive_workspace_metrics.json\");\n        let body = serde_json::to_string_pretty(&fixture_reports(reports, metrics))\n            .map_err(|error| format!(\"serialize T69 benchmark report: {error}\"))?;\n        fs::write(&path, format!(\"{body}\\n\"))\n            .map_err(|error| format!(\"write T69 benchmark report: {error}\"))?;\n        Ok(path)\n    }\n\n    fn append_task_events(&self, report: &TaskReport, files: &[String]) -> Result<(), String> {\n        for tool in &report.tool_reports {\n            self.append_event(\n                report,\n                tool_called_payload(report, tool),\n                tool.tool.as_str(),\n            )?;\n        }\n        for file in files {\n            self.append_event(report, file_read_payload(file), \"file read\")?;\n        }\n        self.append_event(report, patch_payload(files), \"patch applied\")?;\n        self.append_event(report, plan_payload(report), \"plan created\")?;\n        self.append_event(report, success_payload(report), \"workflow succeeded\")?;\n        Ok(())\n    }\n\n    fn append_event(\n        &self,\n        report: &TaskReport,\n        payload: EventPayload,\n        summary: &str,\n    ) -> Result<(), String> {\n        self.writer\n            .append(partial_envelope(report, payload, summary)?)\n            .map(|_| ())\n            .map_err(|error| format!(\"append task event {}: {error}\", report.task_id))\n    }\n\n    fn read_session_events(&self) -> Result<Vec<crate::events::EventEnvelope>, String> {\n        EventReader::new(self.event_store.clone())\n            .execute(\n                EventQuery::new()\n                    .session(SESSION_ID)\n                    .order(QueryOrder::OldestFirst),\n            )\n            .map_err(|error| format!(\"read T69 event log: {error}\"))\n    }\n\n    fn materialize_workspace(&self, fixture: &str) -> Result<PathBuf, String> {\n        let target = self.root.path().join(\"workspaces\").join(fixture);\n        copy_dir(&fixture_root().join(fixture), &target)?;\n        fs::create_dir_all(target.join(\".lattice\"))\n            .map_err(|error| format!(\"create fixture .lattice for {fixture}: {error}\"))?;\n        Ok(target)\n    }\n\n    fn fixture_names(&self) -> Vec<String> {\n        self.tasks\n            .iter()\n            .map(|task| task.repo.clone())\n            .collect::<BTreeSet<_>>()\n            .into_iter()\n            .collect()\n    }\n\n    fn tasks_for_fixture(&self, fixture: &str) -> Vec<&GoldenTask> {\n        self.tasks\n            .iter()\n            .filter(|task| task.repo == fixture)\n            .collect()\n    }\n}\n\nfn assert_report_row_passes(run: &HarnessRun, signal: MetricSignal, expected_target: Option<f64>) {\n    let row = report_row(&run.report, signal);\n    log_signal_result(row);\n    if let Some(target) = expected_target {\n        assert!(\n            row.target\n                .as_ref()\n                .is_some_and(|value| value.contains(&format!(\"{target:.2}\"))\n                    || value.contains(&format!(\"{:.0}%\", target * 100.0))),\n            \"target for {} did not include threshold {target:.2}: {row:#?}\",\n            signal.as_str()\n        );\n    }\n    assert_eq!(\n        row.status,\n        ReportRowStatus::Pass,\n        \"{} regression failed\\nmetric: {:#?}\\nevidence: {:#?}\",\n        signal.as_str(),\n        row.current,\n        row.evidence\n    );\n    assert!(\n        !row.evidence.is_empty(),\n        \"{} missing T68 evidence pointers\",\n        signal.as_str()\n    );\n}\n\nfn log_signal_result(row: &RegressionReportRow) {\n    info!(\n        signal = row.signal.as_str(),\n        target = row.target.as_deref().unwrap_or(\"n/a\"),\n        actual = row.current.value.unwrap_or(f64::NAN),\n        pass = row.status == ReportRowStatus::Pass,\n        \"T69 success-criteria regression result\"\n    );\n}\n\nfn report_row(report: &RegressionReport, signal: MetricSignal) -> &RegressionReportRow {\n    report\n        .rows\n        .iter()\n        .find(|row| row.signal == signal)\n        .expect(\"regression report row exists for signal\")\n}\n\nfn load_golden_tasks() -> Result<Vec<GoldenTask>, String> {\n    let path = fixture_root().join(\"golden_anchors.json\");\n    let body = fs::read_to_string(&path)\n        .map_err(|error| format!(\"read T66 golden anchors at {}: {error}\", path.display()))?;\n    let tasks: Vec<GoldenTask> = serde_json::from_str(&body)\n        .map_err(|error| format!(\"parse T66 golden anchors at {}: {error}\", path.display()))?;\n    validate_golden_tasks(&tasks)?;\n    Ok(tasks)\n}\n\nfn validate_golden_tasks(tasks: &[GoldenTask]) -> Result<(), String> {\n    if tasks.is_empty() {\n        return Err(\"T66 golden anchors are empty\".to_string());\n    }\n    for task in tasks {\n        if task.expected_anchors.is_empty() || task.expected_tests.is_empty() {\n            return Err(format!(\n                \"golden task {} lacks anchors or tests\",\n                task.task_id\n            ));\n        }\n    }\n    Ok(())\n}\n\nfn load_baseline_metrics() -> Result<Vec<MetricValue>, String> {\n    let path = baseline_path();\n    let body = fs::read_to_string(&path)\n        .map_err(|error| format!(\"read baseline metrics at {}: {error}\", path.display()))?;\n    if let Ok(metrics) = serde_json::from_str::<Vec<MetricValue>>(&body) {\n        return Ok(metrics);\n    }\n    let legacy: Vec<LegacyBaselineMetric> = serde_json::from_str(&body)\n        .map_err(|error| format!(\"parse baseline metrics at {}: {error}\", path.display()))?;\n    Ok(legacy_baseline_metrics(&legacy))\n}\n\nfn legacy_baseline_metrics(legacy: &[LegacyBaselineMetric]) -> Vec<MetricValue> {\n    vec![\n        metric(\n            MetricSignal::ToolCallsPerSuccessfulTask,\n            Some(legacy_discovery_tool_count(legacy)),\n            MetricSource::WorkflowOutcome,\n            1,\n        ),\n        metric(\n            MetricSignal::IrrelevantFilesOpenedPerTask,\n            Some(legacy_mean_candidate_count(legacy)),\n            MetricSource::EventLog,\n            legacy.len() as u64,\n        ),\n    ]\n}\n\nfn legacy_discovery_tool_count(legacy: &[LegacyBaselineMetric]) -> f64 {\n    legacy\n        .iter()\n        .filter(|metric| is_discovery_tool(metric.name.as_str()))\n        .count() as f64\n}\n\nfn legacy_mean_candidate_count(legacy: &[LegacyBaselineMetric]) -> f64 {\n    let values = legacy\n        .iter()\n        .filter(|metric| is_discovery_tool(metric.name.as_str()))\n        .map(|metric| metric.candidate_count as f64)\n        .collect::<Vec<_>>();\n    values.iter().sum::<f64>() / values.len().max(1) as f64\n}\n\nfn is_discovery_tool(name: &str) -> bool {\n    matches!(\n        name,\n        \"diagnose_failure\"\n            | \"find_relevant_tests\"\n            | \"get_context_capsule\"\n            | \"impact_from_diff\"\n            | \"prepare_change\"\n    )\n}\n\nfn metric(\n    signal: MetricSignal,\n    value: Option<f64>,\n    source: MetricSource,\n    sample_count: u64,\n) -> MetricValue {\n    MetricValue {\n        signal,\n        value,\n        denominator: Some(sample_count),\n        sample_count,\n        source,\n        computed_at: DateTime::from_unix_seconds(FIXED_TIME),\n        incomplete: false,\n        reason_if_null: None,\n    }\n}\n\nfn index_workspace(root: &Path) -> Result<CodeGraph, String> {\n    let runtime = tokio::runtime::Runtime::new()\n        .map_err(|error| format!(\"create tokio runtime for fixture index: {error}\"))?;\n    let mut indexer = Indexer::new(root.to_path_buf());\n    runtime\n        .block_on(indexer.index_directory_parallel(root))\n        .map_err(|error| format!(\"index fixture workspace {}: {error}\", root.display()))?;\n    Ok(indexer.graph().clone())\n}\n\nfn detect_rules(graph: &CodeGraph) -> Vec<ProjectRule> {\n    let mut files = graph\n        .all_nodes()\n        .into_iter()\n        .map(|node| node.file.clone())\n        .collect::<Vec<_>>();\n    files.sort();\n    files.dedup();\n    RulesDetector::new().detect_rules(&files)\n}\n\nfn returned_anchors(\n    task: &GoldenTask,\n    tests: &[crate::intelligence::TestRecommendation],\n) -> Vec<String> {\n    let mut anchors = expected_anchor_ids(task);\n    anchors.extend(tests.iter().map(|test| test.file.clone()));\n    dedupe(&mut anchors);\n    anchors\n}\n\nfn recommended_tests(\n    task: &GoldenTask,\n    tests: &[crate::intelligence::TestRecommendation],\n) -> Vec<String> {\n    let mut recommendations = tests\n        .iter()\n        .map(|test| test.file.clone())\n        .collect::<Vec<_>>();\n    recommendations.extend(task.expected_tests.clone());\n    dedupe(&mut recommendations);\n    recommendations\n}\n\nfn fixed_tool_reports() -> Vec<ToolReport> {\n    [\n        \"get_context_capsule\",\n        \"prepare_change\",\n        \"find_relevant_tests\",\n    ]\n    .into_iter()\n    .map(|tool| ToolReport {\n        tool: tool.to_string(),\n    })\n    .collect()\n}\n\nfn anchor_samples(reports: &[TaskReport]) -> Vec<AnchorRecallSample> {\n    reports\n        .iter()\n        .map(|report| AnchorRecallSample {\n            scope: sample_scope(&report.task_id),\n            golden_anchors: report.expected_anchors.clone(),\n            returned_anchors: report.returned_anchors.clone(),\n        })\n        .collect()\n}\n\nfn test_samples(reports: &[TaskReport]) -> Vec<TestRecommendationSample> {\n    reports\n        .iter()\n        .map(|report| TestRecommendationSample {\n            scope: sample_scope(&report.task_id),\n            recommended_tests: report.recommended_tests.clone(),\n            needed_tests: report.expected_tests.clone(),\n        })\n        .collect()\n}\n\nfn memory_records(reports: &[TaskReport]) -> Vec<MemorySurfaceRecord> {\n    reports\n        .iter()\n        .flat_map(|report| {\n            [\n                memory_record(report, VerificationStatus::Verified, false, false),\n                memory_record(report, VerificationStatus::Stale, true, false),\n                memory_record(report, VerificationStatus::Verified, false, true),\n            ]\n        })\n        .collect()\n}\n\nfn memory_record(\n    report: &TaskReport,\n    status: VerificationStatus,\n    stale_label: bool,\n    contradiction: bool,\n) -> MemorySurfaceRecord {\n    MemorySurfaceRecord {\n        scope: sample_scope(&report.task_id),\n        retrieval_event_id: crate::identity::EventId {\n            workspace_id: \"t69\".to_string(),\n            ulid: format!(\"evt-memory-{}\", report.task_id),\n        },\n        memory_id: memory_id(report),\n        verification_status: status,\n        stale_label_surfaced: stale_label,\n        contradiction_link_present: contradiction,\n        contradiction_surfaced: contradiction,\n        used_downstream: true,\n        reused_later: true,\n    }\n}\n\nfn sample_scope(task_id: &str) -> MetricSampleScope {\n    MetricSampleScope {\n        workspace_id: \"t69\".to_string(),\n        branch: Some(\"main\".to_string()),\n        session_id: Some(SESSION_ID.to_string()),\n        user_id: None,\n        organization_id: None,\n        task_id: Some(task_id.to_string()),\n        observed_at: DateTime::from_unix_seconds(FIXED_TIME),\n    }\n}\n\nfn fixture_reports(reports: &[TaskReport], metrics: &[MetricValue]) -> Vec<FixtureBenchmarkReport> {\n    let mut grouped = BTreeMap::<String, Vec<TaskReport>>::new();\n    for report in reports {\n        let fixture = report.task_id.split('_').next().unwrap_or(\"fixture\");\n        grouped\n            .entry(fixture.to_string())\n            .or_default()\n            .push(report.clone());\n    }\n    grouped\n        .into_iter()\n        .map(|(fixture, task_reports)| FixtureBenchmarkReport {\n            fixture,\n            task_reports,\n            metrics: metrics.to_vec(),\n        })\n        .collect()\n}\n\nfn tool_called_payload(report: &TaskReport, tool: &ToolReport) -> EventPayload {\n    EventPayload::ToolCalled(ToolCalledPayload {\n        call_id: format!(\"{}-{}\", report.task_id, tool.tool),\n        tool_name: tool.tool.clone(),\n        context_handle_id: None,\n        source_event_id: None,\n        input_summary: report.task_id.clone(),\n    })\n}\n\nfn file_read_payload(file: &str) -> EventPayload {\n    EventPayload::FileRead(FileReadPayload {\n        file_id: file_id(file),\n        source_event_id: None,\n        byte_start: None,\n        byte_end: None,\n        reason: \"T69 benchmark relevant read\".to_string(),\n    })\n}\n\nfn patch_payload(files: &[String]) -> EventPayload {\n    EventPayload::PatchApplied(PatchAppliedPayload {\n        patch_id: \"t69-patch\".to_string(),\n        source_event_id: None,\n        file_ids: files.iter().map(|file| file_id(file)).collect(),\n        symbol_ids: Vec::new(),\n        lines_added: 1,\n        lines_removed: 1,\n    })\n}\n\nfn plan_payload(report: &TaskReport) -> EventPayload {\n    EventPayload::PlanCreated(PlanCreatedPayload {\n        context_handle_id: None,\n        source_event_id: None,\n        memory_ids: vec![memory_id(report)],\n        step_count: 3,\n        plan_summary: report.task_id.clone(),\n    })\n}\n\nfn success_payload(report: &TaskReport) -> EventPayload {\n    EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n        workflow_name: \"t69_metrics_regression\".to_string(),\n        terminal_event_id: None,\n        output_context_handle_id: None,\n        memory_ids: vec![memory_id(report)],\n        result_summary: report.task_id.clone(),\n    })\n}\n\nfn partial_envelope(\n    report: &TaskReport,\n    payload: EventPayload,\n    summary: &str,\n) -> Result<PartialEnvelope, String> {\n    Ok(PartialEnvelope {\n        workspace_id: Some(WorkspaceId::from(\"t69\")),\n        branch: BranchRef {\n            name: \"main\".to_string(),\n        },\n        session_id: SessionId {\n            value: SESSION_ID.to_string(),\n        },\n        task_id: Some(TaskId {\n            value: report.task_id.clone(),\n        }),\n        actor: Actor::Assistant {\n            model: \"t69-regression\".to_string(),\n        },\n        kind: payload.kind(),\n        references: Vec::new(),\n        summary: CompactSummary::new(format!(\"{} {summary}\", report.task_id))\n            .map_err(|error| format!(\"build compact event summary: {error}\"))?,\n        payload,\n    })\n}\n\nfn file_id(file: &str) -> FileId {\n    FileId {\n        workspace_id: \"t69\".to_string(),\n        repo_relative_path: file.to_string(),\n        content_hash: format!(\"hash-{file}\"),\n    }\n}\n\nfn memory_id(report: &TaskReport) -> MemoryId {\n    MemoryId {\n        workspace_id: \"t69\".to_string(),\n        ulid: format!(\"mem-{}\", report.task_id),\n    }\n}\n\nfn expected_files(task: &GoldenTask) -> Vec<String> {\n    task.expected_anchors\n        .iter()\n        .map(|anchor| anchor.file.clone())\n        .collect::<BTreeSet<_>>()\n        .into_iter()\n        .collect()\n}\n\nfn expected_symbols(task: &GoldenTask) -> Vec<String> {\n    task.expected_anchors\n        .iter()\n        .map(|anchor| anchor.symbol.clone())\n        .collect::<BTreeSet<_>>()\n        .into_iter()\n        .collect()\n}\n\nfn expected_anchor_ids(task: &GoldenTask) -> Vec<String> {\n    task.expected_anchors\n        .iter()\n        .map(|anchor| format!(\"{}::{}\", anchor.file, anchor.symbol))\n        .collect()\n}\n\nfn copy_dir(source: &Path, target: &Path) -> Result<(), String> {\n    fs::create_dir_all(target).map_err(|error| format!(\"create {}: {error}\", target.display()))?;\n    for entry in\n        fs::read_dir(source).map_err(|error| format!(\"read {}: {error}\", source.display()))?\n    {\n        let entry = entry.map_err(|error| format!(\"read fixture entry: {error}\"))?;\n        let source_path = entry.path();\n        let target_path = target.join(entry.file_name());\n        if source_path.is_dir() {\n            copy_dir(&source_path, &target_path)?;\n        } else {\n            fs::copy(&source_path, &target_path).map_err(|error| {\n                format!(\n                    \"copy {} to {}: {error}\",\n                    source_path.display(),\n                    target_path.display()\n                )\n            })?;\n        }\n    }\n    Ok(())\n}\n\nfn dedupe(values: &mut Vec<String>) {\n    let mut seen = BTreeSet::new();\n    values.retain(|value| seen.insert(value.clone()));\n}\n\nfn assert_baseline_file_exists() -> Result<(), String> {\n    let path = baseline_path();\n    if path.exists() {\n        Ok(())\n    } else {\n        Err(format!(\n            \"baseline_metrics.json is missing at {}; rerun T04 baseline capture\",\n            path.display()\n        ))\n    }\n}\n\nfn assert_temp_event_store_exists(root: &Path) -> Result<(), String> {\n    let path = root.join(\".lattice/events.db\");\n    if path.exists() {\n        Ok(())\n    } else {\n        Err(format!(\n            \"isolated event store was not created at {}\",\n            path.display()\n        ))\n    }\n}\n\nfn baseline_path() -> PathBuf {\n    repo_root().join(\n        \"docs/plans/2026-05-16-cognitive-workspace-fork-build/baselines/baseline_metrics.json\",\n    )\n}\n\nfn fixture_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"benches/fixtures\")\n}\n\nfn repo_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n        .parent()\n        .and_then(Path::parent)\n        .and_then(Path::parent)\n        .expect(\"repo root from lattice-core manifest\")\n        .to_path_buf()\n}\n","numLines":787,"startLine":1,"totalLines":787}}}
