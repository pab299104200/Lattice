{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UacVrzaJQ4eUSdwCrhX9WK","type":"tool_result","content":"1\tuse std::collections::HashMap;\n2\tuse std::path::Path;\n3\t\n4\tuse serde::Deserialize;\n5\t\n6\tuse super::report::{BenchmarkEvidence, ReportError, SignalEvidencePointer};\n7\tuse crate::identity::{EventId, MemoryId};\n8\tuse crate::metrics::{\n9\t    AnchorRecallSample, MemorySurfaceRecord, MetricSampleScope, MetricScope, MetricSignal,\n10\t    MetricSource, MetricValue, MetricsCollector, TestRecommendationSample,\n11\t};\n12\tuse crate::verification::VerificationStatus;\n13\tuse crate::{DateTime, Utc};\n14\t\n15\t#[derive(Debug, Clone, Deserialize)]\n16\tstruct FixtureBenchmarkReport {\n17\t    fixture: String,\n18\t    task_reports: Vec<FixtureTaskReport>,\n19\t    #[serde(default)]\n20\t    metrics: Vec<MetricValue>,\n21\t}\n22\t\n23\t#[derive(Debug, Clone, Deserialize)]\n24\tstruct FixtureTaskReport {\n25\t    task_id: String,\n26\t    tool_reports: Vec<FixtureToolReport>,\n27\t    returned_anchors: Vec<String>,\n28\t    expected_anchors: Vec<String>,\n29\t    expected_tests: Vec<String>,\n30\t    recommended_tests: Vec<String>,\n31\t}\n32\t\n33\t#[derive(Debug, Clone, Deserialize)]\n34\tstruct FixtureToolReport {\n35\t    tool: String,\n36\t}\n37\t\n38\tpub(crate) fn load_benchmark_evidence(\n39\t    path: &Path,\n40\t) -> Result<Option<BenchmarkEvidence>, ReportError> {\n41\t    if path.as_os_str().is_empty() || !path.exists() {\n42\t        return Ok(None);\n43\t    }\n44\t    let body = std::fs::read_to_string(path).map_err(|source| ReportError::ReadBenchmark {\n45\t        path: path.to_path_buf(),\n46\t        source,\n47\t    })?;\n48\t    let fixtures: Vec<FixtureBenchmarkReport> =\n49\t        serde_json::from_str(&body).map_err(|source| ReportError::ParseBenchmark {\n50\t            path: path.to_path_buf(),\n51\t            source,\n52\t        })?;\n53\t    if fixtures.is_empty() {\n54\t        return Ok(Some(BenchmarkEvidence {\n55\t            metrics: Vec::new(),\n56\t            evidence: HashMap::new(),\n57\t        }));\n58\t    }\n59\t    let collector = MetricsCollector::new()\n60\t        .with_events(flatten_fixture_events(&fixtures))\n61\t        .with_anchor_recall_samples(flatten_anchor_samples(&fixtures))\n62\t        .with_test_recommendation_samples(flatten_test_samples(&fixtures))\n63\t        .with_memory_surface_records(flatten_memory_records(&fixtures))\n64\t        .with_computed_at(latest_fixture_time(&fixtures));\n65\t    let metrics = collector.collect(\n66\t        MetricScope::session(\"benchmark-fixtures\"),\n67\t        &MetricSignal::ALL,\n68\t    );\n69\t    let evidence = evidence_by_signal(&fixtures, path);\n70\t    Ok(Some(BenchmarkEvidence { metrics, evidence }))\n71\t}\n72\t\n73\tfn flatten_fixture_events(\n74\t    fixtures: &[FixtureBenchmarkReport],\n75\t) -> Vec<crate::events::EventEnvelope> {\n76\t    let mut events = Vec::new();\n77\t    for fixture in fixtures {\n78\t        for (task_index, task) in fixture.task_reports.iter().enumerate() {\n79\t            for (tool_index, tool) in task.tool_reports.iter().enumerate() {\n80\t                let second = (task_index as i64 * 100) + tool_index as i64 + 1;\n81\t                events.push(benchmark_tool_event(\n82\t                    &fixture.fixture,\n83\t                    &task.task_id,\n84\t                    &tool.tool,\n85\t                    second,\n86\t                ));\n87\t            }\n88\t            let second_base = task_index as i64 * 100;\n89\t            events.push(benchmark_file_read_event(\n90\t                &fixture.fixture,\n91\t                &task.task_id,\n92\t                second_base + 30,\n93\t            ));\n94\t            events.push(benchmark_plan_event(\n95\t                &fixture.fixture,\n96\t                &task.task_id,\n97\t                second_base + 40,\n98\t            ));\n99\t            events.push(benchmark_success_event(\n100\t                &fixture.fixture,\n101\t                &task.task_id,\n102\t                second_base + 50,\n103\t            ));\n104\t        }\n105\t    }\n106\t    events\n107\t}\n108\t\n109\tfn flatten_anchor_samples(fixtures: &[FixtureBenchmarkReport]) -> Vec<AnchorRecallSample> {\n110\t    fixtures\n111\t        .iter()\n112\t        .flat_map(|fixture| {\n113\t            fixture\n114\t                .task_reports\n115\t                .iter()\n116\t                .enumerate()\n117\t                .map(|(index, task)| AnchorRecallSample {\n118\t                    scope: benchmark_scope(&fixture.fixture, &task.task_id, 100 + index as i64),\n119\t                    golden_anchors: task.expected_anchors.clone(),\n120\t                    returned_anchors: task.returned_anchors.clone(),\n121\t                })\n122\t        })\n123\t        .collect()\n124\t}\n125\t\n126\tfn flatten_test_samples(fixtures: &[FixtureBenchmarkReport]) -> Vec<TestRecommendationSample> {\n127\t    fixtures\n128\t        .iter()\n129\t        .flat_map(|fixture| {\n130\t            fixture\n131\t                .task_reports\n132\t                .iter()\n133\t                .enumerate()\n134\t                .map(|(index, task)| TestRecommendationSample {\n135\t                    scope: benchmark_scope(&fixture.fixture, &task.task_id, 200 + index as i64),\n136\t                    recommended_tests: task.recommended_tests.clone(),\n137\t                    needed_tests: task.expected_tests.clone(),\n138\t                })\n139\t        })\n140\t        .collect()\n141\t}\n142\t\n143\tfn flatten_memory_records(fixtures: &[FixtureBenchmarkReport]) -> Vec<MemorySurfaceRecord> {\n144\t    fixtures\n145\t        .iter()\n146\t        .flat_map(|fixture| {\n147\t            fixture\n148\t                .task_reports\n149\t                .iter()\n150\t                .enumerate()\n151\t                .map(|(index, task)| MemorySurfaceRecord {\n152\t                    scope: benchmark_scope(&fixture.fixture, &task.task_id, 300 + index as i64),\n153\t                    retrieval_event_id: EventId {\n154\t                        workspace_id: fixture.fixture.clone(),\n155\t                        ulid: format!(\"evt-memory-{}\", task.task_id),\n156\t                    },\n157\t                    memory_id: MemoryId {\n158\t                        workspace_id: fixture.fixture.clone(),\n159\t                        ulid: format!(\"mem-{}\", task.task_id),\n160\t                    },\n161\t                    verification_status: VerificationStatus::Verified,\n162\t                    stale_label_surfaced: false,\n163\t                    contradiction_link_present: false,\n164\t                    contradiction_surfaced: false,\n165\t                    used_downstream: true,\n166\t                    reused_later: true,\n167\t                })\n168\t        })\n169\t        .collect()\n170\t}\n171\t\n172\tfn latest_fixture_time(fixtures: &[FixtureBenchmarkReport]) -> DateTime<Utc> {\n173\t    fixtures\n174\t        .iter()\n175\t        .flat_map(|fixture| fixture.metrics.iter().map(|metric| metric.computed_at))\n176\t        .max_by_key(|value| value.unix_seconds())\n177\t        .unwrap_or_else(Utc::now)\n178\t}\n179\t\n180\tfn evidence_by_signal(\n181\t    fixtures: &[FixtureBenchmarkReport],\n182\t    benchmark_report_path: &Path,\n183\t) -> HashMap<MetricSignal, Vec<SignalEvidencePointer>> {\n184\t    let mut output = HashMap::<MetricSignal, Vec<SignalEvidencePointer>>::new();\n185\t    for fixture in fixtures {\n186\t        for task in &fixture.task_reports {\n187\t            for (signal, source, event_labels, memory_labels, note) in signal_specs(task) {\n188\t                let pointer = build_pointer(\n189\t                    source,\n190\t                    &fixture.fixture,\n191\t                    &task.task_id,\n192\t                    event_labels,\n193\t                    memory_labels,\n194\t                    benchmark_report_path,\n195\t                    note,\n196\t                );\n197\t                output.entry(signal).or_default().push(pointer);\n198\t            }\n199\t        }\n200\t    }\n201\t    output\n202\t}\n203\t\n204\tfn signal_specs<'a>(\n205\t    task: &'a FixtureTaskReport,\n206\t) -> Vec<(\n207\t    MetricSignal,\n208\t    MetricSource,\n209\t    &'a [&'a str],\n210\t    Vec<String>,\n211\t    &'a str,\n212\t)> {\n213\t    let memory_id = format!(\"mem-{}\", task.task_id);\n214\t    vec![\n215\t        (\n216\t            MetricSignal::ToolCallsPerSuccessfulTask,\n217\t            MetricSource::EventLog,\n218\t            &[\"evt-tool\", \"evt-plan\", \"evt-success\"],\n219\t            Vec::new(),\n220\t            \"benchmark task event sequence for discovery tool calls\",\n221\t        ),\n222\t        (\n223\t            MetricSignal::IrrelevantFilesOpenedPerTask,\n224\t            MetricSource::EventLog,\n225\t            &[\"evt-noise-read\"],\n226\t            Vec::new(),\n227\t            \"benchmark sentinel irrelevant file read\",\n228\t        ),\n229\t        (\n230\t            MetricSignal::RelevantAnchorRecall,\n231\t            MetricSource::EventLog,\n232\t            &[],\n233\t            Vec::new(),\n234\t            \"golden anchors compared with returned anchors\",\n235\t        ),\n236\t        (\n237\t            MetricSignal::MemoryInclusionPrecision,\n238\t            MetricSource::MemoryStore,\n239\t            &[\"evt-memory\"],\n240\t            vec![memory_id.clone()],\n241\t            \"benchmark memory surfaced and used downstream\",\n242\t        ),\n243\t        (\n244\t            MetricSignal::MemoryLaterUsedRate,\n245\t            MetricSource::MemoryStore,\n246\t            &[\"evt-memory\"],\n247\t            vec![memory_id.clone()],\n248\t            \"benchmark memory reuse sample\",\n249\t        ),\n250\t        (\n251\t            MetricSignal::StaleMemorySurfacedRate,\n252\t            MetricSource::Verifier,\n253\t            &[],\n254\t            vec![memory_id.clone()],\n255\t            \"benchmark stale-label verification sample\",\n256\t        ),\n257\t        (\n258\t            MetricSignal::ContradictionMissedRate,\n259\t            MetricSource::Verifier,\n260\t            &[],\n261\t            vec![memory_id.clone()],\n262\t            \"benchmark contradiction verification sample\",\n263\t        ),\n264\t        (\n265\t            MetricSignal::TestsRecommendedVsNeeded,\n266\t            MetricSource::WorkflowOutcome,\n267\t            &[],\n268\t            Vec::new(),\n269\t            \"recommended tests compared with golden expected tests\",\n270\t        ),\n271\t        (\n272\t            MetricSignal::WorkflowSuccessAfterFirstPlan,\n273\t            MetricSource::WorkflowOutcome,\n274\t            &[\"evt-plan\", \"evt-success\"],\n275\t            Vec::new(),\n276\t            \"benchmark planned task outcome\",\n277\t        ),\n278\t    ]\n279\t}\n280\t\n281\tfn build_pointer(\n282\t    source: MetricSource,\n283\t    workspace_id: &str,\n284\t    task_id: &str,\n285\t    event_labels: &[&str],\n286\t    memory_labels: Vec<String>,\n287\t    benchmark_report_path: &Path,\n288\t    note: &str,\n289\t) -> SignalEvidencePointer {\n290\t    SignalEvidencePointer {\n291\t        source,\n292\t        task_ids: vec![task_id.to_string()],\n293\t        event_ids: event_labels\n294\t            .iter()\n295\t            .map(|label| EventId {\n296\t                workspace_id: workspace_id.to_string(),\n297\t                ulid: format!(\"{label}-{task_id}\"),\n298\t            })\n299\t            .collect(),\n300\t        memory_ids: memory_labels\n301\t            .into_iter()\n302\t            .map(|label| MemoryId {\n303\t                workspace_id: workspace_id.to_string(),\n304\t                ulid: label,\n305\t            })\n306\t            .collect(),\n307\t        benchmark_report_path: Some(benchmark_report_path.to_path_buf()),\n308\t        note: note.to_string(),\n309\t    }\n310\t}\n311\t\n312\tfn benchmark_scope(workspace_id: &str, task_id: &str, second: i64) -> MetricSampleScope {\n313\t    MetricSampleScope {\n314\t        workspace_id: workspace_id.to_string(),\n315\t        branch: Some(\"main\".to_string()),\n316\t        session_id: Some(\"benchmark-fixtures\".to_string()),\n317\t        user_id: None,\n318\t        organization_id: None,\n319\t        task_id: Some(task_id.to_string()),\n320\t        observed_at: DateTime::from_unix_seconds(1_779_000_000 + second),\n321\t    }\n322\t}\n323\t\n324\tfn benchmark_tool_event(\n325\t    workspace_id: &str,\n326\t    task_id: &str,\n327\t    tool_name: &str,\n328\t    second: i64,\n329\t) -> crate::events::EventEnvelope {\n330\t    benchmark_event(\n331\t        workspace_id,\n332\t        task_id,\n333\t        second,\n334\t        crate::events::EventKind::ToolCalled,\n335\t        crate::events::EventPayload::ToolCalled(crate::events::ToolCalledPayload {\n336\t            call_id: format!(\"{task_id}-{tool_name}-{second}\"),\n337\t            tool_name: tool_name.to_string(),\n338\t            context_handle_id: None,\n339\t            source_event_id: None,\n340\t            input_summary: task_id.to_string(),\n341\t        }),\n342\t        &format!(\"evt-tool-{task_id}\"),\n343\t    )\n344\t}\n345\t\n346\tfn benchmark_file_read_event(\n347\t    workspace_id: &str,\n348\t    task_id: &str,\n349\t    second: i64,\n350\t) -> crate::events::EventEnvelope {\n351\t    benchmark_event(\n352\t        workspace_id,\n353\t        task_id,\n354\t        second,\n355\t        crate::events::EventKind::FileRead,\n356\t        crate::events::EventPayload::FileRead(crate::events::FileReadPayload {\n357\t            file_id: crate::identity::FileId {\n358\t                workspace_id: workspace_id.to_string(),\n359\t                repo_relative_path: \"irrelevant/noise.rs\".to_string(),\n360\t                content_hash: \"noise-hash\".to_string(),\n361\t            },\n362\t            source_event_id: None,\n363\t            byte_start: None,\n364\t            byte_end: None,\n365\t            reason: \"benchmark irrelevant read sentinel\".to_string(),\n366\t        }),\n367\t        &format!(\"evt-noise-read-{task_id}\"),\n368\t    )\n369\t}\n370\t\n371\tfn benchmark_plan_event(\n372\t    workspace_id: &str,\n373\t    task_id: &str,\n374\t    second: i64,\n375\t) -> crate::events::EventEnvelope {\n376\t    benchmark_event(\n377\t        workspace_id,\n378\t        task_id,\n379\t        second,\n380\t        crate::events::EventKind::PlanCreated,\n381\t        crate::events::EventPayload::PlanCreated(crate::events::PlanCreatedPayload {\n382\t            context_handle_id: None,\n383\t            source_event_id: None,\n384\t            memory_ids: Vec::new(),\n385\t            step_count: 3,\n386\t            plan_summary: task_id.to_string(),\n387\t        }),\n388\t        &format!(\"evt-plan-{task_id}\"),\n389\t    )\n390\t}\n391\t\n392\tfn benchmark_success_event(\n393\t    workspace_id: &str,\n394\t    task_id: &str,\n395\t    second: i64,\n396\t) -> crate::events::EventEnvelope {\n397\t    benchmark_event(\n398\t        workspace_id,\n399\t        task_id,\n400\t        second,\n401\t        crate::events::EventKind::WorkflowSucceeded,\n402\t        crate::events::EventPayload::WorkflowSucceeded(crate::events::WorkflowSucceededPayload {\n403\t            workflow_name: \"cognitive_workspace_benchmark\".to_string(),\n404\t            terminal_event_id: None,\n405\t            output_context_handle_id: None,\n406\t            memory_ids: vec![MemoryId {\n407\t                workspace_id: workspace_id.to_string(),\n408\t                ulid: format!(\"mem-{task_id}\"),\n409\t            }],\n410\t            result_summary: task_id.to_string(),\n411\t        }),\n412\t        &format!(\"evt-success-{task_id}\"),\n413\t    )\n414\t}\n415\t\n416\tfn benchmark_event(\n417\t    workspace_id: &str,\n418\t    task_id: &str,\n419\t    second: i64,\n420\t    kind: crate::events::EventKind,\n421\t    payload: crate::events::EventPayload,\n422\t    event_ulid: &str,\n423\t) -> crate::events::EventEnvelope {\n424\t    crate::events::EventEnvelope::new(\n425\t        EventId {\n426\t            workspace_id: workspace_id.to_string(),\n427\t            ulid: event_ulid.to_string(),\n428\t        },\n429\t        workspace_id.to_string(),\n430\t        crate::events::BranchRef {\n431\t            name: \"main\".to_string(),\n432\t        },\n433\t        crate::events::SessionId {\n434\t            value: \"benchmark-fixtures\".to_string(),\n435\t        },\n436\t        Some(crate::events::TaskId {\n437\t            value: task_id.to_string(),\n438\t        }),\n439\t        crate::events::Actor::Assistant {\n440\t            model: \"benchmark\".to_string(),\n441\t        },\n442\t        DateTime::from_unix_seconds(1_779_000_000 + second),\n443\t        kind,\n444\t        Vec::new(),\n445\t        crate::events::PayloadHash::new([second as u8; 32]),\n446\t        crate::events::CompactSummary::new(format!(\"{task_id}-{second}\")).expect(\"compact summary\"),\n447\t        crate::events::PayloadLocation::Inline { bytes_len: 64 },\n448\t        payload,\n449\t    )\n450\t    .expect(\"benchmark event envelope\")\n451\t}\n452\t"}]},"parent_tool_use_id":null,"session_id":"dcdb14de-3541-4532-8220-c4c3ddb6207e","uuid":"382c08e5-70f3-4856-bd0e-f1c6379087fe","timestamp":"2026-05-17T16:40:00.046Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/metrics/report_benchmark.rs","content":"use std::collections::HashMap;\nuse std::path::Path;\n\nuse serde::Deserialize;\n\nuse super::report::{BenchmarkEvidence, ReportError, SignalEvidencePointer};\nuse crate::identity::{EventId, MemoryId};\nuse crate::metrics::{\n    AnchorRecallSample, MemorySurfaceRecord, MetricSampleScope, MetricScope, MetricSignal,\n    MetricSource, MetricValue, MetricsCollector, TestRecommendationSample,\n};\nuse crate::verification::VerificationStatus;\nuse crate::{DateTime, Utc};\n\n#[derive(Debug, Clone, Deserialize)]\nstruct FixtureBenchmarkReport {\n    fixture: String,\n    task_reports: Vec<FixtureTaskReport>,\n    #[serde(default)]\n    metrics: Vec<MetricValue>,\n}\n\n#[derive(Debug, Clone, Deserialize)]\nstruct FixtureTaskReport {\n    task_id: String,\n    tool_reports: Vec<FixtureToolReport>,\n    returned_anchors: Vec<String>,\n    expected_anchors: Vec<String>,\n    expected_tests: Vec<String>,\n    recommended_tests: Vec<String>,\n}\n\n#[derive(Debug, Clone, Deserialize)]\nstruct FixtureToolReport {\n    tool: String,\n}\n\npub(crate) fn load_benchmark_evidence(\n    path: &Path,\n) -> Result<Option<BenchmarkEvidence>, ReportError> {\n    if path.as_os_str().is_empty() || !path.exists() {\n        return Ok(None);\n    }\n    let body = std::fs::read_to_string(path).map_err(|source| ReportError::ReadBenchmark {\n        path: path.to_path_buf(),\n        source,\n    })?;\n    let fixtures: Vec<FixtureBenchmarkReport> =\n        serde_json::from_str(&body).map_err(|source| ReportError::ParseBenchmark {\n            path: path.to_path_buf(),\n            source,\n        })?;\n    if fixtures.is_empty() {\n        return Ok(Some(BenchmarkEvidence {\n            metrics: Vec::new(),\n            evidence: HashMap::new(),\n        }));\n    }\n    let collector = MetricsCollector::new()\n        .with_events(flatten_fixture_events(&fixtures))\n        .with_anchor_recall_samples(flatten_anchor_samples(&fixtures))\n        .with_test_recommendation_samples(flatten_test_samples(&fixtures))\n        .with_memory_surface_records(flatten_memory_records(&fixtures))\n        .with_computed_at(latest_fixture_time(&fixtures));\n    let metrics = collector.collect(\n        MetricScope::session(\"benchmark-fixtures\"),\n        &MetricSignal::ALL,\n    );\n    let evidence = evidence_by_signal(&fixtures, path);\n    Ok(Some(BenchmarkEvidence { metrics, evidence }))\n}\n\nfn flatten_fixture_events(\n    fixtures: &[FixtureBenchmarkReport],\n) -> Vec<crate::events::EventEnvelope> {\n    let mut events = Vec::new();\n    for fixture in fixtures {\n        for (task_index, task) in fixture.task_reports.iter().enumerate() {\n            for (tool_index, tool) in task.tool_reports.iter().enumerate() {\n                let second = (task_index as i64 * 100) + tool_index as i64 + 1;\n                events.push(benchmark_tool_event(\n                    &fixture.fixture,\n                    &task.task_id,\n                    &tool.tool,\n                    second,\n                ));\n            }\n            let second_base = task_index as i64 * 100;\n            events.push(benchmark_file_read_event(\n                &fixture.fixture,\n                &task.task_id,\n                second_base + 30,\n            ));\n            events.push(benchmark_plan_event(\n                &fixture.fixture,\n                &task.task_id,\n                second_base + 40,\n            ));\n            events.push(benchmark_success_event(\n                &fixture.fixture,\n                &task.task_id,\n                second_base + 50,\n            ));\n        }\n    }\n    events\n}\n\nfn flatten_anchor_samples(fixtures: &[FixtureBenchmarkReport]) -> Vec<AnchorRecallSample> {\n    fixtures\n        .iter()\n        .flat_map(|fixture| {\n            fixture\n                .task_reports\n                .iter()\n                .enumerate()\n                .map(|(index, task)| AnchorRecallSample {\n                    scope: benchmark_scope(&fixture.fixture, &task.task_id, 100 + index as i64),\n                    golden_anchors: task.expected_anchors.clone(),\n                    returned_anchors: task.returned_anchors.clone(),\n                })\n        })\n        .collect()\n}\n\nfn flatten_test_samples(fixtures: &[FixtureBenchmarkReport]) -> Vec<TestRecommendationSample> {\n    fixtures\n        .iter()\n        .flat_map(|fixture| {\n            fixture\n                .task_reports\n                .iter()\n                .enumerate()\n                .map(|(index, task)| TestRecommendationSample {\n                    scope: benchmark_scope(&fixture.fixture, &task.task_id, 200 + index as i64),\n                    recommended_tests: task.recommended_tests.clone(),\n                    needed_tests: task.expected_tests.clone(),\n                })\n        })\n        .collect()\n}\n\nfn flatten_memory_records(fixtures: &[FixtureBenchmarkReport]) -> Vec<MemorySurfaceRecord> {\n    fixtures\n        .iter()\n        .flat_map(|fixture| {\n            fixture\n                .task_reports\n                .iter()\n                .enumerate()\n                .map(|(index, task)| MemorySurfaceRecord {\n                    scope: benchmark_scope(&fixture.fixture, &task.task_id, 300 + index as i64),\n                    retrieval_event_id: EventId {\n                        workspace_id: fixture.fixture.clone(),\n                        ulid: format!(\"evt-memory-{}\", task.task_id),\n                    },\n                    memory_id: MemoryId {\n                        workspace_id: fixture.fixture.clone(),\n                        ulid: format!(\"mem-{}\", task.task_id),\n                    },\n                    verification_status: VerificationStatus::Verified,\n                    stale_label_surfaced: false,\n                    contradiction_link_present: false,\n                    contradiction_surfaced: false,\n                    used_downstream: true,\n                    reused_later: true,\n                })\n        })\n        .collect()\n}\n\nfn latest_fixture_time(fixtures: &[FixtureBenchmarkReport]) -> DateTime<Utc> {\n    fixtures\n        .iter()\n        .flat_map(|fixture| fixture.metrics.iter().map(|metric| metric.computed_at))\n        .max_by_key(|value| value.unix_seconds())\n        .unwrap_or_else(Utc::now)\n}\n\nfn evidence_by_signal(\n    fixtures: &[FixtureBenchmarkReport],\n    benchmark_report_path: &Path,\n) -> HashMap<MetricSignal, Vec<SignalEvidencePointer>> {\n    let mut output = HashMap::<MetricSignal, Vec<SignalEvidencePointer>>::new();\n    for fixture in fixtures {\n        for task in &fixture.task_reports {\n            for (signal, source, event_labels, memory_labels, note) in signal_specs(task) {\n                let pointer = build_pointer(\n                    source,\n                    &fixture.fixture,\n                    &task.task_id,\n                    event_labels,\n                    memory_labels,\n                    benchmark_report_path,\n                    note,\n                );\n                output.entry(signal).or_default().push(pointer);\n            }\n        }\n    }\n    output\n}\n\nfn signal_specs<'a>(\n    task: &'a FixtureTaskReport,\n) -> Vec<(\n    MetricSignal,\n    MetricSource,\n    &'a [&'a str],\n    Vec<String>,\n    &'a str,\n)> {\n    let memory_id = format!(\"mem-{}\", task.task_id);\n    vec![\n        (\n            MetricSignal::ToolCallsPerSuccessfulTask,\n            MetricSource::EventLog,\n            &[\"evt-tool\", \"evt-plan\", \"evt-success\"],\n            Vec::new(),\n            \"benchmark task event sequence for discovery tool calls\",\n        ),\n        (\n            MetricSignal::IrrelevantFilesOpenedPerTask,\n            MetricSource::EventLog,\n            &[\"evt-noise-read\"],\n            Vec::new(),\n            \"benchmark sentinel irrelevant file read\",\n        ),\n        (\n            MetricSignal::RelevantAnchorRecall,\n            MetricSource::EventLog,\n            &[],\n            Vec::new(),\n            \"golden anchors compared with returned anchors\",\n        ),\n        (\n            MetricSignal::MemoryInclusionPrecision,\n            MetricSource::MemoryStore,\n            &[\"evt-memory\"],\n            vec![memory_id.clone()],\n            \"benchmark memory surfaced and used downstream\",\n        ),\n        (\n            MetricSignal::MemoryLaterUsedRate,\n            MetricSource::MemoryStore,\n            &[\"evt-memory\"],\n            vec![memory_id.clone()],\n            \"benchmark memory reuse sample\",\n        ),\n        (\n            MetricSignal::StaleMemorySurfacedRate,\n            MetricSource::Verifier,\n            &[],\n            vec![memory_id.clone()],\n            \"benchmark stale-label verification sample\",\n        ),\n        (\n            MetricSignal::ContradictionMissedRate,\n            MetricSource::Verifier,\n            &[],\n            vec![memory_id.clone()],\n            \"benchmark contradiction verification sample\",\n        ),\n        (\n            MetricSignal::TestsRecommendedVsNeeded,\n            MetricSource::WorkflowOutcome,\n            &[],\n            Vec::new(),\n            \"recommended tests compared with golden expected tests\",\n        ),\n        (\n            MetricSignal::WorkflowSuccessAfterFirstPlan,\n            MetricSource::WorkflowOutcome,\n            &[\"evt-plan\", \"evt-success\"],\n            Vec::new(),\n            \"benchmark planned task outcome\",\n        ),\n    ]\n}\n\nfn build_pointer(\n    source: MetricSource,\n    workspace_id: &str,\n    task_id: &str,\n    event_labels: &[&str],\n    memory_labels: Vec<String>,\n    benchmark_report_path: &Path,\n    note: &str,\n) -> SignalEvidencePointer {\n    SignalEvidencePointer {\n        source,\n        task_ids: vec![task_id.to_string()],\n        event_ids: event_labels\n            .iter()\n            .map(|label| EventId {\n                workspace_id: workspace_id.to_string(),\n                ulid: format!(\"{label}-{task_id}\"),\n            })\n            .collect(),\n        memory_ids: memory_labels\n            .into_iter()\n            .map(|label| MemoryId {\n                workspace_id: workspace_id.to_string(),\n                ulid: label,\n            })\n            .collect(),\n        benchmark_report_path: Some(benchmark_report_path.to_path_buf()),\n        note: note.to_string(),\n    }\n}\n\nfn benchmark_scope(workspace_id: &str, task_id: &str, second: i64) -> MetricSampleScope {\n    MetricSampleScope {\n        workspace_id: workspace_id.to_string(),\n        branch: Some(\"main\".to_string()),\n        session_id: Some(\"benchmark-fixtures\".to_string()),\n        user_id: None,\n        organization_id: None,\n        task_id: Some(task_id.to_string()),\n        observed_at: DateTime::from_unix_seconds(1_779_000_000 + second),\n    }\n}\n\nfn benchmark_tool_event(\n    workspace_id: &str,\n    task_id: &str,\n    tool_name: &str,\n    second: i64,\n) -> crate::events::EventEnvelope {\n    benchmark_event(\n        workspace_id,\n        task_id,\n        second,\n        crate::events::EventKind::ToolCalled,\n        crate::events::EventPayload::ToolCalled(crate::events::ToolCalledPayload {\n            call_id: format!(\"{task_id}-{tool_name}-{second}\"),\n            tool_name: tool_name.to_string(),\n            context_handle_id: None,\n            source_event_id: None,\n            input_summary: task_id.to_string(),\n        }),\n        &format!(\"evt-tool-{task_id}\"),\n    )\n}\n\nfn benchmark_file_read_event(\n    workspace_id: &str,\n    task_id: &str,\n    second: i64,\n) -> crate::events::EventEnvelope {\n    benchmark_event(\n        workspace_id,\n        task_id,\n        second,\n        crate::events::EventKind::FileRead,\n        crate::events::EventPayload::FileRead(crate::events::FileReadPayload {\n            file_id: crate::identity::FileId {\n                workspace_id: workspace_id.to_string(),\n                repo_relative_path: \"irrelevant/noise.rs\".to_string(),\n                content_hash: \"noise-hash\".to_string(),\n            },\n            source_event_id: None,\n            byte_start: None,\n            byte_end: None,\n            reason: \"benchmark irrelevant read sentinel\".to_string(),\n        }),\n        &format!(\"evt-noise-read-{task_id}\"),\n    )\n}\n\nfn benchmark_plan_event(\n    workspace_id: &str,\n    task_id: &str,\n    second: i64,\n) -> crate::events::EventEnvelope {\n    benchmark_event(\n        workspace_id,\n        task_id,\n        second,\n        crate::events::EventKind::PlanCreated,\n        crate::events::EventPayload::PlanCreated(crate::events::PlanCreatedPayload {\n            context_handle_id: None,\n            source_event_id: None,\n            memory_ids: Vec::new(),\n            step_count: 3,\n            plan_summary: task_id.to_string(),\n        }),\n        &format!(\"evt-plan-{task_id}\"),\n    )\n}\n\nfn benchmark_success_event(\n    workspace_id: &str,\n    task_id: &str,\n    second: i64,\n) -> crate::events::EventEnvelope {\n    benchmark_event(\n        workspace_id,\n        task_id,\n        second,\n        crate::events::EventKind::WorkflowSucceeded,\n        crate::events::EventPayload::WorkflowSucceeded(crate::events::WorkflowSucceededPayload {\n            workflow_name: \"cognitive_workspace_benchmark\".to_string(),\n            terminal_event_id: None,\n            output_context_handle_id: None,\n            memory_ids: vec![MemoryId {\n                workspace_id: workspace_id.to_string(),\n                ulid: format!(\"mem-{task_id}\"),\n            }],\n            result_summary: task_id.to_string(),\n        }),\n        &format!(\"evt-success-{task_id}\"),\n    )\n}\n\nfn benchmark_event(\n    workspace_id: &str,\n    task_id: &str,\n    second: i64,\n    kind: crate::events::EventKind,\n    payload: crate::events::EventPayload,\n    event_ulid: &str,\n) -> crate::events::EventEnvelope {\n    crate::events::EventEnvelope::new(\n        EventId {\n            workspace_id: workspace_id.to_string(),\n            ulid: event_ulid.to_string(),\n        },\n        workspace_id.to_string(),\n        crate::events::BranchRef {\n            name: \"main\".to_string(),\n        },\n        crate::events::SessionId {\n            value: \"benchmark-fixtures\".to_string(),\n        },\n        Some(crate::events::TaskId {\n            value: task_id.to_string(),\n        }),\n        crate::events::Actor::Assistant {\n            model: \"benchmark\".to_string(),\n        },\n        DateTime::from_unix_seconds(1_779_000_000 + second),\n        kind,\n        Vec::new(),\n        crate::events::PayloadHash::new([second as u8; 32]),\n        crate::events::CompactSummary::new(format!(\"{task_id}-{second}\")).expect(\"compact summary\"),\n        crate::events::PayloadLocation::Inline { bytes_len: 64 },\n        payload,\n    )\n    .expect(\"benchmark event envelope\")\n}\n","numLines":452,"startLine":1,"totalLines":452}}}
