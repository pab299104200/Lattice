{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019341QnncgXbCg6SjTxBUhJ","type":"tool_result","content":"1\t//! Phase 9 regression reporting for operators and CI.\n2\t//!\n3\t//! This module implements the report surface required by\n4\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## Phase 9: Metrics And Evaluation` and\n6\t//! `## Measurable Success Criteria`.\n7\t\n8\tuse std::collections::HashMap;\n9\tuse std::fmt::Write as _;\n10\tuse std::path::{Path, PathBuf};\n11\t\n12\tuse serde::{Deserialize, Serialize};\n13\tuse thiserror::Error;\n14\t\n15\tuse crate::identity::{EventId, MemoryId};\n16\tuse crate::metrics::{MetricScope, MetricSignal, MetricSource, MetricValue};\n17\tuse crate::{DateTime, Utc};\n18\t\n19\t#[derive(Debug, Clone, Serialize, Deserialize)]\n20\tpub struct ReportInput {\n21\t    pub current: Vec<MetricValue>,\n22\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n23\t    pub baseline: Option<Vec<MetricValue>>,\n24\t    pub benchmark_report_path: PathBuf,\n25\t    pub scope: MetricScope,\n26\t    pub success_criteria: SuccessCriteriaThresholds,\n27\t}\n28\t\n29\t#[derive(Debug, Clone, Copy, PartialEq, Serialize, Deserialize)]\n30\tpub struct SuccessCriteriaThresholds {\n31\t    pub discovery_tool_calls_reduction: f64,\n32\t    pub irrelevant_file_reads_reduction: f64,\n33\t    pub memory_inclusion_precision: f64,\n34\t    pub contradiction_missed_rate: f64,\n35\t    pub stale_memory_unlabeled_rate: f64,\n36\t    pub tests_recommended_vs_needed: f64,\n37\t}\n38\t\n39\timpl SuccessCriteriaThresholds {\n40\t    pub fn initial() -> Self {\n41\t        Self {\n42\t            discovery_tool_calls_reduction: 0.30,\n43\t            irrelevant_file_reads_reduction: 0.40,\n44\t            memory_inclusion_precision: 0.80,\n45\t            contradiction_missed_rate: 0.0,\n46\t            stale_memory_unlabeled_rate: 0.0,\n47\t            tests_recommended_vs_needed: 0.90,\n48\t        }\n49\t    }\n50\t}\n51\t\n52\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n53\t#[serde(rename_all = \"snake_case\")]\n54\tpub enum ReportRowStatus {\n55\t    Pass,\n56\t    Fail,\n57\t    MissingData,\n58\t    NotApplicable,\n59\t}\n60\t\n61\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n62\tpub struct SignalDelta {\n63\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n64\t    pub absolute: Option<f64>,\n65\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n66\t    pub reduction_ratio: Option<f64>,\n67\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n68\t    pub description: Option<String>,\n69\t}\n70\t\n71\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n72\tpub struct SignalEvidencePointer {\n73\t    pub source: MetricSource,\n74\t    #[serde(default)]\n75\t    pub task_ids: Vec<String>,\n76\t    #[serde(default)]\n77\t    pub event_ids: Vec<EventId>,\n78\t    #[serde(default)]\n79\t    pub memory_ids: Vec<MemoryId>,\n80\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n81\t    pub benchmark_report_path: Option<PathBuf>,\n82\t    pub note: String,\n83\t}\n84\t\n85\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n86\tpub struct RegressionReportRow {\n87\t    pub signal: MetricSignal,\n88\t    pub current: MetricValue,\n89\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n90\t    pub baseline: Option<MetricValue>,\n91\t    pub delta: SignalDelta,\n92\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n93\t    pub target: Option<String>,\n94\t    pub status: ReportRowStatus,\n95\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n96\t    pub evaluation_reason: Option<String>,\n97\t    #[serde(default)]\n98\t    pub evidence: Vec<SignalEvidencePointer>,\n99\t}\n100\t\n101\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n102\tpub struct RegressionReport {\n103\t    pub scope: MetricScope,\n104\t    pub success_criteria: SuccessCriteriaThresholds,\n105\t    pub rows: Vec<RegressionReportRow>,\n106\t    pub benchmark_report_path: PathBuf,\n107\t    pub generated_at: DateTime<Utc>,\n108\t    pub pass_count: usize,\n109\t    pub fail_count: usize,\n110\t    pub missing_count: usize,\n111\t    pub not_applicable_count: usize,\n112\t}\n113\t\n114\t#[derive(Debug, Clone)]\n115\tpub struct BenchmarkEvidence {\n116\t    pub(crate) metrics: Vec<MetricValue>,\n117\t    pub(crate) evidence: HashMap<MetricSignal, Vec<SignalEvidencePointer>>,\n118\t}\n119\t\n120\t#[derive(Debug, Error)]\n121\tpub enum ReportError {\n122\t    #[error(\"failed to read benchmark report at {path}: {source}\")]\n123\t    ReadBenchmark {\n124\t        path: PathBuf,\n125\t        source: std::io::Error,\n126\t    },\n127\t    #[error(\"failed to parse benchmark report at {path}: {source}\")]\n128\t    ParseBenchmark {\n129\t        path: PathBuf,\n130\t        source: serde_json::Error,\n131\t    },\n132\t}\n133\t\n134\timpl BenchmarkEvidence {\n135\t    pub fn from_path(path: &Path) -> Result<Option<Self>, ReportError> {\n136\t        super::report_benchmark::load_benchmark_evidence(path)\n137\t    }\n138\t\n139\t    pub fn metrics(&self) -> &[MetricValue] {\n140\t        &self.metrics\n141\t    }\n142\t\n143\t    pub fn evidence_for(&self, signal: MetricSignal) -> Vec<SignalEvidencePointer> {\n144\t        self.evidence.get(&signal).cloned().unwrap_or_default()\n145\t    }\n146\t}\n147\t\n148\timpl RegressionReport {\n149\t    pub fn build(input: ReportInput) -> Result<Self, ReportError> {\n150\t        let benchmark = BenchmarkEvidence::from_path(&input.benchmark_report_path)?;\n151\t        let current = merge_missing_current_metrics(input.current, benchmark.as_ref());\n152\t        let baseline_map = baseline_map(input.baseline.as_deref());\n153\t        let current_map = current_map(&current);\n154\t        let generated_at = latest_metric_time(&current);\n155\t        let rows = MetricSignal::ALL\n156\t            .iter()\n157\t            .copied()\n158\t            .map(|signal| {\n159\t                build_row(\n160\t                    signal,\n161\t                    current_map.get(&signal).cloned().unwrap_or_else(|| {\n162\t                        missing_metric(signal, benchmark_source(signal), generated_at)\n163\t                    }),\n164\t                    baseline_map.get(&signal).cloned(),\n165\t                    &input.success_criteria,\n166\t                    benchmark.as_ref(),\n167\t                )\n168\t            })\n169\t            .collect::<Vec<_>>();\n170\t        Ok(finalize_report(\n171\t            input.scope,\n172\t            input.success_criteria,\n173\t            rows,\n174\t            input.benchmark_report_path,\n175\t            generated_at,\n176\t        ))\n177\t    }\n178\t\n179\t    pub fn render_text(&self) -> String {\n180\t        let mut output = String::new();\n181\t        let _ = writeln!(\n182\t            output,\n183\t            \"Phase 9 regression report ({})\",\n184\t            self.scope.kind_label()\n185\t        );\n186\t        let _ = writeln!(\n187\t            output,\n188\t            \"pass={} fail={} missing={} n/a={}\",\n189\t            self.pass_count, self.fail_count, self.missing_count, self.not_applicable_count\n190\t        );\n191\t        let _ = writeln!(\n192\t            output,\n193\t            \"signal | current | baseline | delta | target | status\"\n194\t        );\n195\t        for row in &self.rows {\n196\t            let _ = writeln!(\n197\t                output,\n198\t                \"{} | {} | {} | {} | {} | {}\",\n199\t                row.signal.as_str(),\n200\t                format_metric_value(&row.current),\n201\t                row.baseline\n202\t                    .as_ref()\n203\t                    .map(format_metric_value)\n204\t                    .unwrap_or_else(|| \"n/a\".to_string()),\n205\t                format_delta(&row.delta),\n206\t                row.target.clone().unwrap_or_else(|| \"n/a\".to_string()),\n207\t                status_label(&row.status),\n208\t            );\n209\t            if let Some(reason) = &row.evaluation_reason {\n210\t                let _ = writeln!(output, \"  reason: {reason}\");\n211\t            }\n212\t            if !row.evidence.is_empty() {\n213\t                let _ = writeln!(\n214\t                    output,\n215\t                    \"  evidence: {}\",\n216\t                    render_evidence_digest(&row.evidence)\n217\t                );\n218\t            }\n219\t        }\n220\t        output\n221\t    }\n222\t\n223\t    pub fn render_json(&self) -> Result<String, serde_json::Error> {\n224\t        serde_json::to_string_pretty(self)\n225\t    }\n226\t\n227\t    pub fn render_ci_summary(&self) -> String {\n228\t        let failed = self\n229\t            .rows\n230\t            .iter()\n231\t            .filter(|row| row.status == ReportRowStatus::Fail)\n232\t            .map(|row| row.signal.as_str())\n233\t            .collect::<Vec<_>>()\n234\t            .join(\",\");\n235\t        format!(\n236\t            \"scope={} pass={} fail={} missing={} not_applicable={} failed_signals={}\",\n237\t            self.scope.kind_label(),\n238\t            self.pass_count,\n239\t            self.fail_count,\n240\t            self.missing_count,\n241\t            self.not_applicable_count,\n242\t            if failed.is_empty() { \"none\" } else { &failed }\n243\t        )\n244\t    }\n245\t}\n246\t\n247\tpub fn merge_missing_current_metrics(\n248\t    current: Vec<MetricValue>,\n249\t    benchmark: Option<&BenchmarkEvidence>,\n250\t) -> Vec<MetricValue> {\n251\t    let Some(benchmark) = benchmark else {\n252\t        return current;\n253\t    };\n254\t    let benchmark_map = current_map(benchmark.metrics());\n255\t    MetricSignal::ALL\n256\t        .iter()\n257\t        .copied()\n258\t        .map(|signal| {\n259\t            let current_value = current\n260\t                .iter()\n261\t                .find(|value| value.signal == signal)\n262\t                .cloned()\n263\t                .or_else(|| benchmark_map.get(&signal).cloned());\n264\t            match current_value {\n265\t                Some(value) if value.value.is_some() => value,\n266\t                Some(value) => benchmark_map\n267\t                    .get(&signal)\n268\t                    .cloned()\n269\t                    .filter(|candidate| candidate.value.is_some())\n270\t                    .unwrap_or(value),\n271\t                None => benchmark_map.get(&signal).cloned().unwrap_or_else(|| {\n272\t                    missing_metric(signal, benchmark_source(signal), Utc::now())\n273\t                }),\n274\t            }\n275\t        })\n276\t        .collect()\n277\t}\n278\t\n279\tpub fn report_exit_code(report: &RegressionReport, fail_on_regression: bool) -> i32 {\n280\t    if fail_on_regression && report.fail_count > 0 {\n281\t        1\n282\t    } else {\n283\t        0\n284\t    }\n285\t}\n286\t\n287\tfn build_row(\n288\t    signal: MetricSignal,\n289\t    current: MetricValue,\n290\t    baseline: Option<MetricValue>,\n291\t    thresholds: &SuccessCriteriaThresholds,\n292\t    benchmark: Option<&BenchmarkEvidence>,\n293\t) -> RegressionReportRow {\n294\t    let delta = compute_delta(\n295\t        current.value,\n296\t        baseline.as_ref().and_then(|value| value.value),\n297\t    );\n298\t    let (target, status, evaluation_reason) =\n299\t        evaluate_signal(signal, &current, baseline.as_ref(), &delta, thresholds);\n300\t    let evidence = benchmark\n301\t        .map(|value| value.evidence_for(signal))\n302\t        .unwrap_or_default();\n303\t    RegressionReportRow {\n304\t        signal,\n305\t        current,\n306\t        baseline,\n307\t        delta,\n308\t        target,\n309\t        status,\n310\t        evaluation_reason,\n311\t        evidence,\n312\t    }\n313\t}\n314\t\n315\tfn evaluate_signal(\n316\t    signal: MetricSignal,\n317\t    current: &MetricValue,\n318\t    baseline: Option<&MetricValue>,\n319\t    delta: &SignalDelta,\n320\t    thresholds: &SuccessCriteriaThresholds,\n321\t) -> (Option<String>, ReportRowStatus, Option<String>) {\n322\t    match signal {\n323\t        MetricSignal::ToolCallsPerSuccessfulTask => evaluate_reduction(\n324\t            current,\n325\t            baseline,\n326\t            delta,\n327\t            thresholds.discovery_tool_calls_reduction,\n328\t            \">=30% reduction from baseline\",\n329\t        ),\n330\t        MetricSignal::IrrelevantFilesOpenedPerTask => evaluate_reduction(\n331\t            current,\n332\t            baseline,\n333\t            delta,\n334\t            thresholds.irrelevant_file_reads_reduction,\n335\t            \">=40% reduction from baseline\",\n336\t        ),\n337\t        MetricSignal::MemoryInclusionPrecision => evaluate_minimum(\n338\t            current,\n339\t            thresholds.memory_inclusion_precision,\n340\t            \">=0.80 precision\",\n341\t        ),\n342\t        MetricSignal::ContradictionMissedRate => evaluate_maximum(\n343\t            current,\n344\t            thresholds.contradiction_missed_rate,\n345\t            \"=0 contradicted memories surfaced as trusted\",\n346\t        ),\n347\t        MetricSignal::StaleMemorySurfacedRate => evaluate_maximum(\n348\t            current,\n349\t            thresholds.stale_memory_unlabeled_rate,\n350\t            \"=0 stale memories surfaced without stale label\",\n351\t        ),\n352\t        MetricSignal::TestsRecommendedVsNeeded => evaluate_minimum(\n353\t            current,\n354\t            thresholds.tests_recommended_vs_needed,\n355\t            \">=0.90 test recommendation recall\",\n356\t        ),\n357\t        MetricSignal::RelevantAnchorRecall\n358\t        | MetricSignal::MemoryLaterUsedRate\n359\t        | MetricSignal::WorkflowSuccessAfterFirstPlan => (\n360\t            None,\n361\t            if current.value.is_some() {\n362\t                ReportRowStatus::NotApplicable\n363\t            } else {\n364\t                ReportRowStatus::MissingData\n365\t            },\n366\t            current.reason_if_null.clone().or_else(|| {\n367\t                Some(\"spec does not define an initial threshold for this signal\".to_string())\n368\t            }),\n369\t        ),\n370\t    }\n371\t}\n372\t\n373\tfn evaluate_reduction(\n374\t    current: &MetricValue,\n375\t    baseline: Option<&MetricValue>,\n376\t    delta: &SignalDelta,\n377\t    threshold: f64,\n378\t    label: &str,\n379\t) -> (Option<String>, ReportRowStatus, Option<String>) {\n380\t    let target = Some(format!(\"{label} ({:.0}%)\", threshold * 100.0));\n381\t    match (\n382\t        current.value,\n383\t        baseline.and_then(|value| value.value),\n384\t        delta.reduction_ratio,\n385\t    ) {\n386\t        (None, _, _) => (\n387\t            target,\n388\t            ReportRowStatus::MissingData,\n389\t            current.reason_if_null.clone(),\n390\t        ),\n391\t        (Some(_), None, _) => (\n392\t            target,\n393\t            ReportRowStatus::MissingData,\n394\t            Some(\"baseline value is unavailable\".to_string()),\n395\t        ),\n396\t        (Some(_), Some(_), Some(reduction)) => (\n397\t            target,\n398\t            if reduction >= threshold {\n399\t                ReportRowStatus::Pass\n400\t            } else {\n401\t                ReportRowStatus::Fail\n402\t            },\n403\t            Some(format!(\"observed reduction {:.2}%\", reduction * 100.0)),\n404\t        ),\n405\t        _ => (\n406\t            target,\n407\t            ReportRowStatus::MissingData,\n408\t            Some(\"reduction could not be computed\".to_string()),\n409\t        ),\n410\t    }\n411\t}\n412\t\n413\tfn evaluate_minimum(\n414\t    current: &MetricValue,\n415\t    threshold: f64,\n416\t    label: &str,\n417\t) -> (Option<String>, ReportRowStatus, Option<String>) {\n418\t    let target = Some(format!(\"{label} ({threshold:.2})\"));\n419\t    match current.value {\n420\t        Some(value) => (\n421\t            target,\n422\t            if value >= threshold {\n423\t                ReportRowStatus::Pass\n424\t            } else {\n425\t                ReportRowStatus::Fail\n426\t            },\n427\t            Some(format!(\"observed value {value:.4}\")),\n428\t        ),\n429\t        None => (\n430\t            target,\n431\t            ReportRowStatus::MissingData,\n432\t            current.reason_if_null.clone(),\n433\t        ),\n434\t    }\n435\t}\n436\t\n437\tfn evaluate_maximum(\n438\t    current: &MetricValue,\n439\t    threshold: f64,\n440\t    label: &str,\n441\t) -> (Option<String>, ReportRowStatus, Option<String>) {\n442\t    let target = Some(format!(\"{label} ({threshold:.2})\"));\n443\t    match current.value {\n444\t        Some(value) => (\n445\t            target,\n446\t            if value <= threshold {\n447\t                ReportRowStatus::Pass\n448\t            } else {\n449\t                ReportRowStatus::Fail\n450\t            },\n451\t            Some(format!(\"observed value {value:.4}\")),\n452\t        ),\n453\t        None => (\n454\t            target,\n455\t            ReportRowStatus::MissingData,\n456\t            current.reason_if_null.clone(),\n457\t        ),\n458\t    }\n459\t}\n460\t\n461\tfn compute_delta(current: Option<f64>, baseline: Option<f64>) -> SignalDelta {\n462\t    match (current, baseline) {\n463\t        (Some(current), Some(baseline)) => SignalDelta {\n464\t            absolute: Some(current - baseline),\n465\t            reduction_ratio: if baseline.abs() > f64::EPSILON {\n466\t                Some((baseline - current) / baseline)\n467\t            } else {\n468\t                None\n469\t            },\n470\t            description: Some(format!(\"current={current:.4}, baseline={baseline:.4}\")),\n471\t        },\n472\t        (Some(current), None) => SignalDelta {\n473\t            absolute: None,\n474\t            reduction_ratio: None,\n475\t            description: Some(format!(\"current only ({current:.4})\")),\n476\t        },\n477\t        (None, Some(baseline)) => SignalDelta {\n478\t            absolute: None,\n479\t            reduction_ratio: None,\n480\t            description: Some(format!(\"baseline only ({baseline:.4})\")),\n481\t        },\n482\t        (None, None) => SignalDelta {\n483\t            absolute: None,\n484\t            reduction_ratio: None,\n485\t            description: Some(\"neither current nor baseline is available\".to_string()),\n486\t        },\n487\t    }\n488\t}\n489\t\n490\tfn baseline_map(values: Option<&[MetricValue]>) -> HashMap<MetricSignal, MetricValue> {\n491\t    values\n492\t        .unwrap_or(&[])\n493\t        .iter()\n494\t        .map(|value| (value.signal, value.clone()))\n495\t        .collect()\n496\t}\n497\t\n498\tfn current_map(values: &[MetricValue]) -> HashMap<MetricSignal, MetricValue> {\n499\t    values\n500\t        .iter()\n501\t        .map(|value| (value.signal, value.clone()))\n502\t        .collect()\n503\t}\n504\t\n505\tfn latest_metric_time(values: &[MetricValue]) -> DateTime<Utc> {\n506\t    values\n507\t        .iter()\n508\t        .map(|value| value.computed_at)\n509\t        .max_by_key(|value| value.unix_seconds())\n510\t        .unwrap_or_else(Utc::now)\n511\t}\n512\t\n513\tfn finalize_report(\n514\t    scope: MetricScope,\n515\t    success_criteria: SuccessCriteriaThresholds,\n516\t    rows: Vec<RegressionReportRow>,\n517\t    benchmark_report_path: PathBuf,\n518\t    generated_at: DateTime<Utc>,\n519\t) -> RegressionReport {\n520\t    let pass_count = rows\n521\t        .iter()\n522\t        .filter(|row| row.status == ReportRowStatus::Pass)\n523\t        .count();\n524\t    let fail_count = rows\n525\t        .iter()\n526\t        .filter(|row| row.status == ReportRowStatus::Fail)\n527\t        .count();\n528\t    let missing_count = rows\n529\t        .iter()\n530\t        .filter(|row| row.status == ReportRowStatus::MissingData)\n531\t        .count();\n532\t    let not_applicable_count = rows\n533\t        .iter()\n534\t        .filter(|row| row.status == ReportRowStatus::NotApplicable)\n535\t        .count();\n536\t    RegressionReport {\n537\t        scope,\n538\t        success_criteria,\n539\t        rows,\n540\t        benchmark_report_path,\n541\t        generated_at,\n542\t        pass_count,\n543\t        fail_count,\n544\t        missing_count,\n545\t        not_applicable_count,\n546\t    }\n547\t}\n548\t\n549\tfn format_metric_value(value: &MetricValue) -> String {\n550\t    match value.value {\n551\t        Some(number) => format!(\"{number:.4}\"),\n552\t        None => {\n553\t            let reason = value\n554\t                .reason_if_null\n555\t                .clone()\n556\t                .unwrap_or_else(|| \"missing\".to_string());\n557\t            format!(\"n/a ({reason})\")\n558\t        }\n559\t    }\n560\t}\n561\t\n562\tfn format_delta(delta: &SignalDelta) -> String {\n563\t    match (delta.absolute, delta.reduction_ratio) {\n564\t        (Some(absolute), Some(reduction_ratio)) => {\n565\t            format!(\"{absolute:.4} ({:.2}% reduction)\", reduction_ratio * 100.0)\n566\t        }\n567\t        (Some(absolute), None) => format!(\"{absolute:.4}\"),\n568\t        _ => delta\n569\t            .description\n570\t            .clone()\n571\t            .unwrap_or_else(|| \"n/a\".to_string()),\n572\t    }\n573\t}\n574\t\n575\tfn render_evidence_digest(evidence: &[SignalEvidencePointer]) -> String {\n576\t    evidence\n577\t        .iter()\n578\t        .map(|pointer| {\n579\t            let mut parts = Vec::new();\n580\t            if !pointer.task_ids.is_empty() {\n581\t                parts.push(format!(\"tasks={}\", pointer.task_ids.join(\",\")));\n582\t            }\n583\t            if !pointer.event_ids.is_empty() {\n584\t                parts.push(format!(\n585\t                    \"events={}\",\n586\t                    pointer\n587\t                        .event_ids\n588\t                        .iter()\n589\t                        .map(|id| id.ulid.as_str())\n590\t                        .collect::<Vec<_>>()\n591\t                        .join(\",\")\n592\t                ));\n593\t            }\n594\t            if !pointer.memory_ids.is_empty() {\n595\t                parts.push(format!(\n596\t                    \"memories={}\",\n597\t                    pointer\n598\t                        .memory_ids\n599\t                        .iter()\n600\t                        .map(|id| id.ulid.as_str())\n601\t                        .collect::<Vec<_>>()\n602\t                        .join(\",\")\n603\t                ));\n604\t            }\n605\t            parts.push(pointer.note.clone());\n606\t            parts.join(\" \")\n607\t        })\n608\t        .collect::<Vec<_>>()\n609\t        .join(\" | \")\n610\t}\n611\t\n612\tfn status_label(status: &ReportRowStatus) -> &'static str {\n613\t    match status {\n614\t        ReportRowStatus::Pass => \"pass\",\n615\t        ReportRowStatus::Fail => \"fail\",\n616\t        ReportRowStatus::MissingData => \"missing\",\n617\t        ReportRowStatus::NotApplicable => \"n/a\",\n618\t    }\n619\t}\n620\t\n621\tfn missing_metric(\n622\t    signal: MetricSignal,\n623\t    source: MetricSource,\n624\t    computed_at: DateTime<Utc>,\n625\t) -> MetricValue {\n626\t    MetricValue {\n627\t        signal,\n628\t        value: None,\n629\t        denominator: None,\n630\t        sample_count: 0,\n631\t        source,\n632\t        computed_at,\n633\t        incomplete: false,\n634\t        reason_if_null: Some(\"signal was not collected\".to_string()),\n635\t    }\n636\t}\n637\t\n638\tpub(crate) fn benchmark_source(signal: MetricSignal) -> MetricSource {\n639\t    match signal {\n640\t        MetricSignal::ToolCallsPerSuccessfulTask\n641\t        | MetricSignal::IrrelevantFilesOpenedPerTask\n642\t        | MetricSignal::RelevantAnchorRecall => MetricSource::EventLog,\n643\t        MetricSignal::MemoryInclusionPrecision | MetricSignal::MemoryLaterUsedRate => {\n644\t            MetricSource::MemoryStore\n645\t        }\n646\t        MetricSignal::StaleMemorySurfacedRate | MetricSignal::ContradictionMissedRate => {\n647\t            MetricSource::Verifier\n648\t        }\n649\t        MetricSignal::TestsRecommendedVsNeeded | MetricSignal::WorkflowSuccessAfterFirstPlan => {\n650\t            MetricSource::WorkflowOutcome\n651\t        }\n652\t    }\n653\t}\n654\t\n655\ttrait ScopeKindLabel {\n656\t    fn kind_label(&self) -> &'static str;\n657\t}\n658\t\n659\timpl ScopeKindLabel for MetricScope {\n660\t    fn kind_label(&self) -> &'static str {\n661\t        match self.kind {\n662\t            crate::metrics::MetricScopeKind::Session => \"session\",\n663\t            crate::metrics::MetricScopeKind::Branch => \"branch\",\n664\t            crate::metrics::MetricScopeKind::Repo => \"repo\",\n665\t            crate::metrics::MetricScopeKind::User => \"user\",\n666\t            crate::metrics::MetricScopeKind::Organization => \"organization\",\n667\t        }\n668\t    }\n669\t}\n670\t"}]},"parent_tool_use_id":null,"session_id":"dcdb14de-3541-4532-8220-c4c3ddb6207e","uuid":"cce5ede1-48e9-455c-8c48-2b9be29effff","timestamp":"2026-05-17T16:39:19.602Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/metrics/report.rs","content":"//! Phase 9 regression reporting for operators and CI.\n//!\n//! This module implements the report surface required by\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 9: Metrics And Evaluation` and\n//! `## Measurable Success Criteria`.\n\nuse std::collections::HashMap;\nuse std::fmt::Write as _;\nuse std::path::{Path, PathBuf};\n\nuse serde::{Deserialize, Serialize};\nuse thiserror::Error;\n\nuse crate::identity::{EventId, MemoryId};\nuse crate::metrics::{MetricScope, MetricSignal, MetricSource, MetricValue};\nuse crate::{DateTime, Utc};\n\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct ReportInput {\n    pub current: Vec<MetricValue>,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub baseline: Option<Vec<MetricValue>>,\n    pub benchmark_report_path: PathBuf,\n    pub scope: MetricScope,\n    pub success_criteria: SuccessCriteriaThresholds,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Serialize, Deserialize)]\npub struct SuccessCriteriaThresholds {\n    pub discovery_tool_calls_reduction: f64,\n    pub irrelevant_file_reads_reduction: f64,\n    pub memory_inclusion_precision: f64,\n    pub contradiction_missed_rate: f64,\n    pub stale_memory_unlabeled_rate: f64,\n    pub tests_recommended_vs_needed: f64,\n}\n\nimpl SuccessCriteriaThresholds {\n    pub fn initial() -> Self {\n        Self {\n            discovery_tool_calls_reduction: 0.30,\n            irrelevant_file_reads_reduction: 0.40,\n            memory_inclusion_precision: 0.80,\n            contradiction_missed_rate: 0.0,\n            stale_memory_unlabeled_rate: 0.0,\n            tests_recommended_vs_needed: 0.90,\n        }\n    }\n}\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum ReportRowStatus {\n    Pass,\n    Fail,\n    MissingData,\n    NotApplicable,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct SignalDelta {\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub absolute: Option<f64>,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub reduction_ratio: Option<f64>,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub description: Option<String>,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct SignalEvidencePointer {\n    pub source: MetricSource,\n    #[serde(default)]\n    pub task_ids: Vec<String>,\n    #[serde(default)]\n    pub event_ids: Vec<EventId>,\n    #[serde(default)]\n    pub memory_ids: Vec<MemoryId>,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub benchmark_report_path: Option<PathBuf>,\n    pub note: String,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct RegressionReportRow {\n    pub signal: MetricSignal,\n    pub current: MetricValue,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub baseline: Option<MetricValue>,\n    pub delta: SignalDelta,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub target: Option<String>,\n    pub status: ReportRowStatus,\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub evaluation_reason: Option<String>,\n    #[serde(default)]\n    pub evidence: Vec<SignalEvidencePointer>,\n}\n\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct RegressionReport {\n    pub scope: MetricScope,\n    pub success_criteria: SuccessCriteriaThresholds,\n    pub rows: Vec<RegressionReportRow>,\n    pub benchmark_report_path: PathBuf,\n    pub generated_at: DateTime<Utc>,\n    pub pass_count: usize,\n    pub fail_count: usize,\n    pub missing_count: usize,\n    pub not_applicable_count: usize,\n}\n\n#[derive(Debug, Clone)]\npub struct BenchmarkEvidence {\n    pub(crate) metrics: Vec<MetricValue>,\n    pub(crate) evidence: HashMap<MetricSignal, Vec<SignalEvidencePointer>>,\n}\n\n#[derive(Debug, Error)]\npub enum ReportError {\n    #[error(\"failed to read benchmark report at {path}: {source}\")]\n    ReadBenchmark {\n        path: PathBuf,\n        source: std::io::Error,\n    },\n    #[error(\"failed to parse benchmark report at {path}: {source}\")]\n    ParseBenchmark {\n        path: PathBuf,\n        source: serde_json::Error,\n    },\n}\n\nimpl BenchmarkEvidence {\n    pub fn from_path(path: &Path) -> Result<Option<Self>, ReportError> {\n        super::report_benchmark::load_benchmark_evidence(path)\n    }\n\n    pub fn metrics(&self) -> &[MetricValue] {\n        &self.metrics\n    }\n\n    pub fn evidence_for(&self, signal: MetricSignal) -> Vec<SignalEvidencePointer> {\n        self.evidence.get(&signal).cloned().unwrap_or_default()\n    }\n}\n\nimpl RegressionReport {\n    pub fn build(input: ReportInput) -> Result<Self, ReportError> {\n        let benchmark = BenchmarkEvidence::from_path(&input.benchmark_report_path)?;\n        let current = merge_missing_current_metrics(input.current, benchmark.as_ref());\n        let baseline_map = baseline_map(input.baseline.as_deref());\n        let current_map = current_map(&current);\n        let generated_at = latest_metric_time(&current);\n        let rows = MetricSignal::ALL\n            .iter()\n            .copied()\n            .map(|signal| {\n                build_row(\n                    signal,\n                    current_map.get(&signal).cloned().unwrap_or_else(|| {\n                        missing_metric(signal, benchmark_source(signal), generated_at)\n                    }),\n                    baseline_map.get(&signal).cloned(),\n                    &input.success_criteria,\n                    benchmark.as_ref(),\n                )\n            })\n            .collect::<Vec<_>>();\n        Ok(finalize_report(\n            input.scope,\n            input.success_criteria,\n            rows,\n            input.benchmark_report_path,\n            generated_at,\n        ))\n    }\n\n    pub fn render_text(&self) -> String {\n        let mut output = String::new();\n        let _ = writeln!(\n            output,\n            \"Phase 9 regression report ({})\",\n            self.scope.kind_label()\n        );\n        let _ = writeln!(\n            output,\n            \"pass={} fail={} missing={} n/a={}\",\n            self.pass_count, self.fail_count, self.missing_count, self.not_applicable_count\n        );\n        let _ = writeln!(\n            output,\n            \"signal | current | baseline | delta | target | status\"\n        );\n        for row in &self.rows {\n            let _ = writeln!(\n                output,\n                \"{} | {} | {} | {} | {} | {}\",\n                row.signal.as_str(),\n                format_metric_value(&row.current),\n                row.baseline\n                    .as_ref()\n                    .map(format_metric_value)\n                    .unwrap_or_else(|| \"n/a\".to_string()),\n                format_delta(&row.delta),\n                row.target.clone().unwrap_or_else(|| \"n/a\".to_string()),\n                status_label(&row.status),\n            );\n            if let Some(reason) = &row.evaluation_reason {\n                let _ = writeln!(output, \"  reason: {reason}\");\n            }\n            if !row.evidence.is_empty() {\n                let _ = writeln!(\n                    output,\n                    \"  evidence: {}\",\n                    render_evidence_digest(&row.evidence)\n                );\n            }\n        }\n        output\n    }\n\n    pub fn render_json(&self) -> Result<String, serde_json::Error> {\n        serde_json::to_string_pretty(self)\n    }\n\n    pub fn render_ci_summary(&self) -> String {\n        let failed = self\n            .rows\n            .iter()\n            .filter(|row| row.status == ReportRowStatus::Fail)\n            .map(|row| row.signal.as_str())\n            .collect::<Vec<_>>()\n            .join(\",\");\n        format!(\n            \"scope={} pass={} fail={} missing={} not_applicable={} failed_signals={}\",\n            self.scope.kind_label(),\n            self.pass_count,\n            self.fail_count,\n            self.missing_count,\n            self.not_applicable_count,\n            if failed.is_empty() { \"none\" } else { &failed }\n        )\n    }\n}\n\npub fn merge_missing_current_metrics(\n    current: Vec<MetricValue>,\n    benchmark: Option<&BenchmarkEvidence>,\n) -> Vec<MetricValue> {\n    let Some(benchmark) = benchmark else {\n        return current;\n    };\n    let benchmark_map = current_map(benchmark.metrics());\n    MetricSignal::ALL\n        .iter()\n        .copied()\n        .map(|signal| {\n            let current_value = current\n                .iter()\n                .find(|value| value.signal == signal)\n                .cloned()\n                .or_else(|| benchmark_map.get(&signal).cloned());\n            match current_value {\n                Some(value) if value.value.is_some() => value,\n                Some(value) => benchmark_map\n                    .get(&signal)\n                    .cloned()\n                    .filter(|candidate| candidate.value.is_some())\n                    .unwrap_or(value),\n                None => benchmark_map.get(&signal).cloned().unwrap_or_else(|| {\n                    missing_metric(signal, benchmark_source(signal), Utc::now())\n                }),\n            }\n        })\n        .collect()\n}\n\npub fn report_exit_code(report: &RegressionReport, fail_on_regression: bool) -> i32 {\n    if fail_on_regression && report.fail_count > 0 {\n        1\n    } else {\n        0\n    }\n}\n\nfn build_row(\n    signal: MetricSignal,\n    current: MetricValue,\n    baseline: Option<MetricValue>,\n    thresholds: &SuccessCriteriaThresholds,\n    benchmark: Option<&BenchmarkEvidence>,\n) -> RegressionReportRow {\n    let delta = compute_delta(\n        current.value,\n        baseline.as_ref().and_then(|value| value.value),\n    );\n    let (target, status, evaluation_reason) =\n        evaluate_signal(signal, &current, baseline.as_ref(), &delta, thresholds);\n    let evidence = benchmark\n        .map(|value| value.evidence_for(signal))\n        .unwrap_or_default();\n    RegressionReportRow {\n        signal,\n        current,\n        baseline,\n        delta,\n        target,\n        status,\n        evaluation_reason,\n        evidence,\n    }\n}\n\nfn evaluate_signal(\n    signal: MetricSignal,\n    current: &MetricValue,\n    baseline: Option<&MetricValue>,\n    delta: &SignalDelta,\n    thresholds: &SuccessCriteriaThresholds,\n) -> (Option<String>, ReportRowStatus, Option<String>) {\n    match signal {\n        MetricSignal::ToolCallsPerSuccessfulTask => evaluate_reduction(\n            current,\n            baseline,\n            delta,\n            thresholds.discovery_tool_calls_reduction,\n            \">=30% reduction from baseline\",\n        ),\n        MetricSignal::IrrelevantFilesOpenedPerTask => evaluate_reduction(\n            current,\n            baseline,\n            delta,\n            thresholds.irrelevant_file_reads_reduction,\n            \">=40% reduction from baseline\",\n        ),\n        MetricSignal::MemoryInclusionPrecision => evaluate_minimum(\n            current,\n            thresholds.memory_inclusion_precision,\n            \">=0.80 precision\",\n        ),\n        MetricSignal::ContradictionMissedRate => evaluate_maximum(\n            current,\n            thresholds.contradiction_missed_rate,\n            \"=0 contradicted memories surfaced as trusted\",\n        ),\n        MetricSignal::StaleMemorySurfacedRate => evaluate_maximum(\n            current,\n            thresholds.stale_memory_unlabeled_rate,\n            \"=0 stale memories surfaced without stale label\",\n        ),\n        MetricSignal::TestsRecommendedVsNeeded => evaluate_minimum(\n            current,\n            thresholds.tests_recommended_vs_needed,\n            \">=0.90 test recommendation recall\",\n        ),\n        MetricSignal::RelevantAnchorRecall\n        | MetricSignal::MemoryLaterUsedRate\n        | MetricSignal::WorkflowSuccessAfterFirstPlan => (\n            None,\n            if current.value.is_some() {\n                ReportRowStatus::NotApplicable\n            } else {\n                ReportRowStatus::MissingData\n            },\n            current.reason_if_null.clone().or_else(|| {\n                Some(\"spec does not define an initial threshold for this signal\".to_string())\n            }),\n        ),\n    }\n}\n\nfn evaluate_reduction(\n    current: &MetricValue,\n    baseline: Option<&MetricValue>,\n    delta: &SignalDelta,\n    threshold: f64,\n    label: &str,\n) -> (Option<String>, ReportRowStatus, Option<String>) {\n    let target = Some(format!(\"{label} ({:.0}%)\", threshold * 100.0));\n    match (\n        current.value,\n        baseline.and_then(|value| value.value),\n        delta.reduction_ratio,\n    ) {\n        (None, _, _) => (\n            target,\n            ReportRowStatus::MissingData,\n            current.reason_if_null.clone(),\n        ),\n        (Some(_), None, _) => (\n            target,\n            ReportRowStatus::MissingData,\n            Some(\"baseline value is unavailable\".to_string()),\n        ),\n        (Some(_), Some(_), Some(reduction)) => (\n            target,\n            if reduction >= threshold {\n                ReportRowStatus::Pass\n            } else {\n                ReportRowStatus::Fail\n            },\n            Some(format!(\"observed reduction {:.2}%\", reduction * 100.0)),\n        ),\n        _ => (\n            target,\n            ReportRowStatus::MissingData,\n            Some(\"reduction could not be computed\".to_string()),\n        ),\n    }\n}\n\nfn evaluate_minimum(\n    current: &MetricValue,\n    threshold: f64,\n    label: &str,\n) -> (Option<String>, ReportRowStatus, Option<String>) {\n    let target = Some(format!(\"{label} ({threshold:.2})\"));\n    match current.value {\n        Some(value) => (\n            target,\n            if value >= threshold {\n                ReportRowStatus::Pass\n            } else {\n                ReportRowStatus::Fail\n            },\n            Some(format!(\"observed value {value:.4}\")),\n        ),\n        None => (\n            target,\n            ReportRowStatus::MissingData,\n            current.reason_if_null.clone(),\n        ),\n    }\n}\n\nfn evaluate_maximum(\n    current: &MetricValue,\n    threshold: f64,\n    label: &str,\n) -> (Option<String>, ReportRowStatus, Option<String>) {\n    let target = Some(format!(\"{label} ({threshold:.2})\"));\n    match current.value {\n        Some(value) => (\n            target,\n            if value <= threshold {\n                ReportRowStatus::Pass\n            } else {\n                ReportRowStatus::Fail\n            },\n            Some(format!(\"observed value {value:.4}\")),\n        ),\n        None => (\n            target,\n            ReportRowStatus::MissingData,\n            current.reason_if_null.clone(),\n        ),\n    }\n}\n\nfn compute_delta(current: Option<f64>, baseline: Option<f64>) -> SignalDelta {\n    match (current, baseline) {\n        (Some(current), Some(baseline)) => SignalDelta {\n            absolute: Some(current - baseline),\n            reduction_ratio: if baseline.abs() > f64::EPSILON {\n                Some((baseline - current) / baseline)\n            } else {\n                None\n            },\n            description: Some(format!(\"current={current:.4}, baseline={baseline:.4}\")),\n        },\n        (Some(current), None) => SignalDelta {\n            absolute: None,\n            reduction_ratio: None,\n            description: Some(format!(\"current only ({current:.4})\")),\n        },\n        (None, Some(baseline)) => SignalDelta {\n            absolute: None,\n            reduction_ratio: None,\n            description: Some(format!(\"baseline only ({baseline:.4})\")),\n        },\n        (None, None) => SignalDelta {\n            absolute: None,\n            reduction_ratio: None,\n            description: Some(\"neither current nor baseline is available\".to_string()),\n        },\n    }\n}\n\nfn baseline_map(values: Option<&[MetricValue]>) -> HashMap<MetricSignal, MetricValue> {\n    values\n        .unwrap_or(&[])\n        .iter()\n        .map(|value| (value.signal, value.clone()))\n        .collect()\n}\n\nfn current_map(values: &[MetricValue]) -> HashMap<MetricSignal, MetricValue> {\n    values\n        .iter()\n        .map(|value| (value.signal, value.clone()))\n        .collect()\n}\n\nfn latest_metric_time(values: &[MetricValue]) -> DateTime<Utc> {\n    values\n        .iter()\n        .map(|value| value.computed_at)\n        .max_by_key(|value| value.unix_seconds())\n        .unwrap_or_else(Utc::now)\n}\n\nfn finalize_report(\n    scope: MetricScope,\n    success_criteria: SuccessCriteriaThresholds,\n    rows: Vec<RegressionReportRow>,\n    benchmark_report_path: PathBuf,\n    generated_at: DateTime<Utc>,\n) -> RegressionReport {\n    let pass_count = rows\n        .iter()\n        .filter(|row| row.status == ReportRowStatus::Pass)\n        .count();\n    let fail_count = rows\n        .iter()\n        .filter(|row| row.status == ReportRowStatus::Fail)\n        .count();\n    let missing_count = rows\n        .iter()\n        .filter(|row| row.status == ReportRowStatus::MissingData)\n        .count();\n    let not_applicable_count = rows\n        .iter()\n        .filter(|row| row.status == ReportRowStatus::NotApplicable)\n        .count();\n    RegressionReport {\n        scope,\n        success_criteria,\n        rows,\n        benchmark_report_path,\n        generated_at,\n        pass_count,\n        fail_count,\n        missing_count,\n        not_applicable_count,\n    }\n}\n\nfn format_metric_value(value: &MetricValue) -> String {\n    match value.value {\n        Some(number) => format!(\"{number:.4}\"),\n        None => {\n            let reason = value\n                .reason_if_null\n                .clone()\n                .unwrap_or_else(|| \"missing\".to_string());\n            format!(\"n/a ({reason})\")\n        }\n    }\n}\n\nfn format_delta(delta: &SignalDelta) -> String {\n    match (delta.absolute, delta.reduction_ratio) {\n        (Some(absolute), Some(reduction_ratio)) => {\n            format!(\"{absolute:.4} ({:.2}% reduction)\", reduction_ratio * 100.0)\n        }\n        (Some(absolute), None) => format!(\"{absolute:.4}\"),\n        _ => delta\n            .description\n            .clone()\n            .unwrap_or_else(|| \"n/a\".to_string()),\n    }\n}\n\nfn render_evidence_digest(evidence: &[SignalEvidencePointer]) -> String {\n    evidence\n        .iter()\n        .map(|pointer| {\n            let mut parts = Vec::new();\n            if !pointer.task_ids.is_empty() {\n                parts.push(format!(\"tasks={}\", pointer.task_ids.join(\",\")));\n            }\n            if !pointer.event_ids.is_empty() {\n                parts.push(format!(\n                    \"events={}\",\n                    pointer\n                        .event_ids\n                        .iter()\n                        .map(|id| id.ulid.as_str())\n                        .collect::<Vec<_>>()\n                        .join(\",\")\n                ));\n            }\n            if !pointer.memory_ids.is_empty() {\n                parts.push(format!(\n                    \"memories={}\",\n                    pointer\n                        .memory_ids\n                        .iter()\n                        .map(|id| id.ulid.as_str())\n                        .collect::<Vec<_>>()\n                        .join(\",\")\n                ));\n            }\n            parts.push(pointer.note.clone());\n            parts.join(\" \")\n        })\n        .collect::<Vec<_>>()\n        .join(\" | \")\n}\n\nfn status_label(status: &ReportRowStatus) -> &'static str {\n    match status {\n        ReportRowStatus::Pass => \"pass\",\n        ReportRowStatus::Fail => \"fail\",\n        ReportRowStatus::MissingData => \"missing\",\n        ReportRowStatus::NotApplicable => \"n/a\",\n    }\n}\n\nfn missing_metric(\n    signal: MetricSignal,\n    source: MetricSource,\n    computed_at: DateTime<Utc>,\n) -> MetricValue {\n    MetricValue {\n        signal,\n        value: None,\n        denominator: None,\n        sample_count: 0,\n        source,\n        computed_at,\n        incomplete: false,\n        reason_if_null: Some(\"signal was not collected\".to_string()),\n    }\n}\n\npub(crate) fn benchmark_source(signal: MetricSignal) -> MetricSource {\n    match signal {\n        MetricSignal::ToolCallsPerSuccessfulTask\n        | MetricSignal::IrrelevantFilesOpenedPerTask\n        | MetricSignal::RelevantAnchorRecall => MetricSource::EventLog,\n        MetricSignal::MemoryInclusionPrecision | MetricSignal::MemoryLaterUsedRate => {\n            MetricSource::MemoryStore\n        }\n        MetricSignal::StaleMemorySurfacedRate | MetricSignal::ContradictionMissedRate => {\n            MetricSource::Verifier\n        }\n        MetricSignal::TestsRecommendedVsNeeded | MetricSignal::WorkflowSuccessAfterFirstPlan => {\n            MetricSource::WorkflowOutcome\n        }\n    }\n}\n\ntrait ScopeKindLabel {\n    fn kind_label(&self) -> &'static str;\n}\n\nimpl ScopeKindLabel for MetricScope {\n    fn kind_label(&self) -> &'static str {\n        match self.kind {\n            crate::metrics::MetricScopeKind::Session => \"session\",\n            crate::metrics::MetricScopeKind::Branch => \"branch\",\n            crate::metrics::MetricScopeKind::Repo => \"repo\",\n            crate::metrics::MetricScopeKind::User => \"user\",\n            crate::metrics::MetricScopeKind::Organization => \"organization\",\n        }\n    }\n}\n","numLines":670,"startLine":1,"totalLines":670}}}
