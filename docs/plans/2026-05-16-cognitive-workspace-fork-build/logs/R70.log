{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015a3piRcxwfs2EeGAUvxrmf","type":"tool_result","content":"1\tuse std::time::Duration;\n2\t\n3\tuse lattice_core::identity::{EventId, MemoryId};\n4\tuse lattice_core::metrics::{\n5\t    MemorySurfaceRecord, MetricSampleScope, MetricScope, MetricScopeKind, MetricSignal,\n6\t    MetricsCollector,\n7\t};\n8\tuse lattice_core::verification::VerificationStatus;\n9\tuse serde_json::json;\n10\t\n11\tuse super::context_cache::ContextHandleCache;\n12\tuse super::memory_v2::get_memory_metrics::{GetMemoryMetricsArgs, MetricRenderMode};\n13\tuse super::metrics_surface::{detail_payload, MetricsSurface, MetricsSurfaceError};\n14\tuse super::workflow_v2::{\n15\t    ContextItem, MemoryHighlight, Pivot, RenderChoice, StableIdentity, WorkflowBundle,\n16\t    WorkflowRecord,\n17\t};\n18\t\n19\t#[test]\n20\tfn serde_round_trip_preserves_surface_request_and_response() {\n21\t    let args = GetMemoryMetricsArgs {\n22\t        scope: Some(MetricScopeKind::Session),\n23\t        time_range: None,\n24\t        signals: MetricSignal::ALL.to_vec(),\n25\t        render_mode: Some(MetricRenderMode::Diagnostic),\n26\t    };\n27\t    let encoded = serde_json::to_string(&args).expect(\"serialize args\");\n28\t    let decoded: GetMemoryMetricsArgs = serde_json::from_str(&encoded).expect(\"deserialize args\");\n29\t    assert_eq!(decoded.signals, MetricSignal::ALL.to_vec());\n30\t\n31\t    let surface = fixture_surface();\n32\t    let report = surface.build_call_relevance_report(\n33\t        \"ctx-main\",\n34\t        \"prepare_change\",\n35\t        Some(\"session\".to_string()),\n36\t        &workflow_bundle_fixture(),\n37\t    );\n38\t    let encoded = serde_json::to_string(&report).expect(\"serialize report\");\n39\t    let decoded = serde_json::from_str::<super::metrics_surface::CallRelevanceReport>(&encoded)\n40\t        .expect(\"deserialize report\");\n41\t    assert_eq!(decoded.tool_name, \"prepare_change\");\n42\t    assert_eq!(decoded.pivots.len(), 1);\n43\t}\n44\t\n45\t#[test]\n46\tfn collect_returns_every_required_metric_signal_variant() {\n47\t    let surface = fixture_surface();\n48\t    let values = surface.collect(MetricScope::session(\"session-main\"), &MetricSignal::ALL);\n49\t    assert_eq!(values.len(), MetricSignal::ALL.len());\n50\t    let returned: Vec<MetricSignal> = values.iter().map(|value| value.signal).collect();\n51\t    assert_eq!(returned, MetricSignal::ALL.to_vec());\n52\t}\n53\t\n54\t#[test]\n55\tfn collect_reports_honest_null_with_reason_when_evidence_is_missing() {\n56\t    let surface = MetricsSurface::new(\"workspace-main\", MetricsCollector::new(), None);\n57\t    let values = surface.collect(\n58\t        MetricScope::session(\"session-main\"),\n59\t        &[MetricSignal::MemoryInclusionPrecision],\n60\t    );\n61\t    assert_eq!(values.len(), 1);\n62\t    assert_eq!(values[0].value, None);\n63\t    assert_eq!(values[0].sample_count, 0);\n64\t    assert!(values[0]\n65\t        .reason_if_null\n66\t        .as_deref()\n67\t        .is_some_and(|reason| reason.contains(\"no retrieved memories matched\")));\n68\t}\n69\t\n70\t#[test]\n71\tfn call_relevance_exposes_every_ranking_signal_column() {\n72\t    let bundle = workflow_bundle_fixture();\n73\t    let mut surface = fixture_surface();\n74\t    let report = surface.build_call_relevance_report(\n75\t        \"ctx-main\",\n76\t        \"prepare_change\",\n77\t        Some(\"session\".to_string()),\n78\t        &bundle,\n79\t    );\n80\t    surface.record_call(report);\n81\t    let restored = surface\n82\t        .collect_for_call(\"ctx-main\", \"prepare_change\")\n83\t        .expect(\"call report\");\n84\t    let payload = serde_json::to_value(&restored.pivots[0].breakdown).expect(\"serialize\");\n85\t    for key in [\n86\t        \"task_type_compatibility\",\n87\t        \"graph_proximity_to_anchors\",\n88\t        \"exact_identifier_match\",\n89\t        \"semantic_similarity\",\n90\t        \"verification_status\",\n91\t        \"freshness\",\n92\t        \"scope\",\n93\t        \"evidence_strength\",\n94\t        \"contradiction_supersession_state\",\n95\t        \"past_usefulness\",\n96\t        \"recent_successful_reuse\",\n97\t        \"user_preference_compatibility\",\n98\t        \"token_cost\",\n99\t    ] {\n100\t        assert!(\n101\t            payload[\"ranking_signals\"].get(key).is_some(),\n102\t            \"missing ranking signal column {key} in {payload:?}\"\n103\t        );\n104\t    }\n105\t}\n106\t\n107\t#[test]\n108\tfn compact_mode_digest_is_bounded() {\n109\t    let surface = fixture_surface();\n110\t    let report = surface.build_call_relevance_report(\n111\t        \"ctx-main\",\n112\t        \"prepare_change\",\n113\t        Some(\"session\".to_string()),\n114\t        &workflow_bundle_fixture(),\n115\t    );\n116\t    let digest = surface.summarize_for_compact_mode(&report.pivots[0].breakdown);\n117\t    assert!(\n118\t        digest.len() <= 160,\n119\t        \"digest exceeded bound: {}\",\n120\t        digest.len()\n121\t    );\n122\t}\n123\t\n124\t#[test]\n125\tfn diagnostic_expansion_handle_dereferences_to_full_breakdown() {\n126\t    let surface = fixture_surface();\n127\t    let report = surface.build_call_relevance_report(\n128\t        \"ctx-main\",\n129\t        \"prepare_change\",\n130\t        Some(\"session\".to_string()),\n131\t        &workflow_bundle_fixture(),\n132\t    );\n133\t    let mut cache = ContextHandleCache::new_with_limits(8, Duration::from_secs(60));\n134\t    let detail = detail_payload(\n135\t        &report.pivots[0].label,\n136\t        &report.pivots[0].pivot_key,\n137\t        \"pivot\",\n138\t        &report.pivots[0].inclusion_reason,\n139\t        &report.pivots[0].breakdown,\n140\t    );\n141\t    let handle = cache.insert(\n142\t        \"relevance_detail\",\n143\t        lattice_core::intelligence::ExpandContextSeed {\n144\t            query: Some(\"login\".to_string()),\n145\t            fil