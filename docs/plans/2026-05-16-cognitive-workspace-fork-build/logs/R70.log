;\n45\t    assert_eq!(\n46\t        row(&report, MetricSignal::MemoryInclusionPrecision).status,\n47\t        ReportRowStatus::Pass\n48\t    );\n49\t    assert_eq!(\n50\t        row(&report, MetricSignal::ContradictionMissedRate).status,\n51\t        ReportRowStatus::Pass\n52\t    );\n53\t    assert_eq!(\n54\t        row(&report, MetricSignal::StaleMemorySurfacedRate).status,\n55\t        ReportRowStatus::Pass\n56\t    );\n57\t    assert_eq!(\n58\t        row(&report, MetricSignal::TestsRecommendedVsNeeded).status,\n59\t        ReportRowStatus::Pass\n60\t    );\n61\t}\n62\t\n63\t#[test]\n64\tfn null_signals_render_as_na_with_reason_never_zero() {\n65\t    let report = RegressionReport::build(report_input()).expect(\"report builds\");\n66\t    let row = row(&report, MetricSignal::RelevantAnchorRecall);\n67\t    assert_eq!(row.current.value, None);\n68\t    assert_eq!(row.status, ReportRowStatus::MissingData);\n69\t    let text = report.render_text();\n70\t    assert!(text.contains(\"n/a (no benchmark or live evidence)\"));\n71\t}\n72\t\n73\t#[test]\n74\tfn fail_on_regression_exit_code_is_non_zero_only_when_requested() {\n75\t    let mut report = RegressionReport::build(report_input()).expect(\"report builds\");\n76\t    let tool_row = report\n77\t        .rows\n78\t        .iter_mut()\n79\t        .find(|entry| entry.signal == MetricSignal::ToolCallsPerSuccessfulTask)\n80\t        .expect(\"tool calls row\");\n81\t    tool_row.status = ReportRowStatus::Fail;\n82\t    report.fail_count = 1;\n83\t\n84\t    assert_eq!(report_exit_code(&report, false), 0);\n85\t    assert_eq!(report_exit_code(&report, true), 1);\n86\t}\n87\t\n88\t#[test]\n89\tfn benchmark_evidence_round_trips_to_signal_rows() {\n90\t    let path = write_benchmark_fixture();\n91\t    let evidence = BenchmarkEvidence::from_path(&path)\n92\t        .expect(\"benchmark parses\")\n93\t        .expect(\"benchmark exists\");\n94\t    let merged = merge_missing_current_metrics(Vec::new(), Some(&evidence));\n95\t    let report = RegressionReport::build(ReportInput {\n96\t        current: merged,\n97\t        baseline: Some(baseline_metrics()),\n98\t        benchmark_report_path: path.clone(),\n99\t        scope: MetricScope::session(\"session-report\"),\n100\t        success_criteria: SuccessCriteriaThresholds::initial(),\n101\t    })\n102\t    .expect(\"report builds\");\n103\t\n104\t    let row = row(&report, MetricSignal::TestsRecommendedVsNeeded);\n105\t    assert!(!row.evidence.is_empty());\n106\t    assert_eq!(row.evidence[0].task_ids, vec![\"task-alpha\".to_string()]);\n107\t    assert_eq!(row.evidence[0].benchmark_report_path.as_ref(), Some(&path));\n108\t}\n109\t\n110\tfn report_input() -> ReportInput {\n111\t    ReportInput {\n112\t        current: vec![\n113\t            metric(\n114\t                MetricSignal::ToolCallsPerSuccessfulTask,\n115\t                Some(3.0),\n116\t                MetricSource::EventLog,\n117\t            ),\n118\t            metric(\n119\t                MetricSignal::IrrelevantFilesOpenedPerTask,\n120\t                Some(0.5),\n121\t                MetricSource::EventLog,\n122\t            ),\n123\t            metric_null(\n124\t                MetricSignal::RelevantAnchorRecall,\n125\t                MetricSource::EventLog,\n126\t                \"no benchmark or live evidence\",\n127\t            ),\n128\t            metric(\n129\t                MetricSignal::MemoryInclusionPrecision,\n130\t                Some(0.85),\n131\t                MetricSource::MemoryStore,\n132\t            ),\n133\t            metric(\n134\t                MetricSignal::MemoryLaterUsedRate,\n135\t                Some(0.60),\n136\t                MetricSource::MemoryStore,\n137\t            ),\n138\t            metric(\n139\t                MetricSignal::StaleMemorySurfacedRate,\n140\t                Some(0.0),\n141\t                MetricSource::Verifier,\n142\t            ),\n143\t            metric(\n144\t                MetricSignal::ContradictionMissedRate,\n145\t                Some(0.0),\n146\t                MetricSource::Verifier,\n147\t            ),\n148\t            metric(\n149\t                MetricSignal::TestsRecommendedVsNeeded,\n150\t                Some(0.92),\n151\t                MetricSource::WorkflowOutcome,\n152\t            ),\n153\t            metric(\n154\t                MetricSignal::WorkflowSuccessAfterFirstPlan,\n155\t                Some(0.95),\n156\t                MetricSource::WorkflowOutcome,\n157\t            ),\n158\t        ],\n159\t        baseline: Some(baseline_metrics()),\n160\t        benchmark_report_path: PathBuf::new(),\n161\t        scope: MetricScope::session(\"session-report\"),\n162\t        success_criteria: SuccessCriteriaThresholds::initial(),\n163\t    }\n164\t}\n165\t\n166\tfn baseline_metrics() -> Vec<MetricValue> {\n167\t    vec![\n168\t        metric(\n169\t            MetricSignal::ToolCallsPerSuccessfulTask,\n170\t            Some(5.0),\n171\t            MetricSource::EventLog,\n172\t        ),\n173\t        metric(\n174\t            MetricSignal::IrrelevantFilesOpenedPerTask,\n175\t            Some(1.0),\n176\t            MetricSource::EventLog,\n177\t        ),\n178\t    ]\n179\t}\n180\t\n181\tfn metric(signal: MetricSignal, value: Option<f64>, source: MetricSource) -> MetricValue {\n182\t    MetricValue {\n183\t        signal,\n184\t        value,\n185\t        denominator: Some(1),\n186\t        sample_count: 1,\n187\t        source,\n188\t        computed_at: fixed_time(),\n189\t        incomplete: false,\n190\t        reason_if_null: None,\n191\t    }\n192\t}\n193\t\n194\tfn metric_null(signal: MetricSignal, source: MetricSource, reason: &str) -> MetricValue {\n195\t    MetricValue {\n196\t        signal,\n197\t        value: None,\n198\t        denominator: None,\n199\t        sample_count: 0,\n200\t        source,\n201\t        computed_at: fixed_time(),\n202\t        incomplete: false,\n203\t        reason_if_null: Some(reason.to_string())