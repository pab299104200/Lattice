s_scope.memories[0].scope = \"repo\".to_string();\n196\t    surface.record_call(cross_scope);\n197\t    let error = surface\n198\t        .collect_for_call(\"ctx-scope\", \"prepare_change\")\n199\t        .expect_err(\"cross-scope should fail\");\n200\t    assert!(matches!(error, MetricsSurfaceError::CrossScopeQuery { .. }));\n201\t}\n202\t\n203\tfn fixture_surface() -> MetricsSurface {\n204\t    MetricsSurface::new(\"workspace-main\", fixture_collector(), None)\n205\t}\n206\t\n207\tfn fixture_collector() -> MetricsCollector {\n208\t    MetricsCollector::new().with_memory_surface_records(vec![MemorySurfaceRecord {\n209\t        scope: MetricSampleScope {\n210\t            workspace_id: \"workspace-main\".to_string(),\n211\t            branch: Some(\"main\".to_string()),\n212\t            session_id: Some(\"session-main\".to_string()),\n213\t            user_id: None,\n214\t            organization_id: None,\n215\t            task_id: Some(\"ctx-main\".to_string()),\n216\t            observed_at: lattice_core::Utc::now(),\n217\t        },\n218\t        retrieval_event_id: EventId {\n219\t            workspace_id: \"workspace-main\".to_string(),\n220\t            ulid: \"evt-1\".to_string(),\n221\t        },\n222\t        memory_id: MemoryId {\n223\t            workspace_id: \"workspace-main\".to_string(),\n224\t            ulid: \"mem-1\".to_string(),\n225\t        },\n226\t        verification_status: VerificationStatus::Verified,\n227\t        stale_label_surfaced: false,\n228\t        contradiction_link_present: false,\n229\t        contradiction_surfaced: false,\n230\t        used_downstream: true,\n231\t        reused_later: true,\n232\t    }])\n233\t}\n234\t\n235\tfn workflow_bundle_fixture() -> WorkflowBundle {\n236\t    WorkflowBundle {\n237\t        overview: \"Auth workflow\".to_string(),\n238\t        ranked_pivots: vec![Pivot {\n239\t            identity: StableIdentity::LegacyHandle(\"symbol:login\".to_string()),\n240\t            kind: \"symbol\".to_str