{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019GGgFJXLN22jevGTFsabdT","type":"tool_result","content":"1\t//! Canonical Phase 9 signal definitions and deterministic collectors.\n2\t//!\n3\t//! Required metrics:\n4\t//!\n5\t//! - tool calls per successful task\n6\t//! - irrelevant files opened per task\n7\t//! - relevant anchor recall\n8\t//! - memory inclusion precision\n9\t//! - memory later-used rate\n10\t//! - stale memory surfaced rate\n11\t//! - contradiction missed rate\n12\t//! - tests recommended versus tests needed\n13\t//! - workflow success after first plan\n14\t\n15\tuse std::collections::{BTreeMap, BTreeSet, HashSet};\n16\t\n17\tuse serde::{Deserialize, Serialize};\n18\tuse tracing::debug_span;\n19\t\n20\tuse crate::events::{\n21\t    EventEnvelope, EventKind, EventPayload, FileReadPayload, PatchAppliedPayload,\n22\t    WorkflowSucceededPayload,\n23\t};\n24\tuse crate::identity::{EventId, MemoryId};\n25\tuse crate::verification::VerificationStatus;\n26\tuse crate::{DateTime, Utc};\n27\t\n28\tconst DEFAULT_MAX_SAMPLES: usize = 1_000;\n29\t\n30\t/// Canonical Phase 9 signal names used by MCP and CLI surfaces.\n31\t#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n32\t#[serde(rename_all = \"snake_case\")]\n33\tpub enum MetricSignal {\n34\t    ToolCallsPerSuccessfulTask,\n35\t    IrrelevantFilesOpenedPerTask,\n36\t    RelevantAnchorRecall,\n37\t    MemoryInclusionPrecision,\n38\t    MemoryLaterUsedRate,\n39\t    StaleMemorySurfacedRate,\n40\t    ContradictionMissedRate,\n41\t    TestsRecommendedVsNeeded,\n42\t    WorkflowSuccessAfterFirstPlan,\n43\t}\n44\t\n45\timpl MetricSignal {\n46\t    /// Every spec-required Phase 9 signal in canonical order.\n47\t    pub const ALL: [MetricSignal; 9] = [\n48\t        MetricSignal::ToolCallsPerSuccessfulTask,\n49\t        MetricSignal::IrrelevantFilesOpenedPerTask,\n50\t        MetricSignal::RelevantAnchorRecall,\n51\t        MetricSignal::MemoryInclusionPrecision,\n52\t        MetricSignal::MemoryLaterUsedRate,\n53\t        MetricSignal::StaleMemorySurfacedRate,\n54\t        MetricSignal::ContradictionMissedRate,\n55\t        MetricSignal::TestsRecommendedVsNeeded,\n56\t        MetricSignal::WorkflowSuccessAfterFirstPlan,\n57\t    ];\n58\t\n59\t    /// Return the canonical snake_case wire name.\n60\t    pub fn as_str(self) -> &'static str {\n61\t        match self {\n62\t            Self::ToolCallsPerSuccessfulTask => \"tool_calls_per_successful_task\",\n63\t            Self::IrrelevantFilesOpenedPerTask => \"irrelevant_files_opened_per_task\",\n64\t            Self::RelevantAnchorRecall => \"relevant_anchor_recall\",\n65\t            Self::MemoryInclusionPrecision => \"memory_inclusion_precision\",\n66\t            Self::MemoryLaterUsedRate => \"memory_later_used_rate\",\n67\t            Self::StaleMemorySurfacedRate => \"stale_memory_surfaced_rate\",\n68\t            Self::ContradictionMissedRate => \"contradiction_missed_rate\",\n69\t            Self::TestsRecommendedVsNeeded => \"tests_recommended_vs_needed\",\n70\t            Self::WorkflowSuccessAfterFirstPlan => \"workflow_success_after_first_plan\",\n71\t        }\n72\t    }\n73\t}\n74\t\n75\t/// Provenance for one collected metric.\n76\t#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n77\t#[serde(rename_all = \"snake_case\")]\n78\tpub enum MetricSource {\n79\t    EventLog,\n80\t    MemoryStore,\n81\t    WorkflowOutcome,\n82\t    Verifier,\n83\t    SessionMetrics,\n84\t}\n85\t\n86\t/// Optional UTC time-range filter for collection.\n87\t#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\n88\tpub struct MetricTimeRange {\n89\t    /// Inclusive lower bound for considered evidence.\n90\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n91\t    pub since: Option<DateTime<Utc>>,\n92\t    /// Inclusive upper bound for considered evidence.\n93\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n94\t    pub until: Option<DateTime<Utc>>,\n95\t}\n96\t\n97\t/// Top-level metric scope taxonomy for bounded collection.\n98\t#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n99\t#[serde(rename_all = \"snake_case\")]\n100\tpub enum MetricScopeKind {\n101\t    Session,\n102\t    Branch,\n103\t    Repo,\n104\t    User,\n105\t    Organization,\n106\t}\n107\t\n108\t/// Collection scope for Phase 9 metrics.\n109\t#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\n110\tpub struct MetricScope {\n111\t    /// Scope taxonomy requested by the caller.\n112\t    pub kind: MetricScopeKind,\n113\t    /// Workspace identifier required for repo and branch scopes.\n114\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n115\t    pub workspace_id: Option<String>,\n116\t    /// Branch name for branch-scoped metrics.\n117\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n118\t    pub branch: Option<String>,\n119\t    /// Session identifier for session-scoped metrics.\n120\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n121\t    pub session_id: Option<String>,\n122\t    /// User identifier for user-scoped metrics.\n123\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n124\t    pub user_id: Option<String>,\n125\t    /// Organization identifier for organization-scoped metrics.\n126\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n127\t    pub organization_id: Option<String>,\n128\t    /// Optional time-range filter.\n129\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n130\t    pub time_range: Option<MetricTimeRange>,\n131\t}\n132\t\n133\timpl MetricScope {\n134\t    /// Construct a session scope.\n135\t    pub fn session(session_id: impl Into<String>) -> Self {\n136\t        Self {\n137\t            kind: MetricScopeKind::Session,\n138\t            workspace_id: None,\n139\t            branch: None,\n140\t            session_id: Some(session_id.into()),\n141\t            user_id: None,\n142\t            organization_id: None,\n143\t            time_range: None,\n144\t        }\n145\t    }\n146\t\n147\t    /// Construct a branch scope.\n148\t    pub fn branch(workspace_id: impl Into<String>, branch: impl Into<String>) -> Self {\n149\t        Self {\n150\t            kind: MetricScopeKind::Branch,\n151\t            workspace_id: Some(workspace_id.into()),\n152\t            branch: Some(branch.into()),\n153\t            session_id: None,\n154\t            user_id: None,\n155\t            organization_id: None,\n156\t            time_range: None,\n157\t        }\n158\t    }\n159\t\n160\t    /// Construct a repo scope.\n161\t    pub fn repo(workspace_id: impl Into<String>) -> Self {\n162\t        Self {\n163\t            kind: MetricScopeKind::Repo,\n164\t            workspace_id: Some(workspace_id.into()),\n165\t            branch: None,\n166\t            session_id: None,\n167\t            user_id: None,\n168\t            organization_id: None,\n169\t            time_range: None,\n170\t        }\n171\t    }\n172\t\n173\t    /// Attach a UTC time range.\n174\t    pub fn with_time_range(\n175\t        mut self,\n176\t        since: Option<DateTime<Utc>>,\n177\t        until: Option<DateTime<Utc>>,\n178\t    ) -> Self {\n179\t        self.time_range = Some(MetricTimeRange { since, until });\n180\t        self\n181\t    }\n182\t\n183\t    fn time_matches(&self, timestamp: DateTime<Utc>) -> bool {\n184\t        let Some(range) = &self.time_range else {\n185\t            return true;\n186\t        };\n187\t        if let Some(since) = range.since {\n188\t            if timestamp.unix_seconds() < since.unix_seconds() {\n189\t                return false;\n190\t            }\n191\t        }\n192\t        if let Some(until) = range.until {\n193\t            if timestamp.unix_seconds() > until.unix_seconds() {\n194\t                return false;\n195\t            }\n196\t        }\n197\t        true\n198\t    }\n199\t\n200\t    fn missing_dimension_reason(&self) -> Option<String> {\n201\t        match self.kind {\n202\t            MetricScopeKind::Session if self.session_id.is_none() => {\n203\t                Some(\"session scope requires session_id\".to_string())\n204\t            }\n205\t            MetricScopeKind::Branch if self.workspace_id.is_none() || self.branch.is_none() => {\n206\t                Some(\"branch scope requires workspace_id and branch\".to_string())\n207\t            }\n208\t            MetricScopeKind::Repo if self.workspace_id.is_none() => {\n209\t                Some(\"repo scope requires workspace_id\".to_string())\n210\t            }\n211\t            MetricScopeKind::User if self.user_id.is_none() => {\n212\t                Some(\"user scope requires user_id\".to_string())\n213\t            }\n214\t            MetricScopeKind::Organization if self.organization_id.is_none() => {\n215\t                Some(\"organization scope requires organization_id\".to_string())\n216\t            }\n217\t            _ => None,\n218\t        }\n219\t    }\n220\t\n221\t    fn matches_event(&self, event: &EventEnvelope) -> bool {\n222\t        if !self.time_matches(event.timestamp) {\n223\t            return false;\n224\t        }\n225\t        match self.kind {\n226\t            MetricScopeKind::Session => self\n227\t                .session_id\n228\t                .as_ref()\n229\t                .is_some_and(|session_id| session_id == &event.session_id.value),\n230\t            MetricScopeKind::Branch => {\n231\t                self.workspace_id.as_ref() == Some(&event.workspace_id)\n232\t                    && self.branch.as_ref() == Some(&event.branch.name)\n233\t            }\n234\t            MetricScopeKind::Repo => self.workspace_id.as_ref() == Some(&event.workspace_id),\n235\t            MetricScopeKind::User => false,\n236\t            MetricScopeKind::Organization => false,\n237\t        }\n238\t    }\n239\t\n240\t    fn matches_sample(&self, sample: &MetricSampleScope) -> bool {\n241\t        if !self.time_matches(sample.observed_at) {\n242\t            return false;\n243\t        }\n244\t        match self.kind {\n245\t            MetricScopeKind::Session => self.session_id.as_ref() == sample.session_id.as_ref(),\n246\t            MetricScopeKind::Branch => {\n247\t                self.workspace_id.as_ref() == Some(&sample.workspace_id)\n248\t                    && self.branch.as_ref() == sample.branch.as_ref()\n249\t            }\n250\t            MetricScopeKind::Repo => self.workspace_id.as_ref() == Some(&sample.workspace_id),\n251\t            MetricScopeKind::User => self.user_id.as_ref() == sample.user_id.as_ref(),\n252\t            MetricScopeKind::Organization => {\n253\t                self.organization_id.as_ref() == sample.organization_id.as_ref()\n254\t            }\n255\t        }\n256\t    }\n257\t\n258\t    fn label(&self) -> &'static str {\n259\t        match self.kind {\n260\t            MetricScopeKind::Session => \"session\",\n261\t            MetricScopeKind::Branch => \"branch\",\n262\t            MetricScopeKind::Repo => \"repo\",\n263\t            MetricScopeKind::User => \"user\",\n264\t            MetricScopeKind::Organization => \"organization\",\n265\t        }\n266\t    }\n267\t}\n268\t\n269\t/// One collected metric snapshot.\n270\t#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]\n271\tpub struct MetricValue {\n272\t    /// Signal name.\n273\t    pub signal: MetricSignal,\n274\t    /// Metric value when enough evidence exists to compute it.\n275\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n276\t    pub value: Option<f64>,\n277\t    /// Optional denominator used for ratio or mean reporting.\n278\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n279\t    pub denominator: Option<u64>,\n280\t    /// Number of contributing samples actually processed.\n281\t    pub sample_count: u64,\n282\t    /// Provenance for this metric.\n283\t    pub source: MetricSource,\n284\t    /// UTC timestamp when the value was computed.\n285\t    pub computed_at: DateTime<Utc>,\n286\t    /// Whether the collector truncated evidence due to bounds.\n287\t    pub incomplete: bool,\n288\t    /// Truthful reason for a null value.\n289\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n290\t    pub reason_if_null: Option<String>,\n291\t}\n292\t\n293\t/// Shared scope metadata for non-event benchmark samples.\n294\t#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\n295\tpub struct MetricSampleScope {\n296\t    /// Workspace that owns the sample.\n297\t    pub workspace_id: String,\n298\t    /// Optional branch for branch-scoped samples.\n299\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n300\t    pub branch: Option<String>,\n301\t    /// Optional session id for session-scoped samples.\n302\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n303\t    pub session_id: Option<String>,\n304\t    /// Optional user id for user-scoped samples.\n305\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n306\t    pub user_id: Option<String>,\n307\t    /// Optional organization id for organization-scoped samples.\n308\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n309\t    pub organization_id: Option<String>,\n310\t    /// Optional task id for task-local samples.\n311\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n312\t    pub task_id: Option<String>,\n313\t    /// Timestamp used for time-range filtering.\n314\t    pub observed_at: DateTime<Utc>,\n315\t}\n316\t\n317\t/// One retrieved memory entry enriched with verifier and usefulness facts.\n318\t#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\n319\tpub struct MemorySurfaceRecord {\n320\t    /// Scope coordinates for this retrieval entry.\n321\t    pub scope: MetricSampleScope,\n322\t    /// Event that surfaced the memory.\n323\t    pub retrieval_event_id: EventId,\n324\t    /// Retrieved memory identifier.\n325\t    pub memory_id: MemoryId,\n326\t    /// Verification status at retrieval time.\n327\t    pub verification_status: VerificationStatus,\n328\t    /// Whether the surfaced payload labeled the memory as stale.\n329\t    pub stale_label_surfaced: bool,\n330\t    /// Whether a contradiction link existed when surfaced.\n331\t    pub contradiction_link_present: bool,\n332\t    /// Whether the surfaced payload exposed the contradiction.\n333\t    pub contradiction_surfaced: bool,\n334\t    /// Whether the memory was used downstream after retrieval.\n335\t    pub used_downstream: bool,\n336\t    /// Whether the memory was reused later in the same or later session window.\n337\t    pub reused_later: bool,\n338\t}\n339\t\n340\t/// Golden anchor-recall benchmark sample.\n341\t#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\n342\tpub struct AnchorRecallSample {\n343\t    /// Scope coordinates for the benchmark sample.\n344\t    pub scope: MetricSampleScope,\n345\t    /// Golden anchors expected for the task.\n346\t    pub golden_anchors: Vec<String>,\n347\t    /// Anchors returned by the workflow bundle.\n348\t    pub returned_anchors: Vec<String>,\n349\t}\n350\t\n351\t/// Golden test-recommendation benchmark sample.\n352\t#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\n353\tpub struct TestRecommendationSample {\n354\t    /// Scope coordinates for the benchmark sample.\n355\t    pub scope: MetricSampleScope,\n356\t    /// Tests recommended by `find_relevant_tests`.\n357\t    pub recommended_tests: Vec<String>,\n358\t    /// Tests required by the golden answer.\n359\t    pub needed_tests: Vec<String>,\n360\t}\n361\t\n362\t/// Deterministic bounded collector for Phase 9 metrics.\n363\t#[derive(Clone, Debug, Default)]\n364\tpub struct MetricsCollector {\n365\t    events: Vec<EventEnvelope>,\n366\t    memory_surface_records: Vec<MemorySurfaceRecord>,\n367\t    anchor_recall_samples: Vec<AnchorRecallSample>,\n368\t    test_recommendation_samples: Vec<TestRecommendationSample>,\n369\t    max_samples: usize,\n370\t    computed_at: Option<DateTime<Utc>>,\n371\t}\n372\t\n373\timpl MetricsCollector {\n374\t    /// Create an empty collector.\n375\t    pub fn new() -> Self {\n376\t        Self {\n377\t            max_samples: DEFAULT_MAX_SAMPLES,\n378\t            ..Self::default()\n379\t        }\n380\t    }\n381\t\n382\t    /// Replace the event-log evidence used by the collector.\n383\t    pub fn with_events(mut self, events: Vec<EventEnvelope>) -> Self {\n384\t        self.events = events;\n385\t        self\n386\t    }\n387\t\n388\t    /// Replace the memory surface evidence used by the collector.\n389\t    pub fn with_memory_surface_records(mut self, records: Vec<MemorySurfaceRecord>) -> Self {\n390\t        self.memory_surface_records = records;\n391\t        self\n392\t    }\n393\t\n394\t    /// Replace the golden anchor-recall samples used by the collector.\n395\t    pub fn with_anchor_recall_samples(mut self, samples: Vec<AnchorRecallSample>) -> Self {\n396\t        self.anchor_recall_samples = samples;\n397\t        self\n398\t    }\n399\t\n400\t    /// Replace the test-recommendation samples used by the collector.\n401\t    pub fn with_test_recommendation_samples(\n402\t        mut self,\n403\t        samples: Vec<TestRecommendationSample>,\n404\t    ) -> Self {\n405\t        self.test_recommendation_samples = samples;\n406\t        self\n407\t    }\n408\t\n409\t    /// Override the maximum number of samples processed per signal.\n410\t    pub fn with_max_samples(mut self, max_samples: usize) -> Self {\n411\t        self.max_samples = max_samples.max(1);\n412\t        self\n413\t    }\n414\t\n415\t    /// Override the computed-at timestamp for deterministic tests.\n416\t    pub fn with_computed_at(mut self, computed_at: DateTime<Utc>) -> Self {\n417\t        self.computed_at = Some(computed_at);\n418\t        self\n419\t    }\n420\t\n421\t    /// Collect the requested signals for the given scope.\n422\t    pub fn collect(&self, scope: MetricScope, signals: &[MetricSignal]) -> Vec<MetricValue> {\n423\t        let selected = select_signals(signals);\n424\t        selected\n425\t            .into_iter()\n426\t            .map(|signal| self.collect_signal(&scope, signal))\n427\t            .collect()\n428\t    }\n429\t\n430\t    fn collect_signal(&self, scope: &MetricScope, signal: MetricSignal) -> MetricValue {\n431\t        let source = signal_source(signal);\n432\t        let Some(reason) = scope\n433\t            .missing_dimension_reason()\n434\t            .filter(|_| scope_needs_dimensions(signal))\n435\t        else {\n436\t            let metric = match signal {\n437\t                MetricSignal::ToolCallsPerSuccessfulTask => {\n438\t                    self.collect_tool_calls_per_successful_task(scope)\n439\t                }\n440\t                MetricSignal::IrrelevantFilesOpenedPerTask => {\n441\t                    self.collect_irrelevant_files_opened_per_task(scope)\n442\t                }\n443\t                MetricSignal::RelevantAnchorRecall => self.collect_relevant_anchor_recall(scope),\n444\t                MetricSignal::MemoryInclusionPrecision => {\n445\t                    self.collect_memory_inclusion_precision(scope)\n446\t                }\n447\t                MetricSignal::MemoryLaterUsedRate => self.collect_memory_later_used_rate(scope),\n448\t                MetricSignal::StaleMemorySurfacedRate => {\n449\t                    self.collect_stale_memory_surfaced_rate(scope)\n450\t                }\n451\t                MetricSignal::ContradictionMissedRate => {\n452\t                    self.collect_contradiction_missed_rate(scope)\n453\t                }\n454\t                MetricSignal::TestsRecommendedVsNeeded => {\n455\t                    self.collect_tests_recommended_vs_needed(scope)\n456\t                }\n457\t                MetricSignal::WorkflowSuccessAfterFirstPlan => {\n458\t                    self.collect_workflow_success_after_first_plan(scope)\n459\t                }\n460\t            };\n461\t            return finalize_metric(metric, signal, source, scope.label(), self.now());\n462\t        };\n463\t        finalize_metric(\n464\t            SignalMetric::null(reason, false),\n465\t            signal,\n466\t            source,\n467\t            scope.label(),\n468\t            self.now(),\n469\t        )\n470\t    }\n471\t\n472\t    fn collect_tool_calls_per_successful_task(&self, scope: &MetricScope) -> SignalMetric {\n473\t        let events = bounded_events(&self.events, scope, self.max_samples);\n474\t        let tasks = successful_task_metrics(&events.items);\n475\t        mean_metric(\n476\t            tasks\n477\t                .iter()\n478\t                .map(|metric| metric.tool_calls as f64)\n479\t                .collect(),\n480\t            tasks.len() as u64,\n481\t            events.incomplete,\n482\t            \"no successful tasks matched the requested scope\",\n483\t        )\n484\t    }\n485\t\n486\t    fn collect_irrelevant_files_opened_per_task(&self, scope: &MetricScope) -> SignalMetric {\n487\t        let events = bounded_events(&self.events, scope, self.max_samples);\n488\t        let tasks = successful_task_metrics(&events.items);\n489\t        let values = tasks\n490\t            .iter()\n491\t            .map(|metric| count_irrelevant_file_reads(metric) as f64)\n492\t            .collect::<Vec<_>>();\n493\t        mean_metric(\n494\t            values,\n495\t            tasks.len() as u64,\n496\t            events.incomplete,\n497\t            \"no successful tasks matched the requested scope\",\n498\t        )\n499\t    }\n500\t\n501\t    fn collect_relevant_anchor_recall(&self, scope: &MetricScope) -> SignalMetric {\n502\t        let samples = bounded_samples(\n503\t            &self.anchor_recall_samples,\n504\t            scope,\n505\t            self.max_samples,\n506\t            |sample| &sample.scope,\n507\t        );\n508\t        ratio_metric(\n509\t            samples\n510\t                .items\n511\t                .iter()\n512\t                .map(anchor_recall_counts)\n513\t                .fold((0u64, 0u64), accumulate_pair),\n514\t            samples.items.len() as u64,\n515\t            samples.incomplete,\n516\t            \"no anchor recall samples matched the requested scope\",\n517\t        )\n518\t    }\n519\t\n520\t    fn collect_memory_inclusion_precision(&self, scope: &MetricScope) -> SignalMetric {\n521\t        let records = bounded_samples(\n522\t            &self.memory_surface_records,\n523\t            scope,\n524\t            self.max_samples,\n525\t            |record| &record.scope,\n526\t        );\n527\t        ratio_metric(\n528\t            usage_counts(&records.items, |record| record.used_downstream),\n529\t            records.items.len() as u64,\n530\t            records.incomplete,\n531\t            \"no retrieved memories matched the requested scope\",\n532\t        )\n533\t    }\n534\t\n535\t    fn collect_memory_later_used_rate(&self, scope: &MetricScope) -> SignalMetric {\n536\t        let records = bounded_samples(\n537\t            &self.memory_surface_records,\n538\t            scope,\n539\t            self.max_samples,\n540\t            |record| &record.scope,\n541\t        );\n542\t        ratio_metric(\n543\t            usage_counts(&records.items, |record| record.reused_later),\n544\t            records.items.len() as u64,\n545\t            records.incomplete,\n546\t            \"no retrieved memories matched the requested scope\",\n547\t        )\n548\t    }\n549\t\n550\t    fn collect_stale_memory_surfaced_rate(&self, scope: &MetricScope) -> SignalMetric {\n551\t        let records = bounded_samples(\n552\t            &self.memory_surface_records,\n553\t            scope,\n554\t            self.max_samples,\n555\t            |record| &record.scope,\n556\t        );\n557\t        let counts = filtered_ratio_counts(&records.items, is_stale_record, |record| {\n558\t            !record.stale_label_surfaced\n559\t        });\n560\t        ratio_metric(\n561\t            counts,\n562\t            counts.1,\n563\t            records.incomplete,\n564\t            \"no stale retrieved memories matched the requested scope\",\n565\t        )\n566\t    }\n567\t\n568\t    fn collect_contradiction_missed_rate(&self, scope: &MetricScope) -> SignalMetric {\n569\t        let records = bounded_samples(\n570\t            &self.memory_surface_records,\n571\t            scope,\n572\t            self.max_samples,\n573\t            |record| &record.scope,\n574\t        );\n575\t        let counts = filtered_ratio_counts(&records.items, has_contradiction_link, |record| {\n576\t            !record.contradiction_surfaced\n577\t        });\n578\t        ratio_metric(\n579\t            counts,\n580\t            counts.1,\n581\t            records.incomplete,\n582\t            \"no contradicted retrieved memories matched the requested scope\",\n583\t        )\n584\t    }\n585\t\n586\t    fn collect_tests_recommended_vs_needed(&self, scope: &MetricScope) -> SignalMetric {\n587\t        let samples = bounded_samples(\n588\t            &self.test_recommendation_samples,\n589\t            scope,\n590\t            self.max_samples,\n591\t            |sample| &sample.scope,\n592\t        );\n593\t        ratio_metric(\n594\t            samples\n595\t                .items\n596\t                .iter()\n597\t                .map(test_recommendation_counts)\n598\t                .fold((0u64, 0u64), accumulate_pair),\n599\t            samples.items.len() as u64,\n600\t            samples.incomplete,\n601\t            \"no test recommendation samples matched the requested scope\",\n602\t        )\n603\t    }\n604\t\n605\t    fn collect_workflow_success_after_first_plan(&self, scope: &MetricScope) -> SignalMetric {\n606\t        let events = bounded_events(&self.events, scope, self.max_samples);\n607\t        let tasks = planned_task_metrics(&events.items);\n608\t        let succeeded = tasks\n609\t            .iter()\n610\t            .filter(|metric| metric.succeeded_after_first_plan)\n611\t            .count() as u64;\n612\t        ratio_metric(\n613\t            (succeeded, tasks.len() as u64),\n614\t            tasks.len() as u64,\n615\t            events.incomplete,\n616\t            \"no planned tasks matched the requested scope\",\n617\t        )\n618\t    }\n619\t\n620\t    fn now(&self) -> DateTime<Utc> {\n621\t        self.computed_at.unwrap_or_else(Utc::now)\n622\t    }\n623\t}\n624\t\n625\t#[derive(Clone, Debug)]\n626\tstruct SignalMetric {\n627\t    value: Option<f64>,\n628\t    denominator: Option<u64>,\n629\t    sample_count: u64,\n630\t    incomplete: bool,\n631\t    reason_if_null: Option<String>,\n632\t}\n633\t\n634\timpl SignalMetric {\n635\t    fn null(reason: impl Into<String>, incomplete: bool) -> Self {\n636\t        Self {\n637\t            value: None,\n638\t            denominator: None,\n639\t            sample_count: 0,\n640\t            incomplete,\n641\t            reason_if_null: Some(reason.into()),\n642\t        }\n643\t    }\n644\t}\n645\t\n646\t#[derive(Clone, Debug)]\n647\tstruct BoundedData<T> {\n648\t    items: Vec<T>,\n649\t    incomplete: bool,\n650\t}\n651\t\n652\t#[derive(Clone, Debug)]\n653\tstruct SuccessfulTaskMetric {\n654\t    tool_calls: usize,\n655\t    read_files: BTreeSet<String>,\n656\t    changed_files: BTreeSet<String>,\n657\t    artifact_files: BTreeSet<String>,\n658\t}\n659\t\n660\t#[derive(Clone, Debug)]\n661\tstruct PlannedTaskMetric {\n662\t    succeeded_after_first_plan: bool,\n663\t}\n664\t\n665\tfn finalize_metric(\n666\t    metric: SignalMetric,\n667\t    signal: MetricSignal,\n668\t    source: MetricSource,\n669\t    scope_label: &str,\n670\t    computed_at: DateTime<Utc>,\n671\t) -> MetricValue {\n672\t    let _span = debug_span!(\n673\t        \"metrics.collect_signal\",\n674\t        signal = signal.as_str(),\n675\t        scope = scope_label,\n676\t        sample_count = metric.sample_count,\n677\t        incomplete = metric.incomplete\n678\t    )\n679\t    .entered();\n680\t    MetricValue {\n681\t        signal,\n682\t        value: metric.value,\n683\t        denominator: metric.denominator,\n684\t        sample_count: metric.sample_count,\n685\t        source,\n686\t        computed_at,\n687\t        incomplete: metric.incomplete,\n688\t        reason_if_null: metric.reason_if_null,\n689\t    }\n690\t}\n691\t\n692\tfn select_signals(signals: &[MetricSignal]) -> Vec<MetricSignal> {\n693\t    if signals.is_empty() {\n694\t        return MetricSignal::ALL.to_vec();\n695\t    }\n696\t    signals.to_vec()\n697\t}\n698\t\n699\tfn signal_source(signal: MetricSignal) -> MetricSource {\n700\t    match signal {\n701\t        MetricSignal::ToolCallsPerSuccessfulTask => MetricSource::EventLog,\n702\t        MetricSignal::IrrelevantFilesOpenedPerTask => MetricSource::EventLog,\n703\t        MetricSignal::RelevantAnchorRecall => MetricSource::EventLog,\n704\t        MetricSignal::MemoryInclusionPrecision => MetricSource::MemoryStore,\n705\t        MetricSignal::MemoryLaterUsedRate => MetricSource::MemoryStore,\n706\t        MetricSignal::StaleMemorySurfacedRate => MetricSource::Verifier,\n707\t        MetricSignal::ContradictionMissedRate => MetricSource::Verifier,\n708\t        MetricSignal::TestsRecommendedVsNeeded => MetricSource::WorkflowOutcome,\n709\t        MetricSignal::WorkflowSuccessAfterFirstPlan => MetricSource::WorkflowOutcome,\n710\t    }\n711\t}\n712\t\n713\tfn scope_needs_dimensions(_signal: MetricSignal) -> bool {\n714\t    true\n715\t}\n716\t\n717\tfn bounded_events(\n718\t    events: &[EventEnvelope],\n719\t    scope: &MetricScope,\n720\t    max_samples: usize,\n721\t) -> BoundedData<EventEnvelope> {\n722\t    let filtered = events\n723\t        .iter()\n724\t        .filter(|event| scope.matches_event(event))\n725\t        .cloned()\n726\t        .collect::<Vec<_>>();\n727\t    truncate_items(filtered, max_samples)\n728\t}\n729\t\n730\tfn bounded_samples<T: Clone, F>(\n731\t    samples: &[T],\n732\t    scope: &MetricScope,\n733\t    max_samples: usize,\n734\t    sample_scope: F,\n735\t) -> BoundedData<T>\n736\twhere\n737\t    F: Fn(&T) -> &MetricSampleScope,\n738\t{\n739\t    let filtered = samples\n740\t        .iter()\n741\t        .filter(|sample| scope.matches_sample(sample_scope(sample)))\n742\t        .cloned()\n743\t        .collect::<Vec<_>>();\n744\t    truncate_items(filtered, max_samples)\n745\t}\n746\t\n747\tfn truncate_items<T>(items: Vec<T>, max_samples: usize) -> BoundedData<T> {\n748\t    let incomplete = items.len() > max_samples;\n749\t    let items = items.into_iter().take(max_samples).collect();\n750\t    BoundedData { items, incomplete }\n751\t}\n752\t\n753\tfn successful_task_metrics(events: &[EventEnvelope]) -> Vec<SuccessfulTaskMetric> {\n754\t    let groups = group_events_by_task(events);\n755\t    groups\n756\t        .into_values()\n757\t        .filter_map(|task_events| successful_task_metric(&task_events))\n758\t        .collect()\n759\t}\n760\t\n761\tfn successful_task_metric(events: &[EventEnvelope]) -> Option<SuccessfulTaskMetric> {\n762\t    if !is_successful_task(events) {\n763\t        return None;\n764\t    }\n765\t    let tool_calls = events\n766\t        .iter()\n767\t        .filter(|event| event.kind == EventKind::ToolCalled)\n768\t        .count();\n769\t    let read_files = collect_file_reads(events);\n770\t    let changed_files = collect_patch_files(events);\n771\t    let artifact_files = collect_workflow_artifact_files(events);\n772\t    Some(SuccessfulTaskMetric {\n773\t        tool_calls,\n774\t        read_files,\n775\t        changed_files,\n776\t        artifact_files,\n777\t    })\n778\t}\n779\t\n780\tfn planned_task_metrics(events: &[EventEnvelope]) -> Vec<PlannedTaskMetric> {\n781\t    group_events_by_task(events)\n782\t        .into_values()\n783\t        .filter_map(|task_events| planned_task_metric(&task_events))\n784\t        .collect()\n785\t}\n786\t\n787\tfn planned_task_metric(events: &[EventEnvelope]) -> Option<PlannedTaskMetric> {\n788\t    let first_plan_index = events\n789\t        .iter()\n790\t        .position(|event| event.kind == EventKind::PlanCreated)?;\n791\t    let has_failure_after_plan = events[first_plan_index + 1..]\n792\t        .iter()\n793\t        .any(|event| event.kind == EventKind::WorkflowFailed);\n794\t    let has_success_after_plan = events[first_plan_index + 1..]\n795\t        .iter()\n796\t        .any(|event| event.kind == EventKind::WorkflowSucceeded);\n797\t    Some(PlannedTaskMetric {\n798\t        succeeded_after_first_plan: has_success_after_plan && !has_failure_after_plan,\n799\t    })\n800\t}\n801\t\n802\tfn group_events_by_task(events: &[EventEnvelope]) -> BTreeMap<String, Vec<EventEnvelope>> {\n803\t    let mut groups = BTreeMap::new();\n804\t    for event in events.iter().filter(|event| event.task_id.is_some()) {\n805\t        let task_id = event\n806\t            .task_id\n807\t            .as_ref()\n808\t            .map(|task_id| task_id.value.clone())\n809\t            .unwrap_or_default();\n810\t        groups\n811\t            .entry(task_id)\n812\t            .or_insert_with(Vec::new)\n813\t            .push(event.clone());\n814\t    }\n815\t    groups\n816\t}\n817\t\n818\tfn is_successful_task(events: &[EventEnvelope]) -> bool {\n819\t    let mut terminal: Option<EventKind> = None;\n820\t    for event in events {\n821\t        if matches!(\n822\t            event.kind,\n823\t            EventKind::WorkflowSucceeded | EventKind::WorkflowFailed\n824\t        ) {\n825\t            terminal = Some(event.kind);\n826\t        }\n827\t    }\n828\t    terminal == Some(EventKind::WorkflowSucceeded)\n829\t}\n830\t\n831\tfn collect_file_reads(events: &[EventEnvelope]) -> BTreeSet<String> {\n832\t    events\n833\t        .iter()\n834\t        .filter_map(read_file_path)\n835\t        .collect::<BTreeSet<_>>()\n836\t}\n837\t\n838\tfn collect_patch_files(events: &[EventEnvelope]) -> BTreeSet<String> {\n839\t    events\n840\t        .iter()\n841\t        .flat_map(patch_file_paths)\n842\t        .collect::<BTreeSet<_>>()\n843\t}\n844\t\n845\tfn collect_workflow_artifact_files(events: &[EventEnvelope]) -> BTreeSet<String> {\n846\t    let successful_memory_ids = events\n847\t        .iter()\n848\t        .filter_map(success_payload)\n849\t        .flat_map(|payload| payload.memory_ids.iter().cloned())\n850\t        .collect::<HashSet<_>>();\n851\t    let mut files = BTreeSet::new();\n852\t    for event in events {\n853\t        if let EventPayload::MemoryRetrieved(payload) = &event.payload {\n854\t            if payload\n855\t                .memory_ids\n856\t                .iter()\n857\t                .any(|memory_id| successful_memory_ids.contains(memory_id))\n858\t            {\n859\t                files.extend(identity_file_paths(&payload.included_context));\n860\t            }\n861\t        }\n862\t        if let EventPayload::MemoryExpanded(payload) = &event.payload {\n863\t            if payload\n864\t                .memory_id\n865\t                .as_ref()\n866\t                .is_some_and(|memory_id| successful_memory_ids.contains(memory_id))\n867\t            {\n868\t                files.extend(identity_file_paths(&payload.included_context));\n869\t            }\n870\t        }\n871\t    }\n872\t    files\n873\t}\n874\t\n875\tfn read_file_path(event: &EventEnvelope) -> Option<String> {\n876\t    let EventPayload::FileRead(FileReadPayload { file_id, .. }) = &event.payload else {\n877\t        return None;\n878\t    };\n879\t    Some(file_id.repo_relative_path.clone())\n880\t}\n881\t\n882\tfn patch_file_paths(event: &EventEnvelope) -> Vec<String> {\n883\t    let EventPayload::PatchApplied(PatchAppliedPayload { file_ids, .. }) = &event.payload else {\n884\t        return Vec::new();\n885\t    };\n886\t    file_ids\n887\t        .iter()\n888\t        .map(|file_id| file_id.repo_relative_path.clone())\n889\t        .collect()\n890\t}\n891\t\n892\tfn success_payload(event: &EventEnvelope) -> Option<&WorkflowSucceededPayload> {\n893\t    let EventPayload::WorkflowSucceeded(payload) = &event.payload else {\n894\t        return None;\n895\t    };\n896\t    Some(payload)\n897\t}\n898\t\n899\tfn identity_file_paths(\n900\t    included_context: &[crate::events::IncludedContextDelta],\n901\t) -> BTreeSet<String> {\n902\t    included_context\n903\t        .iter()\n904\t        .filter_map(|delta| match &delta.identity {\n905\t            crate::identity::Identity::File(file_id) => Some(file_id.repo_relative_path.clone()),\n906\t            crate::identity::Identity::Symbol(symbol_id) => {\n907\t                Some(symbol_id.file.repo_relative_path.clone())\n908\t            }\n909\t            _ => None,\n910\t        })\n911\t        .collect()\n912\t}\n913\t\n914\tfn count_irrelevant_file_reads(task: &SuccessfulTaskMetric) -> usize {\n915\t    task.read_files\n916\t        .iter()\n917\t        .filter(|path| !task.changed_files.contains(*path) && !task.artifact_files.contains(*path))\n918\t        .count()\n919\t}\n920\t\n921\tfn anchor_recall_counts(sample: &AnchorRecallSample) -> (u64, u64) {\n922\t    let returned = sample\n923\t        .returned_anchors\n924\t        .iter()\n925\t        .map(|anchor| anchor.as_str())\n926\t        .collect::<HashSet<_>>();\n927\t    let hits = sample\n928\t        .golden_anchors\n929\t        .iter()\n930\t        .filter(|anchor| returned.contains(anchor.as_str()))\n931\t        .count() as u64;\n932\t    (hits, sample.golden_anchors.len() as u64)\n933\t}\n934\t\n935\tfn usage_counts<F>(records: &[MemorySurfaceRecord], predicate: F) -> (u64, u64)\n936\twhere\n937\t    F: Fn(&MemorySurfaceRecord) -> bool,\n938\t{\n939\t    let hits = records.iter().filter(|record| predicate(record)).count() as u64;\n940\t    (hits, records.len() as u64)\n941\t}\n942\t\n943\tfn filtered_ratio_counts<F, G>(records: &[MemorySurfaceRecord], include: F, hit: G) -> (u64, u64)\n944\twhere\n945\t    F: Fn(&MemorySurfaceRecord) -> bool,\n946\t    G: Fn(&MemorySurfaceRecord) -> bool,\n947\t{\n948\t    let filtered = records\n949\t        .iter()\n950\t        .filter(|record| include(record))\n951\t        .collect::<Vec<_>>();\n952\t    let hits = filtered.iter().filter(|record| hit(record)).count() as u64;\n953\t    (hits, filtered.len() as u64)\n954\t}\n955\t\n956\tfn is_stale_record(record: &MemorySurfaceRecord) -> bool {\n957\t    record.verification_status == VerificationStatus::Stale\n958\t}\n959\t\n960\tfn has_contradiction_link(record: &MemorySurfaceRecord) -> bool {\n961\t    record.contradiction_link_present\n962\t}\n963\t\n964\tfn test_recommendation_counts(sample: &TestRecommendationSample) -> (u64, u64) {\n965\t    let recommended = sample\n966\t        .recommended_tests\n967\t        .iter()\n968\t        .map(|test| test.as_str())\n969\t        .collect::<HashSet<_>>();\n970\t    let hits = sample\n971\t        .needed_tests\n972\t        .iter()\n973\t        .filter(|test| recommended.contains(test.as_str()))\n974\t        .count() as u64;\n975\t    (hits, sample.needed_tests.len() as u64)\n976\t}\n977\t\n978\tfn accumulate_pair(acc: (u64, u64), item: (u64, u64)) -> (u64, u64) {\n979\t    (acc.0 + item.0, acc.1 + item.1)\n980\t}\n981\t\n982\tfn ratio_metric(\n983\t    counts: (u64, u64),\n984\t    sample_count: u64,\n985\t    incomplete: bool,\n986\t    no_data_reason: &str,\n987\t) -> SignalMetric {\n988\t    if counts.1 == 0 {\n989\t        return SignalMetric::null(no_data_reason, incomplete);\n990\t    }\n991\t    SignalMetric {\n992\t        value: Some(counts.0 as f64 / counts.1 as f64),\n993\t        denominator: Some(counts.1),\n994\t        sample_count,\n995\t        incomplete,\n996\t        reason_if_null: None,\n997\t    }\n998\t}\n999\t\n1000\tfn mean_metric(\n1001\t    values: Vec<f64>,\n1002\t    denominator: u64,\n1003\t    incomplete: bool,\n1004\t    no_data_reason: &str,\n1005\t) -> SignalMetric {\n1006\t    if values.is_empty() {\n1007\t        return SignalMetric::null(no_data_reason, incomplete);\n1008\t    }\n1009\t    let total = values.iter().sum::<f64>();\n1010\t    SignalMetric {\n1011\t        value: Some(total / values.len() as f64),\n1012\t        denominator: Some(denominator),\n1013\t        sample_count: values.len() as u64,\n1014\t        incomplete,\n1015\t        reason_if_null: None,\n1016\t    }\n1017\t}\n1018\t"}]},"parent_tool_use_id":null,"session_id":"dcdb14de-3541-4532-8220-c4c3ddb6207e","uuid":"25d9dca8-5d9d-4de8-a857-e92d83a25354","timestamp":"2026-05-17T16:39:06.978Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/src/metrics/signals.rs","content":"//! Canonical Phase 9 signal definitions and deterministic collectors.\n//!\n//! Required metrics:\n//!\n//! - tool calls per successful task\n//! - irrelevant files opened per task\n//! - relevant anchor recall\n//! - memory inclusion precision\n//! - memory later-used rate\n//! - stale memory surfaced rate\n//! - contradiction missed rate\n//! - tests recommended versus tests needed\n//! - workflow success after first plan\n\nuse std::collections::{BTreeMap, BTreeSet, HashSet};\n\nuse serde::{Deserialize, Serialize};\nuse tracing::debug_span;\n\nuse crate::events::{\n    EventEnvelope, EventKind, EventPayload, FileReadPayload, PatchAppliedPayload,\n    WorkflowSucceededPayload,\n};\nuse crate::identity::{EventId, MemoryId};\nuse crate::verification::VerificationStatus;\nuse crate::{DateTime, Utc};\n\nconst DEFAULT_MAX_SAMPLES: usize = 1_000;\n\n/// Canonical Phase 9 signal names used by MCP and CLI surfaces.\n#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[serde(rename_all = \"snake_case\")]\npub enum MetricSignal {\n    ToolCallsPerSuccessfulTask,\n    IrrelevantFilesOpenedPerTask,\n    RelevantAnchorRecall,\n    MemoryInclusionPrecision,\n    MemoryLaterUsedRate,\n    StaleMemorySurfacedRate,\n    ContradictionMissedRate,\n    TestsRecommendedVsNeeded,\n    WorkflowSuccessAfterFirstPlan,\n}\n\nimpl MetricSignal {\n    /// Every spec-required Phase 9 signal in canonical order.\n    pub const ALL: [MetricSignal; 9] = [\n        MetricSignal::ToolCallsPerSuccessfulTask,\n        MetricSignal::IrrelevantFilesOpenedPerTask,\n        MetricSignal::RelevantAnchorRecall,\n        MetricSignal::MemoryInclusionPrecision,\n        MetricSignal::MemoryLaterUsedRate,\n        MetricSignal::StaleMemorySurfacedRate,\n        MetricSignal::ContradictionMissedRate,\n        MetricSignal::TestsRecommendedVsNeeded,\n        MetricSignal::WorkflowSuccessAfterFirstPlan,\n    ];\n\n    /// Return the canonical snake_case wire name.\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::ToolCallsPerSuccessfulTask => \"tool_calls_per_successful_task\",\n            Self::IrrelevantFilesOpenedPerTask => \"irrelevant_files_opened_per_task\",\n            Self::RelevantAnchorRecall => \"relevant_anchor_recall\",\n            Self::MemoryInclusionPrecision => \"memory_inclusion_precision\",\n            Self::MemoryLaterUsedRate => \"memory_later_used_rate\",\n            Self::StaleMemorySurfacedRate => \"stale_memory_surfaced_rate\",\n            Self::ContradictionMissedRate => \"contradiction_missed_rate\",\n            Self::TestsRecommendedVsNeeded => \"tests_recommended_vs_needed\",\n            Self::WorkflowSuccessAfterFirstPlan => \"workflow_success_after_first_plan\",\n        }\n    }\n}\n\n/// Provenance for one collected metric.\n#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[serde(rename_all = \"snake_case\")]\npub enum MetricSource {\n    EventLog,\n    MemoryStore,\n    WorkflowOutcome,\n    Verifier,\n    SessionMetrics,\n}\n\n/// Optional UTC time-range filter for collection.\n#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\npub struct MetricTimeRange {\n    /// Inclusive lower bound for considered evidence.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub since: Option<DateTime<Utc>>,\n    /// Inclusive upper bound for considered evidence.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub until: Option<DateTime<Utc>>,\n}\n\n/// Top-level metric scope taxonomy for bounded collection.\n#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[serde(rename_all = \"snake_case\")]\npub enum MetricScopeKind {\n    Session,\n    Branch,\n    Repo,\n    User,\n    Organization,\n}\n\n/// Collection scope for Phase 9 metrics.\n#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\npub struct MetricScope {\n    /// Scope taxonomy requested by the caller.\n    pub kind: MetricScopeKind,\n    /// Workspace identifier required for repo and branch scopes.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub workspace_id: Option<String>,\n    /// Branch name for branch-scoped metrics.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub branch: Option<String>,\n    /// Session identifier for session-scoped metrics.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub session_id: Option<String>,\n    /// User identifier for user-scoped metrics.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub user_id: Option<String>,\n    /// Organization identifier for organization-scoped metrics.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub organization_id: Option<String>,\n    /// Optional time-range filter.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub time_range: Option<MetricTimeRange>,\n}\n\nimpl MetricScope {\n    /// Construct a session scope.\n    pub fn session(session_id: impl Into<String>) -> Self {\n        Self {\n            kind: MetricScopeKind::Session,\n            workspace_id: None,\n            branch: None,\n            session_id: Some(session_id.into()),\n            user_id: None,\n            organization_id: None,\n            time_range: None,\n        }\n    }\n\n    /// Construct a branch scope.\n    pub fn branch(workspace_id: impl Into<String>, branch: impl Into<String>) -> Self {\n        Self {\n            kind: MetricScopeKind::Branch,\n            workspace_id: Some(workspace_id.into()),\n            branch: Some(branch.into()),\n            session_id: None,\n            user_id: None,\n            organization_id: None,\n            time_range: None,\n        }\n    }\n\n    /// Construct a repo scope.\n    pub fn repo(workspace_id: impl Into<String>) -> Self {\n        Self {\n            kind: MetricScopeKind::Repo,\n            workspace_id: Some(workspace_id.into()),\n            branch: None,\n            session_id: None,\n            user_id: None,\n            organization_id: None,\n            time_range: None,\n        }\n    }\n\n    /// Attach a UTC time range.\n    pub fn with_time_range(\n        mut self,\n        since: Option<DateTime<Utc>>,\n        until: Option<DateTime<Utc>>,\n    ) -> Self {\n        self.time_range = Some(MetricTimeRange { since, until });\n        self\n    }\n\n    fn time_matches(&self, timestamp: DateTime<Utc>) -> bool {\n        let Some(range) = &self.time_range else {\n            return true;\n        };\n        if let Some(since) = range.since {\n            if timestamp.unix_seconds() < since.unix_seconds() {\n                return false;\n            }\n        }\n        if let Some(until) = range.until {\n            if timestamp.unix_seconds() > until.unix_seconds() {\n                return false;\n            }\n        }\n        true\n    }\n\n    fn missing_dimension_reason(&self) -> Option<String> {\n        match self.kind {\n            MetricScopeKind::Session if self.session_id.is_none() => {\n                Some(\"session scope requires session_id\".to_string())\n            }\n            MetricScopeKind::Branch if self.workspace_id.is_none() || self.branch.is_none() => {\n                Some(\"branch scope requires workspace_id and branch\".to_string())\n            }\n            MetricScopeKind::Repo if self.workspace_id.is_none() => {\n                Some(\"repo scope requires workspace_id\".to_string())\n            }\n            MetricScopeKind::User if self.user_id.is_none() => {\n                Some(\"user scope requires user_id\".to_string())\n            }\n            MetricScopeKind::Organization if self.organization_id.is_none() => {\n                Some(\"organization scope requires organization_id\".to_string())\n            }\n            _ => None,\n        }\n    }\n\n    fn matches_event(&self, event: &EventEnvelope) -> bool {\n        if !self.time_matches(event.timestamp) {\n            return false;\n        }\n        match self.kind {\n            MetricScopeKind::Session => self\n                .session_id\n                .as_ref()\n                .is_some_and(|session_id| session_id == &event.session_id.value),\n            MetricScopeKind::Branch => {\n                self.workspace_id.as_ref() == Some(&event.workspace_id)\n                    && self.branch.as_ref() == Some(&event.branch.name)\n            }\n            MetricScopeKind::Repo => self.workspace_id.as_ref() == Some(&event.workspace_id),\n            MetricScopeKind::User => false,\n            MetricScopeKind::Organization => false,\n        }\n    }\n\n    fn matches_sample(&self, sample: &MetricSampleScope) -> bool {\n        if !self.time_matches(sample.observed_at) {\n            return false;\n        }\n        match self.kind {\n            MetricScopeKind::Session => self.session_id.as_ref() == sample.session_id.as_ref(),\n            MetricScopeKind::Branch => {\n                self.workspace_id.as_ref() == Some(&sample.workspace_id)\n                    && self.branch.as_ref() == sample.branch.as_ref()\n            }\n            MetricScopeKind::Repo => self.workspace_id.as_ref() == Some(&sample.workspace_id),\n            MetricScopeKind::User => self.user_id.as_ref() == sample.user_id.as_ref(),\n            MetricScopeKind::Organization => {\n                self.organization_id.as_ref() == sample.organization_id.as_ref()\n            }\n        }\n    }\n\n    fn label(&self) -> &'static str {\n        match self.kind {\n            MetricScopeKind::Session => \"session\",\n            MetricScopeKind::Branch => \"branch\",\n            MetricScopeKind::Repo => \"repo\",\n            MetricScopeKind::User => \"user\",\n            MetricScopeKind::Organization => \"organization\",\n        }\n    }\n}\n\n/// One collected metric snapshot.\n#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]\npub struct MetricValue {\n    /// Signal name.\n    pub signal: MetricSignal,\n    /// Metric value when enough evidence exists to compute it.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub value: Option<f64>,\n    /// Optional denominator used for ratio or mean reporting.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub denominator: Option<u64>,\n    /// Number of contributing samples actually processed.\n    pub sample_count: u64,\n    /// Provenance for this metric.\n    pub source: MetricSource,\n    /// UTC timestamp when the value was computed.\n    pub computed_at: DateTime<Utc>,\n    /// Whether the collector truncated evidence due to bounds.\n    pub incomplete: bool,\n    /// Truthful reason for a null value.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub reason_if_null: Option<String>,\n}\n\n/// Shared scope metadata for non-event benchmark samples.\n#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\npub struct MetricSampleScope {\n    /// Workspace that owns the sample.\n    pub workspace_id: String,\n    /// Optional branch for branch-scoped samples.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub branch: Option<String>,\n    /// Optional session id for session-scoped samples.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub session_id: Option<String>,\n    /// Optional user id for user-scoped samples.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub user_id: Option<String>,\n    /// Optional organization id for organization-scoped samples.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub organization_id: Option<String>,\n    /// Optional task id for task-local samples.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub task_id: Option<String>,\n    /// Timestamp used for time-range filtering.\n    pub observed_at: DateTime<Utc>,\n}\n\n/// One retrieved memory entry enriched with verifier and usefulness facts.\n#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\npub struct MemorySurfaceRecord {\n    /// Scope coordinates for this retrieval entry.\n    pub scope: MetricSampleScope,\n    /// Event that surfaced the memory.\n    pub retrieval_event_id: EventId,\n    /// Retrieved memory identifier.\n    pub memory_id: MemoryId,\n    /// Verification status at retrieval time.\n    pub verification_status: VerificationStatus,\n    /// Whether the surfaced payload labeled the memory as stale.\n    pub stale_label_surfaced: bool,\n    /// Whether a contradiction link existed when surfaced.\n    pub contradiction_link_present: bool,\n    /// Whether the surfaced payload exposed the contradiction.\n    pub contradiction_surfaced: bool,\n    /// Whether the memory was used downstream after retrieval.\n    pub used_downstream: bool,\n    /// Whether the memory was reused later in the same or later session window.\n    pub reused_later: bool,\n}\n\n/// Golden anchor-recall benchmark sample.\n#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\npub struct AnchorRecallSample {\n    /// Scope coordinates for the benchmark sample.\n    pub scope: MetricSampleScope,\n    /// Golden anchors expected for the task.\n    pub golden_anchors: Vec<String>,\n    /// Anchors returned by the workflow bundle.\n    pub returned_anchors: Vec<String>,\n}\n\n/// Golden test-recommendation benchmark sample.\n#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\npub struct TestRecommendationSample {\n    /// Scope coordinates for the benchmark sample.\n    pub scope: MetricSampleScope,\n    /// Tests recommended by `find_relevant_tests`.\n    pub recommended_tests: Vec<String>,\n    /// Tests required by the golden answer.\n    pub needed_tests: Vec<String>,\n}\n\n/// Deterministic bounded collector for Phase 9 metrics.\n#[derive(Clone, Debug, Default)]\npub struct MetricsCollector {\n    events: Vec<EventEnvelope>,\n    memory_surface_records: Vec<MemorySurfaceRecord>,\n    anchor_recall_samples: Vec<AnchorRecallSample>,\n    test_recommendation_samples: Vec<TestRecommendationSample>,\n    max_samples: usize,\n    computed_at: Option<DateTime<Utc>>,\n}\n\nimpl MetricsCollector {\n    /// Create an empty collector.\n    pub fn new() -> Self {\n        Self {\n            max_samples: DEFAULT_MAX_SAMPLES,\n            ..Self::default()\n        }\n    }\n\n    /// Replace the event-log evidence used by the collector.\n    pub fn with_events(mut self, events: Vec<EventEnvelope>) -> Self {\n        self.events = events;\n        self\n    }\n\n    /// Replace the memory surface evidence used by the collector.\n    pub fn with_memory_surface_records(mut self, records: Vec<MemorySurfaceRecord>) -> Self {\n        self.memory_surface_records = records;\n        self\n    }\n\n    /// Replace the golden anchor-recall samples used by the collector.\n    pub fn with_anchor_recall_samples(mut self, samples: Vec<AnchorRecallSample>) -> Self {\n        self.anchor_recall_samples = samples;\n        self\n    }\n\n    /// Replace the test-recommendation samples used by the collector.\n    pub fn with_test_recommendation_samples(\n        mut self,\n        samples: Vec<TestRecommendationSample>,\n    ) -> Self {\n        self.test_recommendation_samples = samples;\n        self\n    }\n\n    /// Override the maximum number of samples processed per signal.\n    pub fn with_max_samples(mut self, max_samples: usize) -> Self {\n        self.max_samples = max_samples.max(1);\n        self\n    }\n\n    /// Override the computed-at timestamp for deterministic tests.\n    pub fn with_computed_at(mut self, computed_at: DateTime<Utc>) -> Self {\n        self.computed_at = Some(computed_at);\n        self\n    }\n\n    /// Collect the requested signals for the given scope.\n    pub fn collect(&self, scope: MetricScope, signals: &[MetricSignal]) -> Vec<MetricValue> {\n        let selected = select_signals(signals);\n        selected\n            .into_iter()\n            .map(|signal| self.collect_signal(&scope, signal))\n            .collect()\n    }\n\n    fn collect_signal(&self, scope: &MetricScope, signal: MetricSignal) -> MetricValue {\n        let source = signal_source(signal);\n        let Some(reason) = scope\n            .missing_dimension_reason()\n            .filter(|_| scope_needs_dimensions(signal))\n        else {\n            let metric = match signal {\n                MetricSignal::ToolCallsPerSuccessfulTask => {\n                    self.collect_tool_calls_per_successful_task(scope)\n                }\n                MetricSignal::IrrelevantFilesOpenedPerTask => {\n                    self.collect_irrelevant_files_opened_per_task(scope)\n                }\n                MetricSignal::RelevantAnchorRecall => self.collect_relevant_anchor_recall(scope),\n                MetricSignal::MemoryInclusionPrecision => {\n                    self.collect_memory_inclusion_precision(scope)\n                }\n                MetricSignal::MemoryLaterUsedRate => self.collect_memory_later_used_rate(scope),\n                MetricSignal::StaleMemorySurfacedRate => {\n                    self.collect_stale_memory_surfaced_rate(scope)\n                }\n                MetricSignal::ContradictionMissedRate => {\n                    self.collect_contradiction_missed_rate(scope)\n                }\n                MetricSignal::TestsRecommendedVsNeeded => {\n                    self.collect_tests_recommended_vs_needed(scope)\n                }\n                MetricSignal::WorkflowSuccessAfterFirstPlan => {\n                    self.collect_workflow_success_after_first_plan(scope)\n                }\n            };\n            return finalize_metric(metric, signal, source, scope.label(), self.now());\n        };\n        finalize_metric(\n            SignalMetric::null(reason, false),\n            signal,\n            source,\n            scope.label(),\n            self.now(),\n        )\n    }\n\n    fn collect_tool_calls_per_successful_task(&self, scope: &MetricScope) -> SignalMetric {\n        let events = bounded_events(&self.events, scope, self.max_samples);\n        let tasks = successful_task_metrics(&events.items);\n        mean_metric(\n            tasks\n                .iter()\n                .map(|metric| metric.tool_calls as f64)\n                .collect(),\n            tasks.len() as u64,\n            events.incomplete,\n            \"no successful tasks matched the requested scope\",\n        )\n    }\n\n    fn collect_irrelevant_files_opened_per_task(&self, scope: &MetricScope) -> SignalMetric {\n        let events = bounded_events(&self.events, scope, self.max_samples);\n        let tasks = successful_task_metrics(&events.items);\n        let values = tasks\n            .iter()\n            .map(|metric| count_irrelevant_file_reads(metric) as f64)\n            .collect::<Vec<_>>();\n        mean_metric(\n            values,\n            tasks.len() as u64,\n            events.incomplete,\n            \"no successful tasks matched the requested scope\",\n        )\n    }\n\n    fn collect_relevant_anchor_recall(&self, scope: &MetricScope) -> SignalMetric {\n        let samples = bounded_samples(\n            &self.anchor_recall_samples,\n            scope,\n            self.max_samples,\n            |sample| &sample.scope,\n        );\n        ratio_metric(\n            samples\n                .items\n                .iter()\n                .map(anchor_recall_counts)\n                .fold((0u64, 0u64), accumulate_pair),\n            samples.items.len() as u64,\n            samples.incomplete,\n            \"no anchor recall samples matched the requested scope\",\n        )\n    }\n\n    fn collect_memory_inclusion_precision(&self, scope: &MetricScope) -> SignalMetric {\n        let records = bounded_samples(\n            &self.memory_surface_records,\n            scope,\n            self.max_samples,\n            |record| &record.scope,\n        );\n        ratio_metric(\n            usage_counts(&records.items, |record| record.used_downstream),\n            records.items.len() as u64,\n            records.incomplete,\n            \"no retrieved memories matched the requested scope\",\n        )\n    }\n\n    fn collect_memory_later_used_rate(&self, scope: &MetricScope) -> SignalMetric {\n        let records = bounded_samples(\n            &self.memory_surface_records,\n            scope,\n            self.max_samples,\n            |record| &record.scope,\n        );\n        ratio_metric(\n            usage_counts(&records.items, |record| record.reused_later),\n            records.items.len() as u64,\n            records.incomplete,\n            \"no retrieved memories matched the requested scope\",\n        )\n    }\n\n    fn collect_stale_memory_surfaced_rate(&self, scope: &MetricScope) -> SignalMetric {\n        let records = bounded_samples(\n            &self.memory_surface_records,\n            scope,\n            self.max_samples,\n            |record| &record.scope,\n        );\n        let counts = filtered_ratio_counts(&records.items, is_stale_record, |record| {\n            !record.stale_label_surfaced\n        });\n        ratio_metric(\n            counts,\n            counts.1,\n            records.incomplete,\n            \"no stale retrieved memories matched the requested scope\",\n        )\n    }\n\n    fn collect_contradiction_missed_rate(&self, scope: &MetricScope) -> SignalMetric {\n        let records = bounded_samples(\n            &self.memory_surface_records,\n            scope,\n            self.max_samples,\n            |record| &record.scope,\n        );\n        let counts = filtered_ratio_counts(&records.items, has_contradiction_link, |record| {\n            !record.contradiction_surfaced\n        });\n        ratio_metric(\n            counts,\n            counts.1,\n            records.incomplete,\n            \"no contradicted retrieved memories matched the requested scope\",\n        )\n    }\n\n    fn collect_tests_recommended_vs_needed(&self, scope: &MetricScope) -> SignalMetric {\n        let samples = bounded_samples(\n            &self.test_recommendation_samples,\n            scope,\n            self.max_samples,\n            |sample| &sample.scope,\n        );\n        ratio_metric(\n            samples\n                .items\n                .iter()\n                .map(test_recommendation_counts)\n                .fold((0u64, 0u64), accumulate_pair),\n            samples.items.len() as u64,\n            samples.incomplete,\n            \"no test recommendation samples matched the requested scope\",\n        )\n    }\n\n    fn collect_workflow_success_after_first_plan(&self, scope: &MetricScope) -> SignalMetric {\n        let events = bounded_events(&self.events, scope, self.max_samples);\n        let tasks = planned_task_metrics(&events.items);\n        let succeeded = tasks\n            .iter()\n            .filter(|metric| metric.succeeded_after_first_plan)\n            .count() as u64;\n        ratio_metric(\n            (succeeded, tasks.len() as u64),\n            tasks.len() as u64,\n            events.incomplete,\n            \"no planned tasks matched the requested scope\",\n        )\n    }\n\n    fn now(&self) -> DateTime<Utc> {\n        self.computed_at.unwrap_or_else(Utc::now)\n    }\n}\n\n#[derive(Clone, Debug)]\nstruct SignalMetric {\n    value: Option<f64>,\n    denominator: Option<u64>,\n    sample_count: u64,\n    incomplete: bool,\n    reason_if_null: Option<String>,\n}\n\nimpl SignalMetric {\n    fn null(reason: impl Into<String>, incomplete: bool) -> Self {\n        Self {\n            value: None,\n            denominator: None,\n            sample_count: 0,\n            incomplete,\n            reason_if_null: Some(reason.into()),\n        }\n    }\n}\n\n#[derive(Clone, Debug)]\nstruct BoundedData<T> {\n    items: Vec<T>,\n    incomplete: bool,\n}\n\n#[derive(Clone, Debug)]\nstruct SuccessfulTaskMetric {\n    tool_calls: usize,\n    read_files: BTreeSet<String>,\n    changed_files: BTreeSet<String>,\n    artifact_files: BTreeSet<String>,\n}\n\n#[derive(Clone, Debug)]\nstruct PlannedTaskMetric {\n    succeeded_after_first_plan: bool,\n}\n\nfn finalize_metric(\n    metric: SignalMetric,\n    signal: MetricSignal,\n    source: MetricSource,\n    scope_label: &str,\n    computed_at: DateTime<Utc>,\n) -> MetricValue {\n    let _span = debug_span!(\n        \"metrics.collect_signal\",\n        signal = signal.as_str(),\n        scope = scope_label,\n        sample_count = metric.sample_count,\n        incomplete = metric.incomplete\n    )\n    .entered();\n    MetricValue {\n        signal,\n        value: metric.value,\n        denominator: metric.denominator,\n        sample_count: metric.sample_count,\n        source,\n        computed_at,\n        incomplete: metric.incomplete,\n        reason_if_null: metric.reason_if_null,\n    }\n}\n\nfn select_signals(signals: &[MetricSignal]) -> Vec<MetricSignal> {\n    if signals.is_empty() {\n        return MetricSignal::ALL.to_vec();\n    }\n    signals.to_vec()\n}\n\nfn signal_source(signal: MetricSignal) -> MetricSource {\n    match signal {\n        MetricSignal::ToolCallsPerSuccessfulTask => MetricSource::EventLog,\n        MetricSignal::IrrelevantFilesOpenedPerTask => MetricSource::EventLog,\n        MetricSignal::RelevantAnchorRecall => MetricSource::EventLog,\n        MetricSignal::MemoryInclusionPrecision => MetricSource::MemoryStore,\n        MetricSignal::MemoryLaterUsedRate => MetricSource::MemoryStore,\n        MetricSignal::StaleMemorySurfacedRate => MetricSource::Verifier,\n        MetricSignal::ContradictionMissedRate => MetricSource::Verifier,\n        MetricSignal::TestsRecommendedVsNeeded => MetricSource::WorkflowOutcome,\n        MetricSignal::WorkflowSuccessAfterFirstPlan => MetricSource::WorkflowOutcome,\n    }\n}\n\nfn scope_needs_dimensions(_signal: MetricSignal) -> bool {\n    true\n}\n\nfn bounded_events(\n    events: &[EventEnvelope],\n    scope: &MetricScope,\n    max_samples: usize,\n) -> BoundedData<EventEnvelope> {\n    let filtered = events\n        .iter()\n        .filter(|event| scope.matches_event(event))\n        .cloned()\n        .collect::<Vec<_>>();\n    truncate_items(filtered, max_samples)\n}\n\nfn bounded_samples<T: Clone, F>(\n    samples: &[T],\n    scope: &MetricScope,\n    max_samples: usize,\n    sample_scope: F,\n) -> BoundedData<T>\nwhere\n    F: Fn(&T) -> &MetricSampleScope,\n{\n    let filtered = samples\n        .iter()\n        .filter(|sample| scope.matches_sample(sample_scope(sample)))\n        .cloned()\n        .collect::<Vec<_>>();\n    truncate_items(filtered, max_samples)\n}\n\nfn truncate_items<T>(items: Vec<T>, max_samples: usize) -> BoundedData<T> {\n    let incomplete = items.len() > max_samples;\n    let items = items.into_iter().take(max_samples).collect();\n    BoundedData { items, incomplete }\n}\n\nfn successful_task_metrics(events: &[EventEnvelope]) -> Vec<SuccessfulTaskMetric> {\n    let groups = group_events_by_task(events);\n    groups\n        .into_values()\n        .filter_map(|task_events| successful_task_metric(&task_events))\n        .collect()\n}\n\nfn successful_task_metric(events: &[EventEnvelope]) -> Option<SuccessfulTaskMetric> {\n    if !is_successful_task(events) {\n        return None;\n    }\n    let tool_calls = events\n        .iter()\n        .filter(|event| event.kind == EventKind::ToolCalled)\n        .count();\n    let read_files = collect_file_reads(events);\n    let changed_files = collect_patch_files(events);\n    let artifact_files = collect_workflow_artifact_files(events);\n    Some(SuccessfulTaskMetric {\n        tool_calls,\n        read_files,\n        changed_files,\n        artifact_files,\n    })\n}\n\nfn planned_task_metrics(events: &[EventEnvelope]) -> Vec<PlannedTaskMetric> {\n    group_events_by_task(events)\n        .into_values()\n        .filter_map(|task_events| planned_task_metric(&task_events))\n        .collect()\n}\n\nfn planned_task_metric(events: &[EventEnvelope]) -> Option<PlannedTaskMetric> {\n    let first_plan_index = events\n        .iter()\n        .position(|event| event.kind == EventKind::PlanCreated)?;\n    let has_failure_after_plan = events[first_plan_index + 1..]\n        .iter()\n        .any(|event| event.kind == EventKind::WorkflowFailed);\n    let has_success_after_plan = events[first_plan_index + 1..]\n        .iter()\n        .any(|event| event.kind == EventKind::WorkflowSucceeded);\n    Some(PlannedTaskMetric {\n        succeeded_after_first_plan: has_success_after_plan && !has_failure_after_plan,\n    })\n}\n\nfn group_events_by_task(events: &[EventEnvelope]) -> BTreeMap<String, Vec<EventEnvelope>> {\n    let mut groups = BTreeMap::new();\n    for event in events.iter().filter(|event| event.task_id.is_some()) {\n        let task_id = event\n            .task_id\n            .as_ref()\n            .map(|task_id| task_id.value.clone())\n            .unwrap_or_default();\n        groups\n            .entry(task_id)\n            .or_insert_with(Vec::new)\n            .push(event.clone());\n    }\n    groups\n}\n\nfn is_successful_task(events: &[EventEnvelope]) -> bool {\n    let mut terminal: Option<EventKind> = None;\n    for event in events {\n        if matches!(\n            event.kind,\n            EventKind::WorkflowSucceeded | EventKind::WorkflowFailed\n        ) {\n            terminal = Some(event.kind);\n        }\n    }\n    terminal == Some(EventKind::WorkflowSucceeded)\n}\n\nfn collect_file_reads(events: &[EventEnvelope]) -> BTreeSet<String> {\n    events\n        .iter()\n        .filter_map(read_file_path)\n        .collect::<BTreeSet<_>>()\n}\n\nfn collect_patch_files(events: &[EventEnvelope]) -> BTreeSet<String> {\n    events\n        .iter()\n        .flat_map(patch_file_paths)\n        .collect::<BTreeSet<_>>()\n}\n\nfn collect_workflow_artifact_files(events: &[EventEnvelope]) -> BTreeSet<String> {\n    let successful_memory_ids = events\n        .iter()\n        .filter_map(success_payload)\n        .flat_map(|payload| payload.memory_ids.iter().cloned())\n        .collect::<HashSet<_>>();\n    let mut files = BTreeSet::new();\n    for event in events {\n        if let EventPayload::MemoryRetrieved(payload) = &event.payload {\n            if payload\n                .memory_ids\n                .iter()\n                .any(|memory_id| successful_memory_ids.contains(memory_id))\n            {\n                files.extend(identity_file_paths(&payload.included_context));\n            }\n        }\n        if let EventPayload::MemoryExpanded(payload) = &event.payload {\n            if payload\n                .memory_id\n                .as_ref()\n                .is_some_and(|memory_id| successful_memory_ids.contains(memory_id))\n            {\n                files.extend(identity_file_paths(&payload.included_context));\n            }\n        }\n    }\n    files\n}\n\nfn read_file_path(event: &EventEnvelope) -> Option<String> {\n    let EventPayload::FileRead(FileReadPayload { file_id, .. }) = &event.payload else {\n        return None;\n    };\n    Some(file_id.repo_relative_path.clone())\n}\n\nfn patch_file_paths(event: &EventEnvelope) -> Vec<String> {\n    let EventPayload::PatchApplied(PatchAppliedPayload { file_ids, .. }) = &event.payload else {\n        return Vec::new();\n    };\n    file_ids\n        .iter()\n        .map(|file_id| file_id.repo_relative_path.clone())\n        .collect()\n}\n\nfn success_payload(event: &EventEnvelope) -> Option<&WorkflowSucceededPayload> {\n    let EventPayload::WorkflowSucceeded(payload) = &event.payload else {\n        return None;\n    };\n    Some(payload)\n}\n\nfn identity_file_paths(\n    included_context: &[crate::events::IncludedContextDelta],\n) -> BTreeSet<String> {\n    included_context\n        .iter()\n        .filter_map(|delta| match &delta.identity {\n            crate::identity::Identity::File(file_id) => Some(file_id.repo_relative_path.clone()),\n            crate::identity::Identity::Symbol(symbol_id) => {\n                Some(symbol_id.file.repo_relative_path.clone())\n            }\n            _ => None,\n        })\n        .collect()\n}\n\nfn count_irrelevant_file_reads(task: &SuccessfulTaskMetric) -> usize {\n    task.read_files\n        .iter()\n        .filter(|path| !task.changed_files.contains(*path) && !task.artifact_files.contains(*path))\n        .count()\n}\n\nfn anchor_recall_counts(sample: &AnchorRecallSample) -> (u64, u64) {\n    let returned = sample\n        .returned_anchors\n        .iter()\n        .map(|anchor| anchor.as_str())\n        .collect::<HashSet<_>>();\n    let hits = sample\n        .golden_anchors\n        .iter()\n        .filter(|anchor| returned.contains(anchor.as_str()))\n        .count() as u64;\n    (hits, sample.golden_anchors.len() as u64)\n}\n\nfn usage_counts<F>(records: &[MemorySurfaceRecord], predicate: F) -> (u64, u64)\nwhere\n    F: Fn(&MemorySurfaceRecord) -> bool,\n{\n    let hits = records.iter().filter(|record| predicate(record)).count() as u64;\n    (hits, records.len() as u64)\n}\n\nfn filtered_ratio_counts<F, G>(records: &[MemorySurfaceRecord], include: F, hit: G) -> (u64, u64)\nwhere\n    F: Fn(&MemorySurfaceRecord) -> bool,\n    G: Fn(&MemorySurfaceRecord) -> bool,\n{\n    let filtered = records\n        .iter()\n        .filter(|record| include(record))\n        .collect::<Vec<_>>();\n    let hits = filtered.iter().filter(|record| hit(record)).count() as u64;\n    (hits, filtered.len() as u64)\n}\n\nfn is_stale_record(record: &MemorySurfaceRecord) -> bool {\n    record.verification_status == VerificationStatus::Stale\n}\n\nfn has_contradiction_link(record: &MemorySurfaceRecord) -> bool {\n    record.contradiction_link_present\n}\n\nfn test_recommendation_counts(sample: &TestRecommendationSample) -> (u64, u64) {\n    let recommended = sample\n        .recommended_tests\n        .iter()\n        .map(|test| test.as_str())\n        .collect::<HashSet<_>>();\n    let hits = sample\n        .needed_tests\n        .iter()\n        .filter(|test| recommended.contains(test.as_str()))\n        .count() as u64;\n    (hits, sample.needed_tests.len() as u64)\n}\n\nfn accumulate_pair(acc: (u64, u64), item: (u64, u64)) -> (u64, u64) {\n    (acc.0 + item.0, acc.1 + item.1)\n}\n\nfn ratio_metric(\n    counts: (u64, u64),\n    sample_count: u64,\n    incomplete: bool,\n    no_data_reason: &str,\n) -> SignalMetric {\n    if counts.1 == 0 {\n        return SignalMetric::null(no_data_reason, incomplete);\n    }\n    SignalMetric {\n        value: Some(counts.0 as f64 / counts.1 as f64),\n        denominator: Some(counts.1),\n        sample_count,\n        incomplete,\n        reason_if_null: None,\n    }\n}\n\nfn mean_metric(\n    values: Vec<f64>,\n    denominator: u64,\n    incomplete: bool,\n    no_data_reason: &str,\n) -> SignalMetric {\n    if values.is_empty() {\n        return SignalMetric::null(no_data_reason, incomplete);\n    }\n    let total = values.iter().sum::<f64>();\n    SignalMetric {\n        value: Some(total / values.len() as f64),\n        denominator: Some(denominator),\n        sample_count: values.len() as u64,\n        incomplete,\n        reason_if_null: None,\n    }\n}\n","numLines":1018,"startLine":1,"totalLines":1018}}}
