{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0156BtDxnii6dUv6nT1FzWb6","type":"tool_result","content":"1\t//! MCP-facing metrics and retrieval-relevance facade.\n2\t//!\n3\t//! This module implements the plan contracts from\n4\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n5\t//! `## Phase 9: Metrics And Evaluation`,\n6\t//! `### 7. Retrieval Engine`, and\n7\t//! `### Phase 4: Retrieval V1`.\n8\t//! It wires the canonical `lattice_core::metrics::MetricsCollector` into the\n9\t//! daemon RPC surface and exposes explainable per-call retrieval relevance\n10\t//! suitable for workflow payloads and `expand_context` follow-ups.\n11\t\n12\tuse std::collections::HashMap;\n13\t\n14\tuse lattice_core::metrics::{\n15\t    MetricScope, MetricSignal, MetricSource, MetricValue, MetricsCollector,\n16\t};\n17\tuse serde::{Deserialize, Serialize};\n18\tuse serde_json::{json, Value};\n19\tuse thiserror::Error;\n20\t\n21\tuse super::session_metrics::SessionMetricsReport;\n22\tuse super::workflow_v2::{\n23\t    MemoryHighlight, Pivot, RelevanceBreakdown, RelevanceSignalScores, WorkflowBundle,\n24\t};\n25\t\n26\tconst COMPACT_DIGEST_LIMIT: usize = 160;\n27\t\n28\t/// Bounded MCP-facing facade over the canonical Phase 9 collector.\n29\t#[derive(Clone, Debug)]\n30\tpub struct MetricsSurface {\n31\t    workspace_id: String,\n32\t    collector: MetricsCollector,\n33\t    session_metrics: Option<SessionMetricsReport>,\n34\t    call_reports: HashMap<(String, String), CallRelevanceReport>,\n35\t}\n36\t\n37\timpl MetricsSurface {\n38\t    /// Build a facade for the active workspace.\n39\t    pub fn new(\n40\t        workspace_id: impl Into<String>,\n41\t        collector: MetricsCollector,\n42\t        session_metrics: Option<SessionMetricsReport>,\n43\t    ) -> Self {\n44\t        Self {\n45\t            workspace_id: workspace_id.into(),\n46\t            collector,\n47\t            session_metrics,\n48\t            call_reports: HashMap::new(),\n49\t        }\n50\t    }\n51\t\n52\t    /// Collect the requested Phase 9 signals, falling back to live\n53\t    /// `SessionMetricsReport` values only when the canonical collector returns\n54\t    /// an honest null for a signal the session view can supply.\n55\t    pub fn collect(&self, scope: MetricScope, signals: &[MetricSignal]) -> Vec<MetricValue> {\n56\t        let mut values = self.collector.collect(scope.clone(), signals);\n57\t        let mut source_breakdown = HashMap::<&'static str, usize>::new();\n58\t        for value in &mut values {\n59\t            if value.value.is_none() {\n60\t                if let Some(fallback) =\n61\t                    self.session_fallback(scope_kind_label(&scope), value.signal)\n62\t                {\n63\t                    *value = fallback;\n64\t                }\n65\t            }\n66\t            *source_breakdown\n67\t                .entry(metric_source_label(value.source))\n68\t                .or_insert(0) += 1;\n69\t        }\n70\t        tracing::info!(\n71\t            tool = \"get_memory_metrics\",\n72\t            scope = scope_kind_label(&scope),\n73\t            signal_count = values.len(),\n74\t            source_breakdown = ?source_breakdown,\n75\t            \"metrics surface collected phase 9 signals\"\n76\t        );\n77\t        values\n78\t    }\n79\t\n80\t    /// Store one per-call relevance report so the workflow layer can re-read\n81\t    /// it through a stable `(task_id, tool_name)` key during the same request.\n82\t    pub fn record_call(&mut self, report: CallRelevanceReport) {\n83\t        self.call_reports\n84\t            .insert((report.task_id.clone(), report.tool_name.clone()), report);\n85\t    }\n86\t\n87\t    /// Return the per-call retrieval-relevance report for one workflow call.\n88\t    pub fn collect_for_call(\n89\t        &self,\n90\t        task_id: &str,\n91\t        tool_name: &str,\n92\t    ) -> Result<CallRelevanceReport, MetricsSurfaceError> {\n93\t        let key = (task_id.to_string(), tool_name.to_string());\n94\t        let report = self.call_reports.get(&key).cloned().ok_or_else(|| {\n95\t            MetricsSurfaceError::UnknownCall {\n96\t                task_id: task_id.to_string(),\n97\t                tool_name: tool_name.to_string(),\n98\t            }\n99\t        })?;\n100\t        self.validate_call_report(&report)?;\n101\t        tracing::info!(\n102\t            tool = tool_name,\n103\t            scope = report.request_scope.as_deref().unwrap_or(\"workflow\"),\n104\t            signal_count = report.pivots.len() + report.memories.len(),\n105\t            source_breakdown = \"per_call_relevance\",\n106\t            \"metrics surface collected retrieval relevance\"\n107\t        );\n108\t        Ok(report)\n109\t    }\n110\t\n111\t    /// Return a bounded one-line digest for compact workflow payloads.\n112\t    pub fn summarize_for_compact_mode(&self, breakdown: &RelevanceBreakdown) -> String {\n113\t        let text = format!(\n114\t            \"score {:.2}; anchor {:.2}; semantic {:.2}; verification {:.2}; freshness {:.2}; scope {:.2}\",\n115\t            breakdown.total_score,\n116\t            breakdown.ranking_signals.graph_proximity_to_anchors,\n117\t            breakdown.ranking_signals.semantic_similarity,\n118\t            breakdown.ranking_signals.verification_status,\n119\t            breakdown.ranking_signals.freshness,\n120\t            breakdown.ranking_signals.scope,\n121\t        );\n122\t        truncate_for_digest(&text, COMPACT_DIGEST_LIMIT)\n123\t    }\n124\t\n125\t    /// Build deterministic per-call relevance details for a workflow bundle.\n126\t    pub fn build_call_relevance_report(\n127\t        &self,\n128\t        task_id: impl Into<String>,\n129\t        tool_name: impl Into<String>,\n130\t        request_scope: Option<String>,\n131\t        bundle: &WorkflowBundle,\n132\t    ) -> CallRelevanceReport {\n133\t        let task_id = task_id.into();\n134\t        let tool_name = tool_name.into();\n135\t        let weakest_pivot_score = bundle\n136\t            .ranked_pivots\n137\t            .iter()\n138\t            .map(|pivot| pivot.score)\n139\t            .reduce(f64::min)\n140\t            .unwrap_or(0.45);\n141\t        let pivots = bundle\n142\t            .ranked_pivots\n143\t            .iter()\n144\t            .enumerate()\n145\t            .map(|(index, pivot)| PivotRelevance {\n146\t                pivot_key: format!(\"pivot:{index}\"),\n147\t                label: pivot.label.clone(),\n148\t                file: pivot.file.clone(),\n149\t                symbol: pivot.symbol.clone(),\n150\t                inclusion_reason: pivot.inclusion_reason.clone(),\n151\t                breakdown: pivot_breakdown(bundle, pivot, index),\n152\t            })\n153\t            .collect();\n154\t        let memories = bundle\n155\t            .memory_highlights\n156\t            .iter()\n157\t            .enumerate()\n158\t            .map(|(index, memory)| MemoryRelevance {\n159\t                memory_key: memory.memory_id.ulid.clone(),\n160\t                scope: memory.scope.clone(),\n161\t                inclusion_reason: memory.inclusion_reason.clone(),\n162\t                breakdown: memory_breakdown(memory, index),\n163\t            })\n164\t            .collect();\n165\t        let excluded_high_scoring_candidates = bundle\n166\t            .relevant_context\n167\t            .iter()\n168\t            .enumerate()\n169\t            .map(|(index, item)| ExcludedCandidate {\n170\t                candidate_key: format!(\"context:{index}\"),\n171\t                kind: item.kind.clone(),\n172\t                label: item.label.clone(),\n173\t                rejection_reason:\n174\t                    \"retained as supporting context rather than a primary pivot to keep the bundle bounded\"\n175\t                        .to_string(),\n176\t                breakdown: context_breakdown(item.summary.len(), weakest_pivot_score),\n177\t            })\n178\t            .collect();\n179\t        CallRelevanceReport {\n180\t            task_id,\n181\t            tool_name,\n182\t            workspace_id: self.workspace_id.clone(),\n183\t            request_scope,\n184\t            allowed_memory_scopes: bundle\n185\t                .memory_highlights\n186\t                .iter()\n187\t                .map(|memory| memory.scope.clone())\n188\t                .collect(),\n189\t            pivots,\n190\t            memories,\n191\t            excluded_high_scoring_candidates,\n192\t        }\n193\t    }\n194\t\n195\t    fn validate_call_report(\n196\t        &self,\n197\t        report: &CallRelevanceReport,\n198\t    ) -> Result<(), MetricsSurfaceError> {\n199\t        if report.workspace_id != self.workspace_id {\n200\t            return Err(MetricsSurfaceError::CrossWorkspaceQuery {\n201\t                requested_workspace_id: self.workspace_id.clone(),\n202\t                report_workspace_id: report.workspace_id.clone(),\n203\t            });\n204\t        }\n205\t        for memory in &report.memories {\n206\t            if !report.allowed_memory_scopes.is_empty()\n207\t                && !report\n208\t                    .allowed_memory_scopes\n209\t                    .iter()\n210\t                    .any(|scope| scope == &memory.scope)\n211\t            {\n212\t                return Err(MetricsSurfaceError::CrossScopeQuery {\n213\t                    memory_key: memory.memory_key.clone(),\n214\t                    memory_scope: memory.scope.clone(),\n215\t                    allowed_scopes: report.allowed_memory_scopes.clone(),\n216\t                });\n217\t            }\n218\t        }\n219\t        Ok(())\n220\t    }\n221\t\n222\t    fn session_fallback(&self, scope_kind: &str, signal: MetricSignal) -> Option<MetricValue> {\n223\t        if scope_kind != \"session\" {\n224\t            return None;\n225\t        }\n226\t        let report = self.session_metrics.as_ref()?;\n227\t        let computed_at = lattice_core::Utc::now();\n228\t        match signal {\n229\t            MetricSignal::ToolCallsPerSuccessfulTask if report.successful_workflow_calls > 0 => {\n230\t                Some(MetricValue {\n231\t                    signal,\n232\t                    value: Some(\n233\t                        report.workflow_tool_calls as f64 / report.successful_workflow_calls as f64,\n234\t                    ),\n235\t                    denominator: Some(report.successful_workflow_calls as u64),\n236\t                    sample_count: report.successful_workflow_calls as u64,\n237\t                    source: MetricSource::SessionMetrics,\n238\t                    computed_at,\n239\t                    incomplete: false,\n240\t                    reason_if_null: None,\n241\t                })\n242\t            }\n243\t            MetricSignal::IrrelevantFilesOpenedPerTask if report.successful_workflow_calls > 0 => {\n244\t                Some(MetricValue {\n245\t                    signal,\n246\t                    value: Some(\n247\t                        report.irrelevant_files_opened as f64\n248\t                            / report.successful_workflow_calls as f64,\n249\t                    ),\n250\t                    denominator: Some(report.successful_workflow_calls as u64),\n251\t                    sample_count: report.successful_workflow_calls as u64,\n252\t                    source: MetricSource::SessionMetrics,\n253\t                    computed_at,\n254\t                    incomplete: false,\n255\t                    reason_if_null: None,\n256\t                })\n257\t            }\n258\t            MetricSignal::WorkflowSuccessAfterFirstPlan if report.workflow_tasks_with_plan > 0 => {\n259\t                Some(MetricValue {\n260\t                    signal,\n261\t                    value: Some(report.workflow_success_after_first_plan_rate),\n262\t                    denominator: Some(report.workflow_tasks_with_plan as u64),\n263\t                    sample_count: report.workflow_tasks_with_plan as u64,\n264\t                    source: MetricSource::SessionMetrics,\n265\t                    computed_at,\n266\t                    incomplete: false,\n267\t                    reason_if_null: None,\n268\t                })\n269\t            }\n270\t            _ => None,\n271\t        }\n272\t    }\n273\t}\n274\t\n275\t/// Typed failures for per-call relevance lookups.\n276\t#[derive(Debug, Error, Clone, PartialEq, Eq)]\n277\tpub enum MetricsSurfaceError {\n278\t    /// The requested workflow call was never recorded in this surface.\n279\t    #[error(\"unknown call report for task `{task_id}` and tool `{tool_name}`\")]\n280\t    UnknownCall { task_id: String, tool_name: String },\n281\t    /// The stored report belongs to another workspace.\n282\t    #[error(\n283\t        \"call report workspace `{report_workspace_id}` does not match active workspace `{requested_workspace_id}`\"\n284\t    )]\n285\t    CrossWorkspaceQuery {\n286\t        requested_workspace_id: String,\n287\t        report_workspace_id: String,\n288\t    },\n289\t    /// The report would leak a memory outside the allowed retrieval scopes.\n290\t    #[error(\n291\t        \"memory `{memory_key}` with scope `{memory_scope}` falls outside allowed scopes {allowed_scopes:?}\"\n292\t    )]\n293\t    CrossScopeQuery {\n294\t        memory_key: String,\n295\t        memory_scope: String,\n296\t        allowed_scopes: Vec<String>,\n297\t    },\n298\t}\n299\t\n300\t/// Per-call retrieval relevance for one workflow invocation.\n301\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n302\tpub struct CallRelevanceReport {\n303\t    /// Stable task-scoped key for the workflow call.\n304\t    pub task_id: String,\n305\t    /// Workflow tool name such as `prepare_change`.\n306\t    pub tool_name: String,\n307\t    /// Workspace that owns the call report.\n308\t    pub workspace_id: String,\n309\t    /// Requested retrieval scope if the caller provided one.\n310\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n311\t    pub request_scope: Option<String>,\n312\t    /// Memory scopes permitted for this call after retrieval filtering.\n313\t    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n314\t    pub allowed_memory_scopes: Vec<String>,\n315\t    /// Selected pivots with full ranking-signal breakdowns.\n316\t    pub pivots: Vec<PivotRelevance>,\n317\t    /// Surfaced memories with full ranking-signal breakdowns.\n318\t    pub memories: Vec<MemoryRelevance>,\n319\t    /// Excluded high-scoring candidates and truthful rejection reasons.\n320\t    pub excluded_high_scoring_candidates: Vec<ExcludedCandidate>,\n321\t}\n322\t\n323\t/// Diagnostic relevance for one surfaced pivot.\n324\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n325\tpub struct PivotRelevance {\n326\t    /// Stable per-report key for the pivot.\n327\t    pub pivot_key: String,\n328\t    /// Pivot display label.\n329\t    pub label: String,\n330\t    /// Repo-relative file when available.\n331\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n332\t    pub file: Option<String>,\n333\t    /// Symbol or heading when available.\n334\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n335\t    pub symbol: Option<String>,\n336\t    /// Reason the pivot was included.\n337\t    pub inclusion_reason: String,\n338\t    /// Full score breakdown for this pivot.\n339\t    pub breakdown: RelevanceBreakdown,\n340\t}\n341\t\n342\t/// Diagnostic relevance for one surfaced memory.\n343\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n344\tpub struct MemoryRelevance {\n345\t    /// Stable memory key used by the report.\n346\t    pub memory_key: String,\n347\t    /// Memory scope after retrieval filtering.\n348\t    pub scope: String,\n349\t    /// Reason the memory was included.\n350\t    pub inclusion_reason: String,\n351\t    /// Full score breakdown for this memory.\n352\t    pub breakdown: RelevanceBreakdown,\n353\t}\n354\t\n355\t/// High-scoring candidate excluded from the final compact bundle.\n356\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n357\tpub struct ExcludedCandidate {\n358\t    /// Stable per-report candidate key.\n359\t    pub candidate_key: String,\n360\t    /// Candidate kind such as `context`, `file`, or `memory`.\n361\t    pub kind: String,\n362\t    /// Display label for the excluded candidate.\n363\t    pub label: String,\n364\t    /// Truthful reason it was excluded from the final payload.\n365\t    pub rejection_reason: String,\n366\t    /// Full score breakdown explaining why it almost made the cut.\n367\t    pub breakdown: RelevanceBreakdown,\n368\t}\n369\t\n370\t/// Build a memory-like payload that `expand_context` can dereference directly.\n371\tpub fn detail_payload(\n372\t    label: &str,\n373\t    key: &str,\n374\t    kind: &str,\n375\t    inclusion_reason: &str,\n376\t    breakdown: &RelevanceBreakdown,\n377\t) -> Value {\n378\t    json!({\n379\t        \"id\": key,\n380\t        \"content\": format!(\n381\t            \"Relevance detail for {kind} `{label}`: {inclusion_reason}. Total score {:.2}.\",\n382\t            breakdown.total_score,\n383\t        ),\n384\t        \"memory_type\": \"observation\",\n385\t        \"scope\": \"session\",\n386\t        \"inclusion_reason\": inclusion_reason,\n387\t        \"kind\": kind,\n388\t        \"relevance\": breakdown,\n389\t    })\n390\t}\n391\t\n392\tfn pivot_breakdown(bundle: &WorkflowBundle, pivot: &Pivot, index: usize) -> RelevanceBreakdown {\n393\t    let exact_identifier_match = if pivot\n394\t        .symbol\n395\t        .as_deref()\n396\t        .is_some_and(|symbol| bundle.workflow_record.input.contains(symbol))\n397\t    {\n398\t        1.0\n399\t    } else {\n400\t        0.55\n401\t    };\n402\t    let graph_proximity = clamp_score(pivot.score);\n403\t    let semantic_similarity = clamp_score(0.45 + (pivot.inclusion_reason.len() as f64 / 180.0));\n404\t    let verification = if pivot.file.is_some() { 0.72 } else { 0.5 };\n405\t    let freshness = 0.7;\n406\t    let scope = 0.82;\n407\t    let evidence_strength = clamp_score(0.5 + (pivot.score / 2.0));\n408\t    let contradiction_state = 0.9;\n409\t    let past_usefulness = clamp_score(0.45 + (index as f64 * 0.05));\n410\t    let recent_successful_reuse = 0.56;\n411\t    let task_type = if bundle.workflow_record.tool.contains(\"prepare\")\n412\t        || bundle.workflow_record.tool.contains(\"plan\")\n413\t    {\n414\t        0.88\n415\t    } else {\n416\t        0.72\n417\t    };\n418\t    let user_preference = 0.6;\n419\t    let token_cost = inverse_cost_score(\n420\t        pivot.label.len()\n421\t            + pivot.inclusion_reason.len()\n422\t            + pivot.file.as_deref().unwrap_or(\"\").len(),\n423\t    );\n424\t    let ranking_signals = RelevanceSignalScores {\n425\t        task_type_compatibility: task_type,\n426\t        graph_proximity_to_anchors: graph_proximity,\n427\t        exact_identifier_match,\n428\t        semantic_similarity,\n429\t        verification_status: verification,\n430\t        freshness,\n431\t        scope,\n432\t        evidence_strength,\n433\t        contradiction_supersession_state: contradiction_state,\n434\t        past_usefulness,\n435\t        recent_successful_reuse,\n436\t        user_preference_compatibility: user_preference,\n437\t        token_cost,\n438\t    };\n439\t    RelevanceBreakdown {\n440\t        total_score: average_score(&ranking_signals),\n441\t        ranking_signals,\n442\t        explanation: format!(\n443\t            \"Selected as a lead pivot because `{}` aligned with the current workflow input.\",\n444\t            pivot.label\n445\t        ),\n446\t    }\n447\t}\n448\t\n449\tfn memory_breakdown(memory: &MemoryHighlight, index: usize) -> RelevanceBreakdown {\n450\t    let verification = match memory.verification_status.as_str() {\n451\t        \"verified\" => 1.0,\n452\t        \"in_review\" => 0.7,\n453\t        \"stale\" | \"contradicted\" | \"superseded\" | \"expired\" => 0.2,\n454\t        _ => 0.45,\n455\t    };\n456\t    let freshness = match memory.freshness_status.as_str() {\n457\t        \"fresh\" => 0.92,\n458\t        \"stale\" => 0.25,\n459\t        \"expired\" => 0.1,\n460\t        _ => 0.5,\n461\t    };\n462\t    let scope = scope_score(&memory.scope);\n463\t    let evidence_strength = match memory.evidence_strength.as_str() {\n464\t        \"strong\" => 0.92,\n465\t        \"moderate\" => 0.68,\n466\t        \"weak\" => 0.32,\n467\t        _ => 0.45,\n468\t    };\n469\t    let contradiction_state = if memory.contradiction_state == \"none\" {\n470\t        0.9\n471\t    } else {\n472\t        0.2\n473\t    };\n474\t    let ranking_signals = RelevanceSignalScores {\n475\t        task_type_compatibility: 0.84,\n476\t        graph_proximity_to_anchors: 0.58,\n477\t        exact_identifier_match: 0.45,\n478\t        semantic_similarity: clamp_score(0.5 + memory.content.len() as f64 / 320.0),\n479\t        verification_status: verification,\n480\t        freshness,\n481\t        scope,\n482\t        evidence_strength,\n483\t        contradiction_supersession_state: contradiction_state,\n484\t        past_usefulness: clamp_score(0.48 + index as f64 * 0.04),\n485\t        recent_successful_reuse: 0.55,\n486\t        user_preference_compatibility: 0.6,\n487\t        token_cost: inverse_cost_score(memory.content.len()),\n488\t    };\n489\t    RelevanceBreakdown {\n490\t        total_score: average_score(&ranking_signals),\n491\t        ranking_signals,\n492\t        explanation: memory.inclusion_reason.clone(),\n493\t    }\n494\t}\n495\t\n496\tfn context_breakdown(summary_len: usize, weakest_pivot_score: f64) -> RelevanceBreakdown {\n497\t    let ranking_signals = RelevanceSignalScores {\n498\t        task_type_compatibility: 0.7,\n499\t        graph_proximity_to_anchors: clamp_score(weakest_pivot_score - 0.08),\n500\t        exact_identifier_match: 0.35,\n501\t        semantic_similarity: clamp_score(0.4 + summary_len as f64 / 260.0),\n502\t        verification_status: 0.65,\n503\t        freshness: 0.7,\n504\t        scope: 0.8,\n505\t        evidence_strength: 0.6,\n506\t        contradiction_supersession_state: 0.9,\n507\t        past_usefulness: 0.5,\n508\t        recent_successful_reuse: 0.45,\n509\t        user_preference_compatibility: 0.6,\n510\t        token_cost: inverse_cost_score(summary_len),\n511\t    };\n512\t    RelevanceBreakdown {\n513\t        total_score: average_score(&ranking_signals),\n514\t        ranking_signals,\n515\t        explanation:\n516\t            \"Kept as supporting context instead of a pivot because the compact bundle favored stronger anchors.\"\n517\t                .to_string(),\n518\t    }\n519\t}\n520\t\n521\tfn average_score(scores: &RelevanceSignalScores) -> f64 {\n522\t    let total = scores.task_type_compatibility\n523\t        + scores.graph_proximity_to_anchors\n524\t        + scores.exact_identifier_match\n525\t        + scores.semantic_similarity\n526\t        + scores.verification_status\n527\t        + scores.freshness\n528\t        + scores.scope\n529\t        + scores.evidence_strength\n530\t        + scores.contradiction_supersession_state\n531\t        + scores.past_usefulness\n532\t        + scores.recent_successful_reuse\n533\t        + scores.user_preference_compatibility\n534\t        + scores.token_cost;\n535\t    (total / 13.0 * 100.0).round() / 100.0\n536\t}\n537\t\n538\tfn inverse_cost_score(size: usize) -> f64 {\n539\t    clamp_score(1.0 - (size as f64 / 400.0))\n540\t}\n541\t\n542\tfn scope_score(scope: &str) -> f64 {\n543\t    match scope {\n544\t        \"session\" => 0.85,\n545\t        \"branch\" => 0.8,\n546\t        \"repo\" => 0.74,\n547\t        \"user\" => 0.68,\n548\t        \"organization\" => 0.62,\n549\t        _ => 0.5,\n550\t    }\n551\t}\n552\t\n553\tfn clamp_score(value: f64) -> f64 {\n554\t    value.clamp(0.0, 1.0)\n555\t}\n556\t\n557\tfn truncate_for_digest(text: &str, limit: usize) -> String {\n558\t    if text.len() <= limit {\n559\t        return text.to_string();\n560\t    }\n561\t    let capped = limit.saturating_sub(3);\n562\t    format!(\"{}...\", &text[..capped])\n563\t}\n564\t\n565\tfn metric_source_label(source: MetricSource) -> &'static str {\n566\t    match source {\n567\t        MetricSource::EventLog => \"event_log\",\n568\t        MetricSource::MemoryStore => \"memory_store\",\n569\t        MetricSource::WorkflowOutcome => \"workflow_outcome\",\n570\t        MetricSource::Verifier => \"verifier\",\n571\t        MetricSource::SessionMetrics => \"session_metrics\",\n572\t    }\n573\t}\n574\t\n575\tfn scope_kind_label(scope: &MetricScope) -> &'static str {\n576\t    match scope.kind {\n577\t        lattice_core::metrics::MetricScopeKind::Session => \"session\",\n578\t        lattice_core::metrics::MetricScopeKind::Branch => \"branch\",\n579\t        lattice_core::metrics::MetricScopeKind::Repo => \"repo\",\n580\t        lattice_core::metrics::MetricScopeKind::User => \"user\",\n581\t        lattice_core::metrics::MetricScopeKind::Organization => \"organization\",\n582\t    }\n583\t}\n584\t"}]},"parent_tool_use_id":null,"session_id":"dcdb14de-3541-4532-8220-c4c3ddb6207e","uuid":"c1d338a2-efc1-4f7b-ac77-0686b2a3585b","timestamp":"2026-05-17T16:39:32.809Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/metrics_surface.rs","content":"//! MCP-facing metrics and retrieval-relevance facade.\n//!\n//! This module implements the plan contracts from\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 9: Metrics And Evaluation`,\n//! `### 7. Retrieval Engine`, and\n//! `### Phase 4: Retrieval V1`.\n//! It wires the canonical `lattice_core::metrics::MetricsCollector` into the\n//! daemon RPC surface and exposes explainable per-call retrieval relevance\n//! suitable for workflow payloads and `expand_context` follow-ups.\n\nuse std::collections::HashMap;\n\nuse lattice_core::metrics::{\n    MetricScope, MetricSignal, MetricSource, MetricValue, MetricsCollector,\n};\nuse serde::{Deserialize, Serialize};\nuse serde_json::{json, Value};\nuse thiserror::Error;\n\nuse super::session_metrics::SessionMetricsReport;\nuse super::workflow_v2::{\n    MemoryHighlight, Pivot, RelevanceBreakdown, RelevanceSignalScores, WorkflowBundle,\n};\n\nconst COMPACT_DIGEST_LIMIT: usize = 160;\n\n/// Bounded MCP-facing facade over the canonical Phase 9 collector.\n#[derive(Clone, Debug)]\npub struct MetricsSurface {\n    workspace_id: String,\n    collector: MetricsCollector,\n    session_metrics: Option<SessionMetricsReport>,\n    call_reports: HashMap<(String, String), CallRelevanceReport>,\n}\n\nimpl MetricsSurface {\n    /// Build a facade for the active workspace.\n    pub fn new(\n        workspace_id: impl Into<String>,\n        collector: MetricsCollector,\n        session_metrics: Option<SessionMetricsReport>,\n    ) -> Self {\n        Self {\n            workspace_id: workspace_id.into(),\n            collector,\n            session_metrics,\n            call_reports: HashMap::new(),\n        }\n    }\n\n    /// Collect the requested Phase 9 signals, falling back to live\n    /// `SessionMetricsReport` values only when the canonical collector returns\n    /// an honest null for a signal the session view can supply.\n    pub fn collect(&self, scope: MetricScope, signals: &[MetricSignal]) -> Vec<MetricValue> {\n        let mut values = self.collector.collect(scope.clone(), signals);\n        let mut source_breakdown = HashMap::<&'static str, usize>::new();\n        for value in &mut values {\n            if value.value.is_none() {\n                if let Some(fallback) =\n                    self.session_fallback(scope_kind_label(&scope), value.signal)\n                {\n                    *value = fallback;\n                }\n            }\n            *source_breakdown\n                .entry(metric_source_label(value.source))\n                .or_insert(0) += 1;\n        }\n        tracing::info!(\n            tool = \"get_memory_metrics\",\n            scope = scope_kind_label(&scope),\n            signal_count = values.len(),\n            source_breakdown = ?source_breakdown,\n            \"metrics surface collected phase 9 signals\"\n        );\n        values\n    }\n\n    /// Store one per-call relevance report so the workflow layer can re-read\n    /// it through a stable `(task_id, tool_name)` key during the same request.\n    pub fn record_call(&mut self, report: CallRelevanceReport) {\n        self.call_reports\n            .insert((report.task_id.clone(), report.tool_name.clone()), report);\n    }\n\n    /// Return the per-call retrieval-relevance report for one workflow call.\n    pub fn collect_for_call(\n        &self,\n        task_id: &str,\n        tool_name: &str,\n    ) -> Result<CallRelevanceReport, MetricsSurfaceError> {\n        let key = (task_id.to_string(), tool_name.to_string());\n        let report = self.call_reports.get(&key).cloned().ok_or_else(|| {\n            MetricsSurfaceError::UnknownCall {\n                task_id: task_id.to_string(),\n                tool_name: tool_name.to_string(),\n            }\n        })?;\n        self.validate_call_report(&report)?;\n        tracing::info!(\n            tool = tool_name,\n            scope = report.request_scope.as_deref().unwrap_or(\"workflow\"),\n            signal_count = report.pivots.len() + report.memories.len(),\n            source_breakdown = \"per_call_relevance\",\n            \"metrics surface collected retrieval relevance\"\n        );\n        Ok(report)\n    }\n\n    /// Return a bounded one-line digest for compact workflow payloads.\n    pub fn summarize_for_compact_mode(&self, breakdown: &RelevanceBreakdown) -> String {\n        let text = format!(\n            \"score {:.2}; anchor {:.2}; semantic {:.2}; verification {:.2}; freshness {:.2}; scope {:.2}\",\n            breakdown.total_score,\n            breakdown.ranking_signals.graph_proximity_to_anchors,\n            breakdown.ranking_signals.semantic_similarity,\n            breakdown.ranking_signals.verification_status,\n            breakdown.ranking_signals.freshness,\n            breakdown.ranking_signals.scope,\n        );\n        truncate_for_digest(&text, COMPACT_DIGEST_LIMIT)\n    }\n\n    /// Build deterministic per-call relevance details for a workflow bundle.\n    pub fn build_call_relevance_report(\n        &self,\n        task_id: impl Into<String>,\n        tool_name: impl Into<String>,\n        request_scope: Option<String>,\n        bundle: &WorkflowBundle,\n    ) -> CallRelevanceReport {\n        let task_id = task_id.into();\n        let tool_name = tool_name.into();\n        let weakest_pivot_score = bundle\n            .ranked_pivots\n            .iter()\n            .map(|pivot| pivot.score)\n            .reduce(f64::min)\n            .unwrap_or(0.45);\n        let pivots = bundle\n            .ranked_pivots\n            .iter()\n            .enumerate()\n            .map(|(index, pivot)| PivotRelevance {\n                pivot_key: format!(\"pivot:{index}\"),\n                label: pivot.label.clone(),\n                file: pivot.file.clone(),\n                symbol: pivot.symbol.clone(),\n                inclusion_reason: pivot.inclusion_reason.clone(),\n                breakdown: pivot_breakdown(bundle, pivot, index),\n            })\n            .collect();\n        let memories = bundle\n            .memory_highlights\n            .iter()\n            .enumerate()\n            .map(|(index, memory)| MemoryRelevance {\n                memory_key: memory.memory_id.ulid.clone(),\n                scope: memory.scope.clone(),\n                inclusion_reason: memory.inclusion_reason.clone(),\n                breakdown: memory_breakdown(memory, index),\n            })\n            .collect();\n        let excluded_high_scoring_candidates = bundle\n            .relevant_context\n            .iter()\n            .enumerate()\n            .map(|(index, item)| ExcludedCandidate {\n                candidate_key: format!(\"context:{index}\"),\n                kind: item.kind.clone(),\n                label: item.label.clone(),\n                rejection_reason:\n                    \"retained as supporting context rather than a primary pivot to keep the bundle bounded\"\n                        .to_string(),\n                breakdown: context_breakdown(item.summary.len(), weakest_pivot_score),\n            })\n            .collect();\n        CallRelevanceReport {\n            task_id,\n            tool_name,\n            workspace_id: self.workspace_id.clone(),\n            request_scope,\n            allowed_memory_scopes: bundle\n                .memory_highlights\n                .iter()\n                .map(|memory| memory.scope.clone())\n                .collect(),\n            pivots,\n            memories,\n            excluded_high_scoring_candidates,\n        }\n    }\n\n    fn validate_call_report(\n        &self,\n        report: &CallRelevanceReport,\n    ) -> Result<(), MetricsSurfaceError> {\n        if report.workspace_id != self.workspace_id {\n            return Err(MetricsSurfaceError::CrossWorkspaceQuery {\n                requested_workspace_id: self.workspace_id.clone(),\n                report_workspace_id: report.workspace_id.clone(),\n            });\n        }\n        for memory in &report.memories {\n            if !report.allowed_memory_scopes.is_empty()\n                && !report\n                    .allowed_memory_scopes\n                    .iter()\n                    .any(|scope| scope == &memory.scope)\n            {\n                return Err(MetricsSurfaceError::CrossScopeQuery {\n                    memory_key: memory.memory_key.clone(),\n                    memory_scope: memory.scope.clone(),\n                    allowed_scopes: report.allowed_memory_scopes.clone(),\n                });\n            }\n        }\n        Ok(())\n    }\n\n    fn session_fallback(&self, scope_kind: &str, signal: MetricSignal) -> Option<MetricValue> {\n        if scope_kind != \"session\" {\n            return None;\n        }\n        let report = self.session_metrics.as_ref()?;\n        let computed_at = lattice_core::Utc::now();\n        match signal {\n            MetricSignal::ToolCallsPerSuccessfulTask if report.successful_workflow_calls > 0 => {\n                Some(MetricValue {\n                    signal,\n                    value: Some(\n                        report.workflow_tool_calls as f64 / report.successful_workflow_calls as f64,\n                    ),\n                    denominator: Some(report.successful_workflow_calls as u64),\n                    sample_count: report.successful_workflow_calls as u64,\n                    source: MetricSource::SessionMetrics,\n                    computed_at,\n                    incomplete: false,\n                    reason_if_null: None,\n                })\n            }\n            MetricSignal::IrrelevantFilesOpenedPerTask if report.successful_workflow_calls > 0 => {\n                Some(MetricValue {\n                    signal,\n                    value: Some(\n                        report.irrelevant_files_opened as f64\n                            / report.successful_workflow_calls as f64,\n                    ),\n                    denominator: Some(report.successful_workflow_calls as u64),\n                    sample_count: report.successful_workflow_calls as u64,\n                    source: MetricSource::SessionMetrics,\n                    computed_at,\n                    incomplete: false,\n                    reason_if_null: None,\n                })\n            }\n            MetricSignal::WorkflowSuccessAfterFirstPlan if report.workflow_tasks_with_plan > 0 => {\n                Some(MetricValue {\n                    signal,\n                    value: Some(report.workflow_success_after_first_plan_rate),\n                    denominator: Some(report.workflow_tasks_with_plan as u64),\n                    sample_count: report.workflow_tasks_with_plan as u64,\n                    source: MetricSource::SessionMetrics,\n                    computed_at,\n                    incomplete: false,\n                    reason_if_null: None,\n                })\n            }\n            _ => None,\n        }\n    }\n}\n\n/// Typed failures for per-call relevance lookups.\n#[derive(Debug, Error, Clone, PartialEq, Eq)]\npub enum MetricsSurfaceError {\n    /// The requested workflow call was never recorded in this surface.\n    #[error(\"unknown call report for task `{task_id}` and tool `{tool_name}`\")]\n    UnknownCall { task_id: String, tool_name: String },\n    /// The stored report belongs to another workspace.\n    #[error(\n        \"call report workspace `{report_workspace_id}` does not match active workspace `{requested_workspace_id}`\"\n    )]\n    CrossWorkspaceQuery {\n        requested_workspace_id: String,\n        report_workspace_id: String,\n    },\n    /// The report would leak a memory outside the allowed retrieval scopes.\n    #[error(\n        \"memory `{memory_key}` with scope `{memory_scope}` falls outside allowed scopes {allowed_scopes:?}\"\n    )]\n    CrossScopeQuery {\n        memory_key: String,\n        memory_scope: String,\n        allowed_scopes: Vec<String>,\n    },\n}\n\n/// Per-call retrieval relevance for one workflow invocation.\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct CallRelevanceReport {\n    /// Stable task-scoped key for the workflow call.\n    pub task_id: String,\n    /// Workflow tool name such as `prepare_change`.\n    pub tool_name: String,\n    /// Workspace that owns the call report.\n    pub workspace_id: String,\n    /// Requested retrieval scope if the caller provided one.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub request_scope: Option<String>,\n    /// Memory scopes permitted for this call after retrieval filtering.\n    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n    pub allowed_memory_scopes: Vec<String>,\n    /// Selected pivots with full ranking-signal breakdowns.\n    pub pivots: Vec<PivotRelevance>,\n    /// Surfaced memories with full ranking-signal breakdowns.\n    pub memories: Vec<MemoryRelevance>,\n    /// Excluded high-scoring candidates and truthful rejection reasons.\n    pub excluded_high_scoring_candidates: Vec<ExcludedCandidate>,\n}\n\n/// Diagnostic relevance for one surfaced pivot.\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct PivotRelevance {\n    /// Stable per-report key for the pivot.\n    pub pivot_key: String,\n    /// Pivot display label.\n    pub label: String,\n    /// Repo-relative file when available.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub file: Option<String>,\n    /// Symbol or heading when available.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub symbol: Option<String>,\n    /// Reason the pivot was included.\n    pub inclusion_reason: String,\n    /// Full score breakdown for this pivot.\n    pub breakdown: RelevanceBreakdown,\n}\n\n/// Diagnostic relevance for one surfaced memory.\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct MemoryRelevance {\n    /// Stable memory key used by the report.\n    pub memory_key: String,\n    /// Memory scope after retrieval filtering.\n    pub scope: String,\n    /// Reason the memory was included.\n    pub inclusion_reason: String,\n    /// Full score breakdown for this memory.\n    pub breakdown: RelevanceBreakdown,\n}\n\n/// High-scoring candidate excluded from the final compact bundle.\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct ExcludedCandidate {\n    /// Stable per-report candidate key.\n    pub candidate_key: String,\n    /// Candidate kind such as `context`, `file`, or `memory`.\n    pub kind: String,\n    /// Display label for the excluded candidate.\n    pub label: String,\n    /// Truthful reason it was excluded from the final payload.\n    pub rejection_reason: String,\n    /// Full score breakdown explaining why it almost made the cut.\n    pub breakdown: RelevanceBreakdown,\n}\n\n/// Build a memory-like payload that `expand_context` can dereference directly.\npub fn detail_payload(\n    label: &str,\n    key: &str,\n    kind: &str,\n    inclusion_reason: &str,\n    breakdown: &RelevanceBreakdown,\n) -> Value {\n    json!({\n        \"id\": key,\n        \"content\": format!(\n            \"Relevance detail for {kind} `{label}`: {inclusion_reason}. Total score {:.2}.\",\n            breakdown.total_score,\n        ),\n        \"memory_type\": \"observation\",\n        \"scope\": \"session\",\n        \"inclusion_reason\": inclusion_reason,\n        \"kind\": kind,\n        \"relevance\": breakdown,\n    })\n}\n\nfn pivot_breakdown(bundle: &WorkflowBundle, pivot: &Pivot, index: usize) -> RelevanceBreakdown {\n    let exact_identifier_match = if pivot\n        .symbol\n        .as_deref()\n        .is_some_and(|symbol| bundle.workflow_record.input.contains(symbol))\n    {\n        1.0\n    } else {\n        0.55\n    };\n    let graph_proximity = clamp_score(pivot.score);\n    let semantic_similarity = clamp_score(0.45 + (pivot.inclusion_reason.len() as f64 / 180.0));\n    let verification = if pivot.file.is_some() { 0.72 } else { 0.5 };\n    let freshness = 0.7;\n    let scope = 0.82;\n    let evidence_strength = clamp_score(0.5 + (pivot.score / 2.0));\n    let contradiction_state = 0.9;\n    let past_usefulness = clamp_score(0.45 + (index as f64 * 0.05));\n    let recent_successful_reuse = 0.56;\n    let task_type = if bundle.workflow_record.tool.contains(\"prepare\")\n        || bundle.workflow_record.tool.contains(\"plan\")\n    {\n        0.88\n    } else {\n        0.72\n    };\n    let user_preference = 0.6;\n    let token_cost = inverse_cost_score(\n        pivot.label.len()\n            + pivot.inclusion_reason.len()\n            + pivot.file.as_deref().unwrap_or(\"\").len(),\n    );\n    let ranking_signals = RelevanceSignalScores {\n        task_type_compatibility: task_type,\n        graph_proximity_to_anchors: graph_proximity,\n        exact_identifier_match,\n        semantic_similarity,\n        verification_status: verification,\n        freshness,\n        scope,\n        evidence_strength,\n        contradiction_supersession_state: contradiction_state,\n        past_usefulness,\n        recent_successful_reuse,\n        user_preference_compatibility: user_preference,\n        token_cost,\n    };\n    RelevanceBreakdown {\n        total_score: average_score(&ranking_signals),\n        ranking_signals,\n        explanation: format!(\n            \"Selected as a lead pivot because `{}` aligned with the current workflow input.\",\n            pivot.label\n        ),\n    }\n}\n\nfn memory_breakdown(memory: &MemoryHighlight, index: usize) -> RelevanceBreakdown {\n    let verification = match memory.verification_status.as_str() {\n        \"verified\" => 1.0,\n        \"in_review\" => 0.7,\n        \"stale\" | \"contradicted\" | \"superseded\" | \"expired\" => 0.2,\n        _ => 0.45,\n    };\n    let freshness = match memory.freshness_status.as_str() {\n        \"fresh\" => 0.92,\n        \"stale\" => 0.25,\n        \"expired\" => 0.1,\n        _ => 0.5,\n    };\n    let scope = scope_score(&memory.scope);\n    let evidence_strength = match memory.evidence_strength.as_str() {\n        \"strong\" => 0.92,\n        \"moderate\" => 0.68,\n        \"weak\" => 0.32,\n        _ => 0.45,\n    };\n    let contradiction_state = if memory.contradiction_state == \"none\" {\n        0.9\n    } else {\n        0.2\n    };\n    let ranking_signals = RelevanceSignalScores {\n        task_type_compatibility: 0.84,\n        graph_proximity_to_anchors: 0.58,\n        exact_identifier_match: 0.45,\n        semantic_similarity: clamp_score(0.5 + memory.content.len() as f64 / 320.0),\n        verification_status: verification,\n        freshness,\n        scope,\n        evidence_strength,\n        contradiction_supersession_state: contradiction_state,\n        past_usefulness: clamp_score(0.48 + index as f64 * 0.04),\n        recent_successful_reuse: 0.55,\n        user_preference_compatibility: 0.6,\n        token_cost: inverse_cost_score(memory.content.len()),\n    };\n    RelevanceBreakdown {\n        total_score: average_score(&ranking_signals),\n        ranking_signals,\n        explanation: memory.inclusion_reason.clone(),\n    }\n}\n\nfn context_breakdown(summary_len: usize, weakest_pivot_score: f64) -> RelevanceBreakdown {\n    let ranking_signals = RelevanceSignalScores {\n        task_type_compatibility: 0.7,\n        graph_proximity_to_anchors: clamp_score(weakest_pivot_score - 0.08),\n        exact_identifier_match: 0.35,\n        semantic_similarity: clamp_score(0.4 + summary_len as f64 / 260.0),\n        verification_status: 0.65,\n        freshness: 0.7,\n        scope: 0.8,\n        evidence_strength: 0.6,\n        contradiction_supersession_state: 0.9,\n        past_usefulness: 0.5,\n        recent_successful_reuse: 0.45,\n        user_preference_compatibility: 0.6,\n        token_cost: inverse_cost_score(summary_len),\n    };\n    RelevanceBreakdown {\n        total_score: average_score(&ranking_signals),\n        ranking_signals,\n        explanation:\n            \"Kept as supporting context instead of a pivot because the compact bundle favored stronger anchors.\"\n                .to_string(),\n    }\n}\n\nfn average_score(scores: &RelevanceSignalScores) -> f64 {\n    let total = scores.task_type_compatibility\n        + scores.graph_proximity_to_anchors\n        + scores.exact_identifier_match\n        + scores.semantic_similarity\n        + scores.verification_status\n        + scores.freshness\n        + scores.scope\n        + scores.evidence_strength\n        + scores.contradiction_supersession_state\n        + scores.past_usefulness\n        + scores.recent_successful_reuse\n        + scores.user_preference_compatibility\n        + scores.token_cost;\n    (total / 13.0 * 100.0).round() / 100.0\n}\n\nfn inverse_cost_score(size: usize) -> f64 {\n    clamp_score(1.0 - (size as f64 / 400.0))\n}\n\nfn scope_score(scope: &str) -> f64 {\n    match scope {\n        \"session\" => 0.85,\n        \"branch\" => 0.8,\n        \"repo\" => 0.74,\n        \"user\" => 0.68,\n        \"organization\" => 0.62,\n        _ => 0.5,\n    }\n}\n\nfn clamp_score(value: f64) -> f64 {\n    value.clamp(0.0, 1.0)\n}\n\nfn truncate_for_digest(text: &str, limit: usize) -> String {\n    if text.len() <= limit {\n        return text.to_string();\n    }\n    let capped = limit.saturating_sub(3);\n    format!(\"{}...\", &text[..capped])\n}\n\nfn metric_source_label(source: MetricSource) -> &'static str {\n    match source {\n        MetricSource::EventLog => \"event_log\",\n        MetricSource::MemoryStore => \"memory_store\",\n        MetricSource::WorkflowOutcome => \"workflow_outcome\",\n        MetricSource::Verifier => \"verifier\",\n        MetricSource::SessionMetrics => \"session_metrics\",\n    }\n}\n\nfn scope_kind_label(scope: &MetricScope) -> &'static str {\n    match scope.kind {\n        lattice_core::metrics::MetricScopeKind::Session => \"session\",\n        lattice_core::metrics::MetricScopeKind::Branch => \"branch\",\n        lattice_core::metrics::MetricScopeKind::Repo => \"repo\",\n        lattice_core::metrics::MetricScopeKind::User => \"user\",\n        lattice_core::metrics::MetricScopeKind::Organization => \"organization\",\n    }\n}\n","numLines":584,"startLine":1,"totalLines":584}}}
