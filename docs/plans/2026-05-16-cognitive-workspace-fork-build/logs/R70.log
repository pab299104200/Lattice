{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KPM2RfqyDvRLyeGKcsoJrJ","type":"tool_result","content":"1\tuse std::fs;\n2\tuse std::path::{Path, PathBuf};\n3\t\n4\tuse lattice_core::events::{EventQuery, EventReader, EventStore, QueryOrder};\n5\tuse lattice_core::metrics::{\n6\t    merge_missing_current_metrics, report_exit_code, BenchmarkEvidence, MetricScope,\n7\t    MetricScopeKind, MetricSignal, MetricSource, MetricTimeRange, MetricValue, MetricsCollector,\n8\t    RegressionReport, ReportInput, SuccessCriteriaThresholds,\n9\t};\n10\tuse lattice_core::{DateTime, Utc};\n11\tuse thiserror::Error;\n12\tuse tracing_subscriber::EnvFilter;\n13\t\n14\tconst DEFAULT_BENCHMARK_PATH: &str =\n15\t    \"docs/plans/2026-05-16-cognitive-workspace-fork-build/baselines/cognitive_workspace_metrics.json\";\n16\t\n17\tfn main() {\n18\t    if let Err(error) = run() {\n19\t        eprintln!(\"{error}\");\n20\t        std::process::exit(1);\n21\t    }\n22\t}\n23\t\n24\tfn run() -> Result<(), CliError> {\n25\t    init_tracing();\n26\t    let args = CliArgs::parse(std::env::args().skip(1).collect())?;\n27\t    let workspace_root = std::env::current_dir().map_err(CliError::CurrentDir)?;\n28\t    let workspace_root = workspace_root\n29\t        .canonicalize()\n30\t        .unwrap_or_else(|_| workspace_root.clone());\n31\t    let scope = args.metric_scope(&workspace_root)?;\n32\t    let signals = args\n33\t        .signals\n34\t        .clone()\n35\t        .unwrap_or_else(|| MetricSignal::ALL.to_vec());\n36\t    let current = collect_current_metrics(&workspace_root, &scope, &signals)?;\n37\t    let benchmark = BenchmarkEvidence::from_path(&args.benchmark_path())?;\n38\t    let current = merge_missing_current_metrics(current, benchmark.as_ref());\n39\t    let baseline = match &args.baseline {\n40\t        Some(path) => Some(load_baseline_metrics(path)?),\n41\t        None => None,\n42\t    };\n43\t    let report = RegressionReport::build(ReportInput {\n44\t        current,\n45\t        baseline,\n46\t        benchmark_report_path: args.benchmark_path(),\n47\t        scope: scope.clone(),\n48\t        success_criteria: SuccessCriteriaThresholds::initial(),\n49\t    })?;\n50\t    tracing::info!(\n51\t        scope = scope_label(&scope),\n52\t        signal_count = report.rows.len(),\n53\t        pass_count = report.pass_count,\n54\t        fail_count = report.fail_count,\n55\t        format = args.format.as_str(),\n56\t        \"lattice_report evaluated phase 9 thresholds\"\n57\t    );\n58\t    let rendered = args.render(&report)?;\n59\t    write_output(args.output.as_deref(), &rendered)?;\n60\t    let exit_code = report_exit_code(&report, args.fail_on_regression);\n61\t    if exit_code != 0 {\n62\t        std::process::exit(exit_code);\n63\t    }\n64\t    Ok(())\n65\t}\n66\t\n67\t#[derive(Debug, Clone)]\n68\tstruct CliArgs {\n69\t    scope: MetricScopeKind,\n70\t    time_range: Option<MetricTimeRange>,\n71\t    signals: Option<Vec<MetricSignal>>,\n72\t    baseline: Option<PathBuf>,\n73\t    benchmark: Option<PathBuf>,\n74\t    format: OutputFormat,\n75\t    output: Option<PathBuf>,\n76\t    fail_on_regression: bool,\n77\t}\n78\t\n79\t#[derive(Debug, Clone, Copy)]\n80\tenum OutputFormat {\n81\t    Text,\n82\t    Json,\n83\t    CiSummary,\n84\t}\n85\t\n86\timpl OutputFormat {\n87\t    fn as_str(self) -> &'static str {\n88\t        match self {\n89\t            Self::Text => \"text\",\n90\t            Self::Json => \"json\",\n91\t            Self::CiSummary => \"ci-summary\",\n92\t        }\n93\t    }\n94\t}\n95\t\n96\t#[derive(Debug, Error)]\n97\tenum CliError {\n98\t    #[error(\"unknown argument `{0}`\")]\n99\t    UnknownArgument(String),\n100\t    #[error(\"missing value for `{0}`\")]\n101\t    MissingValue(&'static str),\n102\t    #[error(\"invalid scope `{0}`\")]\n103\t    InvalidScope(String),\n104\t    #[error(\"invalid output format `{0}`\")]\n105\t    InvalidFormat(String),\n106\t    #[error(\"invalid signal `{0}`\")]\n107\t    InvalidSignal(String),\n108\t    #[error(\"invalid time range `{0}`; expected RFC3339,RFC3339\")]\n109\t    InvalidTimeRange(String),\n110\t    #[error(\"session scope requires at least one captured event in the active workspace\")]\n111\t    MissingSessionScope,\n112\t    #[error(\"failed to resolve current directory: {0}\")]\n113\t    CurrentDir(std::io::Error),\n114\t    #[error(\"failed to open event store at {path}: {source}\")]\n115\t    EventStoreOpen {\n116\t        path: PathBuf,\n117\t        source: lattice_core::events::EventStoreError,\n118\t    },\n119\t    #[error(\"failed to read events for metrics collection: {0}\")]\n120\t    EventRead(lattice_core::events::EventQueryError),\n121\t    #[error(\"failed to read output path {path}: {source}\")]\n122\t    OutputWrite {\n123\t        path: PathBuf,\n124\t        source: std::io::Error,\n125\t    },\n126\t    #[error(\"failed to parse baseline metrics at {path}: {message}\")]\n127\t    BaselineParse { path: PathBuf, message: String },\n128\t    #[error(transparent)]\n129\t    Report(#[from] lattice_core::metrics::ReportError),\n130\t    #[error(\"failed to serialize report JSON: {0}\")]\n131\t    JsonRender(serde_json::Error),\n132\t}\n133\t\n134\timpl CliArgs {\n135\t    fn parse(args: Vec<String>) -> Result<Self, CliError> {\n136\t        let mut scope = MetricScopeKind::Repo;\n137\t        let mut time_range = None;\n138\t        let mut signals = None;\n139\t        let mut baseline = None;\n140\t        let mut benchmark = None;\n141\t        let mut format = OutputFormat::Text;\n142\t        let mut output = None;\n143\t        let mut fail_on_regression = false;\n144\t        let mut index = 0;\n145\t        while index < args.len() {\n146\t            match args[index].as_str() {\n147\t                \"--scope\" => {\n148\t                    scope = parse_scope(next_arg(&args, index, \"--scope\")?)?;\n149\t                    index += 2;\n150\t                }\n151\t                \"--time-range\" => {\n152\t                    time_range = Some(parse_time_range(next_arg(&args, index, \"--time-range\")?)?);\n153\t                    index += 2;\n154\t                }\n155\t                \"--signals\" => {\n156\t                    signals = Some(parse_signals(next_arg(&args, index, \"--signals\")?)?);\n157\t                    index += 2;\n158\t                }\n159\t                \"--baseline\" => {\n160\t                    baseline = Some(PathBuf::from(next_arg(&args, index, \"--baseline\")?));\n161\t                    index += 2;\n162\t                }\n163\t                \"--benchmark\" => {\n164\t                    benchmark = Some(PathBuf::from(next_arg(&args, index, \"--benchmark\")?));\n165\t                    index += 2;\n166\t                }\n167\t                \"--format\" => {\n168\t                    format = parse_format(next_arg(&args, index, \"--format\")?)?;\n169\t                    index += 2;\n170\t                }\n171\t                \"--output\" => {\n172\t                    output = Some(PathBuf::from(next_arg(&args, index, \"--output\")?));\n173\t                    index += 2;\n174\t                }\n175\t                \"--fail-on-regression\" => {\n176\t                    fail_on_regression = true;\n177\t                    index += 1;\n178\t                }\n179\t                other => return Err(CliError::UnknownArgument(other.to_string())),\n180\t            }\n181\t        }\n182\t        Ok(Self {\n183\t            scope,\n184\t            time_range,\n185\t            signals,\n186\t            baseline,\n187\t            benchmark,\n188\t            format,\n189\t            output,\n190\t            fail_on_regression,\n191\t        })\n192\t    }\n193\t\n194\t    fn benchmark_path(&self) -> PathBuf {\n195\t        self.benchmark\n196\t            .clone()\n197\t            .unwrap_or_else(|| PathBuf::from(DEFAULT_BENCHMARK_PATH))\n198\t    }\n199\t\n200\t    fn metric_scope(&self, workspace_root: &Path) -> Result<MetricScope, CliError> {\n201\t        let scope = match self.scope {\n202\t            MetricScopeKind::Session => {\n203\t                MetricScope::session(resolve_latest_session(workspace_root)?)\n204\t            }\n205\t            MetricScopeKind::Branch => MetricScope::branch(\n206\t                workspace_root.to_string_lossy(),\n207\t                current_git_branch(workspace_root).unwrap_or_else(|| \"main\".to_string()),\n208\t            ),\n209\t            MetricScopeKind::Repo => MetricScope::repo(workspace_root.to_string_lossy()),\n210\t            MetricScopeKind::User => MetricScope {\n211\t                kind: MetricScopeKind::User,\n212\t                workspace_id: None,\n213\t                branch: None,\n214\t                session_id: None,\n215\t                user_id: None,\n216\t                organization_id: None,\n217\t                time_range: None,\n218\t            },\n219\t            MetricScopeKind::Organization => MetricScope {\n220\t                kind: MetricScopeKind::Organization,\n221\t                workspace_id: None,\n222\t                branch: None,\n223\t                session_id: None,\n224\t                user_id: None,\n225\t                organization_id: None,\n226\t                time_range: None,\n227\t            },\n228\t        };\n229\t        Ok(match &self.time_range {\n230\t            Some(range) => scope.with_time_range(range.since, range.until),\n231\t            None => scope,\n232\t        })\n233\t    }\n234\t\n235\t    fn render(&self, report: &RegressionReport) -> Result<String, CliError> {\n236\t        match self.format {\n237\t            OutputFormat::Text => Ok(report.render_text()),\n238\t            OutputFormat::Json => report.render_json().map_err(CliError::JsonRender),\n239\t            OutputFormat::CiSummary => Ok(report.render_ci_summary()),\n240\t        }\n241\t    }\n242\t}\n243\t\n244\tfn collect_current_metrics(\n245\t    workspace_root: &Path,\n246\t    scope: &MetricScope,\n247\t    signals: &[MetricSignal],\n248\t) -> Result<Vec<MetricValue>, CliError> {\n249\t    let events = load_scope_events(workspace_root, scope)?;\n250\t    for signal in signals {\n251\t        tracing::info!(\n252\t            signal = signal.as_str(),\n253\t            source = \"event_log\",\n254\t            event_count = events.len(),\n255\t            \"lattice_report collected live signal input\"\n256\t        );\n257\t    }\n258\t    Ok(MetricsCollector::new()\n259\t        .with_events(events)\n260\t        .collect(scope.clone(), signals))\n261\t}\n262\t\n263\tfn load_scope_events(\n264\t    workspace_root: &Path,\n265\t    scope: &MetricScope,\n266\t) -> Result<Vec<lattice_core::events::EventEnvelope>, CliError> {\n267\t    let event_store_path = workspace_root.join(\".lattice\").join(\"events.db\");\n268\t    let store = EventStore::open(&event_store_path).map_err(|source| CliError::EventStoreOpen {\n269\t        path: event_store_path,\n270\t        source,\n271\t    })?;\n272\t    let reader = EventReader::new(std::sync::Arc::new(store));\n273\t    let query = event_query_for_scope(workspace_root, scope)?;\n274\t    reader.execute(query).map_err(CliError::EventRead)\n275\t}\n276\t\n277\tfn event_query_for_scope(\n278\t    workspace_root: &Path,\n279\t    scope: &MetricScope,\n280\t) -> Result<EventQuery, CliError> {\n281\t    let mut query = match scope.kind {\n282\t        MetricScopeKind::Session => EventQuery::new()\n283\t            .session(\n284\t                scope\n285\t                    .session_id\n286\t                    .clone()\n287\t                    .ok_or(CliError::MissingSessionScope)?,\n288\t            )\n289\t            .workspace(workspace_root.to_string_lossy()),\n290\t        MetricScopeKind::Branch | MetricScopeKind::Repo => EventQuery::new()\n291\t            .workspace(workspace_root.to_string_lossy())\n292\t            .branch(current_git_branch(workspace_root).unwrap_or_else(|| \"main\".to_string())),\n293\t        MetricScopeKind::User | MetricScopeKind::Organization => {\n294\t            return Ok(EventQuery::new()\n295\t                .workspace(workspace_root.to_string_lossy())\n296\t                .branch(current_git_branch(workspace_root).unwrap_or_else(|| \"main\".to_string()))\n297\t                .limit(1));\n298\t        }\n299\t    }\n300\t    .order(QueryOrder::OldestFirst)\n301\t    .limit(1_000);\n302\t    if let Some(range) = &scope.time_range {\n303\t        if let Some(since) = range.since {\n304\t            query = query.after(since);\n305\t        }\n306\t        if let Some(until) = range.until {\n307\t            query = query.before(until);\n308\t        }\n309\t    }\n310\t    Ok(query)\n311\t}\n312\t\n313\tfn resolve_latest_session(workspace_root: &Path) -> Result<String, CliError> {\n314\t    let event_store_path = workspace_root.join(\".lattice\").join(\"events.db\");\n315\t    let store = EventStore::open(&event_store_path).map_err(|source| CliError::EventStoreOpen {\n316\t        path: event_store_path,\n317\t        source,\n318\t    })?;\n319\t    let reader = EventReader::new(std::sync::Arc::new(store));\n320\t    let query = EventQuery::new()\n321\t        .workspace(workspace_root.to_string_lossy())\n322\t        .branch(current_git_branch(workspace_root).unwrap_or_else(|| \"main\".to_string()))\n323\t        .order(QueryOrder::NewestFirst)\n324\t        .limit(1);\n325\t    let latest = reader.execute(query).map_err(CliError::EventRead)?;\n326\t    latest\n327\t        .first()\n328\t        .map(|event| event.session_id.value.clone())\n329\t        .ok_or(CliError::MissingSessionScope)\n330\t}\n331\t\n332\tfn load_baseline_metrics(path: &Path) -> Result<Vec<MetricValue>, CliError> {\n333\t    let body = fs::read_to_string(path).map_err(|error| CliError::BaselineParse {\n334\t        path: path.to_path_buf(),\n335\t        message: error.to_string(),\n336\t    })?;\n337\t    if let Ok(metrics) = serde_json::from_str::<Vec<MetricValue>>(&body) {\n338\t        return Ok(metrics);\n339\t    }\n340\t    if let Ok(fixtures) = serde_json::from_str::<Vec<FixtureBaselineReport>>(&body) {\n341\t        return Ok(flatten_fixture_metrics(&fixtures));\n342\t    }\n343\t    if let Ok(legacy) = serde_json::from_str::<Vec<LegacyBaselineMetric>>(&body) {\n344\t        return Ok(legacy_baseline_metrics(&legacy));\n345\t    }\n346\t    Err(CliError::BaselineParse {\n347\t        path: path.to_path_buf(),\n348\t        message: \"unsupported baseline schema\".to_string(),\n349\t    })\n350\t}\n351\t\n352\tfn flatten_fixture_metrics(fixtures: &[FixtureBaselineReport]) -> Vec<MetricValue> {\n353\t    let mut merged = Vec::new();\n354\t    for signal in MetricSignal::ALL {\n355\t        let values = fixtures\n356\t            .iter()\n357\t            .flat_map(|fixture| fixture.metrics.iter())\n358\t            .filter(|metric| metric.signal == signal)\n359\t            .filter_map(|metric| metric.value)\n360\t            .collect::<Vec<_>>();\n361\t        if values.is_empty() {\n362\t            continue;\n363\t        }\n364\t        let mean = values.iter().sum::<f64>() / values.len() as f64;\n365\t        merged.push(MetricValue {\n366\t            signal,\n367\t            value: Some(mean),\n368\t            denominator: Some(values.len() as u64),\n369\t            sample_count: values.len() as u64,\n370\t            source: fixtures\n371\t                .iter()\n372\t                .flat_map(|fixture| fixture.metrics.iter())\n373\t                .find(|metric| metric.signal == signal)\n374\t                .map(|metric| metric.source)\n375\t                .unwrap_or(MetricSource::EventLog),\n376\t            computed_at: fixtures\n377\t                .iter()\n378\t                .flat_map(|fixture| fixture.metrics.iter().map(|metric| metric.computed_at))\n379\t                .max_by_key(|value| value.unix_seconds())\n380\t                .unwrap_or_else(Utc::now),\n381\t            incomplete: false,\n382\t            reason_if_null: None,\n383\t        });\n384\t    }\n385\t    merged\n386\t}\n387\t\n388\tfn legacy_baseline_metrics(legacy: &[LegacyBaselineMetric]) -> Vec<MetricValue> {\n389\t    let count = legacy\n390\t        .iter()\n391\t        .filter(|metric| {\n392\t            matches!(\n393\t                metric.name.as_str(),\n394\t                \"prepare_change\"\n395\t                    | \"get_context_capsule\"\n396\t                    | \"find_relevant_tests\"\n397\t                    | \"impact_from_diff\"\n398\t                    | \"diagnose_failure\"\n399\t            )\n400\t        })\n401\t        .count() as f64;\n402\t    let mut metrics = Vec::new();\n403\t    if count > 0.0 {\n404\t        metrics.push(MetricValue {\n405\t            signal: MetricSignal::ToolCallsPerSuccessfulTask,\n406\t            value: Some(count),\n407\t            denominator: Some(1),\n408\t            sample_count: 1,\n409\t            source: MetricSource::WorkflowOutcome,\n410\t            computed_at: Utc::now(),\n411\t            incomplete: false,\n412\t            reason_if_null: None,\n413\t        });\n414\t        metrics.push(MetricValue {\n415\t            signal: MetricSignal::IrrelevantFilesOpenedPerTask,\n416\t            value: None,\n417\t            denominator: None,\n418\t            sample_count: 0,\n419\t            source: MetricSource::EventLog,\n420\t            computed_at: Utc::now(),\n421\t            incomplete: false,\n422\t            reason_if_null: Some(\n423\t                \"legacy baseline bench did not capture irrelevant file read counts\".to_string(),\n424\t            ),\n425\t        });\n426\t    }\n427\t    metrics\n428\t}\n429\t\n430\tfn write_output(path: Option<&Path>, rendered: &str) -> Result<(), CliError> {\n431\t    if let Some(path) = path {\n432\t        fs::write(path, rendered).map_err(|source| CliError::OutputWrite {\n433\t            path: path.to_path_buf(),\n434\t            source,\n435\t        })?;\n436\t    } else {\n437\t        println!(\"{rendered}\");\n438\t    }\n439\t    Ok(())\n440\t}\n441\t\n442\tfn init_tracing() {\n443\t    let _ = tracing_subscriber::fmt()\n444\t        .with_env_filter(EnvFilter::from_default_env())\n445\t        .with_writer(std::io::stderr)\n446\t        .try_init();\n447\t}\n448\t\n449\tfn parse_scope(value: &str) -> Result<MetricScopeKind, CliError> {\n450\t    match value {\n451\t        \"session\" => Ok(MetricScopeKind::Session),\n452\t        \"branch\" => Ok(MetricScopeKind::Branch),\n453\t        \"repo\" => Ok(MetricScopeKind::Repo),\n454\t        \"user\" => Ok(MetricScopeKind::User),\n455\t        \"organization\" => Ok(MetricScopeKind::Organization),\n456\t        other => Err(CliError::InvalidScope(other.to_string())),\n457\t    }\n458\t}\n459\t\n460\tfn parse_format(value: &str) -> Result<OutputFormat, CliError> {\n461\t    match value {\n462\t        \"text\" => Ok(OutputFormat::Text),\n463\t        \"json\" => Ok(OutputFormat::Json),\n464\t        \"ci-summary\" => Ok(OutputFormat::CiSummary),\n465\t        other => Err(CliError::InvalidFormat(other.to_string())),\n466\t    }\n467\t}\n468\t\n469\tfn parse_signals(value: &str) -> Result<Vec<MetricSignal>, CliError> {\n470\t    value\n471\t        .split(',')\n472\t        .filter(|item| !item.trim().is_empty())\n473\t        .map(|item| match item.trim() {\n474\t            \"tool_calls_per_successful_task\" => Ok(MetricSignal::ToolCallsPerSuccessfulTask),\n475\t            \"irrelevant_files_opened_per_task\" => Ok(MetricSignal::IrrelevantFilesOpenedPerTask),\n476\t            \"relevant_anchor_recall\" => Ok(MetricSignal::RelevantAnchorRecall),\n477\t            \"memory_inclusion_precision\" => Ok(MetricSignal::MemoryInclusionPrecision),\n478\t            \"memory_later_used_rate\" => Ok(MetricSignal::MemoryLaterUsedRate),\n479\t            \"stale_memory_surfaced_rate\" => Ok(MetricSignal::StaleMemorySurfacedRate),\n480\t            \"contradiction_missed_rate\" => Ok(MetricSignal::ContradictionMissedRate),\n481\t            \"tests_recommended_vs_needed\" => Ok(MetricSignal::TestsRecommendedVsNeeded),\n482\t            \"workflow_success_after_first_plan\" => Ok(MetricSignal::WorkflowSuccessAfterFirstPlan),\n483\t            other => Err(CliError::InvalidSignal(other.to_string())),\n484\t        })\n485\t        .collect()\n486\t}\n487\t\n488\tfn parse_time_range(value: &str) -> Result<MetricTimeRange, CliError> {\n489\t    let mut parts = value.split(',');\n490\t    let since = parts\n491\t        .next()\n492\t        .ok_or_else(|| CliError::InvalidTimeRange(value.to_string()))?;\n493\t    let until = parts\n494\t        .next()\n495\t        .ok_or_else(|| CliError::InvalidTimeRange(value.to_string()))?;\n496\t    if parts.next().is_some() {\n497\t        return Err(CliError::InvalidTimeRange(value.to_string()));\n498\t    }\n499\t    Ok(MetricTimeRange {\n500\t        since: Some(\n501\t            DateTime::parse_rfc3339(since)\n502\t                .map_err(|_| CliError::InvalidTimeRange(value.to_string()))?,\n503\t        ),\n504\t        until: Some(\n505\t            DateTime::parse_rfc3339(until)\n506\t                .map_err(|_| CliError::InvalidTimeRange(value.to_string()))?,\n507\t        ),\n508\t    })\n509\t}\n510\t\n511\tfn next_arg<'a>(args: &'a [String], index: usize, flag: &'static str) -> Result<&'a str, CliError> {\n512\t    args.get(index + 1)\n513\t        .map(String::as_str)\n514\t        .ok_or(CliError::MissingValue(flag))\n515\t}\n516\t\n517\tfn current_git_branch(workspace_root: &Path) -> Option<String> {\n518\t    let git_path = workspace_root.join(\".git\");\n519\t    let head_path = if git_path.is_dir() {\n520\t        git_path.join(\"HEAD\")\n521\t    } else if git_path.is_file() {\n522\t        let gitdir = std::fs::read_to_string(&git_path).ok()?;\n523\t        let relative = gitdir.trim().strip_prefix(\"gitdir:\")?.trim();\n524\t        workspace_root.join(relative).join(\"HEAD\")\n525\t    } else {\n526\t        return None;\n527\t    };\n528\t    let head = std::fs::read_to_string(head_path).ok()?;\n529\t    head.trim()\n530\t        .strip_prefix(\"ref: refs/heads/\")\n531\t        .map(str::to_string)\n532\t}\n533\t\n534\tfn scope_label(scope: &MetricScope) -> &'static str {\n535\t    match scope.kind {\n536\t        MetricScopeKind::Session => \"session\",\n537\t        MetricScopeKind::Branch => \"branch\",\n538\t        MetricScopeKind::Repo => \"repo\",\n539\t        MetricScopeKind::User => \"user\",\n540\t        MetricScopeKind::Organization => \"organization\",\n541\t    }\n542\t}\n543\t\n544\t#[derive(Debug, serde::Deserialize)]\n545\tstruct FixtureBaselineReport {\n546\t    metrics: Vec<MetricValue>,\n547\t}\n548\t\n549\t#[derive(Debug, serde::Deserialize)]\n550\tstruct LegacyBaselineMetric {\n551\t    name: String,\n552\t}\n553\t"}]},"parent_tool_use_id":null,"session_id":"dcdb14de-3541-4532-8220-c4c3ddb6207e","uuid":"b59811da-868b-403a-8c94-91d575daf81c","timestamp":"2026-05-17T16:39:37.711Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/bin/lattice_report.rs","content":"use std::fs;\nuse std::path::{Path, PathBuf};\n\nuse lattice_core::events::{EventQuery, EventReader, EventStore, QueryOrder};\nuse lattice_core::metrics::{\n    merge_missing_current_metrics, report_exit_code, BenchmarkEvidence, MetricScope,\n    MetricScopeKind, MetricSignal, MetricSource, MetricTimeRange, MetricValue, MetricsCollector,\n    RegressionReport, ReportInput, SuccessCriteriaThresholds,\n};\nuse lattice_core::{DateTime, Utc};\nuse thiserror::Error;\nuse tracing_subscriber::EnvFilter;\n\nconst DEFAULT_BENCHMARK_PATH: &str =\n    \"docs/plans/2026-05-16-cognitive-workspace-fork-build/baselines/cognitive_workspace_metrics.json\";\n\nfn main() {\n    if let Err(error) = run() {\n        eprintln!(\"{error}\");\n        std::process::exit(1);\n    }\n}\n\nfn run() -> Result<(), CliError> {\n    init_tracing();\n    let args = CliArgs::parse(std::env::args().skip(1).collect())?;\n    let workspace_root = std::env::current_dir().map_err(CliError::CurrentDir)?;\n    let workspace_root = workspace_root\n        .canonicalize()\n        .unwrap_or_else(|_| workspace_root.clone());\n    let scope = args.metric_scope(&workspace_root)?;\n    let signals = args\n        .signals\n        .clone()\n        .unwrap_or_else(|| MetricSignal::ALL.to_vec());\n    let current = collect_current_metrics(&workspace_root, &scope, &signals)?;\n    let benchmark = BenchmarkEvidence::from_path(&args.benchmark_path())?;\n    let current = merge_missing_current_metrics(current, benchmark.as_ref());\n    let baseline = match &args.baseline {\n        Some(path) => Some(load_baseline_metrics(path)?),\n        None => None,\n    };\n    let report = RegressionReport::build(ReportInput {\n        current,\n        baseline,\n        benchmark_report_path: args.benchmark_path(),\n        scope: scope.clone(),\n        success_criteria: SuccessCriteriaThresholds::initial(),\n    })?;\n    tracing::info!(\n        scope = scope_label(&scope),\n        signal_count = report.rows.len(),\n        pass_count = report.pass_count,\n        fail_count = report.fail_count,\n        format = args.format.as_str(),\n        \"lattice_report evaluated phase 9 thresholds\"\n    );\n    let rendered = args.render(&report)?;\n    write_output(args.output.as_deref(), &rendered)?;\n    let exit_code = report_exit_code(&report, args.fail_on_regression);\n    if exit_code != 0 {\n        std::process::exit(exit_code);\n    }\n    Ok(())\n}\n\n#[derive(Debug, Clone)]\nstruct CliArgs {\n    scope: MetricScopeKind,\n    time_range: Option<MetricTimeRange>,\n    signals: Option<Vec<MetricSignal>>,\n    baseline: Option<PathBuf>,\n    benchmark: Option<PathBuf>,\n    format: OutputFormat,\n    output: Option<PathBuf>,\n    fail_on_regression: bool,\n}\n\n#[derive(Debug, Clone, Copy)]\nenum OutputFormat {\n    Text,\n    Json,\n    CiSummary,\n}\n\nimpl OutputFormat {\n    fn as_str(self) -> &'static str {\n        match self {\n            Self::Text => \"text\",\n            Self::Json => \"json\",\n            Self::CiSummary => \"ci-summary\",\n        }\n    }\n}\n\n#[derive(Debug, Error)]\nenum CliError {\n    #[error(\"unknown argument `{0}`\")]\n    UnknownArgument(String),\n    #[error(\"missing value for `{0}`\")]\n    MissingValue(&'static str),\n    #[error(\"invalid scope `{0}`\")]\n    InvalidScope(String),\n    #[error(\"invalid output format `{0}`\")]\n    InvalidFormat(String),\n    #[error(\"invalid signal `{0}`\")]\n    InvalidSignal(String),\n    #[error(\"invalid time range `{0}`; expected RFC3339,RFC3339\")]\n    InvalidTimeRange(String),\n    #[error(\"session scope requires at least one captured event in the active workspace\")]\n    MissingSessionScope,\n    #[error(\"failed to resolve current directory: {0}\")]\n    CurrentDir(std::io::Error),\n    #[error(\"failed to open event store at {path}: {source}\")]\n    EventStoreOpen {\n        path: PathBuf,\n        source: lattice_core::events::EventStoreError,\n    },\n    #[error(\"failed to read events for metrics collection: {0}\")]\n    EventRead(lattice_core::events::EventQueryError),\n    #[error(\"failed to read output path {path}: {source}\")]\n    OutputWrite {\n        path: PathBuf,\n        source: std::io::Error,\n    },\n    #[error(\"failed to parse baseline metrics at {path}: {message}\")]\n    BaselineParse { path: PathBuf, message: String },\n    #[error(transparent)]\n    Report(#[from] lattice_core::metrics::ReportError),\n    #[error(\"failed to serialize report JSON: {0}\")]\n    JsonRender(serde_json::Error),\n}\n\nimpl CliArgs {\n    fn parse(args: Vec<String>) -> Result<Self, CliError> {\n        let mut scope = MetricScopeKind::Repo;\n        let mut time_range = None;\n        let mut signals = None;\n        let mut baseline = None;\n        let mut benchmark = None;\n        let mut format = OutputFormat::Text;\n        let mut output = None;\n        let mut fail_on_regression = false;\n        let mut index = 0;\n        while index < args.len() {\n            match args[index].as_str() {\n                \"--scope\" => {\n                    scope = parse_scope(next_arg(&args, index, \"--scope\")?)?;\n                    index += 2;\n                }\n                \"--time-range\" => {\n                    time_range = Some(parse_time_range(next_arg(&args, index, \"--time-range\")?)?);\n                    index += 2;\n                }\n                \"--signals\" => {\n                    signals = Some(parse_signals(next_arg(&args, index, \"--signals\")?)?);\n                    index += 2;\n                }\n                \"--baseline\" => {\n                    baseline = Some(PathBuf::from(next_arg(&args, index, \"--baseline\")?));\n                    index += 2;\n                }\n                \"--benchmark\" => {\n                    benchmark = Some(PathBuf::from(next_arg(&args, index, \"--benchmark\")?));\n                    index += 2;\n                }\n                \"--format\" => {\n                    format = parse_format(next_arg(&args, index, \"--format\")?)?;\n                    index += 2;\n                }\n                \"--output\" => {\n                    output = Some(PathBuf::from(next_arg(&args, index, \"--output\")?));\n                    index += 2;\n                }\n                \"--fail-on-regression\" => {\n                    fail_on_regression = true;\n                    index += 1;\n                }\n                other => return Err(CliError::UnknownArgument(other.to_string())),\n            }\n        }\n        Ok(Self {\n            scope,\n            time_range,\n            signals,\n            baseline,\n            benchmark,\n            format,\n            output,\n            fail_on_regression,\n        })\n    }\n\n    fn benchmark_path(&self) -> PathBuf {\n        self.benchmark\n            .clone()\n            .unwrap_or_else(|| PathBuf::from(DEFAULT_BENCHMARK_PATH))\n    }\n\n    fn metric_scope(&self, workspace_root: &Path) -> Result<MetricScope, CliError> {\n        let scope = match self.scope {\n            MetricScopeKind::Session => {\n                MetricScope::session(resolve_latest_session(workspace_root)?)\n            }\n            MetricScopeKind::Branch => MetricScope::branch(\n                workspace_root.to_string_lossy(),\n                current_git_branch(workspace_root).unwrap_or_else(|| \"main\".to_string()),\n            ),\n            MetricScopeKind::Repo => MetricScope::repo(workspace_root.to_string_lossy()),\n            MetricScopeKind::User => MetricScope {\n                kind: MetricScopeKind::User,\n                workspace_id: None,\n                branch: None,\n                session_id: None,\n                user_id: None,\n                organization_id: None,\n                time_range: None,\n            },\n            MetricScopeKind::Organization => MetricScope {\n                kind: MetricScopeKind::Organization,\n                workspace_id: None,\n                branch: None,\n                session_id: None,\n                user_id: None,\n                organization_id: None,\n                time_range: None,\n            },\n        };\n        Ok(match &self.time_range {\n            Some(range) => scope.with_time_range(range.since, range.until),\n            None => scope,\n        })\n    }\n\n    fn render(&self, report: &RegressionReport) -> Result<String, CliError> {\n        match self.format {\n            OutputFormat::Text => Ok(report.render_text()),\n            OutputFormat::Json => report.render_json().map_err(CliError::JsonRender),\n            OutputFormat::CiSummary => Ok(report.render_ci_summary()),\n        }\n    }\n}\n\nfn collect_current_metrics(\n    workspace_root: &Path,\n    scope: &MetricScope,\n    signals: &[MetricSignal],\n) -> Result<Vec<MetricValue>, CliError> {\n    let events = load_scope_events(workspace_root, scope)?;\n    for signal in signals {\n        tracing::info!(\n            signal = signal.as_str(),\n            source = \"event_log\",\n            event_count = events.len(),\n            \"lattice_report collected live signal input\"\n        );\n    }\n    Ok(MetricsCollector::new()\n        .with_events(events)\n        .collect(scope.clone(), signals))\n}\n\nfn load_scope_events(\n    workspace_root: &Path,\n    scope: &MetricScope,\n) -> Result<Vec<lattice_core::events::EventEnvelope>, CliError> {\n    let event_store_path = workspace_root.join(\".lattice\").join(\"events.db\");\n    let store = EventStore::open(&event_store_path).map_err(|source| CliError::EventStoreOpen {\n        path: event_store_path,\n        source,\n    })?;\n    let reader = EventReader::new(std::sync::Arc::new(store));\n    let query = event_query_for_scope(workspace_root, scope)?;\n    reader.execute(query).map_err(CliError::EventRead)\n}\n\nfn event_query_for_scope(\n    workspace_root: &Path,\n    scope: &MetricScope,\n) -> Result<EventQuery, CliError> {\n    let mut query = match scope.kind {\n        MetricScopeKind::Session => EventQuery::new()\n            .session(\n                scope\n                    .session_id\n                    .clone()\n                    .ok_or(CliError::MissingSessionScope)?,\n            )\n            .workspace(workspace_root.to_string_lossy()),\n        MetricScopeKind::Branch | MetricScopeKind::Repo => EventQuery::new()\n            .workspace(workspace_root.to_string_lossy())\n            .branch(current_git_branch(workspace_root).unwrap_or_else(|| \"main\".to_string())),\n        MetricScopeKind::User | MetricScopeKind::Organization => {\n            return Ok(EventQuery::new()\n                .workspace(workspace_root.to_string_lossy())\n                .branch(current_git_branch(workspace_root).unwrap_or_else(|| \"main\".to_string()))\n                .limit(1));\n        }\n    }\n    .order(QueryOrder::OldestFirst)\n    .limit(1_000);\n    if let Some(range) = &scope.time_range {\n        if let Some(since) = range.since {\n            query = query.after(since);\n        }\n        if let Some(until) = range.until {\n            query = query.before(until);\n        }\n    }\n    Ok(query)\n}\n\nfn resolve_latest_session(workspace_root: &Path) -> Result<String, CliError> {\n    let event_store_path = workspace_root.join(\".lattice\").join(\"events.db\");\n    let store = EventStore::open(&event_store_path).map_err(|source| CliError::EventStoreOpen {\n        path: event_store_path,\n        source,\n    })?;\n    let reader = EventReader::new(std::sync::Arc::new(store));\n    let query = EventQuery::new()\n        .workspace(workspace_root.to_string_lossy())\n        .branch(current_git_branch(workspace_root).unwrap_or_else(|| \"main\".to_string()))\n        .order(QueryOrder::NewestFirst)\n        .limit(1);\n    let latest = reader.execute(query).map_err(CliError::EventRead)?;\n    latest\n        .first()\n        .map(|event| event.session_id.value.clone())\n        .ok_or(CliError::MissingSessionScope)\n}\n\nfn load_baseline_metrics(path: &Path) -> Result<Vec<MetricValue>, CliError> {\n    let body = fs::read_to_string(path).map_err(|error| CliError::BaselineParse {\n        path: path.to_path_buf(),\n        message: error.to_string(),\n    })?;\n    if let Ok(metrics) = serde_json::from_str::<Vec<MetricValue>>(&body) {\n        return Ok(metrics);\n    }\n    if let Ok(fixtures) = serde_json::from_str::<Vec<FixtureBaselineReport>>(&body) {\n        return Ok(flatten_fixture_metrics(&fixtures));\n    }\n    if let Ok(legacy) = serde_json::from_str::<Vec<LegacyBaselineMetric>>(&body) {\n        return Ok(legacy_baseline_metrics(&legacy));\n    }\n    Err(CliError::BaselineParse {\n        path: path.to_path_buf(),\n        message: \"unsupported baseline schema\".to_string(),\n    })\n}\n\nfn flatten_fixture_metrics(fixtures: &[FixtureBaselineReport]) -> Vec<MetricValue> {\n    let mut merged = Vec::new();\n    for signal in MetricSignal::ALL {\n        let values = fixtures\n            .iter()\n            .flat_map(|fixture| fixture.metrics.iter())\n            .filter(|metric| metric.signal == signal)\n            .filter_map(|metric| metric.value)\n            .collect::<Vec<_>>();\n        if values.is_empty() {\n            continue;\n        }\n        let mean = values.iter().sum::<f64>() / values.len() as f64;\n        merged.push(MetricValue {\n            signal,\n            value: Some(mean),\n            denominator: Some(values.len() as u64),\n            sample_count: values.len() as u64,\n            source: fixtures\n                .iter()\n                .flat_map(|fixture| fixture.metrics.iter())\n                .find(|metric| metric.signal == signal)\n                .map(|metric| metric.source)\n                .unwrap_or(MetricSource::EventLog),\n            computed_at: fixtures\n                .iter()\n                .flat_map(|fixture| fixture.metrics.iter().map(|metric| metric.computed_at))\n                .max_by_key(|value| value.unix_seconds())\n                .unwrap_or_else(Utc::now),\n            incomplete: false,\n            reason_if_null: None,\n        });\n    }\n    merged\n}\n\nfn legacy_baseline_metrics(legacy: &[LegacyBaselineMetric]) -> Vec<MetricValue> {\n    let count = legacy\n        .iter()\n        .filter(|metric| {\n            matches!(\n                metric.name.as_str(),\n                \"prepare_change\"\n                    | \"get_context_capsule\"\n                    | \"find_relevant_tests\"\n                    | \"impact_from_diff\"\n                    | \"diagnose_failure\"\n            )\n        })\n        .count() as f64;\n    let mut metrics = Vec::new();\n    if count > 0.0 {\n        metrics.push(MetricValue {\n            signal: MetricSignal::ToolCallsPerSuccessfulTask,\n            value: Some(count),\n            denominator: Some(1),\n            sample_count: 1,\n            source: MetricSource::WorkflowOutcome,\n            computed_at: Utc::now(),\n            incomplete: false,\n            reason_if_null: None,\n        });\n        metrics.push(MetricValue {\n            signal: MetricSignal::IrrelevantFilesOpenedPerTask,\n            value: None,\n            denominator: None,\n            sample_count: 0,\n            source: MetricSource::EventLog,\n            computed_at: Utc::now(),\n            incomplete: false,\n            reason_if_null: Some(\n                \"legacy baseline bench did not capture irrelevant file read counts\".to_string(),\n            ),\n        });\n    }\n    metrics\n}\n\nfn write_output(path: Option<&Path>, rendered: &str) -> Result<(), CliError> {\n    if let Some(path) = path {\n        fs::write(path, rendered).map_err(|source| CliError::OutputWrite {\n            path: path.to_path_buf(),\n            source,\n        })?;\n    } else {\n        println!(\"{rendered}\");\n    }\n    Ok(())\n}\n\nfn init_tracing() {\n    let _ = tracing_subscriber::fmt()\n        .with_env_filter(EnvFilter::from_default_env())\n        .with_writer(std::io::stderr)\n        .try_init();\n}\n\nfn parse_scope(value: &str) -> Result<MetricScopeKind, CliError> {\n    match value {\n        \"session\" => Ok(MetricScopeKind::Session),\n        \"branch\" => Ok(MetricScopeKind::Branch),\n        \"repo\" => Ok(MetricScopeKind::Repo),\n        \"user\" => Ok(MetricScopeKind::User),\n        \"organization\" => Ok(MetricScopeKind::Organization),\n        other => Err(CliError::InvalidScope(other.to_string())),\n    }\n}\n\nfn parse_format(value: &str) -> Result<OutputFormat, CliError> {\n    match value {\n        \"text\" => Ok(OutputFormat::Text),\n        \"json\" => Ok(OutputFormat::Json),\n        \"ci-summary\" => Ok(OutputFormat::CiSummary),\n        other => Err(CliError::InvalidFormat(other.to_string())),\n    }\n}\n\nfn parse_signals(value: &str) -> Result<Vec<MetricSignal>, CliError> {\n    value\n        .split(',')\n        .filter(|item| !item.trim().is_empty())\n        .map(|item| match item.trim() {\n            \"tool_calls_per_successful_task\" => Ok(MetricSignal::ToolCallsPerSuccessfulTask),\n            \"irrelevant_files_opened_per_task\" => Ok(MetricSignal::IrrelevantFilesOpenedPerTask),\n            \"relevant_anchor_recall\" => Ok(MetricSignal::RelevantAnchorRecall),\n            \"memory_inclusion_precision\" => Ok(MetricSignal::MemoryInclusionPrecision),\n            \"memory_later_used_rate\" => Ok(MetricSignal::MemoryLaterUsedRate),\n            \"stale_memory_surfaced_rate\" => Ok(MetricSignal::StaleMemorySurfacedRate),\n            \"contradiction_missed_rate\" => Ok(MetricSignal::ContradictionMissedRate),\n            \"tests_recommended_vs_needed\" => Ok(MetricSignal::TestsRecommendedVsNeeded),\n            \"workflow_success_after_first_plan\" => Ok(MetricSignal::WorkflowSuccessAfterFirstPlan),\n            other => Err(CliError::InvalidSignal(other.to_string())),\n        })\n        .collect()\n}\n\nfn parse_time_range(value: &str) -> Result<MetricTimeRange, CliError> {\n    let mut parts = value.split(',');\n    let since = parts\n        .next()\n        .ok_or_else(|| CliError::InvalidTimeRange(value.to_string()))?;\n    let until = parts\n        .next()\n        .ok_or_else(|| CliError::InvalidTimeRange(value.to_string()))?;\n    if parts.next().is_some() {\n        return Err(CliError::InvalidTimeRange(value.to_string()));\n    }\n    Ok(MetricTimeRange {\n        since: Some(\n            DateTime::parse_rfc3339(since)\n                .map_err(|_| CliError::InvalidTimeRange(value.to_string()))?,\n        ),\n        until: Some(\n            DateTime::parse_rfc3339(until)\n                .map_err(|_| CliError::InvalidTimeRange(value.to_string()))?,\n        ),\n    })\n}\n\nfn next_arg<'a>(args: &'a [String], index: usize, flag: &'static str) -> Result<&'a str, CliError> {\n    args.get(index + 1)\n        .map(String::as_str)\n        .ok_or(CliError::MissingValue(flag))\n}\n\nfn current_git_branch(workspace_root: &Path) -> Option<String> {\n    let git_path = workspace_root.join(\".git\");\n    let head_path = if git_path.is_dir() {\n        git_path.join(\"HEAD\")\n    } else if git_path.is_file() {\n        let gitdir = std::fs::read_to_string(&git_path).ok()?;\n        let relative = gitdir.trim().strip_prefix(\"gitdir:\")?.trim();\n        workspace_root.join(relative).join(\"HEAD\")\n    } else {\n        return None;\n    };\n    let head = std::fs::read_to_string(head_path).ok()?;\n    head.trim()\n        .strip_prefix(\"ref: refs/heads/\")\n        .map(str::to_string)\n}\n\nfn scope_label(scope: &MetricScope) -> &'static str {\n    match scope.kind {\n        MetricScopeKind::Session => \"session\",\n        MetricScopeKind::Branch => \"branch\",\n        MetricScopeKind::Repo => \"repo\",\n        MetricScopeKind::User => \"user\",\n        MetricScopeKind::Organization => \"organization\",\n    }\n}\n\n#[derive(Debug, serde::Deserialize)]\nstruct FixtureBaselineReport {\n    metrics: Vec<MetricValue>,\n}\n\n#[derive(Debug, serde::Deserialize)]\nstruct LegacyBaselineMetric {\n    name: String,\n}\n","numLines":553,"startLine":1,"totalLines":553}}}
