{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R2LYFDmdmq6a6Bcdng3gVt","type":"tool_result","content":"1\tuse std::collections::{BTreeMap, BTreeSet};\n2\tuse std::fs;\n3\tuse std::path::{Path, PathBuf};\n4\tuse std::sync::{Mutex, OnceLock};\n5\tuse std::time::{Instant, SystemTime, UNIX_EPOCH};\n6\t\n7\tuse criterion::{black_box, criterion_group, criterion_main, Criterion};\n8\tuse lattice_core::events::hashing::PayloadHash;\n9\tuse lattice_core::events::{\n10\t    Actor, BranchRef, CompactSummary, EventEnvelope, EventKind, EventPayload, FileReadPayload,\n11\t    PayloadLocation, PlanCreatedPayload, SessionId, TaskId, ToolCalledPayload,\n12\t    WorkflowSucceededPayload,\n13\t};\n14\tuse lattice_core::graph::CodeGraph;\n15\tuse lattice_core::identity::{EventId, FileId, MemoryId, WorkspaceId};\n16\tuse lattice_core::indexer::Indexer;\n17\tuse lattice_core::intelligence::{\n18\t    diagnose_failure, find_relevant_tests, impact_from_diff, prepare_change, BundleMode,\n19\t    DiffImpactReport, FailureDiagnosis, ProjectRule, RulesDetector, TaskBundle,\n20\t    TestSelectionReport,\n21\t};\n22\tuse lattice_core::metrics::{\n23\t    AnchorRecallSample, MemorySurfaceRecord, MetricSampleScope, MetricScope, MetricSignal,\n24\t    MetricValue, MetricsCollector, TestRecommendationSample,\n25\t};\n26\tuse lattice_core::query::{ContextCapsule, QueryEngine};\n27\tuse lattice_core::verification::VerificationStatus;\n28\tuse lattice_core::DateTime;\n29\tuse serde::{Deserialize, Serialize};\n30\tuse tempfile::TempDir;\n31\tuse tracing::info;\n32\t\n33\tconst REPORT_PATH: &str =\n34\t    \"docs/plans/2026-05-16-cognitive-workspace-fork-build/baselines/cognitive_workspace_metrics.json\";\n35\tconst FIXTURE_ROOT: &str = \"benches/fixtures\";\n36\tconst SEED: u64 = 20_260_516;\n37\tconst SAMPLE_COUNT: usize = 48;\n38\tconst WARM_UP_COUNT: usize = 4;\n39\t\n40\tstatic GOLDEN_TASKS: OnceLock<Vec<GoldenTask>> = OnceLock::new();\n41\tstatic REPORTS: OnceLock<Mutex<BTreeMap<String, FixtureReport>>> = OnceLock::new();\n42\t\n43\tstruct FixtureWorkspace {\n44\t    name: String,\n45\t    root: PathBuf,\n46\t    _temp_dir: TempDir,\n47\t}\n48\t\n49\tstruct FixtureRuntime {\n50\t    workspace: FixtureWorkspace,\n51\t    graph: CodeGraph,\n52\t    rules: Vec<ProjectRule>,\n53\t    tasks: Vec<GoldenTask>,\n54\t}\n55\t\n56\t#[derive(Clone, Debug, Deserialize, Serialize)]\n57\tstruct GoldenTask {\n58\t    task_id: String,\n59\t    repo: String,\n60\t    intent: String,\n61\t    task_prompt: String,\n62\t    expected_anchors: Vec<ExpectedAnchor>,\n63\t    expected_tests: Vec<String>,\n64\t    expected_memory_classes: Vec<String>,\n65\t    expected_render_mode: String,\n66\t    success_criteria_thresholds: SuccessCriteriaThresholds,\n67\t}\n68\t\n69\t#[derive(Clone, Debug, Deserialize, Serialize)]\n70\tstruct ExpectedAnchor {\n71\t    file: String,\n72\t    symbol: String,\n73\t    doc_section: String,\n74\t}\n75\t\n76\t#[derive(Clone, Debug, Deserialize, Serialize)]\n77\tstruct SuccessCriteriaThresholds {\n78\t    tool_calls_reduction: f64,\n79\t    irrelevant_file_reads_reduction: f64,\n80\t    relevant_anchor_recall: f64,\n81\t    memory_inclusion_precision: f64,\n82\t    contradiction_missed_rate: f64,\n83\t    stale_memory_unlabeled_rate: f64,\n84\t    tests_recommended_vs_needed: f64,\n85\t}\n86\t\n87\t#[derive(Clone, Debug, Serialize)]\n88\tstruct FixtureReport {\n89\t    fixture: String,\n90\t    deterministic_seed: u64,\n91\t    indexed_files: usize,\n92\t    node_count: usize,\n93\t    edge_count: usize,\n94\t    task_reports: Vec<TaskReport>,\n95\t    metrics: Vec<MetricValue>,\n96\t    recorded_at: String,\n97\t}\n98\t\n99\t#[derive(Clone, Debug, Serialize)]\n100\tstruct TaskReport {\n101\t    task_id: String,\n102\t    intent: String,\n103\t    tool_reports: Vec<ToolReport>,\n104\t    returned_anchors: Vec<String>,\n105\t    expected_anchors: Vec<String>,\n106\t    expected_tests: Vec<String>,\n107\t    recommended_tests: Vec<String>,\n108\t}\n109\t\n110\t#[derive(Clone, Debug, Serialize)]\n111\tstruct ToolReport {\n112\t    tool: String,\n113\t    latency_us: u64,\n114\t    payload_bytes: usize,\n115\t    anchor_count: usize,\n116\t}\n117\t\n118\tfn bench_cross_language_fixtures(c: &mut Criterion) {\n119\t    for fixture in [\"rust-repo\", \"typescript-repo\", \"python-repo\"] {\n120\t        register_fixture_benchmark(c, fixture);\n121\t    }\n122\t}\n123\t\n124\tfn register_fixture_benchmark(c: &mut Criterion, fixture: &'static str) {\n125\t    let runtime = build_fixture_runtime(fixture);\n126\t    let report = measure_fixture(&runtime);\n127\t    store_fixture_report(report);\n128\t    c.bench_function(&format!(\"cognitive_workspace/{fixture}\"), |b| {\n129\t        b.iter(|| black_box(run_fixture_runtime(&runtime)))\n130\t    });\n131\t}\n132\t\n133\tfn measure_fixture(runtime: &FixtureRuntime) -> FixtureReport {\n134\t    warm_up(runtime);\n135\t    let mut last_report = run_fixture_runtime(runtime);\n136\t    for _ in 0..SAMPLE_COUNT {\n137\t        last_report = run_fixture_runtime(runtime);\n138\t    }\n139\t    last_report\n140\t}\n141\t\n142\tfn warm_up(runtime: &FixtureRuntime) {\n143\t    for _ in 0..WARM_UP_COUNT {\n144\t        black_box(run_fixture_runtime(runtime));\n145\t    }\n146\t}\n147\t\n148\tfn run_fixture_runtime(runtime: &FixtureRuntime) -> FixtureReport {\n149\t    let task_reports = runtime\n150\t        .tasks\n151\t        .iter()\n152\t        .map(|task| run_task(&runtime, task))\n153\t        .collect::<Vec<_>>();\n154\t    let metrics = collect_metrics(&runtime, &task_reports);\n155\t    FixtureReport {\n156\t        fixture: runtime.workspace.name.clone(),\n157\t        deterministic_seed: SEED,\n158\t        indexed_files: graph_file_count(&runtime.graph),\n159\t        node_count: runtime.graph.node_count(),\n160\t        edge_count: runtime.graph.edge_count(),\n161\t        task_reports,\n162\t        metrics,\n163\t        recorded_at: recorded_at(),\n164\t    }\n165\t}\n166\t\n167\tfn build_fixture_runtime(fixture: &str) -> FixtureRuntime {\n168\t    let workspace = materialize_workspace(fixture);\n169\t    let graph = index_workspace(&workspace.root);\n170\t    let tasks = golden_tasks()\n171\t        .iter()\n172\t        .filter(|task| task.repo == fixture)\n173\t        .cloned()\n174\t        .collect::<Vec<_>>();\n175\t    assert!(!tasks.is_empty(), \"no golden tasks for fixture {fixture}\");\n176\t    let rules = detect_rules(&graph);\n177\t    FixtureRuntime {\n178\t        workspace,\n179\t        graph,\n180\t        rules,\n181\t        tasks,\n182\t    }\n183\t}\n184\t\n185\tfn materialize_workspace(fixture: &str) -> FixtureWorkspace {\n186\t    let temp_dir = TempDir::new().expect(\"create fixture temp workspace\");\n187\t    let root = temp_dir.path().join(fixture);\n188\t    copy_dir(&fixture_source_path(fixture), &root);\n189\t    fs::create_dir_all(root.join(\".lattice\")).expect(\"create isolated .lattice directory\");\n190\t    FixtureWorkspace {\n191\t        name: fixture.to_string(),\n192\t        root,\n193\t        _temp_dir: temp_dir,\n194\t    }\n195\t}\n196\t\n197\tfn copy_dir(source: &Path, target: &Path) {\n198\t    fs::create_dir_all(target).expect(\"create fixture copy target\");\n199\t    for entry in fs::read_dir(source).expect(\"read fixture source\") {\n200\t        let entry = entry.expect(\"read fixture source entry\");\n201\t        let source_path = entry.path();\n202\t        let target_path = target.join(entry.file_name());\n203\t        if source_path.is_dir() {\n204\t            copy_dir(&source_path, &target_path);\n205\t        } else {\n206\t            fs::copy(&source_path, &target_path).expect(\"copy fixture file\");\n207\t        }\n208\t    }\n209\t}\n210\t\n211\tfn index_workspace(root: &Path) -> CodeGraph {\n212\t    let runtime = tokio::runtime::Runtime::new().expect(\"benchmark runtime\");\n213\t    let mut indexer = Indexer::new(root.to_path_buf());\n214\t    runtime\n215\t        .block_on(indexer.index_directory_parallel(root))\n216\t        .expect(\"index fixture workspace\");\n217\t    indexer.graph().clone()\n218\t}\n219\t\n220\tfn run_task(runtime: &FixtureRuntime, task: &GoldenTask) -> TaskReport {\n221\t    let mut reports = Vec::new();\n222\t    let context = time_tool(\"get_context_capsule\", || context_capsule(runtime, task));\n223\t    reports.push(context.0);\n224\t    let prepare = time_tool(\"prepare_change\", || {\n225\t        prepare_report(runtime, task, &context.1)\n226\t    });\n227\t    reports.push(prepare.0);\n228\t    let tests = time_tool(\"find_relevant_tests\", || tests_report(runtime, task));\n229\t    reports.push(tests.0);\n230\t    let impact = time_tool(\"impact_from_diff\", || impact_report(runtime, task));\n231\t    reports.push(impact.0);\n232\t    let diagnosis = time_tool(\"diagnose_failure\", || diagnosis_report(runtime, task));\n233\t    reports.push(diagnosis.0);\n234\t    log_task_tools(runtime, task, &reports);\n235\t    TaskReport {\n236\t        task_id: task.task_id.clone(),\n237\t        intent: task.intent.clone(),\n238\t        returned_anchors: returned_anchors(\n239\t            &context.1,\n240\t            &prepare.1,\n241\t            &tests.1,\n242\t            &impact.1,\n243\t            &diagnosis.1,\n244\t        ),\n245\t        expected_anchors: task_anchor_ids(task),\n246\t        expected_tests: task.expected_tests.clone(),\n247\t        recommended_tests: tests.1.tests.iter().map(|test| test.file.clone()).collect(),\n248\t        tool_reports: reports,\n249\t    }\n250\t}\n251\t\n252\tfn time_tool<T, F>(tool: &str, run: F) -> (ToolReport, T)\n253\twhere\n254\t    T: Serialize,\n255\t    F: FnOnce() -> T,\n256\t{\n257\t    let started_at = Instant::now();\n258\t    let result = run();\n259\t    let payload_bytes = serde_json::to_vec(&result)\n260\t        .expect(\"serialize workflow tool result\")\n261\t        .len();\n262\t    let report = ToolReport {\n263\t        tool: tool.to_string(),\n264\t        latency_us: elapsed_us(started_at),\n265\t        payload_bytes,\n266\t        anchor_count: payload_anchor_count(&result),\n267\t    };\n268\t    (report, result)\n269\t}\n270\t\n271\tfn context_capsule(runtime: &FixtureRuntime, task: &GoldenTask) -> ContextCapsule {\n272\t    let mut engine = QueryEngine::new(runtime.graph.clone(), None, None);\n273\t    engine.query(&task.task_prompt, None, false)\n274\t}\n275\t\n276\tfn prepare_report(\n277\t    runtime: &FixtureRuntime,\n278\t    task: &GoldenTask,\n279\t    capsule: &ContextCapsule,\n280\t) -> TaskBundle {\n281\t    prepare_change(\n282\t        &runtime.graph,\n283\t        capsule,\n284\t        &task_anchor_files(task),\n285\t        &task_anchor_symbols(task),\n286\t        &runtime.rules,\n287\t        BundleMode::Compact,\n288\t    )\n289\t}\n290\t\n291\tfn tests_report(runtime: &FixtureRuntime, task: &GoldenTask) -> TestSelectionReport {\n292\t    find_relevant_tests(\n293\t        &runtime.graph,\n294\t        &task_anchor_files(task),\n295\t        &task_anchor_symbols(task),\n296\t        None,\n297\t        &runtime.rules,\n298\t        8,\n299\t    )\n300\t}\n301\t\n302\tfn impact_report(runtime: &FixtureRuntime, task: &GoldenTask) -> DiffImpactReport {\n303\t    impact_from_diff(\n304\t        &runtime.graph,\n305\t        &task_diff(task),\n306\t        &task_anchor_files(task),\n307\t        &task_anchor_symbols(task),\n308\t        &runtime.rules,\n309\t        BundleMode::Compact,\n310\t        2,\n311\t    )\n312\t}\n313\t\n314\tfn diagnosis_report(runtime: &FixtureRuntime, task: &GoldenTask) -> FailureDiagnosis {\n315\t    diagnose_failure(\n316\t        &runtime.graph,\n317\t        &failure_text(task),\n318\t        Some(\"test\"),\n319\t        &runtime.rules,\n320\t        BundleMode::Compact,\n321\t    )\n322\t}\n323\t\n324\tfn collect_metrics(runtime: &FixtureRuntime, reports: &[TaskReport]) -> Vec<MetricValue> {\n325\t    let events = reports\n326\t        .iter()\n327\t        .flat_map(|report| task_events(runtime, report))\n328\t        .collect::<Vec<_>>();\n329\t    let scope = MetricScope::session(session_id(&runtime.workspace.name));\n330\t    MetricsCollector::new()\n331\t        .with_events(events)\n332\t        .with_anchor_recall_samples(anchor_samples(runtime, reports))\n333\t        .with_test_recommendation_samples(test_samples(runtime, reports))\n334\t        .with_memory_surface_records(memory_records(runtime, reports))\n335\t        .with_computed_at(DateTime::from_unix_seconds(1_779_000_000))\n336\t        .collect(scope, &MetricSignal::ALL)\n337\t}\n338\t\n339\tfn task_events(runtime: &FixtureRuntime, report: &TaskReport) -> Vec<EventEnvelope> {\n340\t    let mut events = Vec::new();\n341\t    for (index, tool) in report.tool_reports.iter().enumerate() {\n342\t        events.push(tool_called_event(runtime, report, tool, index as i64));\n343\t    }\n344\t    events.push(file_read_event(runtime, report, \"irrelevant/noise.rs\", 30));\n345\t    events.push(plan_created_event(runtime, report, 40));\n346\t    events.push(workflow_succeeded_event(runtime, report, 50));\n347\t    events\n348\t}\n349\t\n350\tfn anchor_samples(runtime: &FixtureRuntime, reports: &[TaskReport]) -> Vec<AnchorRecallSample> {\n351\t    reports\n352\t        .iter()\n353\t        .enumerate()\n354\t        .map(|(index, report)| AnchorRecallSample {\n355\t            scope: sample_scope(runtime, report, 100 + index as i64),\n356\t            golden_anchors: report.expected_anchors.clone(),\n357\t            returned_anchors: report.returned_anchors.clone(),\n358\t        })\n359\t        .collect()\n360\t}\n361\t\n362\tfn test_samples(runtime: &FixtureRuntime, reports: &[TaskReport]) -> Vec<TestRecommendationSample> {\n363\t    reports\n364\t        .iter()\n365\t        .enumerate()\n366\t        .map(|(index, report)| TestRecommendationSample {\n367\t            scope: sample_scope(runtime, report, 200 + index as i64),\n368\t            recommended_tests: report.recommended_tests.clone(),\n369\t            needed_tests: report.expected_tests.clone(),\n370\t        })\n371\t        .collect()\n372\t}\n373\t\n374\tfn memory_records(runtime: &FixtureRuntime, reports: &[TaskReport]) -> Vec<MemorySurfaceRecord> {\n375\t    reports\n376\t        .iter()\n377\t        .enumerate()\n378\t        .map(|(index, report)| MemorySurfaceRecord {\n379\t            scope: sample_scope(runtime, report, 300 + index as i64),\n380\t            retrieval_event_id: event_id(runtime, 300 + index as i64),\n381\t            memory_id: memory_id(runtime, report),\n382\t            verification_status: VerificationStatus::Verified,\n383\t            stale_label_surfaced: false,\n384\t            contradiction_link_present: false,\n385\t            contradiction_surfaced: false,\n386\t            used_downstream: true,\n387\t            reused_later: true,\n388\t        })\n389\t        .collect()\n390\t}\n391\t\n392\tfn returned_anchors(\n393\t    context: &ContextCapsule,\n394\t    prepare: &TaskBundle,\n395\t    tests: &TestSelectionReport,\n396\t    impact: &DiffImpactReport,\n397\t    diagnosis: &FailureDiagnosis,\n398\t) -> Vec<String> {\n399\t    let mut anchors = BTreeSet::new();\n400\t    anchors.extend(\n401\t        context\n402\t            .pivots\n403\t            .iter()\n404\t            .map(|node| anchor_id(&node.file, &node.symbol)),\n405\t    );\n406\t    anchors.extend(prepare.primary_files.iter().map(|file| file.file.clone()));\n407\t    anchors.extend(tests.tests.iter().map(|test| test.file.clone()));\n408\t    anchors.extend(\n409\t        impact\n410\t            .changed_symbols\n411\t            .iter()\n412\t            .map(|symbol| anchor_id(&symbol.file, &symbol.symbol)),\n413\t    );\n414\t    anchors.extend(\n415\t        diagnosis\n416\t            .suspects\n417\t            .iter()\n418\t            .map(|symbol| anchor_id(&symbol.file, &symbol.symbol)),\n419\t    );\n420\t    anchors.into_iter().collect()\n421\t}\n422\t\n423\tfn payload_anchor_count<T: Serialize>(payload: &T) -> usize {\n424\t    serde_json::to_value(payload)\n425\t        .ok()\n426\t        .and_then(|value| value.as_object().map(|object| object.len()))\n427\t        .unwrap_or_default()\n428\t}\n429\t\n430\tfn task_anchor_files(task: &GoldenTask) -> Vec<String> {\n431\t    task.expected_anchors\n432\t        .iter()\n433\t        .map(|anchor| anchor.file.clone())\n434\t        .collect::<BTreeSet<_>>()\n435\t        .into_iter()\n436\t        .collect()\n437\t}\n438\t\n439\tfn task_anchor_symbols(task: &GoldenTask) -> Vec<String> {\n440\t    task.expected_anchors\n441\t        .iter()\n442\t        .map(|anchor| anchor.symbol.clone())\n443\t        .collect::<BTreeSet<_>>()\n444\t        .into_iter()\n445\t        .collect()\n446\t}\n447\t\n448\tfn task_anchor_ids(task: &GoldenTask) -> Vec<String> {\n449\t    task.expected_anchors\n450\t        .iter()\n451\t        .map(|anchor| anchor_id(&anchor.file, &anchor.symbol))\n452\t        .collect()\n453\t}\n454\t\n455\tfn anchor_id(file: &str, symbol: &str) -> String {\n456\t    format!(\"{file}::{symbol}\")\n457\t}\n458\t\n459\tfn task_diff(task: &GoldenTask) -> String {\n460\t    let file = task\n461\t        .expected_anchors\n462\t        .first()\n463\t        .expect(\"task has expected anchors\")\n464\t        .file\n465\t        .clone();\n466\t    format!(\n467\t        \"diff --git a/{file} b/{file}\\n--- a/{file}\\n+++ b/{file}\\n@@ -1,3 +1,4 @@\\n- old behavior\\n+ new behavior\\n\"\n468\t    )\n469\t}\n470\t\n471\tfn failure_text(task: &GoldenTask) -> String {\n472\t    format!(\n473\t        \"AssertionError: fixture task {} failed\\n  at {}\\n\",\n474\t        task.task_id,\n475\t        task.expected_tests\n476\t            .first()\n477\t            .expect(\"task has expected tests\")\n478\t    )\n479\t}\n480\t\n481\tfn log_task_tools(runtime: &FixtureRuntime, task: &GoldenTask, reports: &[ToolReport]) {\n482\t    for report in reports {\n483\t        info!(\n484\t            fixture = runtime.workspace.name.as_str(),\n485\t            task_id = task.task_id.as_str(),\n486\t            tool = report.tool.as_str(),\n487\t            latency_ms = report.latency_us as f64 / 1_000.0,\n488\t            metric_signal_count = MetricSignal::ALL.len(),\n489\t            \"cognitive workspace benchmark tool run\"\n490\t        );\n491\t    }\n492\t}\n493\t\n494\tfn detect_rules(graph: &CodeGraph) -> Vec<ProjectRule> {\n495\t    let mut files: Vec<String> = graph\n496\t        .all_nodes()\n497\t        .into_iter()\n498\t        .map(|node| node.file.clone())\n499\t        .collect();\n500\t    files.sort();\n501\t    files.dedup();\n502\t    RulesDetector::new().detect_rules(&files)\n503\t}\n504\t\n505\tfn graph_file_count(graph: &CodeGraph) -> usize {\n506\t    graph\n507\t        .all_nodes()\n508\t        .into_iter()\n509\t        .map(|node| node.file.clone())\n510\t        .collect::<BTreeSet<_>>()\n511\t        .len()\n512\t}\n513\t\n514\tfn golden_tasks() -> &'static [GoldenTask] {\n515\t    GOLDEN_TASKS.get_or_init(load_golden_tasks)\n516\t}\n517\t\n518\tfn load_golden_tasks() -> Vec<GoldenTask> {\n519\t    let path = fixture_root().join(\"golden_anchors.json\");\n520\t    let body = fs::read_to_string(&path).expect(\"read golden anchors\");\n521\t    let tasks: Vec<GoldenTask> = serde_json::from_str(&body).expect(\"parse golden anchors\");\n522\t    validate_golden_tasks(&tasks);\n523\t    tasks\n524\t}\n525\t\n526\tfn validate_golden_tasks(tasks: &[GoldenTask]) {\n527\t    assert!(!tasks.is_empty(), \"golden anchors must contain tasks\");\n528\t    let mut ids = BTreeSet::new();\n529\t    for task in tasks {\n530\t        assert!(\n531\t            ids.insert(task.task_id.clone()),\n532\t            \"duplicate task_id {}\",\n533\t            task.task_id\n534\t        );\n535\t        assert!(!task.repo.is_empty(), \"task {} missing repo\", task.task_id);\n536\t        assert!(\n537\t            !task.intent.is_empty(),\n538\t            \"task {} missing intent\",\n539\t            task.task_id\n540\t        );\n541\t        assert!(\n542\t            !task.expected_anchors.is_empty(),\n543\t            \"task {} missing anchors\",\n544\t            task.task_id\n545\t        );\n546\t        assert!(\n547\t            !task.expected_tests.is_empty(),\n548\t            \"task {} missing tests\",\n549\t            task.task_id\n550\t        );\n551\t        validate_thresholds(task);\n552\t    }\n553\t}\n554\t\n555\tfn validate_thresholds(task: &GoldenTask) {\n556\t    let thresholds = &task.success_criteria_thresholds;\n557\t    assert!(\n558\t        thresholds.relevant_anchor_recall >= 0.8,\n559\t        \"anchor recall threshold\"\n560\t    );\n561\t    assert!(\n562\t        thresholds.memory_inclusion_precision >= 0.8,\n563\t        \"memory precision threshold\"\n564\t    );\n565\t    assert!(\n566\t        thresholds.tests_recommended_vs_needed >= 0.9,\n567\t        \"test threshold\"\n568\t    );\n569\t    assert_eq!(\n570\t        thresholds.contradiction_missed_rate, 0.0,\n571\t        \"contradiction threshold\"\n572\t    );\n573\t    assert_eq!(\n574\t        thresholds.stale_memory_unlabeled_rate, 0.0,\n575\t        \"stale threshold\"\n576\t    );\n577\t}\n578\t\n579\tfn store_fixture_report(report: FixtureReport) {\n580\t    let reports = REPORTS.get_or_init(|| Mutex::new(BTreeMap::new()));\n581\t    let mut guard = reports.lock().expect(\"cognitive benchmark report lock\");\n582\t    guard.insert(report.fixture.clone(), report);\n583\t    write_report_snapshot(&guard);\n584\t}\n585\t\n586\tfn write_report_snapshot(reports: &BTreeMap<String, FixtureReport>) {\n587\t    let snapshot = reports.values().collect::<Vec<_>>();\n588\t    let output_path = repo_root().join(REPORT_PATH);\n589\t    if let Some(parent) = output_path.parent() {\n590\t        fs::create_dir_all(parent).expect(\"create cognitive benchmark report directory\");\n591\t    }\n592\t    let body = serde_json::to_string_pretty(&snapshot).expect(\"serialize benchmark report\");\n593\t    let payload = format!(\"{body}\\n\");\n594\t    if let Err(error) = fs::write(&output_path, &payload) {\n595\t        let shadow_path = std::env::temp_dir()\n596\t            .join(\"lattice-benchmarks\")\n597\t            .join(\"cognitive_workspace_metrics.json\");\n598\t        if let Some(parent) = shadow_path.parent() {\n599\t            fs::create_dir_all(parent).expect(\"create shadow benchmark report directory\");\n600\t        }\n601\t        fs::write(&shadow_path, payload).unwrap_or_else(|shadow_error| {\n602\t            panic!(\n603\t                \"write benchmark report to {} failed with {}; shadow write to {} failed with {}\",\n604\t                output_path.display(),\n605\t                error,\n606\t                shadow_path.display(),\n607\t                shadow_error\n608\t            )\n609\t        });\n610\t        eprintln!(\n611\t            \"Benchmark report repo write failed for {}; wrote shadow report to {} instead: {}\",\n612\t            output_path.display(),\n613\t            shadow_path.display(),\n614\t            error\n615\t        );\n616\t    }\n617\t}\n618\t\n619\tfn tool_called_event(\n620\t    runtime: &FixtureRuntime,\n621\t    report: &TaskReport,\n622\t    tool: &ToolReport,\n623\t    second: i64,\n624\t) -> EventEnvelope {\n625\t    event(\n626\t        runtime,\n627\t        report,\n628\t        second,\n629\t        EventKind::ToolCalled,\n630\t        EventPayload::ToolCalled(ToolCalledPayload {\n631\t            call_id: format!(\"{}-{second}\", report.task_id),\n632\t            tool_name: tool.tool.clone(),\n633\t            context_handle_id: None,\n634\t            source_event_id: None,\n635\t            input_summary: report.intent.clone(),\n636\t        }),\n637\t    )\n638\t}\n639\t\n640\tfn file_read_event(\n641\t    runtime: &FixtureRuntime,\n642\t    report: &TaskReport,\n643\t    path: &str,\n644\t    second: i64,\n645\t) -> EventEnvelope {\n646\t    event(\n647\t        runtime,\n648\t        report,\n649\t        second,\n650\t        EventKind::FileRead,\n651\t        EventPayload::FileRead(FileReadPayload {\n652\t            file_id: file_id(runtime, path),\n653\t            source_event_id: None,\n654\t            byte_start: None,\n655\t            byte_end: None,\n656\t            reason: \"benchmark irrelevant read sentinel\".to_string(),\n657\t        }),\n658\t    )\n659\t}\n660\t\n661\tfn plan_created_event(runtime: &FixtureRuntime, report: &TaskReport, second: i64) -> EventEnvelope {\n662\t    event(\n663\t        runtime,\n664\t        report,\n665\t        second,\n666\t        EventKind::PlanCreated,\n667\t        EventPayload::PlanCreated(PlanCreatedPayload {\n668\t            context_handle_id: None,\n669\t            source_event_id: None,\n670\t            memory_ids: Vec::new(),\n671\t            step_count: 3,\n672\t            plan_summary: report.intent.clone(),\n673\t        }),\n674\t    )\n675\t}\n676\t\n677\tfn workflow_succeeded_event(\n678\t    runtime: &FixtureRuntime,\n679\t    report: &TaskReport,\n680\t    second: i64,\n681\t) -> EventEnvelope {\n682\t    event(\n683\t        runtime,\n684\t        report,\n685\t        second,\n686\t        EventKind::WorkflowSucceeded,\n687\t        EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n688\t            workflow_name: \"cognitive_workspace_benchmark\".to_string(),\n689\t            terminal_event_id: None,\n690\t            output_context_handle_id: None,\n691\t            memory_ids: vec![memory_id(runtime, report)],\n692\t            result_summary: report.intent.clone(),\n693\t        }),\n694\t    )\n695\t}\n696\t\n697\tfn event(\n698\t    runtime: &FixtureRuntime,\n699\t    report: &TaskReport,\n700\t    second: i64,\n701\t    kind: EventKind,\n702\t    payload: EventPayload,\n703\t) -> EventEnvelope {\n704\t    EventEnvelope::new(\n705\t        event_id(runtime, second),\n706\t        WorkspaceId::from(runtime.workspace.name.clone()),\n707\t        BranchRef {\n708\t            name: \"main\".to_string(),\n709\t        },\n710\t        SessionId {\n711\t            value: session_id(&runtime.workspace.name),\n712\t        },\n713\t        Some(TaskId {\n714\t            value: report.task_id.clone(),\n715\t        }),\n716\t        Actor::Assistant {\n717\t            model: \"criterion\".to_string(),\n718\t        },\n719\t        DateTime::from_unix_seconds(1_779_000_000 + second),\n720\t        kind,\n721\t        Vec::new(),\n722\t        PayloadHash::new([second as u8; 32]),\n723\t        CompactSummary::new(format!(\"{}-{second}\", report.task_id)).expect(\"summary\"),\n724\t        PayloadLocation::Inline { bytes_len: 128 },\n725\t        payload,\n726\t    )\n727\t    .expect(\"benchmark event envelope\")\n728\t}\n729\t\n730\tfn sample_scope(runtime: &FixtureRuntime, report: &TaskReport, second: i64) -> MetricSampleScope {\n731\t    MetricSampleScope {\n732\t        workspace_id: runtime.workspace.name.clone(),\n733\t        branch: Some(\"main\".to_string()),\n734\t        session_id: Some(session_id(&runtime.workspace.name)),\n735\t        user_id: None,\n736\t        organization_id: None,\n737\t        task_id: Some(report.task_id.clone()),\n738\t        observed_at: DateTime::from_unix_seconds(1_779_000_000 + second),\n739\t    }\n740\t}\n741\t\n742\tfn event_id(runtime: &FixtureRuntime, second: i64) -> EventId {\n743\t    EventId {\n744\t        workspace_id: runtime.workspace.name.clone(),\n745\t        ulid: format!(\"evt-{second}\"),\n746\t    }\n747\t}\n748\t\n749\tfn file_id(runtime: &FixtureRuntime, path: &str) -> FileId {\n750\t    FileId {\n751\t        workspace_id: runtime.workspace.name.clone(),\n752\t        repo_relative_path: path.to_string(),\n753\t        content_hash: format!(\"hash-{path}\"),\n754\t    }\n755\t}\n756\t\n757\tfn memory_id(runtime: &FixtureRuntime, report: &TaskReport) -> MemoryId {\n758\t    MemoryId {\n759\t        workspace_id: runtime.workspace.name.clone(),\n760\t        ulid: format!(\"mem-{}\", report.task_id),\n761\t    }\n762\t}\n763\t\n764\tfn session_id(fixture: &str) -> String {\n765\t    format!(\"session-{fixture}\")\n766\t}\n767\t\n768\tfn elapsed_us(started_at: Instant) -> u64 {\n769\t    let nanos = started_at.elapsed().as_nanos();\n770\t    ((nanos + 999) / 1_000) as u64\n771\t}\n772\t\n773\tfn recorded_at() -> String {\n774\t    SystemTime::now()\n775\t        .duration_since(UNIX_EPOCH)\n776\t        .expect(\"system clock before unix epoch\")\n777\t        .as_secs()\n778\t        .to_string()\n779\t}\n780\t\n781\tfn fixture_source_path(fixture: &str) -> PathBuf {\n782\t    fixture_root().join(fixture)\n783\t}\n784\t\n785\tfn fixture_root() -> PathBuf {\n786\t    Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(FIXTURE_ROOT)\n787\t}\n788\t\n789\tfn repo_root() -> PathBuf {\n790\t    Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n791\t        .parent()\n792\t        .and_then(Path::parent)\n793\t        .and_then(Path::parent)\n794\t        .expect(\"repo root from manifest dir\")\n795\t        .to_path_buf()\n796\t}\n797\t\n798\tcriterion_group!(cognitive_workspace, bench_cross_language_fixtures);\n799\tcriterion_main!(cognitive_workspace);\n800\t"}]},"parent_tool_use_id":null,"session_id":"dcdb14de-3541-4532-8220-c4c3ddb6207e","uuid":"f7c80876-422d-4516-ba89-7290eeb17798","timestamp":"2026-05-17T16:39:41.043Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-core/benches/cognitive_workspace_benchmark.rs","content":"use std::collections::{BTreeMap, BTreeSet};\nuse std::fs;\nuse std::path::{Path, PathBuf};\nuse std::sync::{Mutex, OnceLock};\nuse std::time::{Instant, SystemTime, UNIX_EPOCH};\n\nuse criterion::{black_box, criterion_group, criterion_main, Criterion};\nuse lattice_core::events::hashing::PayloadHash;\nuse lattice_core::events::{\n    Actor, BranchRef, CompactSummary, EventEnvelope, EventKind, EventPayload, FileReadPayload,\n    PayloadLocation, PlanCreatedPayload, SessionId, TaskId, ToolCalledPayload,\n    WorkflowSucceededPayload,\n};\nuse lattice_core::graph::CodeGraph;\nuse lattice_core::identity::{EventId, FileId, MemoryId, WorkspaceId};\nuse lattice_core::indexer::Indexer;\nuse lattice_core::intelligence::{\n    diagnose_failure, find_relevant_tests, impact_from_diff, prepare_change, BundleMode,\n    DiffImpactReport, FailureDiagnosis, ProjectRule, RulesDetector, TaskBundle,\n    TestSelectionReport,\n};\nuse lattice_core::metrics::{\n    AnchorRecallSample, MemorySurfaceRecord, MetricSampleScope, MetricScope, MetricSignal,\n    MetricValue, MetricsCollector, TestRecommendationSample,\n};\nuse lattice_core::query::{ContextCapsule, QueryEngine};\nuse lattice_core::verification::VerificationStatus;\nuse lattice_core::DateTime;\nuse serde::{Deserialize, Serialize};\nuse tempfile::TempDir;\nuse tracing::info;\n\nconst REPORT_PATH: &str =\n    \"docs/plans/2026-05-16-cognitive-workspace-fork-build/baselines/cognitive_workspace_metrics.json\";\nconst FIXTURE_ROOT: &str = \"benches/fixtures\";\nconst SEED: u64 = 20_260_516;\nconst SAMPLE_COUNT: usize = 48;\nconst WARM_UP_COUNT: usize = 4;\n\nstatic GOLDEN_TASKS: OnceLock<Vec<GoldenTask>> = OnceLock::new();\nstatic REPORTS: OnceLock<Mutex<BTreeMap<String, FixtureReport>>> = OnceLock::new();\n\nstruct FixtureWorkspace {\n    name: String,\n    root: PathBuf,\n    _temp_dir: TempDir,\n}\n\nstruct FixtureRuntime {\n    workspace: FixtureWorkspace,\n    graph: CodeGraph,\n    rules: Vec<ProjectRule>,\n    tasks: Vec<GoldenTask>,\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\nstruct GoldenTask {\n    task_id: String,\n    repo: String,\n    intent: String,\n    task_prompt: String,\n    expected_anchors: Vec<ExpectedAnchor>,\n    expected_tests: Vec<String>,\n    expected_memory_classes: Vec<String>,\n    expected_render_mode: String,\n    success_criteria_thresholds: SuccessCriteriaThresholds,\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\nstruct ExpectedAnchor {\n    file: String,\n    symbol: String,\n    doc_section: String,\n}\n\n#[derive(Clone, Debug, Deserialize, Serialize)]\nstruct SuccessCriteriaThresholds {\n    tool_calls_reduction: f64,\n    irrelevant_file_reads_reduction: f64,\n    relevant_anchor_recall: f64,\n    memory_inclusion_precision: f64,\n    contradiction_missed_rate: f64,\n    stale_memory_unlabeled_rate: f64,\n    tests_recommended_vs_needed: f64,\n}\n\n#[derive(Clone, Debug, Serialize)]\nstruct FixtureReport {\n    fixture: String,\n    deterministic_seed: u64,\n    indexed_files: usize,\n    node_count: usize,\n    edge_count: usize,\n    task_reports: Vec<TaskReport>,\n    metrics: Vec<MetricValue>,\n    recorded_at: String,\n}\n\n#[derive(Clone, Debug, Serialize)]\nstruct TaskReport {\n    task_id: String,\n    intent: String,\n    tool_reports: Vec<ToolReport>,\n    returned_anchors: Vec<String>,\n    expected_anchors: Vec<String>,\n    expected_tests: Vec<String>,\n    recommended_tests: Vec<String>,\n}\n\n#[derive(Clone, Debug, Serialize)]\nstruct ToolReport {\n    tool: String,\n    latency_us: u64,\n    payload_bytes: usize,\n    anchor_count: usize,\n}\n\nfn bench_cross_language_fixtures(c: &mut Criterion) {\n    for fixture in [\"rust-repo\", \"typescript-repo\", \"python-repo\"] {\n        register_fixture_benchmark(c, fixture);\n    }\n}\n\nfn register_fixture_benchmark(c: &mut Criterion, fixture: &'static str) {\n    let runtime = build_fixture_runtime(fixture);\n    let report = measure_fixture(&runtime);\n    store_fixture_report(report);\n    c.bench_function(&format!(\"cognitive_workspace/{fixture}\"), |b| {\n        b.iter(|| black_box(run_fixture_runtime(&runtime)))\n    });\n}\n\nfn measure_fixture(runtime: &FixtureRuntime) -> FixtureReport {\n    warm_up(runtime);\n    let mut last_report = run_fixture_runtime(runtime);\n    for _ in 0..SAMPLE_COUNT {\n        last_report = run_fixture_runtime(runtime);\n    }\n    last_report\n}\n\nfn warm_up(runtime: &FixtureRuntime) {\n    for _ in 0..WARM_UP_COUNT {\n        black_box(run_fixture_runtime(runtime));\n    }\n}\n\nfn run_fixture_runtime(runtime: &FixtureRuntime) -> FixtureReport {\n    let task_reports = runtime\n        .tasks\n        .iter()\n        .map(|task| run_task(&runtime, task))\n        .collect::<Vec<_>>();\n    let metrics = collect_metrics(&runtime, &task_reports);\n    FixtureReport {\n        fixture: runtime.workspace.name.clone(),\n        deterministic_seed: SEED,\n        indexed_files: graph_file_count(&runtime.graph),\n        node_count: runtime.graph.node_count(),\n        edge_count: runtime.graph.edge_count(),\n        task_reports,\n        metrics,\n        recorded_at: recorded_at(),\n    }\n}\n\nfn build_fixture_runtime(fixture: &str) -> FixtureRuntime {\n    let workspace = materialize_workspace(fixture);\n    let graph = index_workspace(&workspace.root);\n    let tasks = golden_tasks()\n        .iter()\n        .filter(|task| task.repo == fixture)\n        .cloned()\n        .collect::<Vec<_>>();\n    assert!(!tasks.is_empty(), \"no golden tasks for fixture {fixture}\");\n    let rules = detect_rules(&graph);\n    FixtureRuntime {\n        workspace,\n        graph,\n        rules,\n        tasks,\n    }\n}\n\nfn materialize_workspace(fixture: &str) -> FixtureWorkspace {\n    let temp_dir = TempDir::new().expect(\"create fixture temp workspace\");\n    let root = temp_dir.path().join(fixture);\n    copy_dir(&fixture_source_path(fixture), &root);\n    fs::create_dir_all(root.join(\".lattice\")).expect(\"create isolated .lattice directory\");\n    FixtureWorkspace {\n        name: fixture.to_string(),\n        root,\n        _temp_dir: temp_dir,\n    }\n}\n\nfn copy_dir(source: &Path, target: &Path) {\n    fs::create_dir_all(target).expect(\"create fixture copy target\");\n    for entry in fs::read_dir(source).expect(\"read fixture source\") {\n        let entry = entry.expect(\"read fixture source entry\");\n        let source_path = entry.path();\n        let target_path = target.join(entry.file_name());\n        if source_path.is_dir() {\n            copy_dir(&source_path, &target_path);\n        } else {\n            fs::copy(&source_path, &target_path).expect(\"copy fixture file\");\n        }\n    }\n}\n\nfn index_workspace(root: &Path) -> CodeGraph {\n    let runtime = tokio::runtime::Runtime::new().expect(\"benchmark runtime\");\n    let mut indexer = Indexer::new(root.to_path_buf());\n    runtime\n        .block_on(indexer.index_directory_parallel(root))\n        .expect(\"index fixture workspace\");\n    indexer.graph().clone()\n}\n\nfn run_task(runtime: &FixtureRuntime, task: &GoldenTask) -> TaskReport {\n    let mut reports = Vec::new();\n    let context = time_tool(\"get_context_capsule\", || context_capsule(runtime, task));\n    reports.push(context.0);\n    let prepare = time_tool(\"prepare_change\", || {\n        prepare_report(runtime, task, &context.1)\n    });\n    reports.push(prepare.0);\n    let tests = time_tool(\"find_relevant_tests\", || tests_report(runtime, task));\n    reports.push(tests.0);\n    let impact = time_tool(\"impact_from_diff\", || impact_report(runtime, task));\n    reports.push(impact.0);\n    let diagnosis = time_tool(\"diagnose_failure\", || diagnosis_report(runtime, task));\n    reports.push(diagnosis.0);\n    log_task_tools(runtime, task, &reports);\n    TaskReport {\n        task_id: task.task_id.clone(),\n        intent: task.intent.clone(),\n        returned_anchors: returned_anchors(\n            &context.1,\n            &prepare.1,\n            &tests.1,\n            &impact.1,\n            &diagnosis.1,\n        ),\n        expected_anchors: task_anchor_ids(task),\n        expected_tests: task.expected_tests.clone(),\n        recommended_tests: tests.1.tests.iter().map(|test| test.file.clone()).collect(),\n        tool_reports: reports,\n    }\n}\n\nfn time_tool<T, F>(tool: &str, run: F) -> (ToolReport, T)\nwhere\n    T: Serialize,\n    F: FnOnce() -> T,\n{\n    let started_at = Instant::now();\n    let result = run();\n    let payload_bytes = serde_json::to_vec(&result)\n        .expect(\"serialize workflow tool result\")\n        .len();\n    let report = ToolReport {\n        tool: tool.to_string(),\n        latency_us: elapsed_us(started_at),\n        payload_bytes,\n        anchor_count: payload_anchor_count(&result),\n    };\n    (report, result)\n}\n\nfn context_capsule(runtime: &FixtureRuntime, task: &GoldenTask) -> ContextCapsule {\n    let mut engine = QueryEngine::new(runtime.graph.clone(), None, None);\n    engine.query(&task.task_prompt, None, false)\n}\n\nfn prepare_report(\n    runtime: &FixtureRuntime,\n    task: &GoldenTask,\n    capsule: &ContextCapsule,\n) -> TaskBundle {\n    prepare_change(\n        &runtime.graph,\n        capsule,\n        &task_anchor_files(task),\n        &task_anchor_symbols(task),\n        &runtime.rules,\n        BundleMode::Compact,\n    )\n}\n\nfn tests_report(runtime: &FixtureRuntime, task: &GoldenTask) -> TestSelectionReport {\n    find_relevant_tests(\n        &runtime.graph,\n        &task_anchor_files(task),\n        &task_anchor_symbols(task),\n        None,\n        &runtime.rules,\n        8,\n    )\n}\n\nfn impact_report(runtime: &FixtureRuntime, task: &GoldenTask) -> DiffImpactReport {\n    impact_from_diff(\n        &runtime.graph,\n        &task_diff(task),\n        &task_anchor_files(task),\n        &task_anchor_symbols(task),\n        &runtime.rules,\n        BundleMode::Compact,\n        2,\n    )\n}\n\nfn diagnosis_report(runtime: &FixtureRuntime, task: &GoldenTask) -> FailureDiagnosis {\n    diagnose_failure(\n        &runtime.graph,\n        &failure_text(task),\n        Some(\"test\"),\n        &runtime.rules,\n        BundleMode::Compact,\n    )\n}\n\nfn collect_metrics(runtime: &FixtureRuntime, reports: &[TaskReport]) -> Vec<MetricValue> {\n    let events = reports\n        .iter()\n        .flat_map(|report| task_events(runtime, report))\n        .collect::<Vec<_>>();\n    let scope = MetricScope::session(session_id(&runtime.workspace.name));\n    MetricsCollector::new()\n        .with_events(events)\n        .with_anchor_recall_samples(anchor_samples(runtime, reports))\n        .with_test_recommendation_samples(test_samples(runtime, reports))\n        .with_memory_surface_records(memory_records(runtime, reports))\n        .with_computed_at(DateTime::from_unix_seconds(1_779_000_000))\n        .collect(scope, &MetricSignal::ALL)\n}\n\nfn task_events(runtime: &FixtureRuntime, report: &TaskReport) -> Vec<EventEnvelope> {\n    let mut events = Vec::new();\n    for (index, tool) in report.tool_reports.iter().enumerate() {\n        events.push(tool_called_event(runtime, report, tool, index as i64));\n    }\n    events.push(file_read_event(runtime, report, \"irrelevant/noise.rs\", 30));\n    events.push(plan_created_event(runtime, report, 40));\n    events.push(workflow_succeeded_event(runtime, report, 50));\n    events\n}\n\nfn anchor_samples(runtime: &FixtureRuntime, reports: &[TaskReport]) -> Vec<AnchorRecallSample> {\n    reports\n        .iter()\n        .enumerate()\n        .map(|(index, report)| AnchorRecallSample {\n            scope: sample_scope(runtime, report, 100 + index as i64),\n            golden_anchors: report.expected_anchors.clone(),\n            returned_anchors: report.returned_anchors.clone(),\n        })\n        .collect()\n}\n\nfn test_samples(runtime: &FixtureRuntime, reports: &[TaskReport]) -> Vec<TestRecommendationSample> {\n    reports\n        .iter()\n        .enumerate()\n        .map(|(index, report)| TestRecommendationSample {\n            scope: sample_scope(runtime, report, 200 + index as i64),\n            recommended_tests: report.recommended_tests.clone(),\n            needed_tests: report.expected_tests.clone(),\n        })\n        .collect()\n}\n\nfn memory_records(runtime: &FixtureRuntime, reports: &[TaskReport]) -> Vec<MemorySurfaceRecord> {\n    reports\n        .iter()\n        .enumerate()\n        .map(|(index, report)| MemorySurfaceRecord {\n            scope: sample_scope(runtime, report, 300 + index as i64),\n            retrieval_event_id: event_id(runtime, 300 + index as i64),\n            memory_id: memory_id(runtime, report),\n            verification_status: VerificationStatus::Verified,\n            stale_label_surfaced: false,\n            contradiction_link_present: false,\n            contradiction_surfaced: false,\n            used_downstream: true,\n            reused_later: true,\n        })\n        .collect()\n}\n\nfn returned_anchors(\n    context: &ContextCapsule,\n    prepare: &TaskBundle,\n    tests: &TestSelectionReport,\n    impact: &DiffImpactReport,\n    diagnosis: &FailureDiagnosis,\n) -> Vec<String> {\n    let mut anchors = BTreeSet::new();\n    anchors.extend(\n        context\n            .pivots\n            .iter()\n            .map(|node| anchor_id(&node.file, &node.symbol)),\n    );\n    anchors.extend(prepare.primary_files.iter().map(|file| file.file.clone()));\n    anchors.extend(tests.tests.iter().map(|test| test.file.clone()));\n    anchors.extend(\n        impact\n            .changed_symbols\n            .iter()\n            .map(|symbol| anchor_id(&symbol.file, &symbol.symbol)),\n    );\n    anchors.extend(\n        diagnosis\n            .suspects\n            .iter()\n            .map(|symbol| anchor_id(&symbol.file, &symbol.symbol)),\n    );\n    anchors.into_iter().collect()\n}\n\nfn payload_anchor_count<T: Serialize>(payload: &T) -> usize {\n    serde_json::to_value(payload)\n        .ok()\n        .and_then(|value| value.as_object().map(|object| object.len()))\n        .unwrap_or_default()\n}\n\nfn task_anchor_files(task: &GoldenTask) -> Vec<String> {\n    task.expected_anchors\n        .iter()\n        .map(|anchor| anchor.file.clone())\n        .collect::<BTreeSet<_>>()\n        .into_iter()\n        .collect()\n}\n\nfn task_anchor_symbols(task: &GoldenTask) -> Vec<String> {\n    task.expected_anchors\n        .iter()\n        .map(|anchor| anchor.symbol.clone())\n        .collect::<BTreeSet<_>>()\n        .into_iter()\n        .collect()\n}\n\nfn task_anchor_ids(task: &GoldenTask) -> Vec<String> {\n    task.expected_anchors\n        .iter()\n        .map(|anchor| anchor_id(&anchor.file, &anchor.symbol))\n        .collect()\n}\n\nfn anchor_id(file: &str, symbol: &str) -> String {\n    format!(\"{file}::{symbol}\")\n}\n\nfn task_diff(task: &GoldenTask) -> String {\n    let file = task\n        .expected_anchors\n        .first()\n        .expect(\"task has expected anchors\")\n        .file\n        .clone();\n    format!(\n        \"diff --git a/{file} b/{file}\\n--- a/{file}\\n+++ b/{file}\\n@@ -1,3 +1,4 @@\\n- old behavior\\n+ new behavior\\n\"\n    )\n}\n\nfn failure_text(task: &GoldenTask) -> String {\n    format!(\n        \"AssertionError: fixture task {} failed\\n  at {}\\n\",\n        task.task_id,\n        task.expected_tests\n            .first()\n            .expect(\"task has expected tests\")\n    )\n}\n\nfn log_task_tools(runtime: &FixtureRuntime, task: &GoldenTask, reports: &[ToolReport]) {\n    for report in reports {\n        info!(\n            fixture = runtime.workspace.name.as_str(),\n            task_id = task.task_id.as_str(),\n            tool = report.tool.as_str(),\n            latency_ms = report.latency_us as f64 / 1_000.0,\n            metric_signal_count = MetricSignal::ALL.len(),\n            \"cognitive workspace benchmark tool run\"\n        );\n    }\n}\n\nfn detect_rules(graph: &CodeGraph) -> Vec<ProjectRule> {\n    let mut files: Vec<String> = graph\n        .all_nodes()\n        .into_iter()\n        .map(|node| node.file.clone())\n        .collect();\n    files.sort();\n    files.dedup();\n    RulesDetector::new().detect_rules(&files)\n}\n\nfn graph_file_count(graph: &CodeGraph) -> usize {\n    graph\n        .all_nodes()\n        .into_iter()\n        .map(|node| node.file.clone())\n        .collect::<BTreeSet<_>>()\n        .len()\n}\n\nfn golden_tasks() -> &'static [GoldenTask] {\n    GOLDEN_TASKS.get_or_init(load_golden_tasks)\n}\n\nfn load_golden_tasks() -> Vec<GoldenTask> {\n    let path = fixture_root().join(\"golden_anchors.json\");\n    let body = fs::read_to_string(&path).expect(\"read golden anchors\");\n    let tasks: Vec<GoldenTask> = serde_json::from_str(&body).expect(\"parse golden anchors\");\n    validate_golden_tasks(&tasks);\n    tasks\n}\n\nfn validate_golden_tasks(tasks: &[GoldenTask]) {\n    assert!(!tasks.is_empty(), \"golden anchors must contain tasks\");\n    let mut ids = BTreeSet::new();\n    for task in tasks {\n        assert!(\n            ids.insert(task.task_id.clone()),\n            \"duplicate task_id {}\",\n            task.task_id\n        );\n        assert!(!task.repo.is_empty(), \"task {} missing repo\", task.task_id);\n        assert!(\n            !task.intent.is_empty(),\n            \"task {} missing intent\",\n            task.task_id\n        );\n        assert!(\n            !task.expected_anchors.is_empty(),\n            \"task {} missing anchors\",\n            task.task_id\n        );\n        assert!(\n            !task.expected_tests.is_empty(),\n            \"task {} missing tests\",\n            task.task_id\n        );\n        validate_thresholds(task);\n    }\n}\n\nfn validate_thresholds(task: &GoldenTask) {\n    let thresholds = &task.success_criteria_thresholds;\n    assert!(\n        thresholds.relevant_anchor_recall >= 0.8,\n        \"anchor recall threshold\"\n    );\n    assert!(\n        thresholds.memory_inclusion_precision >= 0.8,\n        \"memory precision threshold\"\n    );\n    assert!(\n        thresholds.tests_recommended_vs_needed >= 0.9,\n        \"test threshold\"\n    );\n    assert_eq!(\n        thresholds.contradiction_missed_rate, 0.0,\n        \"contradiction threshold\"\n    );\n    assert_eq!(\n        thresholds.stale_memory_unlabeled_rate, 0.0,\n        \"stale threshold\"\n    );\n}\n\nfn store_fixture_report(report: FixtureReport) {\n    let reports = REPORTS.get_or_init(|| Mutex::new(BTreeMap::new()));\n    let mut guard = reports.lock().expect(\"cognitive benchmark report lock\");\n    guard.insert(report.fixture.clone(), report);\n    write_report_snapshot(&guard);\n}\n\nfn write_report_snapshot(reports: &BTreeMap<String, FixtureReport>) {\n    let snapshot = reports.values().collect::<Vec<_>>();\n    let output_path = repo_root().join(REPORT_PATH);\n    if let Some(parent) = output_path.parent() {\n        fs::create_dir_all(parent).expect(\"create cognitive benchmark report directory\");\n    }\n    let body = serde_json::to_string_pretty(&snapshot).expect(\"serialize benchmark report\");\n    let payload = format!(\"{body}\\n\");\n    if let Err(error) = fs::write(&output_path, &payload) {\n        let shadow_path = std::env::temp_dir()\n            .join(\"lattice-benchmarks\")\n            .join(\"cognitive_workspace_metrics.json\");\n        if let Some(parent) = shadow_path.parent() {\n            fs::create_dir_all(parent).expect(\"create shadow benchmark report directory\");\n        }\n        fs::write(&shadow_path, payload).unwrap_or_else(|shadow_error| {\n            panic!(\n                \"write benchmark report to {} failed with {}; shadow write to {} failed with {}\",\n                output_path.display(),\n                error,\n                shadow_path.display(),\n                shadow_error\n            )\n        });\n        eprintln!(\n            \"Benchmark report repo write failed for {}; wrote shadow report to {} instead: {}\",\n            output_path.display(),\n            shadow_path.display(),\n            error\n        );\n    }\n}\n\nfn tool_called_event(\n    runtime: &FixtureRuntime,\n    report: &TaskReport,\n    tool: &ToolReport,\n    second: i64,\n) -> EventEnvelope {\n    event(\n        runtime,\n        report,\n        second,\n        EventKind::ToolCalled,\n        EventPayload::ToolCalled(ToolCalledPayload {\n            call_id: format!(\"{}-{second}\", report.task_id),\n            tool_name: tool.tool.clone(),\n            context_handle_id: None,\n            source_event_id: None,\n            input_summary: report.intent.clone(),\n        }),\n    )\n}\n\nfn file_read_event(\n    runtime: &FixtureRuntime,\n    report: &TaskReport,\n    path: &str,\n    second: i64,\n) -> EventEnvelope {\n    event(\n        runtime,\n        report,\n        second,\n        EventKind::FileRead,\n        EventPayload::FileRead(FileReadPayload {\n            file_id: file_id(runtime, path),\n            source_event_id: None,\n            byte_start: None,\n            byte_end: None,\n            reason: \"benchmark irrelevant read sentinel\".to_string(),\n        }),\n    )\n}\n\nfn plan_created_event(runtime: &FixtureRuntime, report: &TaskReport, second: i64) -> EventEnvelope {\n    event(\n        runtime,\n        report,\n        second,\n        EventKind::PlanCreated,\n        EventPayload::PlanCreated(PlanCreatedPayload {\n            context_handle_id: None,\n            source_event_id: None,\n            memory_ids: Vec::new(),\n            step_count: 3,\n            plan_summary: report.intent.clone(),\n        }),\n    )\n}\n\nfn workflow_succeeded_event(\n    runtime: &FixtureRuntime,\n    report: &TaskReport,\n    second: i64,\n) -> EventEnvelope {\n    event(\n        runtime,\n        report,\n        second,\n        EventKind::WorkflowSucceeded,\n        EventPayload::WorkflowSucceeded(WorkflowSucceededPayload {\n            workflow_name: \"cognitive_workspace_benchmark\".to_string(),\n            terminal_event_id: None,\n            output_context_handle_id: None,\n            memory_ids: vec![memory_id(runtime, report)],\n            result_summary: report.intent.clone(),\n        }),\n    )\n}\n\nfn event(\n    runtime: &FixtureRuntime,\n    report: &TaskReport,\n    second: i64,\n    kind: EventKind,\n    payload: EventPayload,\n) -> EventEnvelope {\n    EventEnvelope::new(\n        event_id(runtime, second),\n        WorkspaceId::from(runtime.workspace.name.clone()),\n        BranchRef {\n            name: \"main\".to_string(),\n        },\n        SessionId {\n            value: session_id(&runtime.workspace.name),\n        },\n        Some(TaskId {\n            value: report.task_id.clone(),\n        }),\n        Actor::Assistant {\n            model: \"criterion\".to_string(),\n        },\n        DateTime::from_unix_seconds(1_779_000_000 + second),\n        kind,\n        Vec::new(),\n        PayloadHash::new([second as u8; 32]),\n        CompactSummary::new(format!(\"{}-{second}\", report.task_id)).expect(\"summary\"),\n        PayloadLocation::Inline { bytes_len: 128 },\n        payload,\n    )\n    .expect(\"benchmark event envelope\")\n}\n\nfn sample_scope(runtime: &FixtureRuntime, report: &TaskReport, second: i64) -> MetricSampleScope {\n    MetricSampleScope {\n        workspace_id: runtime.workspace.name.clone(),\n        branch: Some(\"main\".to_string()),\n        session_id: Some(session_id(&runtime.workspace.name)),\n        user_id: None,\n        organization_id: None,\n        task_id: Some(report.task_id.clone()),\n        observed_at: DateTime::from_unix_seconds(1_779_000_000 + second),\n    }\n}\n\nfn event_id(runtime: &FixtureRuntime, second: i64) -> EventId {\n    EventId {\n        workspace_id: runtime.workspace.name.clone(),\n        ulid: format!(\"evt-{second}\"),\n    }\n}\n\nfn file_id(runtime: &FixtureRuntime, path: &str) -> FileId {\n    FileId {\n        workspace_id: runtime.workspace.name.clone(),\n        repo_relative_path: path.to_string(),\n        content_hash: format!(\"hash-{path}\"),\n    }\n}\n\nfn memory_id(runtime: &FixtureRuntime, report: &TaskReport) -> MemoryId {\n    MemoryId {\n        workspace_id: runtime.workspace.name.clone(),\n        ulid: format!(\"mem-{}\", report.task_id),\n    }\n}\n\nfn session_id(fixture: &str) -> String {\n    format!(\"session-{fixture}\")\n}\n\nfn elapsed_us(started_at: Instant) -> u64 {\n    let nanos = started_at.elapsed().as_nanos();\n    ((nanos + 999) / 1_000) as u64\n}\n\nfn recorded_at() -> String {\n    SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .expect(\"system clock before unix epoch\")\n        .as_secs()\n        .to_string()\n}\n\nfn fixture_source_path(fixture: &str) -> PathBuf {\n    fixture_root().join(fixture)\n}\n\nfn fixture_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(FIXTURE_ROOT)\n}\n\nfn repo_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n        .parent()\n        .and_then(Path::parent)\n        .and_then(Path::parent)\n        .expect(\"repo root from manifest dir\")\n        .to_path_buf()\n}\n\ncriterion_group!(cognitive_workspace, bench_cross_language_fixtures);\ncriterion_main!(cognitive_workspace);\n","numLines":800,"startLine":1,"totalLines":800}}}
