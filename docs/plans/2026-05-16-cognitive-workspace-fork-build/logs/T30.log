@@ -1,6 +1,8 @@
 pub mod anchors;
 pub mod candidates;
+pub mod diagnostic;
 pub mod intent;
+pub mod scoring;
 
 #[cfg(test)]
 mod anchors_tests;
@@ -8,6 +10,8 @@
 mod candidates_tests;
 #[cfg(test)]
 mod intent_tests;
+#[cfg(test)]
