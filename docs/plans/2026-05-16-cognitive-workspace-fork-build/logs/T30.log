     for ch in bare.chars() {
         if ch.is_ascii_alphabetic() {
             saw_alpha = true;
-            saw_upper |= ch.is_ascii_uppercase();
             saw_lower |= ch.is_ascii_lowercase();
         } else if !ch.is_ascii_digit() {
             return false;
         }
     }
-    saw_alpha && (saw_upper && saw_lower || saw_lower)
+    saw_alpha && saw_lower
 }
 
 fn stack_frame_from_token(token: &str) -> Option<StackFrameAnchor> {
diff --git a/daemon/crates/lattice-core/src/retrieval_v1/diagnostic.rs b/daemon/crates/lattice-core/src/retrieval_v1/diagnostic.rs
