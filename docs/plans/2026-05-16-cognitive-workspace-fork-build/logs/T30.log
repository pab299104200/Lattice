fn looks_like_symbol(text: &str) -> bool {
    if text.is_empty() || HTTP_METHODS.contains(&text) {
        return false;
    }
    let bare = text.trim_matches(':');
    if bare.contains("::") {
        return true;
    }
    if bare.ends_with("()") {
        return true;
    }
    if bare.contains('_') {
        return bare
            .chars()
            .all(|ch| ch.is_ascii_alphanumeric() || ch == '_');
    }
    let mut saw_alpha = false;
    let mut saw_upper = false;
    let mut saw_lower = false;
    for ch in bare.chars() {
        if ch.is_ascii_alphabetic() {
            saw_alpha = true;
            saw_upper |= ch.is_ascii_uppercase();
            saw_lower |= ch.is_ascii_lowercase();
        } else if !ch.is_ascii_digit() {
            return false;
        }
    }
    saw_alpha && (saw_upper && saw_lower || saw_lower)
}

