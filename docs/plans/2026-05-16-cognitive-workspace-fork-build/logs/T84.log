+fn mark_skipped(
+    conn: &Connection,
+    source_row_id: i64,
+    reason: &str,
+) -> Result<(), MigrationError> {
     conn.execute(
         "INSERT OR REPLACE INTO migration_progress
             (source_row_id, dest_memory_id, status, migrated_at, schema_version)
          VALUES (?1, NULL, 'skipped', unixepoch(), ?2)",
