+
+trait SeedExt {
+    fn rich(self) -> Self;
+    fn stale(self) -> Self;
+}
+
+impl SeedExt for LegacySeed {
+    fn rich(mut self) -> Self {
+        self.linked_symbols = r#"["important_symbol"]"#;
+        self.linked_files = r#"["src/lib.rs"]"#;
+        self.evidence_json = r#"[{"kind":"note","reference":"test","captured_at":12}]"#;
