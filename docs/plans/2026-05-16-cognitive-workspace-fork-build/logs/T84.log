+        params![source_row_id, reason, MIGRATION_SCHEMA_VERSION],
+    )
+    .map_err(|error| MigrationError::DestinationUnready(error.to_string()))?;
+    tracing::warn!(
+        source_row_id,
+        reason,
+        "legacy memory row quarantined during migration"
+    );
+    Ok(())
 }
 
