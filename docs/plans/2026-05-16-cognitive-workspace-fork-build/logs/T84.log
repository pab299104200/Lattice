+fn event_count(fixture: &SchemaFixture) -> usize {
+    EventReader::new(fixture.event_store.clone())
+        .execute(
+            EventQuery::new()
+                .session(&fixture.session_id)
+                .order(QueryOrder::OldestFirst)
+                .limit(1_000),
+        )
+        .expect("events query")
+        .len()
+}
