+++ b/daemon/crates/lattice-core/src/hardening/mod.rs
@@ -5,6 +5,8 @@
 #[cfg(test)]
 mod large_repo_tests;
 #[cfg(test)]
+mod migration_tests;
+#[cfg(test)]
 mod partial_index_tests;
