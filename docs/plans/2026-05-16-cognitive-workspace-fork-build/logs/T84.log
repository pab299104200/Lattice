+#[tokio::test]
+async fn compat_matrix_extends_mcp_schema_contract_without_changing_tool_list() {
+    let fixture = SchemaFixture::new("compat-schema-parity");
+    let listed = fixture
+        .handler
+        .handle("tools/list", json!({}))
+        .await
+        .expect("tools/list succeeds");
