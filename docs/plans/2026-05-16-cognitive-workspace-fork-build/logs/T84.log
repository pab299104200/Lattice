+        "get_working_set_context",
+        "summarize_subsystem",
+        "get_repo_playbook",
+        "diagnose_failure",
+        "search_memory",
+        "get_session_metrics",
+        "list_stale_memories",
+        "refresh_memory",
+    ];
+    let memory_id = save_memory(&fixture, "refresh target").await;
+    for tool in tools {
+        let response = fixture
+            .handler
+            .handle("tools/call", call_args(tool, additive_args(tool, &memory_id)))
+            .await
+            .unwrap_or_else(|error| panic!("{tool} minimal legacy request failed: {error:?}"));
+        let payload = parse_tool_payload(&response);
+        assert_legacy_superset(tool, &payload);
