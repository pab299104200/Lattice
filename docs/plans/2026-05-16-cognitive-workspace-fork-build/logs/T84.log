+         CREATE TABLE IF NOT EXISTS migration_quarantine (
+            source_row_id INTEGER PRIMARY KEY,
+            reason TEXT NOT NULL,
+            quarantined_at INTEGER NOT NULL,
+            schema_version INTEGER NOT NULL
