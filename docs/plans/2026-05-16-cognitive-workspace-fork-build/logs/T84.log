+            actor: Actor::Daemon,
+            kind: payload.kind(),
+            references: Vec::new(),
+            summary: CompactSummary::new("compat seed event").expect("summary"),
+            payload,
+        })
+        .expect("seed event");
+}
+
+fn event_count(fixture: &SchemaFixture) -> usize {
+    EventReader::new(fixture.event_store.clone())
