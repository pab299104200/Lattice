diff --git a/daemon/crates/lattice-core/src/hardening/migration_tests.rs b/daemon/crates/lattice-core/src/hardening/migration_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e683083457c3b4de06c820ffe3fb2d98810c9a34
