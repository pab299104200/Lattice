+        "get_memory_metrics" => json!({"scope": "session", "render_mode": mode}),
+        "get_event_trace" => json!({"session_id": "compat-session", "render_mode": mode}),
+        "verify_explain_memory" => json!({"memory_id": memory_id, "render_mode": mode}),
