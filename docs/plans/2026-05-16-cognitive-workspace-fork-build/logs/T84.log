+    let listed = fixture
+        .handler
+        .handle("tools/list", json!({}))
+        .await
+        .expect("tools/list succeeds");
+    let names: Vec<&str> = listed["tools"]
+        .as_array()
+        .expect("tool list")
+        .iter()
+        .map(|tool| tool["name"].as_str().expect("tool name"))
+        .collect();
+    assert_eq!(names, ADVERTISED_TOOLS);
