+        for mode in ["compact", "full"] {
+            let payload = call_payload(&fixture, tool, memory_v2_args(tool, mode, &memory_id)).await;
+            assert_eq!(payload["render_mode"].as_str(), Some(mode), "{tool}");
+        }
+    }
+}
