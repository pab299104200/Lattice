+}
+
+fn workflow_args(tool: &str, mode: &str) -> Value {
+    let mut value = additive_args(tool, "unused");
+    if let Some(object) = value.as_object_mut() {
+        object.insert("mode".to_string(), json!(mode));
+        object.insert("render".to_string(), json!("json"));
