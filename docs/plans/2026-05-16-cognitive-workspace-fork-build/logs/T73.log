+        const selection = await vscode.window.showQuickPick(picks, {
+            title: this.i18n.t('eventTraceView.filters.actorTitle'),
+            placeHolder: this.i18n.t('eventTraceView.filters.actorPlaceholder'),
+            canPickMany: true,
+            ignoreFocusOut: true,
