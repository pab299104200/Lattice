 import { DaemonManager } from '../daemon';
-import { createReviewI18n, ReviewI18n } from './i18n';
+import { createReviewI18n, loadReviewCatalog, ReviewI18n } from './i18n';
+import { openProposalDialog } from './components/ProposalDialog';
