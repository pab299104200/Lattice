type ReviewRouteId =
    | 'memoryInbox'
    | 'promotionQueue'
    | 'contradictionQueue'
    | 'staleView'
    | 'evidenceInspector'
    | 'eventTrace'
    | 'retrievalExplanation'
    | 'usefulnessMetrics'
    | 'workspaceGraphHealth'
    | 'indexingHealth'
    | 'consolidationQueue';

interface ReviewRouteDefinition {
    id: ReviewRouteId;
    label: string;
    description: string;
}

interface WebviewMessage {
    command?: string;
    route?: ReviewRouteId;
    filterKey?: 'status' | 'scope' | 'memoryClass';
    sortKey?: 'status' | 'memoryClass' | 'scope' | 'lastVerifiedAt' | 'confidence';
