        private readonly context: vscode.ExtensionContext,
        private readonly daemon: DaemonManager
    ) {
        this.i18n = createReviewI18n();
    }

    public dispose(): void {
        this.memoryInbox?.dispose();
        this.memoryInbox = undefined;
        this.bridge?.dispose();
