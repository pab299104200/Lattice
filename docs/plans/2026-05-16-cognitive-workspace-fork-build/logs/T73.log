+): string | undefined {
+    if (since && Number.isNaN(Date.parse(since))) {
+        return i18n.t('eventTraceView.invalidSince');
+    }
+    if (until && Number.isNaN(Date.parse(until))) {
+        return i18n.t('eventTraceView.invalidUntil');
