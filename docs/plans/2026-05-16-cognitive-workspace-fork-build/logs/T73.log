diff --git a/extension/src/review/components/ProposalDialog.ts b/extension/src/review/components/ProposalDialog.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8e8518f205a343c4f00945ac31be916a3d1b25ad
--- /dev/null
