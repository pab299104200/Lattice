+++ b/extension/src/review/i18n/en.json
@@ -66,6 +66,91 @@
     "accept": "Accept",
     "reject": "Reject"
   },
+  "promotionQueue": {
+    "description": "Review promotion proposals before any durable memory write is applied.",
