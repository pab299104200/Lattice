+    | 'pending'
+    | 'applied'
+    | 'rejected'
+    | 'reverted';
 
-function badgeTone(status: string): string {
-    switch (status) {
-        case 'verified':
-        case 'applied':
-            return 'success';
-        case 'stale':
-        case 'expired':
-        case 'pending':
-        case 'in_review':
-            return 'warning';
-        case 'contradicted':
-        case 'invalidated':
-        case 'rejected':
-            return 'error';
-        case 'superseded':
-            return 'info';
-        default:
-            return 'neutral';
-    }
+interface ReviewI18nLike {
+    t: (key: string, params?: Record<string, string | number>) => string;
 }
 
-function humanize(value: string): string {
-    return value
-        .split('_')
-        .filter(Boolean)
-        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
-        .join(' ');
+interface StatusPresentation {
+    className: string;
+    labelKey: string;
 }
 
-function escapeHtml(value: string): string {
-    return value
-        .replaceAll('&', '&amp;')
-        .replaceAll('<', '&lt;')
