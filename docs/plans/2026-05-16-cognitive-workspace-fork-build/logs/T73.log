function routeIds(): ReviewRouteId[] {
    return [
        'memoryInbox',
        'promotionQueue',
        'contradictionQueue',
        'staleView',
        'evidenceInspector',
        'eventTrace',
        'retrievalExplanation',
        'usefulnessMetrics',
        'workspaceGraphHealth',
        'indexingHealth',
        'consolidationQueue',
    ];
}

function escapeHtml(value: string): string {
    return value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
