+        linkType: stringParam(params, 'linkType'),
+        detectedBy: optionalStringParam(params, 'detectedBy'),
+        reason: optionalStringParam(params, 'reason'),
+    };
+    if (requireReason && !args.reason) {
+        args.reason = '';
+    }
+    return args;
+}
