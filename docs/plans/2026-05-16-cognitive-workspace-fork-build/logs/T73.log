-        : humanize(status);
-    return `<span class="status-badge status-badge--${escapeHtml(tone)}">${escapeHtml(label)}</span>`;
-}
+export type VerificationStatus =
+    | 'verified'
+    | 'unverified'
+    | 'in_review'
+    | 'stale'
+    | 'contradicted'
