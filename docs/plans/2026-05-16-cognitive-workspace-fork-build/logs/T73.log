+                    this.eventTraceState.sortDirection = this.eventTraceState.sortBy === message.sortBy
+                        && this.eventTraceState.sortDirection === 'asc'
+                        ? 'desc'
+                        : 'asc';
+                    this.eventTraceState.sortBy = message.sortBy;
