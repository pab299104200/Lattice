+    private async pickEventTraceScope(kind: 'session' | 'task' | 'workspace'): Promise<void> {
+        const values = uniqueEventTraceValues((this.eventTraceState.lastPage?.events ?? []).map((event) => {
+            if (kind === 'session') {
