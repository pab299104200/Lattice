+                if (message.eventId) {
+                    this.retrievalExplanationState.requestId = extractRetrievalRequestId(
+                        this.findTraceEvent(message.eventId)
+                    );
+                    this.activeRoute = 'retrievalExplanation';
+                    await this.refreshState();
+                }
+                return;
+            default:
+                return;
+        }
+    }
