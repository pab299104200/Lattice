+            || `Marked ${args.targetMemoryId} as superseded by ${args.sourceMemoryId}${detector ? ` (${detector})` : ''}.`;
+    }
+    return base
+        || `Invalidated ${args.targetMemoryId} because it contradicts ${args.sourceMemoryId}${detector ? ` (${detector})` : ''}.`;
+}
