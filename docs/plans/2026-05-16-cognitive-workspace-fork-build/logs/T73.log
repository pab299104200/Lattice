diff --git a/extension/src/review/i18n/index.ts b/extension/src/review/i18n/index.ts
index a75b8f5cec6f99caaac3938f4f024e2ca8d3b03c..c675e96a706ce32451666c7671c78c184ef61a42
--- a/extension/src/review/i18n/index.ts
