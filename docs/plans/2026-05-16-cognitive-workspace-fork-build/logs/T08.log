+                symbol: "hashPassword".to_string(),
+                kind: "function".to_string(),
+                file: "src/auth.ts".to_string(),
+                line: 10,
+                skeleton: "function hashPassword(password)".to_string(),
+                relationship: "callee".to_string(),
+                score: 0.6,
+            }],
+            memories: Vec::new(),
+            stats: CapsuleStats {
+                tokens_used: 40,
