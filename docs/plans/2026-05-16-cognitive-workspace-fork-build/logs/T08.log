    field: &'static str,
) -> Result<u8, IdentityDecodeError> {
    if index + 2 >= bytes.len() {
        return malformed(field, "incomplete percent escape");
    }
    let high = hex_value(bytes[index + 1], field)?;
    let low = hex_value(bytes[index + 2], field)?;
    Ok((high << 4) | low)
}

