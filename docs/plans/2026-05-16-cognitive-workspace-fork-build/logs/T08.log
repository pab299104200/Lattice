+                "loginUser".to_string(),
+                "function loginUser()".to_string(),
+                "function loginUser() {}".to_string(),
+                "src/alt_auth.ts".to_string(),
+                4,
+                8,
+                true,
+                Language::TypeScript,
+            );
+            parsed_files.insert(
+                "src/alt_auth.ts".to_string(),
+                ParsedFile {
+                    file: "src/alt_auth.ts".to_string(),
+                    language: Language::TypeScript,
+                    symbols: vec![Symbol {
+                        id: duplicate_symbol,
+                        kind: SymbolKind::Function,
+                        name: "loginUser".to_string(),
