+const CROCKFORD_BASE32: &[u8; 32] = b"0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+
+fn next_ulid(sequence: &mut u64) -> String {
+    *sequence = sequence.wrapping_add(1);
