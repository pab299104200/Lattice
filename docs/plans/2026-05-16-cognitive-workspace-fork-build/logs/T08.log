+    use lattice_core::symbols::{Language, ParsedFile, Symbol, SymbolId as LegacySymbolId, SymbolKind};
+    use serde_json::json;
+
+    use super::decorate_get_context_capsule_payload;
+    use lattice_core::identity::ContextHandleId;
+
+    #[test]
