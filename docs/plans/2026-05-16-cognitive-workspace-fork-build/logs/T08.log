+                ulid: "01ARZ3NDEKTSV4RRFFQ69G5FAV".to_string(),
+            },
+        );
+
+        assert_eq!(value["pivots"][0]["symbol"].as_str(), Some("loginUser"));
+        assert_eq!(value["pivots"][0]["file"].as_str(), Some("src/auth.ts"));
+        assert_eq!(
