+                        line: 4,
+                        end_line: 8,
+                        is_exported: true,
+                        language: Language::TypeScript,
+                        references: Vec::new(),
+                        imports: Vec::new(),
+                    }],
+                    imports: Vec::new(),
+                    links: Vec::new(),
+                },
+            );
+        }
+
+        (graph, parsed_files)
+    }
+}
