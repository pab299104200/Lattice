+    }
+
+    #[test]
+    fn ambiguous_resolver_outcome_surfaces_diagnostic() {
+        let (graph, parsed_files) = fixture(true);
+        let mut value = json!({
+            "query": "login auth",
+            "intent": "Explore",
+            "pivots": [],
