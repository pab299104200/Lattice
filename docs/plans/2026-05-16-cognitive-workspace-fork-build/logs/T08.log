+                        references: Vec::new(),
+                        imports: Vec::new(),
+                    },
+                ],
+                imports: Vec::new(),
+                links: Vec::new(),
+            },
+        )]);
+
+        if include_duplicate_symbol {
+            let duplicate_symbol = LegacySymbolId {
+                file: "src/alt_auth.ts".to_string(),
+                name: "loginUser".to_string(),
+                byte_offset: 18,
+            };
+            graph.add_node(
+                duplicate_symbol.clone(),
+                SymbolKind::Function,
+                "loginUser".to_string(),
+                "function loginUser()".to_string(),
+                "function loginUser() {}".to_string(),
+                "src/alt_auth.ts".to_string(),
+                4,
+                8,
+                true,
+                Language::TypeScript,
+            );
+            parsed_files.insert(
+                "src/alt_auth.ts".to_string(),
+                ParsedFile {
+                    file: "src/alt_auth.ts".to_string(),
+                    language: Language::TypeScript,
+                    symbols: vec![Symbol {
+                        id: duplicate_symbol,
+                        kind: SymbolKind::Function,
+                        name: "loginUser".to_string(),
+                        signature: "function loginUser()".to_string(),
+                        body: "function loginUser() {}".to_string(),
+                        file: "src/alt_auth.ts".to_string(),
+                        line: 4,
+                        end_line: 8,
+                        is_exported: true,
+                        language: Language::TypeScript,
+                        references: Vec::new(),
+                        imports: Vec::new(),
+                    }],
+                    imports: Vec::new(),
+                    links: Vec::new(),
+                },
+            );
+        }
+
+        (graph, parsed_files)
+    }
+}
