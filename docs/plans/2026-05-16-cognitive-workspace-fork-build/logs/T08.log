+    use lattice_core::query::{CapsuleStats, ContextCapsule, ContextNode, PivotNode, QueryIntent};
+    use lattice_core::symbols::{Language, ParsedFile, Symbol, SymbolId as LegacySymbolId, SymbolKind};
+    use serde_json::json;
+
