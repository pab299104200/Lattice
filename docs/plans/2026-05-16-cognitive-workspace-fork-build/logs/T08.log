+                session_id: "session-main".to_string(),
+                ulid: "01ARZ3NDEKTSV4RRFFQ69G5FAV".to_string(),
+            },
+        );
+
+        assert_eq!(
+            value["stats"]["seed_symbol_identities"][0]["status"].as_str(),
+            Some("ambiguous")
+        );
+        assert_eq!(
