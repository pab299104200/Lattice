+                file: "src/auth.ts".to_string(),
+                name: "hashPassword".to_string(),
+                byte_offset: 44,
+            },
+            SymbolKind::Function,
+            "hashPassword".to_string(),
+            "function hashPassword()".to_string(),
+            "function hashPassword() {}".to_string(),
+            "src/auth.ts".to_string(),
+            10,
+            14,
+            true,
+            Language::TypeScript,
+        );
+        let mut parsed_files = HashMap::from([(
+            "src/auth.ts".to_string(),
+            ParsedFile {
+                file: "src/auth.ts".to_string(),
+                language: Language::TypeScript,
+                symbols: vec![
+                    Symbol {
