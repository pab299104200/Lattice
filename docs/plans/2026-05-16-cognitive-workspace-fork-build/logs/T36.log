+    ) {
+        self.working_memory_states
+            .lock()
+            .await
+            .insert(task_id.to_string(), state);
+    }
+
+    #[cfg(test)]
+    pub(crate) async fn resolve_working_memory_snapshot_for_test(
+        &self,
+        handle: &str,
+    ) -> Option<WorkingMemoryState> {
+        self.working_memory_snapshots.lock().await.get(handle).cloned()
+    }
