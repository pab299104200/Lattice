+        snippet: format!("Snippet for {ulid}"),
+        inclusion_reason: reason.to_string(),
+        expansion_handle: lattice_core::identity::encode_identity(&Identity::Memory(MemoryId {
+            workspace_id: WORKSPACE_ID.to_string(),
+            ulid: ulid.to_string(),
+        })),
