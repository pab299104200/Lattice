+#[derive(Clone)]
+struct FakeRetriever {
+    retrieve_execution: RetrievalExecution,
+    expand_execution: RetrievalExecution,
+}
+
+impl FakeRetriever {
+    fn with_event_results() -> Self {
+        Self {
+            retrieve_execution: RetrievalExecution {
+                bundle: sample_bundle(vec![sample_bundle_result(
+                    "memory-retrieved",
