+                "inspect_working_memory",
+                ExpandContextSeed {
+                    query: Some(format!("inspect working memory {task_id}")),
+                    files: Vec::new(),
+                    symbols: Vec::new(),
+                    tests: Vec::new(),
+                    memories: Vec::new(),
+                },
+            )
+            .await;
+        self.working_memory_snapshots
+            .lock()
+            .await
+            .insert(handle.legacy_handle.clone(), state.clone());
+        handle.legacy_handle
+    }
+
