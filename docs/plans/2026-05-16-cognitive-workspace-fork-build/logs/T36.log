+    pub(crate) async fn remember_working_memory_state_for_test(
+        &self,
+        task_id: &str,
+        state: WorkingMemoryState,
+    ) {
+        self.working_memory_states
+            .lock()
+            .await
+            .insert(task_id.to_string(), state);
+    }
+
+    #[cfg(test)]
