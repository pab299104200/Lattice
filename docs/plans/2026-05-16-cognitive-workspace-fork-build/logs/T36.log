+    assert_eq!(excluded.len(), state.excluded_memories.len());
+    assert_eq!(
+        excluded[0]["exclusion_reason"].as_str(),
+        Some("compressed: budget=120 tokens")
+    );
+
+    cleanup_paths(&workspace_root, &context_cache_path);
+}
