+                "session-test-checkpoint".to_string(),
+                TASK_ID.to_string(),
+            ),
+        )
+        .expect("checkpoint saved");
+
+    let response = handler
+        .handle("tools/call", json!({
+            "name": "inspect_working_memory",
+            "arguments": {
+                "task_id": TASK_ID,
+                "mode": "diagnostic",
+                "include_excluded": true
+            }
+        }))
+        .await
