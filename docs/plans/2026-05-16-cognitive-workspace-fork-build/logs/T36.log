+}
+
+impl WorkingMemoryRetriever for FakeRetriever {
+    fn retrieve(
+        &self,
+        _state: &WorkingMemoryState,
+        _args: &RetrieveArgs,
+        _ctx: &OpContext<'_>,
+    ) -> Result<RetrievalExecution, lattice_core::error::LatticeError> {
