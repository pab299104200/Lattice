diff --git a/daemon/crates/lattice-core/src/consolidation/mod.rs b/daemon/crates/lattice-core/src/consolidation/mod.rs
index 3eda852f5e99d4f9aff19e81cc0eba9065171b9f..1d9a3293e08da5eb90221011e39dc823c658830d
--- a/daemon/crates/lattice-core/src/consolidation/mod.rs
+++ b/daemon/crates/lattice-core/src/consolidation/mod.rs
@@ -264,6 +264,37 @@
     config: ConsolidationConfig,
 }
 
+pub fn persist_pending_proposal(
+    conn: &Connection,
+    workspace_id: &str,
+    kind: &str,
+    mode: ConsolidationJobMode,
+    proposal: &ConsolidationProposal,
+) -> Result<ConsolidationProposalRecord, LatticeError> {
+    initialize_schema(conn)?;
+    conn.execute(
+        "INSERT INTO consolidation_jobs
+            (job_id, workspace_id, kind, mode, status, enqueued_at, proposal_id)
+         VALUES (?1, ?2, ?3, ?4, 'proposed', ?5, ?6)",
+        params![
+            proposal.job_id,
+            workspace_id,
+            kind,
+            mode.as_str(),
+            now_unix_micros(),
+            proposal.proposal_id,
+        ],
+    )
+    .map_err(|e| LatticeError::Storage(format!("Failed to persist consolidation job: {e}")))?;
+    proposal.insert_pending(conn)?;
