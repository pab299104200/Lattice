+                    proposal_kind: record.proposal_kind.as_str().to_string(),
+                    decision: record.decision.as_str().to_string(),
+                    prior_state: record.prior_state,
+                    proposed_state: record.proposed_state,
+                    deprecation_warning: None,
+                }
