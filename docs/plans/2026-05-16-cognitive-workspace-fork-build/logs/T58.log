+    async fn tool_get_task_memory(&self, args: &Value) -> Result<Value, (i32, String)> {
+        let parsed =
+            memory_v2::get_task_memory::parse_args(args).map_err(|message| (-32602, message))?;
+        let Some((state, checkpoint_id)) = self.load_working_memory_state(&parsed.task_id).await?
+        else {
+            return Err((
+                -32602,
+                format!("Working memory for task `{}` was not found", parsed.task_id),
+            ));
+        };
+        let scope = self.current_memory_scope_filter();
+        let preferred_branch = scope.branch.as_ref().map(|branch| branch.name.as_str());
+        let query = parsed
+            .intent_hint
+            .clone()
+            .unwrap_or_else(|| state.task_statement.clone());
+        tracing::info!(
+            tool = "get_task_memory",
+            task_id = parsed.task_id.as_str(),
+            session_id = self.session_id.as_str(),
+            scope = ?scope,
+            "retrieving task memory"
+        );
+
+        let store = self.memory_store.lock().await;
+        let mut candidates = store
+            .query(Some(query.as_str()), 24, &scope)
+            .map_err(|error| (-32603, format!("Failed to query scoped memories: {error}")))?;
+        if candidates.is_empty() {
+            candidates = store
+                .list_all_scoped(&scope)
+                .map_err(|error| (-32603, format!("Failed to list scoped memories: {error}")))?
+                .into_iter()
+                .take(memory_v2::get_task_memory::token_budget_limit(parsed.budget_tokens))
+                .collect();
+        }
+        let ranked = memory_v2::get_task_memory::rank_memories(
+            &store,
+            &self.workspace_root.to_string_lossy(),
+            &state,
+            candidates,
+            parsed.intent_hint.as_deref(),
+            preferred_branch,
+        )
+        .map_err(|message| (-32603, message))?;
+        let clipped = memory_v2::get_task_memory::clip_to_budget(&ranked, parsed.budget_tokens);
+        if let Some(capture) = self.event_capture.as_ref() {
+            let ids: Vec<_> = clipped
+                .iter()
+                .map(|item| lattice_core::identity::MemoryId {
+                    workspace_id: self.workspace_root.to_string_lossy().to_string(),
+                    ulid: item.0.id.clone(),
+                })
+                .collect();
+            let reasons: Vec<_> = clipped.iter().map(|item| item.1.clone()).collect();
+            let _ = capture.record_memory_retrieved(&ids, &reasons);
+        }
+        let bundle = memory_v2::get_task_memory::build_bundle(
+            &store,
+            &self.workspace_root.to_string_lossy(),
+            parsed.task_id,
+            checkpoint_id,
+            &state,
+            clipped,
+        )
+        .map_err(|message| (-32603, message))?;
+        tracing::info!(
+            tool = "get_task_memory",
+            session_id = self.session_id.as_str(),
+            scope = ?scope,
+            memory_count = bundle.memories.len(),
+            "task memory bundle built"
+        );
+        serde_json::to_value(&bundle)
+            .map(wrap_tool_result)
+            .map_err(|error| (-32603, format!("Serialization error: {error}")))
+    }
+
+    async fn tool_save_memory_v2(&self, args: &Value) -> Result<Value, (i32, String)> {
+        let parsed =
+            memory_v2::save_memory::parse_args(args).map_err(|message| (-32602, message))?;
+        memory_v2::save_memory::validate_args(&parsed).map_err(|message| (-32602, message))?;
+        let workspace_id = self.workspace_root.to_string_lossy().to_string();
+        tracing::info!(
+            tool = "save_memory",
+            session_id = self.session_id.as_str(),
+            scope = ?parsed.scope,
+            "saving durable memory"
+        );
+
+        let (memory, structured) =
+            memory_v2::save_memory::build_memory(&self.session_id, &workspace_id, &parsed);
+        let mut store = self.memory_store.lock().await;
+        let memory_id = store
+            .store(memory)
+            .map_err(|error| (-32603, format!("Failed to store memory: {error}")))?;
+        store
+            .update_structured_fields(&memory_id, &structured)
+            .map_err(|error| {
+                (
+                    -32603,
+                    format!("Failed to persist structured memory fields: {error}"),
+                )
+            })?;
+        let verification_job_id = store
+            .enqueue_verification_job(&workspace_id, &memory_id)
+            .map_err(|error| (-32603, format!("Failed to enqueue verification job: {error}")))?;
+        if let Some(capture) = self.event_capture.as_ref() {
+            let _ = capture.record_memory_created(
+                lattice_core::identity::MemoryId {
+                    workspace_id: workspace_id.clone(),
+                    ulid: memory_id.clone(),
+                },
+                &[],
+            );
+        }
+        let response = memory_v2::save_memory::build_response(
+            &store,
+            &workspace_id,
+            &memory_id,
+            verification_job_id,
+        )
+        .map_err(|message| (-32603, message))?;
+        tracing::info!(
+            tool = "save_memory",
+            session_id = self.session_id.as_str(),
+            scope = response.memory.scope.as_str(),
+            memory_count = 1,
+            "durable memory saved"
+        );
+        serde_json::to_value(&response)
+            .map(wrap_tool_result)
+            .map_err(|error| (-32603, format!("Serialization error: {error}")))
+    }
