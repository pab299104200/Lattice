    Decision,
    Constraint,
    Pattern,
    AntiPattern,
    WorkflowOutcome,
    FailurePattern,
    Procedure,
    Preference,
    ArchitectureInvariant,
    DocsContract,
    OpenQuestion,
    CounterMemory,
}

