+            "decision" => MemoryClass::Decision,
+            "constraint" => MemoryClass::Constraint,
+            "pattern" => MemoryClass::Pattern,
+            "anti_pattern" => MemoryClass::AntiPattern,
+            "workflow_outcome" => MemoryClass::WorkflowOutcome,
