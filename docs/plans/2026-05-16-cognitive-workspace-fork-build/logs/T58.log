+            "docs_contract" => MemoryClass::DocsContract,
+            "open_question" => MemoryClass::OpenQuestion,
+            "counter_memory" => MemoryClass::CounterMemory,
+            _ => MemoryClass::Observation,
+        }
+    }
+
+    pub fn from_memory_type(memory_type: &MemoryType) -> Self {
