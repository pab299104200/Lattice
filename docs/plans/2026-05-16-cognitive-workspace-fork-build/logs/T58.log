+                    workspace_id,
+                    memory_id,
+                    "existence",
+                    now_unix_micros(),
+                ],
+            )
+            .map_err(|error| {
+                LatticeError::Storage(format!("Failed to enqueue verification job: {error}"))
+            })?;
+        Ok(job_id)
+    }
