+                        )?
+                        .ok_or_else(|| {
+                            lattice_core::LatticeError::Storage(format!(
+                                "Proposal `{proposal_id}` disappeared after apply"
+                            ))
+                        })
+                    })
+                    .map_err(|error| {
+                        (
+                            -32603,
+                            format!("Failed to apply memory evolution proposal: {error}"),
+                        )
+                    })?;
+                if let Some(memory_id) = record.target_memory_id.as_ref() {
+                    let _ = capture.record_memory_updated(
+                        lattice_core::identity::MemoryId {
