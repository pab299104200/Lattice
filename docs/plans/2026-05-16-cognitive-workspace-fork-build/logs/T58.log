 mod tests;
 
 pub use model::{
-    EvidenceSpan, Memory, MemoryAccessRecord, MemoryEvidence, MemoryLinkRecord, MemoryScope,
-    MemoryScoreKind, MemoryScoreRecord, MemoryStructuredFields, MemoryType,
+    EvidenceSpan, Memory, MemoryAccessRecord, MemoryClass, MemoryEvidence, MemoryLinkRecord,
+    MemoryScope, MemoryScoreKind, MemoryScoreRecord, MemoryStructuredFields, MemoryType,
     MemoryVerificationStatus,
