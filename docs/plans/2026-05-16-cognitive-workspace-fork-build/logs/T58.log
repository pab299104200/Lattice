diff --git a/daemon/crates/lattice-core/src/consolidation/mod.rs b/daemon/crates/lattice-core/src/consolidation/mod.rs
index 3eda852f5e99d4f9aff19e81cc0eba9065171b9f..1d9a3293e08da5eb90221011e39dc823c658830d
--- a/daemon/crates/lattice-core/src/consolidation/mod.rs
