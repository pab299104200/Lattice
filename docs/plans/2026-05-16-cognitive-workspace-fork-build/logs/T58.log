+    pub fn enqueue_verification_job(
+        &self,
+        workspace_id: &str,
+        memory_id: &str,
+    ) -> Result<String, LatticeError> {
+        let job_id = format!("verify-job-{}-{}", memory_id, now_unix_micros());
