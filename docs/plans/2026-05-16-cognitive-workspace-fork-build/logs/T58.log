+            MemoryType::Decision => MemoryClass::Decision,
+            MemoryType::Exploration => MemoryClass::OpenQuestion,
+            MemoryType::Pattern => MemoryClass::Pattern,
+            MemoryType::AntiPattern => MemoryClass::AntiPattern,
+        }
+    }
