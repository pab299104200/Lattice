+
+#[test]
+fn existing_doc_section_emits_verified_proposal() {
+    let fixture = Fixture::new();
+    let section_id = fixture.section_id("docs/spec.md", "Verification Engine", "hash-doc");
+    let memory_id = fixture.seed_memory(
