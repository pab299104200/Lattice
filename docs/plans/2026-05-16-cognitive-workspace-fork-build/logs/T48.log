+                            name: (*heading).to_string(),
+                            signature: (*heading).to_string(),
+                            body: String::new(),
+                            file: (*path).to_string(),
+                            line: 1,
+                            end_line: 1,
+                            is_exported: false,
+                            language: Language::Markdown,
+                            references: Vec::new(),
+                            imports: Vec::new(),
+                        }],
+                    },
+                )
+            })
+            .collect()
+    }
+}
