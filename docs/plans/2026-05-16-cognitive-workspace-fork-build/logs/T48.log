+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use rusqlite::Connection;
+use tempfile::tempdir;
+
+use super::{VerifierCore, VerificationStatus};
+use crate::consolidation::{ConsolidationConfig, ConsolidationJobRuntime, ConsolidationProposal, ProposalKind};
