            ReviewQueueError::ProposalNotFound {
                proposal_id: proposal_id.to_string(),
            }
        })?;
        let reason_ref = reason.as_deref();
        match decision {
            ProposalDecision::Applied => {
                let outcome = proposal.apply(
                    self.conn,
                    self.memory_store,

