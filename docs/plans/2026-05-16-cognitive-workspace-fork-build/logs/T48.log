#[derive(Clone, Debug, PartialEq, Eq)]
pub struct ScanReport {
    pub proposals_enqueued: u32,
    pub skipped: u32,
    pub elapsed: Duration,
}

impl ScanReport {
    pub fn from_counts(proposals_enqueued: u32, skipped: u32, started: Instant) -> Self {
        Self {
            proposals_enqueued,
            skipped,
            elapsed: started.elapsed(),
        }
    }
}

