e.graph(),\n1643\t            &self.workspace_root.to_string_lossy(),\n1644\t            &request,\n1645\t            &capsule,\n1646\t            render_choice,\n1647\t        );\n1648\t        let seed = workflow_v2::build_expand_seed(&bundle);\n1649\t        drop(engine);\n1650\t\n1651\t        let handle = self.store_context_handle(\"get_context_capsule\", seed).await;\n1652\t        let mut value = serde_json::to_value(&bundle)\n1653\t            .map_err(|e| (-32603, format!(\"Serialization error: {}\", e)))?;\n1654\t        attach_context_handle(&mut value, &handle.legacy_handle, \"get_context_capsule\");\n1655\t\n1656\t        let metadata = WorkflowRunMetadata {\n1657\t            delivery_mode: format!(\"{:?}\", render_choice).to_lowercase(),\n1658\t            wire_format: \"standard\".to_string(),\n1659\t            single_anchor_used: false,\n1660\t            _mode_reason: \"context capsule defaults to bounded first-pass retrieval\".to_string(),\n1661\t            semantic_fallback_used: false,\n1662\t            outcome_memory_reuse_count: 0,\n1663\t        };\n1664\t\n1665\t        self.finalize_workflow_value(\"get_context_capsule\", value, &metadata, &response_options)\n1666\t            .await\n1667\t    }\n1668\t\n1669\t    async fn tool_prepare_change(&self, args: &Value) -> Result<Value, (i32, String)> {\n1670\t        let query = args[\"query\"]\n1671\t            .as_str()\n1672\t            .ok_or((-32602, \"Missing required parameter: query\".to_string()))?;\n1673\t        let requested_mode = parse_requested_bundle_mode(args);\n1674\t        let response_options = parse_workflow_response_options(args);\n1675\t        let entry_files = parse_string_array(args, \"entry_files\");\n1676\t        let entry_symbols = parse_string_array(args, \"entry_symbols\");\n1677\t\n1678\t        let (mut capsule, project_rules, semantic_fallback_used) = {\n1679\t            let mut engine = match self.lock_query_engine_for_workflow().await {\n1680\t                Ok(engine) => engine,\n1681\t                Err(()) => {\n1682\t                    return Ok(wrap_workflow_tool_result(\n1683\t                        indexing_workflow_response(\"prepare_change\", query),\n1684\t                        response_options.render,"}]},"parent_tool_use_id":null,"session_id":"1872dd72-ab0d-4621-9b2e-b0d7d6173b92","uuid":"e515e680-78d4-40f5-b2c9-4ee08a22f806","timestamp":"2026-05-17T15:06:03.460Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/mcp.rs","content":"    async fn tool_query_context(&self, args: &Value) -> Result<Value, (i32, String)> {\n        let query = args[\"query\"]\n            .as_str()\n            .ok_or((-32602, \"Missing required parameter: query\".to_string()))?;\n        let render_choice = WorkflowRenderChoice::from_mode_str(args[\"mode\"].as_str());\n        let response_options = parse_workflow_response_options(args);\n\n        let mut engine = match self.lock_query_engine_for_workflow().await {\n            Ok(engine) => engine,\n            Err(()) => {\n                return Ok(wrap_workflow_tool_result(\n                    indexing_workflow_response(\"get_context_capsule\", query),\n                    response_options.render,\n                ))\n            }\n        };\n        if self.indexing.load(Ordering::Relaxed)\n            && workflow_graph_is_empty(engine.graph())\n            && !self.promote_live_graph_for_workflow(&mut engine)\n        {\n            return Ok(wrap_workflow_tool_result(\n                indexing_workflow_response(\"get_context_capsule\", query),\n                response_options.render,\n            ));\n        }\n        let capsule = engine.query(\n            query,\n            None,\n            matches!(render_choice, WorkflowRenderChoice::Focused),\n        );\n        let request = workflow_v2::WorkflowRequest {\n            input: query.to_string(),\n            entry_files: Vec::new