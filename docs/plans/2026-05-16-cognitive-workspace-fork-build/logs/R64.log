gine) => engine,\n                Err(()) => {\n                    return Ok(wrap_workflow_tool_result(\n                        indexing_workflow_response(\"prepare_change\", query),\n                        response_options.render,","numLines":80,"startLine":1605,"totalLines":10684}}}
