{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VXWxfCQrrYqRyQ7d13npAU","type":"tool_result","content":"1\tuse super::{\n2\t    contradiction_state, evidence_strength, expansion_handle, freshness_status,\n3\t    supersession_state, MemoryRecord, TaskMemoryBundle,\n4\t};\n5\tuse lattice_core::memory::{Memory, MemoryScoreKind, MemoryScoreRecord, MemoryStore};\n6\tuse lattice_core::working_memory::{CheckpointId, WorkingMemoryState};\n7\tuse serde::{Deserialize, Serialize};\n8\tuse serde_json::{json, Value};\n9\t\n10\t/// Arguments for the `get_task_memory` tool.\n11\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n12\tpub struct GetTaskMemoryArgs {\n13\t    /// Task id whose active and durable memory should be loaded.\n14\t    pub task_id: String,\n15\t    /// Optional task-specific retrieval hint for durable memory recall.\n16\t    #[serde(default)]\n17\t    pub intent_hint: Option<String>,\n18\t    /// Optional soft token budget for the response payload.\n19\t    #[serde(default)]\n20\t    pub budget_tokens: Option<usize>,\n21\t}\n22\t\n23\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n24\tpub(crate) struct RankedMemory {\n25\t    pub id: String,\n26\t    pub inclusion_reason: String,\n27\t    pub score_milli: i64,\n28\t}\n29\t\n30\tpub fn tool_definition() -> Value {\n31\t    json!({\n32\t        \"name\": \"get_task_memory\",\n33\t        \"description\": \"Read working memory plus relevant durable memory for the current task, with inclusion reasons, verification status, freshness, contradiction state, and expansion handles.\",\n34\t        \"inputSchema\": {\n35\t            \"type\": \"object\",\n36\t            \"properties\": {\n37\t                \"task_id\": {\n38\t                    \"type\": \"string\",\n39\t                    \"description\": \"Task id resolved through the task identity layer\"\n40\t                },\n41\t                \"intent_hint\": {\n42\t                    \"type\": \"string\",\n43\t                    \"description\": \"Optional hint that biases durable memory retrieval toward the current operator intent\"\n44\t                },\n45\t                \"budget_tokens\": {\n46\t                    \"type\": \"integer\",\n47\t                    \"description\": \"Optional soft budget for the returned bundle\"\n48\t                }\n49\t            },\n50\t            \"required\": [\"task_id\"]\n51\t        }\n52\t    })\n53\t}\n54\t\n55\tpub fn parse_args(args: &Value) -> Result<GetTaskMemoryArgs, String> {\n56\t    serde_json::from_value(args.clone())\n57\t        .map_err(|error| format!(\"Invalid get_task_memory arguments: {error}\"))\n58\t}\n59\t\n60\tpub fn build_bundle(\n61\t    store: &MemoryStore,\n62\t    workspace_id: &str,\n63\t    task_id: String,\n64\t    checkpoint_id: Option<CheckpointId>,\n65\t    working_state: &WorkingMemoryState,\n66\t    memories: Vec<(Memory, String, i64)>,\n67\t) -> Result<TaskMemoryBundle, String> {\n68\t    let mut records = Vec::with_capacity(memories.len());\n69\t    for (memory, inclusion_reason, _score) in memories {\n70\t        records.push(build_memory_record(\n71\t            store,\n72\t            workspace_id,\n73\t            &memory,\n74\t            inclusion_reason,\n75\t        )?);\n76\t    }\n77\t    Ok(TaskMemoryBundle {\n78\t        task_id,\n79\t        checkpoint_id,\n80\t        working_memory_verification_status: working_state\n81\t            .verification_status\n82\t            .status\n83\t            .as_str()\n84\t            .to_string(),\n85\t        memories: records,\n86\t    })\n87\t}\n88\t\n89\tfn build_memory_record(\n90\t    store: &MemoryStore,\n91\t    workspace_id: &str,\n92\t    memory: &Memory,\n93\t    inclusion_reason: String,\n94\t) -> Result<MemoryRecord, String> {\n95\t    let fields = store\n96\t        .get_structured_fields(&memory.id)\n97\t        .map_err(|error| format!(\"Failed to load structured memory fields: {error}\"))?\n98\t        .unwrap_or_default();\n99\t    let links = store\n100\t        .list_memory_links_from(&memory.id)\n101\t        .map_err(|error| format!(\"Failed to load memory links: {error}\"))?;\n102\t    let access_history = store\n103\t        .list_memory_accesses(&memory.id)\n104\t        .map_err(|error| format!(\"Failed to load memory access history: {error}\"))?;\n105\t    let usefulness_scores = load_usefulness_scores(store, &memory.id)?;\n106\t    let last_verified_at = store\n107\t        .get_last_verified_at(&memory.id)\n108\t        .map_err(|error| format!(\"Failed to load last verified timestamp: {error}\"))?;\n109\t    let last_verified_graph_snapshot_id = store\n110\t        .get_last_verified_graph_snapshot_id(&memory.id)\n111\t        .map_err(|error| format!(\"Failed to load last verified graph snapshot id: {error}\"))?;\n112\t    let expires_at = store\n113\t        .get_expires_at(&memory.id)\n114\t        .map_err(|error| format!(\"Failed to load expiry timestamp: {error}\"))?;\n115\t    Ok(MemoryRecord {\n116\t        id: memory.id.clone(),\n117\t        expansion_handle: expansion_handle(memory, workspace_id),\n118\t        content: memory.content.clone(),\n119\t        memory_class: fields.memory_class,\n120\t        assertion_type: fields.assertion_type,\n121\t        scope: memory.scope.as_str().to_string(),\n122\t        confidence: memory.confidence,\n123\t        confidence_reason: fields.confidence_reason.clone(),\n124\t        verification_status: fields.verification_status.as_str().to_string(),\n125\t        freshness_status: freshness_status(memory, &fields, expires_at),\n126\t        contradiction_state: contradiction_state(&fields),\n127\t        supersession_state: supersession_state(&fields),\n128\t        inclusion_reason,\n129\t        evidence_strength: evidence_strength(&fields, &usefulness_scores, memory.access_count),\n130\t        linked_files: memory.linked_files.clone(),\n131\t        linked_symbols: memory.linked_symbols.clone(),\n132\t        linked_docs: fields.linked_docs.clone(),\n133\t        linked_tests: fields.linked_tests.clone(),\n134\t        linked_memories: fields.linked_memories.clone(),\n135\t        validity_conditions: fields.validity_conditions.clone(),\n136\t        invalidation_triggers: fields.invalidation_triggers.clone(),\n137\t        provenance: fields.provenance.clone(),\n138\t        evidence: fields.evidence.clone(),\n139\t        links,\n140\t        access_history,\n141\t        usefulness_scores,\n142\t        source_query: memory.source_query.clone(),\n143\t        branch: memory.branch.clone(),\n144\t        refresh_key: memory.refresh_key.clone(),\n145\t        last_verified_at,\n146\t        last_verified_graph_snapshot_id,\n147\t    })\n148\t}\n149\t\n150\tfn load_usefulness_scores(store: &MemoryStore, memory_id: &str) -> Result<Vec<MemoryScoreRecord>, String> {\n151\t    let mut scores = Vec::new();\n152\t    for kind in [\n153\t        MemoryScoreKind::UsefulnessPrior,\n154\t        MemoryScoreKind::RecentUsefulness,\n155\t        MemoryScoreKind::RetrievalAccuracy,\n156\t        MemoryScoreKind::RegressionRisk,\n157\t    ] {\n158\t        if let Some(score) = store\n159\t            .latest_memory_score(memory_id, kind)\n160\t            .map_err(|error| format!(\"Failed to load memory score: {error}\"))?\n161\t        {\n162\t            scores.push(score);\n163\t        }\n164\t    }\n165\t    Ok(scores)\n166\t}\n167\t\n168\tpub(crate) fn token_budget_limit(budget_tokens: Option<usize>) -> usize {\n169\t    match budget_tokens.unwrap_or(1200) {\n170\t        0..=400 => 2,\n171\t        401..=800 => 4,\n172\t        801..=1600 => 6,\n173\t        _ => 8,\n174\t    }\n175\t}\n176\t\n177\tpub(crate) fn approximate_payload_cost(memory: &Memory) -> usize {\n178\t    60 + memory.content.len() / 4 + (memory.linked_files.len() + memory.linked_symbols.len()) * 12\n179\t}\n180\t\n181\tpub(crate) fn clip_to_budget(memories: &[(Memory, String, i64)], budget_tokens: Option<usize>) -> Vec<(Memory, String, i64)> {\n182\t    let mut kept = Vec::new();\n183\t    let mut used = 0usize;\n184\t    let cap = budget_tokens.unwrap_or(1200);\n185\t    for item in memories {\n186\t        let next = approximate_payload_cost(&item.0);\n187\t        if !kept.is_empty() && used + next > cap {\n188\t            break;\n189\t        }\n190\t        used += next;\n191\t        kept.push(item.clone());\n192\t    }\n193\t    kept\n194\t}\n195\t\n196\tpub(crate) fn rank_memories(\n197\t    store: &MemoryStore,\n198\t    workspace_id: &str,\n199\t    working_state: &WorkingMemoryState,\n200\t    candidates: Vec<Memory>,\n201\t    intent_hint: Option<&str>,\n202\t    preferred_branch: Option<&str>,\n203\t) -> Result<Vec<(Memory, String, i64)>, String> {\n204\t    let active_file_hints: Vec<&str> = working_state\n205\t        .active_files\n206\t        .iter()\n207\t        .map(|item| item.repo_relative_path.as_str())\n208\t        .collect();\n209\t    let active_symbol_hints: Vec<&str> = working_state\n210\t        .active_symbols\n211\t        .iter()\n212\t        .map(|item| item.qualified_name.as_str())\n213\t        .collect();\n214\t    let query_terms = build_query_terms(&working_state.task_statement, intent_hint);\n215\t    let mut ranked = Vec::new();\n216\t\n217\t    for memory in candidates {\n218\t        let fields = store\n219\t            .get_structured_fields(&memory.id)\n220\t            .map_err(|error| format!(\"Failed to load structured memory fields: {error}\"))?\n221\t            .unwrap_or_default();\n222\t        let mut score = (memory.confidence * 1000.0).round() as i64;\n223\t        let mut reasons = Vec::new();\n224\t\n225\t        if working_state\n226\t            .selected_memories\n227\t            .iter()\n228\t            .any(|item| item.identity.to_string().contains(memory.id.as_str()))\n229\t        {\n230\t            score += 1200;\n231\t            reasons.push(\"selected in working memory\".to_str