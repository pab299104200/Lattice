{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0126EmdfGz7XRir1dp93y7Vk","type":"tool_result","content":"160\t}\n161\t\n162\tpub fn validate_args(args: &SaveMemoryArgs) -> Result<(), String> {\n163\t    if args.content.trim().is_empty() {\n164\t        return Err(\"save_memory requires non-empty content\".to_string());\n165\t    }\n166\t    if !(0.0..=1.0).contains(&args.confidence) {\n167\t        return Err(\"save_memory confidence must be between 0.0 and 1.0\".to_string());\n168\t    }\n169\t    if args.confidence_reason.trim().is_empty() {\n170\t        return Err(\"save_memory requires a non-empty confidence_reason\".to_string());\n171\t    }\n172\t    match args.scope {\n173\t        MemoryScopeArg::Branch if args.branch.as_deref().unwrap_or(\"\").trim().is_empty() => {\n174\t            Err(\"branch-scoped memory requires a branch\".to_string())\n175\t        }\n176\t        MemoryScopeArg::Organization\n177\t            if args.organization_id.as_deref().unwrap_or(\"\").trim().is_empty() =>\n178\t        {\n179\t            Err(\"organization-scoped memory requires organization_id\".to_string())\n180\t        }\n181\t        _ => Ok(()),\n182\t    }\n183\t}\n184\t\n185\tpub fn memory_scope(arg: MemoryScopeArg) -> MemoryScope {\n186\t    match arg {\n187\t        MemoryScopeArg::Session => MemoryScope::Session,\n188\t        MemoryScopeArg::Branch => MemoryScope::Branch,\n189\t        MemoryScopeArg::Repo => MemoryScope::Repo,\n190\t        MemoryScopeArg::Organization => MemoryScope::Organization,\n191\t    }\n192\t}\n193\t\n194\tpub fn freshness_policy(arg: FreshnessPolicyArg) -> MemoryFreshnessPolicy {\n195\t    match arg {\n196\t        FreshnessPolicyArg::SessionScoped => MemoryFreshnessPolicy::SessionScoped,\n197\t        FreshnessPolicyArg::BranchScoped => MemoryFreshnessPolicy::BranchScoped,\n198\t        FreshnessPolicyArg::RepoScoped => MemoryFreshnessPolicy::RepoScoped,\n199\t        FreshnessPolicyArg::TimeBound => MemoryFreshnessPolicy::TimeBound,\n200\t        FreshnessPolicyArg::ManualReview => MemoryFreshnessPolicy::ManualReview,\n201\t    }\n202\t}\n203\t\n204\tpub fn build_memory(\n205\t    session_id: &str,\n206\t    workspace_id: &str,\n207\t    args: &SaveMemoryArgs,\n208\t) -> (Memory, MemoryStructuredFields) {\n209\t    let scope = memory_scope(args.scope);\n210\t    let assertion_type = args\n211\t        .assertion_type\n212\t        .unwrap_or_else(|| default_assertion_type(&args.memory_class));\n213\t    let memory = Memory {\n214\t        id: String::new(),\n215\t        session_id: session_id.to_string(),\n216\t        content: args.content.clone(),\n217\t        memory_type: coarse_memory_type(&args.memory_class),\n218\t        scope,\n219\t        confidence: args.confidence,\n220\t        linked_symbols: args.linked_symbols.clone(),\n221\t        linked_files: args.linked_files.clone(),\n222\t        workspace_id: Some(workspace_id.to_string()),\n223\t        branch: args.branch.clone(),\n224\t        scope_organization_id: args.organization_id.clone(),\n225\t        refresh_key: args.refresh_key.clone(),\n226\t        source_query: args.source_query.clone(),\n227\t        created_at: 0,\n228\t        last_accessed: 0,\n229\t        access_count: 0,\n230\t        is_stale: false,\n231\t        stale_reason: None,\n232\t        verification_status: MemoryVerificationStatus::Unverified,\n233\t    };\n234\t    let structured = MemoryStructuredFields {\n235\t        memory_class: args.memory_class.clone(),\n236\t        assertion_type,\n237\t        verification_status: MemoryVerificationStatus::Unverified,\n238\t        confidence_reason: Some(args.confidence_reason.clone()),\n239\t        freshness_policy: freshness_policy(args.freshness_policy),\n240\t        freshness_policy_detail: None,\n241\t        validity_conditions: args.validity_conditions.clone(),\n242\t        invalidation_triggers: args.invalidation_triggers.clone(),\n243\t        provenance: build_pro