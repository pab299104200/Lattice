{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017um4WvEbXWWZdd4xHLiyHt","type":"tool_result","content":"86\t}\n87\t\n88\t/// One proposal returned by the consolidation report.\n89\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n90\tpub struct ConsolidationProposalItem {\n91\t    /// Auditable proposal id.\n92\t    pub proposal_id: String,\n93\t    /// Consolidation job id that created the proposal.\n94\t    pub job_id: String,\n95\t    /// Consolidation proposal kind.\n96\t    pub proposal_kind: String,\n97\t    /// Session task id summarized by this proposal.\n98\t    pub task_id: String,\n99\t    /// Human-readable category name.\n100\t    pub category: String,\n101\t    /// Why this proposal was emitted.\n102\t    pub summary: String,\n103\t}\n104\t\n105\t/// Category-level report for considered proposal families.\n106\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n107\tpub struct ConsolidationCategoryReport {\n108\t    /// Category name from the consolidation contract.\n109\t    pub category: String,\n110\t    /// Proposal ids emitted for this category.\n111\t    pub proposal_ids: Vec<String>,\n112\t    /// Explicit explanation when the category emitted no proposals.\n113\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n114\t    pub note: Option<String>,\n115\t}\n116\t\n117\t/// Tool response for `consolidate_session`.\n118\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n119\tpub struct ConsolidationReport {\n120\t    /// Session id that was consolidated.\n121\t    pub session_id: String,\n122\t    /// Mode used to generate the report.\n123\t    pub mode: ConsolidationMode,\n124\t    /// Render mode used for the payload.\n125\t    pub render_mode: ConsolidationRenderMode,\n126\t    /// Optional synchronous budget hint echoed from the request.\n127\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n128\t    pub budget_ms: Option<u64>,\n129\t    /// Proposals produced by the run.\n130\t    pub proposals: Vec<ConsolidationProposalItem>,\n131\t    /// Category-by-category rollup.\n132\t    pub categories: Vec<ConsolidationCategoryReport>,\n133\t    /// Whether the report omitted any higher-cost consolidation families.\n134\t    pub incomplete: bool,\n135\t    /// Notes about omissions or bounded behavior.\n136\t    pub notes: Vec<String>,\n137\t}\n138\t\n139\tpub fn tool_definition() -> Value {\n140\t    json!({\n141\t        \"name\": \"consolidate_session\",\n142\t        \"description\": \"Trigger proposal-only session consolidation and return auditable proposal ids for episode summaries and related consolidation categories.\",\n143\t        \"inputSchema\": {\n144\t            \"type\": \"object\",\n145\t            \"properties\": {"}]},"parent_tool_use_id":null,"session_id":"1872dd72-ab0d-4621-9b2e-b0d7d6173b92","uuid":"28e9c6f2-5fb7-486c-b747-a9110bd13394","timestamp":"2026-05-17T15:02:28.457Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/memory_v2/consolidate_session.rs","content":"}\n\n/// One proposal returned by the consolidation report.\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct ConsolidationProposalItem {\n    /// Auditable proposal id.\n    pub proposal_id: String,\n    /// Consolidation job id that created the proposal.\n    pub job_id: String,\n    /// Consolidation proposal kind.\n    pub proposal_kind: String,\n    /// Session task id summarized by this proposal.\n    pub task_id: String,\n    /// Human-readable category name.\n    pub category: String,\n    /// Why this proposal was emitted.\n    pub summary: String,\n}\n\n/// Category-level report for considered proposal families.\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct ConsolidationCategoryReport {\n    /// Category name from the consolidation contract.\n    pub category: String,\n    /// Proposal ids emitted for this category.\n    pub proposal_ids: Vec<String>,\n    /// Explicit explanation when the category emitted no proposals.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub note: Option<String>,\n}\n\n/// Tool response for `consolidate_session`.\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct ConsolidationReport {\n    /// Session id that was consolidated.\n    pub session_id: String,\n    /// Mode used to generate the report.\n    pub mode: ConsolidationMode,\n    /// Render mode used for the payload.\n    pub render_mode: ConsolidationRenderMode,\n    /// Optional synchronous budget hint echoed from the request.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub budget_ms: Option<u64>,\n    /// Proposals produced by the run.\n    pub proposals: Vec<ConsolidationProposalItem>,\n    /// Category-by-category rollup.\n    pub categories: Vec<ConsolidationCategoryReport>,\n    /// Whether the report omitted any higher-cost consolidation families.\n    pub incomplete: bool,\n    /// Notes about omissions or bounded behavior.\n    pub notes: Vec<String>,\n}\n\npub fn tool_definition() -> Value {\n    json!({\n        \"name\": \"consolidate_session\",\n        \"description\": \"Trigger proposal-only session consolidation and return auditable proposal ids for episode summaries and related consolidation categories.\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {","numLines":60,"startLine":86,"totalLines":354}}}
