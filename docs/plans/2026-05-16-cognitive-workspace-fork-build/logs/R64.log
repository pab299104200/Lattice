ection identity.\n52\t    DocSection(SectionId),\n53\t}\n54\t\n55\t/// Arguments for `list_memory_conflicts`.\n56\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n57\tpub struct ListMemoryConflictsArgs {\n58\t    /// Memory or graph-node anchor to inspect.\n59\t    pub anchor: ConflictAnchor,\n60\t    /// Structured response detail level.\n61\t    #[serde(default = \"default_render_mode\")]\n62\t    pub render_mode: super::verify_explain_memory::VerifyExplainRenderMode,\n63\t    /// Maximum number of conflicts to return.\n64\t    #[serde(default = \"default_limit\")]\n65\t    pub limit: usize,\n66\t    /// Optional pagination cursor encoded as a numeric offset.\n67\t    #[serde(default)]\n68\t    pub cursor: Option<usize>,\n69\t}\n70\t\n71\t/// Conflict edge surfaced for operator review.\n72\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n73\tpub struct ConflictRecord {\n74\t    /// Encoded source memory identity.\n75\t    pub source: String,\n76\t    /// Encoded target memory identity.\n77\t    pub target: String,\n78\t    /// Conflict edge type.\n79\t    pub link_type: String,\n80\t    /// Link strength on a normalized 0..1 scale.\n81\t    pub link_strength: f32,\n82\t    /// Actor or subsystem that created the edge.\n83\t    pub created_by: String,\n84\t    /// Link creation timestamp.\n85\t    pub created_at: u64,\n86\t    /// Verification status attached to the edge.\n87\t    pub link_verification_status: VerificationStatus,\n88\t    /// Human-readable reason for the conflict.\n89\t    pub reason: String,\n90\t}\n91\t\n92\t/// Response returned by `list_memory_conflicts`.\n93\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n94\tpub struct ListMemoryConflictsResponse {\n95\t    /// Human-readable anchor summary.\n96\t    pub anchor: String,\n97\t    /// Returned conflict edges for the current page.\n98\t    pub conflicts: Vec<ConflictRecord>,\n99\t    /// Total number of in-scope conflicts before pagination.\n100\t    pub total: usize,\n101\t    /// Next pagination cursor, when more conflicts remain.\n102\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n103\t    pub next_cursor: Option<usize>,\n104\t    /// Requested structured response detail level.\n105\t    pub render_mode: super::verify_explain_memory::VerifyExplainRenderMode,\n106\t    /// Compact per-conflict summaries.\n107\t    pub summary_lines: Vec<String>,\n108\t}\n109\t\n110\t/// Internal execution bundle returned before event emission.\n111\t#[derive(Debug, Clone)]\n112\tpub struct ListMemoryConflictsExecution {\n113\t    /// Final rendered response payload.\n114\t    pub response: ListMemoryConflictsResponse,\n115\t    /// Memory identities surfaced in the response.\n116\t    pub surfaced_memory_ids: Vec<MemoryId>,\n117\t}\n118\t\n119\tpub fn tool_definition() -> Value {\n120\t    json!({\n121\t        \"name\": \"list_memory_conflicts\",\n122\t        \"description\": \"List contradiction and supersession edges anchored on a memory or graph node, with scope-aware pagination.\",\n123\t        \"inputSchema\": {\n124\t            \"type\": \"object\",\n125\t            \"properties\": {\n126\t                \"anchor\": {\n127\t                    \"oneOf\": [\n128\t                        {\n129\t                            \"type\": \"object\",\n130\t                            \"properties\": {\n131\t                                \"workspace_id\": {\"type\": \"string\"},\n132\t                                \"ulid\": {\"type\": \"string\"}\n133\t                            },\n134\t                            \"required\": [\"workspace_id\", \"ulid\"]\n135\t                        },\n136\t                        {\n137\t                            \"type\": \"object\",\n138\t                            \"properties\": {\n139\t                                \"workspace_id\": {\"type\": \"string\"},\n140\t                                \"repo_relative_path\": {\"type\": \"string\"},\n141\t      