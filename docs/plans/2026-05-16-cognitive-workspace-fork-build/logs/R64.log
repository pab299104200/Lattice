vent traces.\n48\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n49\t#[serde(rename_all = \"snake_case\")]\n50\tpub enum EventTraceRenderMode {\n51\t    Compact,\n52\t    Full,\n53\t    Diagnostic,\n54\t}\n55\t\n56\timpl Default for EventTraceRenderMode {\n57\t    fn default() -> Self {\n58\t        Self::Compact\n59\t    }\n60\t}\n61\t\n62\t/// Event-scope discriminator for the response.\n63\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n64\tpub struct EventTraceScope {\n65\t    /// Scope kind returned by the page.\n66\t    pub kind: String,\n67\t    /// Scope value returned by the page.\n68\t    pub value: String,\n69\t}\n70\t\n71\t/// One event entry in the paginated response.\n72\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n73\tpub struct EventTraceEntry {\n74\t    /// Stable event identity.\n75\t    pub event_id: String,\n76\t    /// Expansion handle for later payload retrieval.\n77\t    pub expansion_handle: String,\n78\t    /// Event kind.\n79\t    pub kind: String,\n80\t    /// UTC timestamp for the event.\n81\t    pub timestamp: DateTime<Utc>,\n82\t    /// Session id attached to the event.\n83\t    pub session_id: String,\n84\t    /// Task id attached to the event, when any.\n85\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n86\t    pub task_id: Option<String>,\n87\t    /// One-line compact summary.\n88\t    pub summary: String,\n89\t    /// Stable references carried by the event.\n90\t    pub references: Vec<String>,\n91\t    /// Full payload in full/diagnostic modes.\n92\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n93\t    pub payload: Option<Value>,\n94\t    /// Canonical payload hash in diagnostic mode.\n95\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n96\t    pub payload_hash: Option<String>,\n97\t    /// Spilled-payload row id in diagnostic mode.\n98\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n99\t    pub spilled_payload_row_id: Option<i64>,\n100\t}\n101\t\n102\t/// Top-level paginated event trace response.\n103\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n104\tpub struct EventTracePage {\n105\t    /// Scope used for the trace page.\n106\t    pub scope: EventTraceScope,\n107\t    /// Render mode used to shape entries.\n108\t    pub render_mode: EventTraceRenderMode,\n109\t    /// Cursor supplied by the caller.\n110\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n111\t    pub cursor: Option<String>,\n112\t    /// Cursor for the next page, when any.\n113\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n114\t    pub next_cursor: Option<String>,\n115\t    /// Returned event entries.\n116\t    pub events: Vec<EventTraceEntry>,\n117\t}\n118\t\n119\tpub fn tool_definition() -> Value {\n120\t    json!({\n121\t        \"name\": \"get_event_trace\",\n122\t        \"description\": \"Return a paginated, workspace-bounded event trace for a task, session, or workspace with compact, full, or diagnostic rendering.\",\n123\t        \"inputSchema\": {\n124\t            \"type\": \"object\",\n125\t            \"properties\": {\n126\t                \"task_id\": {\"type\": \"string\"},\n127\t                \"session_id\": {\"type\": \"string\"},\n128\t                \"workspace_id\": {\"type\": \"string\"},\n129\t                \"kinds\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n130\t                \"since\": {\"type\": \"string\", \"format\": \"date-time\"},"}]},"parent_tool_use_id":null,"session_id":"1872dd72-ab0d-4621-9b2e-b0d7d6173b92","uuid":"098891f9-4c7a-44b7-b56a-839751f6a969","timestamp":"2026-05-17T14:58:34.229Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/memory_v2/get_event_trace.rs","content":"//! Paginated event-trace MCP surface for audit, replay, and debugging.\n//!\n//! This module implements the `## MCP Surface`, `## Event Log`, and\n//! `## MCP Tool Contract Principles` contracts from\n//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`.\n//! Responses are compact by default and expose stable expansion handles for\n//! callers that want full payload inspection.\n\nuse lattice_core::events::{EventEnvelope, EventKind, PayloadLocation, StableRef};\nuse lattice_core::identity::{encode_identity, Identity};\nuse lattice_core::{DateTime, Utc};\nuse serde::{Deserialize, Serialize};\nuse serde_json::{json, Value};\n\n/// Arguments for the `get_event_trace` tool.\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct GetEventTraceArgs {\n    /// Optional task scope.\n    #[serde(default)]\n    pub task_id: Option<String>,\n    /// Optional session scope.\n    #[serde(default)]\n    pub session_id: Option<String>,\n    /// Optional workspace scope.\n    #[serde(default)]\n    pub workspace_id: Option<String>,\n    /// Optional event-kind filter.\n    #[serde(default)]\n    pub kinds: Vec<EventKind>,\n    /// Optional inclusive lower bound.\n    #[serde(default)]\n    pub since: Option<DateTime<Utc>>,\n    /// Optional inclusive upper bound.\n    #[serde(default)]\n    pub until: Option<DateTime<Utc>>,\n    /// Opaque pagination cursor from a prior page.\n    #[serde(default)]\n    pub cursor: Option<String>,\n    /// Requested page size.\n    #[serde(default)]\n    pub limit: Option<usize>,\n    /// Response verbosity.\n    #[serde(default)]\n    pub render_mode: Option<EventTraceRenderMode>,\n}\n\n/// Response verbosity for event traces.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum EventTraceRenderMode {\n    Compact,\n    Full,\n    Diagnostic,\n}\n\nimpl Default for EventTraceRenderMode {\n    fn default() -> Self {\n        Self::Compact\n    }\n}\n\n/// Event-scope discriminator for the response.\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct EventTraceScope {\n    /// Scope kind returned by the page.\n    pub kind: String,\n    /// Scope value returned by the page.\n    pub value: String,\n}\n\n/// One event entry in the paginated response.\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct EventTraceEntry {\n    /// Stable event identity.\n    pub event_id: String,\n    /// Expansion handle for later payload retrieval.\n    pub expansion_handle: String,\n    /// Event kind.\n    pub kind: String,\n    /// UTC timestamp for the event.\n    pub timestamp: DateTime<Utc>,\n    /// Session id attached to the event.\n    pub session_id: String,\n    /// Task id attached to the event, when any.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub task_id: Option<String>,\n    /// One-line compact summary.\n    pub summary: String,\n    /// Stable references carried by the event.\n    pub references: Vec<String>,\n    /// Full payload in full/diagnostic modes.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub payload: Option<Value>,\n    /// Canonical payload hash in diagnostic mode.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub payload_hash: Option<String>,\n    /// Spilled-payload row id in diagnostic mode.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub spilled_payload_row_id: Option<i64>,\n}\n\n/// Top-level paginated event trace response.\n#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\npub struct EventTracePage {\n    /// Scope used for the trace page.\n    pub scope: EventTraceScope,\n    /// Render mode used to shape entries.\n    pub render_mode: EventTraceRenderMode,\n    /// Cursor supplied by the caller.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub cursor: Option<String>,\n    /// Cursor for the next page, when any.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub next_cursor: Option<String>,\n    /// Returned event entries.\n    pub events: Vec<EventTraceEntry>,\n}\n\npub fn tool_definition() -> Value {\n    json!({\n        \"name\": \"get_event_trace\",\n        \"description\": \"Return a paginated, workspace-bounded event trace for a task, session, or workspace with compact, full, or diagnostic rendering.\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"task_id\": {\"type\": \"string\"},\n                \"session_id\": {\"type\": \"string\"},\n                \"workspace_id\": {\"type\": \"string\"},\n                \"kinds\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n                \"since\": {\"type\": \"string\", \"format\": \"date-time\"},","numLines":130,"startLine":1,"totalLines":205}}}
