{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017xSja9HTWbGo9gViT2RSVN","type":"tool_result","content":"1\tuse super::EvolutionAction;\n2\tuse lattice_core::consolidation::{ConsolidationProposal, ProposalKind, ProposalTarget};\n3\tuse lattice_core::memory::{Memory, MemoryStore, MemoryStructuredFields, MemoryVerificationStatus};\n4\tuse serde::{Deserialize, Serialize};\n5\tuse serde_json::{json, Value};\n6\t\n7\t/// Arguments for the unified `propose_memory_evolution` tool.\n8\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n9\tpub struct ProposeMemoryEvolutionArgs {\n10\t    /// Whether to propose, apply, or reject a memory evolution.\n11\t    pub action: EvolutionAction,\n12\t    /// Existing proposal id for apply/reject.\n13\t    #[serde(default)]\n14\t    pub proposal_id: Option<String>,\n15\t    /// Source memory id for a new proposal.\n16\t    #[serde(default)]\n17\t    pub memory_id: Option<String>,\n18\t    /// Proposed content replacement.\n19\t    #[serde(default)]\n20\t    pub content: Option<String>,\n21\t    /// Linked files to append or replace in the proposed state.\n22\t    #[serde(default)]\n23\t    pub linked_files: Vec<String>,\n24\t    /// Linked symbols to append or replace in the proposed state.\n25\t    #[serde(default)]\n26\t    pub linked_symbols: Vec<String>,\n27\t    /// Linked docs to append or replace in the proposed state.\n28\t    #[serde(default)]\n29\t    pub linked_docs: Vec<String>,\n30\t    /// Linked tests to append or replace in the proposed state.\n31\t    #[serde(default)]\n32\t    pub linked_tests: Vec<String>,\n33\t    /// Linked memories to append or replace in the proposed state.\n34\t    #[serde(default)]\n35\t    pub linked_memories: Vec<String>,\n36\t    /// Validity conditions to persist in the proposed state.\n37\t    #[serde(default)]\n38\t    pub validity_conditions: Vec<String>,\n39\t    /// Invalidation triggers to persist in the proposed state.\n40\t    #[serde(default)]\n41\