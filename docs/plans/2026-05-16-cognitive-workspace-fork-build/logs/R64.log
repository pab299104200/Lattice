{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RjtgSTGQSKS5yiMCXj53cR","type":"tool_result","content":"1\t//! Manual session-consolidation trigger for the Memory V2 MCP surface.\n2\t//!\n3\t//! This module implements the plan contract headings `## MCP Surface` and\n4\t//! `## Consolidation Engine` from\n5\t//! `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`.\n6\t//! It preserves the requirement that consolidation emits proposals only:\n7\t//! no consolidation job may silently rewrite memory without auditable prior\n8\t//! and proposed state.\n9\t\n10\tuse lattice_core::consolidation::{\n11\t    empty_state, ConsolidationJobMode, ConsolidationProposal, EpisodeOutcome, EpisodeTemplate,\n12\t    ProposalKind, ProposalTarget,\n13\t};\n14\tuse lattice_core::events::{EventEnvelope, StableRef};\n15\tuse lattice_core::memory::{Memory, MemoryScope, MemoryStore, MemoryType};\n16\tuse serde::{Deserialize, Serialize};\n17\tuse serde_json::{json, Value};\n18\tuse std::collections::HashMap;\n19\t\n20\t/// Arguments for the `consolidate_session` tool.\n21\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n22\tpub struct ConsolidateSessionArgs {\n23\t    /// Session id whose task traces should be consolidated.\n24\t    pub session_id: String,\n25\t    /// Consolidation execution mode.\n26\t    #[serde(default)]\n27\t    pub mode: Option<ConsolidationMode>,\n28\t    /// Optional synchronous budget hint in milliseconds.\n29\t    #[serde(default)]\n30\t    pub budget_ms: Option<u64>,\n31\t    /// Response verbosity for the report payload.\n32\t    #[serde(default)]\n33\t    pub render_mode: Option<ConsolidationRenderMode>,\n34\t}\n35\t\n36\t/// Consolidation modes accepted by the tool.\n37\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n38\t#[serde(rename_all = \"snake_case\")]\n39\tpub enum ConsolidationMode {\n40\t    PostTask,\n41\t    Background,\n42\t    ManualReview,\n43\t    Replay,\n44\t}\n45\t\n46\timpl ConsolidationMode {\n47\t    /// Canonical wire name for the mode.\n48\t    pub fn as_str(self) -> &'static str {\n49\t        match self {\n50\t            Self::PostTask => \"post_task\",\n51\t            Self::Background => \"background\",\n52\t            Self::ManualReview => \"manual_review\",\n53\t            Self::Replay => \"replay\",\n54\t        }\n55\t    }\n56\t\n57\t    pub fn job_mode(self) -> ConsolidationJobMode {\n58\t        match self {\n59\t            Self::PostTask => ConsolidationJobMode::SynchronousPostTask,\n60\t            Self::Background => ConsolidationJobMode::Background,\n61\t            Self::ManualReview => ConsolidationJobMode::ManualReview,\n62\t            Self::Replay => ConsolidationJobMode::Replay,\n63\t        }\n64\t    }\n65\t}\n66\t\n67\timpl Default for ConsolidationMode {\n68\t    fn default() -> Self {\n69\t        Self::PostTask\n70\t    }\n71\t}\n72\t\n73\t/// Render mode accepted by the tool.\n74\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n75\t#[serde(rename_all = \"snake_case\")]\n76\tpub enum ConsolidationRenderMode {\n77\t    Compact,\n78\t    Full,\n79\t    Diagnostic,\n80\t}\n81\t\n82\timpl Default for ConsolidationRenderMode {\n83\t    fn default() -> Self {\n84\t        Self::Compact\n85\t    }\n86\t}\n87\t\n88\t/// One proposal returned by the consolidation report.\n89\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n90\tpub struct ConsolidationProposalItem {\n91\t    /// Auditable proposal id.\n92\t    pub proposal_id: String,\n93\t    /// Consolidation job id that created the proposal.\n94\t    pub job_id: String,\n95\t    /// Consolidation proposal kind.\n96\t    pub proposal_kind: String,\n97\t    /// Session task id summarized by this proposal.\n98\t    pub task_id: String,\n99\t    /// Human-readable category name.\n100\t    pub category: String,"}]},"parent_tool_use_id":null,"session_id":"1872dd72-ab0d-4621-9b2e-b0d7d6173b92","uuid":"dbc0816f-01d3-408b-b11e-7