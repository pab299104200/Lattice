{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01StmcVGza6q9ePTutW5sxET","type":"tool_result","content":"260\t\n261\tpub struct ConsolidationJobRuntime {\n262\t    conn: Arc<Mutex<Connection>>,\n263\t    queue: BoundedJobQueue,\n264\t    config: ConsolidationConfig,\n265\t}\n266\t\n267\tpub fn persist_pending_proposal(\n268\t    conn: &Connection,\n269\t    workspace_id: &str,\n270\t    kind: &str,\n271\t    mode: ConsolidationJobMode,\n272\t    proposal: &ConsolidationProposal,\n273\t) -> Result<ConsolidationProposalRecord, LatticeError> {\n274\t    initialize_schema(conn)?;\n275\t    conn.execute(\n276\t        \"INSERT INTO consolidation_jobs\n277\t            (job_id, workspace_id, kind, mode, status, enqueued_at, proposal_id)\n278\t         VALUES (?1, ?2, ?3, ?4, 'proposed', ?5, ?6)\",\n279\t        params![\n280\t            proposal.job_id,\n281\t            workspace_id,\n282\t            kind,\n283\t            mode.as_str(),\n284\t            now_unix_micros(),\n285\t            proposal.proposal_id,\n286\t        ],\n287\t    )\n288\t    .map_err(|e| LatticeError::Storage(format!(\"Failed to persist consolidation job: {e}\")))?;\n289\t    proposal.insert_pending(conn)?;\n290\t    ConsolidationProposal::load_record(conn, &proposal.proposal_id)?.ok_or_else(|| {\n291\t        LatticeError::Storage(format!(\n292\t            \"Proposal '{}' was not readable after persistence\",\n293\t            proposal.proposal_id\n294\t        ))\n295\t    })\n296\t}\n297\t\n298\timpl ConsolidationJobRuntime {\n299\t    pub fn new(conn: Connection, config: ConsolidationConfig) -> Result<Self, LatticeError> {\n300\t        initialize_schema(&conn)?;\n301\t        let conn = Arc::new(Mutex::new(conn));\n302\t        let queue = BoundedJobQueue::new(config.max_queue_depth, conn.clone());\n303\t        Ok(Self {\n304\t            conn,\n305\t            queue,\n306\t            config,\n307\t        })\n308\t    }\n309\t"}]},"parent_tool_use_id":null