{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QYPhbQHm2xvbjbSTwBvuf5","type":"tool_result","content":"1\tuse std::path::PathBuf;\n2\tuse std::sync::atomic::AtomicBool;\n3\tuse std::sync::Arc;\n4\tuse std::time::{SystemTime, UNIX_EPOCH};\n5\t\n6\tuse lattice_core::events::{\n7\t    EventPayload, EventQuery, EventReader, EventStore, EventWriter, FlushPolicy, QueryOrder,\n8\t};\n9\tuse lattice_core::graph::CodeGraph;\n10\tuse lattice_core::indexer::Indexer;\n11\tuse lattice_core::memory::{\n12\t    Memory, MemoryClass, MemoryScope, MemoryStore, MemoryStructuredFields,\n13\t    MemoryVerificationStatus, MemoryType,\n14\t};\n15\tuse lattice_core::memory::model::MemoryAssertionType;\n16\tuse lattice_core::query::QueryEngine;\n17\tuse lattice_core::storage::GraphStore;\n18\tuse lattice_core::working_memory::WorkingMemoryState;\n19\tuse serde_json::{json, Value};\n20\tuse tokio::sync::Mutex;\n21\t\n22\tuse super::super::mcp::McpHandler;\n23\tuse super::super::server::RequestHandler;\n24\tuse super::{get_task_memory, propose_memory_evolution, save_memory, EvolutionAction, TaskMemoryBundle};\n25\t\n26\tconst TASK_ID: &str = \"task-memory-v2\";\n27\t\n28\t#[test]\n29\tfn serde_round_trips_memory_tool_requests_and_responses() {\n30\t    let get_args = get_task_memory::GetTaskMemoryArgs {\n31\t        task_id: TASK_ID.to_string(),\n32\t        intent_hint: Some(\"refresh auth memory\".to_string()),\n33\t        budget_tokens: Some(800),\n34\t    };\n35\t    round_trip(&get_args);\n36\t\n37\t    let save_args = save_memory::SaveMemoryArgs {\n38\t        content: \"Auth refresh invariant\".to_string(),\n39\t        memory_class: MemoryClass::ArchitectureInvariant,\n40\t        assertion_type: Some(MemoryAssertionType::Constraint),\n41\t        scope: save_memory::MemoryScopeArg::Repo,\n42\t        confidence: 0.81,\n43\t        confidence_reason: \"Derived from code and tests\".to_string(),\n44\t        freshness_policy: save_memory::FreshnessPolicyArg::ManualReview,\n45\t        validity_conditions: vec![\"auth router unchanged\".to_string()],\n46\t        invalidation_triggers: vec![\"refresh flow refactor\".to_string()],\n47\t        provenance_event_ids: vec![\"evt-1\".to_string()],\n48\t        evidence: Vec::new(),\n49\t        linked_files: vec![\"src/auth.rs\".to_string()],\n50\t        linked_symbols: vec![\"refresh_token\".to_string()],\n51\t        linked_docs: vec![\"docs/auth.md#Refresh\".to_string()],\n52\t        linked_tests: vec![\"tests/auth_refresh.rs::refresh_token\".to_string()],\n53\t        linked_memories: vec![\"mem-1\".to_string()],\n54\t        source_query: Some(\"refresh token failures\".to_string()),\n55\t        refresh_key: Some(\"auth::refresh\".to_string()),\n56\t        branch: None,\n57\t        organization_id: None,\n58\t    };\n59\t    round_trip(&save_args);\n60\t\n61\t    let proposal_args = propose_memory_evolution::ProposeMemoryEvolutionArgs {\n62\t        action: EvolutionAction::Propose,\n63\t        proposal_id: None,\n64\t        memory_id: Some(\"mem-1\".to_string()),\n65\t        content: Some(\"Updated content\".to_string()),\n66\t        linked_files: vec![\"src/auth.rs\".to_string()],\n67\t        linked_symbols: vec![\"refresh_token\".to_string()],\n68\t        linked_docs: vec![\"docs/auth.md#Refresh\".to_string()],\n69\t        linked_tests: vec![\"tests/auth_refresh.rs::refresh_token\".to_string()],\n70\t        linked_memories: vec![\"mem-2\".to_string()],\n71\t        validity_conditions: vec![\"router still present\".to_string()],\n72\t        invalidation_triggers: vec![\"handler removed\".to_string()],\n73\t        superseded_by_memory_id: None,\n74\t        invalidate_reason: None,\n75\t        reason: Some(\"refresh contract evolved\".to_string()),\n76\t        decided_by: Some(\"assistant\".to_string()),\n77\t    };\n78\t    round_trip(&proposal_args);\n79\t\n80\t    let bundle = TaskMemoryBundle {\n81\t        task_id: TASK_ID.to_string(),\n82\t        checkpoint_id: Some(7),\n83\t        working_memory_verification_status: \"verified\".to_string(),\n84\t        memories: Vec::new(),\n85\t    };\n86\t    round_trip(&bundle);\n87\t}\n88\t\n89\t#[tokio::test]\n90\tasync fn get_task_memory_surfaces_inclusion_reason_and_verification_status() {\n91\t    let (handler, memory_store, event_store, workspace_root, context_cache_path) =\n92\t        build_handler(\"get-task-memory\");\n93\t    {\n94\t        let mut store = memory_store.lock().await;\n95\t        let id = store\n96\t            .store(seed_memory(\"refresh token must preserve session\", MemoryScope::Repo))\n97\t            .expect(\"store memory\");\n98\t        let mut fields = MemoryStructuredFields::default();\n99\t        fields.memory_class = MemoryClass::Constraint;\n100\t        fields.assertion_type = MemoryAssertionType::Constraint;\n101\t        fields.verification_status = MemoryVerificationStatus::Verified;\n102\t        fields.linked_docs = vec![\"docs/auth.md#Refresh\".to_string()];\n103\t        store\n104\t            .update_structured_fields(&id, &fields)\n105\t            .expect(\"update fields\");\n106\t    }\n107\t    handler\n108\t        .remember_working_memory_state_for_test(\n109\t            TASK_ID,\n110\t            WorkingMemoryState::new(\"refresh token session diagnosis\"),\n111\t        )\n112\t        .await;\n113\t\n114\t    let response = handler\n115\t        .handle(\n116\t            \"tools/call\",\n117\t            json!({\"name\": \"get_task_memory\", \"arguments\": {\"task_id\": TASK_ID, \"intent_hint\": \"refresh token\"}}),\n118\t        )\n119\t        .await\n120\t        .expect(\"tool succeeds\");\n121\t    let payload = parse_tool_payload(&response);\n122\t    let memories = payload[\"memories\"].as_array().expect(\"memories array\");\n123\t    assert!(!memories.is_empty(), \"expected at least one surfaced memory\");\n124\t    for memory in memories {\n125\t        assert!(memory[\"inclusion_reason\"].as_str().is_some_and(|value| !value.is_empty()));\n126\t        assert!(memory[\"verification_status\"].as_str().is_some_and(|value| !value.is_empty()));\n127\t    }\n128\t\n129\t    let events = read_events(&event_store);\n130\t    assert!(events.iter().any(|event| matches!(event.payload, EventPayload::MemoryRetrieved(_))));\n131\t    cleanup_paths(&workspace_root, &context_cache_path);\n132\t}\n133\t\n134\t#[tokio::test]\n135\tasync fn save_memory_defaults_unverified_persists_fields_emits_event_and_queues_verification() {\n136\t    let (handler, memory_store, event_store, workspace_root, context_cache_path) =\n137\t        build_handler(\"save-memory\");\n138\t    let response = handler\n139\t        .handle(\n140\t            \"tools/call\",\n141\t            json!({\n142\t                \"name\": \"save_memory\",\n143\t                \"arguments\": {\n144\t                    \"content\": \"Refresh token invariants rely on session scope\",\n145\t                    \"memory_class\": \"constraint\",\n146\t                    \"assertion_type\": \"constraint\",\n147\t                    \"scope\": \"repo\",\n148\t                    \"confidence\": 0.74,\n149\t                    \"confidence_reason\": \"Observed in handler and tests\",\n150\t                    \"freshness_policy\": \"manual_review\",\n151\t                    \"validity_conditions\": [\"session middleware stays enabled\"],\n152\t                    \"invalidation_triggers\": [\"refresh handler rewrite\"],\n153\t                    \"provenance_event_ids\": [\"evt-refresh\"],\n154\t                    \"linked_files\": [\"src/auth.rs\"],\n155\t                    \"linked_symbols\": [\"refresh_token\"],\n156\t                    \"linked_docs\": [\"docs/auth.md#Refresh\"],\n157\t                    \"linked_tests\": [\"tests/auth_refresh.rs::refresh_token\"],\n158\t                    \"linked_memories\": [\"mem-upstream\"],\n159\t                    \"source_query\": \"refresh token failures\",\n160\t                    \"refresh_key\": \"auth::refresh\"\n161\t                }\n162\t            }),\n163\t        )\n164\t        .await\n165\t        .expect(\"save_memory succeeds\");\n166\t    let payload = parse_tool_payload(&response);\n167\t    assert_eq!(payload[\"memory\"][\"verification_status\"].as_str(), Some(\"unverified\"));\n168\t    let memory_id = payload[\"memory_id\"].as_str().expect(\"memory id\");\n169\t\n170\t    let store = memory_store.lock().await;\n171\t    let fields = store\n172\t        .get_structured_fields(memory_id)\n173\t        .expect(\"fields query\")\n174\t        .expect(\"fields exist\");\n175\t    assert_eq!(fields.memory_class, MemoryClass::Constraint);\n176\t    assert_eq!(fields.assertion_type, MemoryAssertionType::Constraint);\n177\t    assert_eq!(fields.linked_docs, vec![\"docs/auth.md#Refresh\".to_string()]);\n178\t    assert_eq!(\n179\t        fields.linked_tests,\n180\t        vec![\"tests/auth_refresh.rs::refresh_token\".to_string()]\n181\t    );\n182\t    assert_eq!(fields.linked_memories, vec![\"mem-upstream\".to_string()]);\n183\t    assert_eq!(\n184\t        fields.validity_conditions,\n185\t        vec![\"session middleware stays enabled\".to_string()]\n186\t    );\n187\t    assert_eq!(\n188\t        fields.invalidation_triggers,\n189\t        vec![\"refresh handler rewrite\".to_string()]\n190\t    );\n191\t    let queued_jobs: i64 = store\n192\t        .with_connection(|conn| {\n193\t            conn.query_row(\n194\t                \"SELECT COUNT(*) FROM verification_jobs WHERE target_memory_id = ?1 AND status = 'queued'\",\n195\t                [memory_id],\n196\t                |row| row.get(0),\n197\t            )\n198\t            .map_err(|error| lattice_core::LatticeError::Storage(error.to_string()))\n199\t        })\n200\t        .expect(\"verification job count\");\n201\t    assert_eq!(queued_jobs, 1);\n202\t    drop(store);\n203\t\n204\t    let events = read_events(&event_store);\n205\t    assert!(events.iter().any(|event| matches!(event.payload, EventPayload::MemoryCreated(_))));\n206\t    cleanup_paths(&workspace_root, &context_cache_path);\n207\t}\n208\t\n209\t#[tokio::test]\n210\tasync fn propose_apply_and_reject_memory_evolution_are_auditable() {\n211\t    let (handler, memory_store, event_store, workspace_root, context_cache_path) =\n212\t        build_handler(\"memory-evolution\");\n213\t    let memory_id = {\n214\t        let mut store = memory_store.lock().await;\n215\t        let id = store\n216\t            .store(seed_memory(\"refresh behavior old\", MemoryScope::Repo))\n217\t            .expect(\"store memory\");\n218\t        let mut fields = MemoryStructuredFields::default();\n219\t        fields.memory_class = MemoryClass::Observation;\n220\t        store\n221\t            .update_structured_fields(&id, &fields)\n222\t            .expect(\"update fields\");\n223\t        id\n224\t    };\n225\t\n226\t    let propose = handler\n227\t        .handle(\n228\t            \"tools/call\",\n229\t            json!({\n230\t                \"name\": \"propose_memory_evolution\",\n231\t                \"arguments\": {\n232\t                    \"action\": \"propose\",\n233\t                    \"memory_id\": memory_id,\n234\t                    \"content\": \"refresh behavior new\",\n235\t                    \"linked_docs\": [\"docs/auth.md#Refresh\"],\n236\t                    \"reason\": \"refresh path changed\"\n237\t                }\n238\t            }),\n239\t        )\n240\t        .await\n241\t        .expect(\"propose succeeds\");\n242\t    let propose_payload = parse_tool_payload(&propose);\n243\t    let proposal_id = propose_payload[\"proposal_id\"].as_str().expect(\"proposal id\").to_string();\n244\t    {\n245\t        let store = memory_store.lock().await;\n246\t        let current = store\n247\t            .get_by_id(&memory_id)\n248\t            .expect(\"memory query\")\n249\t            .expect(\"memory exists\");\n250\t        assert_eq!(current.content, \"refresh behavior old\");\n251\t        let record = store\n252\t            .with_connection(|conn| {\n253\t                lattice_core::consolidation::ConsolidationProposal::load_record(conn, &proposal_id)\n254\t                    .map_err(Into::into)\n255\t                    .and_then(|value| value.ok_or_else(|| lattice_core::LatticeError::Storage(\"missing proposal\".to_string())))\n256\t            })\n257\t            .expect(\"proposal record\");\n258\t        assert_eq!(record.decision.as_str(), \"pending\");\n259\t    }\n260\t\n261\t    let apply = handler\n262\t        .handle(\n263\t            \"tools/call\",\n264\t            json!({\n265\t                \"name\": \"propose_memory_evolution\",\n266\t                \"arguments\": {\n267\t                    \"action\": \"apply\",\n268\t                    \"proposal_id\": proposal_id,\n269\t                    \"reason\": \"ship updated refresh memory\"\n270\t                }\n271\t            }),\n272\t        )\n273\t        .await\n274\t        .expect(\"apply succeeds\");\n275\t    let apply_payload = parse_tool_payload(&apply);\n276\t    assert_eq!(apply_payload[\"decision\"].as_str(), Some(\"applied\"));\n277\t    {\n278\t        let store = memory_store.lock().await;\n279\t        let current = store\n280\t            .get_by_id(&memory_id)\n281\t            .expect(\"memory query\")\n282\t            .expect(\"memory exists\");\n283\t        assert_eq!(current.content, \"refresh behavior new\");\n284\t    }\n285\t\n286\t    let reject_proposal = handler\n287\t        .handle(\n288\t            \"tools/call\",\n289\t            json!({\n290\t                \"name\": \"propose_memory_evolution\",\n291\t                \"arguments\": {\n292\t                    \"action\": \"propose\",\n293\t                    \"memory_id\": memory_id,\n294\t                    \"content\": \"refresh behavior rejected\",\n295\t                    \"reason\": \"candidate rejected\"\n296\t                }\n297\t            }),\n298\t        )\n299\t        .await\n300\t        .expect(\"second propose succeeds\");\n301\t    let reject_payload = parse_tool_payload(&reject_proposal);\n302\t    let reject_id = reject_payload[\"proposal_id\"].as_str().expect(\"proposal id\").to_string();\n303\t    let reject = handler\n304\t        .handle(\n305\t            \"tools/call\",\n306\t            json!({\n307\t                \"name\": \"propose_memory_evolution\",\n308\t                \"arguments\": {\n309\t                    \"action\": \"reject\",\n310\t                    \"proposal_id\": reject_id,\n311\t                    \"reason\": \"do not accept\"\n312\t                }\n313\t            }),\n314\t        )\n315\t        .await\n316\t        .expect(\"reject succeeds\");\n317\t    let reject_payload = parse_tool_payload(&reject);\n318\t    assert_eq!(reject_payload[\"decision\"].as_str(), Some(\"rejected\"));\n319\t\n320\t    let events = read_events(&event_store);\n321\t    assert!(events.iter().any(|event| matches!(event.payload, EventPayload::MemoryConsolidated(_))));\n322\t    cleanup_paths(&workspace_root, &context_cache_path);\n323\t}\n324\t\n325\t#[tokio::test]\n326\tasync fn get_task_memory_respects_scope_boundaries() {\n327\t    let (handler, memory_store, _event_store, workspace_root, context_cache_path) =\n328\t        build_handler(\"scope-boundary\");\n329\t    {\n330\t        let mut store = memory_store.lock().await;\n331\t        let mut branch_memory = seed_memory(\"other branch memory\", MemoryScope::Branch);\n332\t        branch_memory.workspace_id = Some(workspace_root.to_string_lossy().to_string());\n333\t        branch_memory.branch = Some(\"different-branch\".to_string());\n334\t        store.store(branch_memory).expect(\"store branch memory\");\n335\t    }\n336\t    handler\n337\t        .remember_working_memory_state_for_test(TASK_ID, WorkingMemoryState::new(\"branch mismatch\"))\n338\t        .await;\n339\t\n340\t    let response = handler\n341\t        .handle(\n342\t            \"tools/call\",\n343\t            json!({\"name\": \"get_task_memory\", \"arguments\": {\"task_id\": TASK_ID}}),\n344\t        )\n345\t        .await\n346\t        .expect(\"get_task_memory succeeds\");\n347\t    let payload = parse_tool_payload(&response);\n348\t    let memories = payload[\"memories\"].as_array().expect(\"memories\");\n349\t    assert!(memories.iter().all(|memory| memory[\"content\"].as_str() != Some(\"other branch memory\")));\n350\t    cleanup_paths(&workspace_root, &context_cache_path);\n351\t}\n352\t\n353\t#[tokio::test]\n354\tasync fn apply_memory_evolution_shim_forwards_with_deprecation_warning() {\n355\t    let (handler, memory_store, _event_store, workspace_root, context_cache_path) =\n356\t        build_handler(\"apply-shim\");\n357\t    let memory_id = {\n358\t        let mut store = memory_store.lock().await;\n359\t        store\n360\t            .store(seed_memory(\"shim target\", MemoryScope::Repo))\n361\t            .expect(\"store memory\")\n362\t    };\n363\t    let propose = handler\n364\t        .handle(\n365\t            \"tools/call\",\n366\t            json!({\n367\t                \"name\": \"propose_memory_evolution\",\n368\t                \"arguments\": {\n369\t                    \"action\": \"propose\",\n370\t                    \"memory_id\": memory_id,\n371\t                    \"content\": \"shim target updated\"\n372\t                }\n373\t            }),\n374\t        )\n375\t        .await\n376\t        .expect(\"propose succeeds\");\n377\t    let proposal_id = parse_tool_payload(&propose)[\"proposal_id\"]\n378\t        .as_str()\n379\t        .expect(\"proposal id\")\n380\t        .to_string();\n381\t    let shim = handler\n382\t        .handle(\n383\t            \"tools/call\",\n384\t            json!({\n385\t                \"name\": \"apply_memory_evolution\",\n386\t                \"arguments\": {\n387\t                    \"proposal_id\": proposal_id\n388\t                }\n389\t            }),\n390\t        )\n391\t        .await\n392\t        .expect(\"shim succeeds\");\n393\t    let payload = parse_tool_payload(&shim);\n394\t    assert_eq!(payload[\"decision\"].as_str(), Some(\"applied\"));\n395\t    assert!(payload[\"deprecation_warning\"].as_str().is_some());\n396\t    cleanup_paths(&workspace_root, &context_cache_path);\n397\t}\n398\t\n399\tfn round_trip<T>(value: &T)\n400\twhere\n401\t    T: serde::Serialize + serde::de::DeserializeOwned + PartialEq + std::fmt::Debug,\n402\t{\n403\t    let json = serde_json::to_string(value).expect(\"serialize\");\n404\t    let restored: T = serde_json::from_str(&json).expect(\"deserialize\");\n405\t    assert_eq!(&restored, value);\n406\t}\n407\t\n408\tfn build_handler(\n409\t    suffix: &str,\n410\t) -> (\n411\t    McpHandler,\n412\t    Arc<Mutex<MemoryStore>>,\n413\t    Arc<EventStore>,\n414\t    PathBuf,\n415\t    PathBuf,\n416\t) {\n417\t    let workspace_root = unique_test_path(&format!(\"lattice-memory-v2-{suffix}\"));\n418\t    std::fs::create_dir_all(&workspace_root).expect(\"workspace dir\");\n419\t    let context_cache_path = workspace_root.join(\"context_handles.json\");\n420\t    let memory_store = Arc::new(Mutex::new(\n421\t        MemoryStore::open_in_memory().expect(\"memory store\"),\n422\t    ));\n423\t    let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store\"));\n424\t    let event_writer = Arc::new(\n425\t        EventWriter::new(\n426\t            event_store.clone(),\n427\t            workspace_root.to_string_lossy().to_string(),\n428\t            4096,\n429\t        )\n430\t        .with_flush_policy(FlushPolicy::Sync),\n431\t    );\n432\t    let handler = McpHandler::new(\n433\t        Arc::new(Mutex::new(QueryEngine::new(CodeGraph::new(), None, None))),\n434\t        Arc::new(Mutex::new(Indexer::new(workspace_root.clone()))),\n435\t        memory_store.clone(),\n436\t        Arc::new(Mutex::new(\n437\t            GraphStore::open_in_memory().expect(\"graph store\"),\n438\t        )),\n439\t        Arc::new(std::sync::OnceLock::new()),\n440\t        None,\n441\t        workspace_root.clone(),\n442\t        context_cache_path.clone(),\n443\t        format!(\"session-test-{suffix}\"),\n444\t        None,\n445\t        vec![workspace_root.clone()],\n446\t        Arc::new(AtomicBool::new(false)),\n447\t        Some(event_writer),\n448\t    );\n449\t    (handler, memory_store, event_store, workspace_root, context_cache_path)\n450\t}\n451\t\n452\tfn seed_memory(content: &str, scope: MemoryScope) -> Memory {\n453\t    Memory {\n454\t        id: String::new(),\n455\t        session_id: \"session-seed\".to_string(),\n456\t        content: content.to_string(),\n457\t        memory_type: MemoryType::Observation,\n458\t        scope,\n459\t        confidence: 0.81,\n460\t        linked_symbols: vec![\"refresh_token\".to_string()],\n461\t        linked_files: vec![\"src/auth.rs\".to_string()],\n462\t        workspace_id: None,\n463\t        branch: None,\n464\t        scope_organization_id: None,\n465\t        refresh_key: None,\n466\t        source_query: Some(\"refresh token\".to_string()),\n467\t        created_at: 0,\n468\t        last_accessed: 0,\n469\t        access_count: 0,\n470\t        is_stale: false,\n471\t        stale_reason: None,\n472\t        verification_status: MemoryVerificationStatus::Unverified,\n473\t    }\n474\t}\n475\t\n476\tfn read_events(store: &Arc<EventStore>) -> Vec<lattice_core::events::EventEnvelope> {\n477\t    EventReader::new(store.clone())\n478\t        .execute(EventQuery::new().order(QueryOrder::OldestFirst).limit(32))\n479\t        .expect(\"event query\")\n480\t}\n481\t\n482\tfn parse_tool_payload(response: &Value) -> Value {\n483\t    let text = response[\"content\"][0][\"text\"].as_str().expect(\"tool text\");\n484\t    serde_json::from_str(text).expect(\"tool payload json\")\n485\t}\n486\t\n487\tfn cleanup_paths(workspace_root: &PathBuf, context_cache_path: &PathBuf) {\n488\t    let _ = std::fs::remove_file(context_cache_path);\n489\t    let _ = std::fs::remove_dir_all(workspace_root);\n490\t}\n491\t\n492\tfn unique_test_path(prefix: &str) -> PathBuf {\n493\t    let nanos = SystemTime::now()\n494\t        .duration_since(UNIX_EPOCH)\n495\t        .unwrap_or_default()\n496\t        .as_nanos();\n497\t    std::env::temp_dir().join(format!(\"{prefix}-{nanos}\"))\n498\t}\n499\t"}]},"parent_tool_use_id":null,"session_id":"1872dd72-ab0d-4621-9b2e-b0d7d6173b92","uuid":"5213f429-ac3c-4d63-bc2e-e62f15bfa0d6","timestamp":"2026-05-17T14:52:23.373Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/memory_v2/memory_tools_tests.rs","content":"use std::path::PathBuf;\nuse std::sync::atomic::AtomicBool;\nuse std::sync::Arc;\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse lattice_core::events::{\n    EventPayload, EventQuery, EventReader, EventStore, EventWriter, FlushPolicy, QueryOrder,\n};\nuse lattice_core::graph::CodeGraph;\nuse lattice_core::indexer::Indexer;\nuse lattice_core::memory::{\n    Memory, MemoryClass, MemoryScope, MemoryStore, MemoryStructuredFields,\n    MemoryVerificationStatus, MemoryType,\n};\nuse lattice_core::memory::model::MemoryAssertionType;\nuse lattice_core::query::QueryEngine;\nuse lattice_core::storage::GraphStore;\nuse lattice_core::working_memory::WorkingMemoryState;\nuse serde_json::{json, Value};\nuse tokio::sync::Mutex;\n\nuse super::super::mcp::McpHandler;\nuse super::super::server::RequestHandler;\nuse super::{get_task_memory, propose_memory_evolution, save_memory, EvolutionAction, TaskMemoryBundle};\n\nconst TASK_ID: &str = \"task-memory-v2\";\n\n#[test]\nfn serde_round_trips_memory_tool_requests_and_responses() {\n    let get_args = get_task_memory::GetTaskMemoryArgs {\n        task_id: TASK_ID.to_string(),\n        intent_hint: Some(\"refresh auth memory\".to_string()),\n        budget_tokens: Some(800),\n    };\n    round_trip(&get_args);\n\n    let save_args = save_memory::SaveMemoryArgs {\n        content: \"Auth refresh invariant\".to_string(),\n        memory_class: MemoryClass::ArchitectureInvariant,\n        assertion_type: Some(MemoryAssertionType::Constraint),\n        scope: save_memory::MemoryScopeArg::Repo,\n        confidence: 0.81,\n        confidence_reason: \"Derived from code and tests\".to_string(),\n        freshness_policy: save_memory::FreshnessPolicyArg::ManualReview,\n        validity_conditions: vec![\"auth router unchanged\".to_string()],\n        invalidation_triggers: vec![\"refresh flow refactor\".to_string()],\n        provenance_event_ids: vec![\"evt-1\".to_string()],\n        evidence: Vec::new(),\n        linked_files: vec![\"src/auth.rs\".to_string()],\n        linked_symbols: vec![\"refresh_token\".to_string()],\n        linked_docs: vec![\"docs/auth.md#Refresh\".to_string()],\n        linked_tests: vec![\"tests/auth_refresh.rs::refresh_token\".to_string()],\n        linked_memories: vec![\"mem-1\".to_string()],\n        source_query: Some(\"refresh token failures\".to_string()),\n        refresh_key: Some(\"auth::refresh\".to_string()),\n        branch: None,\n        organization_id: None,\n    };\n    round_trip(&save_args);\n\n    let proposal_args = propose_memory_evolution::ProposeMemoryEvolutionArgs {\n        action: EvolutionAction::Propose,\n        proposal_id: None,\n        memory_id: Some(\"mem-1\".to_string()),\n        content: Some(\"Updated content\".to_string()),\n        linked_files: vec![\"src/auth.rs\".to_string()],\n        linked_symbols: vec![\"refresh_token\".to_string()],\n        linked_docs: vec![\"docs/auth.md#Refresh\".to_string()],\n        linked_tests: vec![\"tests/auth_refresh.rs::refresh_token\".to_string()],\n        linked_memories: vec![\"mem-2\".to_string()],\n        validity_conditions: vec![\"router still present\".to_string()],\n        invalidation_triggers: vec![\"handler removed\".to_string()],\n        superseded_by_memory_id: None,\n        invalidate_reason: None,\n        reason: Some(\"refresh contract evolved\".to_string()),\n        decided_by: Some(\"assistant\".to_string()),\n    };\n    round_trip(&proposal_args);\n\n    let bundle = TaskMemoryBundle {\n        task_id: TASK_ID.to_string(),\n        checkpoint_id: Some(7),\n        working_memory_verification_status: \"verified\".to_string(),\n        memories: Vec::new(),\n    };\n    round_trip(&bundle);\n}\n\n#[tokio::test]\nasync fn get_task_memory_surfaces_inclusion_reason_and_verification_status() {\n    let (handler, memory_store, event_store, workspace_root, context_cache_path) =\n        build_handler(\"get-task-memory\");\n    {\n        let mut store = memory_store.lock().await;\n        let id = store\n            .store(seed_memory(\"refresh token must preserve session\", MemoryScope::Repo))\n            .expect(\"store memory\");\n        let mut fields = MemoryStructuredFields::default();\n        fields.memory_class = MemoryClass::Constraint;\n        fields.assertion_type = MemoryAssertionType::Constraint;\n        fields.verification_status = MemoryVerificationStatus::Verified;\n        fields.linked_docs = vec![\"docs/auth.md#Refresh\".to_string()];\n        store\n            .update_structured_fields(&id, &fields)\n            .expect(\"update fields\");\n    }\n    handler\n        .remember_working_memory_state_for_test(\n            TASK_ID,\n            WorkingMemoryState::new(\"refresh token session diagnosis\"),\n        )\n        .await;\n\n    let response = handler\n        .handle(\n            \"tools/call\",\n            json!({\"name\": \"get_task_memory\", \"arguments\": {\"task_id\": TASK_ID, \"intent_hint\": \"refresh token\"}}),\n        )\n        .await\n        .expect(\"tool succeeds\");\n    let payload = parse_tool_payload(&response);\n    let memories = payload[\"memories\"].as_array().expect(\"memories array\");\n    assert!(!memories.is_empty(), \"expected at least one surfaced memory\");\n    for memory in memories {\n        assert!(memory[\"inclusion_reason\"].as_str().is_some_and(|value| !value.is_empty()));\n        assert!(memory[\"verification_status\"].as_str().is_some_and(|value| !value.is_empty()));\n    }\n\n    let events = read_events(&event_store);\n    assert!(events.iter().any(|event| matches!(event.payload, EventPayload::MemoryRetrieved(_))));\n    cleanup_paths(&workspace_root, &context_cache_path);\n}\n\n#[tokio::test]\nasync fn save_memory_defaults_unverified_persists_fields_emits_event_and_queues_verification() {\n    let (handler, memory_store, event_store, workspace_root, context_cache_path) =\n        build_handler(\"save-memory\");\n    let response = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"save_memory\",\n                \"arguments\": {\n                    \"content\": \"Refresh token invariants rely on session scope\",\n                    \"memory_class\": \"constraint\",\n                    \"assertion_type\": \"constraint\",\n                    \"scope\": \"repo\",\n                    \"confidence\": 0.74,\n                    \"confidence_reason\": \"Observed in handler and tests\",\n                    \"freshness_policy\": \"manual_review\",\n                    \"validity_conditions\": [\"session middleware stays enabled\"],\n                    \"invalidation_triggers\": [\"refresh handler rewrite\"],\n                    \"provenance_event_ids\": [\"evt-refresh\"],\n                    \"linked_files\": [\"src/auth.rs\"],\n                    \"linked_symbols\": [\"refresh_token\"],\n                    \"linked_docs\": [\"docs/auth.md#Refresh\"],\n                    \"linked_tests\": [\"tests/auth_refresh.rs::refresh_token\"],\n                    \"linked_memories\": [\"mem-upstream\"],\n                    \"source_query\": \"refresh token failures\",\n                    \"refresh_key\": \"auth::refresh\"\n                }\n            }),\n        )\n        .await\n        .expect(\"save_memory succeeds\");\n    let payload = parse_tool_payload(&response);\n    assert_eq!(payload[\"memory\"][\"verification_status\"].as_str(), Some(\"unverified\"));\n    let memory_id = payload[\"memory_id\"].as_str().expect(\"memory id\");\n\n    let store = memory_store.lock().await;\n    let fields = store\n        .get_structured_fields(memory_id)\n        .expect(\"fields query\")\n        .expect(\"fields exist\");\n    assert_eq!(fields.memory_class, MemoryClass::Constraint);\n    assert_eq!(fields.assertion_type, MemoryAssertionType::Constraint);\n    assert_eq!(fields.linked_docs, vec![\"docs/auth.md#Refresh\".to_string()]);\n    assert_eq!(\n        fields.linked_tests,\n        vec![\"tests/auth_refresh.rs::refresh_token\".to_string()]\n    );\n    assert_eq!(fields.linked_memories, vec![\"mem-upstream\".to_string()]);\n    assert_eq!(\n        fields.validity_conditions,\n        vec![\"session middleware stays enabled\".to_string()]\n    );\n    assert_eq!(\n        fields.invalidation_triggers,\n        vec![\"refresh handler rewrite\".to_string()]\n    );\n    let queued_jobs: i64 = store\n        .with_connection(|conn| {\n            conn.query_row(\n                \"SELECT COUNT(*) FROM verification_jobs WHERE target_memory_id = ?1 AND status = 'queued'\",\n                [memory_id],\n                |row| row.get(0),\n            )\n            .map_err(|error| lattice_core::LatticeError::Storage(error.to_string()))\n        })\n        .expect(\"verification job count\");\n    assert_eq!(queued_jobs, 1);\n    drop(store);\n\n    let events = read_events(&event_store);\n    assert!(events.iter().any(|event| matches!(event.payload, EventPayload::MemoryCreated(_))));\n    cleanup_paths(&workspace_root, &context_cache_path);\n}\n\n#[tokio::test]\nasync fn propose_apply_and_reject_memory_evolution_are_auditable() {\n    let (handler, memory_store, event_store, workspace_root, context_cache_path) =\n        build_handler(\"memory-evolution\");\n    let memory_id = {\n        let mut store = memory_store.lock().await;\n        let id = store\n            .store(seed_memory(\"refresh behavior old\", MemoryScope::Repo))\n            .expect(\"store memory\");\n        let mut fields = MemoryStructuredFields::default();\n        fields.memory_class = MemoryClass::Observation;\n        store\n            .update_structured_fields(&id, &fields)\n            .expect(\"update fields\");\n        id\n    };\n\n    let propose = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"propose_memory_evolution\",\n                \"arguments\": {\n                    \"action\": \"propose\",\n                    \"memory_id\": memory_id,\n                    \"content\": \"refresh behavior new\",\n                    \"linked_docs\": [\"docs/auth.md#Refresh\"],\n                    \"reason\": \"refresh path changed\"\n                }\n            }),\n        )\n        .await\n        .expect(\"propose succeeds\");\n    let propose_payload = parse_tool_payload(&propose);\n    let proposal_id = propose_payload[\"proposal_id\"].as_str().expect(\"proposal id\").to_string();\n    {\n        let store = memory_store.lock().await;\n        let current = store\n            .get_by_id(&memory_id)\n            .expect(\"memory query\")\n            .expect(\"memory exists\");\n        assert_eq!(current.content, \"refresh behavior old\");\n        let record = store\n            .with_connection(|conn| {\n                lattice_core::consolidation::ConsolidationProposal::load_record(conn, &proposal_id)\n                    .map_err(Into::into)\n                    .and_then(|value| value.ok_or_else(|| lattice_core::LatticeError::Storage(\"missing proposal\".to_string())))\n            })\n            .expect(\"proposal record\");\n        assert_eq!(record.decision.as_str(), \"pending\");\n    }\n\n    let apply = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"propose_memory_evolution\",\n                \"arguments\": {\n                    \"action\": \"apply\",\n                    \"proposal_id\": proposal_id,\n                    \"reason\": \"ship updated refresh memory\"\n                }\n            }),\n        )\n        .await\n        .expect(\"apply succeeds\");\n    let apply_payload = parse_tool_payload(&apply);\n    assert_eq!(apply_payload[\"decision\"].as_str(), Some(\"applied\"));\n    {\n        let store = memory_store.lock().await;\n        let current = store\n            .get_by_id(&memory_id)\n            .expect(\"memory query\")\n            .expect(\"memory exists\");\n        assert_eq!(current.content, \"refresh behavior new\");\n    }\n\n    let reject_proposal = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"propose_memory_evolution\",\n                \"arguments\": {\n                    \"action\": \"propose\",\n                    \"memory_id\": memory_id,\n                    \"content\": \"refresh behavior rejected\",\n                    \"reason\": \"candidate rejected\"\n                }\n            }),\n        )\n        .await\n        .expect(\"second propose succeeds\");\n    let reject_payload = parse_tool_payload(&reject_proposal);\n    let reject_id = reject_payload[\"proposal_id\"].as_str().expect(\"proposal id\").to_string();\n    let reject = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"propose_memory_evolution\",\n                \"arguments\": {\n                    \"action\": \"reject\",\n                    \"proposal_id\": reject_id,\n                    \"reason\": \"do not accept\"\n                }\n            }),\n        )\n        .await\n        .expect(\"reject succeeds\");\n    let reject_payload = parse_tool_payload(&reject);\n    assert_eq!(reject_payload[\"decision\"].as_str(), Some(\"rejected\"));\n\n    let events = read_events(&event_store);\n    assert!(events.iter().any(|event| matches!(event.payload, EventPayload::MemoryConsolidated(_))));\n    cleanup_paths(&workspace_root, &context_cache_path);\n}\n\n#[tokio::test]\nasync fn get_task_memory_respects_scope_boundaries() {\n    let (handler, memory_store, _event_store, workspace_root, context_cache_path) =\n        build_handler(\"scope-boundary\");\n    {\n        let mut store = memory_store.lock().await;\n        let mut branch_memory = seed_memory(\"other branch memory\", MemoryScope::Branch);\n        branch_memory.workspace_id = Some(workspace_root.to_string_lossy().to_string());\n        branch_memory.branch = Some(\"different-branch\".to_string());\n        store.store(branch_memory).expect(\"store branch memory\");\n    }\n    handler\n        .remember_working_memory_state_for_test(TASK_ID, WorkingMemoryState::new(\"branch mismatch\"))\n        .await;\n\n    let response = handler\n        .handle(\n            \"tools/call\",\n            json!({\"name\": \"get_task_memory\", \"arguments\": {\"task_id\": TASK_ID}}),\n        )\n        .await\n        .expect(\"get_task_memory succeeds\");\n    let payload = parse_tool_payload(&response);\n    let memories = payload[\"memories\"].as_array().expect(\"memories\");\n    assert!(memories.iter().all(|memory| memory[\"content\"].as_str() != Some(\"other branch memory\")));\n    cleanup_paths(&workspace_root, &context_cache_path);\n}\n\n#[tokio::test]\nasync fn apply_memory_evolution_shim_forwards_with_deprecation_warning() {\n    let (handler, memory_store, _event_store, workspace_root, context_cache_path) =\n        build_handler(\"apply-shim\");\n    let memory_id = {\n        let mut store = memory_store.lock().await;\n        store\n            .store(seed_memory(\"shim target\", MemoryScope::Repo))\n            .expect(\"store memory\")\n    };\n    let propose = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"propose_memory_evolution\",\n                \"arguments\": {\n                    \"action\": \"propose\",\n                    \"memory_id\": memory_id,\n                    \"content\": \"shim target updated\"\n                }\n            }),\n        )\n        .await\n        .expect(\"propose succeeds\");\n    let proposal_id = parse_tool_payload(&propose)[\"proposal_id\"]\n        .as_str()\n        .expect(\"proposal id\")\n        .to_string();\n    let shim = handler\n        .handle(\n            \"tools/call\",\n            json!({\n                \"name\": \"apply_memory_evolution\",\n                \"arguments\": {\n                    \"proposal_id\": proposal_id\n                }\n            }),\n        )\n        .await\n        .expect(\"shim succeeds\");\n    let payload = parse_tool_payload(&shim);\n    assert_eq!(payload[\"decision\"].as_str(), Some(\"applied\"));\n    assert!(payload[\"deprecation_warning\"].as_str().is_some());\n    cleanup_paths(&workspace_root, &context_cache_path);\n}\n\nfn round_trip<T>(value: &T)\nwhere\n    T: serde::Serialize + serde::de::DeserializeOwned + PartialEq + std::fmt::Debug,\n{\n    let json = serde_json::to_string(value).expect(\"serialize\");\n    let restored: T = serde_json::from_str(&json).expect(\"deserialize\");\n    assert_eq!(&restored, value);\n}\n\nfn build_handler(\n    suffix: &str,\n) -> (\n    McpHandler,\n    Arc<Mutex<MemoryStore>>,\n    Arc<EventStore>,\n    PathBuf,\n    PathBuf,\n) {\n    let workspace_root = unique_test_path(&format!(\"lattice-memory-v2-{suffix}\"));\n    std::fs::create_dir_all(&workspace_root).expect(\"workspace dir\");\n    let context_cache_path = workspace_root.join(\"context_handles.json\");\n    let memory_store = Arc::new(Mutex::new(\n        MemoryStore::open_in_memory().expect(\"memory store\"),\n    ));\n    let event_store = Arc::new(EventStore::open_in_memory().expect(\"event store\"));\n    let event_writer = Arc::new(\n        EventWriter::new(\n            event_store.clone(),\n            workspace_root.to_string_lossy().to_string(),\n            4096,\n        )\n        .with_flush_policy(FlushPolicy::Sync),\n    );\n    let handler = McpHandler::new(\n        Arc::new(Mutex::new(QueryEngine::new(CodeGraph::new(), None, None))),\n        Arc::new(Mutex::new(Indexer::new(workspace_root.clone()))),\n        memory_store.clone(),\n        Arc::new(Mutex::new(\n            GraphStore::open_in_memory().expect(\"graph store\"),\n        )),\n        Arc::new(std::sync::OnceLock::new()),\n        None,\n        workspace_root.clone(),\n        context_cache_path.clone(),\n        format!(\"session-test-{suffix}\"),\n        None,\n        vec![workspace_root.clone()],\n        Arc::new(AtomicBool::new(false)),\n        Some(event_writer),\n    );\n    (handler, memory_store, event_store, workspace_root, context_cache_path)\n}\n\nfn seed_memory(content: &str, scope: MemoryScope) -> Memory {\n    Memory {\n        id: String::new(),\n        session_id: \"session-seed\".to_string(),\n        content: content.to_string(),\n        memory_type: MemoryType::Observation,\n        scope,\n        confidence: 0.81,\n        linked_symbols: vec![\"refresh_token\".to_string()],\n        linked_files: vec![\"src/auth.rs\".to_string()],\n        workspace_id: None,\n        branch: None,\n        scope_organization_id: None,\n        refresh_key: None,\n        source_query: Some(\"refresh token\".to_string()),\n        created_at: 0,\n        last_accessed: 0,\n        access_count: 0,\n        is_stale: false,\n        stale_reason: None,\n        verification_status: MemoryVerificationStatus::Unverified,\n    }\n}\n\nfn read_events(store: &Arc<EventStore>) -> Vec<lattice_core::events::EventEnvelope> {\n    EventReader::new(store.clone())\n        .execute(EventQuery::new().order(QueryOrder::OldestFirst).limit(32))\n        .expect(\"event query\")\n}\n\nfn parse_tool_payload(response: &Value) -> Value {\n    let text = response[\"content\"][0][\"text\"].as_str().expect(\"tool text\");\n    serde_json::from_str(text).expect(\"tool payload json\")\n}\n\nfn cleanup_paths(workspace_root: &PathBuf, context_cache_path: &PathBuf) {\n    let _ = std::fs::remove_file(context_cache_path);\n    let _ = std::fs::remove_dir_all(workspace_root);\n}\n\nfn unique_test_path(prefix: &str) -> PathBuf {\n    let nanos = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_nanos();\n    std::env::temp_dir().join(format!(\"{prefix}-{nanos}\"))\n}\n","numLines":499,"startLine":1,"totalLines":499}}}
