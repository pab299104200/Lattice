{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015WpRYEreEULtPNegdsUQhi","type":"tool_result","content":"1\t//! Workflow Engine V2 edit-planning contract.\n2\t//!\n3\t//! Bound to `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n4\t//! `## Phase 8: Workflow Engine V2` and `## MCP Tool Contract Principles`.\n5\t//! The shared bundle below intentionally mirrors the spec field list:\n6\t//! overview, ranked pivots, relevant context, memory highlights, event\n7\t//! episodes where relevant, suggested next expansion, stable handles, risks or\n8\t//! uncertainty, compact/full render choice, and structured payload.\n9\t\n10\tuse lattice_core::events::EventKind;\n11\tuse lattice_core::identity::{ContextHandleId, EventId, FileId, MemoryId, SymbolId};\n12\tuse lattice_core::intelligence::TaskBundle;\n13\tuse lattice_core::memory::MemoryVerificationStatus;\n14\tuse lattice_core::query::ContextCapsule;\n15\tuse serde::{Deserialize, Serialize};\n16\tuse serde_json::{json, Value};\n17\t\n18\tpub mod context_capsule;\n19\tpub mod diagnose_failure;\n20\tpub mod docs_capsule;\n21\t#[cfg(test)]\n22\tmod composition_tests;\n23\t#[cfg(test)]\n24\tmod discovery_workflows_tests;\n25\t#[cfg(test)]\n26\tmod edit_workflows_tests;\n27\tpub mod impact_from_diff;\n28\tpub mod outcome_capture;\n29\tpub mod plan_edit;\n30\tpub mod prepare_change;\n31\tpub mod relevant_tests;\n32\tpub mod trace_scenario;\n33\t\n34\t/// Render choices shared by workflow v2 discovery and edit tools.\n35\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n36\tpub enum WorkflowRenderChoice {\n37\t    /// Focused response with the smallest useful working set.\n38\t    Focused,\n39\t    /// Compact response for default assistant use.\n40\t    Compact,\n41\t    /// Full response with broader candidates.\n42\t    Full,\n43\t    /// Diagnostic response with extra explanations.\n44\t    Diagnostic,\n45\t}\n46\t\n47\timpl WorkflowRenderChoice {\n48\t    /// Parse a user-supplied mode string.\n49\t    pub fn from_mode_str(value: Option<&str>) -> Self {\n50\t        match value {\n51\t            Some(\"focused\") | Some(\"tiny\") => Self::Focused,\n52\t            Some(\"full\") => Self::Full,\n53\t            Some(\"diagnostic\") => Self::Diagnostic,\n54\t            _ => Self::Compact,\n55\t        }\n56\t    }\n57\t}\n58\t\n59\t/// Build an expansion seed from a workflow-v2 JSON-compatible bundle.\n60\tpub fn build_expand_seed<T: Serialize>(bundle: &T) -> lattice_core::intelligence::ExpandContextSeed {\n61\t    let value = serde_json::to_value(bundle).unwrap_or_else(|_| json!({}));\n62\t    lattice_core::intelligence::ExpandContextSeed {\n63\t        query: value\n64\t            .get(\"query\")\n65\t            .or_else(|| value.get(\"scenario\"))\n66\t            .or_else(|| value.get(\"overview\"))\n67\t            .and_then(Value::as_str)\n68\t            .map(ToString::to_string),\n69\t        files: collect_string_values(&value, &[\"file\", \"repo_relative_path\"]),\n70\t        symbols: collect_string_values(&value, &[\"symbol\", \"qualified_name\"]),\n71\t        tests: collect_test_files(&value),\n72\t        memories: value\n73\t            .get(\"memory_highlights\")\n74\t            .and_then(Value::as_array)\n75\t            .cloned()\n76\t            .unwrap_or_default(),\n77\t    }\n78\t}\n79\t\n80\tfn collect_string_values(value: &Value, keys: &[&str]) -> Vec<String> {\n81\t    let mut values = Vec::new();\n82\t    collect_string_values_inner(value, keys, &mut values);\n83\t    values.sort();\n84\t    values.dedup();\n85\t    values\n86\t}\n87\t\n88\tfn collect_string_values_inner(value: &Value, keys: &[&str], values: &mut Vec<String>) {\n89\t    match value {\n90\t        Value::Object(object) => {\n91\t            for key in keys {\n92\t                if let Some(item) = object.get(*key).and_then(Value::as_str) {\n93\t                    values.push(item.to_string());\n94\t                }\n95\t            }\n96\t            for child in object.values() {\n97\t                collect_string_values_inner(child, keys, values);\n98\t            }\n99\t        }\n100\t        Value::Array(items) => {\n101\t            for item in items {\n102\t                collect_string_values_inner(item, keys, values);\n103\t            }\n104\t        }\n105\t        _ => {}\n106\t    }\n107\t}\n108\t\n109\tfn collect_test_files(value: &Value) -> Vec<String> {\n110\t    value\n111\t        .get(\"tests\")\n112\t        .and_then(Value::as_array)\n113\t        .map(|items| {\n114\t            items\n115\t                .iter()\n116\t                .filter_map(|item| item.get(\"file\").and_then(Value::as_str))\n117\t                .map(ToString::to_string)\n118\t                .collect()\n119\t        })\n120\t        .unwrap_or_default()\n121\t}\n122\t\n123\t/// Assistant-facing response shared by Phase 8 workflow tools.\n124\t#[derive(Debug, Clone, Serialize, Deserialize)]\n125\tpub struct WorkflowBundle {\n126\t    /// Human-readable summary of what the workflow selected and why.\n127\t    pub overview: String,\n128\t    /// Ranked code, doc, memory, or failure pivots with stable identities.\n129\t    pub ranked_pivots: Vec<Pivot>,\n130\t    /// Bounded supporting context that should be read before broad discovery.\n131\t    pub relevant_context: Vec<ContextItem>,\n132\t    /// Memory evidence with inclusion reason and verification lifecycle labels.\n133\t    pub memory_highlights: Vec<MemoryHighlight>,\n134\t    /// Explicit reason when no memories were available or relevant.\n135\t    pub memory_empty_rationale: Option<String>,\n136\t    /// Prior event-log episodes that are relevant to this workflow result.\n137\t    pub event_episodes: Vec<EventEpisode>,\n138\t    /// Recommended next expansion target.\n139\t    pub suggested_next_expansion: Option<ExpansionHint>,\n140\t    /// Stable handles copied out for clients that prefer a flat handle list.\n141\t    pub stable_handles: Vec<String>,\n142\t    /// Risks, stale evidence labels, contradictions, and uncertainty notes.\n143\t    pub risks: Vec<RiskNote>,\n144\t    /// Render shape selected for this response.\n145\t    pub render_choice: RenderChoice,\n146\t    /// Commands inferred from affected build targets and recommended tests.\n147\t    pub verification_commands: Vec<String>,\n148\t    /// Stable record of inputs, anchors, selected candidates, and exclusions.\n149\t    pub workflow_record: WorkflowRecord,\n150\t    /// Tool-specific payload retained for backward-compatible clients.\n151\t    pub structured_payload: Value,\n152\t}\n153\t\n154\t/// A ranked workflow pivot.\n155\t#[derive(Debug, Clone, Serialize, Deserialize)]\n156\tpub struct Pivot {\n157\t    /// Stable identity for the pivot.\n158\t    pub identity: StableIdentity,\n159\t    /// File, symbol, doc, memory, or event.\n160\t    pub kind: String,\n161\t    /// Display label for compact rendering.\n162\t    pub label: String,\n163\t    /// Repo-relative path when applicable.\n164\t    pub file: Option<String>,\n165\t    /// Symbol or heading name when applicable.\n166\t    pub symbol: Option<String>,\n167\t    /// One-based source line when applicable.\n168\t    pub line: Option<usize>,\n169\t    /// Ranked confidence score.\n170\t    pub score: f64,\n171\t    /// Reason this pivot was selected.\n172\t    pub inclusion_reason: String,\n173\t}\n174\t\n175\t/// Supporting context item.\n176\t#[derive(Debug, Clone, Serialize, Deserialize)]\n177\tpub struct ContextItem {\n178\t    /// Stable identity for the context item.\n179\t    pub identity: StableIdentity,\n180\t    /// Context kind such as file, symbol, doc, test, or memory."}]},"parent_tool_use_id":null,"session_id":"1872dd72-ab0d-4621-9b2e-b0d7d6173b92","uuid":"e32b85fa-4bb2-4b93-9bcd-cdc48f22740a","timestamp":"2026-05-17T14:58:47.079Z","tool_use_result":{"type":"text","file":{"filePath":"/home/pete/cadres/lattice/daemon/crates/lattice-daemon/src/rpc/workflow_v2/mod.rs","content":"//! Workflow Engine V2 edit-planning contract.\n//!\n//! Bound to `docs/plans/2026-05-16-cognitive-workspace-fork-plan.md`\n//! `## Phase 8: Workflow Engine V2` and `## MCP Tool Contract Principles`.\n//! The shared bundle below intentionally mirrors the spec field list:\n//! overview, ranked pivots, relevant context, memory highlights, event\n//! episodes where relevant, suggested next expansion, stable handles, risks or\n//! uncertainty, compact/full render choice, and structured payload.\n\nuse lattice_core::events::EventKind;\nuse lattice_core::identity::{ContextHandleId, EventId, FileId, MemoryId, SymbolId};\nuse lattice_core::intelligence::TaskBundle;\nuse lattice_core::memory::MemoryVerificationStatus;\nuse lattice_core::query::ContextCapsule;\nuse serde::{Deserialize, Serialize};\nuse serde_json::{json, Value};\n\npub mod context_capsule;\npub mod diagnose_failure;\npub mod docs_capsule;\n#[cfg(test)]\nmod composition_tests;\n#[cfg(test)]\nmod discovery_workflows_tests;\n#[cfg(test)]\nmod edit_workflows_tests;\npub mod impact_from_diff;\npub mod outcome_capture;\npub mod plan_edit;\npub mod prepare_change;\npub mod relevant_tests;\npub mod trace_scenario;\n\n/// Render choices shared by workflow v2 discovery and edit tools.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\npub enum WorkflowRenderChoice {\n    /// Focused response with the smallest useful working set.\n    Focused,\n    /// Compact response for default assistant use.\n    Compact,\n    /// Full response with broader candidates.\n    Full,\n    /// Diagnostic response with extra explanations.\n    Diagnostic,\n}\n\nimpl WorkflowRenderChoice {\n    /// Parse a user-supplied mode string.\n    pub fn from_mode_str(value: Option<&str>) -> Self {\n        match value {\n            Some(\"focused\") | Some(\"tiny\") => Self::Focused,\n            Some(\"full\") => Self::Full,\n            Some(\"diagnostic\") => Self::Diagnostic,\n            _ => Self::Compact,\n        }\n    }\n}\n\n/// Build an expansion seed from a workflow-v2 JSON-compatible bundle.\npub fn build_expand_seed<T: Serialize>(bundle: &T) -> lattice_core::intelligence::ExpandContextSeed {\n    let value = serde_json::to_value(bundle).unwrap_or_else(|_| json!({}));\n    lattice_core::intelligence::ExpandContextSeed {\n        query: value\n            .get(\"query\")\n            .or_else(|| value.get(\"scenario\"))\n            .or_else(|| value.get(\"overview\"))\n            .and_then(Value::as_str)\n            .map(ToString::to_string),\n        files: collect_string_values(&value, &[\"file\", \"repo_relative_path\"]),\n        symbols: collect_string_values(&value, &[\"symbol\", \"qualified_name\"]),\n        tests: collect_test_files(&value),\n        memories: value\n            .get(\"memory_highlights\")\n            .and_then(Value::as_array)\n            .cloned()\n            .unwrap_or_default(),\n    }\n}\n\nfn collect_string_values(value: &Value, keys: &[&str]) -> Vec<String> {\n    let mut values = Vec::new();\n    collect_string_values_inner(value, keys, &mut values);\n    values.sort();\n    values.dedup();\n    values\n}\n\nfn collect_string_values_inner(value: &Value, keys: &[&str], values: &mut Vec<String>) {\n    match value {\n        Value::Object(object) => {\n            for key in keys {\n                if let Some(item) = object.get(*key).and_then(Value::as_str) {\n                    values.push(item.to_string());\n                }\n            }\n            for child in object.values() {\n                collect_string_values_inner(child, keys, values);\n            }\n        }\n        Value::Array(items) => {\n            for item in items {\n                collect_string_values_inner(item, keys, values);\n            }\n        }\n        _ => {}\n    }\n}\n\nfn collect_test_files(value: &Value) -> Vec<String> {\n    value\n        .get(\"tests\")\n        .and_then(Value::as_array)\n        .map(|items| {\n            items\n                .iter()\n                .filter_map(|item| item.get(\"file\").and_then(Value::as_str))\n                .map(ToString::to_string)\n                .collect()\n        })\n        .unwrap_or_default()\n}\n\n/// Assistant-facing response shared by Phase 8 workflow tools.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct WorkflowBundle {\n    /// Human-readable summary of what the workflow selected and why.\n    pub overview: String,\n    /// Ranked code, doc, memory, or failure pivots with stable identities.\n    pub ranked_pivots: Vec<Pivot>,\n    /// Bounded supporting context that should be read before broad discovery.\n    pub relevant_context: Vec<ContextItem>,\n    /// Memory evidence with inclusion reason and verification lifecycle labels.\n    pub memory_highlights: Vec<MemoryHighlight>,\n    /// Explicit reason when no memories were available or relevant.\n    pub memory_empty_rationale: Option<String>,\n    /// Prior event-log episodes that are relevant to this workflow result.\n    pub event_episodes: Vec<EventEpisode>,\n    /// Recommended next expansion target.\n    pub suggested_next_expansion: Option<ExpansionHint>,\n    /// Stable handles copied out for clients that prefer a flat handle list.\n    pub stable_handles: Vec<String>,\n    /// Risks, stale evidence labels, contradictions, and uncertainty notes.\n    pub risks: Vec<RiskNote>,\n    /// Render shape selected for this response.\n    pub render_choice: RenderChoice,\n    /// Commands inferred from affected build targets and recommended tests.\n    pub verification_commands: Vec<String>,\n    /// Stable record of inputs, anchors, selected candidates, and exclusions.\n    pub workflow_record: WorkflowRecord,\n    /// Tool-specific payload retained for backward-compatible clients.\n    pub structured_payload: Value,\n}\n\n/// A ranked workflow pivot.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct Pivot {\n    /// Stable identity for the pivot.\n    pub identity: StableIdentity,\n    /// File, symbol, doc, memory, or event.\n    pub kind: String,\n    /// Display label for compact rendering.\n    pub label: String,\n    /// Repo-relative path when applicable.\n    pub file: Option<String>,\n    /// Symbol or heading name when applicable.\n    pub symbol: Option<String>,\n    /// One-based source line when applicable.\n    pub line: Option<usize>,\n    /// Ranked confidence score.\n    pub score: f64,\n    /// Reason this pivot was selected.\n    pub inclusion_reason: String,\n}\n\n/// Supporting context item.\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct ContextItem {\n    /// Stable identity for the context item.\n    pub identity: StableIdentity,\n    /// Context kind such as file, symbol, doc, test, or memory.","numLines":180,"startLine":1,"totalLines":644}}}
