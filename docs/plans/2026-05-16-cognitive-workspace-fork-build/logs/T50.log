+                params![
+                    memory.id,
+                    scope.workspace_id,
+                    scope.branch.as_ref().map(|branch| branch.name.as_str()),
+                    memory.scope.as_str(),
+                    now_epoch_secs() as i64,
+                ],
+            )
+            .map_err(|e| {
+                LatticeError::Storage(format!("Failed to record memory scope filter event: {}", e))
+            })?;
+        Ok(())
+    }
 }
 
