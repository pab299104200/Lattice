    MemoryInvalidated(MemoryInvalidatedPayload),
    MemoryConsolidated(MemoryConsolidatedPayload),
    ConsolidationFailed(ConsolidationFailedPayload),
}

impl EventPayload {
    /// Return the `EventKind` corresponding to this payload variant.
