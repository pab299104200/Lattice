+        &self,
+        keyword: &str,
+        scope: &ScopeFilter,
+    ) -> Result<Vec<Memory>, LatticeError> {
+        scope.validate().map_err(scope_filter_error)?;
+        let memories = self.search_by_keyword(keyword)?;
+        self.filter_scope_boundary(memories, scope)
     }
 
