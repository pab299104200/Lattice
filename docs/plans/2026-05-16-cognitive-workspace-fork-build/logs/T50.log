+                    memory_id: row.get(0)?,
+                    attempted_workspace_id: row.get(1)?,
+                    attempted_branch: row.get(2)?,
+                    memory_scope: MemoryScope::from_str(&row.get::<_, String>(3)?),
+                })
+            })
+            .map_err(|e| {
+                LatticeError::Storage(format!(
+                    "Failed to query memory scope filter events: {}",
+                    e
+                ))
+            })?;
