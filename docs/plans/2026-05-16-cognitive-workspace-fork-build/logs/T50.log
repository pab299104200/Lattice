            EventPayload::WorkflowFailed(_) => EventKind::WorkflowFailed,
            EventPayload::MemoryCreated(_) => EventKind::MemoryCreated,
            EventPayload::MemoryUpdated(_) => EventKind::MemoryUpdated,
