+            .map_err(|e| LatticeError::Storage(format!("Failed to mark memory stale: {}", e)))?;
+        if updated == 0 {
+            return Err(LatticeError::Storage(format!(
+                "Memory '{}' not found or invalidated",
+                id
+            )));
+        }
+        Ok(())
+    }
+
