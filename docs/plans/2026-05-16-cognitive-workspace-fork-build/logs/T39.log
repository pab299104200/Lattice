@@ -326,6 +326,9 @@
                 consolidated_memory_id: memory_id("I"),
                 source_event_ids: vec![event_id("N"), event_id("O")],
                 consolidation_summary: "merged duplicate memories".to_string(),
+                proposal_id: None,
