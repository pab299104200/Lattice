+                .provenance_json
+                .map(|json| serde_json::from_str(&json).map_err(json_error))
+                .transpose()?,
+            decided_at: self.decided_at,
+            decision: ProposalDecision::from_str(&self.decision)?,
+            decided_by: self.decided_by,
+            decision_reason: self.decision_reason,
         })
     }
 }
