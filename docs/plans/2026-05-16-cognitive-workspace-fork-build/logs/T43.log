+                decision: row.get(11)?,
+                decided_by: row.get(12)?,
+                decision_reason: row.get(13)?,
+            })
+        },
+    )
+    .optional()
+    .map_err(|e| LatticeError::Storage(format!("Failed to load proposal row: {e}")))
