+fn estimate_cost_micro_usd(prompt_tokens: u32, response_tokens: u32) -> u32 {
+    prompt_tokens
+        .saturating_add(response_tokens.saturating_mul(2))
+        .saturating_div(10)
+        .max(1)
+}
