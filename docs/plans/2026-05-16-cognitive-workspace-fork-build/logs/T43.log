+) -> Result<Option<ConsolidationProposalRow>, LatticeError> {
+    conn.query_row(
+        "SELECT p.proposal_id,
+                p.job_id,
+                j.workspace_id,
+                j.enqueued_at,
+                p.target_memory_id,
+                p.proposal_kind,
