+                    "LLM consolidation queue slice full; dropping job"
+                );
+                emit_queue_full(event_writer, &job, model_name, current_depth, max_depth)?;
+                return Ok(EnqueueOutcome::Dropped {
+                    reason: format!(
+                        "LLM consolidation queue slice {} reached for kind {}",
+                        max_depth, job.kind
+                    ),
+                });
+            }
