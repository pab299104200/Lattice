         LlmJobError::MalformedResponse(_) => "malformed_response",
         LlmJobError::BudgetExceeded(_) => "budget_exceeded",
+        LlmJobError::Provenance(_) => "provenance",
         LlmJobError::Storage(_) => "storage",
     }
 }
