+                        value.ok_or_else(|| {
+                            lattice_core::LatticeError::Storage("missing proposal".to_string())
+                        })
+                    })
+            })
+            .expect("proposal record")
+            .proposed_state["id"]
+            .as_str()
+            .expect("proposed memory id")
+            .to_string()
+    };
+    let existing = memory_store
+        .lock()
