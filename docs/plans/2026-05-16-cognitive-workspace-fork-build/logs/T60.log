diff --git a/daemon/crates/lattice-daemon/src/rpc/mod.rs b/daemon/crates/lattice-daemon/src/rpc/mod.rs
index 0518ffed4088967ae0d3f0805ea076a7546d1268..08cadfa8866f0f1724e5dabea0b4bba71b38f229
--- a/daemon/crates/lattice-daemon/src/rpc/mod.rs
+++ b/daemon/crates/lattice-daemon/src/rpc/mod.rs
