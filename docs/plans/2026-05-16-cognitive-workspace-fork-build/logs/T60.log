// ── Helper Functions ──────────────────────────────────────────────────

fn persist_session_consolidation_proposals(
    _workspace_id: &str,
    _store: &mut MemoryStore,
    slices: &[Vec<lattice_core::events::EventEnvelope>],
    _mode: memory_v2::consolidate_session::ConsolidationMode,
) -> Result<Vec<memory_v2::consolidate_session::ConsolidationProposalItem>, (i32, String)> {
    let mut proposals = Vec::new();
    for (index, slice) in slices.iter().enumerate() {
        let Some(first) = slice.first() else {
            continue;
        };
        let task_id = first
            .task_id
            .as_ref()
            .map(|value| value.value.clone())
            .unwrap_or_else(|| format!("task-{index}"));
        proposals.push(memory_v2::consolidate_session::ConsolidationProposalItem {
            proposal_id: format!("session-consolidation-{index}"),
            job_id: format!("session-consolidation-job-{index}"),
            proposal_kind: "update_memory".to_string(),
            task_id,
            category: "episode_summary".to_string(),
            summary: format!("Consolidation fallback summarized {} events", slice.len()),
        });
    }
    Ok(proposals)
}

fn emit_consolidation_proposal_events(
    capture: &EventCapture,
    workspace_id: &str,
    proposals: &[memory_v2::consolidate_session::ConsolidationProposalItem],
) -> Result<(), (i32, String)> {
    for proposal in proposals {
        let memory_id = MemoryId {
            workspace_id: workspace_id.to_string(),
            ulid: proposal.proposal_id.clone(),
        };
        capture
            .record_memory_updated(memory_id, &proposal.summary)
            .map_err(|error| (-32603, format!("Failed to capture consolidation proposal event: {error}")))?;
    }
    Ok(())
}

fn build_consolidation_report(
    args: memory_v2::consolidate_session::ConsolidateSessionArgs,
    mode: memory_v2::consolidate_session::ConsolidationMode,
    render_mode: memory_v2::consolidate_session::ConsolidationRenderMode,
    proposals: Vec<memory_v2::consolidate_session::ConsolidationProposalItem>,
) -> memory_v2::consolidate_session::ConsolidationReport {
    let proposal_ids: Vec<String> = proposals.iter().map(|proposal| proposal.proposal_id.clone()).collect();
    memory_v2::consolidate_session::ConsolidationReport {
        session_id: args.session_id,
        mode,
        render_mode,
        budget_ms: args.budget_ms,
        categories: vec![memory_v2::consolidate_session::ConsolidationCategoryReport {
            category: "episode_summary".to_string(),
            proposal_ids,
            note: None,
        }],
        proposals,
        incomplete: true,
        notes: vec![
            "Session consolidation currently uses a bounded fallback report in this branch."
                .to_string(),
        ],
    }
}

fn build_metric_values(
    events: &[lattice_core::events::EventEnvelope],
    signals: Vec<memory_v2::get_memory_metrics::MetricSignal>,
    now: lattice_core::DateTime<lattice_core::Utc>,
) -> Vec<memory_v2::get_memory_metrics::MetricValue> {
    let sample_count = events.len() as u64;
    signals
        .into_iter()
        .map(|signal| memory_v2::get_memory_metrics::MetricValue {
            signal,
            value: Some(sample_count as f64),
            denominator: Some(sample_count.max(1)),
            sample_count,
            source: memory_v2::get_memory_metrics::MetricSource::EventLog,
            computed_at: now,
            reason_if_null: None,
        })
        .collect()
}

fn build_event_trace_query(
    parsed: &memory_v2::get_event_trace::GetEventTraceArgs,
    workspace_id: &str,
    current_branch: Option<&str>,
    limit: usize,
) -> EventQuery {
    let mut query = EventQuery::new().order(QueryOrder::NewestFirst).limit(limit);
    if let Some(task_id) = parsed.task_id.as_deref() {
        query = query.task(task_id.to_string());
    }
    if let Some(session_id) = parsed.session_id.as_deref() {
        query = query.session(session_id.to_string());
    }
    if parsed.task_id.is_none() && parsed.session_id.is_none() {
        query = query
            .workspace(workspace_id.to_string())
            .branch(current_branch.unwrap_or("main").to_string());
    }
    if !parsed.kinds.is_empty() {
        query = query.kinds(&parsed.kinds);
    }
    if let Some(since) = parsed.since {
        query = query.after(since);
    }
    if let Some(until) = parsed.until {
        query = query.before(until);
    }
    query
}

fn event_trace_scope_kind(parsed: &memory_v2::get_event_trace::GetEventTraceArgs) -> &'static str {
    if parsed.task_id.is_some() {
        "task"
    } else if parsed.session_id.is_some() {
        "session"
    } else {
        "workspace"
    }
}

fn build_event_trace_page(
    parsed: memory_v2::get_event_trace::GetEventTraceArgs,
    render_mode: memory_v2::get_event_trace::EventTraceRenderMode,
    events: Vec<lattice_core::events::EventEnvelope>,
    next_cursor_row_id: Option<i64>,
    _limit: usize,
) -> memory_v2::get_event_trace::EventTracePage {
    let scope = if let Some(task_id) = parsed.task_id {
        memory_v2::get_event_trace::EventTraceScope {
            kind: "task".to_string(),
            value: task_id,
        }
    } else if let Some(session_id) = parsed.session_id {
        memory_v2::get_event_trace::EventTraceScope {
            kind: "session".to_string(),
            value: session_id,
        }
    } else {
        memory_v2::get_event_trace::EventTraceScope {
            kind: "workspace".to_string(),
            value: parsed.workspace_id.unwrap_or_default(),
        }
    };
    memory_v2::get_event_trace::EventTracePage {
        scope,
        render_mode,
        cursor: parsed.cursor,
        next_cursor: next_cursor_row_id.map(memory_v2::get_event_trace::encode_cursor),
        events: events
            .iter()
            .map(|event| memory_v2::get_event_trace::build_entry(event, render_mode))
            .collect(),
    }
}

