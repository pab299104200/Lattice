+            &store,
+            &indexer,
+            &graph_store,
+            &self.workspace_root,
+            &scope_filter,
+            &mut reports,
+            parsed.clone(),
+        )
+        .map_err(|message| (-32603, message))?;
+        drop(reports);
+        drop(graph_store);
+        drop(indexer);
+        drop(store);
+
+        let handle = self
+            .store_context_handle("verify_explain_memory", execution.expansion_seed.clone())
+            .await;
+        let response = memory_v2::verify_explain_memory::render_response(
+            &execution.report,
+            parsed.render_mode,
