+
+    let response = handler
+        .handle(
+            "tools/call",
+            json!({
+                "name": "get_memory_metrics",
+                "arguments": {
+                    "scope": "session",
+                    "render_mode": "diagnostic"
+                }
+            }),
+        )
+        .await
+        .expect("get_memory_metrics succeeds");
