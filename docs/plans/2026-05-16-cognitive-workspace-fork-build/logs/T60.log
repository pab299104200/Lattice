+    async fn tool_get_memory_metrics_v2(&self, args: &Value) -> Result<Value, (i32, String)> {
+        let parsed = memory_v2::get_memory_metrics::parse_args(args)
+            .map_err(|message| (-32602, message))?;
+        let render_mode = parsed.render_mode.unwrap_or_default();
+        let scope = parsed.scope.unwrap_or_default();
+        let now = lattice_core::Utc::now();
+        let events = self.load_metric_scope_events(scope, parsed.time_range.as_ref()).await?;
+        let signals = build_metric_values(
