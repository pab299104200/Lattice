            references: Vec::new(),
            summary: CompactSummary::new(format!(
                "LLM consolidation {} failed: queue_full",
                job.kind
            ))
            .map_err(|e| LatticeError::Storage(e.to_string()))?,
            payload: EventPayload::ConsolidationFailed(payload),

