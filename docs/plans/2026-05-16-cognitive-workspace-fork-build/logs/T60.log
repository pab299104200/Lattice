            Ok(SessionConsolidationOutcome::Proposed { .. }) => {
                span.record("outcome", "proposed");
            }
            Ok(SessionConsolidationOutcome::RedirectedToBackground { .. }) => {
                span.record("outcome", "redirected");
            }
            Err(_) => {
                span.record("outcome", "failed");
            }
        }
        result
    }

