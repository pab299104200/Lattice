+    pub fn execute_page(
+        &self,
+        query: EventQuery,
+        cursor_row_id: Option<i64>,
+    ) -> Result<EventPage, EventQueryError> {
+        let plan = QueryPlan::new(query)?;
+        let _span = debug_span!(
+            "event_reader.execute_page",
+            scope = %plan.query.trace_scope(),
+            cursor_row_id
