+    let current = memory_store
+        .lock()
+        .await
+        .get_by_id(&proposed_memory_id)
+        .expect("proposal target lookup")
+        .expect("memory exists after apply");
+    assert_eq!(current.memory_type, MemoryType::Pattern);
