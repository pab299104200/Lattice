                LatticeError::Storage(format!("Failed to query session memories: {}", e))
        created_at: row.get(13)?,
        last_accessed: row.get(14)?,
        access_count: row.get(15)?,
        is_stale: row.get(16)?,
        stale_reason: row.get(17)?,
        verification_status,
    })
}


