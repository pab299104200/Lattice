                 FROM memories
                 WHERE is_invalidated = 0
                 ORDER BY created_at DESC",
                [],
                "search memories",
            )?
        keyword: &str,
        exclude_session: Option<&str>,
        limit: usize,
    ) -> Result<Vec<Memory>, LatticeError> {
        let memories = match (build_fts_query(keyword), exclude_session) {
