    DocSectionRef(DocSectionId),
    /// Reference to another event in the append-only stream.
    EventRef(EventId),
    /// Reference to a durable memory record.
    MemoryRef(MemoryId),
    /// Reference to a follow-up context handle.
    ContextHandleRef(ContextHandleId),
}

