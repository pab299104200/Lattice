            })?
            .insert(*payload_hash, row_id);
        debug!(
            bytes_len = payload_bytes.len(),
            inline_ceiling_bytes = self.inline_ceiling_bytes,
            payload_row_id = row_id,
            "event payload spilled to side table"
        );
        Ok(PayloadLocation::Spilled { row_id })
    }

