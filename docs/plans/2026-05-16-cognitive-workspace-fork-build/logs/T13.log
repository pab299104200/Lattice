@@ -5,20 +5,27 @@
 //! `### 3. Event Log`.
 
 pub mod envelope;
+pub mod hashing;
 pub mod kinds;
 pub mod migrations;
 pub mod store;
+pub mod writer;
 
 #[cfg(test)]
 mod store_tests;
