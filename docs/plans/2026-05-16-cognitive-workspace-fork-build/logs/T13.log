+    row: &InsertEnvelopeRow,
+) -> Result<usize, rusqlite::Error> {
+    statement.execute(params![
+        row.event_uuid,
+        row.workspace_id,
+        row.branch,
+        row.session_id,
+        row.task_id,
+        row.actor_kind,
+        row.actor_detail,
+        row.kind,
+        row.ts_unix_micros,
+        row.payload_hash,
+        row.summary,
+        row.payload_inline,
+        row.payload_spill_id,
+        row.references_json,
+        row.schema_version,
+    ])
 }
 
 fn configure_connection(conn: &Connection, enable_wal: bool) -> Result<(), EventStoreError> {
